// Возвращает результат проверки корректности типа значения параметра.
//
// Параметры:
//  ПроверяемоеЗначение	 - Произвольный	 - Переданное значение параметра.
//  ДопустимыйТип		 - Тип			 - Ожидаемый тип параметра.
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Успешность проверки корректности.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция КорректностьТипаПараметра(ПроверяемоеЗначение, ДопустимыйТип)
	
	ТекстШаблона = "Проверка корректности значения параметра %1.";
	ЗаголовокЖурнала = СтрШаблон(ТекстШаблона, ПроверяемоеЗначение);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ТипЗначения = ТипЗнч(ПроверяемоеЗначение);
	Если ТипЗначения <> ДопустимыйТип Тогда
		ТекстШаблона = "Некорректное значение параметра %1.";
		СобытиеОшибки = СтрШаблон(ТекстШаблона, ПроверяемоеЗначение);
		КодОшибки = "SETT-00003";
		ТекстШаблона = "Значение параметра должно быть типа %1. Передан параметр типа %2.";
		КомментарийОшибки = СтрШаблон(ТекстШаблона, Строка(ДопустимыйТип), ТипЗначения);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
	Иначе
		Ответ.Успех = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает поддерживаемые варианты группировки расширенного экспорта.
// 
