#Область СлужебныйПрограммныйИнтерфейс

// Устанавливает значение настройки.
//
// Параметры:
//  НовоеЗначение	 - Произвольный			 - Значение настройки.
//  Идентификатор	 - УникальныйИдентификатор	 - Уникальный идентификатор настройки.
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Успешность установки значения.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция УстановитьЗначение(НовоеЗначение, Идентификатор) Экспорт
	
	СинонимРС = Метаданные.РегистрыСведений.ККСНГ_Настройки.Синоним;
	ТекстШаблона = "Установка значения %1 с идентификатором %2 в регистре сведений %3.";
	ЗаголовокЖурнала = СтрШаблон(ТекстШаблона, НовоеЗначение, Идентификатор, СинонимРС);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ДопустимыйТип = Тип("УникальныйИдентификатор");
	ЗапросКорректностиИдентификатора = КорректностьТипаПараметра(Идентификатор, ДопустимыйТип);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКорректностиИдентификатора.Журнал, Ложь);
	Если Не ЗапросКорректностиИдентификатора.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		МенеджерЗаписи = СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Идентификатор;
		
		АлгоритмСжатия = Новый СжатиеДанных(9);
		ЗаписываемоеЗначение = Новый ХранилищеЗначения(НовоеЗначение, АлгоритмСжатия);
		МенеджерЗаписи.Значение = ЗаписываемоеЗначение;
		
		МенеджерЗаписи.ТипЗначения = ТипЗнч(НовоеЗначение);
		МенеджерЗаписи.Записать();
		
		Ответ.Успех = Истина;
		
	Исключение
		ТекстШаблона = "Ошибка установки значения %1 с идентификатором %2 в регистре сведений %3.";
		СобытиеОшибки = СтрШаблон(ТекстШаблона, НовоеЗначение, Идентификатор, СинонимРС);
		КодОшибки = "SETT-00001";
		КомментарийОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;
	
КонецФункции

// Получает значение настройки по уникальному идентификатору.
//
// Параметры:
//  Идентификатор	 - УникальныйИдентификатор	 - Уникальный идентификатор настройки.
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Произвольный - Значение настройки.
//  * Успех       - Булево    - Успешность получения значения.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция ПолучитьЗначение(Идентификатор) Экспорт
	
	СинонимРС = Метаданные.РегистрыСведений.ККСНГ_Настройки.Синоним;
	ТекстШаблона = "Получение значения с идентификатором %1 в регистре сведений %2.";
	ЗаголовокЖурнала = СтрШаблон(ТекстШаблона, Идентификатор, СинонимРС);
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ДопустимыйТип = Тип("УникальныйИдентификатор");
	ЗапросКорректностиИдентификатора = КорректностьТипаПараметра(Идентификатор, ДопустимыйТип);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКорректностиИдентификатора.Журнал, Ложь);
	Если Не ЗапросКорректностиИдентификатора.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ККСНГ_Настройки.Значение КАК Значение,
	|	ККСНГ_Настройки.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	РегистрСведений.ККСНГ_Настройки КАК ККСНГ_Настройки
	|ГДЕ
	|	ККСНГ_Настройки.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Ответ.Результат = ВыборкаДетальныеЗаписи.Значение.Получить();
		Ответ.Успех = Истина;
	Иначе
		ТекстШаблона = "Отсутствует значение с идентификатором %1 в регистре сведений %2.";
		СобытиеОшибки = СтрШаблон(ТекстШаблона,
		Идентификатор, СинонимРС);
		КодОшибки = "SETT-00002";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, "");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;
	
КонецФункции

// Проверяет наличие настройки по уникальному идентификатору.
//
// Параметры:
//  Идентификатор	 - УникальныйИдентификатор	 - Уникальный идентификатор настройки.
// 
// Возвращаемое значение:
//  Структура - :
