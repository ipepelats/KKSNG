#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область КаталогВыгрузкиРасширенногоЭкспорта

// Устанавливает каталог выгрузки архивов документов при расширенном экспорте.
//
// Параметры:
//  НовыйКаталог - Строка	 - Устанавливаемый каталог выгрузки архивов документов при расширенном экспорте.
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Успешность установки каталог выгрузки.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция УстановитьКаталогВыгрузкиРасширенногоЭкспорта(НовыйКаталог) Экспорт
	
	ШаблонЗаголовка = "Установка каталог выгрузки архивов документов при расширенном экспорте в значение %1.";
	ЗаголовокЖурнала = СтрШаблон(ШаблонЗаголовка, НовыйКаталог);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ДопустимыйТип = Тип("Строка");
	ЗапросКорректностиНовогоКаталога = КорректностьТипаПараметра(НовыйКаталог, ДопустимыйТип);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКорректностиНовогоКаталога.Журнал, Ложь);
	Если Не ЗапросКорректностиНовогоКаталога.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	МаксДопустимаяДлинаПути = 160;
	Если СтрДлина(НовыйКаталог) > МаксДопустимаяДлинаПути Тогда
		ТекстШаблона = "Превышена допустимая длина пути %1.";
		СобытиеОшибки = СтрШаблон(ТекстШаблона, МаксДопустимаяДлинаПути);
		КодОшибки = "MXL-00004";
		ТекстШаблона = "Для установки каталога выгрузки доступна максимальная длина пути %1. Передан путь длиной %2.";
		КомментарийОшибки = СтрШаблон(ТекстШаблона, Строка(МаксДопустимаяДлинаПути), Строка(СтрДлина(НовыйКаталог)));
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	ЗапросУстановкиКаталога = УстановитьЗначение(НовыйКаталог, УИД_КаталогВыгрузкиРасширенногоЭкспорта());
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУстановкиКаталога.Журнал, Ложь);
	Ответ.Успех = ЗапросУстановкиКаталога.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает текущий режим каталог выгрузки архивов документов при расширенном экспорте.
// 
// Возвращаемое значение:
//  Строка - Текущий каталог выгрузки архивов документов при расширенном экспорте.
//
Функция КаталогВыгрузкиРасширенногоЭкспорта() Экспорт
	
	ЗапросТекущегоКаталога = ПолучитьЗначение(УИД_КаталогВыгрузкиРасширенногоЭкспорта());
	Если ЗапросТекущегоКаталога.Успех Тогда
		ТекущийКаталог = ЗапросТекущегоКаталога.Результат;
	Иначе
		ТекущийКаталог = "";
	КонецЕсли;
	Возврат ТекущийКаталог;
	
КонецФункции

#КонецОбласти

#Область ГруппировкаРасширенногоЭкспорта

// Устанавливает вариант группировки архивов документов при расширенном экспорте.
//
// Параметры:
//  НоваяГруппировка - 	 - 
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Успешность установки группировки.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция УстановитьГруппировкуРасширенногоЭкспорта(НоваяГруппировка) Экспорт
	
	ШаблонЗаголовка = "Установка варианта группировки архивов документов при расширенном экспорте в значение %1.";
	ЗаголовокЖурнала = СтрШаблон(ШаблонЗаголовка, НоваяГруппировка);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ПоддерживаемыеГруппировки = ПоддерживаемыеГруппировкиРасширенногоЭкспорта();
	Если ПоддерживаемыеГруппировки.Найти(НоваяГруппировка) = Неопределено Тогда
		ШаблонСобытия = "Некорректное значение устанавливаемой группировки расширенного экспорта: %1.";
		СобытиеОшибки = СтрШаблон((ШаблонСобытия), НоваяГруппировка);
		КодОшибки = "SETT-00004";
		КомментарийОшибки = "Значение устанавливаемой группировки не входит в список поддерживаемых вариантов группировки.";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	ЗапросУстановкиГруппировки = УстановитьЗначение(НоваяГруппировка, УИД_ГруппировкаРасширенногоЭкспорта());
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУстановкиГруппировки.Журнал, Ложь);
	Ответ.Успех = ЗапросУстановкиГруппировки.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает текущий вариант группировки архивов документов при расширенном экспорте.
// 
// Возвращаемое значение:
//  Строка - Текущий вариант группировки (см. ПоддерживаемыеГруппировкиРасширенногоЭкспорта()).
//
Функция ГруппировкаРасширенногоЭкспорта() Экспорт
	
	ПоддерживаемыеГруппировки = ПоддерживаемыеГруппировкиРасширенногоЭкспорта();
	Если ПоддерживаемыеГруппировки.Количество() > 0 Тогда
		ТекущаяГруппировка = ПоддерживаемыеГруппировки[0];
	Иначе
		ТекущаяГруппировка = "";
	КонецЕсли;
	
	ЗапросТекущейГруппировки = ПолучитьЗначение(УИД_ГруппировкаРасширенногоЭкспорта());
	Если ЗапросТекущейГруппировки.Успех Тогда
		ХранимаяГруппировка = ЗапросТекущейГруппировки.Результат;
		Если ПоддерживаемыеГруппировки.Найти(ХранимаяГруппировка) <> Неопределено Тогда
			ТекущаяГруппировка = ХранимаяГруппировка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущаяГруппировка;
	
КонецФункции

#КонецОбласти

#Область ТипыДокументовРасширенногоЭкспорта

// Устанавливает вариант группировки архивов документов при расширенном экспорте.
//
// Параметры:
//  НовыйСписок	 - 	 - 
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Успешность установки группировки.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция УстановитьТипыДокументовРасширенногоЭкспорта(НовыйСписок) Экспорт
	
	ШаблонЗаголовка = "Установка типов документов при расширенном экспорте: %1.";
	ПредставлениеСписка = СтрСоединить(НовыйСписок.ВыгрузитьЗначения(), ", ");
	ЗаголовокЖурнала = СтрШаблон(ШаблонЗаголовка, ПредставлениеСписка);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ПоддерживаемыеТипыДокументов = ПоддерживаемыеТипыДокументовРасширенногоЭкспорта();
	НекорректныеТипыДокументов = Новый Массив;
	Для Каждого ТекЭлемент Из НовыйСписок Цикл
		ТекТипДокумента = ТекЭлемент.Значение;
		НайденныйТипДокумента = ПоддерживаемыеТипыДокументов.Найти(ТекТипДокумента);
		Если НайденныйТипДокумента = Неопределено Тогда
			НекорректныеТипыДокументов.Добавить(ТекТипДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Если НекорректныеТипыДокументов.Количество() > 0 Тогда
		ШаблонСобытия = "Некорректные устанавливаемые типы документов расширенного экспорта: %1.";
		ПредставлениеНекорректных = СтрСоединить(НекорректныеТипыДокументов, ", ");
		СобытиеОшибки = СтрШаблон((ШаблонСобытия), ПредставлениеНекорректных);
		КодОшибки = "SETT-00005";
		КомментарийОшибки = "Значения устанавливаемых типов документов не входят в список поддерживаемых типов документов.";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	ЗапросУстановкиСписка = УстановитьЗначение(НовыйСписок, УИД_ТипыДокументовРасширенногоЭкспорта());
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУстановкиСписка.Журнал, Ложь);
	Ответ.Успех = ЗапросУстановкиСписка.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает текущий список типов документов при расширенном экспорте.
//
// Параметры:
//  ВернутьИзСохраненнойНастройки	 - 	 - 
// 
// Возвращаемое значение:
//  СписокЗначений - Текущий список типов документов (см. ПоддерживаемыеТипыДокументовРасширенногоЭкспорта()).
//
Функция ТипыДокументовРасширенногоЭкспорта(ВернутьИзСохраненнойНастройки = Истина) Экспорт
	
	ПоддерживаемыеТипыДокументов = ПоддерживаемыеТипыДокументовРасширенногоЭкспорта();
	
	ЗапросТекущегоСписка = ПолучитьЗначение(УИД_ТипыДокументовРасширенногоЭкспорта());
	Если Не ЗапросТекущегоСписка.Успех ИЛИ ВернутьИзСохраненнойНастройки = Ложь Тогда
		ТекущийСписок = Новый СписокЗначений;
		ТекущийСписок.ЗагрузитьЗначения(ПоддерживаемыеТипыДокументов);
		ТекущийСписок.ЗаполнитьПометки(Истина);
		Возврат ТекущийСписок;
	КонецЕсли;
	
	ТекущийСписок = ЗапросТекущегоСписка.Результат;
	
	ЭлементыКУдалению = Новый Массив;
	Для Каждого ТекЭлемент Из ТекущийСписок Цикл
		НайденныйТипДокумента = ПоддерживаемыеТипыДокументов.Найти(ТекЭлемент.Значение);
		Если НайденныйТипДокумента = Неопределено Тогда
			ЭлементыКУдалению.Добавить(ТекЭлемент);
		Иначе
			ПоддерживаемыеТипыДокументов.Удалить(НайденныйТипДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекЭлемент Из ЭлементыКУдалению Цикл
		ТекущийСписок.Удалить(ТекЭлемент);
	КонецЦикла;
	
	Для Каждого ТекТипДокумента Из ПоддерживаемыеТипыДокументов Цикл
		ТекущийСписок.Добавить(ТекТипДокумента);
	КонецЦикла;
	
	Возврат ТекущийСписок;
	
КонецФункции

// Возвращает краткое представление типа документа
//
// Параметры:
//  ПолноеПредставление	 - Строка	 - тип документа:
//  	"УПД:Первичный документ" - УПД ДОП;
//  	"УПД:Счет-фактура" - УПД СЧФ;
//  	"УПД:Счет-фактура и первичный документ" - УПД СЧФДОП;
//  	"УКД:Первичный документ" - УКД ДОП;
//  	"УКД:Корректировочный счет-фактура" - УКД КСЧФ;
//  	"УКД:Корректировочный счет-фактура и первичный документ" - УКД КСЧФДОП;
// 
// Возвращаемое значение:
//  Строка - пустая строка либо одно из "UPD_DOP"/"UPD_SF"/"UPD_SF_DOP"/"UCD_DIC"/"UCD_CSF"/"UCD_CSF_DIC"
//
Функция КраткоеПредставлениеТипаДокумента(ПолноеПредставление) Экспорт
	
	СоответствиеТипамДокументов = Новый Соответствие;
	СоответствиеТипамДокументов.Вставить("УПД:Первичный документ", "UPD_DOP");
	СоответствиеТипамДокументов.Вставить("УПД:Счет-фактура", "UPD_SF");
	СоответствиеТипамДокументов.Вставить("УПД:Счет-фактура и первичный документ", "UPD_SF_DOP");
	СоответствиеТипамДокументов.Вставить("УКД:Первичный документ", "UCD_DIC");
	СоответствиеТипамДокументов.Вставить("УКД:Корректировочный счет-фактура", "UCD_CSF");
	СоответствиеТипамДокументов.Вставить("УКД:Корректировочный счет-фактура и первичный документ", "UCD_CSF_DIC");
	
	КраткоеПредставление = СоответствиеТипамДокументов.Получить(ПолноеПредставление);
	Если КраткоеПредставление = Неопределено Тогда
		Возврат ПолноеПредставление;
	Иначе
		Возврат КраткоеПредставление;
	КонецЕсли;
	
КонецФункции

// Возвращает полное представление типа документа
//
// Параметры:
//  КраткоеПредставление - Строка	 - тип документа:
//  	"UPD_DOP"/"UPD_SF"/"UPD_SF_DOP"/"UCD_DIC"/"UCD_CSF"/"UCD_CSF_DIC"
// 
// Возвращаемое значение:
//  Строка - представление типа документа:
//  "УПД:Первичный документ" - УПД ДОП;
//  "УПД:Счет-фактура" - УПД СЧФ;
//  "УПД:Счет-фактура и первичный документ" - УПД СЧФДОП;
//  "УКД:Первичный документ" - УКД ДОП;
//  "УКД:Корректировочный счет-фактура" - УКД КСЧФ;
//  "УКД:Корректировочный счет-фактура и первичный документ" - УКД КСЧФДОП;
//
Функция ПолноеПредставлениеТипаДокумента(КраткоеПредставление) Экспорт
	
	СоответствиеТипамДокументов = Новый Соответствие;
	СоответствиеТипамДокументов.Вставить("UPD_DOP", "УПД:Первичный документ");
	СоответствиеТипамДокументов.Вставить("UPD_SF", "УПД:Счет-фактура");
	СоответствиеТипамДокументов.Вставить("UPD_SF_DOP", "УПД:Счет-фактура и первичный документ");
	СоответствиеТипамДокументов.Вставить("UCD_DIC", "УКД:Первичный документ");
	СоответствиеТипамДокументов.Вставить("UCD_CSF", "УКД:Корректировочный счет-фактура");
	СоответствиеТипамДокументов.Вставить("UCD_CSF_DIC", "УКД:Корректировочный счет-фактура и первичный документ");
	
	ПолноеПредставление = СоответствиеТипамДокументов.Получить(КраткоеПредставление);
	Если  ПолноеПредставление = Неопределено Тогда
		Возврат КраткоеПредставление;
	Иначе
		Возврат ПолноеПредставление;
	КонецЕсли;
	
КонецФункции

// Возвращает сокращенное представление типа документа.
//
// Параметры:
//  ТипДокумента - Строка	 - 
// 
// Возвращаемое значение:
//  Строка - Сокращенное представление типа документа.
//  Пример: СокращенноеПредставлениеТипаДокумента(UPD_SF) ==> "УПД.СЧФ"
//
Функция СокращенноеПредставлениеТипаДокумента(ТипДокумента) Экспорт
	
	СоответствиеТипамДокументов = Новый Соответствие;
	СоответствиеТипамДокументов.Вставить("UPD_DOP", "УПД.ДОП");
	СоответствиеТипамДокументов.Вставить("UPD_SF", "УПД.СЧФ");
	СоответствиеТипамДокументов.Вставить("UPD_SF_DOP", "УПД.СЧФДОП");
	СоответствиеТипамДокументов.Вставить("UCD_CSF", "УКД.КСЧФ");
	СоответствиеТипамДокументов.Вставить("UCD_DIC",	"УКД.ДИС");
	СоответствиеТипамДокументов.Вставить("UCD_CSF_DIC", "УКД.КСЧФДИС");
	
	Представление = СоответствиеТипамДокументов.Получить(ТипДокумента);
	Если Не Представление = Неопределено Тогда
		Возврат Представление;
	Иначе
		Возврат ТипДокумента;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОтправкаЧерновиковЭДО

// Устанавливает настройку использования независимой отправки черновиков при расширенной отправке ДО.
//
// Параметры:
