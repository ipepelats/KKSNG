// Сохраняет таблицу настроек МЧД.
//
// Параметры:
//  НоваяТаблицаЗначений - 	 - Таблица значений довренностей
//  ОрганизацияЭДО		 - 	 - ККСНГ_Организации
// 
// Возвращаемое значение:
//  Структура - :
//  * Результат   - Неопределено
//  * Успех       - Булево    - Результат сохранения таблицы.
//  * КодОшибки   - Строка
//  * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений().
//
Функция СохранитьТаблицуДоверенностей(НоваяТаблицаЗначений, ОрганизацияЭДО) Экспорт
	
	ШаблонЗаголовка = "Сохранение настроек по МЧД: %1.";
	ЗаголовокЖурнала = СтрШаблон(ШаблонЗаголовка, ОрганизацияЭДО);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ЗначениеНастройкиМЧД = ПолучитьЗначение(УИД_НастройкаМЧД());
	СоответствиеНастройкиМЧД = ЗначениеНастройкиМЧД.Результат;
	
	Если ТипЗнч(СоответствиеНастройкиМЧД) = Тип("Соответствие") Тогда
		СоответствиеНастройкиМЧД.Вставить(ОрганизацияЭДО, НоваяТаблицаЗначений);
	Иначе
		СоответствиеНастройкиМЧД = Новый Соответствие;
		СоответствиеНастройкиМЧД.Вставить(ОрганизацияЭДО, НоваяТаблицаЗначений);
	КонецЕсли;
	
	ЗапросСохраненияНастроекМЧД = УстановитьЗначение(СоответствиеНастройкиМЧД, УИД_НастройкаМЧД());
	
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросСохраненияНастроекМЧД.Журнал, Ложь);
	Ответ.Успех = ЗапросСохраненияНастроекМЧД.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Получает таблицу настроек МЧД.
//
// Параметры:
//  ОрганизацияЭДО	 - 	 - ККСНГ_Организации
// 
// Возвращаемое значение:
//  ТаблицаМЧД - ТаблицаЗначений
//
Функция ПолучитьТаблицуДоверенностей(ОрганизацияЭДО) Экспорт
	
	Перем ТаблицаМЧД;
	
	ШаблонЗаголовка = "Запись настроек по МЧД %1.";
	ЗаголовокЖурнала = СтрШаблон(ШаблонЗаголовка, Строка(ОрганизацияЭДО));
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ЗначениеНастройкиМЧД = ПолучитьЗначение(УИД_НастройкаМЧД());
	СоответствиеНастройкиМЧД = ЗначениеНастройкиМЧД.Результат;
	
	Если ЗначениеНастройкиМЧД.Успех И ЗначениеЗаполнено(СоответствиеНастройкиМЧД) Тогда
		ТаблицаМЧД = СоответствиеНастройкиМЧД.Получить(ОрганизацияЭДО);
	КонецЕсли;
	
	Возврат ТаблицаМЧД;
	
КонецФункции

