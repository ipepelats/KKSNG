	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ККСНГ_Настройки.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ККСНГ_Настройки КАК ККСНГ_Настройки
	|ГДЕ
	|	ККСНГ_Настройки.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Ответ.Результат = Не Запрос.Выполнить().Пустой();
	Ответ.Успех = Истина;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;
	
КонецФункции

