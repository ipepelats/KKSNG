#Область ТестовыйРежим

// Устанавливает настройку «Тестовый режим» (тест/прод)
//
// Параметры:
//  Использование	 - Булево	 - признак подключения к тестовому стенду
// 
// Возвращаемое значение:
//  Булево - успех обновления настройки
//
Функция УстановитьТестовыйРежим(Использование) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(СтрШаблон("Установка признака тестового режима работы с сервисом '%1'.", Использование));
	
	ЗапросУстановкиЗначения = УстановитьЗначение(Использование, УИД_ИспользованиеТестовогоРежима());
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУстановкиЗначения.Журнал, Ложь);
	Ответ.Успех = ЗапросУстановкиЗначения.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Получает настройку «Тестовый режим» (тест/прод)
// 
// Возвращаемое значение:
//  Булево - признак подключения к тестовому стенду
//
Функция ТестовыйРежим() Экспорт
	
	Возврат ПолучитьЗначение(УИД_ИспользованиеТестовогоРежима());
	
КонецФункции

#КонецОбласти

#Область НеОбновлятьПодключаемыеМодули

// Устанавливает настройку игнорирования обновления подключаемых модулей
