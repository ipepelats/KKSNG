#Область РаботаСРегистромСведений

// Устанавливает значение режима
//
// Параметры:
//  Режим			 - Булево	 - Значение режима
//  Идентификатор	 - Строка	 - Уникальный идентификатор режима
// 
// Возвращаемое значение:
//  Булево - Результат установки режима
//
Функция УстановитьЗначение(Режим, Идентификатор)
	
	Перем Ответ;
	Перем НаборЗаписей, НоваяЗапись;
	Перем ИнформацияОбОшибке, Шаблон, Описание, Комментарий;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(СтрШаблон("Установка значения '%1' с идентификатором '%2'", Режим, Идентификатор));
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
		Если Режим Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Идентификатор = Идентификатор;
		КонецЕсли;
		НаборЗаписей.Записать();
		
		Ответ.Успех = Истина;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Шаблон = "Ошибка установки значения '%1' с идентификатором '%2' в регистре сведений '%3'";
		Описание = СтрШаблон(Шаблон, Режим, Идентификатор, Метаданные.РегистрыСведений.ККСНГ_Служебный.Синоним);
		Комментарий = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, Описание, "SETT-00007", Комментарий);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// Проверяет значение режима
//
// Параметры:
//  Идентификатор	 - Строка	 - Уникальный идентификатор режима
// 
// Возвращаемое значение:
//  Булево - Значение режима
//
Функция ПолучитьЗначение(Идентификатор)
	
	Перем НаборЗаписей;
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли