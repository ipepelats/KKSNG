// 
// Возвращаемое значение:
//  Булево - успех обновления настройки
//
Функция УстановитьОбновлениеПодключаемыхМодулей(Использование) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(СтрШаблон("Установка режима обновления подключаемых модулей '%1'.", Использование));
	
	ЗапросУстановкиЗначения = УстановитьЗначение(Не Использование, УИД_ОбновлениеПодключаемыхМодулей());
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУстановкиЗначения.Журнал, Ложь);
	Ответ.Успех = ЗапросУстановкиЗначения.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Получает настройку игнорирования обновления подключаемых модулей
// 
// Возвращаемое значение:
//  Булево - обновлять подключаемые модули
//
Функция ОбновлятьПодключаемыеМодули() Экспорт
	
	Попытка
		Возврат Не ПолучитьЗначение(УИД_ОбновлениеПодключаемыхМодулей());
	Исключение
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

