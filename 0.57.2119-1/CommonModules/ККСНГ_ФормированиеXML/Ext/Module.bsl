Процедура ПроверитьЗаполнениеСчетаУВХД(СтруктураДокумента, ДанныеФормата, ЖурналСообщений)
	
	СписокПроверяемыхРеквизитов = Новый Массив();
	
	// Реквизиты счета
	ПроверяемыеРеквизитыСчета = Новый Соответствие();
	ПроверяемыеРеквизитыСчета.Вставить("Num_invoice", ПроверяемыйРеквизитУВХД("Номер счета"));
	ПроверяемыеРеквизитыСчета.Вставить("Date_invoice", ПроверяемыйРеквизитУВХД("Дата счета"));
	СписокПроверяемыхРеквизитов.Добавить(ПроверяемыеРеквизитыСчета);
	
	РеквизитыСчета = СтруктураДокумента.InvoiceDetailRequest.InvoiceDetailRequestHeader.Extrinsic;
	Для каждого РеквизитСчета Из РеквизитыСчета Цикл
		ИмяРеквизита = РеквизитСчета.name;
		ПроверяемыйРеквизит = ПроверяемыеРеквизитыСчета.Получить(ИмяРеквизита);
		Если Не ПроверяемыйРеквизит = Неопределено Тогда
			ЗначениеРеквизита = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитСчета, "__content");
			ПроверяемыйРеквизит.Заполнен = ЗначениеЗаполнено(ЗначениеРеквизита);
			ПроверяемыйРеквизит.Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Участники счета
	УчастникиСчета = СтруктураДокумента.InvoiceDetailRequest.InvoiceDetailRequestHeader.InvoicePartner;
	Для каждого УчастникСчета Из УчастникиСчета Цикл
		
		ПроверяемыеРеквизитыУчастниковСчета = Новый Соответствие();
		ПроверяемыеРеквизитыУчастниковСчета.Вставить("INN", ПроверяемыйРеквизитУВХД("ИНН"));
		//ПроверяемыеРеквизитыУчастниковСчета.Вставить("IBAN", ПроверяемыйРеквизитУВХД("Номер счета"));
		//ПроверяемыеРеквизитыУчастниковСчета.Вставить("BIK", ПроверяемыйРеквизитУВХД("БИК"));
		//ПроверяемыеРеквизитыУчастниковСчета.Вставить("NameBank", ПроверяемыйРеквизитУВХД("Наименование банка"));
		СписокПроверяемыхРеквизитов.Добавить(ПроверяемыеРеквизитыУчастниковСчета);
		
		// Реквизиты участника счета
		ИмяУчастника = УчастникСчета.Contact.Name.__content;
		РеквизитыУчастникаСчета = УчастникСчета.Contact.Extrinsic;
		Для каждого РеквизитУчастникаСчета Из РеквизитыУчастникаСчета Цикл
			ИмяРеквизита = РеквизитУчастникаСчета.name;
			ПроверяемыйРеквизит = ПроверяемыеРеквизитыУчастниковСчета.Получить(ИмяРеквизита);
			Если Не ПроверяемыйРеквизит = Неопределено Тогда
				ЗначениеРеквизита = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитУчастникаСчета, "__content");
				ПроверяемыйРеквизит.Заполнен = ЗначениеЗаполнено(ЗначениеРеквизита);
				ПроверяемыйРеквизит.Найден = Истина;
			КонецЕсли;
		КонецЦикла;
		
		// Адрес участника счета
		АдресУчастника = УчастникСчета.Contact.PostalAddress;
		
		ПроверяемыеРеквизитыАдресаУчастника = Новый Соответствие();
		ПроверяемыеРеквизитыАдресаУчастника.Вставить("City", ПроверяемыйРеквизитУВХД("Город"));
		ПроверяемыеРеквизитыАдресаУчастника.Вставить("Street", ПроверяемыйРеквизитУВХД("Улица"));
		ПроверяемыеРеквизитыАдресаУчастника.Вставить("PostalCode", ПроверяемыйРеквизитУВХД("Индекс"));
		ПроверяемыеРеквизитыАдресаУчастника.Вставить("Country.__content", ПроверяемыйРеквизитУВХД("Страна"));
		СписокПроверяемыхРеквизитов.Добавить(ПроверяемыеРеквизитыАдресаУчастника);
		
		Для каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизитыАдресаУчастника Цикл
			ДанныеПроверки = ПроверяемыйРеквизит.Значение;
			ЗначениеРеквизита = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(АдресУчастника, ПроверяемыйРеквизит.Ключ, NULL);
			ДанныеПроверки.Заполнен = ЗначениеЗаполнено(ЗначениеРеквизита);
			ДанныеПроверки.Найден = Не (ЗначениеРеквизита = NULL);
		КонецЦикла;
		
	КонецЦикла;
	
	// Анализ заполнения реквизитов и заполнение журнала сообщений
	Для каждого ПроверяемыеРеквизиты Из СписокПроверяемыхРеквизитов Цикл
		Для каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
			ДанныеПроверки = ПроверяемыйРеквизит.Значение;
			Если Не ДанныеПроверки.Найден Тогда
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, СтрШаблон("Не найден обязательный реквизит счета ""%1""", ДанныеПроверки.Синоним), "XM-00051");	
			ИначеЕсли Не ДанныеПроверки.Заполнен Тогда
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, СтрШаблон("Не заполнен обязательный реквизит счета ""%1""", ДанныеПроверки.Синоним), "XM-00052");	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверяемыйРеквизитУВХД(Синоним)
	
	Возврат Новый Структура("Синоним, Найден, Заполнен", Синоним, Ложь, Ложь);
	
КонецФункции

Функция ВалютаСчетаУВХД(СведенияОВалюте)
	
	СоответствияКодовВалютыНаименованиям = Новый Соответствие();
	СоответствияКодовВалютыНаименованиям.Вставить("643", "RUB");
	СоответствияКодовВалютыНаименованиям.Вставить("978", "EUR");
	СоответствияКодовВалютыНаименованиям.Вставить("840", "USD");
	
	НаименованиеВалюты = СоответствияКодовВалютыНаименованиям.Получить(СведенияОВалюте.Код);
	Если НаименованиеВалюты = Неопределено Тогда
		НаименованиеВалюты = СведенияОВалюте.Наименование;
	КонецЕсли;
	
	Возврат НаименованиеВалюты;
	
КонецФункции

