#Область Счет

Процедура ЗаполнитьПлатежныеРеквизитыСчета(Приемник, Источник, ЖурналСообщений)
	
	БанковскийСчет = Источник.БанковскийСчет;
	
	Если ЗначениеЗаполнено(БанковскийСчет.НомерСчета) Тогда
		Приемник.Счет = БанковскийСчет.НомерСчета;
		
		Банк = БанковскийСчет.Банк;
		
		Если ЗначениеЗаполнено(Банк) Тогда
			
			// БИК
			Если ЗначениеЗаполнено(БанковскийСчет.БИК) Тогда
				Приемник.Банк.БИК = БанковскийСчет.БИК;
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен БИК банка " + Строка(Банк), "XM-00014",, Банк);
			КонецЕсли;
			
			// НаимБанк
			Если ЗначениеЗаполнено(БанковскийСчет.НаименованиеБанка) Тогда
				Приемник.Банк.НаимБанк = БанковскийСчет.НаименованиеБанка;
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнено наменование банка " + Строка(Банк), "XM-00014",, Банк);
			КонецЕсли;
			
			// КоррСчет
			Если ЗначениеЗаполнено(БанковскийСчет.КоррСчет) Тогда
				Приемник.Банк.Счет = БанковскийСчет.КоррСчет;
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен корр. счет банка " + Строка(Банк), "XM-00014",, Банк);
			КонецЕсли;
			
			// Город
			Если ЗначениеЗаполнено(БанковскийСчет.ГородБанка) Тогда
				Приемник.Банк.Город = БанковскийСчет.ГородБанка;
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен город банка " + Строка(Банк), "XM-00014",, Банк);
			КонецЕсли;
			
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен банк счета " + БанковскийСчет.Представление, "XM-00014",, Банк);	
		КонецЕсли;
		
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен номер банковского счета " + БанковскийСчет.Представление, "XM-00014",, Банк);
		//ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен банковский счет", "XM-00014");
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСведенияОбУчастникеСчета(Приемник, Источник, Адрес, ДанныеФормата, ЖурналСообщений)
	
	ИдСв = Приемник.ИдСв;
	
	Если Источник.ЭтоЮрЛицо Тогда // Заполнение данных юрлица
		
		СвЮЛ = ИдСв.СвЮЛ;
		СвЮЛ.НаимОрг = СокрЛП(Источник.ПолноеНаименование);
		Если Не ЗначениеЗаполнено(Источник.ПолноеНаименование) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнено полное наименование юр. лица " + Строка(Источник.Ссылка), "XM-00013",, Источник.Ссылка);
		КонецЕсли;
		СвЮЛ.ИННЮЛ = Источник.ИНН;
		Если Не ЗначениеЗаполнено(Источник.ИНН) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен ИНН юр. лица " + Строка(Источник.Ссылка), "XM-00010",, Источник.Ссылка);
		КонецЕсли;
		СвЮЛ.КПП = Источник.КПП;
		
	Иначе // физ. лицо
		
		СвФЛ = ИдСв.СвФЛ;
		СвФЛ.ИННФЛ = Источник.ИНН;
		Если Не ЗначениеЗаполнено(Источник.ИНН) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, "Не заполнен ИНН физ. лица " + Строка(Источник.Ссылка), "XM-00011",, Источник.Ссылка);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СвФЛ.ФИОИП, Источник.ФИО);
		
	КонецЕсли;
	
	// Заполнение адреса
	Если Не ПустаяСтрока(Адрес.КодРегион) И ПроверитьСоответствиеПолейАдресаФормату(Адрес, ДанныеФормата.ПространствоИмен, "АдрРФТип", ЖурналСообщений) Тогда
		АдрРФ = Приемник.Адрес.АдрРФ;
		ЗаполнитьЗначенияСвойств(АдрРФ, Адрес);
	ИначеЕсли Не ПустаяСтрока(Адрес.КодСтраны) И Не ПустаяСтрока(Адрес.Представление) Тогда
		АдрИнф = Приемник.Адрес.АдрИно;
		АдрИнф.КодСтр = Адрес.КодСтраны;
		АдрИнф.АдрТекст = Лев(СокрЛП(Адрес.Представление), 1000); // Максимальное количество символов 1000
	Иначе
		Приемник.Адрес = Неопределено;
		ТекстОшибки = "Проверьте заполнение юридического адреса участника " + Строка(Источник.Ссылка);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, ТекстОшибки, "XM-00012",, Источник.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТоварыУслугиФорматСчета(Документ, ДанныеДокумента, ДанныеФормата, Ответ)
	
	// Табличная часть
	СтТовБезНДСВсего = 0;
	СтТовУчНалВсего  = 0;
	СумНДС = 0;
	БезНДС = Истина;
	
	СведенияТаблицыСч = Документ.ТаблСч.СведТов;
	Для Каждого СтрСчета Из ДанныеДокумента.ТоварыУслуги Цикл
		
		СтрокаСведТов = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("Файл.Документ.ТаблСч.СведТов", ДанныеФормата.ПространствоИмен);
		
		СтрокаСведТов.КолТов = СтрСчета.Количество;
		СтрокаСведТов.НаимТов = СтрСчета.Наименование;
		СтрокаСведТов.НомСтр = СтрСчета.НомерСтроки;
		ТекОКЕИ = СокрЛП(СтрСчета.КодОКЕИ);
		
		Если ЗначениеЗаполнено(ТекОКЕИ) Тогда
			РезультатПроверкиОКЕИ = КорректностьОКЕИ(ТекОКЕИ);
			Если РезультатПроверкиОКЕИ.Успех = Истина Тогда
				СтрокаСведТов.ОКЕИ_Тов = ТекОКЕИ;
			Иначе 
				ОписаниеОшибкиОКЕИ = НСтр("ru = 'Некорректный код по ОКЕИ единицы измерения %1, строка №%2, товар %3: '");
				ОписаниеОшибкиОКЕИ = СтрШаблон(ОписаниеОшибкиОКЕИ, 
				СтрСчета.НаименованиеЕдиницыИзмерения, СтрСчета.НомерСтроки, СтрокаСведТов.НаимТов);
				ОписаниеОшибкиОКЕИ = ОписаниеОшибкиОКЕИ + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(РезультатПроверкиОКЕИ.Журнал);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибкиОКЕИ, "XM-00037",, ДанныеДокумента.ДокументСсылка);
			КонецЕсли;
		КонецЕсли;
		
		СтрокаСведТов.СтТовБезНДС = СтрСчета.СуммаБезНДС;
		СтрокаСведТов.СтТовУчНал = СтрСчета.СуммаСНДС;
		Если СокрЛП(НРег(СтрСчета.СтавкаНДССтрокой)) = "без ндс" Тогда
			СтрокаСведТов.СумНал.БезНДС = "без НДС";
			СтрокаСведТов.НалСт = "без НДС";
		Иначе
			СтрокаСведТов.СумНал.СумНДС = Формат(СтрСчета.СуммаНДС, "ЧГ=0;ЧРД=.;ЧН=0");
			СтрокаСведТов.НалСт = СтрСчета.СтавкаНДССтрокой;
			БезНДС = Ложь;
		КонецЕсли;
		
		СтрокаСведТов.ЦенаТов = СтрСчета.Цена;
		
		СтТовБезНДСВсего = СтТовБезНДСВсего + СтрСчета.СуммаБезНДС;
		СтТовУчНалВсего  = СтТовУчНалВсего + СтрСчета.СуммаСНДС;
		СумНДС = СумНДС + СтрСчета.СуммаНДС;
		
		СведенияТаблицыСч.Добавить(СтрокаСведТов);
		
	КонецЦикла;
	
	ВсегоОпл = Документ.ТаблСч.ВсегоОпл;
	
	ВсегоОпл.СтТовБезНДСВсего = СтТовБезНДСВсего;
	ВсегоОпл.СтТовУчНалВсего  = СтТовУчНалВсего;
	Если БезНДС Тогда
		ВсегоОпл.СумНалВсего.БезНДС = "без НДС";
	Иначе
		ВсегоОпл.СумНалВсего.СумНДС = Формат(СумНДС, "ЧГ=0;ЧРД=.;ЧН=0");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СчетУВХД

Процедура ЗаполнитьЗаголовокСчетаУВХД(ДанныеДокумента, СтруктураДокумента, ДанныеФормата, ЖурналСообщений)
	
	СтруктураЗаголовкаДокумента = СтруктураДокумента.InvoiceDetailRequest.InvoiceDetailRequestHeader;
	СтруктураЗаголовкаДокумента.invoiceID = ДанныеДокумента.ИдФайл;
	СтруктураЗаголовкаДокумента.invoiceDate = ТекущаяДатаСеанса();
	СтруктураЗаголовкаДокумента.purpose = "standard"; 
	СтруктураЗаголовкаДокумента.operation = "new";
	
	РеквизитыСчета = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураЗаголовкаДокумента, "Extrinsic", Новый Массив());
	РеквизитыСчета.Добавить(РеквизитСчетаУВХД("Num_invoice", ДанныеДокумента.Номер, ДанныеФормата));
	РеквизитыСчета.Добавить(РеквизитСчетаУВХД("Date_invoice", Формат(ДанныеДокумента.Дата, "ДФ=dd.MM.yyyy"), ДанныеФормата));
	
	ЗаполнитьСведенияОбУчастникахСчетаУВХД(ДанныеДокумента, СтруктураДокумента, ДанныеФормата, ЖурналСообщений);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОбУчастникахСчетаУВХД(ДанныеДокумента, СтруктураДокумента, ДанныеФормата, ЖурналСообщений)
	
	СведенияОбУчастниках = СтруктураДокумента.InvoiceDetailRequest.InvoiceDetailRequestHeader.InvoicePartner;
	СведенияОбУчастниках.Добавить(ПолучитьСведенияОбУчастникеСчетаУВХД("billTo", ДанныеДокумента.Продавцы[0], ДанныеФормата, ЖурналСообщений)); // role="billTo" для получателя
	СведенияОбУчастниках.Добавить(ПолучитьСведенияОбУчастникеСчетаУВХД("remitTo", ДанныеДокумента.Покупатели[0], ДанныеФормата, ЖурналСообщений)); // role="remitTo" для отправителя
	
КонецПроцедуры

Функция ПолучитьСведенияОбУчастникеСчетаУВХД(РольУчастника, ДанныеУчастника, ДанныеФормата, ЖурналСообщений)
	
	Сведения = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("Request.InvoiceDetailRequest.InvoiceDetailRequestHeader.InvoicePartner", ДанныеФормата.ПространствоИмен);
	Адрес = ДанныеУчастника.ЮридическийАдрес;
	
	Сведения.Contact.role = РольУчастника;
	Сведения.Contact.Name.__content = ДанныеУчастника.Представление;
	АдресПредставление = СокрЛП(СтрЗаменить(Адрес.Представление, Адрес.Индекс + ",", ""));
	Сведения.Contact.PostalAddress = АдресУчастникаСчетаУВХД(ДанныеФормата, Адрес.Индекс, Адрес.Город, АдресПредставление, "Российская Федерация");
	
	Реквизиты = Сведения.Contact.Extrinsic;
	Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("INN", ДанныеУчастника.ИНН, ДанныеФормата));	
	Если ДанныеУчастника.ЭтоЮрЛицо Тогда
		Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("KPP", ДанныеУчастника.КПП, ДанныеФормата));	
	КонецЕсли;
	
	Если РольУчастника = "billTo" Тогда
		
		БанковскийСчетОтправителя = ДанныеУчастника.БанковскийСчет;
		Если ККСНГ_ОбщегоНазначенияКлиентСервер.СтруктураПустая(БанковскийСчетОтправителя) Тогда
			СобытиеОшибки = "Не заполнен банковский счет организации-отправителя.";
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, СобытиеОшибки, "ACC-00001");
		Иначе 
			ПроверяемыеРеквизиты = Новый Соответствие;
			ПроверяемыеРеквизиты.Вставить("БИК", БанковскийСчетОтправителя.БИК);
			ПроверяемыеРеквизиты.Вставить("наименование банка", БанковскийСчетОтправителя.НаименованиеБанка);
			ПроверяемыеРеквизиты.Вставить("номер счета", БанковскийСчетОтправителя.НомерСчета);
			ПроверяемыеРеквизиты.Вставить("корреспондентский счет", БанковскийСчетОтправителя.КоррСчет);
			Для каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
				Если Не ЗначениеЗаполнено(ПроверяемыйРеквизит.Значение) Тогда
					СобытиеОшибки = СтрШаблон("Не заполнен обязательный реквизит ""%1"" банковского счета организации-отправителя.", ПроверяемыйРеквизит.Ключ);
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналСообщений, СобытиеОшибки, "ACC-00002");	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("BIK", БанковскийСчетОтправителя.БИК, ДанныеФормата));	
		Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("NameBank", БанковскийСчетОтправителя.НаименованиеБанка, ДанныеФормата));
		Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("IBAN", БанковскийСчетОтправителя.НомерСчета, ДанныеФормата));
		Реквизиты.Добавить(РеквизитУчастникаСчетаУВХД("CorrAcc", БанковскийСчетОтправителя.КоррСчет, ДанныеФормата));
		
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

