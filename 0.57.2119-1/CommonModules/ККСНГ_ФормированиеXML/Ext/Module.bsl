Процедура ЗаполнитьСведенияОбУчастнике(Приемник, Источник, Адрес, ДанныеФормата, ЖурналЛогирования, ЮридическийАдрес = Истина, ТипУчастникаЭДО = Неопределено)
	
	Перем АдресДляЗаполнения, УчастникЭДО;
	
	Приемник.СтруктПодр = Источник.СтруктурноеПодразделение;
	
	ИдСв = Приемник.ИдСв;
	
	Если Источник.ЭтоЮрЛицо Тогда // Заполнение данных юрлица
		
		Если Источник.Резидент Тогда
			
			СвЮЛУч = ИдСв.СвЮЛУч;
			
			Если Не ЗначениеЗаполнено(Источник.ПолноеНаименование) Тогда
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнено наименование юр.лица """ + Источник.Представление + """", "XM-00026", , Источник.Ссылка);
			Иначе
				СвЮЛУч.НаимОрг = Источник.ПолноеНаименование;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Источник.ИНН) Тогда
				ОписаниеОшибкиИНН = "";
				
				Если Не ККСНГ_ОбщегоНазначенияКлиентСервер.ИННСоответствуетТребованиям(Источник.ИНН, Источник.ЭтоЮрЛицо, ОписаниеОшибкиИНН) Тогда
					ОписаниеОшибкиИНН = "Ошибка заполнения ИНН юр.лица """ + Источник.Представление + """. " + ОписаниеОшибкиИНН;
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, ОписаниеОшибкиИНН, "XM-00027",, Источник.Ссылка);
				Иначе
					СвЮЛУч.ИННЮЛ = Источник.ИНН;
				КонецЕсли;
				
			ИначеЕсли СвЮЛУч.Свойство("ДефИННЮЛ") Тогда // 820 приказ
				СвЮЛУч.ДефИННЮЛ = "-";
			Иначе// 189 приказ
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнен ИНН юр. лица """ + Источник.Представление + """.", "XM-00027", , Источник.Ссылка);
				СвЮЛУч.ИННЮЛ = Неопределено;
			КонецЕсли; 
			
			СвЮЛУч.КПП	= Источник.КПП;
			
		Иначе // Не состоит на налоговом учёте.
			
			ИдСв.СвИнНеУч.НаимОрг = Источник.ПолноеНаименование;
			
		КонецЕсли;
		
	Иначе // физ. лицо
		
		СвИП = ИдСв.СвИП;
		
		Если ЗначениеЗаполнено(Источник.ИНН) Тогда
			
			ОписаниеОшибкиИНН = "";
			
			Если Не ККСНГ_ОбщегоНазначенияКлиентСервер.ИННСоответствуетТребованиям(Источник.ИНН, Источник.ЭтоЮрЛицо, ОписаниеОшибкиИНН) Тогда
				ОписаниеОшибкиИНН = "Ошибка заполнения ИНН физ.лица """ + Источник.Представление + """. "  + ОписаниеОшибкиИНН;
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, ОписаниеОшибкиИНН, "XM-00029",, Источник.Ссылка);
			Иначе
				СвИП.ИННФЛ = Источник.ИНН;
			КонецЕсли;
			
		ИначеЕсли СвИП.Свойство("ДефИННФЛ") Тогда // 820 приказ
			СвИП.ДефИННФЛ = "-";
		Иначе// 189 приказ
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнен ИНН физ.лица """ + Источник.Представление + """.", "XM-00029", , Источник.Ссылка);
			СвИП.ИННФЛ = Неопределено;
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(СвИП.ФИО, Источник.ФИО);
		
		СвИП.СвГосРегИП = Источник.СвидетельствоРегистрацииИП;	
		
		// Обязателен только для продавца ИП.
		Если ПустаяСтрока(Источник.СвидетельствоРегистрацииИП) И ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнены данные свидетельства о гос. регистрации организации " + Источник.Представление, "XM-00030",, Источник.Ссылка);
		КонецЕсли;	
		
		Если ПустаяСтрока(СвИП.ФИО.Фамилия) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнена фамилия " + Источник.Представление, "XM-00031",, Источник.Ссылка);
		КонецЕсли;	
		
		Если ПустаяСтрока(СвИП.ФИО.Имя) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, "Не заполнено имя " + Источник.Представление, "XM-00032",, Источник.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполнение общей информации
	Приемник.ОКПО = ?(ЗначениеЗаполнено(Источник.КодПоОКПО), Источник.КодПоОКПО, Неопределено);
	
	АдресОбязателен = (ДанныеФормата.ФункцияУПД <> "ДОП");
	
	// Заполнение адреса
	Если Не ПустаяСтрока(Адрес.КодРегион) И ПроверитьСоответствиеПолейАдресаФормату(Адрес, ДанныеФормата.ПространствоИмен, "АдрРФТип", ЖурналЛогирования) Тогда
		
		АдрРФ = Приемник.Адрес.АдрРФ;
		ЗаполнитьЗначенияСвойств(АдрРФ, Адрес);
		
	ИначеЕсли Не ПустаяСтрока(Адрес.КодСтраны) И Не ПустаяСтрока(Адрес.Представление) Тогда
		
		АдрИнф = Приемник.Адрес.АдрИнф;
		// TODO: В получение данных для БП добавить "альтернативный" метод определения кода страны через ПолучитьКодСтраныАльтернативныйМетод()
		АдрИнф.КодСтр   = Адрес.КодСтраны;
		АдрИнф.АдрТекст = Лев(СокрЛП(Адрес.Представление), 1000); // Максимальное количество символов 1000
		
	ИначеЕсли Не ПустаяСтрока(Адрес.КодГАР) Тогда
		
		Приемник.Адрес.КодГАР = Адрес.КодГАР;
		
	Иначе
		
		Приемник.Адрес = Неопределено;
		
		Если АдресОбязателен Тогда
			
			АдресДляЗаполнения = ?(ЮридическийАдрес = Истина, "юридического", "фактического"); 
			УчастникЭДО = ?(ТипУчастникаЭДО <> Неопределено, ТипУчастникаЭДО, "участника"); 
			
			ТекстОшибки = СтрШаблон("Проверьте заполнение %1 адреса %2 %3", АдресДляЗаполнения, УчастникЭДО, Источник.Представление);
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(ЖурналЛогирования, ТекстОшибки, "XM-00033", , Источник.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполнение контактной информации
	КонтактныеСведения = Приемник.Контакт;
	
	Если ТипЗнч(Источник.Телефоны) = Тип("Массив") И Источник.Телефоны.Количество() > 0 Тогда
		КонтактныеСведения.Тлф = Источник.Телефоны[0];
	КонецЕсли;
	
	Если ТипЗнч(Источник.Телефоны) = Тип("Массив") И Источник.Email.Количество() > 0 Тогда
		КонтактныеСведения.ЭлПочта = Источник.Email[0];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КонтактныеСведения.Тлф) И Не ЗначениеЗаполнено(КонтактныеСведения.ЭлПочта) Тогда
		КонтактныеСведения = Неопределено;
	КонецЕсли;
	
	// Заполнение банковских реквизитов
	БанковскиеРеквизиты = Приемник.БанкРекв;
	СвБанк = БанковскиеРеквизиты.СвБанк;
	
	Если ЗначениеЗаполнено(Источник.БанковскийСчет.НомерСчета) Тогда
		
		БанковскиеРеквизиты.НомерСчета = Источник.БанковскийСчет.НомерСчета;
		
		Если ЗначениеЗаполнено(Источник.БанковскийСчет.НаименованиеБанка) Тогда
			СвБанк.НаимБанк = Источник.БанковскийСчет.НаименованиеБанка;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Источник.БанковскийСчет.БИК) Тогда
			СвБанк.БИК = Источник.БанковскийСчет.БИК;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Источник.БанковскийСчет.КоррСчет) Тогда
			СвБанк.КорСчет = Источник.БанковскийСчет.КоррСчет;
		КонецЕсли;
		
		Если ККСНГ_ОбщегоНазначенияКлиентСервер.СтруктураПустая(СвБанк) Тогда
			СвБанк = Неопределено;
		КонецЕсли;
		
	Иначе
		БанковскиеРеквизиты = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Функция КорректностьОКЕИ(ПроверяемыйОКЕИ)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	
	ДлинаОКЕИ = СтрДлина(ПроверяемыйОКЕИ);
	Если ДлинаОКЕИ <> 3 И ДлинаОКЕИ <> 4 Тогда
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, НСтр("ru = 'Код по ОКЕИ должен состоять либо из 3, либо из 4 цифр.'"), "XM-00035");
		Ответ.Успех = Ложь;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции // КорректностьОКЕИ()

#КонецОбласти

#Область ОбработчикиФормированияЭД

Функция ПолучитьОбработчикФормированияЭД(ПрофильОрганизации, ИмяОбработчика = "")
	
	ОбработчикЭДСсылка = ПрофильОрганизации.ПодключаемыйМодуль;
	
	Если Не ПустаяСтрока(ИмяОбработчика) И ИмяОбработчика = "ОбработчикПослеФормированияЭД" Тогда
		Если Не ПрофильОрганизации.ОбработчикПослеФормированияЭД.Пустая() Тогда
			ОбработчикЭДСсылка = ПрофильОрганизации.ОбработчикПослеФормированияЭД;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбработчикЭДСсылка) Тогда
		ОбработчикЭД = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ОбработчикЭДСсылка);
	КонецЕсли;
	
	Возврат ОбработчикЭД;
	
КонецФункции

Функция ВыполнитьОбработчикПередФормированием(ДанныеДокумента, ДанныеФормата, СтандартнаяОбработка)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	
	Попытка
		ОбработчикЭД = ПолучитьОбработчикФормированияЭД(ДанныеДокумента.ПрофильОрганизации);
	Исключение
		
		ОписаниеОшибки = "Ошибка получения клиентского обработчика перед формированием XML. " + ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "XM-00053");
		Ответ.Успех = Ложь;
		
		Возврат Ответ;
		
	КонецПопытки;
	
	Если Не ОбработчикЭД = Неопределено Тогда
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		
		Попытка
			
			ДанныеДокументаОбработчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеДокумента);
			ДанныеФорматаОбработчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеФормата);
			
			РезультатОбработки = ОбработчикЭД.ВыполнитьАлгоритмПередФормированием(ДанныеДокументаОбработчик, ДанныеФорматаОбработчик, СтандартнаяОбработка, Отказ, ОписаниеОшибки);
			
			Если Не ТипЗнч(Отказ) = Тип("Булево") Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Некорректный тип значения в параметре ""Отказ"".";
			КонецЕсли;
			
			Если Не ТипЗнч(СтандартнаяОбработка) = Тип("Булево") Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Некорректный тип значения в параметре ""СтандартнаяОбработка"".";
			КонецЕсли;
			
			Если Отказ Тогда
				ТекстОшибки = "Ошибка выполнения клиентского обработчика перед формированием XML. " + Строка(ОписаниеОшибки);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00050");
			ИначеЕсли СтандартнаяОбработка Тогда
				
				Если ТипЗнч(РезультатОбработки) = Тип("Структура") Или РезультатОбработки = Неопределено Тогда
					Ответ.Результат = РезультатОбработки;
				Иначе
					Отказ = Истина;
					ТекстОшибки = "Ошибка выполнения клиентского обработчика перед формированием XML. Тип выходного параметра ""ДанныеДокумента"" не соответствует ожидаемому - ""Структура"".";
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00051");
				КонецЕсли;
				
			Иначе
				
				// TODO сделать валидацию XML ???
				Если ТипЗнч(РезультатОбработки) = Тип("Строка") И Не ПустаяСтрока(РезультатОбработки) Тогда
					Ответ.Результат = РезультатОбработки;
				Иначе
					Отказ = Истина;
					ТекстОшибки = "Ошибка выполнения клиентского обработчика перед формированием XML. Ошибка выходного параметра - ожидается сформированный текст XML.";
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00051");
				КонецЕсли;
				
			КонецЕсли;
			
			Ответ.Успех = Не Отказ;
			
		Исключение
			Ответ.Успех = Ложь;
			ТекстОшибки = "Ошибка выполнения клиентского обработчика перед формированием XML. " + ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00052");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ВыполнитьОбработчикПослеФормирования(СтруктураДокумента, ДанныеДокумента, ДанныеФормата)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	
	Попытка
		ОбработчикЭД = ПолучитьОбработчикФормированияЭД(ДанныеДокумента.ПрофильОрганизации, "ОбработчикПослеФормированияЭД");
	Исключение
		
		ОписаниеОшибки = "Ошибка получения клиентского обработчика после формирования XML. " + ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "XM-00053");
		Ответ.Успех = Ложь;
		
		Возврат Ответ;
		
	КонецПопытки;
	
	Если Не ОбработчикЭД = Неопределено Тогда
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		
		Попытка
			
			СтруктураДокументаОбработчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДокумента);
			ДанныеДокументаОбработчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеДокумента);
			ДанныеФорматаОбработчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеФормата);
			
			РезультатОбработки = ОбработчикЭД.ВыполнитьАлгоритмПослеФормирования(СтруктураДокументаОбработчик, ДанныеДокументаОбработчик, ДанныеФорматаОбработчик, Отказ, ОписаниеОшибки);
			
			Если Не ТипЗнч(Отказ) = Тип("Булево") Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Некорректный тип значения в параметре ""Отказ"".";
			КонецЕсли;
			
			Если Отказ Тогда
				ТекстОшибки = "Ошибка выполнения клиентского обработчика после формированием XML. " + Строка(ОписаниеОшибки);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00050");
			ИначеЕсли ТипЗнч(РезультатОбработки) = Тип("Структура") Или РезультатОбработки = Неопределено Тогда
				Ответ.Результат = РезультатОбработки;
			Иначе // Ошибка выходного параметра
				Отказ = Истина;
				ТекстОшибки = "Ошибка выполнения клиентского обработчика после формирования XML. Тип выходного параметра не соответствует ожидаемому - ""Структура"".";
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00053");
			КонецЕсли;
			
			Ответ.Успех = НЕ Отказ;
			
		Исключение
			Ответ.Успех = Ложь;
			ТекстОшибки = "Ошибка выполнения клиентского обработчика после формирования XML. " + ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00054");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

