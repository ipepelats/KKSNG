	Для каждого Стр Из ДанныеДокумента.ТоварыУслуги Цикл
		
		СведениеОТовареУслуге = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("Request.InvoiceDetailRequest.InvoiceDetailOrder.InvoiceDetailItem", ДанныеФормата.ПространствоИмен);
		
		СведениеОТовареУслуге.invoiceLineNumber = Стр.НомерСтроки;
		СведениеОТовареУслуге.quantity = Стр.Количество;
		СведениеОТовареУслуге.UnitOfMeasure = СокрЛП(Стр.КодОКЕИ);
		СведениеОТовареУслуге.UnitPrice.Money.currency = Валюта;
		СведениеОТовареУслуге.UnitPrice.Money.__content = Стр.Цена;
		СведениеОТовареУслуге.SubtotalAmount.Money.currency = Валюта;
		СведениеОТовареУслуге.SubtotalAmount.Money.__content = Стр.СуммаСНДС;
		СведениеОТовареУслуге.Tax.Money.currency = Валюта;
		СведениеОТовареУслуге.Tax.Money.__content = Стр.СуммаНДС;
		СведениеОТовареУслуге.Tax.Description.__content = Стр.СтавкаНДССтрокой;
		СведениеОТовареУслуге.Distribution.__content = Стр.Наименование;
		
		СведенияОТоварахУслугах.Добавить(СведениеОТовареУслуге);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИтоговуюИнформациюСчетаУВХД(ДанныеДокумента, СтруктураДокумента, ДанныеФормата)
	
	СведенияОбИтогах = СтруктураДокумента.InvoiceDetailRequest.InvoiceDetailSummary;
	Если ДанныеДокумента.ТоварыУслуги.Количество() Тогда
		
		Валюта = ДанныеДокумента.СведенияОВалюте.Наименование;
		ТоварыУслуги = ДанныеДокумента.ТоварыУслуги;
		
		СведенияОбИтогах.SubtotalAmount.Money.currency = Валюта;
		СведенияОбИтогах.SubtotalAmount.Money.__content = ТоварыУслуги.Итог("СуммаСНДС");
		
		СведенияОбИтогах.TotalAmountWithoutTax.Money.currency = Валюта;
		СведенияОбИтогах.TotalAmountWithoutTax.Money.__content = ТоварыУслуги.Итог("СуммаБезНДС");
		
		СведенияОбИтогах.Tax.Money.currency = Валюта;
		СведенияОбИтогах.Tax.Money.__content = ТоварыУслуги.Итог("СуммаНДС");
		СведенияОбИтогах.Tax.Description.__content = ТоварыУслуги[0].СтавкаНДССтрокой;
		
	КонецЕсли;
	
КонецПроцедуры

