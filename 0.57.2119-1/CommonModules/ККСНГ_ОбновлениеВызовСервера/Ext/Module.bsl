Функция ПолучитьРасширение(ИмяРасширения)
	
	РасширениеКонфигурации = Неопределено;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Имя", ИмяРасширения);

	УстановитьПривилегированныйРежим(Истина);

	МассивРасширений = РасширенияКонфигурации.Получить(СтруктураОтбора);		
	Если МассивРасширений.Количество() > 0 Тогда
		РасширениеКонфигурации = МассивРасширений[0];		
	КонецЕсли;
	
	Возврат РасширениеКонфигурации;
	
КонецФункции

Функция ПолучитьТекущуюВерсиюРасширения(ИмяРасширения)
	
	ТекущаяВерсия = Неопределено;
	
	РасширениеКонфигурации = ПолучитьРасширение(ИмяРасширения);
	
	Если РасширениеКонфигурации <> Неопределено Тогда
		ТекущаяВерсия = РасширениеКонфигурации.Версия;		
	КонецЕсли;
	
	Возврат ТекущаяВерсия;
	
КонецФункции

