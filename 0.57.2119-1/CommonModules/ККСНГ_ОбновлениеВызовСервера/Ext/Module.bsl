#Область СлужебныйПрограммныйИнтерфейс

#Область APIСервисаОбновлений

// Проверяет есть ли на сервисе новая версия продукта.
//
// Параметры:
//	ИмяПродукта 			- строка - Имя расширения.
//	ТекущаяВерсия			- строка - Версия утановленного расширения.
//	РежимТест				- булево - Признак загрузки тестового обновления.
//	Upd_AuthToken			- строка - Авторизационный токен.
//
// Возвращаемое значение: 
//	Результат 				- булево - Истина - на сервисе есть новая версия.
//
Функция UpdateExists(ИмяПродукта, ТекущаяВерсия, РежимТест = Ложь) Экспорт

	СтруктураЗапроса = ПолучитьСтруктуруЗапроса();
	СтруктураЗапроса.Метод = "GET";
	ИмяМетода = "/cnup/" + ИмяПродукта + "/" + ТекущаяВерсия + "/" + ?(РежимТест, "ТЕСТОВЫЙ", "ПРОМЫШЛЕННЫЙ");
	СтруктураЗапроса.Адрес = СтруктураЗапроса.Адрес + ИмяМетода;

	Возврат ВызватьМетодИОбработатьРезультат(СтруктураЗапроса, Тип("Булево"), "Вызов API сервиса обновлений: " + ИмяМетода);
	
КонецФункции

// Получает с сервиса обновлений двоичные данные zip архива актуальной версии продукта.
//
// Параметры:
//	ИмяПродукта 	- строка - Название продукта на сервисе.
//	РежимТест		- булево - Признак загрузки тестового обновления.
//	Upd_AuthToken		- строка - Авторизационный токен.
//
// Возвращаемое значение: 
//
//	АрхивОбновления 	- ДвоичныеДанные - zip архив актуальной версии продукта.
//
Функция GetLastUpdate(ИмяПродукта, РежимТест = Ложь) Экспорт

	СтруктураЗапроса = ПолучитьСтруктуруЗапроса();
	СтруктураЗапроса.Метод = "GET";
	ИмяМетода = "/downloadlastproduct/" + ИмяПродукта + "/" + ?(РежимТест, "ТЕСТОВЫЙ", "ПРОМЫШЛЕННЫЙ");
	СтруктураЗапроса.Адрес = СтруктураЗапроса.Адрес + ИмяМетода;

	Возврат ВызватьМетодИОбработатьРезультат(СтруктураЗапроса, Тип("ДвоичныеДанные"), "Вызов API сервиса обновлений: " + ИмяМетода);
	
КонецФункции

#КонецОбласти

#Область ПакетОбновления

// Получение обновления
//
// Параметры:
//	ДДАрхиваОбновления       - Двоичные данные
//
// Возвращаемое значение:
//	Структура
//   * ИсторияВерсий      
//   * ОсновнойМодуль 
//   * НастройкиПодключаемыхМодулей 
//
Функция ПакетОбновленияИзАрхива(ДДАрхиваОбновления) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Загрузка обновления ККСНГ_Курьер");

	ПакетОбновления = Новый Структура;
	ПакетОбновления.Вставить("ИсторияВерсий", Неопределено);
	ПакетОбновления.Вставить("ОсновнойМодуль", Неопределено);
	ПакетОбновления.Вставить("НастройкиПодключаемыхМодулей", Неопределено); 
	
	ИмяКаталогаОбновления = ПолучитьИмяВременногоФайла();
		
	// 1. Распаковка архива
	ОбработкаРаспаковки = РаспаковатьАрхивОбновления(ДДАрхиваОбновления, ИмяКаталогаОбновления);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОбработкаРаспаковки.Журнал, Ложь);
	Если Не ОбработкаРаспаковки.Успех Тогда
		УдалитьКаталогОбновления(ИмяКаталогаОбновления, Ответ.Журнал);
		Возврат Ответ;
	КонецЕсли;
	
	// 2. Получение двоичных данных основного модуля
	ОбработкаДвоичныхДанныхОсновногоМодуля = ПолучитьДвоичныеДанныеОсновногоМодуля(ИмяКаталогаОбновления);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОбработкаДвоичныхДанныхОсновногоМодуля.Журнал, Ложь);
	Если Не ОбработкаДвоичныхДанныхОсновногоМодуля.Успех Тогда
		УдалитьКаталогОбновления(ИмяКаталогаОбновления, Ответ.Журнал);
		Возврат Ответ;
	КонецЕсли;
	ПакетОбновления.ОсновнойМодуль = ОбработкаДвоичныхДанныхОсновногоМодуля.Результат;
	
	// 3. История версий обновления
	ОбработкаИсторииВерсий = ПолучитьИсториюВерсий(ИмяКаталогаОбновления);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОбработкаИсторииВерсий.Журнал, Ложь);
	Если ОбработкаИсторииВерсий.Успех Тогда		
		ПакетОбновления.ИсторияВерсий = ОбработкаИсторииВерсий.Результат;
	КонецЕсли;
	
	// 4. Настройки подключаемых модулей
	ОбработкаПолученияНастроек = ПолучитьНастройкиПодключаемыхМодулей(ИмяКаталогаОбновления);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОбработкаПолученияНастроек.Журнал, Ложь);	
	Если ОбработкаПолученияНастроек.Успех Тогда
		ПакетОбновления.НастройкиПодключаемыхМодулей = ОбработкаПолученияНастроек.Результат;
	КонецЕсли; 
	
	// 4.1 Получение двоичных данных подключаемых модулей
	Если ПакетОбновления.НастройкиПодключаемыхМодулей <> Неопределено Тогда
		ЗапросДанныхПодключаемыхМодулей = ПолучитьДвоичныеДанныеПодключаемыхМодулей(ИмяКаталогаОбновления,
																					 ПакетОбновления.НастройкиПодключаемыхМодулей.ПодключаемыеМодулиДляУстановки);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныхПодключаемыхМодулей.Журнал, Ложь);	
		Если Не ЗапросДанныхПодключаемыхМодулей.Успех Тогда
			УдалитьКаталогОбновления(ИмяКаталогаОбновления, Ответ.Журнал);
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;
		
	УдалитьКаталогОбновления(ИмяКаталогаОбновления, Ответ.Журнал);
	
	Ответ.Результат = ПакетОбновления;
	Ответ.Успех = Истина;
		
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область ОбработчикиОбновлений

// Устанавливает СпособАвторизации = ApiKey для пустых значений справочника ККСНГ_Организации
//
// Параметры:
//	нет
//
Процедура ОбновитьЭлементыСправочникаККСНГОрганизации() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ККСНГ_Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|ГДЕ
	|	ККСНГ_Организации.СпособАвторизации = ЗНАЧЕНИЕ(Перечисление.ККСНГ_СпособыАвторизацииКурьер.ПустаяСсылка)";
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СправочникОбъект.СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ApiKey;
			СправочникОбъект.Записать();
		Исключение
			Продолжить;	
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает значения по умолчанию реквизитов справочника ККСНГ_ЭлектронныеДокументы
//
// Параметры:
//	нет
//
Процедура ОбновитьЭлементыСправочникаККСНГЭлектронныеДокументы() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка
