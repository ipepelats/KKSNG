// Проверяет необходимость обновления и обновляет список доступных действий для существующих документов
//
// Параметры:
//  нет
// 
//
Процедура ПроверитьИВыполнитьЗаполнениеДоступныхДействийДокументов() Экспорт
	
	Если Не РегистрыСведений.ККСНГ_Служебный.ОбновлятьДоступныеДействияДокументов() Тогда
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
		|ГДЕ
		|	НЕ ККСНГ_ЭлектронныеДокументы.ПометкаУдаления";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ККСНГ_ЭлектронныеДокументы.ЗаполнитьДоступныеДействияКурьер(ДокументОбъект);
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.Записать();
		КонецЦикла;
				
		РегистрыСведений.ККСНГ_Служебный.УстановитьОбновлениеДоступныхДействийДокументовЗавершен(Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает значение реквизита "НаправлениеЭД" для элементов справочника "электронные документы"
//
// Параметры:
//	нет
//
Процедура ЗаполнитьНаправлениеЭД() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
		|ГДЕ
		|	ККСНГ_ЭлектронныеДокументы.НаправлениеЭД = &ПустоеНаправлениеЭД";
		
	Запрос.УстановитьПараметр("ПустоеНаправлениеЭД", ПредопределенноеЗначение("Перечисление.ККСНГ_НаправленияЭД.ПустаяСсылка"));	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ДокументОбъект.НаправлениеЭД = ?(ДокументОбъект.КодЭДОВладельца = ДокументОбъект.SellerCode, 
												Перечисления.ККСНГ_НаправленияЭД.Исходящий, 
														Перечисления.ККСНГ_НаправленияЭД.Входящий);
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
				Продолжить;	
			КонецПопытки;	
		КонецЦикла;
	КонецЕсли;
	   
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Устанавливает значения по умолчанию для настроек
//
Процедура ЗаполнитьЗначенияНастроекПоУмолчанию() Экспорт
	
	СоответствияНастройкиЗначению = Новый Соответствие();
	СоответствияНастройкиЗначению.Вставить(РегистрыСведений.ККСНГ_Настройки.УИД_ИспользованиеБизнесПроцессаУВХД(), Истина);
	
	НастройкаПроксиСервераПоУмолчанию = Новый Соответствие;
	НастройкаПроксиСервераПоУмолчанию.Вставить("ИспользоватьПрокси", Ложь);
	НастройкаПроксиСервераПоУмолчанию.Вставить("Пользователь", "");
	НастройкаПроксиСервераПоУмолчанию.Вставить("Пароль", "");
	НастройкаПроксиСервераПоУмолчанию.Вставить("Сервер", "");
	НастройкаПроксиСервераПоУмолчанию.Вставить("Порт", "");
	НастройкаПроксиСервераПоУмолчанию.Вставить("ИспользоватьСистемныеНастройки", Ложь);
	НастройкаПроксиСервераПоУмолчанию.Вставить("ИспользоватьАутентификациюОС", Ложь);
	СоответствияНастройкиЗначению.Вставить(РегистрыСведений.ККСНГ_Настройки.УИД_НастройкаПроксиСервера(), НастройкаПроксиСервераПоУмолчанию);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого СоответствиеНастройкиЗначению Из СоответствияНастройкиЗначению Цикл
		ЗапросНаличиеНастройки = РегистрыСведений.ККСНГ_Настройки.ПроверитьНаличиеНастройки(СоответствиеНастройкиЗначению.Ключ);
		Если ЗапросНаличиеНастройки.Успех И Не ЗапросНаличиеНастройки.Результат Тогда
			РегистрыСведений.ККСНГ_Настройки.УстановитьЗначение(СоответствиеНастройкиЗначению.Значение, СоответствиеНастройкиЗначению.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОбновитьПовторноИспользуемыеЗначения();
		
КонецПроцедуры

// Выполняет заполнение регистра связанных документов в соответствии с новой структурой
//
Процедура ОбновитьДанныеСвязанныхДокументов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ККСНГ_СвязанныеДокументы.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.ККСНГ_СвязанныеДокументы КАК ККСНГ_СвязанныеДокументы
	|ГДЕ
	|	ККСНГ_СвязанныеДокументы.Удалить_СвязанныйДокумент <> НЕОПРЕДЕЛЕНО
	|		ИЛИ ККСНГ_СвязанныеДокументы.КлючСтроки = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЭлектронныйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭлектронныйДокумент";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Попытка
		ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Возврат;
	КонецПопытки;
		
	Пока ВыборкаДокументов.Следующий() Цикл
		
		НачатьТранзакцию();
	
		Попытка
			
			БлокировкаДанных = Новый БлокировкаДанных();
			
			ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ККСНГ_СвязанныеДокументы");
			ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ВыборкаДокументов.ЭлектронныйДокумент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();
		
			НаборЗаписей = РегистрыСведений.ККСНГ_СвязанныеДокументы.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ВыборкаДокументов.ЭлектронныйДокумент);
			НаборЗаписей.Прочитать();
			
			ТаблицаЗаписей = НаборЗаписей.Выгрузить();
			ТаблицаЗаписей.Сортировать("Дата УБЫВ, Удалить_СвязанныйДокумент УБЫВ");
			
			Для каждого СтрокаЗаписи Из ТаблицаЗаписей Цикл
				
				Если СтрокаЗаписи.Удалить_СвязанныйДокумент <> Неопределено Тогда
					СтрокаЗаписи.СвязанныйДокумент = СтрокаЗаписи.Удалить_СвязанныйДокумент;
				КонецЕсли;
												
				СтрокаЗаписи.Удалить_СвязанныйДокумент = Неопределено;
				СтрокаЗаписи.КлючСтроки = ТаблицаЗаписей.Индекс(СтрокаЗаписи) + 1;
											
			КонецЦикла;	
			
			НаборЗаписей.Загрузить(ТаблицаЗаписей);
			НаборЗаписей.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОписаниеОшибки = ОписаниеОшибки();				                                                                                
		КонецПопытки;
				
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

