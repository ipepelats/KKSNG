
#Область ПрограммныйИнтерфейс

// Инфо по модулям решения 1С Адаптер
//
// Параметры:
//   нет
//
// Возвращаемое значение:
//  Структура
//   ИмяВСервисеОбновлений                 - Строка
//   ИмяРасширения                         - Строка
//   ИмяФайлаРасширения                    - Строка
//   ИмяМакетаНастройкиПодключаемыхМодулей - Строка
//
Функция ИнформацияОПродукте() Экспорт
	
	СтруктураПродукта = Новый Структура();
	
	Если РегистрыСведений.ККСНГ_Служебный.ОбновленияИзТестовогоРепозитория() Тогда
		СтруктураПродукта.Вставить("ИмяВСервисеОбновлений", 				"ККСНГ_Тестовый");
	Иначе				
		СтруктураПродукта.Вставить("ИмяВСервисеОбновлений", 				"ККСНГ_Курьер");		
	КонецЕсли;
	
	СтруктураПродукта.Вставить("ИмяРасширения",         				"ККСНГ_Курьер");
	СтруктураПродукта.Вставить("ИмяФайлаРасширения",					"ККСНГ_Курьер.cfe");
	СтруктураПродукта.Вставить("ИмяМакетаНастройкиПодключаемыхМодулей",	"ККСНГ_НастройкиПодключаемыхМодулей.mxl");
	
	Возврат СтруктураПродукта;
	
КонецФункции

// Проверка наличия обновления на сайте
// см. cnup
//
// Параметры:
//   РежимТест            - Булево
//
// Возвращаемое значение:
// см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//
Функция ПроверитьНаличиеОбновления(РежимТест = Ложь) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Проверка наличия обновлений ККСНГ_Курьер");
	
	ИнформацияОПродукте = ИнформацияОПродукте(); 
	
	ИмяРасширения           = ИнформацияОПродукте.ИмяРасширения;
	ИмяВСервисеОбновлений   = ИнформацияОПродукте.ИмяВСервисеОбновлений;
	ТекущаяВерсияРасширения = ПолучитьТекущуюВерсиюРасширения(ИмяРасширения);
		
	Если ЗначениеЗаполнено(ТекущаяВерсияРасширения) Тогда
		
		ПроверкаНаличияОбновления = UpdateExists(ИмяВСервисеОбновлений, ТекущаяВерсияРасширения, РежимТест);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПроверкаНаличияОбновления.Журнал, Ложь);
		Ответ.Успех         = ПроверкаНаличияОбновления.Успех;
		Ответ.Результат     = ПроверкаНаличияОбновления.Результат;
		
	Иначе 
		ТекстОшибки = "Не удалось найти обновляемое расширение %1.";
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяРасширения);					
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00001");	
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Загрузка обновления с сайта
// см. downloadlastproduct
//
// Параметры:
//   РежимТест            - Булево
//
// Возвращаемое значение:
// см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//
Функция ЗагрузитьОбновление(РежимТест = Ложь) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Загрузка обновления ККСНГ_Курьер");
	
	ИнформацияОПродукте = ИнформацияОПродукте(); 
	
	ИмяРасширения = ИнформацияОПродукте.ИмяРасширения;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Имя", ИмяРасширения);

	ПроверкаОбновления = ПроверитьНаличиеОбновления();
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПроверкаОбновления.Журнал, Ложь);
	
	Если ПроверкаОбновления.Успех Тогда
	
		ЗапросОбновления = GetLastUpdate(ИнформацияОПродукте.ИмяВСервисеОбновлений, РежимТест);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОбновления.Журнал, Ложь);
		
		Если ЗапросОбновления.Успех Тогда
						  
			ЗапросФайловОбновления = ПакетОбновленияИзАрхива(ЗапросОбновления.Результат);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросФайловОбновления.Журнал, Ложь);
			
			Ответ.Результат = ЗапросФайловОбновления.Результат;
			Ответ.Успех     = ЗапросФайловОбновления.Успех;			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

// Установка обновления
//
// Параметры:
//	ПакетОбновления  - Структура
//   * ИсторияВерсий      
//   * ОсновнойМодуль 
//   * НастройкиПодключаемыхМодулей 
//   РежимТест       - Булево
//
// Возвращаемое значение:
// см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//
Функция УстановитьОбновление(ПакетОбновления, РежимТест = Ложь) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Установка обновлений ККСНГ_Курьер");
	
	ИнформацияОПродукте = ИнформацияОПродукте();	
	ИмяРасширения = ИнформацияОПродукте.ИмяРасширения;
	ОсновноеРасширениеКонфигурации = ПолучитьРасширение(ИмяРасширения);	
	
	Если ОсновноеРасширениеКонфигурации <> Неопределено Тогда
		
		Если ТипЗнч(ПакетОбновления.ОсновнойМодуль) = Тип("ДвоичныеДанные") Тогда
			
			Попытка
				УстановитьПривилегированныйРежим(Истина);
				ОсновноеРасширениеКонфигурации.Записать(ПакетОбновления.ОсновнойМодуль);
				УстановитьПривилегированныйРежим(Ложь);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ТекстОшибки = "Не удалось установить расширение %1. " + ОписаниеОшибки;
				ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяРасширения);					
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00002");
				Возврат Ответ;				
			КонецПопытки;
		
		Иначе
			ТекстОшибки = "Не удалось получить данные обновляемого расширения %1.";
			ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяРасширения);					
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00003");
			Возврат Ответ;
		КонецЕсли;
		
	Иначе
		ТекстОшибки = "Не удалось найти обновляемое расширение %1.";
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяРасширения);					
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00004");
		Возврат Ответ;
	КонецЕсли;
	
	Если ПакетОбновления.НастройкиПодключаемыхМодулей <> Неопределено Тогда 
		
		ПодключаемыеМодулиДляУстановки = ПакетОбновления.НастройкиПодключаемыхМодулей.ПодключаемыеМодулиДляУстановки;
		УстановкаМодулей = ККСНГ_ПодключаемыеМодулиВызовСервера.УстановитьОбновитьПодключаемыеМодули(ПодключаемыеМодулиДляУстановки);
		
		Если НЕ УстановкаМодулей.Успех Тогда
			ТекстОшибки = УстановкаМодулей.ОписаниеОшибки;					
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;

	Ответ.Успех = Истина;
	Возврат Ответ;
	
КонецФункции
 
#Область ПрограммныйИнтерфейсФоновыхЗаданий

// Проверка наличия обновления с возвратом адреса результата
//
// Параметры:
//	АдресРезультата       - Строка - адрес хранилища загруженного обновления
//   РежимТест            - Булево
//
Процедура ПроверитьНаличиеОбновленияВФоновомЗадании(АдресРезультата, РежимТест = Ложь) Экспорт
	
	Ответ = ПроверитьНаличиеОбновления(РежимТест);
	ПоместитьВоВременноеХранилище(Ответ, АдресРезультата);
	
КонецПроцедуры

// Загрузка обновления с возвратом адреса результата
//
// Параметры:
//	АдресРезультата       - Строка - адрес хранилища загруженного обновления
