#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтруктуруЗапроса()

	СтруктураЗапроса = ККСНГ_ТранспортHTTPКлиентСервер.ПолучитьСтруктуруЗапроса();

	СтруктураЗапроса.Адрес = "https://update.esphere.ru/api/products";
	
	СтруктураЗапроса.Заголовки.Вставить("Accept", "application/json");
	СтруктураЗапроса.Заголовки.Вставить("Content-Type", "application/json");
	СтруктураЗапроса.Заголовки.Вставить("Accept-Language", "ru");
	СтруктураЗапроса.Заголовки.Вставить("Accept-Charset", "utf-8");
	СтруктураЗапроса.Заголовки.Вставить("Content-Language", "ru");
	СтруктураЗапроса.Заголовки.Вставить("Content-Charset", "utf-8");
	
	Возврат СтруктураЗапроса;

КонецФункции

Функция ВызватьМетодИОбработатьРезультат(СтруктураЗапроса, ТипРезультата = Неопределено, ЗаголовокЖурнала = "")

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ККСНГ_ТранспортHTTPКлиентСервер.ЗаполнитьПараметрыПрокси(СтруктураЗапроса);
	
	СтруктураЗапроса.МаксРедиректов = 2;
	ОтветAPI = ККСНГ_ТранспортHTTPКлиентСервер.ВыполнитьHTTPМетод(СтруктураЗапроса);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтветAPI.Журнал);
	
	Если ОтветAPI.Успех И ТипЗнч(ОтветAPI.Результат) = Тип("HTTPОтвет") Тогда
		
		Попытка

			// Обрабатываем результат
			Если ТипРезультата = Тип("ДвоичныеДанные") Тогда
				
				Ответ.Результат = ОтветAPI.Результат.ПолучитьТелоКакДвоичныеДанные();
				
			Иначе 
				
				СтрокаОтвета = ОтветAPI.Результат.ПолучитьТелоКакСтроку();
				
				Если ТипРезультата = Тип("Булево") Тогда
				
					СтрокаОтвета = СокрЛП(НРег(СтрокаОтвета));
					Если ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЦифрыВСтроке(СтрокаОтвета) Тогда
						Ответ.Результат = Число(СтрокаОтвета) <> 0;
					ИначеЕсли СтрокаОтвета = "true" ИЛИ СтрокаОтвета = "истина" Тогда
						Ответ.Результат = Истина;
					Иначе
						Ответ.Результат = Ложь;
					КонецЕсли;
					
				Иначе 
					Ответ.Результат = СтрокаОтвета;
				КонецЕсли;	
				
			КонецЕсли;
			
			Ответ.Успех = Истина;

		Исключение

			// Не удалось прочитать XML
			ОписаниеОшибки = ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка обработки ответа API сервиса обновлений", "XT-00013", ОписаниеОшибки);

		КонецПопытки;

	ИначеЕсли ОтветAPI.КодОшибки < 500 И ТипЗнч(ОтветAPI.Результат) = Тип("HTTPОтвет") Тогда

		Попытка

			ИсходныеДанные = ОтветAPI.Результат.ПолучитьТелоКакСтроку();
			ОбъектXDTO = ККСНГ_APIКурьер.ПолучитьОбъектXDTO(ИсходныеДанные, "http://www.cc.org/Errors", "BodyRoot", Истина);
			ДанныеОшибки = ККСНГ_APIКурьер.ПолучитьСтруктуруПоОбъектуXDTO(ОбъектXDTO);

			// Пробежим по всем вариантам и добавим в журнал, если есть данные.
			Для Каждого Элемент Из ДанныеОшибки Цикл

				ОписаниеОшибки = Элемент.Значение;

				Если НЕ ТипЗнч(ОписаниеОшибки) = Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;

				КодОшибки = "ER-00000";
				ТекстОшибки = "";
				ОписаниеОшибки.Свойство("ErrorNumber", КодОшибки);
				ОписаниеОшибки.Свойство("Message", ТекстОшибки);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, КодОшибки);

			КонецЦикла;

		Исключение

			ОписаниеОшибки = ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ОписаниеОшибки,
													"Не удалось прочитать текст ошибки сервиса обновлений.");

		КонецПопытки;
		
	КонецЕсли;

	Возврат Ответ;

КонецФункции

#Область ПакетОбновления

Функция РаспаковатьАрхивОбновления(ДвоичныеДанныеАрхива, ИмяКаталогаОбновления)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Распаковка архива обновления");
		
	Попытка		
		СоздатьКаталог(ИмяКаталогаОбновления);		
	Исключение
		ТекстОшибки = "Не удалось создать каталог временных файлов обновления %1 по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяКаталогаОбновления);		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00002");
		Возврат Ответ;		
	КонецПопытки;
	
	Попытка
		
		ПотокАрхива = ДвоичныеДанныеАрхива.ОткрытьПотокДляЧтения();
		
		Архив = Новый ЧтениеZipФайла(ПотокАрхива);
		Архив.ИзвлечьВсе(ИмяКаталогаОбновления, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		Архив.Закрыть();
		
		ПотокАрхива.Закрыть();
		
	Исключение		
		ТекстОшибки = "Не удалось распаковать архив с обновлением по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00003");
		Возврат Ответ;		
	КонецПопытки;
	
	Ответ.Успех = Истина;
	Возврат Ответ;
	
КонецФункции	

Функция ПолучитьИсториюВерсий(ИмяКаталогаОбновления)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Получение истории версий");
	
	ТекстДок = Новый ТекстовыйДокумент;	
	ИмяФайлаИстории = ИмяКаталогаОбновления + "\Info.html";
	
	Попытка
		ТекстДок.Прочитать(ИмяФайлаИстории, КодировкаТекста.UTF8);
		Ответ.Результат = ТекстДок.ПолучитьТекст();
	Исключение	
		ТекстОшибки = "Не удалось получить историю версий из файла %1 пакета обновлений по причине: ";
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяФайлаИстории) + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());			
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00004");
		Возврат Ответ;
	КонецПопытки;
	
	Ответ.Успех = Истина;
	Возврат Ответ;

КонецФункции

Функция ПолучитьДвоичныеДанныеОсновногоМодуля(ИмяКаталогаОбновления)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Получение двоичных данных основного модуля");
		
	ИмяФайлаРасширения = ИмяКаталогаОбновления + "\" + ИнформацияОПродукте().ИмяФайлаРасширения;
	ФайлРасширения = Новый Файл(ИмяФайлаРасширения);
	
	Если ФайлРасширения.Существует() Тогда
		
		Попытка
			ДвоичныеДанныеОсновногоМодуля = Новый ДвоичныеДанные(ФайлРасширения.ПолноеИмя);
		Исключение
			ТекстОшибки = "Не удалось получить основного модуля из файла %1 по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон(ТекстОшибки, ФайлРасширения.ПолноеИмя);			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00007");
			Возврат Ответ;	
		КонецПопытки;
		
		Ответ.Результат = ДвоичныеДанныеОсновногоМодуля;
		
	Иначе
		ТекстОшибки = "Не удалось найти файл %1 основного модуля";
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяФайлаРасширения);			
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00008");
		Возврат Ответ;	
	КонецЕсли;			
	
	Ответ.Успех = Истина;
	Возврат Ответ; 
	
КонецФункции

Функция ПолучитьНастройкиПодключаемыхМодулей(ИмяКаталогаОбновления)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Получение списка подключаемых модулей");
	
	ИмяФайлаНастроек = ИмяКаталогаОбновления + "\" + ИнформацияОПродукте().ИмяМакетаНастройкиПодключаемыхМодулей;
	
	Попытка
		ТабДокНастроек = Новый ТабличныйДокумент;
		ТабДокНастроек.Прочитать(ИмяФайлаНастроек, СпособЧтенияЗначенийТабличногоДокумента.Значение);	
				
	Исключение		
		ТекстОшибки = "Не удалось получить список подключаемых модулей из файла %1 пакета обновлений по причине: ";
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяФайлаНастроек) + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());			
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00006");
		Возврат Ответ;		
	КонецПопытки;
	
	
	НастройкиПодключаемыхМодулей = ККСНГ_ПодключаемыеМодулиВызовСервера.ПроверитьНеобходимостьОбновленияПодключаемыхМодулей(ТабДокНастроек);
	
	Ответ.Успех = НастройкиПодключаемыхМодулей.ПодключаемыеМодулиДляУстановки.Количество();
	Ответ.Результат = НастройкиПодключаемыхМодулей;
	
	Возврат Ответ;

КонецФункции

Функция ПолучитьДвоичныеДанныеПодключаемыхМодулей(ИмяКаталогаОбновления, МассивПодключаемыхМодулей)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Получение двоичных данных подключаемых модулей");
	
	// Получение двоичных данных из настроек
	Для Каждого ПодключемыйМодуль Из МассивПодключаемыхМодулей Цикл
		
		ИмяФайлаМакета = ИмяКаталогаОбновления + "\" + ПодключемыйМодуль.ИмяМакета;
		ФайлМакета = Новый Файл(ИмяФайлаМакета);
		
		Если ФайлМакета.Существует() Тогда
			Попытка
				ДвоичныеДанныеПМ = Новый ДвоичныеДанные(ФайлМакета.ПолноеИмя);
			Исключение
				ТекстОшибки = "Не удалось получить подключаемого модуля из файла %1 по причине: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстОшибки = СтрШаблон(ТекстОшибки, ФайлМакета.ПолноеИмя);			
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00007");
				Возврат Ответ;	
			КонецПопытки;
			
			ПодключемыйМодуль.Вставить("ДвоичныеДанные", ДвоичныеДанныеПМ);
			
		Иначе
			ТекстОшибки = "Не удалось найти файл %1 подключаемого модуля";
			ТекстОшибки = СтрШаблон(ТекстОшибки, ИмяФайлаМакета);			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UD-00008");
			Возврат Ответ;	
		КонецЕсли;
				
	КонецЦикла;
	
	Ответ.Успех = Истина;
	Возврат Ответ; 
	
КонецФункции

