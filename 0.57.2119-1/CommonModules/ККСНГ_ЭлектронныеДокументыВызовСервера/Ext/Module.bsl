// Отбор документов по фильтру действий
//
// Параметры:
//	ЭлектронныеДокументы  - ККСНГ_ЭлектронныеДокументы
//	ДействияОтбора        - Строка - доступные действия
//
// Возвращаемое значение:
//	Массив ссылок
//
Функция ОтобратьЭлектронныеДокументыПоДействию(ЭлектронныеДокументы, ДействияОтбора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументыDocumentActions.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы.DocumentActions КАК ККСНГ_ЭлектронныеДокументыDocumentActions
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументыDocumentActions.Ссылка В(&ЭлектронныеДокументы)
	|	И ККСНГ_ЭлектронныеДокументыDocumentActions.Action В(&Actions)";
	
	Запрос.УстановитьПараметр("ЭлектронныеДокументы", ЭлектронныеДокументы);
	Запрос.УстановитьПараметр("Actions", СтрРазделить(ДействияОтбора, ", ", Ложь));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Получает доступность действий по документам
//
// Параметры:
//	ЭлектронныйДокумент  - ККСНГ_ЭлектронныеДокументы
//	ДействияОтбора        - Строка - доступные действия
//
// Возвращаемое значение:
//	Соответствие НазваниеДействия - Булево
//
Функция ДоступностьДействийДокумента(ЭлектронныйДокумент, ДействияОтбора) Экспорт

	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДействий.Действие КАК Действие
	|ПОМЕСТИТЬ ТаблицаДействий
	|ИЗ
	|	&ТаблицаДействий КАК ТаблицаДействий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДействий.Действие КАК Действие,
	|	ВЫБОР
	|		КОГДА ККСНГ_ЭлектронныеДокументыDocumentActions.НомерСтроки ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Доступно
	|ИЗ
	|	ТаблицаДействий КАК ТаблицаДействий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_ЭлектронныеДокументы.DocumentActions КАК ККСНГ_ЭлектронныеДокументыDocumentActions
	|		ПО ТаблицаДействий.Действие = ККСНГ_ЭлектронныеДокументыDocumentActions.Action
	|			И (ККСНГ_ЭлектронныеДокументыDocumentActions.Ссылка = &ЭлектронныйДокумент)";

	МассивДействий = СтрРазделить(ДействияОтбора, ",", Ложь);

	ТаблицаДействий = Новый ТаблицаЗначений;
	ТаблицаДействий.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	Для каждого ТекущееДействие Из МассивДействий Цикл
	    СтрокаДействия = ТаблицаДействий.Добавить();
		СтрокаДействия.Действие = СокрЛП(ТекущееДействие);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТаблицаДействий", ТаблицаДействий);
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Действие, Выборка.Доступно);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

