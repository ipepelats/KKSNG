#Область ДеревоПодчиненностиДокумента

Процедура ИнициализацияДереваПодчиненностиЭД(ДеревоОбъект, РеквизитыДокумента, ЭтоВходящий)
	
	КорневойЭлемент = ДеревоОбъект.Строки.Добавить();	
	КорневойЭлемент.РасширенныйТип = "Document";
	КорневойЭлемент.Представление = Строка(РеквизитыДокумента.Ссылка);
	КорневойЭлемент.Структурирован = ЭтоСтруктурированныйЭД(РеквизитыДокумента.DocumentTypeCode);	 
	
	// TODO направление
	НаправлениеДокумента = ?(ЭтоВходящий, "In", "Out");	
	КорневойЭлемент.Направление = НаправлениеДокумента;
	
	// TODO статусы
	КорневойЭлемент.Статус = РеквизитыДокумента.StatusName;	
	
	ПараметрыФормированияСтрок = ПараметрыФормированияСтрокДерева(РеквизитыДокумента.DocumentTypeCode);
	ДобавитьСтрокиВДеревоПодчиненностиЭД(КорневойЭлемент, ЭтоВходящий, ПараметрыФормированияСтрок);
		
КонецПроцедуры

Функция ПараметрыФормированияСтрокДерева(КодТипаДокумента)
	
	Параметры = Новый Структура;
	
	Если КодТипаДокумента = "UPD_SF" Или КодТипаДокумента = "UCD_CSF" Тогда
		Параметры.Вставить("ЭтоУПД", Истина);	
		Параметры.Вставить("ЭтоСЧФ", Истина);	
	ИначеЕсли КодТипаДокумента = "UPD_SF_DOP" Или КодТипаДокумента = "UCD_CSF_DIC" Тогда 		
		Параметры.Вставить("ЭтоУПД", Истина);	
		Параметры.Вставить("ЭтоСЧФ", Истина);	
		Параметры.Вставить("ЭтоДОП", Истина);
	ИначеЕсли КодТипаДокумента = "UPD_DOP" Или КодТипаДокумента = "UCD_DIC" Тогда 
		Параметры.Вставить("ЭтоУПД", Истина);	
		Параметры.Вставить("ЭтоДОП", Истина);
	Иначе
		Возврат Параметры;
	КонецЕсли; 
	
	Возврат Параметры;
	
КонецФункции

Процедура ДобавитьСтрокиВДеревоПодчиненностиЭД(КорневойЭлемент, ЭтоВходящий, ПараметрыФомирования)
	
	ЭтоУПД = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФомирования, "ЭтоУПД", Ложь);
	ЭтоСЧФ = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФомирования, "ЭтоСЧФ", Ложь);
	ЭтоДОП = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыФомирования, "ЭтоДОП", Ложь);
	
	Если ЭтоУПД Тогда
		
		Если ЭтоВходящий Тогда
			
			Если ЭтоСЧФ Тогда
				
				СтрокаПДО = КорневойЭлемент.Строки.Добавить();
				СтрокаПДО.РасширенныйТип = "SendConfirmation";
				СтрокаПДО.Представление = "Подтверждение даты отправки";
				СтрокаПДО.Направление = "In";
				СтрокаПДО.Структурирован = Истина;
				
				СтрокаИОППДО = СтрокаПДО.Строки.Добавить();
				СтрокаИОППДО.РасширенныйТип = "ReceiveNotificationOfSendConfirmation";
				СтрокаИОППДО.Представление = "Извещение о получении (ПДО)";
				СтрокаИОППДО.Направление = "Out";
				СтрокаИОППДО.Структурирован = Истина;
				
				СтрокаИОП = КорневойЭлемент.Строки.Добавить();
				СтрокаИОП.РасширенныйТип = "ReceiveNotificationOfDocument";
				СтрокаИОП.Представление = "Извещение о получении документа";
				СтрокаИОП.Направление = "Out";
				СтрокаИОП.Структурирован = Истина;
				
				СтрокаПДОИОП = СтрокаИОП.Строки.Добавить();
				СтрокаПДОИОП.РасширенныйТип = "SendConfirmationOfReceiveNotificationOfDocument";
				СтрокаПДОИОП.Представление = "Подтверждение даты отправки (ИОП УПД)";
				СтрокаПДОИОП.Направление = "In";
				СтрокаПДОИОП.Структурирован = Истина;
				
				СтрокаИОППДОИОП = СтрокаПДОИОП.Строки.Добавить();
				СтрокаИОППДОИОП.РасширенныйТип = "ReceiveNotificationOfSendConfirmationOfReceiveNotificationOfDocument";
				СтрокаИОППДОИОП.Представление = "Извещение о получении (ПОД ИОП УПД)";
				СтрокаИОППДОИОП.Направление = "Out";
				СтрокаИОППДОИОП.Структурирован = Истина;
				
			КонецЕсли; 
			
		Иначе
			
			Если ЭтоСЧФ Тогда
				
				СтрокаПДП = КорневойЭлемент.Строки.Добавить();
				СтрокаПДП.РасширенныйТип = "ReceiveConfirmation";
				СтрокаПДП.Представление = "Подтверждение даты получения";
				СтрокаПДП.Направление = "In";
				СтрокаПДП.Структурирован = Истина;
				
				СтрокаИОППДП = СтрокаПДП.Строки.Добавить();
				СтрокаИОППДП.РасширенныйТип = "ReceiveNotificationOfReceiveConfirmation";
				СтрокаИОППДП.Представление = "Извещение о получении (ПДП)";
				СтрокаИОППДП.Направление = "Out";
				СтрокаИОППДП.Структурирован = Истина;
				
				СтрокаИОП = КорневойЭлемент.Строки.Добавить();
				СтрокаИОП.РасширенныйТип = "ReceiveNotificationOfDocument";
				СтрокаИОП.Представление = "Извещение о получении документа";
				СтрокаИОП.Направление = "In";
				СтрокаИОП.Структурирован = Истина;
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Если ЭтоДОП Тогда
			
			СтрокаУПДДОППокупателя = КорневойЭлемент.Строки.Добавить();
			СтрокаУПДДОППокупателя.РасширенныйТип = "AcceptDocument";
			СтрокаУПДДОППокупателя.Представление = "Документ покупателя";
			СтрокаУПДДОППокупателя.Направление = ?(ЭтоВходящий, "Out", "In"); 
			СтрокаУПДДОППокупателя.Структурирован = Истина;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДеревоПодчиненностиЭД(ДеревоОбъект, РеквизитыДокумента, ЭтоВходящий)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_Квитанции.Ссылка КАК Ссылка,
	|	ККСНГ_Квитанции.ExtendedType КАК РасширенныйТип,
	|	ККСНГ_Квитанции.Id КАК Id,
	|	ККСНГ_Квитанции.NeedReply КАК ТребуетсяОтвет,
	|	ККСНГ_Квитанции.Type КАК ТипТранспортногоДокумента
	|ПОМЕСТИТЬ ВТ_ДокументКвитанции
	|ИЗ
	|	Справочник.ККСНГ_Квитанции КАК ККСНГ_Квитанции
	|ГДЕ
	|	ККСНГ_Квитанции.Владелец = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка,
	|	""Document"",
	|	ККСНГ_ЭлектронныеДокументы.Id,
	|	ЛОЖЬ,
	|	ККСНГ_ЭлектронныеДокументы.Type
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументКвитанции.Ссылка КАК Владелец,
	|	ВТ_ДокументКвитанции.РасширенныйТип КАК РасширенныйТип,
	|	ККСНГ_ПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайлСсылка,
	|	ВТ_ДокументКвитанции.Id КАК id,
	|	ВТ_ДокументКвитанции.ТребуетсяОтвет КАК ТребуетсяОтвет,
	|	ВТ_ДокументКвитанции.ТипТранспортногоДокумента КАК ТипТранспортногоДокумента,
	|	ККСНГ_ПрисоединенныеФайлы.Filename КАК ПрисоединенныйФайлИмя
	|ИЗ
	|	ВТ_ДокументКвитанции КАК ВТ_ДокументКвитанции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_ПрисоединенныеФайлы КАК ККСНГ_ПрисоединенныеФайлы
	|		ПО ВТ_ДокументКвитанции.Ссылка = ККСНГ_ПрисоединенныеФайлы.Владелец
	|ГДЕ
	|	ККСНГ_ПрисоединенныеФайлы.Id = 0";
	
	Запрос.УстановитьПараметр("Ссылка", РеквизитыДокумента.Ссылка); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПоиска = Новый Структура("РасширенныйТип", Выборка.РасширенныйТип);
		МассивСтрокДерева = ДеревоОбъект.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если МассивСтрокДерева.Количество() = 1 Тогда
			СтрокаДерева = МассивСтрокДерева[0];
			СтрокаДерева.ПрисоединенныйФайлСсылка = Выборка.ПрисоединенныйФайлСсылка;
			СтрокаДерева.ПрисоединенныйФайлИмя = Выборка.ПрисоединенныйФайлИмя;			
			СтрокаДерева.Владелец = Выборка.Владелец;
			СтрокаДерева.ТребуетсяОтвет = Выборка.ТребуетсяОтвет;
			СтрокаДерева.ТипТранспортногоДокумента = Выборка.ТипТранспортногоДокумента;
		КонецЕсли; 		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыСтрокДерева(УзелДерева)
	
	Для каждого ТекущаяСтрока Из УзелДерева.Строки Цикл
		ЗаполнитьРеквизитыСтрокиДерева(ТекущаяСтрока);
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыСтрокиДерева(СтрокаДерева)
	
	Если Не ЗначениеЗаполнено(СтрокаДерева.Статус) Тогда
		Если ЗначениеЗаполнено(СтрокаДерева.ПрисоединенныйФайлСсылка) Тогда
			Если СтрокаДерева.Направление = "In" Тогда
				СтрокаДерева.Статус = "Получен";
			ИначеЕсли СтрокаДерева.Направление = "Out" Тогда
				СтрокаДерева.Статус = "Отправлен";
			КонецЕсли; 
		Иначе
			Если СтрокаДерева.Направление = "In" Тогда
				СтрокаДерева.Статус = "Не получен";
			ИначеЕсли СтрокаДерева.Направление = "Out" Тогда
				СтрокаДерева.Статус = "Не сформирован";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 		 
	
	ЗаполнитьРеквизитыСтрокДерева(СтрокаДерева);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатнаяФормаЭД

Процедура ВывестиПредставлениеЭлектроннойПодписи(ПечатнаяФорма, СвойстваЭлектронногоДокумента)
	
	МассивЭП = СвойстваЭлектронногоДокумента.Подписи;
	
	Если МассивЭП.Количество() > 0 Тогда
		
		МакетПодписи = Справочники.ККСНГ_ЭлектронныеДокументы.ПолучитьМакет("МакетЭП");
		ПодписьПродавца = МассивЭП[0];				
		
		Штамп = Новый ТабличныйДокумент;		
		ШтампПродавца = ПолучитьШтамп(ПодписьПродавца, МакетПодписи);		
				
		Если МассивЭП.Количество() > 1 Тогда 
			
			ПодписьПокупателя = МассивЭП[1];
			ШтампПокупателя = ПолучитьШтамп(ПодписьПокупателя, МакетПодписи);			
			
			Разделитель = МакетПодписи.ПолучитьОбласть("ОбластьШтампШапка|ОбластьРазделитель");
			ШиринаШтампа = ШиринаТабличногоДокументаВСимволах(ШтампПродавца);
			ШиринаДокумента = ШиринаТабличногоДокументаВСимволах(ПечатнаяФорма);
			Разделитель.Область().ШиринаКолонки = ШиринаДокумента - 2 * ШиринаШтампа;						
			
			ВысотаШтампаПокупателя = ШтампПокупателя.Область().Низ - ШтампПокупателя.Область().Верх;
			ВысотаШтампаПродавца = ШтампПродавца.Область().Низ - ШтампПродавца.Область().Верх;
			
			РазницаВысоты = ВысотаШтампаПокупателя - ВысотаШтампаПродавца;
			Если РазницаВысоты > 0 Тогда
				Для Инд = 1 По РазницаВысоты Цикл
					ОбластьДопСтрока = МакетПодписи.ПолучитьОбласть("ДопСтрока|ШтампКолонки");
					ШтампПродавца.Вывести(ОбластьДопСтрока);
				КонецЦикла; 
			КонецЕсли; 
			
			Штамп.Вывести(ШтампПродавца);
			Штамп.Присоединить(Разделитель); 
			Штамп.Присоединить(ШтампПокупателя);
			
		Иначе
			Штамп.Вывести(ШтампПродавца);			
		КонецЕсли;
		
		ПечатнаяФорма.Вывести(Штамп);
		
	КонецЕсли;  
	
КонецПроцедуры

Функция ШиринаТабличногоДокументаВСимволах(ТабличныйДокумент)
	
	ШиринаВСимволах = 0;
	Для н = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		
		ШаблонАдресаОбласти = "R%1C%2";
		АдресОбласти = СтрШаблон(ШаблонАдресаОбласти, ТабличныйДокумент.ВысотаТаблицы - 1, н);
		Область = ТабличныйДокумент.Область(АдресОбласти);
		ШиринаВСимволах = ШиринаВСимволах + Область.ШиринаКолонки;
		
	КонецЦикла;
	
	Возврат ШиринаВСимволах;
	
КонецФункции

Функция ПолучитьШтамп(ДанныеПодписи, МакетПодписи)
	
	Штамп = МакетПодписи.ПолучитьОбласть("ОбластьШтампШапка|ШтампКолонки");
	Штамп.Параметры.ДатаПодписи = ДанныеПодписи.ДатаПодписи;
	
	Если ЗначениеЗаполнено(ДанныеПодписи.Отпечаток) Тогда
		ОбластьШтампДанные = МакетПодписи.ПолучитьОбласть("ОбластьШтампДанные|ШтампКолонки");
		ОбластьШтампДанные.Параметры.Отпечаток = ДанныеПодписи.Отпечаток;
		ОбластьШтампДанные.Параметры.КомуВыданСертификат = ДанныеПодписи.КомуВыданСертификат;
		ОбластьШтампДанные.Параметры.СрокДействия = ДанныеПодписи.СрокДействия;		
		Штамп.Вывести(ОбластьШтампДанные);
				
		Если ЗначениеЗаполнено(ДанныеПодписи.ИздательСертификата) Тогда
			ОбластьШтампУЦ = МакетПодписи.ПолучитьОбласть("ОбластьШтампУЦ|ШтампКолонки");
			ОбластьШтампУЦ.Параметры.ИздательСертификата = ДанныеПодписи.ИздательСертификата;								
		Иначе
			ОбластьШтампУЦ = МакетПодписи.ПолучитьОбласть("ОбластьШтампПустаяСтрока|ШтампКолонки");
		КонецЕсли;			
		Штамп.Вывести(ОбластьШтампУЦ);						
	КонецЕсли;	
	
	ОбластьШтампПодвал = МакетПодписи.ПолучитьОбласть("ОбластьШтампПодвал|ШтампКолонки");
	Штамп.Вывести(ОбластьШтампПодвал);
	
	Возврат Штамп;
	
КонецФункции

Процедура ЗаменитьПрефиксПриказаЭД(ИмяФайлаЭД, ЧтоЗаменить, НаЧтоЗаменить)
	                                         
	ОбъектXML   = Новый ЧтениеXML;
	ОбъектXML.ОткрытьФайл(ИмяФайлаЭД);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ОбъектXML);
	ОбъектXML.Закрыть();

	ЭлементФайл  = ДокументDOM.ПолучитьЭлементыПоИмени("Файл");
	
	Если ЭлементФайл.Количество() Тогда
		
		АтрибутыЭлемента = ЭлементФайл[0].Атрибуты;
		
		АтрибутИдФайл = АтрибутыЭлемента.ПолучитьИменованныйЭлемент("ИдФайл");
		
		Если ТипЗнч(АтрибутИдФайл) = Тип("АтрибутDOM") Тогда
			АтрибутИдФайл.ЗначениеУзла = СтрЗаменить(АтрибутИдФайл.ЗначениеУзла, ЧтоЗаменить, НаЧтоЗаменить); 
				
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.ОткрытьФайл(ИмяФайлаЭД);
			ЗаписьDOM = Новый ЗаписьDOM;
			ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
			ЗаписьXML.Закрыть();
			
		КонецЕсли;	
					
	КонецЕсли;
	
	ДокументDOM = Неопределено;
	ПостроительDOM = Неопределено;
	
КонецПроцедуры

Функция ПроверитьВозможностьСформироватьПФ(ИмяФайлаЭД, ФайлЭД)
	
	Перем Ответ;
	Перем МодульФормированияПФ, МинимальнаяВерсияПодсистемы, ДанныеКонфигурации;
	Перем ШаблонСообщения, ТекстСообщения;
	Перем НаименованиеДокумента, ИдФайла, ВерсФормУПД;
	
	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Ложь);
	Ответ.Вставить("ТекстСообщения", "");
	Ответ.Вставить("Вариант", 0);
	Ответ.Вставить("Модуль");
	
	МинимальнаяВерсияПодсистемы = "";
	НаименованиеДокумента = "";
	ИдФайла = ФайлЭД.FileName;
	
	// Поиск общего модуля библиотеки электронных документов
	
	МодульФормированияПФ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ФорматыЭДО", Ложь);
	Если МодульФормированияПФ <> Неопределено Тогда
		Ответ.Вариант = 1;
		Ответ.Модуль = МодульФормированияПФ;
	КонецЕсли;
	
	Если МодульФормированияПФ = Неопределено Тогда
		МодульФормированияПФ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ОбменСКонтрагентамиВнутренний", Ложь);
		Если МодульФормированияПФ <> Неопределено Тогда
			Ответ.Вариант = 2;
			Ответ.Модуль = МодульФормированияПФ;
		КонецЕсли;
	КонецЕсли;
	
	Если МодульФормированияПФ = Неопределено Тогда
		Ответ.ТекстСообщения = "Не удалось найти общий модуль конфигурации для формирования печатной формы.";
		Возврат Ответ;
	КонецЕсли;
	
	// Проверка типа документа
	
	Если СтрНачинаетсяС(ИдФайла, "ON_NKORSCHFDOPPR") Тогда
		МинимальнаяВерсияПодсистемы = "1.7.2.82";
		НаименованиеДокумента = "УКД ЕД-7-26/736@";
	КонецЕсли;
	
	Если СтрНачинаетсяС(ИдФайла, "ON_NSCHFDOPPR") Тогда
		
		ВерсФормУПД = ВерсияФорматаУПД(ИмяФайлаЭД);
		Если ЗначениеЗаполнено(ВерсФормУПД) Тогда
			
			Если ККСНГ_ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсФормУПД, "5.01") > 0 Тогда
				МинимальнаяВерсияПодсистемы = "1.9.12.33";
				НаименованиеДокумента = "УПД ЕД-7−26/970@";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка соответствия версии подсистемы 
	
	Если ЗначениеЗаполнено(МинимальнаяВерсияПодсистемы) Тогда
		
		Если ККСНГ_ОбщегоНазначенияКлиентСервер.СравнитьВерсииПодсистемы("БиблиотекаЭлектронныхДокументов", МинимальнаяВерсияПодсистемы) < 0 Тогда
			
			ДанныеКонфигурации = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОпределениеКонфигурации();
			ШаблонСообщения = "Не удалось сформировать печатную форму документа: используемая конфигурация %1 (%2) не поддерживает работу с %3 (требуется Библиотека электронных документов версии %4 или выше).";
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ДанныеКонфигурации.Синоним, ДанныеКонфигурации.Версия, НаименованиеДокумента, МинимальнаяВерсияПодсистемы);
			Ответ.ТекстСообщения = ТекстСообщения;
			Возврат Ответ;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

Функция ВерсияФорматаУПД(ИмяФайлаЭД)
	
	Перем ВерсФорм;
	Перем ОбъектXML, ПостроительDOM, ДокументDOM, ЭлементФайл, АтрибутыЭлемента, АтрибутВерсФорм;
	
	ОбъектXML = Новый ЧтениеXML;
	ОбъектXML.ОткрытьФайл(ИмяФайлаЭД);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ОбъектXML);
	ОбъектXML.Закрыть();
	
	ЭлементФайл = ДокументDOM.ПолучитьЭлементыПоИмени("Файл");
	Если ЭлементФайл.Количество() Тогда
		
		АтрибутыЭлемента = ЭлементФайл[0].Атрибуты;
		АтрибутВерсФорм = АтрибутыЭлемента.ПолучитьИменованныйЭлемент("ВерсФорм");
		
		Если ТипЗнч(АтрибутВерсФорм) = Тип("АтрибутDOM") Тогда
			ВерсФорм = АтрибутВерсФорм.ЗначениеУзла;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументDOM = Неопределено;
	ПостроительDOM = Неопределено;
	ОбъектXML = Неопределено;
	
	Возврат ВерсФорм;
	
КонецФункции

#КонецОбласти

Функция ФайлАрхива(ИмяФайла, Знач ДвоичныеДанные)
	
	Если ТипЗнч(ДвоичныеДанные) = Тип("ХранилищеЗначения") Тогда
		ДвоичныеДанные = ДвоичныеДанные.Получить();	
	КонецЕсли;
	
	ФайлАрхива = Новый Структура();
	ФайлАрхива.Вставить("Имя", ИмяФайла);
	ФайлАрхива.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	
	Возврат ФайлАрхива;
	
КонецФункции

Функция АрхивироватьФайлы(МассивФайлов)

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Архивирование файлов");
	
	Попытка
		
		ДобавленныеФайлы = Новый Массив();
		
		ИмяАрхивногоФайла =  ПолучитьИмяВременногоФайла("zip");
		МаксДлинаПолногоПути = 259;
		
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхивногоФайла);				
		КаталогВременныхФайлов = ПолучитьИмяВременногоФайла("") + ПолучитьРазделительПути();
		Для каждого ДанныеФайла Из МассивФайлов Цикл
			Если Не ТипЗнч(ДанныеФайла.ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
				Продолжить;	
			КонецЕсли;
			ФайлПолноеИмя = КаталогВременныхФайлов + ДанныеФайла.Имя;
			Если Не ДобавленныеФайлы.Найти(ФайлПолноеИмя) = Неопределено Тогда
				Продолжить;		
			КонецЕсли;
			ДанныеФайла.ДвоичныеДанные.Записать(ФайлПолноеИмя);
			ЗаписьZipФайла.Добавить(ФайлПолноеИмя);
			ДобавленныеФайлы.Добавить(ФайлПолноеИмя);
		КонецЦикла;
		ЗаписьZipФайла.Записать();				
				
		Ответ.Успех = Истина;
		Ответ.Результат = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ИмяАрхивногоФайла));
		
		УдалитьФайлы(КаталогВременныхФайлов);
		УдалитьФайлы(ИмяАрхивногоФайла);
		
	Исключение
		ШаблонОшибки = "Ошибка записи архива ""%1"": %2";
		ТекстОшибки = СтрШаблон(ШаблонОшибки, ИмяАрхивногоФайла, ОписаниеОшибки());
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "FR-00002");
	КонецПопытки;	

	Возврат Ответ;
	
КонецФункции

Функция СтруктураРезультатаПоПолучателюПриОтправкеФайла()

	Результат = Новый Структура;
	Результат.Вставить("СтатусОтправки");
	Результат.Вставить("ОтправленныйЭД");
	Результат.Вставить("ИмяСтатуса");
	Результат.Вставить("ТекстОшибки");
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьДанныеКарточки(Получатель, ДопРеквизитыПоПолучателям, ДанныеКарточки)

	ДанныеКарточки.Вставить("ДопАтрибуты", Неопределено);
	ДанныеКарточки.Вставить("ДопПараметры", Неопределено);
	ДанныеКарточки.Вставить("Комментарий", "");
	ДанныеКарточки.Вставить("ЗапросПодписи", Ложь);
	
	ДопРеквизитыПолучателя = ДопРеквизитыПоПолучателям.Получить(Получатель);
	Если ТипЗнч(ДопРеквизитыПолучателя) = Тип("Структура") Тогда
		
		Если ЗначениеЗаполнено(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопРеквизитыПолучателя, "ДопАтрибуты")) Тогда
			ДанныеКарточки.Вставить("ДопАтрибуты", ЗначениеИзСтрокиВнутр(ДопРеквизитыПолучателя.ДопАтрибуты));
		КонецЕсли;
		Если ЗначениеЗаполнено(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопРеквизитыПолучателя, "ДопПараметры")) Тогда
			ДанныеКарточки.Вставить("ДопПараметры", ЗначениеИзСтрокиВнутр(ДопРеквизитыПолучателя.ДопПараметры));
		КонецЕсли;
		Если ЗначениеЗаполнено(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопРеквизитыПолучателя, "Комментарий")) Тогда
			ДанныеКарточки.Вставить("Комментарий", ДопРеквизитыПолучателя.Комментарий);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопРеквизитыПолучателя, "ЗапросПодписи")) Тогда
			ДанныеКарточки.Вставить("ЗапросПодписи", ДопРеквизитыПолучателя.ЗапросПодписи);
		Иначе
			ДанныеКарточки.Вставить("ЗапросПодписи", Ложь);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

