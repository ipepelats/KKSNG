// Сохраняет содержимое файла ЭД во временный файл
//
// Параметры:
//  ФайлЭД          - СправочникСсылка.ККСНГ_ПрисоединенныеФайлы	 - Ссылка на файл электронного документа
//
// Возвращаемое значение:
// Неопределено или строка - имя временного файла
//
Функция СохранитьФайлЭД(ФайлЭД)	Экспорт
	
	Результат = Неопределено;
	
	ДвоичныеДанныеФайла = ФайлЭД.Content.Получить();
	Если ДвоичныеДанныеФайла <> Неопределено Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
		Результат = ИмяВременногоФайла;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на присоединенный файл для ЭД
//
// Параметры:
//	ЭлектронныйДокумент - Справочник.ККСНГ_ЭлектронныеДокументы 
//
// Возвращаемое значение:
//	Справочник.ККСНГ_ПрисоединенныеФайлы или Неопределено 
//
Функция ФайлВторогоТитула(ЭлектронныйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_ПрисоединенныеФайлы.Ссылка КАК ФайлЭД
	|ИЗ
	|	Справочник.ККСНГ_ПрисоединенныеФайлы КАК ККСНГ_ПрисоединенныеФайлы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Квитанции КАК ККСНГ_КвитанцииПодписи
	|		ПО ККСНГ_ПрисоединенныеФайлы.Владелец = ККСНГ_КвитанцииПодписи.Ссылка
	|ГДЕ
	|	ККСНГ_КвитанцииПодписи.Владелец = &ЭлектронныйДокумент
	|	И ККСНГ_КвитанцииПодписи.Type В(&ТитулПокупателя)";
	
	МассивТитулПокупателя = МассивТиповТранспортныхДокументовТитулПокупателя();
	
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	Запрос.УстановитьПараметр("ТитулПокупателя", МассивТитулПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФайлЭД;
	Иначе		
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция НастройкиЭкспорта() Экспорт

	НастройкиЭкспорта = Новый Соответствие();
	НастройкиЭкспорта.Вставить("ТипыДокументовЭкспорта", ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТипыДокументовРасширенногоЭкспорта());
	НастройкиЭкспорта.Вставить("КаталогВыгрузкиЭкспорта", ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.КаталогВыгрузкиРасширенногоЭкспорта());
	НастройкиЭкспорта.Вставить("ГруппировкаЭкспорта", ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ГруппировкаРасширенногоЭкспорта());
	
	Возврат НастройкиЭкспорта;
	
КонецФункции

