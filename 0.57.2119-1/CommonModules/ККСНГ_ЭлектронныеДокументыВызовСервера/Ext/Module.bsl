#Область ВыгрузкаПакетовЭД

Функция ПолучитьИмяФайлаБезРасширения(ИмяФайла)

	Составляющие = СтрРазделить(ИмяФайла, ".", Ложь);
	
	Если Составляющие.Количество() = 1 Тогда
		Возврат ИмяФайла;
	Иначе	
		РасширениеФайла = Составляющие[Составляющие.Количество() - 1];
		Возврат СтрЗаменить(ИмяФайла, "." + РасширениеФайла, "");
	КонецЕсли;

КонецФункции

Функция ОбработатьЗапросПоВложениям(ЗапросПоДокументу, ПараметрыАвторизации, Ответ)

	ОшибкиПриПолученииВложений = Ложь;
	Если ЗапросПоДокументу.Успех Тогда
		Для каждого ТекущееВложение Из ЗапросПоДокументу.Результат.Attachments.Attachment Цикл
			ЗапросВложений = ККСНГ_APIКурьер.v1_DocumentAttachment(ПараметрыАвторизации, ТекущееВложение.id);
			Если ЗапросВложений.Успех Тогда
				ДобавитьВПакетДанныхФайлов(ЗапросВложений, Ответ);
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросВложений.Журнал, Ложь);
				ОшибкиПриПолученииВложений = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПоДокументу.Журнал, Ложь);
		ОшибкиПриПолученииВложений = Истина;
	КонецЕсли;	

	Возврат НЕ ОшибкиПриПолученииВложений;	
	
КонецФункции

Функция ОбработатьЗапросПоКвитанциям(ЗапросПоКвитанциям, ТекущийИдентификатор, Ответ)
	
	Если ЗапросПоКвитанциям.Успех Тогда
		Для каждого ТекущаяКвитанция Из ЗапросПоКвитанциям.Результат.TicketDetails Цикл
			Если ТекущаяКвитанция.DocumentId = ТекущийИдентификатор Тогда
				Продолжить;
			Иначе	
				ДобавитьВПакетДанныхФайлов(ТекущаяКвитанция.Content, Ответ);
				ДобавитьПодписиВПакетДанныхФайлов(ТекущаяКвитанция.Signature, ТекущаяКвитанция.Content.Filename, "Content", Ответ, Неопределено);			
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПоКвитанциям.Журнал, Ложь);
		Возврат Ложь;
	КонецЕсли;	

КонецФункции

Функция ДобавитьПодписиВПакетДанныхФайлов(ДанныеПодписей, ИмяФайлаСРасширением, ИмяРеквизитаДвоичныхДанных, Ответ, ДанныеЗапроса)

	Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") И ДанныеЗапроса.Свойство("Успех") И ДанныеЗапроса.Успех = Ложь Тогда
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ДанныеЗапроса.Журнал, Ложь);
		Возврат Ложь;
	КонецЕсли;	
	
	ДополнениеКИмениФайла = "SGN";
	СчетчикПодписей = 0;
	Для каждого ТекущаяПодпись Из ДанныеПодписей Цикл
		
		СчетчикПодписейКакСтрока = ?(СчетчикПодписей = 0, "", Формат(СчетчикПодписей, "Ф=(ЧЦ=10; ЧДЦ=0; ЧГ=)"));
		
		ИмяФайлаПодписи = ПолучитьИмяФайлаБезРасширения(ИмяФайлаСРасширением);
		ИмяФайлаПодписи = ИмяФайлаПодписи + ДополнениеКИмениФайла + СчетчикПодписейКакСтрока + ".sgn";
		ДанныеФайла = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_FileContent");
		ДанныеФайла.Filename = ИмяФайлаПодписи;
		ДанныеФайла.Content = ТекущаяПодпись[ИмяРеквизитаДвоичныхДанных];
		Ответ.Результат.Добавить(ДанныеФайла);
		
		СчетчикПодписей = СчетчикПодписей + 1;
		
	КонецЦикла;	

	Возврат Истина;
	
КонецФункции 

Функция ДобавитьВПакетДанныхФайлов(ДанныеЗапроса, Ответ)

	// Проверка на ошибку "Документ не может быть распечатан."
	Если ДанныеЗапроса.Свойство("Журнал") Тогда
		ПоследняяОшибкаЖурнала = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ДанныеЗапроса.Журнал);
		Если ТипЗнч(ПоследняяОшибкаЖурнала) = Тип("Структура") И НРЕГ(ПоследняяОшибкаЖурнала.КодОшибки) = "er-10402" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ДанныеЗапроса.Свойство("Успех") ИЛИ ДанныеЗапроса.Успех Тогда
		ДобавитьВПакет = Истина;
	Иначе
		ДобавитьВПакет = Ложь;
	КонецЕсли;
	
	Если ДанныеЗапроса.Свойство("Результат") Тогда
		ПолученныеДанныеФайла = ДанныеЗапроса.Результат;
	Иначе	
		ПолученныеДанныеФайла = ДанныеЗапроса;
	КонецЕсли;
	
	Если ДобавитьВПакет Тогда
		ДанныеФайла = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_FileContent");
		ЗаполнитьЗначенияСвойств(ДанныеФайла, ПолученныеДанныеФайла);
		Ответ.Результат.Добавить(ДанныеФайла);
		Возврат Истина;
	Иначе	
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ДанныеЗапроса.Журнал, Ложь);
		Возврат Ложь;
	КонецЕсли;

КонецФункции

