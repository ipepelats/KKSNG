Процедура ОбработатьДопВложенияПриОтправкеЭД(Данные)

	ЗапросОтправкаДокумента = Данные.ЗапросОтправкаДокумента;
	ДанныеДокумента = Данные.ДанныеДокумента;
	ПараметрыАвторизации = Данные.ПараметрыАвторизации;
	Ответ = Данные.Ответ;
	СтруктураДокумента = Данные.СтруктураДокумента;
	
	DocumentID = ЗапросОтправкаДокумента.Результат.Id;
	
	// ККСНГ: Передаем подпись для индивидуального подписания каждого вложения (нужно для роуминга)
	ЗапросДобавленияВложений = ККСНГ_ОтправкаЭДВызовСервера.ДобавитьВложенияЭлектронногоДокумента(ПараметрыАвторизации, DocumentID, ДанныеДокумента.Вложения, Данные.Подпись);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДобавленияВложений.Журнал, Ложь);
	
	Если Данные.ПодписатьДанные И ЗапросДобавленияВложений.Успех Тогда
		
		// TODO реализовать проверку доступных действий и обновление списка после выполнения действия
		Если СтрНайти(ВРЕГ(СтруктураДокумента.Actions), "SIGN") = 0 И СтрНайти(ВРЕГ(СтруктураДокумента.Actions), "SEND") > 0 Тогда
			
			// Отправка документа
			ЗапросОтправкиДокумента = ККСНГ_APIКурьер.v1_DocumentSend(ПараметрыАвторизации, DocumentID);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОтправкиДокумента.Журнал, Ложь);
			
		Иначе
			
			ЗапросОтправкиДокумента = Новый Структура("Успех", Истина);
			
		КонецЕсли;
		
		Если ЗапросОтправкиДокумента.Успех Тогда
			
			// Подписание документа
			ЗапросПодписанияДокумента = ККСНГ_APIКурьер.v1_DocumentSign(ПараметрыАвторизации, DocumentID, Данные.Подпись);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПодписанияДокумента.Журнал, Ложь);
			
			Ответ.Успех = ЗапросПодписанияДокумента.Успех;
			
		КонецЕсли;
		
	Иначе
		
		Ответ.Успех = ЗапросДобавленияВложений.Успех;
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьОбъектыИБПослеОтправкиСтруктурированногоЭД(Данные)

	ДанныеДокумента = Данные.ДанныеДокумента;
	СтруктураДокумента = Данные.СтруктураДокумента;
	ПрофильЭДООрганизации = Данные.ПрофильЭДООрганизации;
	ПараметрыАвторизации = Данные.ПараметрыАвторизации;
	Ответ = Данные.Ответ;
	
	НачатьТранзакцию();
	Попытка
		
		// Очищаем доп. реквизиты отправленного документа
		ККСНГ_ОбъектыИБВызовСервера.ОчиститьДопРеквизитыДокумента(ДанныеДокумента.ДокументСсылка);
		
		ПолучениеЭД = ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(СтруктураДокумента.Id, ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПолучениеЭД.Журнал, Ложь);
		
		Если ПолучениеЭД.Успех Тогда					
			
			НовыйДокументСсылка = ПолучениеЭД.Результат;
			Ответ.Результат = НовыйДокументСсылка;
			
			ЭДОбъект = НовыйДокументСсылка.ПолучитьОбъект();
			ЭДОбъект.Отправитель = ДанныеДокумента.Организация;	
			ЭДОбъект.Получатель = ДанныеДокумента.Контрагент;
			ЭДОбъект.Записать();
			
			МодульМенеджераСпособыОтправки = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("Перечисления.ККСНГ_ПМ_СпособыОтправки");
			ТекСпособОтправки = МодульМенеджераСпособыОтправки.СтруктурированныйДокумент;
			
			ККСНГ_ОбъектыИБВызовСервера.ЗаписатьСвязьЭлектронногоДокумента(НовыйДокументСсылка, ДанныеДокумента.Ссылка, , ТекСпособОтправки); 
					
		Иначе										
			ВызватьИсключение "Электронный документ не записан";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ответ.Результат = Неопределено;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Получение ЭД", "ED-00002", ОписаниеОшибки());				
		
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьОбъектыИБПослеОтправкиНЕСтруктурированногоЭД(Данные)

	ДанныеКарточки = Данные.ДанныеКарточки;
	СтруктураДокумента = Данные.СтруктураДокумента;
	ПрофильЭДООрганизации = Данные.ПрофильЭДООрганизации;
	ПараметрыАвторизации = Данные.ПараметрыАвторизации;
	СпособОтправки = Данные.СпособОтправки;
	Ответ = Данные.Ответ;
	
	НачатьТранзакцию();
	
	Попытка
		
		ПолучениеЭД = ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(СтруктураДокумента.Id, ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПолучениеЭД.Журнал, Ложь);
		
		Если ПолучениеЭД.Успех Тогда
			
			НовыйДокументСсылка = ПолучениеЭД.Результат;
			Ответ.Результат = НовыйДокументСсылка;
			
			ЭДОбъект = НовыйДокументСсылка.ПолучитьОбъект();
			ЭДОбъект.Отправитель = ПрофильЭДООрганизации.Организация;
			ЭДОбъект.Получатель = ДанныеКарточки.Получатель.Контрагент;
			ЭДОбъект.Записать();
			
			Если ЗначениеЗаполнено(СпособОтправки) Тогда
				ККСНГ_ОбъектыИБВызовСервера.ЗаписатьСвязьЭлектронногоДокумента(НовыйДокументСсылка, ДанныеКарточки.Ссылка, , СпособОтправки);
			КонецЕсли;
			
		Иначе
			ВызватьИсключение "Электронный документ не записан";
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();				
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ответ.Результат = Неопределено;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Получение ЭД", "ED-00003", ОписаниеОшибки());				
		
	КонецПопытки;	
	
КонецПроцедуры	

#Область ОбработчикиФормированияДанныхПодписанта

Функция ПолучитьОбработчикФормированияЭД(ПрофильОрганизации, ИмяОбработчика = "")
	
	Если Не ПустаяСтрока(ИмяОбработчика) И ИмяОбработчика = "ОбработчикПослеФормированияЭД" Тогда
		ОбработчикЭДСсылка = ПрофильОрганизации.ОбработчикПослеФормированияЭД;
	Иначе
		ОбработчикЭДСсылка = ПрофильОрганизации.ПодключаемыйМодуль;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбработчикЭДСсылка) Тогда
		ОбработчикЭД = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ОбработчикЭДСсылка);
	КонецЕсли;
	
	Возврат ОбработчикЭД;
	
КонецФункции

Функция ВыполнитьОбработчикПередЗаполнениемПодписанта(ОрганизацияЭДО, ДанныеСертификата, СтандартнаяОбработка)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	
	Попытка
		ОбработчикЭД = ПолучитьОбработчикФормированияЭД(ОрганизацияЭДО);
	Исключение
		ОписаниеОшибки = "Ошибка получения клиентского обработчика перед заполнением подписанта. " + ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "XM-00053");
		Ответ.Успех = Ложь;
		
		Возврат Ответ;
		
	КонецПопытки;
	
	Если Не ОбработчикЭД = Неопределено Тогда
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		
		Попытка
			
			РезультатОбработки = ОбработчикЭД.ВыполнитьАлгоритмПередЗаполнениемПодписанта(ОрганизацияЭДО, ДанныеСертификата, СтандартнаяОбработка, Отказ, ОписаниеОшибки);
			Если Не ТипЗнч(Отказ) = Тип("Булево") Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Некорректный тип значения в параметре ""Отказ"".";
			КонецЕсли;
			
			Если НЕ ТипЗнч(СтандартнаяОбработка) = Тип("Булево") Тогда
				Отказ = Истина;
				ОписаниеОшибки = "Некорректный тип значения в параметре ""СтандартнаяОбработка"".";
			КонецЕсли;
			
			Если Отказ Тогда
				ТекстОшибки = "Ошибка выполнения клиентского обработчика перед заполнением подписанта. " + Строка(ОписаниеОшибки);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00050");
			Иначе
				
				Если ТипЗнч(РезультатОбработки) = Тип("Структура") Или РезультатОбработки = Неопределено Тогда
					Ответ.Результат = РезультатОбработки;
				Иначе
					Отказ = Истина; 
					ТекстОшибки = "Ошибка выполнения клиентского обработчика перед заполнением подписанта. Тип выходного параметра ""РезультатОбработки"" не соответствует ожидаемому - ""Структура"".";
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00051");
				КонецЕсли;
				
			КонецЕсли;
			
			Ответ.Успех = Не Отказ;
			
		Исключение
			Ответ.Успех = Ложь;
			ТекстОшибки = "Ошибка выполнения клиентского обработчика перед заполнением подписанта. " + ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "XM-00052");
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

