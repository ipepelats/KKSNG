#Область ПрограммныйИнтерфейс

// Отправляет ЭД в СФЕРА Курьер
Функция ОтправитьДокументВКурьер(ДанныеДокумента, ПрофильЭДООрганизации, ПараметрыАвторизации, ПодписатьДанные, ДопРеквизиты = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Создание черновиков в сервисе ЭДО");
	
	Signature = Неопределено;
	Если ПодписатьДанные Тогда
		СвойстваПодписи = ККСНГ_ДокументооборотКлиентСервер.СвойстваПодписиИзРезультатаПодписания(ДанныеДокумента);
		Signature = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_Signature");
		Signature.Content = СвойстваПодписи.Подпись;
	КонецЕсли;

	Если ТипЗнч(ДопРеквизиты) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДопРеквизиты);
	КонецЕсли;
	
	ЕстьДопВложения = (ДанныеДокумента.Вложения <> Неопределено И ДанныеДокумента.Вложения.Количество() > 0);
	
	DocumentCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
	
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "Дата", Ложь, DocumentCard.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ПредставлениеНомера", Ложь, DocumentCard.Number);
	DocumentCard.TypeCode = "LETTER"; // Всегда ПИСЬМО
	
	DocumentCard.Content.Filename = ДанныеДокумента.ИмяФайла;
	DocumentCard.Content.MimeType = "application/xml";
	DocumentCard.Content.Content = ДанныеДокумента.Данные;
	
	DocumentCard.Удалить("Signature");
	DocumentCard.RequestSign = Ложь;
	DocumentCard.Barcode.Type = "None";
	Если DocumentCard.Contract.Number = "" Тогда DocumentCard.Удалить("Contract"); КонецЕсли;
	
	Если ДанныеДокумента.ДопАтрибуты <> Неопределено Тогда
		DocumentCard.Attributes.KeyValueObject = ДанныеДокумента.ДопАтрибуты;
	КонецЕсли;

	ККСНГ_КодПолучателя = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "КодУчастникаЭДОПолучателя", "");
	ЗапросОтправкаДокумента = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, ККСНГ_КодПолучателя, DocumentCard);
	
	Если ЗапросОтправкаДокумента.Успех Тогда
		DocumentID = ЗапросОтправкаДокумента.Результат.Id;
		Сообщить("ККСНГ: Черновик УПД создан. ID: " + DocumentID);
		
		Если ЕстьДопВложения Тогда
			ЗапросДобавленияВложений = ККСНГ_ОтправкаЭДВызовСервера.ДобавитьВложенияЭлектронногоДокумента(ПараметрыАвторизации, DocumentID, ДанныеДокумента.Вложения, Signature, ДанныеДокумента);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДобавленияВложений.Журнал, Ложь);
		КонецЕсли;
		
		ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(DocumentID, ПрофильЭДООрганизации, ПараметрыАвторизации);
		Ответ.Успех = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ДобавитьВложенияЭлектронногоДокумента(ПараметрыАвторизации, DocumentID, МассивВложений, Подпись = Неопределено, ДанныеДокумента = Неопределено) Экспорт
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	Для каждого Вложение Из МассивВложений Цикл 
		Попытка
			CardAttachment = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
			CardAttachment.Date = ТекущаяДатаСеанса();
			CardAttachment.TypeCode = "LETTER";
			CardAttachment.Удалить("Signature");
			CardAttachment.RequestSign = Ложь;
			CardAttachment.Barcode.Type = "None";
			CardAttachment.Удалить("Contract");
			
			ККСНГ_Данные = ?(ТипЗнч(Вложение.АдресВХранилище) = Тип("ДвоичныеДанные"), Вложение.АдресВХранилище, ПолучитьИзВременногоХранилища(Вложение.АдресВХранилище));
			Если ККСНГ_Данные = Неопределено Тогда Продолжить; КонецЕсли;
			
			CardAttachment.Content.Filename = Вложение.ИмяФайла;
			CardAttachment.Content.Content  = ККСНГ_Данные;
			CardAttachment.Content.MimeType = ?(НРег(Вложение.Расширение) = "pdf", "application/pdf", "text/plain");
			
			ККСНГ_КодПолучателя = ?(ДанныеДокумента <> Неопределено, ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "КодУчастникаЭДОПолучателя", ""), "");
			ЗапросДобавления = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, ККСНГ_КодПолучателя, CardAttachment);
			Если ЗапросДобавления.Успех Тогда
				Сообщить("ККСНГ: Черновик счета создан. ID: " + ЗапросДобавления.Результат.Id);
			КонецЕсли;
		Исключение
			Сообщить("ККСНГ: Ошибка вложений: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПодготовитьДанныеЭлектронныхДокументов(МассивДокументов, ПрофильОрганизации, ПараметрыАвторизации, ДополнительныеПараметры = Неопределено) Экспорт
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	СписокДокументов = Новый Массив;
	Для каждого ДокументЭлемент Из МассивДокументов Цикл
		ДокументСсылка = ДокументЭлемент.Ссылка;
		Сообщить("--- Подготовка данных: " + Строка(ДокументСсылка));
		ОтветПоДокументу = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		ОтветПоДокументу.Результат = ДокументСсылка;
		ДанныеДокумента = ККСНГ_ЭлектронныеДокументы.СтруктураДанныхДокумента();
		ДанныеДокумента.Вставить("ПрофильОрганизации", ПрофильОрганизации);
		ДанныеДокумента.Вставить("КодЭДООтправителя",  ПрофильОрганизации.КодУчастникаЭДО);
		ДанныеДокумента.Вставить("ОтправительЭД",  ПрофильОрганизации.Организация);
		ДанныеДокумента.Вставить("ПолучательЭД",  ДокументЭлемент.Контрагент);
		ОбщийМодульПолучениеДанных = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПолучениеДанных");
		ЗапросДанныхДокумента = ОбщийМодульПолучениеДанных.ДанныеДокумента(ДокументСсылка, ДанныеДокумента);
		Если ЗапросДанныхДокумента.Успех Тогда
			ДанныеДокумента = ЗапросДанныхДокумента.Результат;
			ЗапросДанныхФормата = ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента);
			Если ЗапросДанныхФормата.Успех Тогда
				ДанныеФормата = ЗапросДанныхФормата.Результат;
				ЗапросКодаЭДО = ККСНГ_ДокументооборотВызовСервера.ПолучитьКодЭДОПолучателя(ДанныеДокумента.ПрофильКонтрагента, ДанныеФормата.КодТипаДокумента, ПрофильОрганизации, ПараметрыАвторизации);
				Если ЗапросКодаЭДО.Успех Тогда ДанныеДокумента.КодЭДОПолучателя = ЗапросКодаЭДО.Результат; КонецЕсли;
				ЗапросXML = ККСНГ_ФормированиеXML.СоздатьXML(ДанныеДокумента, ДанныеФормата);
				
				// ВОССТАНОВЛЕННЫЙ БЛОК ПОИСКА СЧЕТА (СФ -> Реализация -> Счет)
				ККСНГ_СчетСсылка = Неопределено;
				ККСНГ_Реализация = Неопределено;
				ККСНГ_МетаДок = ДокументСсылка.Метаданные();
				Если Найти(ВРег(ККСНГ_МетаДок.Имя), "РЕАЛИЗАЦИЯ") > 0 Тогда
					ККСНГ_Реализация = ДокументСсылка;
				ИначеЕсли Найти(ВРег(ККСНГ_МетаДок.Имя), "СЧЕТФАКТУРА") > 0 Тогда
					Если ККСНГ_МетаДок.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
						ККСНГ_Реализация = ДокументСсылка.ДокументОснование;
					ИначеЕсли ККСНГ_МетаДок.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
						Если ДокументСсылка.ДокументыОснования.Количество() > 0 Тогда
							ККСНГ_Реализация = ДокументСсылка.ДокументыОснования[0].ДокументОснование;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если ЗначениеЗаполнено(ККСНГ_Реализация) Тогда
					ККСНГ_МетаРеал = ККСНГ_Реализация.Метаданные();
					Если ККСНГ_МетаРеал.Реквизиты.Найти("СчетНаОплату") <> Неопределено Тогда
						ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплату;
					ИначеЕсли ККСНГ_МетаРеал.Реквизиты.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
						ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплатуПокупателю;
					КонецЕсли;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ККСНГ_СчетСсылка) Тогда
					Сообщить("ККСНГ: Найден счет: " + Строка(ККСНГ_СчетСсылка));
					// Генерация PDF (сокращено для надежности)
					Попытка
						ККСНГ_УпрПеч = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("УправлениеПечатью", Ложь);
						ККСНГ_ОбщН = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ОбщегоНазначения", Ложь);
						ККСНГ_Коллекция = Новый ТаблицаЗначений;
						ККСНГ_Коллекция.Колонки.Добавить("ИмяВКоллекции"); ККСНГ_Коллекция.Колонки.Добавить("ИмяМакета"); ККСНГ_Коллекция.Колонки.Добавить("ТабличныйДокумент");
						ККСНГ_Коллекция.Колонки.Добавить("ИмяВРЕГ"); ККСНГ_Коллекция.Колонки.Добавить("КоличествоЭкземпляров"); ККСНГ_Коллекция.Колонки.Добавить("ИмяФайлаПечатнойФормы");
						НовСтр = ККСНГ_Коллекция.Добавить(); НовСтр.ИмяВКоллекции = "СчетЗаказ"; НовСтр.ИмяМакета = "СчетЗаказ"; НовСтр.ИмяВРЕГ = "СЧЕТЗАКАЗ"; НовСтр.КоличествоЭкземпляров = 1;
						Попытка Менеджер = Обработки.ПечатьСчетаНаОплату; Исключение Менеджер = ККСНГ_ОбщН.МенеджерОбъектаПоСсылке(ККСНГ_СчетСсылка); КонецПопытки;
						Менеджер.Печать(Новый Массив, Новый Структура, ККСНГ_Коллекция, Новый СписокЗначений, ККСНГ_УпрПеч.ПодготовитьСтруктуруПараметровВывода());
						ПФ = ККСНГ_Коллекция[0];
						Если ПФ.ТабличныйДокумент <> Неопределено Тогда
							ИмяВрем = ПолучитьИмяВременногоФайла("pdf");
							Попытка ПФ.ТабличныйДокумент.Записать(ИмяВрем, ТипФайлаТабличногоДокумента.PDF); ДД = Новый ДвоичныеДанные(ИмяВрем); УдалитьФайлы(ИмяВрем); Исключение ДД = ПолучитьДвоичныеДанныеИзСтроки("TEST", "UTF-8"); КонецПопытки;
							Влож = ИнициализироватьСтруктуруВложения();
							Влож.ИмяФайла = "Bill_" + СтрЗаменить(ККСНГ_СчетСсылка.Номер, " ", "_") + ".pdf";
							Влож.Расширение = "pdf";
							Влож.АдресВХранилище = ДД;
							Если ДанныеДокумента.Вложения = Неопределено Тогда ДанныеДокумента.Вложения = Новый Массив; КонецЕсли;
							ДанныеДокумента.Вложения.Добавить(Влож);
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЕсли;
				
				ДанныеЭД = Новый Структура;
				ДанныеЭД.Вставить("Дата", ДанныеДокумента.Дата);
				ДанныеЭД.Вставить("ПредставлениеНомера", ДанныеДокумента.Номер);
				ДанныеЭД.Вставить("ДокументСсылка", ДокументСсылка);
				ДанныеЭД.Вставить("Данные", ЗапросXML.Результат);
				ДанныеЭД.Вставить("ИмяФайла", ДанныеДокумента.ИдФайл + ".xml");
				ДанныеЭД.Вставить("КодУчастникаЭДОПолучателя", ДанныеДокумента.КодЭДОПолучателя);
				ДанныеЭД.Вставить("ПрофильОрганизации", ПрофильОрганизации);
				ДанныеЭД.Вставить("Вложения", ДанныеДокумента.Вложения);
				
				ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеЭД, ИнициализироватьДопРеквизитыДокумента());
				ДанныеЭД.Вставить("Вложения", ДанныеДокумента.Вложения);
				
				ДляПодписи = Новый Структура;
				ДляПодписи.Вставить("Данные", ДанныеЭД);
				ДляПодписи.Вставить("ИмяПоляДД", "Данные");
				ДляПодписи.Вставить("Представление", ДанныеЭД.ИмяФайла);
				ОтветПоДокументу.Результат = ДляПодписи;
				ОтветПоДокументу.Успех = Истина;
			КонецЕсли;
		КонецЕсли;
		СписокДокументов.Добавить(ОтветПоДокументу);
	КонецЦикла;
	Ответ.Результат = СписокДокументов;
	Ответ.Успех = Истина;
	Возврат Ответ;
КонецФункции

Функция ИнициализироватьДопРеквизитыДокумента() Экспорт 
	Доп = Новый Структура;
	Доп.Вставить("ДопАтрибуты"); Доп.Вставить("Вложения"); Доп.Вставить("Комментарий"); Доп.Вставить("ЗапроситьПодпись", Ложь);
	Возврат Доп;
КонецФункции

Функция ИнициализироватьСтруктуруВложения() Экспорт
	Влож = Новый Структура;
	Влож.Вставить("ИмяФайла"); Влож.Вставить("Расширение"); Влож.Вставить("АдресВХранилище"); Влож.Вставить("Наименование");
	Возврат Влож;
КонецФункции

Функция ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента) Экспорт
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ДанныеФормата = Новый Структура;
	ДанныеФормата.Вставить("КодТипаДокумента", "LETTER");
	ДанныеФормата.Вставить("Идентификатор", "LETTER");
	Ответ.Результат = ДанныеФормата; Ответ.Успех = Истина;
	Возврат Ответ;
КонецФункции

Функция ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, СвойствоКарточкиСтрока, ПроверитьЗаполнение, СвойствоDocumentCardЗначение)
	Результат = Ложь;
	Значение = Неопределено;
	Если ДанныеКарточки.Свойство(СвойствоКарточкиСтрока, Значение) Тогда
		Если НЕ ПроверитьЗаполнение ИЛИ ЗначениеЗаполнено(Значение) Тогда
			СвойствоDocumentCardЗначение = Значение; Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
