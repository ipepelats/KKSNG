#Область ПрограммныйИнтерфейс

// ГЛАВНАЯ ФУНКЦИЯ ОТПРАВКИ
Функция ОтправитьДокументВКурьер(ДанныеДокумента, ПрофильЭДООрганизации, ПараметрыАвторизации, ПодписатьДанные, ДопРеквизиты = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Создание черновиков документов");
	
	// ДЛЯ ТЕСТА: Принудительно отключаем автоматическую подпись
	ПодписатьДанные = Ложь;

	Если ТипЗнч(ДопРеквизиты) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДопРеквизиты);
	КонецЕсли;
	
	// 1. СОЗДАЕМ ЧЕРНОВИК ОСНОВНОГО ДОКУМЕНТА (УПД/СФ)
	DocumentCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
	
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "Дата", Ложь, DocumentCard.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ПредставлениеНомера", Ложь, DocumentCard.Number);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "КодТипаДокумента", Ложь, DocumentCard.TypeCode);
	
	DocumentCard.Content.Filename = ДанныеДокумента.ИмяФайла;
	DocumentCard.Content.MimeType = "application/xml";
	DocumentCard.Content.Content = ДанныеДокумента.Данные;
	
	DocumentCard.Удалить("Signature");
	DocumentCard.RequestSign = Ложь;
	DocumentCard.Barcode.Type = "None";
	Если DocumentCard.Contract.Number = "" Тогда DocumentCard.Удалить("Contract"); КонецЕсли;

	КодПолучателя = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "КодУчастникаЭДОПолучателя", "");
	
	Сообщить("ККСНГ: Создание черновика УПД...");
	ЗапросУПД = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, КодПолучателя, DocumentCard);
	
	Если ЗапросУПД.Успех Тогда
		
		MainID = ЗапросУПД.Результат.Id;
		Сообщить("ККСНГ: Черновик УПД создан. ID: " + MainID);
		
		// 2. СОЗДАЕМ ЧЕРНОВИК СЧЕТА (Как отдельное письмо)
		МассивВложений = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "Вложения", Неопределено);
		
		Если МассивВложений <> Неопределено И МассивВложений.Количество() > 0 Тогда
			
			Сообщить("ККСНГ: Начинаем загрузку связанных документов...");
			Для каждого Вложение Из МассивВложений Цикл
				
				Попытка
					BillCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
					BillCard.Date = ТекущаяДатаСеанса();
					BillCard.Number = "Счет_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
					BillCard.TypeCode = "LETTER"; // Тип Письмо для счета
					
					// Поля связи оставляем пустыми для ручного объединения в пакете в вебе
					
					BillCard.Удалить("Signature");
					BillCard.RequestSign = Ложь;
					BillCard.Barcode.Type = "None";
					BillCard.Удалить("Contract");
					
					ККСНГ_ДД = ?(ТипЗнч(Вложение.АдресВХранилище) = Тип("ДвоичныеДанные"), Вложение.АдресВХранилище, ПолучитьИзВременногоХранилища(Вложение.АдресВХранилище));
					
					Если ККСНГ_ДД <> Неопределено Тогда
						BillCard.Content.Filename = Вложение.ИмяФайла;
						BillCard.Content.Content  = ККСНГ_ДД;
						BillCard.Content.MimeType = "text/plain";
						
						ЗапросСчет = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, КодПолучателя, BillCard);
						Если ЗапросСчет.Успех Тогда
							Сообщить("ККСНГ: Черновик счета создан. ID: " + ЗапросСчет.Результат.Id);
						Иначе
							Сообщить("ККСНГ: Ошибка создания счета: " + ЗапросСчет.КодОшибки);
						КонецЕсли;
					КонецЕсли;
				Исключение
					Сообщить("ККСНГ: Ошибка вложения: " + ОписаниеОшибки());
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(MainID, ПрофильЭДООрганизации, ПараметрыАвторизации);
		Ответ.Успех = Истина;
		
	Иначе
		Сообщить("ККСНГ: Ошибка API (УПД): " + ЗапросУПД.КодОшибки);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУПД.Журнал, Ложь);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ПодготовитьДанныеЭлектронныхДокументов(МассивДокументов, ПрофильОрганизации, ПараметрыАвторизации, ДополнительныеПараметры = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	СписокДокументов = Новый Массив;
	
	Для каждого ДокументЭлемент Из МассивДокументов Цикл
		
		ДокументСсылка = ДокументЭлемент.Ссылка;
		Сообщить("--- Подготовка: " + Строка(ДокументСсылка));
		
		ОтветПоДокументу = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		ОтветПоДокументу.Результат = ДокументСсылка;
		
		ДанныеДокумента = ККСНГ_ЭлектронныеДокументы.СтруктураДанныхДокумента();
		ДанныеДокумента.Вставить("ПрофильОрганизации", ПрофильОрганизации);
		ДанныеДокумента.Вставить("КодЭДООтправителя",  ПрофильОрганизации.КодУчастникаЭДО);
		ДанныеДокумента.Вставить("ОтправительЭД",  ПрофильОрганизации.Организация);
		ДанныеДокумента.Вставить("ПолучательЭД",  ДокументЭлемент.Контрагент);
		ДанныеДокумента.Вставить("Вложения", Новый Массив);
		
		ДанныеДокумента.БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "БизнесПроцесс");
		
		// Получение данных документа
		ОбщийМодульПолучениеДанных = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПолучениеДанных");
		ЗапросДанныхДокумента = ОбщийМодульПолучениеДанных.ДанныеДокумента(ДокументСсылка, ДанныеДокумента);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросДанныхДокумента.Журнал);
		
		Если ЗапросДанныхДокумента.Успех Тогда
			
			ДанныеДокумента = ЗапросДанныхДокумента.Результат;
			
			ЗапросНаДополнение = ДополнитьДанныеДокументаДаннымиЭДО(ДанныеДокумента, ПрофильОрганизации);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросНаДополнение.Журнал);
			
			Если ЗапросНаДополнение.Успех Тогда
				
				ЗапросЗаполненияИнфополей = ДополнитьДанныеДокументаЗначениямиИнфополей(ДанныеДокумента);
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросЗаполненияИнфополей.Журнал);

				Если ЗапросЗаполненияИнфополей.Успех Тогда

					ЗапросДанныхФормата = ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента);
					ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросДанныхФормата.Журнал);
					
					Если ЗапросДанныхФормата.Успех Тогда
																
						ДанныеФормата = ЗапросДанныхФормата.Результат;
						
						ЗапросАктуальностиФормата = ПроверитьАктуальностьФорматаУКД(ДанныеДокумента, ДанныеФормата);
						ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросАктуальностиФормата.Журнал);
						
						Если ЗапросАктуальностиФормата.Успех Тогда

							ЗапросКодаЭДО = ККСНГ_ДокументооборотВызовСервера.ПолучитьКодЭДОПолучателя(ДанныеДокумента.ПрофильКонтрагента, ДанныеФормата.КодТипаДокумента, ПрофильОрганизации, ПараметрыАвторизации);
							Если ЗапросКодаЭДО.Успех Тогда
								ДанныеДокумента.КодЭДОПолучателя = ЗапросКодаЭДО.Результат;
							КонецЕсли;
							
							// ПОЛУЧЕНИЕ XML
							ЗапросXML = ККСНГ_ФормированиеXML.СоздатьXML(ДанныеДокумента, ДанныеФормата);
							ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросXML.Журнал);
							
							// ККСНГ: ПОИСК СВЯЗАННОГО СЧЕТА (СФ -> Реализация -> Счет)
							ККСНГ_СчетСсылка = Неопределено;
							ККСНГ_Реализация = Неопределено;
							ККСНГ_МетаДок = ДокументСсылка.Метаданные();
							Если Найти(ВРег(ККСНГ_МетаДок.Имя), "РЕАЛИЗАЦИЯ") > 0 Тогда
								ККСНГ_Реализация = ДокументСсылка;
							ИначеЕсли Найти(ВРег(ККСНГ_МетаДок.Имя), "СЧЕТФАКТУРА") > 0 Тогда
								Если ККСНГ_МетаДок.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
									ККСНГ_Реализация = ДокументСсылка.ДокументОснование;
								ИначеЕсли ККСНГ_МетаДок.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
									Если ДокументСсылка.ДокументыОснования.Количество() > 0 Тогда
										ККСНГ_Реализация = ДокументСсылка.ДокументыОснования[0].ДокументОснование;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							Если ЗначениеЗаполнено(ККСНГ_Реализация) Тогда
								ККСНГ_МетаРеал = ККСНГ_Реализация.Метаданные();
								Если ККСНГ_МетаРеал.Реквизиты.Найти("СчетНаОплату") <> Неопределено Тогда
									ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплату;
								ИначеЕсли ККСНГ_МетаРеал.Реквизиты.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
									ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплатуПокупателю;
								КонецЕсли;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ККСНГ_СчетСсылка) Тогда
								Сообщить("ККСНГ: Найден счет: " + Строка(ККСНГ_СчетСсылка));
								Попытка
									ККСНГ_ДД = ПолучитьДвоичныеДанныеИзСтроки("Bill Text Content", "UTF-8"); 
									Влож = Новый Структура("ИмяФайла, Расширение, АдресВХранилище, Наименование, Ссылка, ПолноеИмя");
									Влож.ИмяФайла = "Bill_" + СтрЗаменить(ККСНГ_СчетСсылка.Номер, " ", "_") + ".txt";
									Влож.Расширение = "txt";
									Влож.АдресВХранилище = ККСНГ_ДД;
									Влож.Наименование = "Счет на оплату";
									Влож.Ссылка = ККСНГ_СчетСсылка;
									Влож.ПолноеИмя = Влож.ИмяФайла;
									ДанныеДокумента.Вложения.Добавить(Влож);
								Исключение
								КонецПопытки;
							КонецЕсли;
							
							ДанныеСвязанногоДокумента = ДанныеСвязанногоДокумента(ДанныеДокумента.ДокументСсылка);
							
							ДанныеЭД = Новый Структура;
							ДанныеЭД.Вставить("Дата", ДанныеДокумента.Дата);
							ДанныеЭД.Вставить("ПредставлениеНомера", ДанныеДокумента.Номер);
							ДанныеЭД.Вставить("Организация", ДанныеДокумента.ОтправительЭД);
							ДанныеЭД.Вставить("Ссылка", ДанныеДокумента.ДокументСсылка);
							ДанныеЭД.Вставить("Контрагент", ДанныеДокумента.ПолучательЭД);
							ДанныеЭД.Вставить("ИдентификаторСвязанногоДокумента", ДанныеСвязанногоДокумента.Идентификатор);
							ДанныеЭД.Вставить("ТипСвязи", ДанныеСвязанногоДокумента.ТипСвязи);
							ДанныеЭД.Вставить("КодУчастникаЭДОПолучателя", ДанныеДокумента.КодЭДОПолучателя);
							ДанныеЭД.Вставить("КодТипаДокумента", ДанныеФормата.КодТипаДокумента);
							ДанныеЭД.Вставить("ДокументСсылка", ДокументСсылка);
							ДанныеЭД.Вставить("ДанныеФормата", ДанныеФормата);
							ДанныеЭД.Вставить("Данные", ?(ЗапросXML.Успех, ЗапросXML.Результат, Неопределено));
							ДанныеЭД.Вставить("ИмяФайла", ?(ЗапросXML.Успех, ДанныеДокумента.ИдФайл + ".xml", Неопределено));
							ДанныеЭД.Вставить("ПрофильКонтрагента", ДанныеДокумента.ПрофильКонтрагента);
							ДанныеЭД.Вставить("ПрофильОрганизации", ДанныеДокумента.ПрофильОрганизации);
							ДанныеЭД.Вставить("Вложения", ДанныеДокумента.Вложения);
							
							ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеЭД, ИнициализироватьДопРеквизитыДокумента());
							
							ОтветПоДокументу.Результат = Новый Структура("Данные, ИмяПоляДД, Представление", ДанныеЭД, "Данные", ДанныеЭД.ИмяФайла);
							ОтветПоДокументу.Успех = ЗапросXML.Успех; 
							
						КонецЕсли;
					КонецЕсли; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		СписокДокументов.Добавить(ОтветПоДокументу);
		
	КонецЦикла;
	
	Ответ.Результат = СписокДокументов;
	Ответ.Успех = Истина;
	Возврат Ответ;
	
КонецФункции

Функция ЕстьМаркировкаПива(ДанныеДокумента) Экспорт
	ВидыПродукцииИС = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ВидыПродукцииИС");
	Если ТипЗнч(ВидыПродукцииИС) = Тип("Соответствие") Тогда
		Возврат ВидыПродукцииИС[ВРег("Пиво")] = Истина Или ВидыПродукцииИС[ВРег("ПивоВПотребительскихУпаковках")] = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ДополнитьДанныеДокументаДаннымиЭДО(ДанныеДокумента, ПрофильОрганизации) Экспорт
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ККСНГ_Контрагенты ГДЕ Владелец = &П И Контрагент = &К");
	Запрос.УстановитьПараметр("П", ПрофильОрганизации); Запрос.УстановитьПараметр("К", ДанныеДокумента.ПолучательЭД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеДокумента.Вставить("ПрофильКонтрагента", Выборка.Ссылка);
		ДанныеДокумента.Вставить("КодЭДОПолучателя", Выборка.Ссылка.КодУчастникаЭДО);
		Ответ.Успех = Истина;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция ПолучитьДопРеквизитыДокументов(МассивДокументов, УникальныйИдентификатор = "") Экспорт
	ДокументыСДопРеквизитами = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ СвязанныйДокумент, ЗапросПодписи КАК ЗапроситьПодпись, Комментарий ИЗ РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД ГДЕ СвязанныйДокумент В (&Массив)");
	Запрос.УстановитьПараметр("Массив", МассивДокументов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Доп = ИнициализироватьДопРеквизитыДокумента();
		Доп.ЗапроситьПодпись = Выборка.ЗапроситьПодпись;
		Доп.Комментарий = Выборка.Комментарий;
		ДокументыСДопРеквизитами.Вставить(Выборка.СвязанныйДокумент, Доп); 
	КонецЦикла;
	Возврат ДокументыСДопРеквизитами;
КонецФункции

Функция ИнициализироватьДопРеквизитыДокумента() Экспорт 
	Доп = Новый Структура("ДопАтрибуты, Вложения, Комментарий, ЗапроситьПодпись", Неопределено, Новый Массив, "", Ложь);
	Возврат Доп;
КонецФункции

Функция ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, СвойствоКарточкиСтрока, ПроверитьЗаполнение, СвойствоDocumentCardЗначение)
	Значение = Неопределено;
	Если ДанныеКарточки.Свойство(СвойствоКарточкиСтрока, Значение) Тогда
		Если НЕ ПроверитьЗаполнение ИЛИ ЗначениеЗаполнено(Значение) Тогда
			СвойствоDocumentCardЗначение = Значение; Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

