#Область ПрограммныйИнтерфейс

// ГЛАВНАЯ ФУНКЦИЯ ОТПРАВКИ
Функция ОтправитьДокументВКурьер(ДанныеДокумента, ПрофильЭДООрганизации, ПараметрыАвторизации, ПодписатьДанные, ДопРеквизиты = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Создание пакета черновиков");
	
	// ПРИНУДИТЕЛЬНО: Только черновики
	ПодписатьДанные = Ложь;

	Если ТипЗнч(ДопРеквизиты) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДопРеквизиты);
	КонецЕсли;
	
	// 1. СОЗДАЕМ КАРТОЧКУ УПД
	DocumentCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
	
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "Дата", Ложь, DocumentCard.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ПредставлениеНомера", Ложь, DocumentCard.Number);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "КодТипаДокумента", Ложь, DocumentCard.TypeCode);
	
	DocumentCard.Content.Filename = ДанныеДокумента.ИмяФайла;
	DocumentCard.Content.MimeType = "application/xml";
	DocumentCard.Content.Content = ДанныеДокумента.Данные;
	
	DocumentCard.Удалить("Signature");
	DocumentCard.RequestSign = Ложь;
	DocumentCard.Barcode.Type = "None";
	Если DocumentCard.Contract.Number = "" Тогда DocumentCard.Удалить("Contract"); КонецЕсли;

	КодПолучателя = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "КодУчастникаЭДОПолучателя", "");
	
	Сообщить("ККСНГ: Создание черновика УПД...");
	ЗапросУПД = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, КодПолучателя, DocumentCard);
	
	Если ЗапросУПД.Успех Тогда
		
		MainID = ЗапросУПД.Результат.Id;
		Сообщить("ККСНГ: УПД готов. ID: " + MainID);
		
		// 2. СОЗДАЕМ СЧЕТ
		МассивВложений = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "Вложения", Неопределено);
		
		Если МассивВложений <> Неопределено И МассивВложений.Количество() > 0 Тогда
			
			Сообщить("ККСНГ: Загрузка счета в пакет...");
			Для каждого Вложение Из МассивВложений Цикл
				
				Попытка
					BillCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
					BillCard.Date = ТекущаяДатаСеанса();
					BillCard.Number = "Bill_" + MainID;
					BillCard.TypeCode = "LETTER";
					BillCard.ParentDocumentId = MainID;
					BillCard.Relation = "Invoice";
					BillCard.Удалить("Signature");
					BillCard.RequestSign = Ложь;
					
					ККСНГ_ДД = ?(ТипЗнч(Вложение.АдресВХранилище) = Тип("ДвоичныеДанные"), Вложение.АдресВХранилище, ПолучитьИзВременногоХранилища(Вложение.АдресВХранилище));
					
					Если ККСНГ_ДД <> Неопределено Тогда
						BillCard.Content.Filename = Вложение.ИмяФайла;
						BillCard.Content.Content  = ККСНГ_ДД;
						BillCard.Content.MimeType = "text/plain";
						
						ЗапросСчет = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, КодПолучателя, BillCard);
						Если ЗапросСчет.Успех Тогда
							Сообщить("ККСНГ: Счет добавлен. ID: " + ЗапросСчет.Результат.Id);
						Иначе
							Сообщить("ККСНГ: Ошибка API счета: " + ЗапросСчет.КодОшибки);
						КонецЕсли;
					КонецЕсли;
				Исключение
					Сообщить("ККСНГ: Ошибка вложения: " + ОписаниеОшибки());
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(MainID, ПрофильЭДООрганизации, ПараметрыАвторизации);
		Ответ.Успех = Истина;
		
	Иначе
		Сообщить("ККСНГ: Ошибка создания УПД: " + ЗапросУПД.КодОшибки);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросУПД.Журнал, Ложь);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ПодготовитьДанныеЭлектронныхДокументов(МассивДокументов, ПрофильОрганизации, ПараметрыАвторизации, ДополнительныеПараметры = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	СписокДокументов = Новый Массив;
	
	Для каждого ДокументЭлемент Из МассивДокументов Цикл
		ДокументСсылка = ДокументЭлемент.Ссылка;
		Сообщить("--- Подготовка: " + Строка(ДокументСсылка));
		
		ОтветПоДокументу = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		ДанныеДокумента = ККСНГ_ЭлектронныеДокументы.СтруктураДанныхДокумента();
		ДанныеДокумента.Вставить("ПрофильОрганизации", ПрофильОрганизации);
		ДанныеДокумента.Вставить("КодЭДООтправителя",  ПрофильОрганизации.КодУчастникаЭДО);
		ДанныеДокумента.Вставить("ОтправительЭД",  ПрофильОрганизации.Организация);
		ДанныеДокумента.Вставить("ПолучательЭД",  ДокументЭлемент.Контрагент);
		ДанныеДокумента.Вставить("Вложения", Новый Массив);
		
		ОбщийМодульПолучениеДанных = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПолучениеДанных");
		ОбщийМодульПолучениеДанных.ДанныеДокумента(ДокументСсылка, ДанныеДокумента);
		
		// ПОИСК СЧЕТА
		ККСНГ_СчетСсылка = Неопределено;
		ККСНГ_Реализация = Неопределено;
		Мета = ДокументСсылка.Метаданные();
		Если Найти(ВРег(Мета.Имя), "РЕАЛИЗАЦИЯ") > 0 Тогда
			ККСНГ_Реализация = ДокументСсылка;
		ИначеЕсли Найти(ВРег(Мета.Имя), "СЧЕТФАКТУРА") > 0 Тогда
			Если Мета.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
				ККСНГ_Реализация = ДокументСсылка.ДокументОснование;
			ИначеЕсли Мета.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
				Если ДокументСсылка.ДокументыОснования.Количество() > 0 Тогда
					ККСНГ_Реализация = ДокументСсылка.ДокументыОснования[0].ДокументОснование;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ККСНГ_Реализация) Тогда
			МетаР = ККСНГ_Реализация.Метаданные();
			Если МетаР.Реквизиты.Найти("СчетНаОплату") <> Неопределено Тогда
				ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплату;
			ИначеЕсли МетаР.Реквизиты.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
				ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплатуПокупателю;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(ККСНГ_СчетСсылка) Тогда
			Сообщить("ККСНГ: Найден счет: " + Строка(ККСНГ_СчетСсылка));
			Влож = Новый Структура("ИмяФайла, Расширение, АдресВХранилище, Наименование");
			Влож.ИмяФайла = "Bill_" + СтрЗаменить(ККСНГ_СчетСсылка.Номер, " ", "_") + ".txt";
			Влож.Расширение = "txt";
			Влож.АдресВХранилище = ПолучитьДвоичныеДанныеИзСтроки("Bill Content", "UTF-8");
			Влож.Наименование = "Счет на оплату";
			ДанныеДокумента.Вложения.Добавить(Влож);
		КонецЕсли;

		ЗапросФ = ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента);
		Если ЗапросФ.Успех Тогда
			ЗапросXML = ККСНГ_ФормированиеXML.СоздатьXML(ДанныеДокумента, ЗапросФ.Результат);
			
			ДанныеЭД = Новый Структура;
			ДанныеЭД.Вставить("Дата", ДанныеДокумента.Дата);
			ДанныеЭД.Вставить("ПредставлениеНомера", ДанныеДокумента.Номер);
			ДанныеЭД.Вставить("ДокументСсылка", ДокументСсылка);
			ДанныеЭД.Вставить("Данные", ЗапросXML.Результат);
			ДанныеЭД.Вставить("ИмяФайла", ДанныеДокумента.ИдФайл + ".xml");
			ДанныеЭД.Вставить("КодУчастникаЭДОПолучателя", ДанныеДокумента.КодЭДОПолучателя);
			ДанныеЭД.Вставить("ПрофильОрганизации", ПрофильОрганизации);
			ДанныеЭД.Вставить("Вложения", ДанныеДокумента.Вложения);
			
			ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеЭД, ИнициализироватьДопРеквизитыДокумента());
			
			ОтветПоДокументу.Результат = Новый Структура("Данные, ИмяПоляДД, Представление", ДанныеЭД, "Данные", ДанныеЭД.ИмяФайла);
			ОтветПоДокументу.Успех = Истина;
		КонецЕсли;
		СписокДокументов.Добавить(ОтветПоДокументу);
	КонецЦикла;
	Ответ.Результат = СписокДокументов; Ответ.Успех = Истина;
	Возврат Ответ;
КонецФункции

Функция ПолучитьДопРеквизитыДокументов(МассивДокументов, УникальныйИдентификатор = "") Экспорт
	ДокументыСДопРеквизитами = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ СвязанныйДокумент, ДопАтрибуты, Вложения, Комментарий, УстановленыДопАтрибуты, ЕстьВложения, ЗапросПодписи КАК ЗапроситьПодпись ИЗ РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД ГДЕ СвязанныйДокумент В (&Массив)");
	Запрос.УстановитьПараметр("Массив", МассивДокументов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Доп = ИнициализироватьДопРеквизитыДокумента();
		Доп.ЗапроситьПодпись = Выборка.ЗапроситьПодпись;
		Доп.Комментарий = Выборка.Комментарий;
		ДокументыСДопРеквизитами.Вставить(Выборка.СвязанныйДокумент, Доп); 
	КонецЦикла;
	Возврат ДокументыСДопРеквизитами;
КонецФункции

Функция ПолучитьДопРеквизитыДокументовДляОтправки(НаборыДанных, УникальныйИдентификатор = "") Экспорт
	Массив = Новый Массив;
	Для каждого Набор Из НаборыДанных Цикл Массив.Добавить(Набор.ДокументСсылка); КонецЦикла;
	Возврат ПолучитьДопРеквизитыДокументов(Массив, УникальныйИдентификатор);
КонецФункции

Функция ИнициализироватьДопРеквизитыДокумента() Экспорт 
	Доп = Новый Структура("ДопАтрибуты, Вложения, Комментарий, ЗапроситьПодпись", Неопределено, Новый Массив, "", Ложь);
	Возврат Доп;
КонецФункции

Функция ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, СвойствоКарточкиСтрока, ПроверитьЗаполнение, СвойствоDocumentCardЗначение)
	Значение = Неопределено;
	Если ДанныеКарточки.Свойство(СвойствоКарточкиСтрока, Значение) Тогда
		Если НЕ ПроверитьЗаполнение ИЛИ ЗначениеЗаполнено(Значение) Тогда
			СвойствоDocumentCardЗначение = Значение; Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента) Экспорт
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ИмяВарианта = ?(ДанныеДокумента.ПрофильКонтрагента.ВариантНастройкиОбмена = "Использовать настройки организации", ДанныеДокумента.ПрофильОрганизации.ВариантНастройкиОбмена, ДанныеДокумента.ПрофильКонтрагента.ВариантНастройкиОбмена);
	ДанныеФормата = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьФорматЭлектронногоДокумента(ИмяВарианта, ДанныеДокумента.ПредставлениеЭД);
	Ответ.Результат = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеФормата);
	Ответ.Успех = (Ответ.Результат <> Неопределено);
	Возврат Ответ;
КонецФункции

Функция ДобавитьВложенияЭлектронногоДокумента(ПараметрыАвторизации, DocumentID, МассивВложений, Подпись = Неопределено, ДанныеДокумента = Неопределено) Экспорт
	Возврат Новый Структура("Успех, Журнал", Истина, Новый Массив);
КонецФункции

Функция ОтправитьНеструктурированныйДокументВКурьер(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись = Неопределено, Send = Ложь, СпособОтправки = Неопределено) Экспорт
	Возврат Новый Структура("Успех", Ложь);
КонецФункции

Функция ОтправитьПроизвольныйДокументВКурьер(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись, СпособОтправки = Неопределено) Экспорт
	Возврат Новый Структура("Успех", Ложь);
КонецФункции

Функция ОтправитьДокументНаКурьерСОбработкойЧерновика(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, СпособОтправки = Неопределено) Экспорт
	Возврат Новый Структура("Успех", Ложь);
КонецФункции

#КонецОбласти
