#Область ПрограммныйИнтерфейс

// Отправляет ЭД в СФЕРА Курьер
//
// Параметры:
//	ДанныеДокумента                 - Структура
//	ПрофильЭДООрганизации           - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации            - Структура:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//	ДопРеквизиты                    - Структура, произвольный
//
Функция ОтправитьДокументВКурьер(ДанныеДокумента, ПрофильЭДООрганизации, ПараметрыАвторизации, ПодписатьДанные, ДопРеквизиты = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Отправить и подписать документ в сервис ЭДО");
	
	Если ТипЗнч(ДопРеквизиты) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДопРеквизиты);
	КонецЕсли;
	
	// ККСНГ: Определяем наличие вложений заранее, чтобы использовать в параметрах карточки
	ЕстьДопВложения = (ДанныеДокумента.Вложения <> Неопределено И ДанныеДокумента.Вложения.Количество() > 0);
	
	DocumentCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
	
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "Дата", Ложь, DocumentCard.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ПредставлениеНомера", Ложь, DocumentCard.Number);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "КодТипаДокумента", Ложь, DocumentCard.TypeCode);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ДоговорДата", Истина, DocumentCard.Contract.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "ДоговорНомер", Истина, DocumentCard.Contract.Number);
	ЗаполнитьСвойствоDocumentCard(ДанныеДокумента, "Комментарий", Истина, DocumentCard.Comment);
	
	//Content
	DocumentCard.Content.Filename = ДанныеДокумента.ИмяФайла;
	DocumentCard.Content.MimeType = "application/xml";
	DocumentCard.Content.Content = ДанныеДокумента.Данные;
	
	//Relation
	Если ЗначениеЗаполнено(ДанныеДокумента.ИдентификаторСвязанногоДокумента) И ЗначениеЗаполнено(ДанныеДокумента.ТипСвязи) Тогда
		DocumentCard.ParentDocumentId = ДанныеДокумента.ИдентификаторСвязанногоДокумента;
		DocumentCard.Relation = ДанныеДокумента.ТипСвязи;
	Иначе
		DocumentCard.Relation = "Other";
	КонецЕсли;
	
	// Вложения и доп. реквизиты
	ЕстьДопВложения = ДанныеДокумента.Вложения <> Неопределено;
	Если ДанныеДокумента.ДопАтрибуты <> Неопределено Тогда
		DocumentCard.Attributes.KeyValueObject = ДанныеДокумента.ДопАтрибуты;
	КонецЕсли;
	
	DocumentCard.RequestSign = ДанныеДокумента.ЗапроситьПодпись;
	
	Если ПодписатьДанные Тогда
		
		Signature = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_Signature");
		
		СвойстваПодписи = ККСНГ_ДокументооборотКлиентСервер.СвойстваПодписиИзРезультатаПодписания(ДанныеДокумента);
		Signature.Content = СвойстваПодписи.Подпись;
		
		Если СтрСравнить(ДанныеДокумента.ДанныеПодписанта.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
			
			Signature.MchdUuid = ДанныеДокумента.ДанныеПодписанта.МЧД.Номер;
			Signature.MchdAccessMode = ДанныеДокумента.ДанныеПодписанта.МЧД.ИнформационнаяСистема;
			Если Не ПустаяСтрока(ДанныеДокумента.ДанныеПодписанта.МЧД.ИННДоверителя) Тогда
				Signature.MchdInn = ДанныеДокумента.ДанныеПодписанта.МЧД.ИННДоверителя;
			КонецЕсли;
			Если Не ПустаяСтрока(ДанныеДокумента.ДанныеПодписанта.МЧД.ИННПредставителя) Тогда
				Signature.MchdConfidantInn = ДанныеДокумента.ДанныеПодписанта.МЧД.ИННПредставителя;
			КонецЕсли;
			
			Для каждого Доверенность Из ДанныеДокумента.ДанныеПодписанта.МЧД.Цепочка Цикл
				
				SignatureMchd = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_SignatureMchdIdentify");
				
				SignatureMchd.MchdUuid = Доверенность.Номер;
				SignatureMchd.MchdAccessMode = Доверенность.ИнформационнаяСистема;
				
				Если Не ПустаяСтрока(Доверенность.ИННДоверителя) Тогда
					SignatureMchd.MchdInn = Доверенность.ИННДоверителя;
				КонецЕсли;
				
				Если Не ПустаяСтрока(Доверенность.ИННПредставителя) Тогда
					SignatureMchd.MchdConfidantInn = Доверенность.ИННПредставителя;
				КонецЕсли;
				
				Signature.Chain.SignatureMchdIdentify.Добавить(SignatureMchd);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если СтрСравнить(ДанныеДокумента.ДанныеПодписанта.ВариантОтправкиМЧД, "Пакет") = 0 Тогда
			
			Signature.MchdFileName = ДанныеДокумента.ДанныеПодписанта.МЧД.ИмяФайлаДоверенности;
			Signature.MchdFile = ДанныеДокумента.ДанныеПодписанта.МЧД.ФайлДоверенности;
			Signature.MchdSignature = ДанныеДокумента.ДанныеПодписанта.МЧД.ФайлПодписи;
			
			Для каждого Доверенность Из ДанныеДокумента.ДанныеПодписанта.МЧД.Цепочка Цикл
				
				Если Доверенность.ЕстьФайлДоверенности И Доверенность.ЕстьФайлПодписи Тогда
					
					SignatureMchd = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_SignatureMchdIdentify");
					
					SignatureMchd.MchdFileName = Доверенность.ИмяФайлаДоверенности;
					SignatureMchd.MchdFile = Доверенность.ФайлДоверенности;
					SignatureMchd.MchdSignature = Доверенность.ФайлПодписи;
					
					Signature.Chain.SignatureMchdIdentify.Добавить(SignatureMchd);
					
				Иначе
					ТекстСообщения = СтрШаблон("В машиночитаемой доверенности: %1 отсутсвуют файлы доверенности и подписи", Доверенность.Номер);
					ККСНГ_ЛогированиеКлиентСервер.ДобавитьСообщение(Ответ.Журнал, ТекстСообщения);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Если документ без вложений, то отправляем документ сразу с подписью
		// Иначе документ отправляется как черновик, к нему добавляются вложения, только потом он подписывается
		Если Не ЕстьДопВложения Тогда
			DocumentCard.Signature = Signature;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьДопПараметрыКарточкиЭД(DocumentCard, ДанныеДокумента);
	
	// TODO как определять значения полей?
	DocumentCard.Barcode.Type = "None";
	DocumentCard.RequestSign = Ложь;
	
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Создание документа в сервисе ЭДО");
	ЗапросОтправкаДокумента = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, ДанныеДокумента.КодУчастникаЭДОПолучателя, DocumentCard);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОтправкаДокумента.Журнал, Ложь);
	
	Если ЗапросОтправкаДокумента.Успех Тогда
		
		СтруктураДокумента = ЗапросОтправкаДокумента.Результат;
		
		// Если документ с вложениями, то добавим их и подпишем документ
		Если ЕстьДопВложения Тогда
			
			ПараметрыДанных = Новый Структура;
			ПараметрыДанных.Вставить("ЗапросОтправкаДокумента", ЗапросОтправкаДокумента);
			ПараметрыДанных.Вставить("ДанныеДокумента", ДанныеДокумента);
			ПараметрыДанных.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
			ПараметрыДанных.Вставить("Ответ", Ответ);
			ПараметрыДанных.Вставить("СтруктураДокумента", СтруктураДокумента);
			ПараметрыДанных.Вставить("Подпись", Signature);
			ПараметрыДанных.Вставить("ПодписатьДанные", ПодписатьДанные);
			
			ОбработатьДопВложенияПриОтправкеЭД(ПараметрыДанных);
			
		Иначе
			Ответ.Успех = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Ответ.Успех Тогда
		
		ПараметрыДанных = Новый Структура;
		ПараметрыДанных.Вставить("ДанныеДокумента", ДанныеДокумента);
		ПараметрыДанных.Вставить("СтруктураДокумента", СтруктураДокумента);
		ПараметрыДанных.Вставить("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
		ПараметрыДанных.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
		ПараметрыДанных.Вставить("Ответ", Ответ);
		
		ОбработатьОбъектыИБПослеОтправкиСтруктурированногоЭД(ПараметрыДанных);
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Отправляет ЭД в СФЕРА Курьер
//
// Параметры:
//	ДанныеКарточки                  - Структура
//										* Content	            ДвоичныеДанные
//										* Filename	            Строка
//										* MimeType	            Строка
//										* Дата	                Дата
//										* ЗапроситьПодписание	Булево
//										* КодТипаДокумента	    Строка
//										* Комментарий	        Строка
//										* Номер	                Строка
//										* Получатель	        СправочникСсылка.ККСНГ_Контрагенты
//										* Ссылка	            Неопределено
//										* Черновик	            Булево
//	ПрофильЭДООрганизации           - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации            - Структура:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//	Подпись                         - Строка
//	Send                            - Булево
//
Функция ОтправитьНеструктурированныйДокументВКурьер(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись = Неопределено, Send = Ложь, СпособОтправки = Неопределено) Экспорт
	
	ЗаголовокЖурнала = НСтр("ru = 'Отправить и подписать документ в сервис ЭДО'");
	
	Возврат ОтправитьНеструктурированный(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись, СпособОтправки, Истина, Ложь, ЗаголовокЖурнала);
	
КонецФункции

// Отправляет произвольного ЭД в СФЕРА Курьер
//
// Параметры:
//	ДанныеКарточки                  - Структура
//										* Content	            ДвоичныеДанные
//										* Filename	            Строка
//										* MimeType	            Строка
//										* Дата	                Дата
//										* ЗапроситьПодписание	Булево
//										* КодТипаДокумента	    Строка
//										* Комментарий	        Строка
//										* Номер	                Строка
//										* Получатель	        СправочникСсылка.ККСНГ_Контрагенты
//										* Ссылка	            Неопределено
//	ПрофильЭДООрганизации           - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации            - Структура:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//	Подпись                         - Строка
//  СпособОтправки - ПеречислениеСсылка.ККСНГ_ПМ_СпособыОтправки - Способ отправки электронного документа
//
// Возвращаемое значение:
//  Структура:
//      * Результат   - СправочникСсылка.ККСНГ_ЭлектронныеДокументы - ссылка на отправленный электронный документ. 
//      * Успех       - Булево    - Успешность отправки документа.
//      * КодОшибки   - Строка
//      * Журнал      - Структура - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений(). 
//   
Функция ОтправитьПроизвольныйДокументВКурьер(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись, СпособОтправки = Неопределено) Экспорт
	
	ЗаголовокЖурнала = НСтр("ru = 'Отправка подписанного документа в сервис ЭДО'");
	
	Возврат ОтправитьНеструктурированный(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись, СпособОтправки, Ложь, Истина, ЗаголовокЖурнала);
	
КонецФункции

// Функция - Отправить документ и обработать черновик
//
// Параметры:
//  Send			 - 	 - 
//  ОшибкаОтправки	 - 	 - 
//  Данные			 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ОтправитьДокументНаКурьерСОбработкойЧерновика(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, СпособОтправки = Неопределено) Экспорт
	
	ЗаголовокЖурнала = НСтр("ru = 'Отправить документ в сервис ЭДО'");
	
	Ответ = ОтправитьНеструктурированный(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, , СпособОтправки, Ложь, Ложь, ЗаголовокЖурнала);
	
	Если Ответ.Успех Тогда
		
		СтрокаДействий = Ответ.Результат.Actions;
		
		Если Найти(СтрокаДействий, "Send") > 0 Тогда
			ОтправкаБезПодписи = ККСНГ_APIКурьер.v1_DocumentSend(ПараметрыАвторизации, Ответ.Результат.Id);
		Иначе
			ОтправкаБезПодписи = ККСНГ_APIКурьер.v1_DocumentAccept(ПараметрыАвторизации, Ответ.Результат.Id);
		КонецЕсли;
		
		ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(Ответ.Результат.Id, ПрофильЭДООрганизации, ПараметрыАвторизации);
		
		Если Не ОтправкаБезПодписи.Успех Тогда
			Ответ.Успех = Ложь;
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтправкаБезПодписи.Журнал, Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

// Получает данные формата электронного документа
//
// Параметры:
//   ДанныеДокумента - Структура - см. ККСНГ_ЭлектронныеДокументы.СтруктураДанныхДокумента
//
// Возвращаемое значение:
//   Структура - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета:
//   	* Результат - Структура - в случае, если ЭД "Счет на оплату (сервис ЭДО)":
//      				** КодТипаДокумента - Строка
//      				** ПространствоИмен - Строка
//      				** Идентификатор - Строка
//      				** ВерсияФормата - Строка
//					- Структура - в остальных случаях структура соответствует настройкам формата ЭД 
//                    	описание см. ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьФорматЭлектронногоДокумента
//
Функция ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ДанныеФормата = Неопределено;
	
	Попытка
		
		ПредставлениеЭД = ДанныеДокумента.ПредставлениеЭД;
		
		Если Не ПустаяСтрока(ПредставлениеЭД) Тогда
			
			БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "БизнесПроцесс");
			
			Если ПредставлениеЭД = "Счет на оплату (сервис ЭДО)" Тогда
				
				ДанныеФормата = Новый Структура;
				ДанныеФормата.Вставить("КодТипаДокумента", "BILL");
				ДанныеФормата.Вставить("ВерсияФормата", "Счет 1.01");
				ДанныеФормата.Вставить("ПространствоИмен", "KKSNG_BILL");
				ДанныеФормата.Вставить("Идентификатор", "BILL");
				
				Если БизнесПроцесс = "УВХД" Тогда
					ДанныеФормата.Вставить("КодТипаДокумента", "UVHD_BILL");
					ДанныеФормата.Вставить("ВерсияФормата", "Счет 1.01");
					ДанныеФормата.Вставить("ПространствоИмен", "KKSNG_BILL_UVHD");
					ДанныеФормата.Вставить("Идентификатор", "UVHD_BILL");
				КонецЕсли;
				
			Иначе
				
				ИмяВариантаНастройки = ?(ДанныеДокумента.ПрофильКонтрагента.ВариантНастройкиОбмена = "Использовать настройки организации",
				ДанныеДокумента.ПрофильОрганизации.ВариантНастройкиОбмена,
				ДанныеДокумента.ПрофильКонтрагента.ВариантНастройкиОбмена);
				
				Если СтрНайти(ИмяВариантаНастройки, "для комплекта документов") > 0
					// Чтобы счет-фактура авансовый уходил как УПД СЧФ, а не как УПД СЧФДОП.
					И (ДанныеДокумента.ЭтоАванс
					// Чтобы счет-фактура комиссионеру уходил как УПД СЧФ, а не как УПД СЧФДОП.
					Или ДанныеДокумента.ЭтоКомиссия
					// Чтобы РТУ с видом операции "Передача на комиссию" уходила как УПД ДОП.
					Или ДанныеДокумента.ПредставлениеЭД = "Товарная накладная") Тогда
					ИмяВариантаНастройки = СтрЗаменить(ИмяВариантаНастройки, "для комплекта документов", "для каждого документа");
				КонецЕсли;
				
				ДанныеФормата = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьФорматЭлектронногоДокумента(ИмяВариантаНастройки, ПредставлениеЭД);
				ДанныеФормата = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеФормата);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстСообщения = СтрШаблон("Не удалось определить формат ЭДО для документа %1.", ДанныеДокумента.ДокументСсылка);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстСообщения, "SE-00014", ОписаниеОшибки);
		
	КонецПопытки;
	
	Ответ.Результат = ДанныеФормата;
	Ответ.Успех = (ДанныеФормата <> Неопределено);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Формирует массив данных документов с помощью процедур подключаемого модуля
//
// Параметры:
//	МассивДокументов                - Массив ссылок
//	ПрофильЭДООрганизации           - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации            - Структура:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Массив
//
Функция ПодготовитьДанныеЭлектронныхДокументов(МассивДокументов, ПрофильОрганизации, ПараметрыАвторизации, ДополнительныеПараметры = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	СписокДокументов = Новый Массив;
	
	Для каждого ДокументЭлемент Из МассивДокументов Цикл
		
		ДокументСсылка = ДокументЭлемент.Ссылка;
		
		// ККСНГ: ЭТАП 1 - Логирование
		ККСНГ_ТекстЛога = "--- Начата подготовка данных для документа: " + Строка(ДокументСсылка);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ККСНГ_ТекстЛога);
		Сообщить(ККСНГ_ТекстЛога);
		
		ОтветПоДокументу = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		ОтветПоДокументу.Результат = ДокументСсылка;
		
		ДанныеДокумента = ККСНГ_ЭлектронныеДокументы.СтруктураДанныхДокумента();
		ДанныеДокумента.Вставить("ПрофильОрганизации", ПрофильОрганизации);
		ДанныеДокумента.Вставить("КодЭДООтправителя",  ПрофильОрганизации.КодУчастникаЭДО);
		ДанныеДокумента.Вставить("ОтправительЭД",  ПрофильОрганизации.Организация);
		ДанныеДокумента.Вставить("ПолучательЭД",  ДокументЭлемент.Контрагент);
		
		ДанныеДокумента.БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "БизнесПроцесс");
		
		// Получение данных документа
		ОбщийМодульПолучениеДанных = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПолучениеДанных");
		ЗапросДанныхДокумента = ОбщийМодульПолучениеДанных.ДанныеДокумента(ДокументСсылка, ДанныеДокумента);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросДанныхДокумента.Журнал);
		
		Если ЗапросДанныхДокумента.Успех Тогда
			
			ДанныеДокумента = ЗапросДанныхДокумента.Результат;
			
			ЗапросНаДополнение = ДополнитьДанныеДокументаДаннымиЭДО(ДанныеДокумента, ПрофильОрганизации);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросНаДополнение.Журнал);
			
			Если ЗапросНаДополнение.Успех Тогда
				
				// Получение данных по инфополям документа
				ЗапросЗаполненияИнфополей = ДополнитьДанныеДокументаЗначениямиИнфополей(ДанныеДокумента);
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросЗаполненияИнфополей.Журнал);

				Если ЗапросЗаполненияИнфополей.Успех Тогда

					// Получение данных о формате отправляемого документа
					ЗапросДанныхФормата = ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента);
					ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросДанныхФормата.Журнал);
					
					Если ЗапросДанныхФормата.Успех Тогда
																
						ДанныеФормата = ЗапросДанныхФормата.Результат;
						
						ЗапросАктуальностФормата = ПроверитьАктуальностьФорматаУКД(ДанныеДокумента, ДанныеФормата);
						ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросАктуальностФормата.Журнал);
						
						Если ЗапросАктуальностФормата.Успех Тогда

							// Обновление кода ЭДО получателя на случай роуминга
							ЗапросКодаЭДО = ККСНГ_ДокументооборотВызовСервера.ПолучитьКодЭДОПолучателя(ДанныеДокумента.ПрофильКонтрагента, 
							ДанныеФормата.КодТипаДокумента, ПрофильОрганизации, ПараметрыАвторизации);
							Если ЗапросКодаЭДО.Успех Тогда
								ДанныеДокумента.КодЭДОПолучателя = ЗапросКодаЭДО.Результат;
							КонецЕсли;
							
							// Получение XML по документу
							ЗапросXML = ККСНГ_ФормированиеXML.СоздатьXML(ДанныеДокумента, ДанныеФормата);
							ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросXML.Журнал);

							// ККСНГ: ЭТАП 2 - Поиск счета через цепочку СФ -> Реализация -> Счет
							Если ЗапросXML.Успех Тогда
								ККСНГ_СчетСсылка = Неопределено;
								Попытка
									ККСНГ_Реализация = Неопределено;
									ККСНГ_МетаДанныеДок = ДокументСсылка.Метаданные();
									
									// 1. Определяем Реализацию
									Если Найти(ВРег(ККСНГ_МетаДанныеДок.Имя), "РЕАЛИЗАЦИЯ") > 0 Тогда
										ККСНГ_Реализация = ДокументСсылка;
									ИначеЕсли Найти(ВРег(ККСНГ_МетаДанныеДок.Имя), "СЧЕТФАКТУРА") > 0 Тогда
										// Ищем реализацию в Счетах-фактурах
										Если ККСНГ_МетаДанныеДок.Реквизиты.Найти("ДокументОснование") <> Неопределено И ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
											ККСНГ_Реализация = ДокументСсылка.ДокументОснование;
										ИначеЕсли ККСНГ_МетаДанныеДок.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
											Если ДокументСсылка.ДокументыОснования.Количество() > 0 Тогда
												ККСНГ_Реализация = ДокументСсылка.ДокументыОснования[0].ДокументОснование;
											КонецЕсли;
										КонецЕсли;
									КонецЕсли;

									Если ЗначениеЗаполнено(ККСНГ_Реализация) Тогда
										ККСНГ_Инфо = "ККСНГ: Поиск счета в реализации: " + Строка(ККСНГ_Реализация);
										Сообщить(ККСНГ_Инфо);
										
										ККСНГ_МетаРеализации = ККСНГ_Реализация.Метаданные();
										// Проверяем реквизиты счета в реализации
										Если ККСНГ_МетаРеализации.Реквизиты.Найти("СчетНаОплату") <> Неопределено Тогда
											ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплату;
										ИначеЕсли ККСНГ_МетаРеализации.Реквизиты.Найти("СчетНаОплатуПокупателю") <> Неопределено Тогда
											ККСНГ_СчетСсылка = ККСНГ_Реализация.СчетНаОплатуПокупателю;
										КонецЕсли;
									КонецЕсли;
								Исключение
									ККСНГ_ТекстОшибки = "ККСНГ: Ошибка поиска цепочки СФ-Реализация-Счет: " + ОписаниеОшибки();
									Сообщить(ККСНГ_ТекстОшибки);
									ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_ТекстОшибки);
								КонецПопытки;

								Если ЗначениеЗаполнено(ККСНГ_СчетСсылка) Тогда
									ККСНГ_Инфо = "ККСНГ: Найден связанный счет: " + Строка(ККСНГ_СчетСсылка);
									Сообщить(ККСНГ_Инфо);
									ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_Инфо);

									ККСНГ_УпрПечатью = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("УправлениеПечатью", Ложь);
									ККСНГ_ОбщНазн = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ОбщегоНазначения", Ложь);

									Если ККСНГ_УпрПечатью <> Неопределено И ККСНГ_ОбщНазн <> Неопределено Тогда
										Попытка
											ККСНГ_МассивСчетов = Новый Массив;
											ККСНГ_МассивСчетов.Добавить(ККСНГ_СчетСсылка);

											// Полный набор колонок для БСП 3.0 любого поколения
											ККСНГ_ОбъектыПечати = Новый СписокЗначений;
											ККСНГ_КоллекцияПФ = Новый ТаблицаЗначений;
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ИмяВКоллекции");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("Имя");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ИмяМакета");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ИмяВРЕГ");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ТабличныйДокумент");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("Экземпляров");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("КоличествоЭкземпляров");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ИмяФайлаПечатнойФормы");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("СинонимМакета");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("Представление");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("Картинка");
											ККСНГ_КоллекцияПФ.Колонки.Добавить("ПолныйПутьКМакету");
											
											ККСНГ_НоваяСтрока = ККСНГ_КоллекцияПФ.Добавить();
											ККСНГ_НоваяСтрока.ИмяВКоллекции = "СчетЗаказ";
											ККСНГ_НоваяСтрока.Имя           = "СчетЗаказ";
											ККСНГ_НоваяСтрока.ИмяМакета     = "СчетЗаказ";
											ККСНГ_НоваяСтрока.ИмяВРЕГ       = "СЧЕТЗАКАЗ";
											ККСНГ_НоваяСтрока.СинонимМакета = "Счет на оплату";
											ККСНГ_НоваяСтрока.Представление = "Счет на оплату";
											ККСНГ_НоваяСтрока.Экземпляров   = 1;
											ККСНГ_НоваяСтрока.КоличествоЭкземпляров = 1;

											// В вашей версии менеджер печати - это отдельная обработка
											Попытка
												ККСНГ_МенеджерПечати = Обработки.ПечатьСчетаНаОплату;
											Исключение
												ККСНГ_МенеджерПечати = ККСНГ_ОбщНазн.МенеджерОбъектаПоСсылке(ККСНГ_СчетСсылка);
											КонецПопытки;
											
											ККСНГ_МенеджерПечати.Печать(ККСНГ_МассивСчетов, Новый Структура, ККСНГ_КоллекцияПФ, ККСНГ_ОбъектыПечати, ККСНГ_УпрПечатью.ПодготовитьСтруктуруПараметровВывода());

											ККСНГ_ПФ = Неопределено;
											Сообщить("ККСНГ: Анализ коллекции ПФ (всего " + ККСНГ_КоллекцияПФ.Количество() + "):");
											
											Для Каждого ККСНГ_Стр Из ККСНГ_КоллекцияПФ Цикл
												ККСНГ_СтатусТабДок = ?(ККСНГ_Стр.ТабличныйДокумент <> Неопределено, "Заполнен", "ПУСТО");
												Сообщить("ККСНГ: -> Форма: '" + ККСНГ_Стр.ИмяВКоллекции + "', ТабДок: " + ККСНГ_СтатусТабДок);
												
												Если ККСНГ_ПФ = Неопределено И ККСНГ_Стр.ТабличныйДокумент <> Неопределено Тогда
													ККСНГ_ПФ = ККСНГ_Стр;
												КонецЕсли;
											КонецЦикла;

											Если ККСНГ_ПФ <> Неопределено И ККСНГ_ПФ.ТабличныйДокумент <> Неопределено Тогда
												ККСНГ_ИмяФайлаPDF = ПолучитьИмяВременногоФайла("pdf");
												Попытка
													ККСНГ_ПФ.ТабличныйДокумент.Записать(ККСНГ_ИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF);
													ККСНГ_ДД_PDF = Новый ДвоичныеДанные(ККСНГ_ИмяФайлаPDF);
													
													// Сохраняем вложение для последующей отправки
													ККСНГ_СтруктураВложения = ИнициализироватьСтруктуруВложения();
													// СБИС чувствителен к именам файлов, убираем пробелы и знаки
													ККСНГ_ИмяБезПробелов = "Bill_" + СтрЗаменить(ККСНГ_СчетСсылка.Номер, " ", "_") + ".pdf";
													ККСНГ_СтруктураВложения.ИмяФайла = ККСНГ_ИмяБезПробелов;
													ККСНГ_СтруктураВложения.Наименование = "Счет на оплату";
													ККСНГ_СтруктураВложения.Расширение = "pdf";
													ККСНГ_СтруктураВложения.АдресВХранилище = ККСНГ_ДД_PDF; 
													
													// Доп. поля для роуминга (СБИС)
													ККСНГ_СтруктураВложения.Вставить("TypeCode", "Other");
													ККСНГ_СтруктураВложения.Вставить("Relation", "Invoice");
													
													ККСНГ_Инфо = "ККСНГ: Счет подготовлен (имя: " + ККСНГ_ИмяБезПробелов + ")";
													ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_Инфо);
													
													// Добавляем в массив вложений документа (безопасная инициализация)
													ККСНГ_МассивВложений = Неопределено;
													Если Не ДанныеДокумента.Свойство("Вложения", ККСНГ_МассивВложений) Или ККСНГ_МассивВложений = Неопределено Тогда
														ККСНГ_МассивВложений = Новый Массив;
														ДанныеДокумента.Вставить("Вложения", ККСНГ_МассивВложений);
													КонецЕсли;
													ККСНГ_МассивВложений.Добавить(ККСНГ_СтруктураВложения);
													
												Исключение
													ККСНГ_ТекстОшибки = "ККСНГ: Ошибка сохранения PDF (лицензия): " + ОписаниеОшибки();
													ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_ТекстОшибки);
													
													// ЗАПАСНОЙ ВАРИАНТ ДЛЯ ТЕСТА В УЧЕБНОЙ ВЕРСИИ
													ККСНГ_ДД_Тест = ПолучитьДвоичныеДанныеИзСтроки("Тестовый файл вместо счета (ограничение лицензии 1С)", "UTF-8");
													ККСНГ_СтруктураВложения = ИнициализироватьСтруктуруВложения();
													ККСНГ_СтруктураВложения.ИмяФайла = "Bill_TEST.txt";
													ККСНГ_СтруктураВложения.Наименование = "Счет на оплату (ТЕСТ)";
													ККСНГ_СтруктураВложения.Расширение = "txt";
													ККСНГ_СтруктураВложения.АдресВХранилище = ККСНГ_ДД_Тест;
													
													// Доп. поля для роуминга
													ККСНГ_СтруктураВложения.Вставить("TypeCode", "Other");
													ККСНГ_СтруктураВложения.Вставить("Relation", "Invoice");
													
													ККСНГ_МассивВложений = Неопределено;
													Если Не ДанныеДокумента.Свойство("Вложения", ККСНГ_МассивВложений) Или ККСНГ_МассивВложений = Неопределено Тогда
														ККСНГ_МассивВложений = Новый Массив;
														ДанныеДокумента.Вставить("Вложения", ККСНГ_МассивВложений);
													КонецЕсли;
													ККСНГ_МассивВложений.Добавить(ККСНГ_СтруктураВложения);
													Сообщить("ККСНГ: PDF недоступен, добавлен текстовый файл для проверки пакета.");
												КонецПопытки;
												
												Попытка
													УдалитьФайлы(ККСНГ_ИмяФайлаPDF);
												Исключение
												КонецПопытки;
											Иначе
												ККСНГ_Инфо = "ККСНГ: Не удалось получить заполненный ТабличныйДокумент.";
												ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_Инфо);
											КонецЕсли;
										Исключение
											ККСНГ_ТекстОшибки = "ККСНГ: Ошибка генерации PDF: " + ОписаниеОшибки();
											Сообщить(ККСНГ_ТекстОшибки);
											ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_ТекстОшибки);
										КонецПопытки;
									КонецЕсли;
								Иначе
									ККСНГ_Инфо = "ККСНГ: Связанный счет не найден.";
									Сообщить(ККСНГ_Инфо);
									ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(ОтветПоДокументу.Журнал, ККСНГ_Инфо);
								КонецЕсли;
							КонецЕсли;

							ДанныеСвязанногоДокумента = ДанныеСвязанногоДокумента(ДанныеДокумента.ДокументСсылка);
							
							ДанныеЭД = Новый Структура;
							
							ДанныеЭД.Вставить("Дата", ДанныеДокумента.Дата);
							ДанныеЭД.Вставить("ПредставлениеНомера", ДанныеДокумента.Номер);
							ДанныеЭД.Вставить("ДоговорДата", ДанныеДокумента.СведенияОДоговоре.Дата);
							ДанныеЭД.Вставить("ДоговорНомер", ДанныеДокумента.СведенияОДоговоре.Номер);
							ДанныеЭД.Вставить("Организация", ДанныеДокумента.ОтправительЭД);
							ДанныеЭД.Вставить("Ссылка", ДанныеДокумента.ДокументСсылка);
							ДанныеЭД.Вставить("Контрагент", ДанныеДокумента.ПолучательЭД);
							ДанныеЭД.Вставить("ИдентификаторСвязанногоДокумента", ДанныеСвязанногоДокумента.Идентификатор);
							ДанныеЭД.Вставить("ТипСвязи", ДанныеСвязанногоДокумента.ТипСвязи);
							
							ДанныеЭД.Вставить("КодУчастникаЭДОПолучателя", ДанныеДокумента.КодЭДОПолучателя);
							ДанныеЭД.Вставить("Подпись");
							ДанныеЭД.Вставить("КодТипаДокумента", ДанныеФормата.КодТипаДокумента);
							
							ДанныеЭД.Вставить("ДокументСсылка", ДокументСсылка);
							ДанныеЭД.Вставить("ДанныеФормата", ДанныеФормата);
							ДанныеЭД.Вставить("Данные", ?(ЗапросXML.Успех, ЗапросXML.Результат, Неопределено));
							ДанныеЭД.Вставить("ИмяФайла", ?(ЗапросXML.Успех, ДанныеДокумента.ИдФайл + ".xml", Неопределено));
							ДанныеЭД.Вставить("ПрофильКонтрагента", ДанныеДокумента.ПрофильКонтрагента);
							ДанныеЭД.Вставить("ПрофильОрганизации", ДанныеДокумента.ПрофильОрганизации);
							
							ПараметрыЗапроса = Новый Структура("БизнесПроцесс", ДанныеДокумента.БизнесПроцесс);
							ДопПараметрыДокумента = ККСНГ_ЭлектронныеДокументы.ПолучитьДопПараметрыДокумента(ДанныеЭД, ПараметрыЗапроса);
							ДополнитьДопПараметрыДокументаПриНаличииМаркировки(ДанныеДокумента, ДанныеФормата, ДопПараметрыДокумента);
							ДанныеЭД.Вставить("ДопПараметры", ДопПараметрыДокумента);
							
							ДанныеЭД.Вставить("ДанныеПодписанта", Неопределено);
							
							ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеЭД, ИнициализироватьДопРеквизитыДокумента());
							
							// ККСНГ: Передаем вложения после стандартизации структуры, чтобы избежать пересечения ключей
							ДанныеЭД.Вставить("Вложения", ДанныеДокумента.Вложения);
							
							ДанныеДляПодписи = Новый Структура;
							ДанныеДляПодписи.Вставить("Данные", ДанныеЭД);
							ДанныеДляПодписи.Вставить("ИмяПоляДД", "Данные");
							ДанныеДляПодписи.Вставить("Представление", ДанныеЭД.ИмяФайла);
							
							ОтветПоДокументу.Результат = ДанныеДляПодписи;
							ОтветПоДокументу.Успех = ЗапросXML.Успех; 
							
						КонецЕсли; // ЗапросАктуальностФормата
						
					КонецЕсли; // ЗапросДанныхФормата 
					
				КонецЕсли; // ЗапросЗаполненияИнфополей
				
			КонецЕсли; // ЗапросНаДополнение
			
		КонецЕсли; // ЗапросДанныхДокумента	
		
		Если ОтветПоДокументу.Успех И ДанныеДокумента.БизнесПроцесс = "УВХД" Тогда
			ЗапросПроверкаДопПараметров = ККСНГ_ЭлектронныеДокументы.ПроверитьЗаполнениеДопПараметровДокумента(ДанныеЭД.ДопПараметры, ДокументСсылка);				
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(ОтветПоДокументу.Журнал, ЗапросПроверкаДопПараметров.Журнал);
			ОтветПоДокументу.Успех = ОтветПоДокументу.Успех И ЗапросПроверкаДопПараметров.Успех;	
		КонецЕсли;
		
		// Логи
		ЗаполнитьДанныеПоОшибке(ОтветПоДокументу.Журнал, ДокументСсылка);
		// Логи
		
		СписокДокументов.Добавить(ОтветПоДокументу);
		
	КонецЦикла;
	
	Ответ.Результат = СписокДокументов;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

Функция ЕстьМаркировкаПива(ДанныеДокумента) Экспорт
	
	Перем Результат, ВидыПродукцииИС;
	
	Результат = Ложь;
	
	ВидыПродукцииИС = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ВидыПродукцииИС");
	Если ТипЗнч(ВидыПродукцииИС) = Тип("Соответствие") Тогда
		Результат = ВидыПродукцииИС[ВРег("Пиво")] = Истина Или ВидыПродукцииИС[ВРег("ПивоВПотребительскихУпаковках")] = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьДопПараметрыДокументаПриНаличииМаркировки(ДанныеДокумента, ДанныеФормата, ДопПараметрыДокумента) Экспорт
	
	Перем Идентификатор, ФункцияУПД, Параметр;
	
	Идентификатор = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеФормата, "Идентификатор");
	ФункцияУПД = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеФормата, "ФункцияУПД");
	
	Если Идентификатор = "УПД_2024" И (ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП") И ЕстьМаркировкаПива(ДанныеДокумента) Тогда
		Если ТипЗнч(ДопПараметрыДокумента) = Тип("Массив") Тогда
			
			Параметр = Новый Структура();
			Параметр.Вставить("Ключ", "system.sendingGIS");
			Параметр.Вставить("Значение", "CZ.FIX");
			ДопПараметрыДокумента.Добавить(Параметр);
			
			Параметр = Новый Структура();
			Параметр.Вставить("Ключ", "system.productGroup");
			Параметр.Вставить("Значение", "beer");
			ДопПараметрыДокумента.Добавить(Параметр);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Дополняет данными по профилям отправителя и получателя
//
// Параметры:
//	ДанныеДокумента                 - Структура
//                                      * ПрофильОрганизации
//                                      * КодЭДООтправителя
//                                      * ПрофильКонтрагента
//                                      * КодЭДОПолучателя
//	ПрофильЭДООрганизации           - СправочникСсылка.ККСНГ_Организации
//
// Возвращаемое значение:
//	Структура, см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ДополнитьДанныеДокументаДаннымиЭДО(ДанныеДокумента, ПрофильОрганизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ККСНГ_Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|ГДЕ
	|	ККСНГ_Контрагенты.Владелец = &ПрофильОрганизации
	|	И ККСНГ_Контрагенты.Контрагент = &Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ККСНГ_Контрагенты.ПометкаУдаления";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПрофильОрганизации", ПрофильОрганизации);
	Запрос.УстановитьПараметр("Контрагент", ДанныеДокумента.ПолучательЭД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПрофильКонтрагента = Выборка.Ссылка;
		Если НЕ ДанныеДокумента.Свойство("ПрофильОрганизации") Тогда
			ДанныеДокумента.Вставить("ПрофильОрганизации", ПрофильОрганизации);
		КонецЕсли;
		Если НЕ ДанныеДокумента.Свойство("КодЭДООтправителя") Тогда
			ДанныеДокумента.Вставить("КодЭДООтправителя", ПрофильОрганизации.КодУчастникаЭДО);
		КонецЕсли;
		Если НЕ ДанныеДокумента.Свойство("ПрофильКонтрагента") Тогда
			ДанныеДокумента.Вставить("ПрофильКонтрагента", ПрофильКонтрагента);
		КонецЕсли;
		Если НЕ ДанныеДокумента.Свойство("КодЭДОПолучателя") Тогда
			ДанныеДокумента.Вставить("КодЭДОПолучателя", ПрофильКонтрагента.КодУчастникаЭДО);	
		КонецЕсли;
		
		Ответ.Успех = Истина;
		
	КонецЦикла;
	
	Если Не Ответ.Успех Тогда
		ТекстСообщения = СтрШаблон("Для контрагента %1 не найдена настройка ЭДО.", ДанныеДокумента.ПолучательЭД);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстСообщения, "SE-00013");
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Добавляет информацию по инфополям в данные по документу
//
// Параметры:
//	ДанныеДокумента                 - Структура
//                                      * ИнфоФХЖ1/2/3
//
// Возвращаемое значение:
//	Структура, см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ДополнитьДанныеДокументаЗначениямиИнфополей(ДанныеДокумента) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если ДанныеДокумента.ЭтоСФ И Не ДанныеДокумента.ЭтоАванс Тогда
		ДокументСсылка = ДанныеДокумента.ДокументСсылка.ДокументОснование;
		ДокументСчетфактура = ДанныеДокумента.СсылкаСчетаФактуры; 
	Иначе
		ДокументСсылка = ДанныеДокумента.ДокументСсылка;
		ДокументСчетфактура = Неопределено;
	КонецЕсли;
	
	ЗапросИнфополей = ККСНГ_ЭлектронныеДокументы.ПолучитьЗначенияИнфополейДокумента(ДокументСсылка, ДанныеДокумента.ПрофильКонтрагента, ДокументСчетфактура);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросИнфополей.Журнал);
	
	Если ЗапросИнфополей.Успех Тогда
		ЗначенияИнфополей = ЗапросИнфополей.Результат;
		
		МассивФХЖ1 = Неопределено;
		
		Если ЗначенияИнфополей.Свойство("ИнфоФХЖ1", МассивФХЖ1) Тогда
			ДанныеДокумента.ИнфополяФХЖ1 = МассивФХЖ1;
		КонецЕсли;
		
		МассивФХЖ3 = Неопределено;
		
		Если ЗначенияИнфополей.Свойство("ИнфоФХЖ3", МассивФХЖ3) Тогда
			ДанныеДокумента.ИнфополяФХЖ3 = МассивФХЖ3;
		КонецЕсли;
		
		МассивФХЖ2 = Неопределено;
		
		Если ЗначенияИнфополей.Свойство("ИнфоФХЖ2", МассивФХЖ2) Тогда
			
			Для каждого ЭлементФХЖ2 Из МассивФХЖ2 Цикл
				
				ПоляИдентификации = ЭлементФХЖ2.ДопПоля;
				
				Если ПустаяСтрока(ПоляИдентификации.ТабличнаяЧасть) Тогда
					
					ЭлементФХЖ2.Удалить("ДопПоля");
					
					Для Каждого СтрокаТЗ Из ДанныеДокумента.ТоварыУслуги Цикл
						
						СтрокаТЗ.ИнфополяФХЖ2.Добавить(ЭлементФХЖ2);
						
					КонецЦикла;
					
				Иначе
					
					// Пока идентификацию строк производим по номеру строки и номенклатуре/ содержанию
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("НомерСтроки", ПоляИдентификации.НомерСтроки);
					
					Если ПоляИдентификации.Свойство("Номенклатура") Тогда
						СтруктураОтбора.Вставить("НоменклатураСсылка", ПоляИдентификации.Номенклатура);
					ИначеЕсли ПоляИдентификации.Свойство("Содержание") Тогда
						СтруктураОтбора.Вставить("Содержание", ПоляИдентификации.Содержание);
					КонецЕсли;
					
					НайдСтроки = ДанныеДокумента.ТоварыУслуги.НайтиСтроки(СтруктураОтбора);
					
					Если НайдСтроки.Количество() = 1 Тогда
						
						ЭлементФХЖ2.Удалить("ДопПоля");
						
						НайдСтроки[0].ИнфополяФХЖ2.Добавить(ЭлементФХЖ2);
						
					Иначе // TODO прерывать формирование?
						
						ТекстОшибки = СтрШаблон("Ошибка установки значения инфополя %1 в строке %2 документа %3.", ЭлементФХЖ2.Идентиф, ПоляИдентификации.НомерСтроки, ДанныеДокумента.ДокументСсылка); 
						ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "IF-000003");
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.Успех = ЗапросИнфополей.Успех;
	
	Возврат Ответ;
	
КонецФункции

// Заполняет подписанта в структуре данных электронного документа 
//
// Параметры:
//	ДвоичныеДанныеХранилище  - Строка - Адрес хранилища данных ЭД
//	Сертификат               - Структура или ссылка справочника "Сертификаты ЭП"
//	ПараметрыЭД              - Структура:
//                              * ДанныеФормата
//
// Возвращаемое значение:
//	Строка - Адрес хранилища данных ЭД
//
Функция ЗаполнитьПодписантаНаСервере(ДвоичныеДанныеХранилище, ДанныеПодписанта, ПараметрыЭД) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Ошибки = Новый Массив;
	
	КодТипаДокумента = ПараметрыЭД.ДанныеФормата.КодТипаДокумента;
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЭД.ДокументСсылка, "Организация");
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЭД.ДокументСсылка, "Контрагент");
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДвоичныеДанныеХранилище);
	Если ДвоичныеДанные = Неопределено Тогда
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка получения данных документа при добавлении подписанта", "SG-00009");
		Возврат Ответ;
	КонецЕсли; 
	
	РезультатДанныеФайлаЭД = ККСНГ_СтруктурированныеДокументыВызовСервера.ПолучитьОбъектXDTOПоСтруктурированномуXML(ДвоичныеДанные); //XDTO
	
	Если Не РезультатДанныеФайлаЭД.Успех Тогда
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, РезультатДанныеФайлаЭД.Журнал, Ложь);
		Возврат Ответ;
	КонецЕсли; 
	
	ДанныеФайлаЭД = РезультатДанныеФайлаЭД.Результат;
	
	ПространствоИменСхемы = ДанныеФайлаЭД.Тип().URIПространстваИмен;
	
	ЭтоФизЛицо = Ложь;
	ОбменСКонтрагентамиПереопределяемый.ЭтоФизЛицо(Организация, ЭтоФизЛицо);
	
	ДанныеЮрФизЛица = Новый Структура("ИНН");
	ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, Организация);
	
	ОписаниеОшибкиИНН = "";
	Если Не ККСНГ_ОбщегоНазначенияКлиентСервер.ИННСоответствуетТребованиям(ДанныеЮрФизЛица.ИНН, НЕ ЭтоФизЛицо, ОписаниеОшибкиИНН) Тогда
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка заполнения ИНН у подписанта.", "SG-00010", ОписаниеОшибкиИНН);
		Возврат Ответ;
	КонецЕсли;
	
	Если КодТипаДокумента = "UPD_DOP" Или КодТипаДокумента = "UPD_SF"  Или КодТипаДокумента = "UPD_SF_DOP" Или КодТипаДокумента = "UCD_CSF" 
		Или КодТипаДокумента = "UCD_CSF_DIC" Или КодТипаДокумента = "UCD_DIC" 
		Или КодТипаДокумента = "BILL" Тогда
		
		Подписант = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант");
		
		Если ПространствоИменСхемы = "KKSNG_ON_NSCHFDOPPR_970" Тогда
			ЗаполнитьПодписантаПриказ970(ДанныеФайлаЭД, ДанныеПодписанта, Организация, Контрагент, Ошибки, ПространствоИменСхемы);
		Иначе
			
			Если Не ЭтоФизЛицо Тогда
				ЮридическоеЛицо = ЗаполнитьПодписантаЮридическоеЛицо(ДанныеЮрФизЛица, ДанныеПодписанта, Ошибки, Подписант, ПространствоИменСхемы);
			Иначе
				ИндивидуальныйПредприниматель = ЗаполнитьПодписантаФизическоеЛицо(ДанныеЮрФизЛица, ДанныеПодписанта, Организация, Ошибки, Подписант, ПространствоИменСхемы);
			КонецЕсли;
			
			Если КодТипаДокумента = "BILL" Тогда
				Если Не ЭтоФизЛицо Тогда
					ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант, "ЮЛ", ЮридическоеЛицо, Ошибки);
				Иначе
					ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант, "ИП", ИндивидуальныйПредприниматель, Ошибки);
				КонецЕсли;
			Иначе
				ИндексПодписанта = ДанныеФайлаЭД.Документ.Подписант.Количество() - 1;
				Если Не ЭтоФизЛицо Тогда
					ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "ЮЛ", ЮридическоеЛицо, Ошибки);
				Иначе
					ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "ИП", ИндивидуальныйПредприниматель, Ошибки);
				КонецЕсли;
				
				Попытка
					ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта].Сбросить("ФЛ");
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;

	Иначе
		//ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Не реализовано заполнение подписанта для типа: ", КодТипаДокумента);
		ТекстСоощения = СтрШаблон("Не реализовано заполнение подписанта для документа: %1", КодТипаДокумента);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстСоощения, "SG-00002");
		Возврат Ответ;
	КонецЕсли; 
	
	Если Ошибки.Количество() Тогда
		
		Для Каждого ТекстСоощения Из Ошибки Цикл
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстСоощения, "SG-00003");
		КонецЦикла
		
	Иначе
		Попытка
			
			ДанныеФайлаЭД.Проверить();
			
			НоваяЗаписьXML = Новый ЗаписьXML;
			НоваяЗаписьXML.УстановитьСтроку("windows-1251");
			НоваяЗаписьXML.ЗаписатьОбъявлениеXML();
			ФабрикаXDTO.ЗаписатьXML(НоваяЗаписьXML, ДанныеФайлаЭД, , , , НазначениеТипаXML.Неявное);
			СтрокаXML = НоваяЗаписьXML.Закрыть();
			СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ПространствоИменСхемы + """", "");
			
			ДвоичныеДанныеЭД = ПолучитьДвоичныеДанныеИзСтроки(СтрокаXML, "windows-1251");
			Ответ.Результат = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЭД);
			Ответ.Успех = Истина;
		
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "", "SG-00001", ОписаниеОшибки);
		КонецПопытки;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ЗаполнитьПодписантаФизическоеЛицо(ДанныеЮрФизЛица, ДанныеСертификата, Организация, Ошибки, Подписант, ПространствоИменСхемы)
	
	Перем МодульККСНГ_ПМ_РаботаСМетаданными;
	Перем ДанныеСвидетельства, ИмяСертификата, ИндивидуальныйПредприниматель, ОтчествоСертификата, ФамилияСертификата, ФИО;
	
	ФамилияСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Фамилия", "");
	ИмяСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Имя", "");
	ОтчествоСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Отчество", "");
	
	ИндивидуальныйПредприниматель = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант.ИП");
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ИндивидуальныйПредприниматель, "ИННФЛ", ДанныеЮрФизЛица.ИНН, Ошибки);
	
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	ДанныеСвидетельства = МодульККСНГ_ПМ_РаботаСМетаданными.ДанныеСвидетельстваОРегистрацииИП(Организация); //TODO данные ИП
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ИндивидуальныйПредприниматель, "СвГосРегИП", ДанныеСвидетельства, Ошибки);
	
	ФИО = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант.ИП.ФИО");
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Фамилия", ФамилияСертификата, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Имя", ИмяСертификата, Ошибки);
	
	Если ЗначениеЗаполнено(ОтчествоСертификата) Тогда
		ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Отчество", ОтчествоСертификата, Ошибки);
	КонецЕсли;
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ИндивидуальныйПредприниматель, "ФИО", ФИО, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(Подписант, "ИП", ИндивидуальныйПредприниматель, Ошибки);
	
	Возврат ИндивидуальныйПредприниматель;
	
КонецФункции

Функция ЗаполнитьПодписантаЮридическоеЛицо(ДанныеЮрФизЛица, ДанныеСертификата, Ошибки, Подписант, ПространствоИменСхемы)
	
	Перем ИмяСертификата, ОтчествоСертификата, ФамилияСертификата, ФИО, ЮридическоеЛицо;
	
	ФамилияСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Фамилия", "");
	ИмяСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Имя", "");
	ОтчествоСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Отчество", "");
	ДолжностьПоСертификату = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Должность", "");
	
	ЮридическоеЛицо = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант.ЮЛ");
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ЮридическоеЛицо, "ИННЮЛ", ДанныеЮрФизЛица.ИНН, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ЮридическоеЛицо, "Должн", ДолжностьПоСертификату, Ошибки);
	
	ФИО = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант.ЮЛ.ФИО");
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Фамилия", ФамилияСертификата, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Имя", ИмяСертификата, Ошибки);
	
	Если ЗначениеЗаполнено(ОтчествоСертификата) Тогда
		ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Отчество", ОтчествоСертификата, Ошибки);
	КонецЕсли;
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ЮридическоеЛицо, "ФИО", ФИО, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(Подписант, "ЮЛ", ЮридическоеЛицо, Ошибки);
	
	Возврат ЮридическоеЛицо;
	
КонецФункции

Процедура ЗаполнитьПодписантаПриказ970(ДанныеФайлаЭД, ДанныеСертификата, Организация, Контрагент, Ошибки, ПространствоИменСхемы)
	
	Перем ФамилияСертификата, ИмяСертификата, ОтчествоСертификата, СпособПодтверждения;
	Перем ДатаДокумента, ДатаПодписанияДокумента, ИндексПодписанта, ФИО;
	Перем СведенияОДоверенности, ДанныеМЧД;
	
	ФамилияСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Фамилия");
	ИмяСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Имя");
	ОтчествоСертификата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Отчество");
	ДолжностьПоСертификату = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСертификата, "Должность");
	
	ИндексПодписанта = ДанныеФайлаЭД.Документ.Подписант.Количество() - 1;
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "Должн", ДолжностьПоСертификату, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "ТипПодпис", "1", Ошибки);
	
	ДатаДокумента = ДанныеФайлаЭД.Документ.СвСчФакт.ДатаДок;
	ДатаПодписанияДокумента = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyy");
	
	Если СтрСравнить(ДатаПодписанияДокумента, ДатаДокумента) <> 0 Тогда
		ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "ДатаПодДок", ДатаПодписанияДокумента, Ошибки);
	КонецЕсли;
	
	ФИО = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "ФИОТип");
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Фамилия", ФамилияСертификата, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Имя", ИмяСертификата, Ошибки);
	
	Если ЗначениеЗаполнено(ОтчествоСертификата) Тогда
		ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ФИО, "Отчество", ОтчествоСертификата, Ошибки);
	КонецЕсли;
	
	// Сведения о доверенности в электронной форме в машиночитаемом виде
	Если ДанныеСертификата.ТребуетсяМЧД = Истина И СтрСравнить(ДанныеСертификата.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда 
		
		// Блок СвДоверЭл заполняется только при варианте метаданные (СпособПодтверждения = 3)
		Доверенность = ДанныеСертификата.МЧД;
		СведенияОДоверенности = ККСНГ_XDTOКлиентСервер.СоздатьОбъектXDTO(ПространствоИменСхемы, "Файл.Документ.Подписант.СвДоверЭл");
		
		Если ТипЗнч(Доверенность) = Тип("Структура") Тогда
			
			ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(СведенияОДоверенности, "НомДовер", Доверенность.Номер, Ошибки);
			ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(СведенияОДоверенности, "ДатаВыдДовер", Формат(Доверенность.ДатаНачала, "ДФ=dd.MM.yyy"), Ошибки);
			ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(СведенияОДоверенности, "ИдСистХран", Доверенность.ИнформационнаяСистема, Ошибки);
			ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта].СвДоверЭл.Добавить(СведенияОДоверенности);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеСертификата.ТребуетсяМЧД = Ложь Тогда
		СпособПодтверждения = 1; // Без доверенности
	ИначеЕсли СтрСравнить(ДанныеСертификата.ВариантОтправкиМЧД, "Пакет") = 0 Тогда
		СпособПодтверждения = 2; // МЧД пакетом
	ИначеЕсли СтрСравнить(ДанныеСертификата.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
		СпособПодтверждения = 3; // МЧД сведения об инф. системе
	ИначеЕсли СтрСравнить(ДанныеСертификата.ВариантОтправкиМЧД, "НеОтправлять") = 0 Тогда
		СпособПодтверждения = 4; // МЧД отправляется отдельно
	Иначе
		СпособПодтверждения = 6; // Иное
	КонецЕсли;
	
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "СпосПодтПолном", СпособПодтверждения, Ошибки);
	ККСНГ_XDTOКлиентСервер.УстановитьЗначениеСвойстваXDTO(ДанныеФайлаЭД.Документ.Подписант[ИндексПодписанта], "ФИО", ФИО, Ошибки);
	
КонецПроцедуры

// Получает ошибки по маркируемой продукции от ЦРПТ 
//
// Параметры:
//	ПараметрыАвторизации            - Структура:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//	Id                               - id ЭД
//
// Возвращаемое значение:
//	Массив структур:
//	 * Заголовок
//	 * КодОшибки
//	 * ОписаниеОшибки
//	 * ИНН
//	 * КодыМаркировок
//	 * КодыУпаковок
//	 * НомерДатаДокумента
//	 * НомерДатаИсправления
//
Функция ПолучитьОшибкиПоМаркируемойПродукцииИзЦРПТ(ПараметрыАвторизации, Id) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ИнформацияПоОшибкам = ККСНГ_APIКурьер.v2_DocumentExternalServices(ПараметрыАвторизации, Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ИнформацияПоОшибкам.Журнал, Ложь);
	
	Если ИнформацияПоОшибкам.Успех Тогда
		
		ИнформацияДляВывода = Новый Массив;
        ТекстОшибки = "";
		
		Для каждого ОтветПоОшибкам Из ИнформацияПоОшибкам.Результат.ExternalServiceData Цикл
			
			Если НЕ НРЕГ(ОтветПоОшибкам.ServiceCode) = "cz" Тогда
				Продолжить;
			КонецЕсли;
			
			ИнформацияИзЦРПТ = СтруктураИнформацииОшибкиЦРПТ();
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветПоОшибкам.Data);
			ДанныеЦРПТ = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Обработано = ЗаполнитьИнформациюИзЦРПТ(ИнформацияИзЦРПТ, ДанныеЦРПТ);	
			Если Обработано Тогда
				ИнформацияДляВывода.Добавить(ИнформацияИзЦРПТ);	
			Иначе
				ТекстОшибки = "Ошибка десериализации данных ЦРПТ.";
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Ответ.Результат = ИнформацияДляВывода;
		Если ТекстОшибки = "" Тогда
			Ответ.Успех = Истина;		
		Иначе	
			Ответ.Успех = Ложь;
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "MK-00004");
		КонецЕсли;
		
	КонецЕсли;	

	Возврат Ответ;
	
КонецФункции

// Получает ошибки по маркируемой продукции от ЦРПТ 
//
// Параметры:
//	ДанныеЦРПТ            - Структура:
//								см.СтруктураИнформацииПоОшибкамЦРПТ()
//
// Возвращаемое значение:
//	Структура:
//	 * Заголовок
//	 * КодОшибки
//	 * ОписаниеОшибки
//	 * ИНН
//	 * КодыМаркировок
//	 * КодыУпаковок
//	 * НомерДатаДокумента
//	 * НомерДатаИсправления
//
Функция ДанныеПоОшибкеПоМаркируемойПродукцииИзЦРПТ(ДанныеЦРПТ) Экспорт
	
	Перем Ответ;
	Перем ИнформацияИзЦРПТ, Обработано;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ИнформацияИзЦРПТ = СтруктураИнформацииЦРПТ();
	Обработано = ЗаполнитьИнформациюИзЦРПТ(ИнформацияИзЦРПТ, ДанныеЦРПТ);
	Если Обработано Тогда
		Ответ.Успех = Истина;
		Ответ.Результат = ИнформацияИзЦРПТ;
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка десериализации данных ЦРПТ.", "MK-00004");
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Возвращает структуру дополнительных реквизитов
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//	Структура
//
Функция ИнициализироватьДопРеквизитыДокумента() Экспорт 
	
	ДопРеквизиты = Новый Структура();
	ДопРеквизиты.Вставить("ДопАтрибуты");
	ДопРеквизиты.Вставить("Вложения");
	ДопРеквизиты.Вставить("Комментарий");
	ДопРеквизиты.Вставить("ЗапроситьПодпись", Ложь);
	
	Возврат ДопРеквизиты;
	
КонецФункции

// Возвращает структуру вложения
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//	Структура
//
Функция ИнициализироватьСтруктуруВложения() Экспорт
	
	СтруктураВложения = Новый Структура;
	
	СтруктураВложения.Вставить("Ссылка");
	СтруктураВложения.Вставить("ПолноеИмя");
	СтруктураВложения.Вставить("ИмяФайла");
	СтруктураВложения.Вставить("Наименование");
	СтруктураВложения.Вставить("Расширение");
	СтруктураВложения.Вставить("Размер");
	СтруктураВложения.Вставить("АдресВХранилище");
	СтруктураВложения.Вставить("ОписаниеОшибки");
	
	Возврат СтруктураВложения;
	
КонецФункции

Функция ПолучитьДанныеПодписанта(ОрганизацияЭДО, КонтрагентЭДО, Сертификат) Экспорт
	
	Перем Ответ;
	Перем ДвоичныеДанныеДанныеСертификата, ДанныеСертификата, СертификатКриптографии;
	Перем ЗапросОбработчикПередФормированием, ЗапросОбработчикПослеФормирования;
	Перем ЗапросДействующейДоверенности, ДанныеПодписанта, ПроверятьНаличиеФайлов;
	Перем ДанныеДоверенности, Комментарий, ВладелецНастройки;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	СтандартнаяОбработка = Истина;
	
	Если ТипЗнч(Сертификат) = Тип("СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования") Тогда
		
		ДвоичныеДанныеДанныеСертификата = Сертификат.ДанныеСертификата;
		Если ТипЗнч(ДвоичныеДанныеДанныеСертификата) = Тип("ХранилищеЗначения") Тогда
			ДвоичныеДанныеДанныеСертификата = ДвоичныеДанныеДанныеСертификата.Получить();
		КонецЕсли;
		
		СертификатКриптографии = Новый СертификатКриптографии(ДвоичныеДанныеДанныеСертификата);
		ДанныеСертификата = ККСНГ_ЭлектроннаяПодписьКлиентСервер.ПолучитьСвойстваСертификата(СертификатКриптографии);
		
	Иначе
		ДанныеСертификата = Сертификат;
	КонецЕсли;
	
	ЗапросОбработчикПередФормированием = ВыполнитьОбработчикПередЗаполнениемПодписанта(ОрганизацияЭДО, ДанныеСертификата, СтандартнаяОбработка);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОбработчикПередФормированием.Журнал, Ложь);
	
	Ответ.Результат = ЗапросОбработчикПередФормированием.Результат;
	Ответ.Успех = ЗапросОбработчикПередФормированием.Успех;
	
	Если Не ЗапросОбработчикПередФормированием.Успех Или Не СтандартнаяОбработка Тогда
		Возврат Ответ;
	КонецЕсли;
	
	ДанныеПодписанта = ПолучитьСтруктуруДанныхПодписанта();
	ДанныеПодписанта.Фамилия = ДанныеСертификата.Фамилия;
	ДанныеПодписанта.Имя = ДанныеСертификата.Имя;
	ДанныеПодписанта.Отчество = ДанныеСертификата.Отчество;
	ДанныеПодписанта.Должность = ДанныеСертификата.Должность;
	ДанныеПодписанта.ИНН = ДанныеСертификата.ИНН;
	
	Если Не ЗначениеЗаполнено(ДанныеПодписанта.Должность) Тогда
		ДанныеПодписанта.Должность = "Сотрудник";
	КонецЕсли;
	
	// Заполнение машиночитаемой доверенности
	ДанныеПодписанта.ТребуетсяМЧД = ККСНГ_МашиночитаемыеДоверенности.ТребуетсяМашиночитаемаяДоверенность(ОрганизацияЭДО, ДанныеСертификата);
	Если ДанныеПодписанта.ТребуетсяМЧД Тогда
		
		ВладелецНастройки = ?(ЗначениеЗаполнено(КонтрагентЭДО), КонтрагентЭДО, ОрганизацияЭДО);
		ДанныеПодписанта.ВариантОтправкиМЧД = ККСНГ_МашиночитаемыеДоверенности.ПолучитьВариантОтправкиДоверенности(ВладелецНастройки);
		
		Если СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "НеОтправлять") <> 0 Тогда
			
			ПроверятьНаличиеФайлов = СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Пакет") = 0;
			
			ЗапросДействующейДоверенности = ККСНГ_МашиночитаемыеДоверенности.ПолучитьДействующуюДоверенность(ОрганизацияЭДО, ДанныеСертификата.Отпечаток, ПроверятьНаличиеФайлов);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДействующейДоверенности.Журнал);
			
			Если ЗапросДействующейДоверенности.Успех Тогда
				
				ДанныеДоверенности = ККСНГ_МашиночитаемыеДоверенности.ПолучитьДанныеДоверенностиПоСсылке(ЗапросДействующейДоверенности.Результат);
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ДанныеДоверенности.Журнал);
				
				Если ДанныеДоверенности.Успех Тогда
					ДанныеДоверенности.Результат.ИННПредставителя = ДанныеСертификата.ИНН;
					ДанныеПодписанта.МЧД = ДанныеДоверенности.Результат;
				Иначе
					Возврат Ответ;
				КонецЕсли;
				
			Иначе
				
				Комментарий = СтрШаблон("Организация: %1, Отпечаток сертификата: %2, Вариант отправки МЧД: %3", ОрганизацияЭДО, ДанныеСертификата.Отпечаток, ДанныеПодписанта.ВариантОтправкиМЧД);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Не удалось найти машиночитаемую доверенность", "MCHD-000034", Комментарий);
				
				Ответ.Успех = ЗапросДействующейДоверенности.Успех;
				Возврат Ответ;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросОбработчикПослеФормирования = ВыполнитьОбработчикПослеЗаполненияПодписанта(ОрганизацияЭДО, ДанныеСертификата, ДанныеПодписанта);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОбработчикПослеФормирования.Журнал, Ложь);
	
	Ответ.Результат = ДанныеПодписанта;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьСтруктуруДанныхПодписанта() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Фамилия", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Отчество", "");
	Результат.Вставить("Должность", "");
	Результат.Вставить("ИНН", "");
	Результат.Вставить("ВариантОтправкиМЧД", "НеОтправлять");
	Результат.Вставить("ТребуетсяМЧД", Ложь);
	Результат.Вставить("МЧД", ККСНГ_МашиночитаемыеДоверенности.ПолучитьСтруктуруДанныхМЧД());
	
	Возврат Результат;
	
КонецФункции

#Область РаботаСДопРеквизитами

// Возвращает дополнительные реквизиты из РС ККСНГ_ПМ_ДопРеквизитыЭД
//
// Параметры:
//	ДокументСсылка - ссылка на документ ИБ
//
// Возвращаемое значение:
//	Структура , см.ИнициализироватьДопРеквизитыДокумента()
//
Функция ПолучитьДопРеквизитыЭлектронногоДокумента(ДокументСсылка) Экспорт
	
	ДопРеквизиты = ИнициализироватьДопРеквизитыДокумента();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ДопАтрибуты КАК ДопАтрибуты,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.Вложения КАК Вложения,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.Комментарий КАК Комментарий,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.УстановленыДопАтрибуты КАК УстановленыДопАтрибуты,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ЕстьВложения КАК ЕстьВложения,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ЗапросПодписи КАК ЗапроситьПодпись  
	|ИЗ
	|	РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД КАК ККСНГ_ПМ_ДопРеквизитыЭД
	|ГДЕ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.СвязанныйДокумент = &СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", ДокументСсылка);
	
	ВыборкаДопРеквизиты = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДопРеквизиты.Следующий() Тогда
		ЗаполнитьЗначенияДопРеквизитовЭД(ДопРеквизиты, ВыборкаДопРеквизиты);	
	КонецЕсли;
	
	Возврат ДопРеквизиты;
	
КонецФункции

// Возвращает дополнительные реквизиты из РС ККСНГ_ПМ_ДопРеквизитыЭД
//
// Параметры:
//	МассивДокументов - Массив ссылок на документ ИБ
//
// Возвращаемое значение:
//	Соответствие , см.ИнициализироватьДопРеквизитыДокумента()
//
Функция ПолучитьДопРеквизитыЭлектронныхДокументов(МассивДокументов) Экспорт
	
	ДокументыСДопРеквизитами = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.СвязанныйДокумент КАК ДокументСсылка,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ДопАтрибуты КАК ДопАтрибуты,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.Вложения КАК Вложения,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.Комментарий КАК Комментарий,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.УстановленыДопАтрибуты КАК УстановленыДопАтрибуты,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ЕстьВложения КАК ЕстьВложения,
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ЗапросПодписи КАК ЗапроситьПодпись  
	|ИЗ
	|	РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД КАК ККСНГ_ПМ_ДопРеквизитыЭД
	|ГДЕ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.СвязанныйДокумент В (&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	ВыборкаДопРеквизиты = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДопРеквизиты.Следующий() Цикл
		
		ДопРеквизиты = ИнициализироватьДопРеквизитыДокумента();
		ЗаполнитьЗначенияДопРеквизитовЭД(ДопРеквизиты, ВыборкаДопРеквизиты);
		ДокументыСДопРеквизитами.Вставить(ВыборкаДопРеквизиты.ДокументСсылка, ДопРеквизиты); 
		
	КонецЦикла;
	
	Возврат ДокументыСДопРеквизитами;
	
КонецФункции

// Обертки

// Получает доп реквизиты из РС ККСНГ_ПМ_ДопРеквизитыЭД
//
// Параметры:
//	НаборыДанных - Структура:
//                   * ДокументСсылка - ссылка на документ ИБ
//
// Возвращаемое значение:
//	Соответствие , см.ИнициализироватьДопРеквизитыДокумента()
//
Функция ПолучитьДопРеквизитыДокументовДляОтправки(НаборыДанных, УникальныйИдентфикатор = "") Экспорт
	
	МассивДокументов = Новый Массив;
	
	Для каждого Набор Из НаборыДанных Цикл
		МассивДокументов.Добавить(Набор.ДокументСсылка);
	КонецЦикла;
	
	Возврат ПолучитьДопРеквизитыДокументов(МассивДокументов, УникальныйИдентфикатор);
	
КонецФункции

// Получает доп реквизиты из РС ККСНГ_ПМ_ДопРеквизитыЭД
//
// Параметры:
//	МассивДокументов - Массив ссылок на документы ИБ
//
// Возвращаемое значение:
//	Соответствие , см.ИнициализироватьДопРеквизитыДокумента()
//
Функция ПолучитьДопРеквизитыДокументов(МассивДокументов, УникальныйИдентфикатор = "") Экспорт
	
	СоответствиеДопРеквизитов = ПолучитьДопРеквизитыЭлектронныхДокументов(МассивДокументов);
	
	Для каждого ДопРеквизитыЭД Из СоответствиеДопРеквизитов Цикл 
		ЗаполнитьДвоичныеДанныеДопВложенийПрисоединенныхФайлов(ДопРеквизитыЭД.Значение.Вложения, УникальныйИдентфикатор);	
	КонецЦикла;
	
	Возврат СоответствиеДопРеквизитов;
	
КонецФункции

// Прикрепляет вложения к ЭД в СФЕРА Курьер
//
// Параметры:
//	ПараметрыАвторизации            - Структура
//	МассивВложений                  - Массив структур
//	DocumentID                      - Число - id основного документа
//	Подпись                         - Структура (type_Signature) - для подписания вложений
//	ДанныеДокумента                 - Структура - данные основного документа (для получения реквизитов)
//
// Возвращаемое значение:
//	Структура, см.ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ДобавитьВложенияЭлектронногоДокумента(ПараметрыАвторизации, DocumentID, МассивВложений, Подпись = Неопределено, ДанныеДокумента = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Истина;
	
	Для каждого Вложение Из МассивВложений Цикл 
		
		// ККСНГ: Для роуминга (СБИС) создаем полноценный документ вместо вложения
		CardAttachment = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
		CardAttachment.Date = ТекущаяДатаСеанса();
		CardAttachment.Number = ?(ДанныеДокумента <> Неопределено, ДанныеДокумента.Номер, "");
		CardAttachment.TypeCode = "BILL";
		CardAttachment.Relation = "Invoice";
		CardAttachment.ParentDocumentId = DocumentID; // Привязка к основному документу (ПАКЕТ)
		
		// Заполнение контента
		Если ТипЗнч(Вложение.АдресВХранилище) = Тип("ДвоичныеДанные") Тогда
			ККСНГ_ДанныеФайла = Вложение.АдресВХранилище;
		Иначе
			ККСНГ_ДанныеФайла = ПолучитьИзВременногоХранилища(Вложение.АдресВХранилище);
		КонецЕсли;
		
		CardAttachment.Content.Filename = Вложение.ИмяФайла;
		CardAttachment.Content.Content  = ККСНГ_ДанныеФайла;
		
		// Определение MIME-типа
		ККСНГ_Расширение = НРег(Вложение.Расширение);
		Если ККСНГ_Расширение = "pdf" Тогда
			CardAttachment.Content.MimeType = "application/pdf";
		ИначеЕсли ККСНГ_Расширение = "txt" Тогда
			CardAttachment.Content.MimeType = "text/plain";
		Иначе
			CardAttachment.Content.MimeType = "application/xml";
		КонецЕсли;
		
		// Подпись для вложения
		Если Подпись <> Неопределено Тогда
			CardAttachment.Signature = Подпись;
		КонецЕсли;
		
		// Отправка счета как отдельного документа в пакете
		ЗапросДобавления = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, ДанныеДокумента.КодЭДОПолучателя, CardAttachment);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДобавления.Журнал, Ложь);
		
		Если НЕ ЗапросДобавления.Успех Тогда
			Ответ.Успех = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьАктуальностьФорматаУКД(ДанныеДокумента, ДанныеФормата)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если Не ДанныеДокумента.ЭтоКорректировка Тогда 
		Ответ.Успех = Истина;
		Возврат Ответ;
	КонецЕсли;

	ДатаПереходаНаУКД2020 = Дата('2021.10.01 00:00:00');
	Если ДанныеДокумента.Дата < ДатаПереходаНаУКД2020 Тогда
		Ответ.Успех = Истина;
		Возврат Ответ;
	КонецЕсли;
	
	Если СокрЛП(ДанныеФормата.Идентификатор) <> "УКД_2020" И ДанныеДокумента.ДатаИсходногоДокумента >= ДатаПереходаНаУКД2020 Тогда
		
		ИзменитьНастройкуОрганизации = ДанныеДокумента.ПрофильКонтрагента.ВариантНастройкиОбмена = "Использовать настройки организации";
		
		ТекстОшибки = "Документ %1 требуется отправить по новому формату %2.
					|Пожалуйста, измените настройку документооборота %3 %4.";
		ПредставлениеИзменяемогоОбъекта = ?(ИзменитьНастройкуОрганизации, "организации", "контрагента");
		ИзменяемыйОбъект = ?(ИзменитьНастройкуОрганизации, ДанныеДокумента.ПрофильОрганизации, ДанныеДокумента.ПрофильКонтрагента);
		ТекстОшибки = СтрШаблон(ТекстОшибки, ДанныеДокумента.ДокументСсылка, "УКД (ФНС 2020)", ПредставлениеИзменяемогоОбъекта, ИзменяемыйОбъект);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "UFD-00005", , ИзменяемыйОбъект);
		
		Возврат Ответ;
		
	КонецЕсли;
	
	Ответ.Успех = Истина;
	Возврат Ответ;
	
КонецФункции

Функция ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, СвойствоКарточкиСтрока, ПроверитьЗаполнение, СвойствоDocumentCardЗначение)

	Результат = Ложь;
	
	ЗначениеСвойстваКарточки = Неопределено;
	Если ДанныеКарточки.Свойство(СвойствоКарточкиСтрока, ЗначениеСвойстваКарточки) Тогда
		
		Если НЕ ПроверитьЗаполнение ИЛИ ЗначениеЗаполнено(ЗначениеСвойстваКарточки) Тогда
			СвойствоDocumentCardЗначение = ЗначениеСвойстваКарточки;
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ОтправитьНеструктурированный(ДанныеКарточки, ПрофильЭДООрганизации, ПараметрыАвторизации, Подпись, СпособОтправки, ПроверитьПодпись, ПроверитьКодЭДО, ЗаголовокЖурнала)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	DocumentCard = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentCard");
	
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "Дата", Ложь, DocumentCard.Date);
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "Номер", Ложь, DocumentCard.Number);
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "КодТипаДокумента", Ложь, DocumentCard.TypeCode);
	
	ДоговорЗаполнен = ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "ДоговорНомер", Истина, DocumentCard.Contract.Number);
	Если ДоговорЗаполнен Тогда
		ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "ДоговорДата", Истина, DocumentCard.Contract.Date);
	КонецЕсли;
	
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "MimeType", Ложь, DocumentCard.Content.MimeType);
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "Content", Ложь, DocumentCard.Content.Content);
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "Filename", Ложь, DocumentCard.Content.Filename);
	
	Если Не ПроверитьПодпись Или Подпись <> Неопределено Тогда
		
		Если Подпись <> Неопределено Тогда
			
			Signature = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_Signature");
			Signature.Content = Подпись;
			
			Если СтрСравнить(ДанныеКарточки.ДанныеПодписанта.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
				Signature.MchdUuid = ДанныеКарточки.ДанныеПодписанта.МЧД.Номер;
				Signature.MchdAccessMode = ДанныеКарточки.ДанныеПодписанта.МЧД.ИнформационнаяСистема;
				
				Если Не ПустаяСтрока(ДанныеКарточки.ДанныеПодписанта.МЧД.ИННДоверителя) Тогда
					Signature.MchdInn = ДанныеКарточки.ДанныеПодписанта.МЧД.ИННДоверителя;
				КонецЕсли;
				
				Если Не ПустаяСтрока(ДанныеКарточки.ДанныеПодписанта.МЧД.ИННПредставителя) Тогда
					Signature.MchdConfidantInn = ДанныеКарточки.ДанныеПодписанта.МЧД.ИННПредставителя;
				КонецЕсли;
				
				Для каждого Доверенность Из ДанныеКарточки.ДанныеПодписанта.МЧД.Цепочка Цикл
					
					SignatureMchd = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_SignatureMchdIdentify");
					
					SignatureMchd.MchdUuid = Доверенность.Номер;
					SignatureMchd.MchdAccessMode = Доверенность.ИнформационнаяСистема;
					
					Если Не ПустаяСтрока(Доверенность.ИННДоверителя) Тогда
						SignatureMchd.MchdInn = Доверенность.ИННДоверителя;
					КонецЕсли;
					
					Если Не ПустаяСтрока(Доверенность.ИННПредставителя) Тогда
						SignatureMchd.MchdConfidantInn = Доверенность.ИННПредставителя;
					КонецЕсли;
					
					Signature.Chain.SignatureMchdIdentify.Добавить(SignatureMchd);
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если СтрСравнить(ДанныеКарточки.ДанныеПодписанта.ВариантОтправкиМЧД, "Пакет") = 0  Тогда
				
				Signature.MchdFileName = ДанныеКарточки.ДанныеПодписанта.МЧД.ИмяФайлаДоверенности;
				Signature.MchdFile = ДанныеКарточки.ДанныеПодписанта.МЧД.ФайлДоверенности;
				Signature.MchdSignature = ДанныеКарточки.ДанныеПодписанта.МЧД.ФайлПодписи;
				
				Для каждого Доверенность Из ДанныеКарточки.ДанныеПодписанта.МЧД.Цепочка Цикл
					
					Если Доверенность.ЕстьФайлДоверенности И Доверенность.ЕстьФайлПодписи Тогда
						
						SignatureMchd = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруПоТипуXDTO("type_SignatureMchdIdentify");
						
						SignatureMchd.MchdFileName = Доверенность.ИмяФайлаДоверенности;
						SignatureMchd.MchdFile = Доверенность.ФайлДоверенности;
						SignatureMchd.MchdSignature = Доверенность.ФайлПодписи;
						
						Signature.Chain.SignatureMchdIdentify.Добавить(SignatureMchd);
					Иначе
						ТекстСообщения = СтрШаблон("В машиночитаемой доверенности: %1 отсутсвуют файлы доверенности и подписи", Доверенность.Номер);
						ККСНГ_ЛогированиеКлиентСервер.ДобавитьСообщение(Ответ.Журнал, ТекстСообщения);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			DocumentCard.Signature = Signature;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Relation
	Если ДанныеКарточки.Свойство("ИдентификаторСвязанногоДокумента") И ЗначениеЗаполнено(ДанныеКарточки.ИдентификаторСвязанногоДокумента) Тогда
		DocumentCard.ParentDocumentId = ДанныеКарточки.ИдентификаторСвязанногоДокумента;
	КонецЕсли;
	
	Если ДанныеКарточки.Свойство("ТипСвязи") И ЗначениеЗаполнено(ДанныеКарточки.ТипСвязи) Тогда
		DocumentCard.Relation = ДанныеКарточки.ТипСвязи;
	Иначе	
		DocumentCard.Relation = "Other";
	КонецЕсли;
	
	DocumentCard.Barcode.Type = "None";
	
	ДопАтрибуты = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКарточки, "ДопАтрибуты", Неопределено);
	
	Если ДопАтрибуты <> Неопределено Тогда
		DocumentCard.Attributes.KeyValueObject = ДопАтрибуты;
	КонецЕсли;
	
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "ЗапроситьПодписание", Истина, DocumentCard.RequestSign);
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "ЗапросПодписи", Истина, DocumentCard.RequestSign);
	
	// Признак необходимости запроса подписи у получателя, если не запрашиваем подпись, то не передаем
	Если DocumentCard.RequestSign <> Истина Тогда
		DocumentCard.Удалить("RequestSign");
	КонецЕсли;
	
	ЗаполнитьСвойствоDocumentCard(ДанныеКарточки, "Комментарий", Истина, DocumentCard.Comment);
	
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Создание документа в сервисе ЭДО");
	
	ЗапросКодаЭДО = ККСНГ_ДокументооборотВызовСервера.ПолучитьКодЭДОПолучателя(ДанныеКарточки.Получатель, DocumentCard.TypeCode, ПрофильЭДООрганизации, ПараметрыАвторизации);
	Если ЗапросКодаЭДО.Успех Тогда
		КодУчастникаЭДО = ЗапросКодаЭДО.Результат;
	ИначеЕсли ПроверитьКодЭДО Тогда
		Возврат Ответ;
	Иначе
		КодУчастникаЭДО = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКарточки.Получатель, "КодУчастникаЭДО");
	КонецЕсли;
	
	ЗаполнитьДопПараметрыКарточкиЭД(DocumentCard, ДанныеКарточки);
	
	ЗапросОтправкаДокумента = ККСНГ_APIКурьер.v1_DocumentAdd(ПараметрыАвторизации, КодУчастникаЭДО, DocumentCard);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОтправкаДокумента.Журнал, Ложь);
	
	// TODO: Добавить работу с вложениями
	
	Если ЗапросОтправкаДокумента.Успех Тогда
		
		Ответ.Успех = Истина;
		СтруктураДокумента = ЗапросОтправкаДокумента.Результат;
		
		ПараметрыДанных = Новый Структура;
		ПараметрыДанных.Вставить("ДанныеКарточки", ДанныеКарточки);
		ПараметрыДанных.Вставить("СтруктураДокумента", СтруктураДокумента);
		ПараметрыДанных.Вставить("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
		ПараметрыДанных.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
		ПараметрыДанных.Вставить("Ответ", Ответ);
		ПараметрыДанных.Вставить("СпособОтправки", СпособОтправки);
		
		ОбработатьОбъектыИБПослеОтправкиНЕСтруктурированногоЭД(ПараметрыДанных);
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

Процедура ЗаполнитьДопПараметрыКарточкиЭД(КарточкаДокумента, ДанныеКарточки)
	
	ДопПараметрыКарточки = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КарточкаДокумента, "Properties.StringKeyValue");
	Если ТипЗнч(ДопПараметрыКарточки) = Тип("Массив") Тогда
		ДопПараметрыДокумента = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеКарточки, "ДопПараметры");
		Если ТипЗнч(ДопПараметрыДокумента) = Тип("Массив") Тогда
			Для каждого ДопПараметрДокумента Из ДопПараметрыДокумента Цикл
				ДопПараметрКарточки = Новый Структура();
				ДопПараметрКарточки.Вставить("Key", ДопПараметрДокумента.Ключ);
				ДопПараметрЗначение = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметрДокумента.Значение, "Значение", ДопПараметрДокумента.Значение);
				ДопПараметрКарточки.Вставить("Value", ДопПараметрЗначение);
				ДопПараметрыКарточки.Добавить(ДопПараметрКарточки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//TODO Добавить на вход бизнес-процесс?
Функция ДанныеСвязанногоДокумента(ДокументСсылка)
	
	ДанныеРезультат = Новый Структура();
	ДанныеРезультат.Вставить("Идентификатор", "");
	ДанныеРезультат.Вставить("ТипСвязи", "Other");
	
	ДанныеДоговораУВХД = ККСНГ_ЭлектронныеДокументы.ПолучитьДанныеДоговораУВХДПоДокументу(ДокументСсылка);
	
	Если ТипЗнч(ДанныеДоговораУВХД) = Тип("Структура")
		И ДанныеДоговораУВХД.ИдентификаторДоговора > 0 Тогда
		ДанныеРезультат.Идентификатор = ДанныеДоговораУВХД.ИдентификаторДоговора; 
		
	КонецЕсли;	
		
	Возврат ДанныеРезультат;
	
КонецФункции

#Область РаботаСДопРеквизитами

// Получение данных из РС

Процедура ЗаполнитьЗначенияДопРеквизитовЭД(ДопРеквизиты, ВыборкаДопРеквизиты)
	
	// Вложения
	Если ВыборкаДопРеквизиты.ЕстьВложения Тогда
			
		СтрокаВложенийВнутр = ВыборкаДопРеквизиты.Вложения.Получить();
								
		Попытка
			ТаблицаВложений = ЗначениеИзСтрокиВнутр(СтрокаВложенийВнутр);
		Исключение
			ТаблицаВложений = Неопределено;
		КонецПопытки;
		
		МассивВложений = Вложения(ТаблицаВложений);
		Если НЕ МассивВложений = Неопределено Тогда
			ДопРеквизиты.Вложения = МассивВложений;
		КонецЕсли;
					
	КонецЕсли;
		
	// Атрибуты
	Если ВыборкаДопРеквизиты.УстановленыДопАтрибуты Тогда
		
		СтрокаАтрибутов = ВыборкаДопРеквизиты.ДопАтрибуты.Получить();
		
		Попытка
			МассивАтрибутов = ЗначениеИзСтрокиВнутр(СтрокаАтрибутов);
		Исключение
			МассивАтрибутов = Неопределено;
		КонецПопытки;
		
		Если ТипЗнч(МассивАтрибутов) = Тип("Массив") Тогда
			ДопРеквизиты.ДопАтрибуты = МассивАтрибутов;
		КонецЕсли;
						
	КонецЕсли;
	
	// Запросить подпись
	Если ВыборкаДопРеквизиты.ЗапроситьПодпись Тогда
		ДопРеквизиты.ЗапроситьПодпись = ВыборкаДопРеквизиты.ЗапроситьПодпись;
	КонецЕсли;
	
	// Комментарий
	Если ЗначениеЗаполнено(ВыборкаДопРеквизиты.Комментарий) Тогда
		ДопРеквизиты.Комментарий = Лев(ВыборкаДопРеквизиты.Комментарий, 1000);
	КонецЕсли;

КонецПроцедуры

Функция Вложения(ТаблицаВложений)

	Результат = Неопределено;
	
	Если ТипЗнч(ТаблицаВложений) = Тип("ТаблицаЗначений") Тогда
		
		Результат = Новый Массив;
		
		Для каждого СтрокаВложений Из ТаблицаВложений Цикл
			
			СтруктураВложения = ИнициализироватьСтруктуруВложения();
			ЗаполнитьЗначенияСвойств(СтруктураВложения, СтрокаВложений);
			
			// TODO Предусмотреть некорректные имена файлов
			СтруктураВложения.ИмяФайла = СокрЛП(СтрокаВложений.Наименование) 
			+ ?(ЗначениеЗаполнено(СтрокаВложений.Расширение), "." + СтрокаВложений.Расширение, "");
			
			Результат.Добавить(СтруктураВложения);
		КонецЦикла;
		
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДвоичныеДанныеДопВложенийПрисоединенныхФайлов(Вложения, УникальныйИдентфикатор)
	
	Если НЕ ТипЗнч(Вложения) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтруктураВложения Из Вложения Цикл 
		Если ЗначениеЗаполнено(СтруктураВложения.Ссылка) Тогда  
			ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(СтруктураВложения.Ссылка);
							
			Если ТипЗнч(ДвоичныеДанныеФайла) = Тип("ДвоичныеДанные") Тогда
				СтруктураВложения.АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентфикатор);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
			
КонецПроцедуры

// Отправка

Процедура ПреобразоватьДопВложенияВСтруктурыДляОтправки(Вложения)

	// TODO Добавить ответ, сделать функцией
	МассивВложенийКОтправке = Новый Массив;
	
	Для каждого Вложение из Вложения Цикл
			
		attachment = Новый Структура;
		
		// ККСНГ: Поддержка прямой передачи ДвоичныхДанных (для надежности при переходе клиент-сервер)
		Если ТипЗнч(Вложение.АдресВХранилище) = Тип("ДвоичныеДанные") Тогда
			ККСНГ_ДанныеФайла = Вложение.АдресВХранилище;
		Иначе
			ККСНГ_ДанныеФайла = ПолучитьИзВременногоХранилища(Вложение.АдресВХранилище);
		КонецЕсли;
		
		attachment.Вставить("Content", ККСНГ_ДанныеФайла);
		attachment.Вставить("Filename", Вложение.ИмяФайла);
		
		// ККСНГ: Улучшенное определение типа для роуминга
		ККСНГ_Расширение = НРег(Вложение.Расширение);
		Если ККСНГ_Расширение = "pdf" Тогда
			attachment.Вставить("MimeType", "application/pdf");
			attachment.Вставить("TypeCode", "BILL"); // Официальный тип "Счет"
		ИначеЕсли ККСНГ_Расширение = "txt" Тогда
			attachment.Вставить("MimeType", "text/plain");
			attachment.Вставить("TypeCode", "BILL"); // Для теста тоже ставим BILL
		Иначе
			attachment.Вставить("MimeType", "application/xml");
			attachment.Вставить("TypeCode", "Other");
		КонецЕсли;
		
		// Явная связь
		attachment.Вставить("Relation", "Invoice");
						
		МассивВложенийКОтправке.Добавить(attachment);
		
	КонецЦикла;
	
	Вложения = МассивВложенийКОтправке;
	
КонецПроцедуры	

#КонецОбласти

Процедура ЗаполнитьДанныеПоОшибке(ОтветПоДокументуЖурнал, ДокументСсылка)

	Для Каждого Сообщение Из ОтветПоДокументуЖурнал Цикл
		Если ТипЗнч(Сообщение) = Тип("Массив") Тогда
			ЗаполнитьДанныеПоОшибке(Сообщение, ДокументСсылка);
		ИначеЕсли ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Если Строка(Сообщение.Статус) = "-1" Тогда
				Сообщение.Данные = ДокументСсылка;	
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЗаполнитьИнформациюИзЦРПТ(ИнформацияИзЦРПТ, ДанныеЦРПТ)
	
	ТипСтруктура = Тип("Структура");
	ТипМассив = Тип("Массив");
	ТипСтрока = Тип("Строка");
	ТипЧисло = Тип("Число");
	
	Типы = Новый Структура;
	Типы.Вставить("ТипСтруктура", ТипСтруктура);
	Типы.Вставить("ТипМассив", ТипМассив);
	Типы.Вставить("ТипСтрока", ТипСтрока);
	Типы.Вставить("ТипЧисло", ТипЧисло);
	
	ВОбработке = Ложь;
	status = СвойствоЕстьВСтруктуре(ДанныеЦРПТ, "status", ТипЧисло);
	Если status.Успех И status.Результат = 1 Тогда
		ВОбработке = Истина;
	КонецЕсли;
	
	Если ВОбработке Тогда
		ИнформацияИзЦРПТ.Заголовок = "Обрабатывается";
		ИнформацияИзЦРПТ.КодОшибки = "1";
		Возврат Истина;
	КонецЕсли;
	
	receipt = СвойствоЕстьВСтруктуре(ДанныеЦРПТ, "receipt", ТипСтруктура);
	Если НЕ receipt.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Operations = СвойствоЕстьВСтруктуре(receipt.Результат, "Operations", ТипМассив);
	Если НЕ Operations.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для каждого Operation Из Operations.Результат Цикл
		
		Errors = Неопределено;
		ДанныеОперации = ДанныеОперации(Operation, Errors, Типы);
		Если НЕ ДанныеОперации Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Для каждого Error Из Errors Цикл
			
			Code = Неопределено;
			Data = Неопределено;
			ДанныеОшибки = ДанныеОшибки(Error, Code, Data, Типы);
			Если НЕ ДанныеОшибки Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ИнформацияОшибкиЦРПТ = СтруктураИнформацииОшибкиЦРПТ();
			ИнформацияИзЦРПТ.Ошибки.Добавить(ИнформацияОшибкиЦРПТ);
			ЗаполнитьИнфоПоОшибке(ИнформацияОшибкиЦРПТ, Error, Data, Code);
			Если ПустаяСтрока(ИнформацияИзЦРПТ.Заголовок) Тогда
				ИнформацияИзЦРПТ.Заголовок = ИнформацияОшибкиЦРПТ.Заголовок;
				ИнформацияИзЦРПТ.КодОшибки = ИнформацияОшибкиЦРПТ.КодОшибки;
				ИнформацияИзЦРПТ.ОписаниеОшибки = ИнформацияОшибкиЦРПТ.ОписаниеОшибки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьИнфоПоОшибке(ИнформацияИзЦРПТ, Error, Data, Code)
	
	Перем Text, Tpe, Inn, Kpp, Fias, Participant, Reason, Details;
	Перем Gtin, Cis, Pack, Invoice, InvoiceDate, FixDate, FixNumber;
	Перем НомерДокумента, ДатаДокумента, НомерИсправления, ДатаИсправления;
	Перем СписокОшибок, КлючЗначение;
	
	Text = СвойствоЕстьВСтруктуре(Error, "Text", Тип("Строка"));
	Tpe = СвойствоЕстьВСтруктуре(Data, "Tpe");
	Reason = СвойствоЕстьВСтруктуре(Data, "Reason");
	Inn = СвойствоЕстьВСтруктуре(Data, "Inn");
	Kpp = СвойствоЕстьВСтруктуре(Data, "Kpp");
	Fias = СвойствоЕстьВСтруктуре(Data, "Fias");
	Participant = СвойствоЕстьВСтруктуре(Data, "participant");
	
	Gtin = СвойствоЕстьВСтруктуре(Data, "Gtin");
	Cis = СвойствоЕстьВСтруктуре(Data, "Cis");
	Pack = СвойствоЕстьВСтруктуре(Data, "Pack");
	Invoice = СвойствоЕстьВСтруктуре(Data, "Invoice");
	InvoiceDate = СвойствоЕстьВСтруктуре(Data, "InvoiceDate");
	FixDate = СвойствоЕстьВСтруктуре(Data, "FixDate");
	FixNumber = СвойствоЕстьВСтруктуре(Data, "FixNumber");
	
	ИнформацияИзЦРПТ.КодОшибки = "" + Code;
	ИнформацияИзЦРПТ.Заголовок = "При обработке документа возникли ошибки";
	ИнформацияИзЦРПТ.СлужебнаяИнформация = ОбработатьТэг(Tpe.Успех, Tpe.Результат);
	ИнформацияИзЦРПТ.Причина = ОбработатьТэг(Reason.Успех, Reason.Результат);
	ИнформацияИзЦРПТ.ИНН = ОбработатьТэг(Inn.Успех, Inn.Результат);
	ИнформацияИзЦРПТ.КПП = ОбработатьТэг(Kpp.Успех, Kpp.Результат);
	ИнформацияИзЦРПТ.ФИАС = ОбработатьТэг(Fias.Успех, Fias.Результат);
	ИнформацияИзЦРПТ.Участники = ОбработатьТэг(Participant.Успех, Participant.Результат);
	ИнформацияИзЦРПТ.GTIN = ОбработатьТэг(Gtin.Успех, Gtin.Результат);
	ИнформацияИзЦРПТ.КодыМаркировок = ОбработатьТэг(Cis.Успех, Cis.Результат);
	ИнформацияИзЦРПТ.КодыУпаковок = ОбработатьТэг(Pack.Успех, Pack.Результат);
	
	НомерДокумента = ОбработатьТэг(Invoice.Успех, Invoice.Результат);
	ДатаДокумента = ОбработатьТэг(InvoiceDate.Успех, InvoiceDate.Результат);
	Если ЗначениеЗаполнено(НомерДокумента) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		ИнформацияИзЦРПТ.НомерДатаДокумента = "№ " + НомерДокумента + " от " + ДатаДокумента;
	КонецЕсли;
	
	НомерИсправления = ОбработатьТэг(FixNumber.Успех, FixNumber.Результат);
	ДатаИсправления = ОбработатьТэг(FixDate.Успех, FixDate.Результат);
	Если ЗначениеЗаполнено(НомерИсправления) И ЗначениеЗаполнено(ДатаИсправления) Тогда
		ИнформацияИзЦРПТ.НомерДатаИсправления = "№ " + НомерИсправления + " от " + ДатаИсправления;
	КонецЕсли;
	
	ИнформацияИзЦРПТ.ОписаниеОшибки  = ОписаниеОшибкиЦРПТ(Code);
	ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{ИНН}", "{инн}");
	ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{КМ}", "{км}");
	ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{НОМЕР}", "{номер}");
	ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{ДАТА}", "{дата}");
	ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{REASON}", "{reason}");
	
	Если СтрНайти(ИнформацияИзЦРПТ.ОписаниеОшибки, "{инн}") > 0 Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{инн}", ИнформацияИзЦРПТ.ИНН);
	КонецЕсли;
	
	Если СтрНайти(ИнформацияИзЦРПТ.ОписаниеОшибки, "{км}") > 0 Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{км}", ИнформацияИзЦРПТ.КодыМаркировок);
	КонецЕсли;
	
	Если СтрНайти(ИнформацияИзЦРПТ.ОписаниеОшибки, "{номер}") > 0 И ЗначениеЗаполнено(НомерДокумента) Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{номер}", НомерДокумента);
	КонецЕсли;
	
	Если СтрНайти(ИнформацияИзЦРПТ.ОписаниеОшибки, "{дата}") > 0 И ЗначениеЗаполнено(ДатаДокумента) Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{дата}", ДатаДокумента);
	КонецЕсли;
	
	Если СтрНайти(ИнформацияИзЦРПТ.ОписаниеОшибки, "{reason}") > 0 Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = СтрЗаменить(ИнформацияИзЦРПТ.ОписаниеОшибки, "{reason}", ИнформацияИзЦРПТ.Причина);
	КонецЕсли;
	
	СписокОшибок = Новый Массив;
	Если СвойствоЕстьВСтруктуре(Error, "Error", Тип("Структура")).Успех Тогда
		Для каждого КлючЗначение Из Error.Error Цикл
			Если СтрСравнить(КлючЗначение.Ключ, "Details") = 0 Тогда
				СписокОшибок.Добавить(КлючЗначение.Значение);
			Иначе
				Details = СвойствоЕстьВСтруктуре(Error.Error[КлючЗначение.Ключ], "details", Тип("Строка"));
				Если Details.Успех Тогда
					СписокОшибок.Добавить(Details.Результат);
				Иначе
					СписокОшибок.Добавить(КлючЗначение.Ключ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	ИнформацияИзЦРПТ.ДополнительнаяИнформация = СтрСоединить(СписокОшибок, ", ");
	
	// Замена описания ошибки, взятого из словаря, текстом ЦРПТ если он заполнен
	Если Text.Успех И Не ПустаяСтрока(Text.Результат) Тогда
		ИнформацияИзЦРПТ.ОписаниеОшибки = Text.Результат;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьТэг(Обрабатывать, Тэг)
	
	Перем Результат;
	
	Результат = "";
	Если Обрабатывать Тогда
		Если ТипЗнч(Тэг) = Тип("Массив") И Тэг.Количество() > 0 Тогда
			Попытка
				Результат = СтрСоединить(Тэг, ", ");
			Исключение
				Результат = "";
			КонецПопытки;
		ИначеЕсли ТипЗнч(Тэг) = Тип("Строка") Тогда
			Результат = Тэг;
		Иначе
			Результат = "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеОперации(Operation, Errors, Типы)

	Details = СвойствоЕстьВСтруктуре(Operation, "Details", Типы.ТипСтруктура);
	Если НЕ Details.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	Successful = СвойствоЕстьВСтруктуре(Details.Результат, "Successful", Типы.ТипСтрока);
	Если НЕ Successful.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НРЕГ(Successful.Результат) = "true" Тогда
		Errors = Новый Массив;
	Иначе
		ErrorsОтвет = СвойствоЕстьВСтруктуре(Details.Результат, "Errors", Типы.ТипМассив);
		Если НЕ ErrorsОтвет.Успех Тогда
			Возврат Ложь;
		КонецЕсли;
		Errors = ErrorsОтвет.Результат;
	КонецЕсли;	
	Возврат Истина;
	
КонецФункции

Функция ДанныеОшибки(Error, Code, Data, Типы)
	
	CodeОтвет = СвойствоЕстьВСтруктуре(Error, "Code", Типы.ТипЧисло);
	Если Не CodeОтвет.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	DataОтвет = СвойствоЕстьВСтруктуре(Error, "Data", Типы.ТипСтруктура);
	Если Не DataОтвет.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Code = CodeОтвет.Результат;
	Data = DataОтвет.Результат;
	
	Возврат Истина;
	
КонецФункции

Функция СвойствоЕстьВСтруктуре(ДанныеСтруктура, ИмяСвойства, ТипСвойства = Неопределено)

	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Ложь);
	Ответ.Вставить("Результат", "");
	
	Если НЕ ТипЗнч(ДанныеСтруктура) = Тип("Структура") Тогда
		Возврат Ответ;
	ИначеЕсли НЕ ДанныеСтруктура.Свойство(ИмяСвойства, Ответ.Результат) Тогда
		Возврат Ответ;
	ИначеЕсли НЕ ТипСвойства = Неопределено И НЕ ТипЗнч(Ответ.Результат) = ТипСвойства Тогда
		Возврат Ответ;
	Иначе	
		Ответ.Успех = Истина;
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции

Функция СтруктураИнформацииЦРПТ()
	
	Перем Результат;
	Результат = Новый Структура;
	
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("Ошибки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураИнформацииОшибкиЦРПТ()
	
	Перем Результат;
	Результат = Новый Структура;
	
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("СлужебнаяИнформация", "");
