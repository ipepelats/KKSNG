// Возвращает структуру с ключами, аналогичными полям указанного типа XDTO
//
// Параметры:
//	ТипXDTO - строка с именем типа или тип объекта XDTO
//	ПространствоИмен - пространство имен
//
// Возвращаемое значение:
//	Структура
//
// Пример:
//	СтруктураДокумента = ПолучитьСтруктуруПоТипуXDTO("type_Document", "http://schemas.datacontract.org/2004/07/Korus.Eds.Api");
//
Функция ПолучитьСтруктуруПоТипуXDTO(Знач ТипXDTO, Знач ПространствоИмен = "") Экспорт
	
	Результат =  Новый Структура;
	
	Если (ТипЗнч(ТипXDTO) = Тип("Строка")) Тогда
		
		ИменаТипов = СтрРазделить(ТипXDTO, ".", Ложь);
		
		Если ИменаТипов.Количество() > 0 Тогда
			
			ПространствоИмен = ?(ЗначениеЗаполнено(ПространствоИмен), ПространствоИмен, ПолучитьПространствоИменПоУмолчанию());
			
			ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, ИменаТипов[0]);
			ИменаТипов.Удалить(0);
			
			Для каждого ИмяТипа Из ИменаТипов Цикл
				
				Свойство = ТипXDTO.Свойства.Получить(ИмяТипа);
				
				Если Свойство = Неопределено Тогда
					Возврат Результат;
				КонецЕсли;
				
				ТипXDTO = Свойство.Тип;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(ТипXDTO) <> Тип("ТипОбъектаXDTO")) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипXDTO);
	
	Для каждого ЭлементКоллекцииСвойств Из ОбъектXDTO.Свойства() Цикл
		
		ЭлементДанных = ОбъектXDTO[ЭлементКоллекцииСвойств.Имя];
		Если (ТипЗнч(ЭлементДанных) = Тип("СписокXDTO")) Тогда
			
			Список = Новый Массив;
			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, Список);
			
		ИначеЕсли (ТипЗнч(ЭлементКоллекцииСвойств.Тип) = Тип("ТипОбъектаXDTO")) Тогда
			
			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, ПолучитьСтруктуруПоТипуXDTO(ЭлементКоллекцииСвойств.Тип));
			
		Иначе
			
			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, ЭлементДанных);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

