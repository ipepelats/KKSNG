Процедура ЗаполнитьStringKeyValue(ПараметрыАвторизации, DocumentCard)
	
	СпособПередачи = Новый Структура();
	СпособПередачи.Вставить("Key", "send.mode");
	СпособПередачи.Вставить("Value", "modul1c");
			
	ЗначениеСпособаАвторизации = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыАвторизации,"СпособАвторизации", "undefined");
	
	Если ЗначениеСпособаАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ApiKey Тогда
		ЗначениеСпособаАвторизации = "apikey";
	ИначеЕсли ЗначениеСпособаАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка Тогда
		ЗначениеСпособаАвторизации = "vpnkeytls";
	Иначе
		ЗначениеСпособаАвторизации = "unqualified";
	КонецЕсли;

	СпособАвторизации = Новый Структура();
	СпособАвторизации.Вставить("Key", "auth.mode");	
	СпособАвторизации.Вставить("Value", ЗначениеСпособаАвторизации);

	StringKeyValue = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(DocumentCard,	"Properties.StringKeyValue", Неопределено);
	
	Если StringKeyValue <> Неопределено
		И ТипЗнч(StringKeyValue) = Тип("Массив") Тогда
		
		StringKeyValue.Добавить(СпособПередачи);
		StringKeyValue.Добавить(СпособАвторизации);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьОбъектXDTOПоСтруктуре(ОбъектXDTO, Данные)
	
	Перем ЗначениеЗаполнения;
	
	Для Каждого ЭлементКоллекцииСвойств Из ОбъектXDTO.Свойства() Цикл

		ЭлементДанных = ОбъектXDTO[ЭлементКоллекцииСвойств.Имя];

		Если (ТипЗнч(ЭлементДанных) = Тип("СписокXDTO")) Тогда
			
			// Заполнение списка
			ОбработатьЭлементДанныхСписокXDTO(Данные, ЭлементКоллекцииСвойств, ЭлементДанных);
			
		ИначеЕсли (ТипЗнч(ЭлементКоллекцииСвойств.Тип) = Тип("ТипОбъектаXDTO")) Тогда 
			
			// Заполнение вложенного объекта
			Если (Данные.Свойство(ЭлементКоллекцииСвойств.Имя)) Тогда
				ОбъектXDTO[ЭлементКоллекцииСвойств.Имя] = ФабрикаXDTO.Создать(ЭлементКоллекцииСвойств.Тип);
				ЗаполнитьОбъектXDTOПоСтруктуре(ОбъектXDTO[ЭлементКоллекцииСвойств.Имя], Данные[ЭлементКоллекцииСвойств.Имя]);
			КонецЕсли;
			
		Иначе
				
			// Заполнение значения (заполняем только не пустые)
			Если Данные.Свойство(ЭлементКоллекцииСвойств.Имя, ЗначениеЗаполнения) И ЗначениеЗаполнения <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ОбъектXDTO, Данные, ЭлементКоллекцииСвойств.Имя);
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьЭлементДанныхСписокXDTO(Данные, ЭлементКоллекцииСвойств, ЭлементДанных)

	Если (Данные.Свойство(ЭлементКоллекцииСвойств.Имя)
		И (ТипЗнч(Данные[ЭлементКоллекцииСвойств.Имя]) = Тип("Массив"))) Тогда
		
		Для Каждого СтрокаДанных Из Данные[ЭлементКоллекцииСвойств.Имя] Цикл
			
			НовыйЭлемент = ФабрикаXDTO.Создать(ЭлементКоллекцииСвойств.Тип);
			
			Если НовыйЭлемент = Неопределено Тогда
				// Это конечный элемент
				НовыйЭлемент = СтрокаДанных;
			Иначе
				// Рекурсивно заполняем дальше
				ЗаполнитьОбъектXDTOПоСтруктуре(НовыйЭлемент, СтрокаДанных);
			КонецЕсли;
			
			ЭлементДанных.Добавить(НовыйЭлемент);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСтруктуруЗапроса(ПараметрыАвторизации = Неопределено)

	СтруктураЗапроса = ККСНГ_ТранспортHTTPКлиентСервер.ПолучитьСтруктуруЗапроса();

	АвторизацияТокеном = Ложь;
	AuthToken = "";
	Если ПараметрыАвторизации <> Неопределено Тогда
		СпособАвторизации = ПараметрыАвторизации.СпособАвторизации;
		AuthToken = ПараметрыАвторизации.AuthToken;
	    АвторизацияТокеном = СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка;
	КонецЕсли;
	Если АвторизацияТокеном Тогда
		Если ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТестовыйРежим() Тогда
			СтруктураЗапроса.Адрес = "https://einv-preprod.esphere.ru:9443/auxch/courier_webapi";
		Иначе
			СтруктураЗапроса.Адрес = "https://einv.esphere.ru:9443/auxch/courier_webapi";
		КонецЕсли;
		СтруктураЗапроса.Заголовки.Вставить("Cookie", ПараметрыАвторизации.КонтекстТокена.AuthCookie);
	Иначе	// AuthToken
		Если ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТестовыйРежим() Тогда
			СтруктураЗапроса.Адрес = "https://courier-demo.esphere.ru/api";
		Иначе
			СтруктураЗапроса.Адрес = "https://courier-api.esphere.ru";
		КонецЕсли;
		Если Не ПустаяСтрока(AuthToken) Тогда
			СтруктураЗапроса.Заголовки.Вставить("Auth-token", AuthToken);
		КонецЕсли;
	КонецЕсли;

	СтруктураЗапроса.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);

	СтруктураЗапроса.Заголовки.Вставить("Accept", "application/xml"); // "application/json"
	СтруктураЗапроса.Заголовки.Вставить("Content-Type", "application/xml");

	Возврат СтруктураЗапроса;

КонецФункции

Функция ВызватьМетодИОбработатьРезультат(СтруктураЗапроса, ТипXDTO = "", ЗаголовокЖурнала = "", РезультатСтрокой = Ложь)

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ККСНГ_ТранспортHTTPКлиентСервер.ЗаполнитьПараметрыПрокси(СтруктураЗапроса);
	
	ОтветAPI = ККСНГ_ТранспортHTTPКлиентСервер.ВыполнитьHTTPМетод(СтруктураЗапроса);
	Ответ.Результат = ОтветAPI.КодОшибки;
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтветAPI.Журнал);
	
	Если ОтветAPI.Успех И ТипЗнч(ОтветAPI.Результат) = Тип("HTTPОтвет") Тогда
		
		Попытка

			ИсходныеДанные = ОтветAPI.Результат.ПолучитьТелоКакСтроку();
			Если РезультатСтрокой = Истина Тогда 
				Ответ.Результат = ИсходныеДанные;
			ИначеЕсли Не ПустаяСтрока(ТипXDTO) Тогда
				// Обрабатываем результат
				Ответ.Результат = ПолучитьСтруктуруПоXML(ИсходныеДанные, ТипXDTO);
			КонецЕсли;

			Ответ.Успех = Истина;

		Исключение

			// Не удалось прочитать XML
			ОписаниеОшибки = ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка обработки ответа API сервиса ЭДО", "XT-00013", ОписаниеОшибки);

		КонецПопытки;
		
	// Пробуем найти сообщение об ошибке от API
	ИначеЕсли ОтветAPI.КодОшибки = 302 Тогда
		ПараметрыАвторизации = СтруктураЗапроса.ПараметрыАвторизации;

		Если ТипЗнч(ПараметрыАвторизации) = Тип("Структура")
			И ПараметрыАвторизации.СпособАвторизации
					= Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка Тогда

			ПараметрыАвторизации.Вставить("НеобходимаПереинициализация", Истина);

			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал,
						"Пользовательская сессия устарела, пожалуйста, повторите действие.", "AU-00002");

		КонецЕсли;

	Иначе
		
		ЗапросРасшифровки = РасшифроватьОшибкуКурьера(ОтветAPI);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросРасшифровки.Журнал);
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

Функция РасшифроватьОшибкуКурьера(ОтветAPI)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если ОтветAPI.КодОшибки < 500 И ТипЗнч(ОтветAPI.Результат) = Тип("HTTPОтвет") Тогда

		Попытка

			ИсходныеДанные = ОтветAPI.Результат.ПолучитьТелоКакСтроку();
			ОбъектXDTO = ПолучитьОбъектXDTO(ИсходныеДанные, "http://www.cc.org/Errors", "BodyRoot", Истина);
			ДанныеОшибки = ПолучитьСтруктуруПоОбъектуXDTO(ОбъектXDTO);

			// Пробежим по всем вариантам и добавим в журнал, если есть данные
			Для Каждого Элемент Из ДанныеОшибки Цикл

				ОписаниеОшибки = Элемент.Значение;

				Если НЕ ТипЗнч(ОписаниеОшибки) = Тип("Структура") Тогда
					Продолжить;
				КонецЕсли;

				КодОшибки = "ER-00000";
				ТекстОшибки = "";
				ОписаниеОшибки.Свойство("ErrorNumber", КодОшибки);
				ОписаниеОшибки.Свойство("Message", ТекстОшибки);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, КодОшибки);

			КонецЦикла;

		Исключение

			ОписаниеОшибки = ОписаниеОшибки();
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ОписаниеОшибки,
													"Не удалось прочитать текст ошибки API сервиса ЭДО.");

		КонецПопытки;
			
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

#КонецОбласти