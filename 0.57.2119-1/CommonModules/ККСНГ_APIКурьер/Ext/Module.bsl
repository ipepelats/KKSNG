// Вызов метода Version API СФЕРА Курьер
// См. https://confluence.esphere.ru/display/SBER/Version
// Также может использоваться для проверки настроек прокси-сервера.
//
// Параметры:
//	ПроверяемыеПараметрыПрокси - Неопределено, Соответствие - настройки прокси-сервера, с которыми нужно выполнить запрос:
//        см. РегистрыСведений.ККСНГ_Настройки.СохранитьНастройкиПроксиСервера()
//
// Возвращаемое значение:
//	список структур VersionInfo, см. https://confluence.esphere.ru/display/SBER/VersionInfo
//	либо КодОшибки ответа выполение HTTP-метода, если передан параметр ПроверяемыеПараметрыПрокси.
//
Функция v1_Version(ПроверяемыеПараметрыПрокси = Неопределено) Экспорт

	СтруктураЗапроса = ПолучитьСтруктуруЗапроса(Неопределено);
	СтруктураЗапроса.Метод = "GET";
	СтруктураЗапроса.Адрес = СтруктураЗапроса.Адрес + "/api/about/version";
	ЗаголовокЖурнала = "Вызов API сервиса ЭДО: Version";
	
	Если ЗначениеЗаполнено(ПроверяемыеПараметрыПрокси) Тогда
		Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
		
		ККСНГ_ТранспортHTTPКлиентСервер.ЗаполнитьПараметрыПрокси(СтруктураЗапроса, ПроверяемыеПараметрыПрокси);
		
		СтруктураЗапроса.МаксРедиректов = 2;
		ОтветAPI = ККСНГ_ТранспортHTTPКлиентСервер.ВыполнитьHTTPМетод(СтруктураЗапроса);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтветAPI.Журнал);
		Ответ.Результат = ОтветAPI.КодОшибки;
		Ответ.Успех = ОтветAPI.Успех;
		
		ЗапросРасшифровки = РасшифроватьОшибкуКурьера(ОтветAPI);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросРасшифровки.Журнал);
		
		Возврат Ответ;
	КонецЕсли;
	
	Возврат ВызватьМетодИОбработатьРезультат(СтруктураЗапроса, "type_VersionInfo", ЗаголовокЖурнала);

КонецФункции

