// Формирует строку формата XML по данным типа Структура
//
// Параметры:
//	 Данные                  - Структура
//	 ТипXDTO                 - ТипXDTO
//	 ЛокальноеИмя            - Строка
//	 УдалятьПространствоИмен - Булево
//	 ПространствоИмен        - Строка
//
// Возвращаемое значение:
//	Строка XML
//
Функция ПолучитьXMLПоСтруктуре(Данные, ТипXDTO, ЛокальноеИмя = Неопределено, УдалятьПространствоИмен = Ложь, Знач ПространствоИмен = "") Экспорт

	ПространствоИмен = ?(ЗначениеЗаполнено(ПространствоИмен), ПространствоИмен, ПолучитьПространствоИменПоУмолчанию());

	ТипОбъектаXDTO = ФабрикаXDTO.Тип(ПространствоИмен, ТипXDTO);
	ОбъектXDTO = ФабрикаXDTO.Создать(ТипОбъектаXDTO);
	ЗаполнитьОбъектXDTOПоСтруктуре(ОбъектXDTO, Данные);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, ЛокальноеИмя);
	СтрокаXML = ЗаписьXML.Закрыть();

	Если (УдалятьПространствоИмен) Тогда
		СтрокаXML = СтрЗаменить(СтрокаXML, "xmlns=""" + ПространствоИмен + """", "");
	КонецЕсли;

	Возврат СтрокаXML;

КонецФункции

// Формирует структуру по строке формата XML
//
// Параметры:
//	 ТекстXML                  - Строка XML
//	 ТипXDTO                   - ТипXDTO
//	 BodyRoot                  - Булево - добавление пространства имен
//
// Возвращаемое значение:
//	Структура -  произвольный
//
Функция ПолучитьСтруктуруПоXML(ТекстXML, ТипXDTO, BodyRoot = Ложь) Экспорт

	ПространствоXDTO = ПолучитьПространствоИменПоУмолчанию();
	ОбъектXDTO = ПолучитьОбъектXDTO(ТекстXML, ПространствоXDTO, ТипXDTO, BodyRoot);
	Возврат ПолучитьСтруктуруПоОбъектуXDTO(ОбъектXDTO);

КонецФункции

// Формирует структуру по объекту XDTO
//
// Параметры:
//	 ОбъектXDTO                - ОбъектXDTO
//
// Возвращаемое значение:
//	Структура -  произвольный
//
Функция ПолучитьСтруктуруПоОбъектуXDTO(ОбъектXDTO) Экспорт

	Результат =  Новый Структура;

	Если ТипЗнч(ОбъектXDTO) = Тип("ЗначениеXDTO") Тогда
		Возврат ОбъектXDTO.Значение;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекцииСвойств Из ОбъектXDTO.Свойства() Цикл

		ЭлементДанных = ОбъектXDTO[ЭлементКоллекцииСвойств.Имя];
		Если (ТипЗнч(ЭлементДанных) = Тип("СписокXDTO")) Тогда

			Список = Новый Массив;
	
			Для Каждого ЭлементСписка Из ЭлементДанных Цикл
				Если ТипЗнч(ЭлементСписка) = Тип("ОбъектXDTO") Тогда
					НовыйЭлементМассива = ПолучитьСтруктуруПоОбъектуXDTO(ЭлементСписка);
				Иначе
					НовыйЭлементМассива = ЭлементСписка;
				КонецЕсли;
				
				Список.Добавить(НовыйЭлементМассива);
			КонецЦикла;
			
			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, Список);

		ИначеЕсли (ТипЗнч(ЭлементДанных) = Тип("ОбъектXDTO")) Тогда

			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, ПолучитьСтруктуруПоОбъектуXDTO(ЭлементДанных));

		Иначе

			Результат.Вставить(ЭлементКоллекцииСвойств.Имя, ЭлементДанных);

		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует ОбъектXDTO по строке формата XML
//
// Параметры:
//	 ТекстXML                  - Строка XML
//	 ПространствоИменXML       - Строка
//	 ТипXDTO                   - ТипXDTO
//	 BodyRoot                  - Булево - добавление пространства имен
//
// Возвращаемое значение:
//	ОбъектXDTO
//
Функция ПолучитьОбъектXDTO(Знач ТекстXML, Знач ПространствоИменXML = Неопределено, Знач ТипXDTO = Неопределено, BodyRoot = Ложь) Экспорт

	ОбXDTO = Неопределено;

	Если ТипXDTO = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(ПространствоИменXML)) Тогда
		ПространствоИменXML = ПолучитьПространствоИменПоУмолчанию();
	КонецЕсли;

	Если BodyRoot Тогда
		ТекстXML = "<BodyRoot xmlns=""" + ПространствоИменXML + """>" + ТекстXML + "</BodyRoot>";
	КонецЕсли;

	ККСНГ_XDTOКлиентСервер.УстановитьПространствоИменПервогоЭлемента(ТекстXML, ПространствоИменXML);

	Попытка

		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстXML);

		ТипXDTO = ФабрикаXDTO.Тип(ПространствоИменXML, ТипXDTO);

		ОбXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		ЧтениеXML.Закрыть();

	Исключение

		ТекстОписанияОшибки = ОписаниеОшибки();
		ВызватьИсключение ТекстОписанияОшибки + Символы.ПС  + ТекстXML;

	КонецПопытки;

	Возврат ОбXDTO;

КонецФункции

