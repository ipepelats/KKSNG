// Функция получает значения инфополей для указанного документа по настройкам из профиля контрагента. 
//
// Параметры:
//	- ДокументСсылка - ДокументСсылка.* - Ссылка на документ ИБ
//	- ПрофильКонтрагента - СправочникСсылка.ККСНГ_Контрагенты - профиль контрагента, содержащий настройки получения инфополей.
//	- ТипИнфополей - строка - Необязательный параметр, задается как строка типов инфополей разделенных запятой.
//		Пример: "ИнфоФХЖ2,ИнфоФХЖ3", "ИнфоФХЖ1,ИнфоФХЖ3", "ИнфоФХЖ1". 
//	  Если параметр не задан, то будут получены значения всех настроенных инфополей профиля.
//
// Возвращаемое значение:
//
//  Ответ - Структура, см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета() 
Функция ПолучитьЗначенияИнфополейДокумента(ДокументСсылка, ПрофильКонтрагента, СчетФактураСсылка = Неопределено, ТипИнфополей = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	СтруктураЗначенийИнфополей = Новый Структура;
	МассивОшибокЗаполнения = Новый Массив;
	
	Если ЗначениеЗаполнено(ДокументСсылка)
		И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДокументСсылка)) Тогда
		
		ИмяДокумента = "Документ." + ДокументСсылка.Метаданные().Имя;
	
		НастройкиИнфополей = ПолучитьНастройкиФормированияИнфополей(ИмяДокумента, ПрофильКонтрагента, ТипИнфополей);
			
		ПредставлениеДокумента = ПолучитьПредставлениеДокумента(ДокументСсылка, СчетФактураСсылка);
		
		ТаблицаЗначенийИнфополей = ПолучитьТаблицуИнфоПолей(НастройкиИнфополей, СчетФактураСсылка, ДокументСсылка);
		
		Для каждого КлючИЗначение Из НастройкиИнфополей Цикл
			
			МассивЗначенийИнфополей = Новый Массив;
			МассивНастроек = КлючИЗначение.Значение;
									
			Для каждого ЭлементНастройки Из МассивНастроек Цикл
				
				ПараметрыДанных = Новый Структура;
				ПараметрыДанных.Вставить("ЭлементНастройки", ЭлементНастройки);
				ПараметрыДанных.Вставить("ТаблицаЗначенийИнфополей", ТаблицаЗначенийИнфополей);
				ПараметрыДанных.Вставить("КлючИЗначение", КлючИЗначение);
				ПараметрыДанных.Вставить("МассивЗначенийИнфополей", МассивЗначенийИнфополей);
				ПараметрыДанных.Вставить("ПредставлениеДокумента", ПредставлениеДокумента);
				ПараметрыДанных.Вставить("Ответ", Ответ);
				
				Проверено = ПроверкаПолейЗаполненныхВручную(ПараметрыДанных);
				Если НЕ Проверено Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяПоля = "Инфополе_1";
				ТаблицаРезультат = ВычислитьЗначениеИнфополя(ЭлементНастройки, ДокументСсылка, ИмяПоля, МассивОшибокЗаполнения);
				
				ОбработатьЗначениеВычисления(ЭлементНастройки, ИмяПоля, ТаблицаРезультат, МассивЗначенийИнфополей, МассивОшибокЗаполнения);
				
			КонецЦикла;
											
			Если МассивЗначенийИнфополей.Количество() Тогда
				СтруктураЗначенийИнфополей.Вставить(КлючИЗначение.Ключ, МассивЗначенийИнфополей);	
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе // 
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьСообщение(Ответ.Журнал, "Некорректные параметры получения значений инфополей.");	
	КонецЕсли;
	
	СформироватьОтветПоИнфополям(Ответ, МассивОшибокЗаполнения, СтруктураЗначенийИнфополей, ПредставлениеДокумента);
	
	Возврат Ответ;
	
КонецФункции

// Функция вычисляет значение инфополя для указанного документа по настройкам из профиля контрагента. 
//
// Параметры:
//	- ЭлементНастройки - Структура, см. ККСНГ_ЭлектронныеДокументы.ПолучитьНастройкиФормированияИнфополей() - Настройка инфополя.
//	- ДокументСсылка - ДокументСсылка.* - Ссылка на документ ИБ
//	- ИмяПоля - Строка - Имя поля в СКД.
//	- МассивОшибокЗаполнения - Массив из Строка - При ошибках вычисления будет содержать ошибки. 
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит вычисленное значение инфополя. 
//
Функция ВычислитьЗначениеИнфополя(ЭлементНастройки, ДокументСсылка, ИмяПоля, МассивОшибокЗаполнения) Экспорт

	ТаблицаРезультат = Новый ТаблицаЗначений;
	ИмяТаблицы = ЭлементНастройки.Документ + ?(ЗначениеЗаполнено(ЭлементНастройки.ТабличнаяЧасть), "." + ЭлементНастройки.ТабличнаяЧасть, "");
	
	ТекстЗапроса = "ВЫБРАТЬ Первые 1 * ИЗ " + ИмяТаблицы + " ГДЕ Ссылка = &Ссылка";
		
	// Создаем схему компоновки
	СхемаКомпоновки = ККСНГ_ОбщегоНазначения.ПолучитьСхемуКомпоновкиДанныхИзЗапроса(ТекстЗапроса);
	
	// Настройки по умолчанию
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
	// Обновляем настройки с учетом заданных отборов
	Если ТипЗнч(ЭлементНастройки.ХранилищеУсловий) = Тип("ХранилищеЗначения") Тогда
		УсловиеОтбора = ЭлементНастройки.ХранилищеУсловий.Получить();
	КонецЕсли;
	
	Если ТипЗнч(УсловиеОтбора) = Тип("НастройкиКомпоновкиДанных")  Тогда
		Попытка
			КомпоновщикНастроек.ЗагрузитьНастройки(УсловиеОтбора);
		Исключение
			
			ТекстОшибки = СтрШаблон("Ошибка настройки поля ""%1"" раздела %2.", 
			ЭлементНастройки.Идентификатор,
			ЭлементНастройки.ТипИнфополя);
			
			МассивОшибокЗаполнения.Добавить(ТекстОшибки);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	// Задаем параметры
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Ссылка"));
	Параметр.Использование = Истина;
	Параметр.Значение = ДокументСсылка;
		
	// Добавляем все поля таблицы
	Структура = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Структура.Использование = Истина;
	Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	Для каждого ДоступноеПоле Из Настройки.Выбор.ДоступныеПоляВыбора.Элементы Цикл
		Если НЕ ДоступноеПоле.Папка Тогда
			ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ДоступноеПоле.Поле;
		КонецЕсли;
	КонецЦикла;
	
	// Добавляем вычисляемые поля
	ГруппаИнфополей = Настройки.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ГруппаИнфополей.Заголовок = "Инфополя";
	
	ФормулаАдаптированная = ЭлементНастройки.Формула;
	ОткрывающийсяРазделитель = ККСНГ_ОбщегоНазначенияКлиентСервер.ОткрывающийсяРазделитель(ФормулаАдаптированная);
	ЗакрывающийсяРазделитель = ККСНГ_ОбщегоНазначенияКлиентСервер.ЗакрывающийсяРазделитель(ФормулаАдаптированная);
	ФормулаАдаптированная = СтрЗаменить(ФормулаАдаптированная, ОткрывающийсяРазделитель, "");
	ФормулаАдаптированная = СтрЗаменить(ФормулаАдаптированная, ЗакрывающийсяРазделитель, "");
	
	ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Добавить();
	ВычисляемоеПоле.ПутьКДанным = ИмяПоля;
	ВычисляемоеПоле.Выражение = ФормулаАдаптированная;
	
	ВыбранноеПоле = ГруппаИнфополей.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	
	ВыбранноеПоле.Заголовок = ЭлементНастройки.Идентификатор;
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	// Компоновка и вывод в таблицу
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Исключение
		
		ТекстОшибки = СтрШаблон("Ошибка вычисления значения поля ""%1"" раздела %2.",
		ЭлементНастройки.Идентификатор,
		ЭлементНастройки.ТипИнфополя);
		МассивОшибокЗаполнения.Добавить(ТекстОшибки);
		
	КонецПопытки;
	
	Пока ТаблицаРезультат.Количество() > 1 Цикл
		ТаблицаРезультат.Удалить(ТаблицаРезультат.Количество() - 1);
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Получение количества документов в разделе
