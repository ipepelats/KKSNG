// Функция получает значения инфополей для указанного документа
//
// Параметры:
//	ДокументСсылка - Ссылка на документ
//	ИмяКлюча       - Строка
//	ИмяЗначения    - Строка
//
// Возвращаемое значение:
//	Массив структур ИмяКлюча-ИмяЗначения
//
Функция ПолучитьИнфоПоляМассивом(ДокументСсылка, ИмяКлюча, ИмяЗначения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ИнфоПоля КАК ИнфоПоля
	|ИЗ
	|	РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД КАК ККСНГ_ПМ_ДопРеквизитыЭД
	|ГДЕ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.СвязанныйДокумент = &СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", ДокументСсылка);
	
	ВыборкаДопРеквизиты = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДопРеквизиты.Следующий() Тогда
		
		ИнфоПоля = ВыборкаДопРеквизиты.ИнфоПоля.Получить();
		Если ИнфоПоля = Неопределено Тогда
			Возврат Неопределено;	
		КонецЕсли;
		
		ДанныеИнфоПолей = ЗначениеИзСтрокиВнутр(ИнфоПоля);
		Если ТипЗнч(ДанныеИнфоПолей) = Тип("Массив") И ДанныеИнфоПолей.Количество() > 0 И ТипЗнч(ДанныеИнфоПолей[0]) = Тип("Структура") Тогда
			
			МассивРезультат = Новый Массив;
			
			Для каждого ТекущееПоле Из ДанныеИнфоПолей Цикл
				РезультатСтруктура = Новый Структура;
				РезультатСтруктура.Вставить(ИмяКлюча, ТекущееПоле.Key);
				РезультатСтруктура.Вставить(ИмяЗначения, ТекущееПоле.Value);
				МассивРезультат.Добавить(РезультатСтруктура);
			КонецЦикла;
			
			Возврат МассивРезультат;
			
		Иначе	
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

КонецФункции

// Функция получает значения инфополей для указанного документа
//
// Параметры:
//	ДокументСсылка - Ссылка на документ
//
// Возвращаемое значение:
//	ТаблицаЗначений
// 		* ТипПоля
// 		* Идентиф
// 		* Значен
//			
Функция ПолучитьИнфоПоляТаблицей(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.ИнфоПоля КАК ИнфоПоля
	|ИЗ
	|	РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД КАК ККСНГ_ПМ_ДопРеквизитыЭД
	|ГДЕ
	|	ККСНГ_ПМ_ДопРеквизитыЭД.СвязанныйДокумент = &СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", ДокументСсылка);
	
	ВыборкаДопРеквизиты = Запрос.Выполнить().Выбрать();
	
	ТаблицаРезультат = Неопределено;
	
	Если НЕ ВыборкаДопРеквизиты.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИнфоПоля = ВыборкаДопРеквизиты.ИнфоПоля.Получить();
	
	Если НЕ ИнфоПоля = Неопределено Тогда
		
		ДанныеИнфоПолей = ЗначениеИзСтрокиВнутр(ИнфоПоля);
		
		Если ТипЗнч(ДанныеИнфоПолей) = Тип("Массив") 
			И ДанныеИнфоПолей.Количество() > 0 
			И ТипЗнч(ДанныеИнфоПолей[0]) = Тип("Структура") Тогда
			
			ТаблицаРезультат = Новый ТаблицаЗначений;
			ТаблицаРезультат.Колонки.Добавить("ТипПоля");
			ТаблицаРезультат.Колонки.Добавить("Идентиф");
			ТаблицаРезультат.Колонки.Добавить("Значен");
			
			Для каждого ТекущееПоле Из ДанныеИнфоПолей Цикл
				СтрокаТаблицы = ТаблицаРезультат.Добавить();
				
				Если НЕ ТекущееПоле.Свойство("Type", СтрокаТаблицы.ТипПоля) Тогда
					СтрокаТаблицы.ТипПоля = "ИнфоФХЖ1";
				КонецЕсли;
				
				СтрокаТаблицы.Идентиф = ТекущееПоле.Key;
				СтрокаТаблицы.Значен = ТекущееПоле.Value;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ТаблицаРезультат;
	
КонецФункции

// Функция получает настройки инфополей для указанного типа документа
//
// Параметры:
//	ИмяДокумента       - Строка
//	ПрофильКонтрагента - Справочник.ККСНГ_Контрагенты
//	ТипИнфополей       - ИнфоФХЖ1/2/3
//
// Возвращаемое значение:
//	Структура
// 		* ИнфоФХЖ1/2/3                             - Тип инфополей
// 		* СтруктураНастроекИнфополей.ИнфоФХЖ       - Структура:
// 			** Документ	                           - Строка
// 			** ДоступноЗаполнениеВручную	       - Булево
// 			** Идентификатор	                   - Строка
// 			** ОбязательноДляЗаполнения	           - Булево
// 			** Подсказка	                       - Строка
// 			** ТабличнаяЧасть	                   - Строка
// 			** ТипИнфополя	                       - Строка
// 			** Формула	                           - Строка
// 			** ХранилищеУсловий	                   - ХранилищеЗначения
//
Функция ПолучитьНастройкиФормированияИнфополей(ИмяДокумента, ПрофильКонтрагента, ТипИнфополей = Неопределено) Экспорт
	
	СтруктураНастроекИнфополей = Новый Структура;
	
	Если ТипИнфополей = Неопределено Тогда
		ОтборПоТипу = Ложь;
		МассивТипов = Неопределено;
	Иначе
		ОтборПоТипу = Истина;
		МассивТипов = СтрРазделить(ТипИнфополей, ",");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	""ИнфоФХЖ1"" КАК ТипИнфополя,
				   |	ИСТИНА КАК ОбязательноДляЗаполнения,
				   |	ИСТИНА КАК ДоступноЗаполнениеВручную,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Документ КАК Документ,
	               |	"""" КАК ТабличнаяЧасть,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Идентификатор КАК Идентификатор,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.ХранилищеУсловий КАК ХранилищеУсловий,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Формула КАК Формула,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Подсказка КАК Подсказка
	               |ИЗ
	               |	Справочник.ККСНГ_Контрагенты.ИнформационныеПоляФХЖ1 КАК ККСНГ_КонтрагентыИнформационныеПоляФХЖ1
	               |ГДЕ
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Ссылка = &ПрофильКонтрагента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Документ = &ИмяДокумента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ1.Использовать
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоТипу
	               |				ТОГДА ""ИнфоФХЖ1"" В (&МассивТипов)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ИнфоФХЖ2"",
				   |	ИСТИНА,
				   |	ЛОЖЬ,
				   |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Документ,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.ТабличнаяЧасть,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Идентификатор,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.ХранилищеУсловий,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Формула,
	               |	""""
	               |ИЗ
	               |	Справочник.ККСНГ_Контрагенты.ИнформационныеПоляФХЖ2 КАК ККСНГ_КонтрагентыИнформационныеПоляФХЖ2
	               |ГДЕ
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Ссылка = &ПрофильКонтрагента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Документ = &ИмяДокумента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ2.Использовать
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоТипу
	               |				ТОГДА ""ИнфоФХЖ2"" В (&МассивТипов)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	""ИнфоФХЖ3"",
				   |	ИСТИНА,
	               |	ИСТИНА,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Документ,
	               |	"""",
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Идентификатор,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.ХранилищеУсловий,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Формула,
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Подсказка
	               |ИЗ
	               |	Справочник.ККСНГ_Контрагенты.ИнформационныеПоляФХЖ3 КАК ККСНГ_КонтрагентыИнформационныеПоляФХЖ3
	               |ГДЕ
	               |	ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Ссылка = &ПрофильКонтрагента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Документ = &ИмяДокумента
	               |	И ККСНГ_КонтрагентыИнформационныеПоляФХЖ3.Использовать
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоТипу
	               |				ТОГДА ""ИнфоФХЖ3"" В (&МассивТипов)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |ИТОГИ ПО
	               |	ТипИнфополя";
	
	Запрос.УстановитьПараметр("ПрофильКонтрагента", ПрофильКонтрагента);
	Запрос.УстановитьПараметр("ИмяДокумента", ИмяДокумента);
	Запрос.УстановитьПараметр("ОтборПоТипу", ОтборПоТипу);
	Запрос.УстановитьПараметр("МассивТипов", МассивТипов);
	
	ВыборкаПоТипам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ТипИнфополя");
	
	Пока ВыборкаПоТипам.Следующий() Цикл
		
		ВыборкаНастроек = ВыборкаПоТипам.Выбрать();
		МассивНастроек = Новый Массив;
		
		Пока ВыборкаНастроек.Следующий() Цикл
			МассивНастроек.Добавить(ККСНГ_ОбщегоНазначенияВызовСервера.СтрокаТаблицыЗначенийВСтруктуру(ВыборкаНастроек));
		КонецЦикла;
		
		Если МассивНастроек.Количество() Тогда
			СтруктураНастроекИнфополей.Вставить(ВыборкаПоТипам.ТипИнфополя, МассивНастроек);
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СтруктураНастроекИнфополей;
	
КонецФункции

#КонецОбласти

