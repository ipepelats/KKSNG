	ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(АдресХранилищаРезультата);
	
	ДанныеФормированияЗапросовРазделов = ЗначениеИзСтрокиВнутр(ДанныеФормированияЗапросовРазделов);
	
	//Результаты = Новый Соответствие();
	//Для каждого ДанныеФормированияЗапросаРаздела Из ДанныеФормированияЗапросовРазделов Цикл
	//	Раздел = ДанныеФормированияЗапросаРаздела.Ключ;
	//	ДанныеФормирования = ДанныеФормированияЗапросаРаздела.Значение;
	//	КоличествоСтрок = ПолучитьКоличествоСтрокИзДанныхФормирования(ДанныеФормирования);		
	//	Результаты.Вставить(Раздел, КоличествоСтрок);
	//КонецЦикла;
	
	Результаты = ВыполнитьРасчетКоличестваЭлементовВРазделах(ДанныеФормированияЗапросовРазделов);		
	
	Ответ.Успех = Истина;
	
	Ответ.Результат = Результаты;
	
	ПоместитьВоВременноеХранилище(Ответ, АдресХранилищаРезультата); 
	
КонецПроцедуры

