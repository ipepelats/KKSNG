КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДоступныеДействияДокументаКурьер(Объект)
	
	СписокДействийПоМаске = ККСНГ_ДокументооборотКлиентСервер.ПолучитьСоответствиеМаскиДействийИзСтроки(Объект.Actions);
	
	Если НРег(СокрЛП(Объект.Status)) = "delivered" Тогда

		СписокДействийПоМаске.Вставить("Accept", Истина);
		СписокДействийПоМаске.Вставить("Reject", Истина);

	КонецЕсли;

	Если СписокДействийПоМаске["AcceptWithTicket"] <> Неопределено
		И СписокДействийПоМаске["AcceptWithTicket"] Тогда

		СписокДействийПоМаске.Удалить("Accept");

	КонецЕсли;

	Если СписокДействийПоМаске["RejectWithTicket"] <> Неопределено
		И СписокДействийПоМаске["RejectWithTicket"] Тогда

		СписокДействийПоМаске.Удалить("Reject");

	КонецЕсли;
	
	Возврат СписокДействийПоМаске;
	
КонецФункции

Процедура ОбработатьТипОбъектаXDTO(ЭтоСписок, СвойстваТипа, Результат, ПространствоИмен)

	Если ЭтоСписок Тогда
		Таблица = Новый ТаблицаЗначений;
		Для каждого ТекСвойство Из СвойстваТипа Цикл
			Таблица.Колонки.Добавить(ТекСвойство.Имя);
		КонецЦикла;
		Результат = Таблица;
	ИначеЕсли СвойстваТипа.Количество() > 0 Тогда
		Результат = Новый Структура;
		Для каждого ТекСвойство Из СвойстваТипа Цикл
			ТекИмяСвойства = ТекСвойство.Имя;
			Результат.Вставить(ТекИмяСвойства, СтруктураПоТипуXDTO(ТекСвойство.Тип, ПространствоИмен, ТекСвойство.ВерхняяГраница <> 1));
		КонецЦикла;
	Иначе
		Возврат;
		
	КонецЕсли;	

КонецПроцедуры

// Возвращает структуру с ключами, аналогичными полям указанного типа XDTO
//
// Параметры:
//	ТипXDTO - строка с именем типа или тип объекта XDTO
//	ПространствоИмен - пространство имен
//
// Возвращаемое значение: 
//	Структура
//
// Пример:
//	СтруктураДокумента = СтруктураПоТипуXDTO("type_Document", "http://schemas.datacontract.org/2004/07/Korus.Eds.Api");
//
Функция СтруктураПоТипуXDTO(Знач ТипXDTO, ПространствоИмен, ЭтоСписок = Ложь)
	
	Результат = Неопределено;
				
	Если ТипЗнч(ТипXDTO) = Тип("Строка") Тогда
		
		ИменаТипов = СтрРазделить(ТипXDTO, ".", Ложь);
		
		Если ИменаТипов.Количество() > 0 Тогда
									
			ТипXDTO = ФабрикаXDTO.Тип(ПространствоИмен, ИменаТипов[0]);
			ИменаТипов.Удалить(0);
			
			Для Каждого ИмяТипа Из ИменаТипов Цикл

				Свойство = ТипXDTO.Свойства.Получить(ИмяТипа);
				
				Если Свойство = Неопределено Тогда
					Возврат Результат;
				Иначе
					ЭтоСписок = Свойство.ВерхняяГраница <> 1;
					ТипXDTO = Свойство.Тип;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") Тогда
		
		СвойстваТипа = ТипXDTO.Свойства;

		ОбработатьТипОбъектаXDTO(ЭтоСписок, СвойстваТипа, Результат, ПространствоИмен);
		
		Возврат Результат;
		
	ИначеЕсли ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда
		
		Если ТипXDTO.Имя = "boolean" Тогда
			Результат = Ложь;
			Возврат Результат;
		Иначе
			Возврат Результат;
		КонецЕсли;
		
	Иначе
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

#Область РаботаСИнфополями

Функция ПолучитьПредставлениеДокумента(ДокументСсылка, СчетФактураСсылка)

	Если СчетФактураСсылка = Неопределено Тогда
		ПредставлениеДокумента = Строка(ДокументСсылка);
	Иначе
		ПредставлениеДокумента = Строка(СчетФактураСсылка);	
	КонецЕсли;	
	
	Возврат ПредставлениеДокумента;

КонецФункции

Функция ПолучитьТаблицуИнфоПолей(НастройкиИнфополей, СчетФактураСсылка, ДокументСсылка)

	ТаблицаЗначенийИнфополей  = Неопределено;
	
	Если НастройкиИнфополей.Количество() Тогда
		Если СчетФактураСсылка = Неопределено Тогда
			ТаблицаЗначенийИнфополей = ПолучитьИнфоПоляТаблицей(ДокументСсылка);
		Иначе
			ТаблицаЗначенийИнфополей = ПолучитьИнфоПоляТаблицей(СчетФактураСсылка);	
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ТаблицаЗначенийИнфополей;

КонецФункции

Функция ПроверкаПолейЗаполненныхВручную(Данные)

	ЭлементНастройки = Данные.ЭлементНастройки;
	ТаблицаЗначенийИнфополей = Данные.ТаблицаЗначенийИнфополей;
	КлючИЗначение = Данные.КлючИЗначение;
	МассивЗначенийИнфополей = Данные.МассивЗначенийИнфополей;
	ПредставлениеДокумента = Данные.ПредставлениеДокумента;
	Ответ = Данные.Ответ;
	
	// Проверяем значения полей, заполненных вручную 
	Если ЭлементНастройки.ДоступноЗаполнениеВручную
		И ТипЗнч(ТаблицаЗначенийИнфополей) = Тип("ТаблицаЗначений") Тогда
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ТипПоля", КлючИЗначение.Ключ);                     
		СтруктураПоиска.Вставить("Идентиф", ЭлементНастройки.Идентификатор);
		
		НайдСтроки = ТаблицаЗначенийИнфополей.НайтиСтроки(СтруктураПоиска);
		
		Если НайдСтроки.Количество() Тогда 
			СтруктураИнфополя = ККСНГ_ОбщегоНазначенияВызовСервера.СтрокаТаблицыЗначенийВСтруктуру(НайдСтроки[0]);
			
			Если ЗначениеЗаполнено(СтруктураИнфополя.Значен) Тогда
				
				МассивЗначенийИнфополей.Добавить(СтруктураИнфополя);
				
				ТекстСообщения = СтрШаблон("Значение поля ""%1"" для документа %2 задано вручную - %3.", 
				ЭлементНастройки.Идентификатор, 
				ПредставлениеДокумента, 
				СтруктураИнфополя.Значен);
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения);
				
				Возврат Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	

	Возврат Истина;
	
КонецФункции

Процедура ОбработатьЗначениеВычисления(ЭлементНастройки, ИмяПоля, ТаблицаРезультат, МассивЗначенийИнфополей, МассивОшибокЗаполнения)

	Если ЭлементНастройки.ТипИнфополя = "ИнфоФХЖ2" Тогда 
		Для каждого СтрРезультат Из ТаблицаРезультат Цикл
			
			ЗначениеПоля = СтрРезультат[ИмяПоля];
			
			// TODO после добавления флага обязательности заполнения в ТЧ инфополей убрать эту проверку
			Если НЕ ЗначениеПоля = Неопределено
				И НЕ ЗначениеПоля = Null Тогда
				
				ОбработатьИнфоФХЖ2(ЗначениеПоля, ЭлементНастройки, СтрРезультат, МассивОшибокЗаполнения, МассивЗначенийИнфополей);
				
			КонецЕсли;
			
		КонецЦикла;	
	Иначе // Для инфополей кроме ФХЖ2 берем только первую строку результата
		Если ТаблицаРезультат.Количество() Тогда
			
			ЗначениеПоля = ТаблицаРезультат[0][ИмяПоля];
			
			// TODO после добавления флага обязательности заполнения в ТЧ инфополей убрать эту проверку
			Если НЕ ЗначениеПоля = Неопределено
				И НЕ ЗначениеПоля = Null Тогда
				
				ОбработатьИнфоФХЖ13(ЗначениеПоля, ЭлементНастройки, МассивОшибокЗаполнения, МассивЗначенийИнфополей);
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьИнфоФХЖ13(ЗначениеПоля, ЭлементНастройки, МассивОшибокЗаполнения, МассивЗначенийИнфополей)

	Если НЕ ЗначениеЗаполнено(ЗначениеПоля) 
		И ЭлементНастройки.ОбязательноДляЗаполнения Тогда
		
		ТекстОшибки = СтрШаблон("Не заполнено значение поля ""%1"" раздела %2.", 
		ЭлементНастройки.Идентификатор,
		ЭлементНастройки.ТипИнфополя);
		
		МассивОшибокЗаполнения.Добавить(ТекстОшибки);
		
	Иначе
		
		СтруктураИнфополя = Новый Структура;
		СтруктураИнфополя.Вставить("Идентиф", ЭлементНастройки.Идентификатор);
		СтруктураИнфополя.Вставить("Значен", Строка(ЗначениеПоля));
		
		МассивЗначенийИнфополей.Добавить(СтруктураИнфополя);
	КонецЕсли;	

КонецПроцедуры

Процедура ОбработатьИнфоФХЖ2(ЗначениеПоля, ЭлементНастройки, СтрРезультат, МассивОшибокЗаполнения, МассивЗначенийИнфополей)

	Если НЕ ЗначениеЗаполнено(ЗначениеПоля) 
		И ЭлементНастройки.ОбязательноДляЗаполнения Тогда
		
		ТекстОшибки = СтрШаблон("Не заполнено значение поля ""%1"" раздела %2 в строке %3.", 
		ЭлементНастройки.Идентификатор,
		ЭлементНастройки.ТипИнфополя,
		СтрРезультат.НомерСтроки);
		
		МассивОшибокЗаполнения.Добавить(ТекстОшибки);
		
	Иначе	
		СтруктураИнфополя = Новый Структура;
		СтруктураИнфополя.Вставить("Идентиф", ЭлементНастройки.Идентификатор);
		
		СтруктураПолей = ККСНГ_ОбщегоНазначенияВызовСервера.СтрокаТаблицыЗначенийВСтруктуру(СтрРезультат);
		СтруктураПолей.Вставить("ТабличнаяЧасть", ЭлементНастройки.ТабличнаяЧасть);
		
		СтруктураИнфополя.Вставить("ДопПоля", СтруктураПолей);
		СтруктураИнфополя.Вставить("Значен", Строка(ЗначениеПоля));
		
		МассивЗначенийИнфополей.Добавить(СтруктураИнфополя);
		
	КонецЕсли;	

КонецПроцедуры

Процедура СформироватьОтветПоИнфополям(Ответ, МассивОшибокЗаполнения, СтруктураЗначенийИнфополей, ПредставлениеДокумента)

	Если МассивОшибокЗаполнения.Количество() = 0 Тогда
		Ответ.Успех = Истина;
		Ответ.Результат = СтруктураЗначенийИнфополей;
	Иначе
		
		ОбщийТекстОшибки = "Некорректное заполнение инфополей документа " + ПредставлениеДокумента + ":";
		ТекстОшибок = "";
		
		Для каждого СтрокаОшибки Из МассивОшибокЗаполнения Цикл
			ТекстОшибок = ТекстОшибок + Символы.ПС + СтрокаОшибки;	
		КонецЦикла;
		
		ОбщийТекстОшибки = ОбщийТекстОшибки + ТекстОшибок;
			
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОбщийТекстОшибки, "IF-000003");

	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область РаботаСДопПараметрами

Функция ДополнительныйПараметр(Ключ, Значение = "", ОбязательноЗаполнение = Ложь, ВозможноИзменение = Ложь, 
										Представление = Неопределено, СписокДопустимыхЗначений = Неопределено, Комментарий = "")
	
	ДополнительныйПараметр = Новый Структура();
	ДополнительныйПараметр.Вставить("Ключ", Ключ);
	ДополнительныйПараметр.Вставить("Значение", Значение);
	ДополнительныйПараметр.Вставить("ОбязательноЗаполнение", ОбязательноЗаполнение);
	ДополнительныйПараметр.Вставить("ВозможноИзменение", ВозможноИзменение);
	ДополнительныйПараметр.Вставить("Представление", Представление);
	ДополнительныйПараметр.Вставить("ДоступенСписокЗначений", ТипЗнч(СписокДопустимыхЗначений) = Тип("СписокЗначений"));
	ДополнительныйПараметр.Вставить("СписокДопустимыхЗначений", СписокДопустимыхЗначений);
	ДополнительныйПараметр.Вставить("Комментарий", Комментарий);
			
	Возврат ДополнительныйПараметр;		
	
КонецФункции

Функция ПолучитьСписокДополнительныхПараметровДокумента(ДопПараметры = Неопределено)
	
	СоответствиеДопПараметровДокументам = Новый Соответствие();
	
	БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "БизнесПроцесс");
	
	Если БизнесПроцесс = "УВХД" Тогда
		
		СписокДопустимойВалюты = ПолучитьСписокДопустимыхВалютУВХД();
		СписокНаименованийДокумента = ПолучитьСписокНаименованийДокументаУВХД();
		
		ДопПараметр_БизнесПроцесс = ДополнительныйПараметр("business process", , Истина, Ложь, "Бизнес-процесс");
		ДопПараметр_ЭлектроннаяПочтаСотрудника = ДополнительныйПараметр("manager.email", , Ложь, Истина, "Email сотрудника банка");
		ДопПараметр_ПодписьОтправителя = ДополнительныйПараметр("system.senderSignatureRequired", , Истина, Ложь, "Подпись отправителя");
		ДопПараметр_Валюта = ДополнительныйПараметр("document.currency", , Истина, Истина, "Валюта", СписокДопустимойВалюты, "Заполняется буквенным кодом валюты латиницей, согласно классификатору (например, RUB).");
		ДопПараметр_НазначениеДокумента = ДополнительныйПараметр("type", , Ложь, Ложь, "Назначение документа");
		ДопПараметр_НомерДоговораУВХД = ДополнительныйПараметр("uvhd.contract.number", , Истина, Истина, "Номер электронного договора");
		ДопПараметр_НаименованиеДокументаУВХД = ДополнительныйПараметр("document.name", , Истина, Истина, "Наименование документа", СписокНаименованийДокумента);
		
		// Структурированные документы
		ДопПараметрыUPD_DOP = Новый Массив();
		ДопПараметрыUPD_DOP.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыUPD_DOP.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыUPD_DOP.Добавить(ДопПараметр_НомерДоговораУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("UPD_DOP", ДопПараметрыUPD_DOP);
		
		ДопПараметрыUPD_SF = Новый Массив();
		ДопПараметрыUPD_SF.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыUPD_SF.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыUPD_SF.Добавить(ДопПараметр_НомерДоговораУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("UPD_SF", ДопПараметрыUPD_SF);
		
		ДопПараметрыUPD_SF_DOP = Новый Массив();
		ДопПараметрыUPD_SF_DOP.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыUPD_SF_DOP.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыUPD_SF_DOP.Добавить(ДопПараметр_НазначениеДокумента);
		ДопПараметрыUPD_SF_DOP.Добавить(ДопПараметр_НомерДоговораУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("UPD_SF_DOP", ДопПараметрыUPD_SF_DOP);
		
		ДопПараметрыUVHD_BILL = Новый Массив();
		ДопПараметрыUVHD_BILL.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыUVHD_BILL.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыUVHD_BILL.Добавить(ДопПараметр_Валюта);
		ДопПараметрыUVHD_BILL.Добавить(ДопПараметр_НомерДоговораУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("UVHD_BILL", ДопПараметрыUVHD_BILL);
		
		// Неструктурированные документы
		ДопПараметрыACT = Новый Массив();
		ДопПараметрыACT.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыACT.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыACT.Добавить(ДопПараметр_Валюта);
		ДопПараметрыACT.Добавить(ДопПараметр_ПодписьОтправителя);
		ДопПараметрыACT.Добавить(ДопПараметр_НомерДоговораУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("ACT", ДопПараметрыACT);
		
		ДопПараметрыACT_PROD = Новый Массив();
		ДопПараметрыACT_PROD.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыACT_PROD.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		
		СоответствиеДопПараметровДокументам.Вставить("ACT_PROD", ДопПараметрыACT_PROD);
		
		ДопПараметрыDOCUMENT = Новый Массив();
		ДопПараметрыDOCUMENT.Добавить(ДопПараметр_БизнесПроцесс);
		ДопПараметрыDOCUMENT.Добавить(ДопПараметр_ЭлектроннаяПочтаСотрудника);
		ДопПараметрыDOCUMENT.Добавить(ДопПараметр_ПодписьОтправителя);
		ДопПараметрыDOCUMENT.Добавить(ДопПараметр_НаименованиеДокументаУВХД);
		
		СоответствиеДопПараметровДокументам.Вставить("DOCUMENT", ДопПараметрыDOCUMENT);
		
	КонецЕсли;
	
	Возврат СоответствиеДопПараметровДокументам;
	
КонецФункции

Процедура ЗаполнитьЗначенияДопПараметровПоУмолчанию(ДопПараметрыДокумента, ДанныеДокумента, ДопПараметры = Неопределено)
	
	Если Не ТипЗнч(ДопПараметрыДокумента) = Тип("Массив") Тогда
		Возврат;				
	КонецЕсли;
	
	БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "БизнесПроцесс");
	Если БизнесПроцесс = "УВХД" Тогда
		
		ПрофильКонтрагента = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ПрофильКонтрагента");		
		
		Если ДанныеДокумента.Свойство("ДокументСсылка") И ЗначениеЗаполнено(ДанныеДокумента.ДокументСсылка) Тогда
			ДанныеДоговораУВХД = ПолучитьДанныеДоговораУВХДПоДокументу(ДанныеДокумента.ДокументСсылка);
		ИначеЕсли ДанныеДокумента.Свойство("Договор") И ЗначениеЗаполнено(ДанныеДокумента.Договор) Тогда
			МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
			ДанныеДоговора1С = МодульККСНГ_ПМ_РаботаСМетаданными.ПолучитьДанныеДоговора(ДанныеДокумента.Договор);
			ДанныеДоговораУВХД = ПолучитьДанныеДоговораУВХД(ДанныеДоговора1С);
		Иначе
			ДанныеДоговораУВХД = Неопределено;
		КонецЕсли;
		
		ВалютаПоУмолчанию = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДоговораУВХД, "ВалютаДоговора", "");
		Если ЗначениеЗаполнено(ВалютаПоУмолчанию) Тогда
			ВалютаПоУмолчанию = ВалютаПоУмолчанию.Наименование;	
		КонецЕсли;
		
		ЗначениямПоУмолчанию = Новый Соответствие();
		ЗначениямПоУмолчанию.Вставить("business process", "UVHD");
		ЗначениямПоУмолчанию.Вставить("manager.email", ПрофильКонтрагента.СотрудникБанкаEmail);
		ЗначениямПоУмолчанию.Вставить("system.senderSignatureRequired", "true");
		ЗначениямПоУмолчанию.Вставить("document.currency", ВалютаПоУмолчанию);
		ЗначениямПоУмолчанию.Вставить("type", "");
		ЗначениямПоУмолчанию.Вставить("uvhd.contract.number", ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДоговораУВХД, "НомерДоговора"));
		ЗначениямПоУмолчанию.Вставить("document.name", ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "НаименованиеДокументаУВХД"));
		
		Для каждого ДопПараметрДокумента Из ДопПараметрыДокумента Цикл
			ДопПараметрДокумента.Значение = ЗначениямПоУмолчанию.Получить(ДопПараметрДокумента.Ключ);		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоСчетчиками

Функция ПолучитьКоличествоСтрокИзДанныхФормирования(ДанныеФормированияЗапроса)
	
	КоличествоСтрок = 0;
	
	Если ДанныеФормированияЗапроса.Свойство("ТекстЗапроса") Тогда
		
		ТекстЗапроса = ДанныеФормированияЗапроса.ТекстЗапроса;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РАЗРЕШЕННЫЕ", "");
		
		Шаблон = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(1) КАК _Счетчик
		|ИЗ
		|	(%1) КАК _ВложенныйЗапрос";
		ТекстЗапроса = СтрШаблон(Шаблон, ТекстЗапроса);
		
		Если ДанныеФормированияЗапроса.Свойство("ПараметрыЗапроса") Тогда
			ПараметрыЗапроса = ДанныеФормированияЗапроса.ПараметрыЗапроса;
			Запрос = Новый Запрос(ТекстЗапроса);
			Для каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
				Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);	
			КонецЦикла;
		КонецЕсли;
		
		Попытка
			Результат = Запрос.Выполнить();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		КоличествоСтрок = Выборка._Счетчик;
		
		//КоличествоСтрок = Результат.Выбрать().Количество();
		
	ИначеЕсли ДанныеФормированияЗапроса.Свойство("Схема") Тогда
		
		Схема = ДанныеФормированияЗапроса.Схема;
		Настройки = ДанныеФормированияЗапроса.Настройки;
				
		КомпоновщикМакета  = Новый КомпоновщикМакетаКомпоновкиДанных();
		Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
		
		// С учетом отборов
		//ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
		//ПроцессорКомпоновкиДанных.Инициализировать(Макет);
		// 
		//ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		//КоличествоСтрок = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).Количество();
		
		// Без учета отборов
		Запрос = Новый Запрос;
		ТекстЗапроса = Макет.НаборыДанных.НаборДанныхДинамическогоСписка.Запрос;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РАЗРЕШЕННЫЕ", "");
		
		Шаблон = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(1) КАК _Счетчик
		|ИЗ
		|	(%1) КАК _ВложенныйЗапрос";
		ТекстЗапроса = СтрШаблон(Шаблон, ТекстЗапроса);
		
		Запрос.Текст = ТекстЗапроса;
		
		Для Каждого Парам из Макет.ЗначенияПараметров Цикл
			Запрос.УстановитьПараметр(Парам.Имя, Парам.Значение);
		КонецЦикла;
		
		Попытка
			Результат = Запрос.Выполнить();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		КоличествоСтрок = Выборка._Счетчик;
		
		//КоличествоСтрок = Выборка.Количество();
				
	КонецЕсли;
	
	Возврат КоличествоСтрок;
	
КонецФункции

Функция ВыполнитьРасчетКоличестваЭлементовВРазделах(ДанныеПоРазделам)
			
	Запрос = Новый Запрос;
	ЧастиТекстаЗапроса = Новый Массив;
	
	КоличествоЗапросовВПакете = 0;
	РазделительЗапросовВПакете = 
		"
		|;
		|";
	 
	ПоложениеРезультатовВПакете = Новый Соответствие;
	
	Для каждого ДанныеРаздела Из ДанныеПоРазделам Цикл
		
		ИмяРаздела = ДанныеРаздела.Ключ;
		ДанныеЗапроса = ДанныеРаздела.Значение;
		
		ТекстЗапроса = ДанныеЗапроса.ТекстЗапроса;
		
		// Обернем запрос в выборку количества
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РАЗРЕШЕННЫЕ", "");
		
		Шаблон = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(1) КАК _Счетчик
		|ИЗ
		|	(%1) КАК _ВложенныйЗапрос";
		ТекстЗапроса = СтрШаблон(Шаблон, ТекстЗапроса);
			
		// Переименовываем и устанавливаем параметры запроса.
		Префикс = СтрШаблон("%1_", ИмяРаздела);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&", "&" + Префикс);
		
		// Устанавливаем параметры			
		Для каждого ПараметрЗапроса Из ДанныеЗапроса.ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Префикс + ПараметрЗапроса.Имя, ПараметрЗапроса.Значение);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ЧастиТекстаЗапроса) Тогда
			ЧастиТекстаЗапроса.Добавить(РазделительЗапросовВПакете);
		КонецЕсли;
		
		ТекстЗапросаВПакете = СтрШаблон(
			"////////////////////////////////////////////////////////////////////////////
			|// %1
			|
			|%2", ИмяРаздела, ТекстЗапроса);
		ЧастиТекстаЗапроса.Добавить(ТекстЗапросаВПакете);
			
		
		// Вычисляем положение результата по разделу в пакете.
		КоличествоЗапросовВПакете = КоличествоЗапросовВПакете + 1;
		
		ПоложениеРезультатовВПакете.Вставить(ИмяРаздела, КоличествоЗапросовВПакете - 1);
				      		
	КонецЦикла;	
	
	// Заполняем результаты по разделам по данным пакета.
	Запрос.Текст = СтрСоединить(ЧастиТекстаЗапроса);
	Результаты = Запрос.ВыполнитьПакет();
	
	РезультатыПоРазделам = Новый Соответствие();
	
	Для каждого ДанныеРаздела Из ДанныеПоРазделам Цикл
		
		ИмяРаздела = ДанныеРаздела.Ключ;
		КоличествоЭлементов = 0;
			
		ИндексРезультата = ПоложениеРезультатовВПакете.Получить(ИмяРаздела);
		
		Если НЕ ИндексРезультата = Неопределено Тогда
		
			Результат = Результаты[ИндексРезультата];
			
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
			
				Пока Выборка.Следующий() Цикл
					КоличествоЭлементов = КоличествоЭлементов + Выборка._Счетчик;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		РезультатыПоРазделам.Вставить(ИмяРаздела, КоличествоЭлементов);
		
	КонецЦикла;
	
	Возврат РезультатыПоРазделам;
	
КонецФункции

#КонецОбласти

#КонецОбласти
