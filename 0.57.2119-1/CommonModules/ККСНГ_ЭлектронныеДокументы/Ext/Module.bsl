// Заполняет объект XDTO
//
// Параметры:
//	ОбъектXDTO         - Объект XDTO, произвольный
//	Данные             - Структура, произвольная
//
Процедура ЗаполнитьОбъектXDTOПоСтруктуре(ОбъектXDTO, Данные) Экспорт
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Для Каждого ЭлементКоллекцииСвойств Из ОбъектXDTO.Свойства() Цикл
		
		ЭлементДанных = ОбъектXDTO[ЭлементКоллекцииСвойств.Имя];
		Если ТипЗнч(ЭлементДанных) = Тип("СписокXDTO")
			И Данные.Свойство(ЭлементКоллекцииСвойств.Имя)
				И ТипЗнч(Данные[ЭлементКоллекцииСвойств.Имя]) = Тип("Массив") Тогда
				
			Для Каждого СтрокаДанных Из Данные[ЭлементКоллекцииСвойств.Имя] Цикл
				НовыйЭлемент = ФабрикаXDTO.Создать(ЭлементКоллекцииСвойств.Тип);
				Если НовыйЭлемент = Неопределено Тогда
					// Это конечный элемент
					НовыйЭлемент = СтрокаДанных;
				Иначе
					// Рекурсивно заполняем дальше
					ЗаполнитьОбъектXDTOПоСтруктуре(НовыйЭлемент, СтрокаДанных);
				КонецЕсли;
				ЭлементДанных.Добавить(НовыйЭлемент);
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ЭлементКоллекцииСвойств.Тип) = Тип("ТипОбъектаXDTO") И ТипЗнч(ЭлементДанных) <> Тип("СписокXDTO") Тогда
			
			ЗначениеСвойства = Неопределено;
			Если Данные.Свойство(ЭлементКоллекцииСвойств.Имя, ЗначениеСвойства) И ЗначениеСвойства <> Неопределено Тогда
				ОбъектXDTO[ЭлементКоллекцииСвойств.Имя] = ФабрикаXDTO.Создать(ЭлементКоллекцииСвойств.Тип);
				ЗаполнитьОбъектXDTOПоСтруктуре(ОбъектXDTO[ЭлементКоллекцииСвойств.Имя], Данные[ЭлементКоллекцииСвойств.Имя]);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ЭлементКоллекцииСвойств.Тип) = Тип("ТипЗначенияXDTO") И Данные.Свойство(ЭлементКоллекцииСвойств.Имя) 
			И (ЭлементКоллекцииСвойств.ВозможноПустое Или ЗначениеЗаполнено(Данные[ЭлементКоллекцииСвойств.Имя])) Тогда
				
			ЗаполнитьЗначенияСвойств(ОбъектXDTO, Данные, ЭлементКоллекцииСвойств.Имя);	
			
		Иначе 
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Обновляет список доступных действий для существующих документов
//
// Параметры:
//  Объект     -  ККСНГ_ЭлектронныеДокументы
// 
//
Процедура ЗаполнитьДоступныеДействияКурьер(Объект) Экспорт
	
	Объект.DocumentActions.Очистить();
	
	ДоступныеДействияКурьер = ПолучитьДоступныеДействияДокументаКурьер(Объект);
	
	Для каждого ДоступноеДействияКурьер Из ДоступныеДействияКурьер Цикл
		Объект.DocumentActions.Добавить().Action = ДоступноеДействияКурьер.Ключ;		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДопПараметрыДокумента(ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	ДопПараметрыРезультат = Новый Массив();
	ДанныеЗапросаДопПараметров = Новый Структура();
		
	ДопПараметрыДокумента = ДополнительныеПараметрыДокумента(ДанныеДокумента, ДопПараметры);
	Если ДопПараметрыДокумента = Неопределено Тогда
		Возврат ДопПараметрыРезультат;		
	КонецЕсли;
	
	ДопПараметрыОбщийСписок = Новый Соответствие();
	Для каждого ДопПараметрДокумента Из ДопПараметрыДокумента Цикл
		ДопПараметрыОбщийСписок.Вставить(ДопПараметрДокумента.Ключ, ДопПараметрДокумента);
	КонецЦикла;
	
	ДопРеквизитыДокумента = ПрочитатьДополнительныеРеквизитыДокумента(ДанныеДокумента.ДокументСсылка);
	ДопПараметрыРезультат = ДополнитьДопПараметры(ДопПараметрыДокумента, ДопРеквизитыДокумента);
	
	Возврат ДопПараметрыРезультат;
	
КонецФункции

Функция ДополнитьДопПараметры(ДопПараметрыПоУмолчанию, ДопПараметрыДополнения = Неопределено) Экспорт
	
	ДопПараметрыДокумента = Новый Массив();
	ДопПараметрыОбщийСписок = Новый Соответствие();
	ДопПараметрыРезультат = Новый Массив();
	
	Для каждого ДопПараметрДокумента Из ДопПараметрыПоУмолчанию Цикл
		ДопПараметрыОбщийСписок.Вставить(ДопПараметрДокумента.Ключ, ДопПараметрДокумента);
	КонецЦикла;
	
	Если Не ДопПараметрыДополнения = Неопределено Тогда
		Если ДопПараметрыДополнения.УстановленыДопПараметры Тогда
			Если ТипЗнч(ДопПараметрыДополнения.ДопПараметры) = Тип("ХранилищеЗначения") Тогда
				ДопПараметрыДокументаСтрока = ДопПараметрыДополнения.ДопПараметры.Получить();
				Если Не ДопПараметрыДокументаСтрока = Неопределено Тогда
					ДопПараметрыДокумента = ЗначениеИзСтрокиВнутр(ДопПараметрыДокументаСтрока);			
				КонецЕсли;
			ИначеЕсли ТипЗнч(ДопПараметрыДополнения.ДопПараметры) = Тип("Массив") Тогда
				ДопПараметрыДокумента = ДопПараметрыДополнения.ДопПараметры;
			ИначеЕсли ТипЗнч(ДопПараметрыДополнения.ДопПараметры) = Тип("Строка") Тогда
				ДопПараметрыДокумента = ЗначениеИзСтрокиВнутр(ДопПараметрыДополнения.ДопПараметры);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Для каждого ДопПараметрДокумента Из ДопПараметрыДокумента Цикл
		НайденныйДопПараметр = ДопПараметрыОбщийСписок.Получить(ДопПараметрДокумента.Ключ);
		Если Не НайденныйДопПараметр = Неопределено Тогда
			НайденныйДопПараметр.Значение = ДопПараметрДокумента.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ДопПараметрДокумента Из ДопПараметрыОбщийСписок Цикл
		ДопПараметрыРезультат.Добавить(ДопПараметрДокумента);
	КонецЦикла;
	
	Возврат ДопПараметрыРезультат;
	
КонецФункции

// Возвращает структуру параметров, необходимых для получения доп. параметров документа,
// используя метод ДополнительныеПараметрыДокумента()
//
// Параметры:
//   ПрофильКонтрагента - СправочникСсылка.ККСНГ_Контрагенты - Профиль контрагента
//   КодТипаДокумента - Строка - Код типа документа
//   ЭтоДокументУВХД - Булево - Признак использования в бизнес-процессе УВХД
//
// Возвращаемое значение:
//   Структура - Структура параметров для получения доп. параметров документа - Содержит:
//		* ПрофильКонтрагента - СправочникСсылка.ККСНГ_Контрагенты - Профиль контрагента, доп. параметры которого необходимо получить
//		* КодТипаДокумента - Код типа документа в сервисе ЭДО
//		* ЭтоДокументУВХД - Признак использования в бизнес-процессе УВХД для определения необходимости получения доп. параметров
//
Функция СтруктураПолученияДопПараметровДокумента(ДокументСсылка = Неопределено, 
											  	 ПрофильКонтрагента = Неопределено, 
											  	 КодТипаДокумента = Неопределено, 
											  	 Договор = Неопределено) Экспорт
										
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ДокументСсылка", ДокументСсылка);
	СтруктураПараметров.Вставить("ПрофильКонтрагента", ПрофильКонтрагента);
	СтруктураПараметров.Вставить("Договор", Договор);
	СтруктураПараметров.Вставить("КодТипаДокумента", КодТипаДокумента);
		
	Возврат СтруктураПараметров;
	
КонецФункции

// Проверяет заполнение обязательных доп.параметров ЭД
//
// Параметры:
//   ДанныеПроверки - Структура - Данные для проверки заполнения ЭД
//		см. описание СтруктураПолученияДопПараметровДокумента()
//
// Возвращаемое значение:
//   Ответ - Структура - см.описание ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПроверитьЗаполнениеДопПараметровДокумента(ДанныеПроверки, ДокументСсылка = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если Не ТипЗнч(ДанныеПроверки) = Тип("Массив") Тогда
		Возврат Ответ;		
	КонецЕсли;
		
	Для каждого ДанныеДокумента Из ДанныеПроверки Цикл
		
		Если ТипЗнч(ДанныеДокумента) = Тип("КлючИЗначение") Тогда
			ДанныеДопПараметра = ДанныеДокумента.Значение;
		Иначе
			ДанныеДопПараметра = ДанныеДокумента;
		КонецЕсли;
		
		Если ДанныеДопПараметра.ОбязательноЗаполнение И Не ЗначениеЗаполнено(ДанныеДопПараметра.Значение) Тогда
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				ШаблонСообщения = "Не заполнен обязательный доп. параметр ""%1"" документа ""%2""";
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ДанныеДопПараметра.Представление, ДокументСсылка);
			Иначе
				ШаблонСообщения = "Не заполнен обязательный доп. параметр ""%1""";
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ДанныеДопПараметра.Представление);
			КонецЕсли;   
			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьСообщение(Ответ.Журнал, , ТекстСообщения, "-1", "CHP-00001");				
			
		КонецЕсли;
		
		Если ДанныеДопПараметра.Ключ = "document.currency" 
			И НЕ ПустаяСтрока(ДанныеДопПараметра.Значение)
			И НЕ ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЛатиницаВСтроке(ДанныеДопПараметра.Значение) Тогда
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				ШаблонСообщения = "Ошибка заполнения доп. параметра ""%1"" документа ""%2"". Ожидается буквенный код валюты латиницей, согласно классификатору (например, RUB), текущее значение - ""%3"".";
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ДанныеДопПараметра.Представление, ДокументСсылка, ДанныеДопПараметра.Значение);
			Иначе
				ШаблонСообщения = "Ошибка заполнения доп. параметра ""%1"". Ожидается буквенный код валюты латиницей, согласно классификатору (например, RUB), текущее значение - ""%2"".";
				ТекстСообщения = СтрШаблон(ШаблонСообщения, ДанныеДопПараметра.Представление, ДанныеДопПараметра.Значение);
			КонецЕсли;
			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьСообщение(Ответ.Журнал, , ТекстСообщения, "-1", "CHP-00001");
					
		КонецЕсли;
		
	КонецЦикла;
	
	Ответ.Успех = (Ответ.Журнал.Количество() = 0);
	
	Возврат Ответ;
	
КонецФункции

Функция ДополнительныеПараметрыДокумента(ДанныеДокумента, ДопПараметры = Неопределено) Экспорт
	
	ДопПараметрыДокумента = Неопределено;	
	
	// TODO Исправить эту часть, код типа документа должен приходить в корневой структуре
	Если ДанныеДокумента.Свойство("КодТипаДокумента") Тогда
		КодТипаДокумента = ДанныеДокумента.КодТипаДокумента;
	Иначе
		КодТипаДокумента = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ДанныеФормата.КодТипаДокумента");
	КонецЕсли;
	
	СоответствиеДопПараметровТипамДокументов = ПолучитьСписокДополнительныхПараметровДокумента(ДопПараметры);
	ДопПараметрыДокумента = СоответствиеДопПараметровТипамДокументов.Получить(КодТипаДокумента);
	ЗаполнитьЗначенияДопПараметровПоУмолчанию(ДопПараметрыДокумента, ДанныеДокумента, ДопПараметры);
	
	Возврат ДопПараметрыДокумента;
	
КонецФункции

// Возвращает признак принадлежности документа к бизнес-процессу УВХД
//
// Параметры:
//   ДокументСсылка - ДокументСсылка.* - Ссылка на объект основной конфигурации
//
// Возвращаемое значение:
//   Булево - Признак принадлежности документа к бизнес-процессу УВХД
//
Функция ЭтоДокументУВХД(ДокументСсылка) Экспорт
	
	ДанныеДоговора = ПолучитьДанныеДоговораУВХДПоДокументу(ДокументСсылка);
	
	Возврат ТипЗнч(ДанныеДоговора) = Тип("Структура");
	
КонецФункции

Функция ПолучитьДанныеДоговораУВХДПоДокументу(ДокументСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	ДанныеДоговора = МодульККСНГ_ПМ_РаботаСМетаданными.ПолучитьДоговорДокумента(ДокументСсылка);
	
	Возврат ПолучитьДанныеДоговораУВХД(ДанныеДоговора);
	
КонецФункции	

Функция ПолучитьДанныеДоговораУВХД(ДанныеДоговора) Экспорт
	
	Если ККСНГ_ОбщегоНазначенияКлиентСервер.СтруктураПустая(ДанныеДоговора) Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтрагентыДоговорыУВХД.ДоговорУВХД КАК Договор,
	|	ЕСТЬNULL(КонтрагентыДоговорыУВХД.ДоговорУВХД.Id, 0) КАК ИдентификаторДоговора,
	|	ВЫБОР
	|		КОГДА КонтрагентыДоговорыУВХД.ДоговорУВХД = ЗНАЧЕНИЕ(Справочник.ККСНГ_ЭлектронныеДокументы.ПустаяСсылка)
	|			ТОГДА &НомерДоговора1С
	|		ИНАЧЕ КонтрагентыДоговорыУВХД.ДоговорУВХД.Number
	|	КОНЕЦ КАК НомерДоговора,
	|	&ВалютаДоговора КАК ВалютаДоговора
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты.ДоговорыУВХД КАК КонтрагентыДоговорыУВХД
	|ГДЕ
	|	КонтрагентыДоговорыУВХД.Договор1С = &Договор1С";
	
	Запрос.УстановитьПараметр("Договор1С", Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойства(ДанныеДоговора.Договор));
	
	Запрос.УстановитьПараметр("НомерДоговора1С", ДанныеДоговора.Номер);
	Запрос.УстановитьПараметр("ВалютаДоговора", ДанныеДоговора.Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ДанныеДоговора = Новый Структура("Договор, ИдентификаторДоговора, НомерДоговора, ВалютаДоговора");
		ЗаполнитьЗначенияСвойств(ДанныеДоговора, Выборка);
		
		Возврат ДанныеДоговора;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьДанныеФорматаДокумента(ДокументСсылка, ПрофильОрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();	
	
	// Получение данных документа
	ОбщийМодульПолучениеДанных = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПолучениеДанных");
	ЗапросПредставленияЭД = ОбщийМодульПолучениеДанных.ПолучитьПредставлениеЭД(ДокументСсылка);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПредставленияЭД.Журнал);
	
	Если ЗапросПредставленияЭД.Успех Тогда
		
		ДанныеДокумента = ЗапросПредставленияЭД.Результат;
		
		ЗапросНаДополнение = ККСНГ_ОтправкаЭДВызовСервера.ДополнитьДанныеДокументаДаннымиЭДО(ДанныеДокумента, ПрофильОрганизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросНаДополнение.Журнал);
		
		Если ЗапросНаДополнение.Успех Тогда
			
			// Получение данных о формате отправляемого документа
			ЗапросДанныхФормата = ККСНГ_ОтправкаЭДВызовСервера.ПолучитьДанныеФорматаДокументаЭД(ДанныеДокумента);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныхФормата.Журнал);
			
			Если ЗапросДанныхФормата.Успех Тогда
				
				ДанныеФормата = ЗапросДанныхФормата.Результат;
				
				// Обновление кода ЭДО получателя на случай роуминга
				ДанныеДокумента.Вставить("ЭтоРоуминг", Ложь);
				ЗапросКодаЭДО = ККСНГ_ДокументооборотВызовСервера.ПолучитьКодЭДОПолучателя(ДанныеДокумента.ПрофильКонтрагента, 
														ДанныеФормата.КодТипаДокумента, ПрофильОрганизации, ПараметрыАвторизации);
				Если ЗапросКодаЭДО.Успех Тогда
					ДанныеДокумента.Вставить("ЭтоРоуминг", ?(ДанныеДокумента.КодЭДОПолучателя = ЗапросКодаЭДО.Результат, Ложь, Истина));
					ДанныеДокумента.КодЭДОПолучателя = ЗапросКодаЭДО.Результат;
				КонецЕсли;
				
				ДанныеДокумента.Вставить("ДанныеФормата", ДанныеФормата);
				Ответ.Результат = ДанныеДокумента;
				Ответ.Успех = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ПрочитатьДополнительныеРеквизитыДокумента(СвязанныйДокумент) Экспорт
	
	Результат = Неопределено;
	
	МодульМенеджераДопРеквизитыЭД = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("РегистрыСведений.ККСНГ_ПМ_ДопРеквизитыЭД");
	
	НаборЗаписей =  МодульМенеджераДопРеквизитыЭД.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СвязанныйДокумент.Установить(СвязанныйДокумент);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() Тогда
		Результат = НаборЗаписей[0];
	КонецЕсли;
	         
	Возврат Результат; 
	
КонецФункции

Функция ПолучитьБизнесПроцессПоДокументу(ДокументСсылка) Экспорт
	
	БизнесПроцесс = Неопределено;	
	
	Если ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ИспользуетсяБизнесПроцессУВХД() Тогда
		КонтрагентСбер = ККСНГ_РаботаСКонтрагентамиВызовСервера.ЭтоКонтрагентСбер(ДокументСсылка.Контрагент.ИНН);
		ЭтоДокументУВХД = ККСНГ_ЭлектронныеДокументы.ЭтоДокументУВХД(ДокументСсылка);
		Если КонтрагентСбер И ЭтоДокументУВХД Тогда
			БизнесПроцесс = "УВХД";	
		КонецЕсли;
	КонецЕсли;
	
	Возврат БизнесПроцесс;
	
КонецФункции

Функция ПроверитьСтруктуруАдресаУВХД(СтруктураАдреса) Экспорт
	
	Возврат ЗначениеЗаполнено(СтруктураАдреса.Город)
			И ЗначениеЗаполнено(СтруктураАдреса.Индекс)
			И ЗначениеЗаполнено(СтруктураАдреса.Улица);
	
КонецФункции

Функция ПолучитьСписокДопустимыхВалютУВХД() Экспорт
	
	СписокДопустимыхВалютУВХД = Новый СписокЗначений;
	
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	ТаблицаВалют = МодульККСНГ_ПМ_РаботаСМетаданными.ПолучитьТаблицуВалют();
	 
	Для каждого СтрокаВалюты Из ТаблицаВалют Цикл
		Если НЕ ПустаяСтрока(СтрокаВалюты.БуквенныйКод) 
			И ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЛатиницаВСтроке(СтрокаВалюты.БуквенныйКод) Тогда
			СписокДопустимыхВалютУВХД.Добавить(СтрокаВалюты.БуквенныйКод);	
		КонецЕсли;
		
	КонецЦикла;
	
	СписокДопустимыхВалютУВХД.СортироватьПоЗначению();
	
	Возврат СписокДопустимыхВалютУВХД;

КонецФункции	

// Функция - Получить список наименований документа УВХД
//  
//  Возвращает список наименований документов для УВХД
// 
// Возвращаемое значение:
