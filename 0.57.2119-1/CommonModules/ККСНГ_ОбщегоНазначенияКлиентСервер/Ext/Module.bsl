// Получает общий модуль по имени
//
// Параметры:
//  ИмяМодуля          - Строка - Имя модуля
//  ВызыватьИсключение - Булево
//
// Возвращаемое значение:
//	Тип Общий модуль или Неопределено
//
Функция ПолучитьМодульПодсистемы(ИмяМодуля, ВызыватьИсключение = Истина) Экспорт

	Попытка
		МодульПодсистемы = Вычислить(ИмяМодуля);
	Исключение
		МодульПодсистемы = Неопределено;
		Если ВызыватьИсключение Тогда
			ВызватьИсключение "Не найден модуль " + ИмяМодуля + " приложения ""Модуль ЭДО"".";
		КонецЕсли;
	КонецПопытки;

	Возврат МодульПодсистемы;

КонецФункции

// Получает общий модуль по одному из имен
//
// Параметры:
//  ВариантыИменМодуля          - Массив строк - имена модуля
//
// Возвращаемое значение:
//	Тип Общий модуль или Неопределено
//
Функция НайтиМодульПодсистем(ВариантыИменМодуля) Экспорт
		
	ИскомыйМодуль = Неопределено;
	ВариантыИменМодуля = СтрРазделить(ВариантыИменМодуля, ",", Ложь);
	Для каждого ИмяМодуля Из ВариантыИменМодуля Цикл
		ИскомыйМодуль = ПолучитьМодульПодсистемы(СокрЛП(ИмяМодуля), Ложь);
		Если ИскомыйМодуль <> Неопределено Тогда
		    Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ИскомыйМодуль;
	
КонецФункции

