// Заменяет недопустимые символы в XML-строке на заданные символы.
//
// Параметры:
//   Текст        - Строка - строка, в которой требуется выполнить замену недопустимых символов.
//   СимволЗамены - Строка - строка, на которую требуется выполнить замену недопустимого символа в XML-строке.
// 
//  Возвращаемое значение:
//    Строка - строка, полученная заменой недопустимых символов в XML-строке.
//
Функция ЗаменитьНедопустимыеСимволыXML(Знач Текст, СимволЗамены = " ") Экспорт
	
#Если НЕ ВебКлиент Тогда
	ПозицияНачала = 1;
	Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
	Пока Позиция > 0 Цикл
		НедопустимыйСимвол = Сред(Текст, Позиция, 1);
		Текст = СтрЗаменить(Текст, НедопустимыйСимвол, СимволЗамены);
		ПозицияНачала = Позиция + СтрДлина(СимволЗамены);
		Если ПозицияНачала > СтрДлина(Текст) Тогда
			Прервать;
		КонецЕсли;
		Позиция = НайтиНедопустимыеСимволыXML(Текст, ПозицияНачала);
	КонецЦикла;
	
	Возврат Текст;
#Иначе
	// Коды символов от 0 до 2^16-1, которые метод НайтиНедопустимыеСимволыXML
	// считает недопустимыми: 0-8, 11-12, 14-31, 55296-57343.
	Итог = "";
	ДлинаСтроки = СтрДлина(Текст);
	
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		Символ = Сред(Текст, НомерСимвола, 1);
		КодСимвола = КодСимвола(Символ);
		
		Если КодСимвола < 9
		 Или КодСимвола > 10    И КодСимвола < 13
		 Или КодСимвола > 13    И КодСимвола < 32
		 Или КодСимвола > 55295 И КодСимвола < 57344 Тогда
			
			Символ = " ";
		КонецЕсли;
		Итог = Итог + Символ;
	КонецЦикла;
	
	Возврат Итог;
#КонецЕсли
	
КонецФункции

// Определяет физ лицо или нет по ИНН
//
// Параметры:
//   ИНН - Строка - Строка ИНН
// 
//  Возвращаемое значение:
//    Булево
//
Функция ЭтоИННФизЛица(ИНН) Экспорт
	
	Если СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По 12 Цикл
		Если СтрНайти("0123456789", Сред(ИНН, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрНачинаетсяС(ИНН, "00") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет соответствие ИНН требованиям.
//
// Параметры:
//  ИНН                - Строка - проверяемый индивидуальный номер налогоплательщика.
//  ЭтоЮридическоеЛицо - Булево - признак, является ли владелец ИНН юридическим лицом.
//  ТекстСообщения     - Строка - текст сообщения о найденных ошибках.
//
// Возвращаемое значение:
//  Булево - Истина, если соответствует.
//
Функция ИННСоответствуетТребованиям(Знач ИНН, ЭтоЮридическоеЛицо, ТекстСообщения) Экспорт

	СоответствуетТребованиям = Истина;
	ТекстСообщения = "";

	ИНН      = СокрЛП(ИНН);
	ДлинаИНН = СтрДлина(ИНН);

	Если ЭтоЮридическоеЛицо = Неопределено Тогда
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'Не определен тип владельца ИНН.';
												|en = 'TIN owner type is not specified.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЦифрыВСтроке(ИНН) Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'ИНН должен состоять только из цифр.';
												|en = 'TIN contains only digits.'");
	КонецЕсли;

	Если  ЭтоЮридическоеЛицо И ДлинаИНН <> 10 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
			+ НСтр("ru = 'ИНН юридического лица должен состоять из 10 цифр.';
					|en = 'TIN of a business entity must contain 10 digits.'");
	ИначеЕсли НЕ ЭтоЮридическоеЛицо И ДлинаИНН <> 12 Тогда
		СоответствуетТребованиям = Ложь;
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
			+ НСтр("ru = 'ИНН физического лица должен состоять из 12 цифр.';
					|en = 'TIN of an individual must contain 12 digits.'");
	КонецЕсли;

	Если НЕ СоответствуетТребованиям Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если ЭтоЮридическоеЛицо Тогда
		
		Множители = Новый Соответствие;
		Множители.Вставить(1, 2);
		Множители.Вставить(2, 4);
		Множители.Вставить(3, 10);
		Множители.Вставить(4, 3);
		Множители.Вставить(5, 5);
		Множители.Вставить(6, 9);
		Множители.Вставить(7, 4);
		Множители.Вставить(8, 6);
		Множители.Вставить(9, 8);
		КонтрольнаяСумма = 0;
		
		Для Индекс = 1 По 9 Цикл
			Множитель = Множители[Индекс];
			Цифра = Число(Сред(ИНН, Индекс, 1));
			КонтрольнаяСумма = КонтрольнаяСумма + Цифра * Множитель;
		КонецЦикла;
		
		КонтрольныйРазряд = (КонтрольнаяСумма % 11) % 10;
		
		СоответствуетТребованиям = (КонтрольныйРазряд = Число(Сред(ИНН, 10, 1)));
		
	Иначе
		
		Множители = Новый Соответствие;
		Множители.Вставить(1,  Новый Структура("М11, М12", 7,  3));
		Множители.Вставить(2,  Новый Структура("М11, М12", 2,  7));
		Множители.Вставить(3,  Новый Структура("М11, М12", 4,  2));
		Множители.Вставить(4,  Новый Структура("М11, М12", 10, 4));
		Множители.Вставить(5,  Новый Структура("М11, М12", 3, 10));
		Множители.Вставить(6,  Новый Структура("М11, М12", 5,  3));
		Множители.Вставить(7,  Новый Структура("М11, М12", 9,  5));
		Множители.Вставить(8,  Новый Структура("М11, М12", 4,  9));
		Множители.Вставить(9,  Новый Структура("М11, М12", 6,  4));
		Множители.Вставить(10, Новый Структура("М11, М12", 8,  6));
		Множители.Вставить(11, Новый Структура("М11, М12", 0,  8));
		
		КонтрольнаяСумма11 = 0;
		КонтрольнаяСумма12 = 0;
		
		Для Индекс = 1 По 11 Цикл
			Множитель11 = Множители[Индекс].М11;
			Множитель12 = Множители[Индекс].М12;
			Цифра = Число(Сред(ИНН, Индекс, 1));
			КонтрольнаяСумма11 = КонтрольнаяСумма11 + Цифра * Множитель11;
			КонтрольнаяСумма12 = КонтрольнаяСумма12 + Цифра * Множитель12;
		КонецЦикла;
		
		КонтрольныйРазряд11 = (КонтрольнаяСумма11 % 11) % 10;
		КонтрольныйРазряд12 = (КонтрольнаяСумма12 % 11) % 10;
		
		СоответствуетТребованиям = (КонтрольныйРазряд11 = Число(Сред(ИНН, 11, 1)) И КонтрольныйРазряд12 = Число(Сред(ИНН, 12, 1)));
		
	КонецЕсли;
	
	Если Не СоответствуетТребованиям Тогда
		ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
		+ НСтр("ru = 'Контрольное число для ИНН не совпадает с рассчитанным.';
		|en = 'Check digit of TIN does not match the calculated value.'");
	КонецЕсли;
	
	Возврат СоответствуетТребованиям;

КонецФункции

// Формирует текст запроса по всем полям для указанной таблицы
//
// Параметры:
//  ИмяТаблицы                - Строка - Имя таблицы
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекстЗапросаПоТаблице(ИмяТаблицы) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ * ИЗ " + ИмяТаблицы;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Математика

Функция МаксимальноеЗначениеВМассиве(Массив)
	
	// Рассчитываем, что на вход будет получен массив, в котором все элементы либо все положительные, либо отрицательные.
	// Поэтому для определения максимального значения сравниваем абсолютное значение элемента.
	//
	// В случае, если на вход получен массив, в котором элементы с разными знаками, то максимальное значение будет
	// определено не правильно. Но этот случай оставлен для совместимости с предыдущими версиями.
	
	МаксимальноеЗначение = 0;
	Множитель            = 1;
	Для Индекс = 0 По Массив.Количество() - 1 Цикл
		Значение = Массив[Индекс];
		АбсолютноеЗначение = ?(Значение > 0, Значение, -Значение);
		Если МаксимальноеЗначение < АбсолютноеЗначение Тогда
			МаксимальноеЗначение = АбсолютноеЗначение;
			Множитель = ?(Значение > 0, 1, -1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МаксимальноеЗначение * Множитель;
	
КонецФункции

#КонецОбласти

#Область ДинамическиеСписки

Процедура НайтиРекурсивно(КоллекцияЭлементов, МассивЭлементов, СпособПоиска, ЗначениеПоиска)
	
	Для каждого ЭлементОтбора Из КоллекцияЭлементов Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			ДобавитьЭлементПоУсловию(СпособПоиска, ЭлементОтбора, ЗначениеПоиска, МассивЭлементов);
			
		Иначе
			
			НайтиРекурсивно(ЭлементОтбора.Элементы, МассивЭлементов, СпособПоиска, ЗначениеПоиска);
			
			Если СпособПоиска = 2 И ЭлементОтбора.Представление = ЗначениеПоиска Тогда
				МассивЭлементов.Добавить(ЭлементОтбора);
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЭлементПоУсловию(СпособПоиска, ЭлементОтбора, ЗначениеПоиска, МассивЭлементов)

	Если СпособПоиска = 1 Тогда
		Если ЭлементОтбора.ЛевоеЗначение = ЗначениеПоиска Тогда
			МассивЭлементов.Добавить(ЭлементОтбора);
		КонецЕсли;
	ИначеЕсли СпособПоиска = 2 Тогда
		Если ЭлементОтбора.Представление = ЗначениеПоиска Тогда
			МассивЭлементов.Добавить(ЭлементОтбора);
		КонецЕсли;
	Иначе
		Возврат;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти