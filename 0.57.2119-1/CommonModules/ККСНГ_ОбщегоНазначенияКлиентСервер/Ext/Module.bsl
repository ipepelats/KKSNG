
#Область ПрограммныйИнтерфейс

// Возвращает ссылку на общий модуль или модуль менеджера по имени.
//
// См. ОбщегоНазначения.ОбщийМодуль
//
// Параметры:
//  Имя - Строка - имя общего модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль, МодульМенеджераОбъекта - общий модуль.
//
// Пример:
//	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ОбновлениеКонфигурации") Тогда
//		МодульОбновлениеКонфигурации = ОбщегоНазначения.ОбщийМодуль("ОбновлениеКонфигурации");
//		МодульОбновлениеКонфигурации.<Имя метода>();
//	КонецЕсли;
//
//	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолнотекстовыйПоиск") Тогда
//		МодульПолнотекстовыйПоискСервер = ОбщегоНазначения.ОбщийМодуль("ПолнотекстовыйПоискСервер");
//		МодульПолнотекстовыйПоискСервер.<Имя метода>();
//	КонецЕсли;
//
Функция ОбщийМодуль(Имя) Экспорт
	
	Попытка
		Модуль = Вычислить(Имя);
	Исключение
		Модуль = Неопределено;
		ВызватьИсключение "Не найден модуль " + Имя + " подключаемого модуля приложения ""Модуль ЭДО"".";
	КонецПопытки;
	
#Если Не ВебКлиент Тогда
	
	// В веб-клиенте не проверяется
	// т.к. при обращении к модулям с вызовом сервера типа такого модуля в веб-клиенте не существует.
	
	Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
		ВызватьИсключение СтрШаблон("Общий модуль ""%1"" не найден.", Имя);
	КонецЕсли;
	
#КонецЕсли
	
	Возврат Модуль;
	
КонецФункции

// Удаляет указанные файлы, см. УдалитьФайлы()
//
// Параметры:
//  Путь	 - Строка	 - Путь к удаляемым файлам
//  Маска	 - Строка	 - Маска для выбора удаляемых файлов
//
Процедура УдалитьФайлыБезопасно(Путь, Маска = "") Экспорт
	
	Попытка
		УдалитьФайлы(Путь, Маска);
	Исключение
		Возврат
	КонецПопытки;
	
КонецПроцедуры

 // Сравнивает текущую версию приложения с переданной в параметре
//
// Параметры:
//  Версия	 - Строка	 - версия, с которой нужно сравнить текущую версию приложения
// 
// Возвращаемое значение:
//  Число - см. СравнитьВерсии()
//
Функция СравнитьВерсиюПриложения(Версия) Экспорт
	
	Перем СистемнаяИнформация;
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, Версия);
	
КонецФункции

// Приводит переданное значение к числу.
//
// Параметры:
//	ПриводимоеЗначение	- Произвольный - исходное значение
//
// Возвращаемое значение:
//	Произвольный - приведенное значение
//
Функция ПривестиКЧислу(ПриводимоеЗначение) Экспорт
	
	Перем ТипЧисло;
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Возврат ТипЧисло.ПривестиЗначение(ПриводимоеЗначение);
	
КонецФункции

// Структура типового ответа для функций
//
// Параметры:
//  ИмяГруппы - Строка - Группа сообщений журнала
//
// Возвращаемое значение: 
//  Структура:
//		* Результат      - Произвольный - результат выполнения
//		* Успех          - Булево
//		* КодОшибки      - Строка
//		* Журнал         - см. ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений()
//	
Функция ПолучитьСтруктуруОтвета(ИмяГруппы = "") Экспорт

	СтруктураОтвета = Новый Структура;	
	СтруктураОтвета.Вставить("Результат");
	СтруктураОтвета.Вставить("Успех", Ложь);
	СтруктураОтвета.Вставить("КодОшибки");
	СтруктураОтвета.Вставить("Журнал", ККСНГ_ЛогированиеКлиентСервер.СоздатьЖурналСообщений(ИмяГруппы));
	
	Возврат СтруктураОтвета;
	
КонецФункции

// Заполняет КодОшибки в СтруктураОтвета последней ошибкой журнала 
//
// Параметры:
//  СтруктураОтвета - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Процедура ОбновитьСтруктуруОтвета(СтруктураОтвета) Экспорт 
	ПоследняяОшибка = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(СтруктураОтвета.Журнал);
	Если ЗначениеЗаполнено(ПоследняяОшибка) Тогда
		СтруктураОтвета.КодОшибки = ПоследняяОшибка.КодОшибки;	
	Иначе
		СтруктураОтвета.КодОшибки = "";	
	КонецЕсли;	
	
КонецПроцедуры	

// Формирует и выводит сообщение, которое может быть связано с элементом 
// управления формы.
//
// Параметры:
//  ТекстСообщенияПользователю - Строка - текст сообщения.
//  КлючДанных                 - ЛюбаяСсылка - объект или ключ записи информационной базы, к которому это сообщение относится.
//  Поле                       - Строка - наименование реквизита формы.
//  ПутьКДанным                - Строка - путь к данным (путь к реквизиту формы).
//  Отказ                      - Булево - выходной параметр, всегда устанавливается в значение Истина.
//
// Пример:
//
//  1. Для вывода сообщения у поля управляемой формы, связанного с реквизитом объекта:
//  ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "ПолеВРеквизитеФормыОбъект",
//   "Объект");
//
//  Альтернативный вариант использования в форме объекта:
//  ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "Объект.ПолеВРеквизитеФормыОбъект");
//
//  2. Для вывода сообщения рядом с полем управляемой формы, связанным с реквизитом формы:
//  ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ,
//   "ИмяРеквизитаФормы");
//
//  3. Для вывода сообщения связанного с объектом информационной базы:
//  ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), ОбъектИнформационнойБазы, "Ответственный",,Отказ);
//
//  4. Для вывода сообщения по ссылке на объект информационной базы:
//  ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
//   НСтр("ru = 'Сообщение об ошибке.'"), Ссылка, , , Отказ);
//
//  Случаи некорректного использования:
//   1. Передача одновременно параметров КлючДанных и ПутьКДанным.
//   2. Передача в параметре КлючДанных значения типа отличного от допустимых.
//   3. Установка ссылки без установки поля (и/или пути к данным).
//
Процедура СообщитьПользователю(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных = Неопределено,
		Знач Поле = "",
		Знач ПутьКДанным = "",
		Отказ = Ложь) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	ЭтоОбъект = Ложь;
	
#Если НЕ ТонкийКлиент И НЕ ВебКлиент И НЕ МобильныйКлиент Тогда
	Если КлючДанных <> Неопределено
	   И XMLТипЗнч(КлючДанных) <> Неопределено Тогда
		ТипЗначенияСтрокой = XMLТипЗнч(КлючДанных).ИмяТипа;
		ЭтоОбъект = СтрНайти(ТипЗначенияСтрокой, "Object.") > 0;
	КонецЕсли;
#КонецЕсли
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
		
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры

// Проверяет наличие реквизита или свойства у произвольного объекта без обращения к метаданным.
//
// Параметры:
//  Объект       - Произвольный - объект, у которого нужно проверить наличие реквизита или свойства;
//  ИмяРеквизита - Строка       - имя реквизита или свойства.
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КлючУникальности   = Новый УникальныйИдентификатор;
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
	
	Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
	
КонецФункции

#Область РаботаСформулами

// Возвращает открывающийся разделитель операнда формулы.
//
// Параметры:
//  Формула - Строка - формула, для которой нужно получить разделитель.
//
// Возвращаемое значение: 
//  Строка  - содержит открывающийся разделитель операнда формулы.
//
Функция ОткрывающийсяРазделитель(Формула) Экспорт

	Если СтрНайти(Формула, "{") Тогда
		Возврат "{";
	Иначе 
		Возврат "[";
	КонецЕсли;
	
КонецФункции

// Возвращает закрывающийся разделитель операнда формулы.
//
// Параметры:
//  Формула - Строка - формула, для которой нужно получить разделитель.
//
// Возвращаемое значение: 
//  Строка  - содержит закрывающийся разделитель операнда формулы.
//
Функция ЗакрывающийсяРазделитель(Формула) Экспорт

	Если СтрНайти(Формула, "}") Тогда
		Возврат "}";
	Иначе 
		Возврат "]";
	КонецЕсли;
	
КонецФункции

// Возвращает шаблон операнда формулы с разделителями.
//
// Параметры:
//  Формула - Строка - формула, для которой нужно получить шаблон операнда.
//
// Возвращаемое значение: 
//  Строка  - содержит шаблон операнда формулы с разделителями.
//
Функция ШаблонОперанда(Формула) Экспорт

	Если ОткрывающийсяРазделитель(Формула) = "{" Тогда
		Возврат "{%1}";
	Иначе 
		Возврат "[%1]";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ВерсионированиеКонфигураций

// Приводит строку с номером конфигурации к виду, пригодному для сравнения
//
// Параметры:
//  Версия	 - Строка	 - Исходная строка с номером версии конфигурации
// 
// Возвращаемое значение:
//  Строка - результат
//
Функция ВерсияКонфигурацииСтрокой(Версия) Экспорт
	
	Рез = "";
	Если НЕ ПустаяСтрока(Версия) Тогда
		// Убираем "лишнюю" версию для решений БИТ с версионированием в формате НомерКонфигурации/НомерРешения.
		ПозицияСимвола = СтрНайти(Версия, "/");
		ВременнаяСтрока = Лев(Версия, ?(ПозицияСимвола > 0, ПозицияСимвола - 1, СтрДлина(Версия)));
		
		ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
		ВременнаяСтрока = СтрЗаменить(ВременнаяСтрока,".",Символы.ПС);
		Для Инд = 1 По СтрЧислоСтрок(ВременнаяСтрока) Цикл
			Разряд = СокрЛП(СтрПолучитьСтроку(ВременнаяСтрока, Инд));
			РазрядЧислом = ОписаниеТипаЧисло.ПривестиЗначение(Разряд);
			Если РазрядЧислом <> 0
				Или (Не ПустаяСтрока(Разряд) И ПустаяСтрока(СтрЗаменить(Разряд, "0", ""))) Тогда
					Разряд = РазрядЧислом;
			КонецЕсли;
			Рез = Рез + Формат(Разряд,"ЧЦ=10; ЧН=0000000000; ЧВН=; ЧГ=0");
		КонецЦикла;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Сравнить две строки версий.
//
// Параметры:
//  СтрокаВерсии1  - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС.
//  СтрокаВерсии2  - Строка - второй сравниваемый номер версии.
//
// Возвращаемое значение:
//   Число   - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2) Экспорт
	
	Строка1 = ВерсияКонфигурацииСтрокой(СтрокаВерсии1);
	Строка2 = ВерсияКонфигурацииСтрокой(СтрокаВерсии2);
	
	Возврат СтрСравнить(Строка1, Строка2);
	
КонецФункции

// Сравнивает версии подсистем
Функция СравнитьВерсииПодсистемы(ИдентификаторПодсистемы, ВерсияСравнения) Экспорт
	
	Перем ВерсияПодсистемы;
	
	ВерсияПодсистемы = ККСНГ_ОбщегоНазначенияВызовСервера.ПолучитьВерсиюПодсистемы(ИдентификаторПодсистемы);
	Возврат СравнитьВерсии(ВерсияПодсистемы, ВерсияСравнения);
	
КонецФункции

