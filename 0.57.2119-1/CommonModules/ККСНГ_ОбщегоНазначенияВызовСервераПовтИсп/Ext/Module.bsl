#Область ФорматыЭД

// Получает таблицу описания форматов ЭД
//
// Параметры:
//  нет
//
// Возвращаемое значение:
//	Таблица значений
//   * ВерсияФормата           - Строка
//   * Документ                - Строка
//   * Идентификатор           - Строка
//   * Использование           - Булево
//   * КодТипаДокумента        - Строка
//   * НаименованиеВарианта    - Строка
//   * ПриказОВведенииФормата  - Строка
//   * ПространствоИмен        - Строка
//   * ТребуетсяПодпись        - Булево
//   * ФункцияУПД              - Строка
//
Функция ПолучитьФорматыЭлектронныхДокументов() Экспорт
	
	Перем Макет, ТаблицаФорматов, СтрокаФорматов;
	Перем ТекущаяДата, СтрокиКУдалению;
	
	Макет = ПолучитьОбщийМакет("ККСНГ_ФорматыЭлектронныхДокументов");
	ТаблицаФорматов = ПолучитьТаблицуЗначенийИзМакета(Макет);
	
	Если Не УстаревшиеФорматыЭлектронныхДокументовРазрешены() Тогда
		
		ТекущаяДата = ТекущаяДатаСеанса();
		СтрокиКУдалению = Новый Массив;
		
		Для каждого СтрокаФорматов Из ТаблицаФорматов Цикл
			Если ЗначениеЗаполнено(СтрокаФорматов.ДействуетДо) И ТекущаяДата > КонецДня(СтрокаФорматов.ДействуетДо) Тогда
				СтрокиКУдалению.Добавить(СтрокаФорматов);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаФорматов Из СтрокиКУдалению Цикл
			ТаблицаФорматов.Удалить(СтрокаФорматов);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаФорматов;
	
КонецФункции

// Возвращает наименования вариантов настройки документооборота.
// Сведения задаются в макете ОбщиеМакеты.ККСНГ_ФорматыЭлектронныхДокументов.
// 
// Параметры:
//  ИдентификаторыФорматов - Строка - Идентификаторы искомых форматов через запятую, например, "УКД_501, УКД_502".
//		Если параметр указан, то возвращаются только варианты настройки, содержащие переданные форматы.
//
// Возвращаемое значение:
//  Массив - наименования вариантов настройки документооборота.
//
Функция ПолучитьВариантыФорматовЭлектронныхДокументов(ИдентификаторыФорматов = "") Экспорт
	
	ТаблицаФорматов = ПолучитьФорматыЭлектронныхДокументов();
	
	Если ЗначениеЗаполнено(ИдентификаторыФорматов) Тогда
		МассивИдентификаторов = СтрРазделить(ИдентификаторыФорматов, ",", Ложь);
		ТаблицаВариантов = Неопределено;
		Для Каждого ТекИдентификатор Из МассивИдентификаторов Цикл
			ТекИдентификатор = СокрЛП(ТекИдентификатор);
			ОтборПоФормату = Новый Структура;
			ОтборПоФормату.Вставить("Идентификатор", ТекИдентификатор);
			ТекТаблицаВариантов = ТаблицаФорматов.Скопировать(ОтборПоФормату, "НаименованиеВарианта");
			Если ТаблицаВариантов = Неопределено Тогда
				ТаблицаВариантов = ТекТаблицаВариантов;
			Иначе
				ККСНГ_ОбщегоНазначенияВызовСервера.ДополнитьТаблицу(ТекТаблицаВариантов, ТаблицаВариантов);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ТаблицаВариантов = ТаблицаФорматов.Скопировать(, "НаименованиеВарианта");
	КонецЕсли;
	ТаблицаВариантов.Свернуть("НаименованиеВарианта");
		
	Возврат ТаблицаВариантов.ВыгрузитьКолонку("НаименованиеВарианта");
	
КонецФункции

// Подбирает формат электронного документа из доступных на основе переданного
//
// Параметры:
//  НаименованиеВарианта - Строка	 - сиходный вариант настройки формата
// 
// Возвращаемое значение:
//  Строка - подобранный вариант
//
Функция ПолучитьДоступныйФорматЭлектронногоДокумента(НаименованиеВарианта) Экспорт
	
	Перем Результат;
	
	Результат = НаименованиеВарианта;
	
	ВариантыФорматов = ПолучитьВариантыФорматовЭлектронныхДокументов();
	Если ВариантыФорматов.Найти(НаименованиеВарианта) = Неопределено Тогда
		Для каждого ВариантФормата Из ВариантыФорматов Цикл
			
			Если Результат = НаименованиеВарианта Тогда
				Результат = ВариантФормата; // первый из доступных по-умолчанию
			КонецЕсли;
			
			Если СтрНайти(НаименованиеВарианта, "для каждого документа") > 0 И СтрНайти(ВариантФормата, "для каждого документа") > 0 Тогда
				Результат = ВариантФормата;
				Прервать;
			КонецЕсли;
			
			Если СтрНайти(НаименованиеВарианта, "для комплекта") > 0 И СтрНайти(ВариантФормата, "для комплекта") > 0 Тогда
				Результат = ВариантФормата;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с настройками формата ЭД.
// 
// Возвращаемое значение:
//  Структура - состав указан в макете ККСНГ_ФорматыЭлектронныхДокументов.
//
Функция ПолучитьФорматЭлектронногоДокумента(НаименованиеВарианта, Документ, Использование = Истина) Экспорт
	
	Перем Результат, ТаблицаФорматов, ВариантФормата;
	Перем Отбор, НайденныеСтроки, НайденнаяСтрока, ИмяКолонки;
	
	Результат = Неопределено;
	
	ВариантФормата = ПолучитьДоступныйФорматЭлектронногоДокумента(НаименованиеВарианта);
	ТаблицаФорматов = ПолучитьФорматыЭлектронныхДокументов();
	
	Отбор = Новый Структура();
	Отбор.Вставить("НаименованиеВарианта", ВариантФормата);
	Отбор.Вставить("Документ", Документ);
	Отбор.Вставить("Использование", Использование);
	НайденныеСтроки = ТаблицаФорматов.НайтиСтроки(Отбор);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Результат = Новый Структура;
		Для Каждого Колонка Из ТаблицаФорматов.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Результат.Вставить(ИмяКолонки, НайденнаяСтрока[ИмяКолонки]);
		КонецЦикла;
		
		Прервать;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует таблицу значений из мактета.
// Сведения задаются в макете ККСНГ_ФорматыЭлектронныхДокументов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - состав и типы колонок указаны в макете ККСНГ_ФорматыЭлектронныхДокументов.
//
Функция ПолучитьТаблицуЗначенийИзМакета(Макет) Экспорт

	Результат = Новый ТаблицаЗначений;
	
	ОбрабатываемыеСсылочныеТипы = Новый Массив;
	//ОбрабатываемыеСсылочныеТипы.Добавить("Перечисления");
	//ОбрабатываемыеСсылочныеТипы.Добавить("ПланыВидовХарактеристик");
	//ОбрабатываемыеСсылочныеТипы.Добавить("Справочники");
	
	// Получим колонки таблицы форматов
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	Для Сч = 1 По ОбластьШапки.ШиринаТаблицы Цикл
		ИмяКолонки = ОбластьШапки.Область(1, Сч).Текст;
		Если ЗначениеЗаполнено(ИмяКолонки) Тогда
			ПредставлениеТипаКолонки = ОбластьШапки.Область(2, Сч).Текст;
			ТипКолонки = Новый ОписаниеТипов(ПредставлениеТипаКолонки);
			
			Результат.Колонки.Добавить(ИмяКолонки, ТипКолонки);
		КонецЕсли;
	КонецЦикла;
	
	// Заполним строки
	ОбластьСтрок = Макет.ПолучитьОбласть("Строки");
	Для НомерСтроки = 1 По ОбластьСтрок.ВысотаТаблицы Цикл
		Если ЗначениеЗаполнено(ОбластьСтрок.Область(НомерСтроки, 1).Текст) Тогда
			НоваяСтрока = Результат.Добавить();
			
			Для НомерКолонки = 1 По Результат.Колонки.Количество() Цикл
				Колонка = Результат.Колонки[НомерКолонки - 1];
				
				ТекстЯчейки = СокрЛП(ОбластьСтрок.Область(НомерСтроки, НомерКолонки).Текст);
				ТипЗначения = Колонка.ТипЗначения.Типы()[0];
				
				ПолноеИмяОбъекта = "";
				ЗначениеЯчейкиОтвет = ЗначениеЯчейки(ТипЗначения, ТекстЯчейки, ОбрабатываемыеСсылочныеТипы, Колонка, ПолноеИмяОбъекта);
				Если НЕ ЗначениеЯчейкиОтвет.Успех Тогда
					ШаблонОшибки = НСтр("ru='В макете %1 использован неподдерживаемый ссылочный тип (%2)'");
					СтрокаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибки, 
					Метаданные.ОбщиеМакеты.ККСНГ_ФорматыЭлектронныхДокументов.Синоним, ПолноеИмяОбъекта);
					ВызватьИсключение СтрокаОшибки;					
				КонецЕсли;
				
				НоваяСтрока[Колонка.Имя] = ЗначениеЯчейкиОтвет.Результат;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;       
	
	Возврат Результат;

КонецФункции

