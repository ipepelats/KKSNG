// Получает строковые значения идентификаторов указанного перечисления
//
// Параметры:
//  ИмяПеречисления	 - Строка	 - имя перечисления, для которого надо получить список идентификаторов
// 
// Возвращаемое значение:
//  Соответствие - список идентификаторов перечисления: ключ - ПеречисленияСсылка, значение - строковое имя
//
Функция ПолучитьЗначенияПеречисления(ИмяПеречисления) Экспорт
	
	Перем Результат, МетаданныеПеречисления;
	
	Результат = Новый Соответствие;
	
	МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если Перечисления <> Неопределено Тогда
		Для каждого ЗначениеПеречисления Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
			Результат.Вставить(Перечисления[ИмяПеречисления][ЗначениеПеречисления.Имя], ЗначениеПеречисления.Имя);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

