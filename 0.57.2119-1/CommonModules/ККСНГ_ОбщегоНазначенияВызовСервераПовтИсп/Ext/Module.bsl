// Возвращает структуру текущего сеанса ИБ
//
// Возвращаемое значение: 
//	Результат - Структура - содержит следующие поля:
//		* ИмяКомпьютера - Строка
//		* ИмяПриложения - Строка
//		* НачалоСеанса - Число
//		* НомерСеанса  - Число
//		* НомерСоединения - Число
//	    * Пользователь - Строка (Пользователь.Имя текущего сеанса)
//
// Пример:
//	СтруктураСеанса = ПолучитьСтруктуруТекущегоСеансаИнформационнойБазы();
//
Функция ПолучитьСтруктуруТекущегоСеансаИнформационнойБазы() Экспорт
	
   Результат = Новый Структура("ИмяКомпьютера,ИмяПриложения,НачалоСеанса,НомерСеанса,НомерСоединения,Пользователь");
   ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы();
   
   ЗаполнитьЗначенияСвойств(Результат, ТекущийСеанс, , "Пользователь");
   
   Если Не ТекущийСеанс = Неопределено Тогда
	   Результат.Пользователь = ТекущийСеанс.Пользователь.Имя;
   КонецЕсли; 
   
   Возврат Результат;
   
КонецФункции // ПолучитьТекущегоПользователяИБ

// Проверяет наличие объекта в конфигурации по наименованию
//
// Параметры:
//  Класс     - Строка - Тип объекта
//  Название  - Строка - Наименование объекта
//
// Возвращаемое значение:
//	Булево
//
Функция ОбъектМетаданныхЕстьВКонфигурации(Класс, Название) Экспорт
	
	Если Метаданные.НайтиПоПолномуИмени(Класс + "." + Название) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

