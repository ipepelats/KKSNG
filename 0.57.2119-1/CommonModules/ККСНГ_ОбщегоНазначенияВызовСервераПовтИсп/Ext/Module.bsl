КонецФункции // ПолучитьТекущегоПользователяИБ

// Возвращает информацию о используемой конфигурации
//
// Параметры:
//  нет
//
// Возвращаемое значение: 
//  Результат - Структура("Имя,Синоним,Версия")
//
Функция ОпределениеКонфигурации() Экспорт
	
	Результат = Новый Структура("Имя,Синоним,Версия");
	ЗаполнитьЗначенияСвойств(Результат, Метаданные);
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование основного модуля расширения
//
// Параметры:
//  нет
//
// Возвращаемое значение:
//	Строка
//
Функция НаименованиеВерсииМодуля() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Расширения = РасширенияКонфигурации.Получить();
	Для каждого Расширение Из Расширения Цикл
		Если Расширение.Имя = "ККСНГ_Курьер" Тогда
			Возврат "Модуль ЭДО " + Расширение.Версия;	
		КонецЕсли;	
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат "";

КонецФункции

