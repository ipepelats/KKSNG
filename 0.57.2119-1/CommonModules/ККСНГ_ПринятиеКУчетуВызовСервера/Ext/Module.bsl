	СтруктураДокумента.Вставить("НоменклатураКор", ТаблицаНоменклатурыКор);
	
	Возврат СтруктураДокумента;
	
КонецФункции

// Получает контрагента по коду ЭДО профиля либо по ИНН / КПП
//
// Параметры:
//	КодЭдо   - Строка
//	ИНН      - Строка
//	КПП      - Строка
//
// Возвращаемое значение:
//	Справочники.Контрагенты
//
Функция НайтиКонтрагента(КодЭдо = "", ИНН = "", КПП = "") Экспорт
	
	Перем КонтрагентСсылка, ПрофильЭДОКонтрагента;
	Перем ТекстЗапроса, Запрос, Выборка;
	
	Если ЗначениеЗаполнено(КодЭдо) Тогда
		ПрофильЭДОКонтрагента = Справочники.ККСНГ_Контрагенты.НайтиПоРеквизиту("КодУчастникаЭДО", КодЭДО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПрофильЭДОКонтрагента) Тогда
		КонтрагентСсылка = ПрофильЭДОКонтрагента.Контрагент;
	Иначе
		КонтрагентСсылка = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Если КонтрагентСсылка.Пустая() И Не ПустаяСтрока(ИНН) Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.ПометкаУдаления";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			КонтрагентСсылка = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КонтрагентСсылка;
	
КонецФункции

// Получает договор по профилю организации с контрагентом
//
// Параметры:         
//	Организация      - ККСНГ_Организации
//	Контрагент       - ККСНГ_Контрагенты
//
// Возвращаемое значение:
//	Справочники.ДоговорыКонтрагентов
//
Функция НайтиДоговорКонтрагента(Организация, Контрагент) Экспорт
	
	ПрофильЭДООрганизации = Справочники.ККСНГ_Организации.НайтиПоРеквизиту("Организация", Организация);
	
	Если ЗначениеЗаполнено(ПрофильЭДООрганизации)Тогда
		
		ПрофильЭДОКонтрагента = Справочники.ККСНГ_Контрагенты.НайтиПоРеквизиту("Контрагент", Контрагент, , ПрофильЭДООрганизации);
		
		Если ЗначениеЗаполнено(ПрофильЭДОКонтрагента) 
			И ЗначениеЗаполнено(ПрофильЭДОКонтрагента.Договор) Тогда
							
			Возврат Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ПрофильЭДОКонтрагента, "Договор");
				
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат Неопределено;
	
КонецФункции

// Получает склад по профилю организации с контрагентом
//
// Параметры:         
//	Организация      - ККСНГ_Организации
//	Контрагент       - ККСНГ_Контрагенты
//
// Возвращаемое значение:
//	Справочники.Склады
//
Функция НайтиСкладКонтрагента(Организация, Контрагент) Экспорт
	
	ПрофильЭДООрганизации = Справочники.ККСНГ_Организации.НайтиПоРеквизиту("Организация", Организация);
	
	Если ЗначениеЗаполнено(ПрофильЭДООрганизации)Тогда
		
		ПрофильЭДОКонтрагента = Справочники.ККСНГ_Контрагенты.НайтиПоРеквизиту("Контрагент", Контрагент, , ПрофильЭДООрганизации);
		Если ЗначениеЗаполнено(ПрофильЭДОКонтрагента) Тогда
			Если ЗначениеЗаполнено(ПрофильЭДОКонтрагента.Склад) Тогда
				Возврат Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ПрофильЭДОКонтрагента, "Склад");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПрофильЭДООрганизации.Склад) Тогда
			Возврат Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ПрофильЭДООрганизации, "Склад");
		КонецЕсли;
			
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

// Получает номенклатуру по наименоваю/полному наименованию либо артикулу
//
// Параметры:         
//	Наименование  - Строка
//	Артикул       - Строка
//
// Возвращаемое значение:
//	СписокЗначений
//
Функция НайтиНоменклатуру(Код = "", Артикул = "", Наименование = "") Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Артикул КАК Артикул,
	|	ВЫБОР
	|		КОГДА Номенклатура.НаименованиеПолное = &Наименование
	|			ТОГДА 1000
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА Номенклатура.Наименование = &Наименование
	|			ТОГДА 100
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА Номенклатура.Код = &Код
	|			ТОГДА 10
	|		ИНАЧЕ 0
	|	КОНЕЦ + ВЫБОР
	|		КОГДА Номенклатура.Артикул = &Артикул
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	((Номенклатура.НаименованиеПолное = &Наименование
	|				ИЛИ Номенклатура.Наименование = &Наименование)
	|				И &Наименование <> """"
	|			ИЛИ Номенклатура.Артикул = &Артикул
	|				И &Артикул <> """"
	|			ИЛИ Номенклатура.Код = &Код
	|				И &Код <> """") 
	|	И НЕ Номенклатура.ЭтоГруппа 
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Код", СокрЛП(Код));
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Артикул));
	
	СписокЗначений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокЗначений;
	
КонецФункции

// Получает профиль рганизации по коду ЭДО
//
// Параметры:
//	КодЭдо   - Строка
//
// Возвращаемое значение:
//	Справочники.ККСНГ_Организации
//
Функция НайтиОрганизациюПоКодуЭДО(КодЭДО) Экспорт
	
	ОрганизацияСсылка = Справочники.ККСНГ_Организации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(КодЭДО) Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ККСНГ_Организации.Организация КАК Организация
		|ИЗ
		|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
		|ГДЕ
		|	ККСНГ_Организации.КодУчастникаЭДО = &КодУчастникаЭДО
		|	И НЕ ПометкаУдаления";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("КодУчастникаЭДО", КодЭДО);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОрганизацияСсылка = Выборка.Организация;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОрганизацияСсылка;
	
КонецФункции

// Поиск профиля ЭДО контрагента по его идентификатору. Если профиль не найден - осуществляется поиск контрагента по его регистрационным данным.
//
// Параметры:
//  ИдентификаторЭДО			 - Строка	 - идентификатор ЭДО контрагента
//  ТипСведений					 - Строка	 - наименования типа сведений из формата ФНС.
//  ИдентификационныеСведения	 - Структура - аттрибуты идентификационных сведений в формате ФНС 
// 
// Возвращаемое значение:
//  Структура - в полях структуры возвращается результат поиска или Неопределено. Поля структуры:
//	- ПрофильЭДО - СправочникСсылка.ККСНГ_Контрагенты
//	- Контрагент - СправочникСсылка.Контрагенты
Функция НайтиДанныеКонтрагента(ИдентификаторЭДО, ТипСведений, ИдентификационныеСведения) Экспорт
		
	ПрофильЭДОКонтрагента = Справочники.ККСНГ_Контрагенты.НайтиПоРеквизиту("КодУчастникаЭДО", ИдентификаторЭДО);
	Если ПрофильЭДОКонтрагента.Пустая() Тогда
		ПрофильЭДОКонтрагента = Неопределено;
		КонтрагентСсылка = ПолучитьКонтрагентаПоИдентификационнымСведениям(ИдентификационныеСведения, ТипСведений);
	Иначе
		КонтрагентСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрофильЭДОКонтрагента, "Контрагент");
	КонецЕсли; 
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ПрофильЭДО", ПрофильЭДОКонтрагента);
	СтруктураВозврата.Вставить("Контрагент", КонтрагентСсылка);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Возвращает склад учета для указанных профилей ЭДО. Склад, настроенный для профиля контрагента, имеет приоритет над складом, настроенным для организации.
// Варианты параметров:  
//	- профиль ЭДО контрагента
//	- код контрагента + профиль ЭДО организации/код организации
//
// Параметры:
//  ПрофильЭДООрганизации	 - СправочникСсылка.ККСНГ_Организации, Строка *Необязательный  - профиль ЭДО или код участника 
//  ПрофильЭДОКонтрагента	 - СправочникСсылка.ККСНГ_Контрагенты, Строка	 - профиль ЭДО или код участника
//
// Возвращаемое значение:
//  СправочникСсылка.Склады, Неопределено - склад из настроек профилей ЭДО или Неопределено если склад в настройках не заполнен
//
Функция СкладКонтрагента(ПрофильЭДООрганизации = Неопределено, ПрофильЭДОКонтрагента) Экспорт
	
	Склад = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_Контрагенты.Склад КАК СкладКонтрагента,
	|	ККСНГ_Организации.Склад КАК СкладПоУмолчанию
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|		ПО ККСНГ_Контрагенты.Владелец = ККСНГ_Организации.Ссылка
	|ГДЕ
	|	&УсловиеПрофильОрганизации
	|	И &УсловиеПрофильКонтрагента";
	
	ТипЗнчПрофильКонтрагента = ТипЗнч(ПрофильЭДОКонтрагента);
	Если ТипЗнчПрофильКонтрагента = Тип("СправочникСсылка.ККСНГ_Контрагенты") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильКонтрагента", "ККСНГ_Контрагенты.Ссылка = &ПрофильЭДОКонтрагента");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильКонтрагента", "ККСНГ_Контрагенты.КодУчастникаЭДО = &ПрофильЭДОКонтрагента");
		ТипЗнчПрофильОрганизации = ТипЗнч(ПрофильЭДООрганизации);
		Если ТипЗнчПрофильОрганизации = Тип("СправочникСсылка.ККСНГ_Организации") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ККСНГ_Организации.Ссылка = &ПрофильЭДООрганизации");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ККСНГ_Организации.КодУчастникаЭДО = &ПрофильЭДООрганизации");
		КонецЕсли;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	Запрос.УстановитьПараметр("ПрофильЭДОКонтрагента", ПрофильЭДОКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.СкладКонтрагента) Тогда
			Склад = Выборка.СкладКонтрагента;
		ИначеЕсли ЗначениеЗаполнено(Выборка.СкладПоУмолчанию) Тогда
			Склад = Выборка.СкладПоУмолчанию;
		КонецЕсли; 	
	КонецЕсли; 
	
	Возврат Склад;
		
КонецФункции

// Возвращает договор контрагента для указанных профилей ЭДО.
// Варианты параметров:  
//	- профиль ЭДО контрагента
//	- код контрагента + профиль ЭДО организации/код организации
//
// Параметры:
//  ПрофильЭДООрганизации	 - СправочникСсылка.ККСНГ_Организации, Строка	 - профиль ЭДО или код участника
//  ПрофильЭДОКонтрагента	 - СправочникСсылка.ККСНГ_Контрагенты, Строка	 - профиль ЭДО или код участника
// 
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов, Неопределено - договор контрагента из настроек профилей ЭДО или Неопределено если договор в настройках не заполнен
//
Функция ДоговорКонтрагента(ПрофильЭДООрганизации = Неопределено, ПрофильЭДОКонтрагента) Экспорт
	
	Договор = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_Контрагенты.Договор КАК Договор
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|		ПО ККСНГ_Контрагенты.Владелец = ККСНГ_Организации.Ссылка
	|ГДЕ
	|	&УсловиеПрофильОрганизации
	|	И &УсловиеПрофильКонтрагента";
	
	ТипЗнчПрофильКонтрагента = ТипЗнч(ПрофильЭДОКонтрагента);
	Если ТипЗнчПрофильКонтрагента = Тип("СправочникСсылка.ККСНГ_Контрагенты") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильКонтрагента", "ККСНГ_Контрагенты.Ссылка = &ПрофильЭДОКонтрагента");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильКонтрагента", "ККСНГ_Контрагенты.КодУчастникаЭДО = &ПрофильЭДОКонтрагента");
		ТипЗнчПрофильОрганизации = ТипЗнч(ПрофильЭДООрганизации);
		Если ТипЗнчПрофильОрганизации = Тип("СправочникСсылка.ККСНГ_Организации") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ККСНГ_Организации.Ссылка = &ПрофильЭДООрганизации");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрофильОрганизации", "ККСНГ_Организации.КодУчастникаЭДО = &ПрофильЭДООрганизации");
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	Запрос.УстановитьПараметр("ПрофильЭДОКонтрагента", ПрофильЭДОКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Договор) Тогда
			Договор = Выборка.Договор;
		КонецЕсли;		
	КонецЕсли; 
	
	Возврат Договор;
	
КонецФункции

