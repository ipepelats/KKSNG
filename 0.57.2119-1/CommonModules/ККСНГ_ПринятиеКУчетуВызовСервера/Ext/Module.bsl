// Дополняет данные оснований СЧФ транспортными накладными.
//
// Параметры:
//	ДанныеОснованийСЧФ - ТаблицаЗначений
//   * НомерОснСЧФ    - Строка - номер основания СЧФ;
//   * ДатаОснСЧФ     - Дата - дата основания СЧФ.
//	ТранспортныеНакладные - ТаблицаЗначений
//   * НомТранНакл    - Строка - номер транспортной накладной;
//   * ДатаТранНакл   - Дата - дата транспортной накладной.
//
Процедура ДополнитьОснованияСЧФТранспортнымиНакладными(ДанныеОснованийСЧФ, ТранспортныеНакладные)
		
	Если ТранспортныеНакладные.Количество() Тогда
		Для каждого ТекТранНакл Из ТранспортныеНакладные Цикл
			СтрокаТекТранНакл = ДанныеОснованийСЧФ.Добавить();
			СтрокаТекТранНакл.НомерОснСЧФ = ТекТранНакл.НомТранНакл;
			СтрокаТекТранНакл.ДатаОснСЧФ = ТекТранНакл.ДатаТранНакл;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

// Дополняет данные оснований СЧФ сведениями о платёжно-расчетных документах.
//
// Параметры:
//	ДанныеОснованийСЧФ - ТаблицаЗначений
//   * НомерОснСЧФ    - Строка - номер основания СЧФ;
//   * ДатаОснСЧФ     - Дата - дата основания СЧФ.
//	СведениямиПРД - ТаблицаЗначений
//   * НомерПРД    - Строка - номер платёжно-расчетного документа;
//   * ДатаПРД     - Дата - дата платёжно-расчетного документа;
//   * СуммаПРД    - Число - сумма платёжно-расчетного документа.
//
Процедура ДополнитьОснованияСЧФСведениямиПРД(ДанныеОснованийСЧФ, СведениямиПРД)
		
	Если СведениямиПРД.Количество() Тогда
		Для каждого ТекСвПРД Из СведениямиПРД Цикл
			СтрокаТекПРД = ДанныеОснованийСЧФ.Добавить();
			СтрокаТекПРД.НомерОснСЧФ = ТекСвПРД.НомерПРД;
			СтрокаТекПРД.ДатаОснСЧФ = ТекСвПРД.ДатаПРД;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьКонтрагентаПоИдентификационнымСведениям(ИдентификационныеСведения, ТипСведений)
	
	КонтрагентСсылка = Неопределено;
	
	Если ТипСведений = "СвИП" Тогда
		
		ИННФЛ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИдентификационныеСведения, "ИННФЛ", "");
		
		// поиск ИП
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИННФЛ
		|	И Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)";
		Запрос.УстановитьПараметр("ИННФЛ", ИННФЛ);
		ВыборкаКонтрагент = Запрос.Выполнить().Выбрать();
		Если ВыборкаКонтрагент.Следующий() Тогда
			КонтрагентСсылка = ВыборкаКонтрагент.Ссылка;
		КонецЕсли; 
		
	ИначеЕсли ТипСведений = "СвЮЛУч" Тогда
		
		ИННЮЛ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИдентификационныеСведения, "ИННЮЛ", "");
		КПП = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИдентификационныеСведения, "КПП", "");		
		
		// поиск ЮЛ
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИННЮЛ
		|	И Контрагенты.КПП = &КПП";
		Запрос.УстановитьПараметр("ИННЮЛ", ИННЮЛ);
		Запрос.УстановитьПараметр("КПП", КПП);
		ВыборкаКонтрагент = Запрос.Выполнить().Выбрать();
		Если ВыборкаКонтрагент.Следующий() Тогда
			КонтрагентСсылка = ВыборкаКонтрагент.Ссылка;
		КонецЕсли; 
		
	ИначеЕсли ТипСведений = "СвФЛУчастФХЖ" Тогда
		
		ГосРегИПВыдДов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИдентификационныеСведения, "ГосРегИПВыдДов", "");
		
		// поиск ИП			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.РегистрационныйНомер = &РегистрационныйНомер
		|	И Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)";
		Запрос.УстановитьПараметр("РегистрационныйНомер", ГосРегИПВыдДов);			
		ВыборкаКонтрагент = Запрос.Выполнить().Выбрать();
		Если ВыборкаКонтрагент.Следующий() Тогда
			КонтрагентСсылка = ВыборкаКонтрагент.Ссылка;
		КонецЕсли;
		
	Иначе
		ВызватьИсключение "Не реализован поиск контрагента для типа сведений: " + Строка(ТипСведений);
	КонецЕсли; 		
	
	Возврат КонтрагентСсылка;
	
КонецФункции

