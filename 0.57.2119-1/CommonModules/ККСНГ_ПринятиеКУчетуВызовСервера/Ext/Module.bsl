
#Область ПрограммныйИнтерфейс

// Возвращает структуру данных, заполненную по структурированному документу
//
// Параметры:
//	ДанныеXML - строка XML, адрес во временном хранилище или двоичные данные
//	ИмяФайла - строка, содержащая имя файла (используется для определения формата)
//
// Возвращаемое значение:
//	Структура
//
Функция ПолучитьДанныеПоСтруктурированномуXML(ДанныеXML, ИмяФайла = "") Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обработка данных XML структурированного документа");
	
	ЗапросОбъектаXDTO = ККСНГ_СтруктурированныеДокументыВызовСервера.ПолучитьОбъектXDTOПоСтруктурированномуXML(ДанныеXML);
	Если Не ЗапросОбъектаXDTO.Успех Тогда
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросОбъектаXDTO.Журнал, Ложь);
		Возврат Ответ;
	КонецЕсли;
	
	ДанныеДокумента = ПолучитьСтруктуруДокумента();
	ДанныеXML = ККСНГ_APIКурьер.ПолучитьСтруктуруПоОбъектуXDTO(ЗапросОбъектаXDTO.Результат);
	
	// Реквизиты заголовка
	СписокРеквизитов = Новый СписокЗначений();
	СписокРеквизитов.Добавить("ИдентификаторФайла", "ИдФайл");
	
	СвСчФакт = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, "Документ.СвСчФакт");
	СвКСчФ = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, "Документ.СвКСчФ");
	Если СвСчФакт = Неопределено И СвКСчФ <> Неопределено Тогда
		// Замена ветки СвСчФакт на СвКСчФ для единообразного парсинга
		ДанныеXML.Документ.Вставить("СвСчФакт", СвКСчФ);
	КонецЕсли;
	
	// УПД приказ 970
	СписокРеквизитов.Добавить("Номер", "Документ.СвСчФакт.НомерДок");
	СписокРеквизитов.Добавить("ДатаСтрокой", "Документ.СвСчФакт.ДатаДок");
	СписокРеквизитов.Добавить("КодОКВ", "Документ.СвСчФакт.ДенИзм.КодОКВ");
	
	СписокРеквизитов.Добавить("Отправитель", "СвУчДокОбор.ИдОтпр");
	СписокРеквизитов.Добавить("Получатель", "СвУчДокОбор.ИдПол");
	СписокРеквизитов.Добавить("Номер", "Документ.СвСчФакт.НомерСчФ");
	СписокРеквизитов.Добавить("ДатаСтрокой", "Документ.СвСчФакт.ДатаСчФ");
	СписокРеквизитов.Добавить("КодОКВ", "Документ.СвСчФакт.КодОКВ");
	
	СписокРеквизитов.Добавить("ПервичныйДокумент", "Документ.НаимДокОпр");
	СписокРеквизитов.Добавить("Функция", "Документ.Функция");
	СписокРеквизитов.Добавить("СуммаБезНДС", "Документ.ТаблСчФакт.ВсегоОпл.СтТовБезНДСВсего");
	СписокРеквизитов.Добавить("СуммаНДС", "Документ.ТаблСчФакт.ВсегоОпл.СумНалВсего.СумНДС");
	СписокРеквизитов.Добавить("СуммаСНДС", "Документ.ТаблСчФакт.ВсегоОпл.СтТовУчНалВсего");
	
	// Для УКД
	СписокРеквизитов.Добавить("Номер", "Документ.СвСчФакт.НомерКСчФ");
	СписокРеквизитов.Добавить("ДатаСтрокой", "Документ.СвСчФакт.ДатаКСчФ");
	СписокРеквизитов.Добавить("СуммаБезНДСУвеличение", "Документ.ТаблКСчФ.ВсегоУвел.СтТовБезНДСВсего");
	СписокРеквизитов.Добавить("СуммаНДСУвеличение", "Документ.ТаблКСчФ.ВсегоУвел.СумНал.СумНДС");
	СписокРеквизитов.Добавить("СуммаСНДСУвеличение", "Документ.ТаблКСчФ.ВсегоУвел.СтТовУчНалВсего");
	СписокРеквизитов.Добавить("СуммаБезНДСУменьшение", "Документ.ТаблКСчФ.ВсегоУм.СтТовБезНДСВсего");
	СписокРеквизитов.Добавить("СуммаНДСУменьшение", "Документ.ТаблКСчФ.ВсегоУм.СумНал.СумНДС");
	СписокРеквизитов.Добавить("СуммаСНДСУменьшение", "Документ.ТаблКСчФ.ВсегоУм.СтТовУчНалВсего");
	
	// Транспортные накладные.
	ЗаполнитьДанныеТранспортныхНакладных(ДанныеДокумента, ДанныеXML);
	
	// Платёжно-расчетные документы.
	ЗаполнитьСведенияПлатежноРасчетныхДокументов(ДанныеДокумента, ДанныеXML);
	
	// Исправление СчФ
	СписокРеквизитов.Добавить("НомерИсправления", "Документ.СвСчФакт.ИспрСчФ.НомИспрСчФ");
	СписокРеквизитов.Добавить("ДатаИсправленияСтрокой", "Документ.СвСчФакт.ИспрСчФ.ДатаИспрСчФ");
	
	// УПД 970
	СписокРеквизитов.Добавить("НомерИсправления", "Документ.СвСчФакт.ИспрДок.НомИспр");
	СписокРеквизитов.Добавить("ДатаИсправленияСтрокой", "Документ.СвСчФакт.ИспрДок.ДатаИспр");
	
	// Пока не обрабатываем.
	// Исправление КСчФ
	// СписокРеквизитов.Добавить("НомерИсправления",		"Документ.СвСчФакт.ИспрКСчФ.НомИспрКСчФ");
	// СписокРеквизитов.Добавить("ДатаИсправленияСтрокой",	"Документ.СвСчФакт.ИспрКСчФ.ДатаИспрКСчФ");
	
	// Корректировка		
	Если СвКСчФ <> Неопределено Тогда
		
		// Сведения об основаниях корректировки.
		ЗаполнитьСведенияОбОснованияхКорректировки(ДанныеДокумента, ДанныеXML);
				
		// Сведения о корректируемых документах.
		ЗаполнитьСведенияОКорректируемыхДокументах(ДанныеДокумента, ДанныеXML);
		
		ЗаполнитьСведенияОбИсправленияхИсходныхДокументов(ДанныеДокумента, ДанныеXML);
					
	// Путь "Документ.СвСчФакт.СчФ.НомерСчФ" есть только в УКД (189 приказ).
	// Иначе
	//	СписокРеквизитов.Добавить("НомерОсн",				"Документ.СвСчФакт.СчФ.НомерСчФ");
	//	СписокРеквизитов.Добавить("ДатаОснСтрокой",			"Документ.СвСчФакт.СчФ.ДатаСчФ");	
	КонецЕсли;
			
	// Сведения о продавце
	ДополнитьДанныеСведениямиОПродавце(СписокРеквизитов, ДанныеXML);
		
	// Сведения о покупателе
	ДополнитьДанныеСведениямиОПокупателе(СписокРеквизитов, ДанныеXML);
	
	// Сведения о грузоотправителе
	ДополнитьДанныеСведениямиОГрузоотправителе(СписокРеквизитов, ДанныеXML);
	
	// Сведения о перевозчике
	ДополнитьДанныеСведениямиОПеревозчике(СписокРеквизитов, ДанныеXML);
	
	СписокРеквизитов.Добавить("ОбстФормСЧФ", "Документ.СвСчФакт.ДопСвФХЖ1.ОбстФормСЧФ");
	
	Для каждого Реквизит Из СписокРеквизитов Цикл
		ТекущееЗначениеСвойства = Неопределено;
		ДанныеДокумента.Свойство(Реквизит.Значение, ТекущееЗначениеСвойства);
		НовоеЗначениеСвойства = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, Реквизит.Представление, ТекущееЗначениеСвойства);
		ДанныеДокумента.Вставить(Реквизит.Значение,	НовоеЗначениеСвойства);
	КонецЦикла;
	
	Если Не ПустаяСтрока(ДанныеДокумента.ДатаСтрокой) Тогда
		Попытка
			ДанныеДокумента.Дата = Дата(ДанныеДокумента.ДатаСтрокой + " 00:00:00");
		Исключение
			ДанныеДокумента.Дата = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДанныеДокумента.ДатаИсправленияСтрокой) Тогда
		Попытка
			ДанныеДокумента.ДатаИсправления = Дата(ДанныеДокумента.ДатаИсправленияСтрокой + " 00:00:00");
		Исключение
			ДанныеДокумента.ДатаИсправления = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;
	
	// Таблица номенклатуры
	ЗаполнитьСведенияОТоварах(ДанныеДокумента, ДанныеXML);
	
	// Таблица номенклатуры кор
	ЗаполнитьСведенияОКорректируемыхТоварах(ДанныеДокумента, ДанныеXML);
	
	Ответ.Результат = ДанныеДокумента;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

// Заполняет таблицу ссылками на Справочник.Номенклатура из Справочник.ККСНГ_НоменклатураКонтрагентов
//
// Параметры:
//	ТаблицаНоменклатуры                - Таблица значений - таблица номенклатуры
//	Контрагент                         - Справочник.Контрагенты
//
Процедура НайтиСопоставленияНоменклатурыКонтрагента(ТаблицаНоменклатуры, Контрагент) Экспорт
	
	СписокВидовНоменклатуры = ККСНГ_СтруктурированныеДокументыВызовСервера.ПолучитьСписокПризнаковТоварРабота();
	
	Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
		// TODO Вынести заполнение ставки НДС
		СтрокаНоменклатуры.СтавкаНДС = ККСНГ_ДокументооборотПовтИсп.ПолучитьСтавкуНДСДляПринятияКУчету(СтрокаНоменклатуры.СтавкаНДССтрокой);
		
		ВидНоменклатуры = СписокВидовНоменклатуры.НайтиПоЗначению(СтрокаНоменклатуры.Вид);
		СтрокаНоменклатуры.СопоставленоАвтоматически = Ложь;
		
		Если ЗначениеЗаполнено(Контрагент) Тогда
			
			ЗапросНоменклатуры = Справочники.ККСНГ_НоменклатураКонтрагентов.НайтиСоответствиеНоменклатурыПоДаннымКонтрагента(
			Контрагент,
			СтрокаНоменклатуры.Код,
			СтрокаНоменклатуры.Наименование,
			?(ВидНоменклатуры <> Неопределено, ВидНоменклатуры.Представление, ""),
			СтрокаНоменклатуры.ЕдИзм,
			СтрокаНоменклатуры.Артикул,
			СтрокаНоменклатуры.Характеристика);
			
			Если ЗапросНоменклатуры.Успех Тогда 
				
				СтрокаНоменклатуры.Номенклатура = ЗапросНоменклатуры.Результат.Номенклатура;
				СтрокаНоменклатуры.ХарактеристикаНоменклатуры = ЗапросНоменклатуры.Результат.ХарактеристикаНоменклатуры;
				СтрокаНоменклатуры.СопоставленоАвтоматически = Истина; 
				
			КонецЕсли;

		КонецЕсли;
		
		//  Заполнение ед.изм.
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.КодОКЕИ) Тогда
			ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуВызовСервера");
			ЕдИзмСсылка = ОбщийМодульПринятиеКУчету.НайтиЕдиницуИзмерения(СтрокаНоменклатуры.Номенклатура, СтрокаНоменклатуры.КодОКЕИ);
			СтрокаНоменклатуры.ЕдИзмСсылка = ЕдИзмСсылка;
		КонецЕсли;
		
		//  Заполнение страны происхождения
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.КодСтраныПроисх) Тогда
			ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуВызовСервера");
			СтранаСсылка = ОбщийМодульПринятиеКУчету.НайтиСтрануМира(СтрокаНоменклатуры.КодСтраныПроисх);
			СтрокаНоменклатуры.СтранаПроисхожденияСсылка = СтранаСсылка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет таблицу ссылками на Справочник.Номенклатура из Справочник.ККСНГ_НоменклатураКонтрагентов для корректировки
// Параметры:
//   ТаблицаНоменклатуры                - Таблица значений - таблица номенклатуры
//   Контрагент                         - Справочник.Контрагенты
Процедура НайтиСопоставленияНоменклатурыКонтрагентаДляКорректировки(ТаблицаНоменклатуры, Контрагент) Экспорт
	
	СписокВидовНоменклатуры = ККСНГ_СтруктурированныеДокументыВызовСервера.ПолучитьСписокПризнаковТоварРабота();
	
	Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
		
		// TODO Вынести заполнение ставки НДС
		СтрокаНоменклатуры.СтавкаНДСДоИзменения = ККСНГ_ДокументооборотПовтИсп.ПолучитьСтавкуНДСДляПринятияКУчету(СтрокаНоменклатуры.СтавкаНДССтрокойДоИзменения);
		СтрокаНоменклатуры.СтавкаНДС = ККСНГ_ДокументооборотПовтИсп.ПолучитьСтавкуНДСДляПринятияКУчету(СтрокаНоменклатуры.СтавкаНДССтрокой);
		
		СтрокаНоменклатуры.СопоставленоАвтоматически = Ложь;
		
		НаименованиеЕдИзм = СтрокаНоменклатуры.ЕдИзм;
		
		//  Заполнение ед.изм.
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.КодОКЕИ) Тогда
			
			ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуВызовСервера");
			ЕдИзмСсылка = ОбщийМодульПринятиеКУчету.НайтиЕдиницуИзмерения(СтрокаНоменклатуры.Номенклатура, СтрокаНоменклатуры.КодОКЕИ);
			СтрокаНоменклатуры.ЕдИзмСсылка = ЕдИзмСсылка;
			
			Если ПустаяСтрока(НаименованиеЕдИзм) Тогда
				НаименованиеЕдИзм = ЕдИзмСсылка.Наименование;
			КонецЕсли;
			
		КонецЕсли;
		
		//  Заполнение номенклатуры.
		Если ЗначениеЗаполнено(Контрагент) Тогда
			
			ЗапросНоменклатуры = Справочники.ККСНГ_НоменклатураКонтрагентов.НайтиСоответствиеНоменклатурыПоДаннымКонтрагентаДляКорректировки(
			Контрагент,
			СтрокаНоменклатуры.Наименование,
			НаименованиеЕдИзм,
			СтрокаНоменклатуры.Характеристика);
			
			Если ЗапросНоменклатуры.Успех Тогда
				
				СтрокаНоменклатуры.Номенклатура = ЗапросНоменклатуры.Результат.Номенклатура;
				СтрокаНоменклатуры.ХарактеристикаНоменклатуры = ЗапросНоменклатуры.Результат.ХарактеристикаНоменклатуры;
				СтрокаНоменклатуры.СопоставленоАвтоматически = Истина;
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет данные по электронному документу.
//
// Параметры:
//	ДокументСсылка - ссылка на документ
//
// Возвращаемое значение:
//	Структура
//
Функция ДанныеДокумента(ДокументСсылка) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обработка данных электронного документа для учета");
	
	ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуВызовСервера");
		
	ЗапросДанных = ОбщийМодульПринятиеКУчету.ПолучитьДанныеПоСтруктурированномуДокументу(ДокументСсылка);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанных.Журнал, Ложь);
	
	Если Не ЗапросДанных.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Результат = ЗапросДанных.Результат;
	Результат.Вставить("ВидСчетаФактурыПолученного");
	
	СтруктДок = Результат.СтруктурированныйДокумент;
	
	// Счет-фактура без первичного документа Функция = СЧФ.
	Если ККСНГ_ОбщегоНазначенияКлиентСервер.ЭтоИсправление(СтруктДок.НомерИсправления) Тогда
		
		СчетФактураСсылкаИсправляемый = Неопределено;
		КорректируемыйДокумент = Неопределено;
		Если СтруктДок.ОбстФормСЧФ = "2" Тогда // Счет-фактура авансовый
			ВидСчетаФактурыИсправляемого = "НаАванс";
			СчетФактураСсылкаИсправляемый = ОбщийМодульПринятиеКУчету.НайтиИсправляемыйАвансСФ(Результат.Организация, Результат.Контрагент, СтруктДок.Дата, СтруктДок.Номер);
		Иначе // Все прочие варианты пока считаем за поступление.
			
			ВидСчетаФактурыИсправляемого = ?(СтруктДок.ОбстФормСЧФ = "1", "НаПоступление", Неопределено);
			
			ДанныеИсправляемыхДокументов = СтруктДок.ОснСЧФ.СкопироватьКолонки();
			СтрокаТекДокумента = ДанныеИсправляемыхДокументов.Добавить();
			СтрокаТекДокумента.НомерОснСЧФ = СтруктДок.Номер;
			СтрокаТекДокумента.ДатаОснСЧФ = СтруктДок.Дата;
			КорректируемыйДокумент = ОбщийМодульПринятиеКУчету.НайтиКорректируемыйДокумент(Результат.Организация, Результат.Контрагент, ДанныеИсправляемыхДокументов, Ложь);
			
		КонецЕсли;
		Результат.Вставить("ВидСчетаФактурыИсправляемого", ВидСчетаФактурыИсправляемого);
		Результат.Вставить("СчетФактураСсылкаИсправляемый", СчетФактураСсылкаИсправляемый);
		Результат.Вставить("КорректируемыйДокумент", КорректируемыйДокумент);
		
	ИначеЕсли ККСНГ_ОбщегоНазначенияКлиентСервер.ЭтоКорректировка(Результат.ИдентификаторФайла) Тогда
		
		КорректируемыйДокумент = ОбщийМодульПринятиеКУчету.НайтиКорректируемыйДокумент(Результат.Организация, Результат.Контрагент, СтруктДок.ОснСЧФ, Истина);
		Результат.Вставить("КорректируемыйДокумент", КорректируемыйДокумент);
		
	ИначеЕсли ВРег(СтруктДок.Функция) = "СЧФ" Тогда
							
		Если СтруктДок.ОбстФормСЧФ = "1" Тогда // Счет-фактура на поступление
			Результат.ВидСчетаФактурыПолученного = "НаПоступление";
			
			ДанныеОснованийСЧФ = ТаблицаОснСЧФ();
			СтрокаТекДокумента = ДанныеОснованийСЧФ.Добавить();
			СтрокаТекДокумента.НомерОснСЧФ = СтруктДок.Номер;
			СтрокаТекДокумента.ДатаОснСЧФ = СтруктДок.Дата;
			
			ДополнитьОснованияСЧФТранспортнымиНакладными(ДанныеОснованийСЧФ, СтруктДок.ТранНакл);
			ПоступлениеТоваровУслугСсылка = ОбщийМодульПринятиеКУчету.НайтиОснованиеСФ(Результат.Организация, Результат.Контрагент, ДанныеОснованийСЧФ, Результат.ВидСчетаФактурыПолученного);
			Результат.Вставить("ПоступлениеТоваровУслугСсылка", ПоступлениеТоваровУслугСсылка);
			
		ИначеЕсли СтруктДок.ОбстФормСЧФ = "2" Или Не ЗначениеЗаполнено(СтруктДок.ОбстФормСЧФ) Тогда // Счет-фактура авансовый
			
			Результат.ВидСчетаФактурыПолученного = "НаАванс";
			ДанныеОснованийСЧФ = ТаблицаОснСЧФ();
			ДополнитьОснованияСЧФСведениямиПРД(ДанныеОснованийСЧФ, СтруктДок.СвПРД);
			ДокументОснование = ОбщийМодульПринятиеКУчету.НайтиОснованиеСФ(Результат.Организация, Результат.Контрагент, ДанныеОснованийСЧФ, Результат.ВидСчетаФактурыПолученного);
			Результат.Вставить("ДокументОснование", ДокументОснование);
			
		ИначеЕсли Результат.СтруктурированныйДокумент.ОбстФормСЧФ = "3" Тогда // Счет-фактура на аванс комитента.
			Результат.ВидСчетаФактурыПолученного = "НаАвансКомитента";
		Иначе
			Результат.ВидСчетаФактурыПолученного = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.Успех = Истина;
	Ответ.Результат = Результат;
	
	Возврат Ответ;

КонецФункции

