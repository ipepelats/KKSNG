	СписокРеквизитов.Добавить("ГрузоотправительКПП", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвЮЛУч.КПП");
	СписокРеквизитов.Добавить("ГрузоотправительНаименование", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвЮЛУч.НаимОрг");
	
	СписокРеквизитов.Добавить("ГрузоотправительНаименование", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвИнНеУч.НаимОрг");
	СписокРеквизитов.Добавить("ГрузоотправительНаименование", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвЮлНеУч.НаимОрг");

	СписокРеквизитов.Добавить("ГрузоотправительИНН", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвИП.ИННФЛ");
	СписокРеквизитов.Добавить("ГрузоотправительИНН", "Документ.СвСчФакт.ГрузОт.ГрузОтпр.ИдСв.СвФЛУчастФХЖ.ИННФЛ");
	
КонецПроцедуры	

// Дополняет СписокРеквизитов и ДанныеXML элементами сведений о перевозчике.
//
// Параметры:
//	СписокРеквизитов - СписокЗначений - список свойств заполняемой структуры (см. ПолучитьСтруктуруДокумента()):
//     * Значение - Строка - имя заполняемого свойства;
//     * Представление - Строка - путь к значению свойства в структуре ДанныеXML.
//	ДанныеXML - Структура - структура, отражающая содержимое документа XML.
//
Процедура ДополнитьДанныеСведениямиОПеревозчике(СписокРеквизитов, ДанныеXML)
	
	Перевозчик = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик");
	
	Если ТипЗнч(Перевозчик) = Тип("Массив") И Перевозчик.Количество() Тогда
		ДанныеXML.СвПродПер.СвПер.ТранГруз.Перевозчик = Перевозчик[0];
	КонецЕсли;
	
	СписокРеквизитов.Добавить("ПеревозчикИНН", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвЮЛУч.ИННЮЛ");
	СписокРеквизитов.Добавить("ПеревозчикКПП", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвЮЛУч.КПП");
	СписокРеквизитов.Добавить("ПеревозчикНаименование", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвЮЛУч.НаимОрг");
	
	СписокРеквизитов.Добавить("ПеревозчикНаименование", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвИнНеУч.НаимОрг");
	СписокРеквизитов.Добавить("ПеревозчикНаименование", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвЮлНеУч.НаимОрг");
	
	СписокРеквизитов.Добавить("ПеревозчикИНН", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвИП.ИННФЛ");
	СписокРеквизитов.Добавить("ПеревозчикИНН", "Документ.СвПродПер.СвПер.ТранГруз.Перевозчик.ИдСв.СвФЛУчастФХЖ.ИННФЛ");
	
КонецПроцедуры
	
// Заполняет в структуре таблицу номенклатуры сведениями о товарах, полученными из XML документа.
//
// Параметры:
//	ДанныеДокумента - Структура - заполняемая структура (см. ПолучитьСтруктуруДокумента()).
//	ДанныеXML - Структура - структура, отражающая содержимое документа XML.
//
Процедура ЗаполнитьСведенияОТоварах(ДанныеДокумента, ДанныеXML)
	
	ДанныеНоменклатуры = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, "Документ.ТаблСчФакт.СведТов");
	
	Если ТипЗнч(ДанныеНоменклатуры) = Тип("Структура") Тогда
		ТаблицаНоменклатуры = Новый Массив;
		ТаблицаНоменклатуры.Добавить(ДанныеНоменклатуры);
	Иначе
		ТаблицаНоменклатуры = ДанныеНоменклатуры;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаНоменклатуры) = Тип("Массив") Тогда
		
		СписокРеквизитовТаблицы = Новый Соответствие();
		
		СписокРеквизитовТаблицы.Вставить("Номер", 						"НомСтр");
		СписокРеквизитовТаблицы.Вставить("Наименование", 				"НаимТов");
		СписокРеквизитовТаблицы.Вставить("КодОКЕИ", 					"ОКЕИ_Тов");
		СписокРеквизитовТаблицы.Вставить("Количество", 					"КолТов");
		СписокРеквизитовТаблицы.Вставить("Цена", 						"ЦенаТов");
		СписокРеквизитовТаблицы.Вставить("СуммаБезНДС", 				"СтТовБезНДС");
		СписокРеквизитовТаблицы.Вставить("СуммаНДС", 					"СумНал");
		СписокРеквизитовТаблицы.Вставить("СуммаНДС2", 					"СумНал.СумНал");
		СписокРеквизитовТаблицы.Вставить("Сумма", 						"СтТовУчНал");
		СписокРеквизитовТаблицы.Вставить("ЕдИзм", 						"НаимЕдИзм");
		СписокРеквизитовТаблицы.Вставить("Вид", 						"ДопСведТов.ПрТовРаб");
		СписокРеквизитовТаблицы.Вставить("Характеристика", 				"ДопСведТов.ХарактерТов");
		СписокРеквизитовТаблицы.Вставить("Артикул", 					"ДопСведТов.АртикулТов");
		СписокРеквизитовТаблицы.Вставить("Код", 						"ДопСведТов.КодТов");
		СписокРеквизитовТаблицы.Вставить("НомерТД", 					"СвДТ.НомерДТ");
		СписокРеквизитовТаблицы.Вставить("КодСтраныПроисх", 			"СвДТ.КодПроисх");
		СписокРеквизитовТаблицы.Вставить("КрНаимСтраныПроисх", 			"ДопСведТов.КрНаимСтрПр");
		СписокРеквизитовТаблицы.Вставить("СтавкаНДССтрокой", 			"НалСт");
		СписокРеквизитовТаблицы.Вставить("СведенияОМаркировке", 		"ДопСведТов.НомСредИдентТов");
		СписокРеквизитовТаблицы.Вставить("ГТИН", 						"ДопСведТов.ГТИН");
		СписокРеквизитовТаблицы.Вставить("СведенияОПрослеживаемости", 	"ДопСведТов.СведПрослеж");
		
		Для каждого СтрокаТаблицы Из ТаблицаНоменклатуры Цикл
			
			Если СтрокаТаблицы.Свойство("СвТД") Тогда
				Если ТипЗнч(СтрокаТаблицы.СвТД) = Тип("Массив") И СтрокаТаблицы.СвТД.Количество() Тогда
					СтрокаТаблицы.СвТД = СтрокаТаблицы.СвТД[0];
				КонецЕсли;
			ИначеЕсли СтрокаТаблицы.Свойство("СвДТ") Тогда // УПД приказ 970
				Если ТипЗнч(СтрокаТаблицы.СвДТ) = Тип("Массив") И СтрокаТаблицы.СвДТ.Количество() Тогда
					СтрокаТаблицы.СвДТ = СтрокаТаблицы.СвДТ[0];
				КонецЕсли;
			Иначе
				ВызватьИсключение "В строке таблицы не найдены сведения о декларации на товары";
			КонецЕсли;
			
			Если ТипЗнч(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрокаТаблицы, "ДопСведТов.КрНаимСтрПр")) = Тип("Массив") Тогда
				
				Если СтрокаТаблицы.ДопСведТов.КрНаимСтрПр.Количество() Тогда
					СтрокаТаблицы.ДопСведТов.КрНаимСтрПр = СтрокаТаблицы.ДопСведТов.КрНаимСтрПр[0];
				Иначе
					СтрокаТаблицы.ДопСведТов.КрНаимСтрПр = "";
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока = ДанныеДокумента.Номенклатура.Добавить();
			Для каждого Колонка Из ДанныеДокумента.Номенклатура.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрокаТаблицы, СписокРеквизитовТаблицы[Колонка.Имя]);
			КонецЦикла;
			
			Если НоваяСтрока.СуммаНДС = 0 Тогда
				НоваяСтрока.СуммаНДС = ?(НоваяСтрока.СуммаБезНДС > НоваяСтрока.СуммаНДС2, НоваяСтрока.Сумма - НоваяСтрока.СуммаБезНДС, НоваяСтрока.СуммаНДС2);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет в структуре таблицу корректируемой номенклатуры 
// сведениями о корректируемых товарах, полученными из XML документа.
//
// Параметры:
//	ДанныеДокумента - Структура - заполняемая структура (см. ПолучитьСтруктуруДокумента()).
//	ДанныеXML - Структура - структура, отражающая содержимое документа XML.
//
Процедура ЗаполнитьСведенияОКорректируемыхТоварах(ДанныеДокумента, ДанныеXML)
	
	ДанныеНоменклатурыКор = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXML, "Документ.ТаблКСчФ.СведТов");
	Если ТипЗнч(ДанныеНоменклатурыКор) = Тип("Структура") Тогда
		ТаблицаНоменклатурыКор = Новый Массив;
		ТаблицаНоменклатурыКор.Добавить(ДанныеНоменклатурыКор);
	Иначе
		ТаблицаНоменклатурыКор = ДанныеНоменклатурыКор;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаНоменклатурыКор) = Тип("Массив") Тогда
		
		СписокРеквизитовТаблицы = Новый Соответствие();
		
		СписокРеквизитовТаблицы.Вставить("Номер", 						"НомСтр");
		СписокРеквизитовТаблицы.Вставить("Наименование", 				"НаимТов");
		СписокРеквизитовТаблицы.Вставить("КодОКЕИ", 					"ОКЕИ_ТовПосле");
		СписокРеквизитовТаблицы.Вставить("ЕдИзм", 						"ДопСведТов.НаимЕдИзмПосле");
		СписокРеквизитовТаблицы.Вставить("Характеристика",				"ДопСведТов.ХарактерТов");
		СписокРеквизитовТаблицы.Вставить("Код", 						"ДопСведТов.КодТов");
		СписокРеквизитовТаблицы.Вставить("Артикул", 					"ДопСведТов.АртикулТов");
		СписокРеквизитовТаблицы.Вставить("КоличествоДоИзменения", 		"КолТовДо");
		СписокРеквизитовТаблицы.Вставить("Количество", 					"КолТовПосле");
		СписокРеквизитовТаблицы.Вставить("ЦенаДоИзменения", 			"ЦенаТовДо");
		СписокРеквизитовТаблицы.Вставить("Цена", 						"ЦенаТовПосле");
		СписокРеквизитовТаблицы.Вставить("СтавкаНДССтрокойДоИзменения",	"НалСтДо");
		СписокРеквизитовТаблицы.Вставить("СтавкаНДССтрокой",			"НалСтПосле");
		СписокРеквизитовТаблицы.Вставить("СуммаБезНДСДоИзменения", 		"СтТовБезНДС.СтоимДоИзм");
		СписокРеквизитовТаблицы.Вставить("СуммаБезНДС", 				"СтТовБезНДС.СтоимПослеИзм");
		СписокРеквизитовТаблицы.Вставить("СуммаНДСДо",   				"СумНалДо.СумНДС");
		СписокРеквизитовТаблицы.Вставить("СуммаНДС", 					"СумНалПосле.СумНДС");
		СписокРеквизитовТаблицы.Вставить("СуммаДоИзменения", 			"СтТовУчНал.СтоимДоИзм");
		СписокРеквизитовТаблицы.Вставить("Сумма", 						"СтТовУчНал.СтоимПослеИзм");
		СписокРеквизитовТаблицы.Вставить("СведенияОМаркировке",			"НомСредИдентТовДо");
		СписокРеквизитовТаблицы.Вставить("СведенияОПрослеживаемости",	"СведПрослеж");
		
		Для Каждого СтрокаТаблицы Из ТаблицаНоменклатурыКор Цикл
			
			НоваяСтрока = ДанныеДокумента.НоменклатураКор.Добавить();
			Для Каждого Колонка Из ДанныеДокумента.НоменклатураКор.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтрокаТаблицы, СписокРеквизитовТаблицы[Колонка.Имя]);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры		
	
#КонецОбласти

