// Получает структуру данных ЭД
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//	Структура
//
Функция ПолучитьСтруктуруЭлектронногоДокумента() Экспорт
	
	СтруктураЭД = Новый Структура;
	
	СтруктураЭД.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	СтруктураЭД.Вставить("Контрагент");
	СтруктураЭД.Вставить("ДоговорКонтрагента");
	СтруктураЭД.Вставить("Склад");
	СтруктураЭД.Вставить("ВалютаДокумента");
	СтруктураЭД.Вставить("СуммаДокумента", 0);
	
	СтруктураЭД.Вставить("ДокументУчета", Неопределено);
	СтруктураЭД.Вставить("ДокументОснование", Неопределено);
	
	СтруктураЭД.Вставить("ВидСчетаФактурыПолученного", Неопределено);
	СтруктураЭД.Вставить("ИдентификаторФайла", Неопределено);
	
	СтруктураЭД.Вставить("СтруктурированныйДокумент", Неопределено);
	
	Возврат СтруктураЭД;
	
КонецФункции

