#Область ПрограммныйИнтерфейс

#Область ЭлектронныеДокументы

// Записывает электронный документ в ИБ 
//
// Параметры: 
//	СтруктураОбъекта      - Структура, см. https://confluence.esphere.ru/display/SBER/Document
//	ПрофильЭДООрганизации - Ссылка на справочник ККСНГ_Организации
//  ПараметрыАвторизации  - Структура, см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации()
//
// Возвращаемое значение: 
//	Результат - ссылка, неопределено - ссылка на справочник ККСНГ_ЭлектронныеДокументы
//
Функция ЗаписатьЭД(СтруктураОбъекта, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	// Подготовка структуры ответа
	СтруктураОтвета = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись ЭД (" + Формат(СтруктураОбъекта.Id, "ЧГ=") + ")");
	
	// Обработка объекта записи
	ЭтоНовыйЭД = Ложь;
	ОбъектЭД = ПолучитьОбъектЭД(СтруктураОбъекта.Id, ПрофильЭДООрганизации, ЭтоНовыйЭД);
	
	// Очистка реквизитов и ТЧ
	ОчиститьДанныеОбъекта(ОбъектЭД);
	
	// Заполнение свойств + дополнительные поля и ТЧ
	ЗаполнитьЗначенияСвойств(ОбъектЭД, СтруктураОбъекта);
	
	ОбъектЭД.Description_ = СтруктураОбъекта.Description;	
	Для Каждого DocumentRelation Из СтруктураОбъекта.Relations.DocumentRelation Цикл
		НоваяСтрока = ОбъектЭД.Relations.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, DocumentRelation);
	КонецЦикла;
	
	НачатьТранзакцию();
	
	Попытка
	
		Для каждого DocumentSign Из СтруктураОбъекта.DocumentSigns Цикл
			
			НоваяСтрокаТабличнойЧасти = ОбъектЭД.DocumentSigns.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТабличнойЧасти, DocumentSign);
			
			ДанныеСертификата = DocumentSign.SignatureDetails;
			
			СертификатСсылка = ПолучитьСсылкуСертификат(ДанныеСертификата.Thumbprint);
			Если СертификатСсылка.Пустая() Тогда
				РезультатЗаписиСертификата = ЗаписатьСертификат(ДанныеСертификата);
				Если РезультатЗаписиСертификата.Успех Тогда
					СертификатСсылка = РезультатЗаписиСертификата.Результат;
				Иначе
					Возврат СтруктураОтвета;
				КонецЕсли;
			КонецЕсли; 
			
			НоваяСтрокаТабличнойЧасти.Image = Новый ХранилищеЗначения(DocumentSign.Image, Новый СжатиеДанных(9));
			НоваяСтрокаТабличнойЧасти.Сертификат = СертификатСсылка;

		КонецЦикла; 
		
		ОбъектЭД.КодЭДОВладельца = ПрофильЭДООрганизации.КодУчастникаЭДО;
		ОбъектЭД.Организация = ПрофильЭДООрганизации.Организация;
		ОбъектЭД.НаправлениеЭД = ?(ОбъектЭД.КодЭДОВладельца = ОбъектЭД.SellerCode,
												Перечисления.ККСНГ_НаправленияЭД.Исходящий, 
														Перечисления.ККСНГ_НаправленияЭД.Входящий);
														
		ИнициализироватьСвойстваЭДПоМаркировке(ОбъектЭД, ЭтоНовыйЭД, ПараметрыАвторизации);
														
		ККСНГ_ЭлектронныеДокументы.ЗаполнитьДоступныеДействияКурьер(ОбъектЭД);
		
		// Загрузка доп.параметров
		СписокДопПараметров = ОбъектЭД.Properties;
		Если Не ПараметрыАвторизации = Неопределено Тогда
			ЗапросДопПараметрыДокумента = ККСНГ_APIКурьер.v2_DocumentGetProperties(ПараметрыАвторизации, ОбъектЭД.Id);
			Если ЗапросДопПараметрыДокумента.Успех Тогда
				ДопПараметрыДокумента = ЗапросДопПараметрыДокумента.Результат.StringKeyValue;
				Для каждого ДопПараметрДокумента Из ДопПараметрыДокумента Цикл
					ЗаполнитьЗначенияСвойств(СписокДопПараметров.Добавить(), ДопПараметрДокумента);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;	

		// Запись и заполнение структуры ответа
		Если ЗаписатьНекийОбъект(ОбъектЭД, , СтруктураОтвета.Журнал) Тогда
			СтруктураОтвета.Результат = ОбъектЭД.Ссылка;
			СтруктураОтвета.Успех = Истина;
		КонецЕсли;	
	
		ЗафиксироватьТранзакцию();				
		
	Исключение
		ОтменитьТранзакцию();
		СтруктураОтвета.Успех = Ложь;
		ТекстОшибки = "Запись ЭД (" + Формат(СтруктураОбъекта.Id, "ЧГ=") + "): " + ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(СтруктураОтвета.Журнал, ТекстОшибки, "RQ-20003");				
	КонецПопытки;			
		
	Возврат СтруктураОтвета; 
	
КонецФункции // ШаблонЗаписиЭДДокумента

// Получает электронный документ как объект
//
// Параметры:
//	Id                    - Идентификатор электронного документа
//  ПрофильЭДООрганизации - ссылка на справочник ККСНГ_Организации
//  ЭтоНовыйЭД            - Булево - создать новый
//
// Возвращаемое значение: 
//	Результат - объект, неопределено - объект справочника ККСНГ_ЭлектронныеДокументы
//
Функция ПолучитьОбъектЭД(Id, ПрофильЭДООрганизации, ЭтоНовыйЭД = Ложь) Экспорт
	
	ОбъектЭД = Неопределено;
	
	СсылкаСуществующего = ПолучитьСсылкуЭД(Id, ПрофильЭДООрганизации);
	ЭтоНовыйЭД = СсылкаСуществующего.Пустая();
	
	Если ЭтоНовыйЭД Тогда
		ОбъектЭД = Справочники.ККСНГ_ЭлектронныеДокументы.СоздатьЭлемент();
	Иначе
		ОбъектЭД = СсылкаСуществующего.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат ОбъектЭД;
	
КонецФункции //ПолучитьОбъектЭД

// Получает ссылку на электронный документ
//	Id - Идентификатор электронного документа
//  ПрофильЭДООрганизации - ссылка на справочник ККСНГ_Организации
//
// Параметры:
//
// Возвращаемое значение: 
//	Результат - ссылка, пустаяссылка - ссылка на справочник ККСНГ_ЭлектронныеДокументы
//
Функция ПолучитьСсылкуЭД(Id, ПрофильЭДООрганизации) Экспорт
	
	СсылкаЭД = Справочники.ККСНГ_ЭлектронныеДокументы.ПустаяСсылка();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументы.Id = &Id
	|	И ККСНГ_ЭлектронныеДокументы.КодЭДОВладельца = &КодЭДОВладельца");
	Запрос.УстановитьПараметр("Id", Id);
	Запрос.УстановитьПараметр("КодЭДОВладельца", ПрофильЭДООрганизации.КодУчастникаЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда		
		СсылкаЭД = Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат СсылкаЭД;
	
КонецФункции // ПолучитьСсылкуЭД

// Изменяет объент электронного документа в соответствии с ожидаемым событием
//	Id - Идентификатор электронного документа
//  ПрофильЭДООрганизации - ссылка на справочник ККСНГ_Организации
//  Событие - структура DocumentEvent см. https://confluence.esphere.ru/display/SBER/DocumentEvent
//
// Параметры:
//
// Возвращаемое значение: 
//	Результат - ссылка, пустаяссылка - ссылка на справочник ККСНГ_ЭлектронныеДокументы
//
Функция ОтразитьИзмененияВОбъектеЭД(ИдДокумента, ПрофильЭДООрганизации, Событие) Экспорт

	СсылкаЭД = ПолучитьСсылкуЭД(ИдДокумента, ПрофильЭДООрганизации);
	Если СсылкаЭД <> Справочники.ККСНГ_ЭлектронныеДокументы.ПустаяСсылка() Тогда
		
		// Варианты событий
		ИмяСобытия = Событие.EventType;
		
		Если ИмяСобытия = "Revoked" Тогда // документ был отозван
			
			ОбъектЭД = СсылкаЭД.ПолучитьОбъект();
			ОбъектЭД.Status = "Revoked";
			ОбъектЭД.Actions = "";
			//ОбъектЭД.IsDocflowCompleted = Истина;
			RevokeReason = "Причину отзыва смотрите в истории обработки";
			ОбъектЭД.StatusName = "Документ отозван";
			ОбъектЭД.StatusChanged = Событие.Date;
			ОбъектЭД.Записать();
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат СсылкаЭД;
	
КонецФункции	

#КонецОбласти

#Область СвязиЭлектронныхДокументов

// Добавляет записи о связанных с электронным документом документах 1С в регистр сведений
//
// Параметры:
//	ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы, Строка - ссылка или уникальный идентификатор электронного документ
//	Документ1С - ДокументСсылка, Строка - ссылка или уникальный идентификатор связанного документа 1С
//	Дата - Дата - дата формирования связи
//	СпособОтправки - ПеречислениеСсылка.ККСНГ_ПМ_СпособыОтправки - способ отправки электронного документа
//
// Возвращаемое значение:
//   Структура - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаписатьСвязьЭлектронногоДокумента(ЭлектронныйДокумент, Документ1С, Дата = Неопределено, СпособОтправки = Неопределено) Экспорт

	СвязанныеДокументы = Новый Массив;
	СвязанныеДокументы.Добавить(Новый Структура("ДокументСсылка, Дата, СпособОтправки", Документ1С, Дата, СпособОтправки));
	
	Возврат ЗаписатьСвязиЭлектронногоДокумента(ЭлектронныйДокумент, СвязанныеДокументы);

КонецФункции

// Добавляет записи о связанных с электронным документом документах 1С в регистр сведений
//
// Параметры:
//	ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы, Строка - ссылка или уникальный идентификатор электронного документ
//	СвязанныеДокументы - Массив - массив структур данных связанных документов 1С со свойствами:	
//		* Документ1С - ДокументСсылка, Строка - ссылка или уникальный идентификатор связанного документа 1С
//		* Дата - Дата - Дата формирования связи
//		* СпособОтправки - ПеречислениеСсылка.ККСНГ_ПМ_СпособыОтправки - Способ отправки электронного документа
//
// Возвращаемое значение:
//   Структура - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаписатьСвязиЭлектронногоДокумента(ЭлектронныйДокумент, СвязанныеДокументы) Экспорт

	Перем ЭлектронныйДокументСтрокой, СвязанныйДокумент, ТипСвязанногоДокумента, Дата, СпособОтправки, ДокументСсылка;
	Перем НаборЗаписей, ТаблицаЗаписей, СтрокаЗаписи;
	
	ИмяГруппы = "Записи связей электронного документа " + Строка(ЭлектронныйДокумент);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ИмяГруппы);
	
	Если НЕ ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОбъектМетаданныхЕстьВКонфигурации("РегистрСведений", "ККСНГ_СвязанныеДокументы") Тогда
		СобытиеОшибки = "Ошибка записи связанных документов";
		ОписаниеОшибки = "Не обнаружена таблица связанных документов";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLW-00001", ОписаниеОшибки);
		Возврат Ответ;	
	КонецЕсли;	
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		ЭлектронныйДокументСтрокой = XMLСтрока(ЭлектронныйДокумент);
	ИначеЕсли ТипЗнч(ЭлектронныйДокумент) = Тип("Строка") Тогда
		ЭлектронныйДокументСтрокой = ЭлектронныйДокумент;	
	Иначе
		СобытиеОшибки = "Ошибка записи связанных документов";
		ОписаниеОшибки = "Некорретный тип параметра электронного документа";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLW-00002", ОписаниеОшибки);
		Возврат Ответ;
	КонецЕсли;
			
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ККСНГ_СвязанныеДокументы");
		ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ЭлектронныйДокументСтрокой);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
	
		НаборЗаписей = РегистрыСведений["ККСНГ_СвязанныеДокументы"].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокументСтрокой);
		НаборЗаписей.Прочитать();
		
		ТаблицаЗаписей = НаборЗаписей.Выгрузить();
		
		Для каждого ДанныеДокумента Из СвязанныеДокументы Цикл
			
			Дата = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "Дата");
			СпособОтправки = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "СпособОтправки");
			ДокументСсылка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ДокументСсылка");
			
			Если Метаданные.РегистрыСведений["ККСНГ_СвязанныеДокументы"].Ресурсы.СвязанныйДокумент.Тип.СодержитТип(ТипЗнч(ДокументСсылка)) Тогда
				СвязанныйДокумент = ДокументСсылка;
			Иначе
				СвязанныйДокумент = XMLСтрока(ДокументСсылка);
			КонецЕсли;
			
			// TODO Переделать
			ТипСвязанногоДокумента = ОбщегоНазначения.ВидОбъектаПоСсылке(ДокументСсылка) + "Ссылка." + ДокументСсылка.Метаданные().Имя;
			
			СтрокаЗаписи = ТаблицаЗаписей.Найти(СвязанныйДокумент, "СвязанныйДокумент");
			
			Если СтрокаЗаписи = Неопределено Тогда
				СтрокаЗаписи = ТаблицаЗаписей.Добавить();
				СтрокаЗаписи.ЭлектронныйДокумент = ЭлектронныйДокументСтрокой;
				СтрокаЗаписи.СвязанныйДокумент = СвязанныйДокумент;
				СтрокаЗаписи.ТипСвязанногоДокумента = ТипСвязанногоДокумента;
			КонецЕсли; 
						
			Если Дата = Неопределено Тогда
				СтрокаЗаписи.Дата = ТекущаяДатаСеанса();
			Иначе
				СтрокаЗаписи.Дата = Дата;
			КонецЕсли;
			
			Если СпособОтправки <> Неопределено Тогда
				СтрокаЗаписи.СпособОтправки = СпособОтправки;
			КонецЕсли;
			
		КонецЦикла;	
		
		УстановитьКлючиСтрокСвязанныхДокументов(ТаблицаЗаписей);
		
		НаборЗаписей.Загрузить(ТаблицаЗаписей);
		НаборЗаписей.Записать();
		
		Ответ.Успех = Истина;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		СобытиеОшибки = "Ошибка записи связанных документов";
		ОписаниеОшибки = ОписаниеОшибки();
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLW-00003", ОписаниеОшибки);
				                                                                                
	КонецПопытки;	
	
	Возврат Ответ;

КонецФункции

// Удаляет записи связанных документов электронного документа
//
// Параметры:
//	ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы, Строка - ссылка или уникальный идентификатор электронного документ
//	КлючСтроки - Число, Неопределено - ключ строки связи
//
// Возвращаемое значение:
//   Структура - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//
Функция УдалитьСвязиЭлектронногоДокумента(ЭлектронныйДокумент, КлючСтроки = Неопределено) Экспорт

	Перем ЭлектронныйДокументСтрокой;
	Перем НаборЗаписей, ТаблицаЗаписей, СтрокаКУдалению;
	
	ИмяГруппы = "Удаление связей электронного документа " + Строка(ЭлектронныйДокумент);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ИмяГруппы);
	
	Если НЕ ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОбъектМетаданныхЕстьВКонфигурации("РегистрСведений", "ККСНГ_СвязанныеДокументы") Тогда
		СобытиеОшибки = "Ошибка удаления связей электронного документа";
		ОписаниеОшибки = "Не обнаружена таблица связанных документов";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLD-00001", ОписаниеОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		ЭлектронныйДокументСтрокой = XMLСтрока(ЭлектронныйДокумент);
	ИначеЕсли ТипЗнч(ЭлектронныйДокумент) = Тип("Строка") Тогда
		ЭлектронныйДокументСтрокой = ЭлектронныйДокумент;	
	Иначе
		СобытиеОшибки = "Ошибка удаления связей электронного документа";
		ОписаниеОшибки = "Некорретный тип параметра электронного документа";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLD-00002", ОписаниеОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ККСНГ_СвязанныеДокументы");
		ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ЭлектронныйДокументСтрокой);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		НаборЗаписей = РегистрыСведений["ККСНГ_СвязанныеДокументы"].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокументСтрокой);

		Если КлючСтроки <> Неопределено Тогда
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 1
				И НаборЗаписей[0].КлючСтроки = КлючСтроки Тогда
				НаборЗаписей.Очистить();
			ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
				ВызватьИсключение "Не найдена запись с ключом " + XMLСтрока(КлючСтроки);	
			Иначе	
				ТаблицаЗаписей = НаборЗаписей.Выгрузить();
					
				СтрокаКУдалению = ТаблицаЗаписей.Найти(КлючСтроки, "КлючСтроки");
				Если СтрокаКУдалению = Неопределено Тогда
					ВызватьИсключение "Не найдена запись с ключом " + XMLСтрока(КлючСтроки);
				КонецЕсли;
				
				ТаблицаЗаписей.Удалить(СтрокаКУдалению);
				
				УстановитьКлючиСтрокСвязанныхДокументов(ТаблицаЗаписей);
				
				НаборЗаписей.Загрузить(ТаблицаЗаписей);
			КонецЕсли;
			
		КонецЕсли;
		
		НаборЗаписей.Записать();
		Ответ.Успех = Истина;
			
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		СобытиеОшибки = "Ошибка удаления связей электронного документа";
		ОписаниеОшибки = ОписаниеОшибки();
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, "DLD-00003", ОписаниеОшибки);

	КонецПопытки;
	
	Возврат Ответ;
		
КонецФункции

// Возвращает ссылку на связанный объект 1С для электронного документа
//
// Параметры:
//	ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы, Строка - ссылка или уникальный идентификатор электронного документ
//	УИДСвязанногоОбъекта - Строка - уникальный идентификатор связанного объекта 1С
//
// Возвращаемое значение:
//   ЛюбаяСсылка, Неопределено - ссылка на объект 1С
//
Функция СсылкаНаСвязанныйДокументПоИдентификатору(ЭлектронныйДокумент, УИДСвязанногоОбъекта) Экспорт
	
	Перем СсылкаНаСвязанныйДокумент;
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		ЭлектронныйДокументСтрокой = XMLСтрока(ЭлектронныйДокумент);
	ИначеЕсли ТипЗнч(ЭлектронныйДокумент) = Тип("Строка") Тогда
		ЭлектронныйДокументСтрокой = ЭлектронныйДокумент;	
	Иначе
		Возврат СсылкаНаСвязанныйДокумент;
	КонецЕсли;
	
	Запрос = Новый Запрос;                                                                                                          
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1 
	|	ККСНГ_СвязанныеДокументы.ТипСвязанногоДокумента,
	|	ККСНГ_СвязанныеДокументы.СвязанныйДокумент
	|ИЗ 
	|	РегистрСведений.ККСНГ_СвязанныеДокументы КАК ККСНГ_СвязанныеДокументы
	|ГДЕ 
	|	ККСНГ_СвязанныеДокументы.ЭлектронныйДокумент = &ЭлектронныйДокумент
	|	И ККСНГ_СвязанныеДокументы.СвязанныйДокумент = &СвязанныйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ККСНГ_СвязанныеДокументы.Дата";
	
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокументСтрокой);
	Запрос.УстановитьПараметр("СвязанныйДокумент", УИДСвязанногоОбъекта);
	
	ВыборкаДокумента = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДокумента.Следующий() 
		И НЕ ПустаяСтрока(ВыборкаДокумента.ТипСвязанногоДокумента) Тогда
		СсылкаНаСвязанныйДокумент = РегистрыСведений["ККСНГ_СвязанныеДокументы"].СсылкаНаСвязанныйДокумент(
											УИДСвязанногоОбъекта, ВыборкаДокумента.ТипСвязанногоДокумента);
	КонецЕсли;
	
	Возврат СсылкаНаСвязанныйДокумент;
	
КонецФункции

