// Записывает квитанцию в ИБ 
//
// Параметры: 
//	СтруктураОбъекта - структура, см. https://confluence.esphere.ru/display/SBER/TicketDetails
//	Владелец - ссылка на владельца ККСНГ_ЭлектронныеДокументы
//
// Возвращаемое значение: 
//	Результат - ссылка, неопределено - ссылка на справочник ККСНГ_Квитанции
//
Функция ЗаписатьКвитанцию(СтруктураОбъекта, Владелец) Экспорт
	
	// Подготовка структуры ответа
	СтруктураОтвета = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись квитанции (" + Формат(СтруктураОбъекта.Id, "ЧГ=") + ")");
	
	// Обработка объекта записи
	ОбъектКвитанция = ПолучитьОбъектКвитанция(СтруктураОбъекта.Id, Владелец);
	
	// Очистка реквизитов и ТЧ
	ОчиститьДанныеОбъекта(ОбъектКвитанция);
	
	// Заполнение свойств + дополнительные поля и ТЧ
	ЗаполнитьЗначенияСвойств(ОбъектКвитанция, СтруктураОбъекта);
	
	ОбъектКвитанция.Владелец = Владелец;
	
	Попытка
		ОбъектКвитанция.ККСНГ_ExtendedDocumentType = Перечисления.ККСНГ_ExtendedDocumentType[СокрЛП(СтруктураОбъекта.ExtendedType)];
	Исключение
		ОбъектКвитанция.ККСНГ_ExtendedDocumentType = Перечисления.ККСНГ_ExtendedDocumentType.ПустаяСсылка();
	КонецПопытки;
	
	///////////////
	// Подписи ТЧ
	ОбъектКвитанция.Подписи.Очистить();
	
	Для Каждого СтруктураПодписи Из СтруктураОбъекта.Signature Цикл
		НоваяПодпись = ОбъектКвитанция.Подписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПодпись, СтруктураПодписи.Content);
		НоваяПодпись.Content = Новый ХранилищеЗначения(СтруктураПодписи.Content, Новый СжатиеДанных(9));
		НоваяПодпись.ДатаПодписи = ЭлектроннаяПодпись.ДатаПодписания(СтруктураПодписи.Content);
	КонецЦикла;
	
	НачатьТранзакцию();
	
	Попытка
	
		// Запись и заполнение структуры ответа
		Если ЗаписатьНекийОбъект(ОбъектКвитанция, , СтруктураОтвета.Журнал) Тогда
			СтруктураОтвета.Результат = ОбъектКвитанция.Ссылка;
			СтруктураОтвета.Успех = Истина;
		КонецЕсли;	
		
		ЗафиксироватьТранзакцию();				
		
	Исключение
		ОтменитьТранзакцию();
		СтруктураОтвета.Успех = Ложь;
		ТекстОшибки = "Запись квитанции (" + Формат(СтруктураОбъекта.Id, "ЧГ=") + "): " + ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(СтруктураОтвета.Журнал, ТекстОшибки, "RQ-20004");				
	КонецПопытки;			
		
	Возврат СтруктураОтвета; 
	
КонецФункции

// Получает квитанцию как объект
//
// Параметры:
//	Id - Идентификатор квитанции
//	Владелец - ссылка на владельца ККСНГ_ЭлектронныеДокументы
//
// Возвращаемое значение: 
//	Результат - объект, неопределено - ссылка на справочник ККСНГ_Квитанции
//
Функция ПолучитьОбъектКвитанция(Id, Владелец) Экспорт
	
	ОбъектКвитанция = Неопределено;
	
	СсылкаСуществующего = ПолучитьСсылкуКвитанции(Id, Владелец);
	
	Если СсылкаСуществующего.Пустая() Тогда
		ОбъектКвитанция = Справочники.ККСНГ_Квитанции.СоздатьЭлемент();
	Иначе
		ОбъектКвитанция = СсылкаСуществующего.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат ОбъектКвитанция;
	
КонецФункции

// Получает ссылку на квитанцию
//	Id - Идентификатор квитанции
//	Владелец - ссылка на владельца ККСНГ_ЭлектронныеДокументы
//
// Параметры:
//
// Возвращаемое значение: 
//	Результат - ссылка, пустаяссылка - объект справочника ККСНГ_Квитанции
//
Функция ПолучитьСсылкуКвитанции(Id, Владелец) Экспорт
	
	Возврат Справочники.ККСНГ_Квитанции.НайтиПоРеквизиту("Id", Id , , Владелец);
	
КонецФункции

// Получает список квитанций документа
//	Владелец - ссылка на владельца ККСНГ_ЭлектронныеДокументы
//	NeedReply - булево - признак отбора квитанций
//
// Параметры:
//
// Возвращаемое значение: 
//	Результат - массив СправочникСсылка.ККСНГ_Квитанции
//
Функция ПолучитьКвитанцииДокумента(Владелец, NeedReply = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Выборка = Справочники.ККСНГ_Квитанции.Выбрать(, Владелец);
	Пока Выборка.Следующий() Цикл
		Если NeedReply = Неопределено Или Выборка.NeedReply = NeedReply Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЭлектронныеПодписиЭлектронныхДокументов

// Функция - Добавить подписи электронного документа
//
// Параметры:
//  СоответствиеПодписиСертификаты - Соответствие: 
// 		* Ключ 	   - Структура	 - СтруктураПодписи
// 		* Значение - Структура	 - СтруктураДанныхСертификата
//  IdДокумента					   - Число	 - Идентификатор электронного документа
//  ПрофильЭДООрганизации		   - СправочникСсылка.ККСНГ_Организации	 - ссылка на профиль ЭДО организации
// 
// Возвращаемое значение:
//	Результат - Структура, с полями 
//			Успех - Булево - Результат выполнения операции
//			Результат - СправочникСсылка.ККСНГ_ЭлектронныеДокументы, Неопределено - ссылка на справочник ККСНГ_ЭлектронныеДокументы  
//			Журнал -
//
Функция ДобавитьПодписиЭлектронногоДокумента(СоответствиеПодписиСертификаты, IdДокумента, ПрофильЭДООрганизации) Экспорт
	
	// Подготовка структуры ответа
	СтруктураОтвета = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись подписей ЭД (" + Формат(IdДокумента, "ЧГ=") + ")");
	
	// Обработка объекта записи
	ОбъектЭД = ПолучитьОбъектЭД(IdДокумента, ПрофильЭДООрганизации);
	
	ТабличнаяЧастьПодписи = ОбъектЭД.DocumentSigns;
	
	Для каждого СоответствиеПодписьСертификат Из СоответствиеПодписиСертификаты Цикл
		
		СтруктураПодписи = СоответствиеПодписьСертификат.Ключ;
		ДанныеСертификата = СоответствиеПодписьСертификат.Значение;		
		
		НоваяСтрокаТабличнойЧасти = ТабличнаяЧастьПодписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТабличнойЧасти, СтруктураПодписи);
		
		СертификатСсылка = ПолучитьСсылкуСертификат(ДанныеСертификата.Thumbprint);
		Если СертификатСсылка.Пустая() Тогда
			РезультатЗаписиСертификата = ЗаписатьСертификат(ДанныеСертификата);
			Если РезультатЗаписиСертификата.Успех Тогда
				СертификатСсылка = РезультатЗаписиСертификата.Результат;
			Иначе
				Возврат СтруктураОтвета;
			КонецЕсли;
		КонецЕсли; 
		
		НоваяСтрокаТабличнойЧасти.Image = Новый ХранилищеЗначения(СтруктураПодписи.Image, Новый СжатиеДанных(9));
		
		НоваяСтрокаТабличнойЧасти.Сертификат = СертификатСсылка;
		
	КонецЦикла;
	
	// Запись и заполнение структуры ответа
	Если ЗаписатьНекийОбъект(ОбъектЭД, , СтруктураОтвета.Журнал) Тогда
		СтруктураОтвета.Результат = ОбъектЭД.Ссылка;
		СтруктураОтвета.Успех = Истина;
	КонецЕсли;	
	
	Возврат СтруктураОтвета;
	
КонецФункции 

#КонецОбласти

#Область СертифкатыКлючейЭлектроннойПодписи

// Записывает данные сертификата в объект ИБ
// 
// Параметры:
//  СтруктураОбъекта - структура, см. https://confluence.esphere.ru/display/SBER/Document
//
// Возвращаемое значение: 
//  Структура - см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаписатьСертификат(СтруктураОбъекта) Экспорт
	
	//Подготовка структуры ответа
	СтруктураОтвета = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись Сертификата (" + СтруктураОбъекта.Thumbprint + ")");
	
	//Обработка объекта записи
	ОбъектСертификат = ПолучитьОбъектСертификат(СтруктураОбъекта.Thumbprint);
	
	//Очистка реквизитов и ТЧ
	ОчиститьДанныеОбъекта(ОбъектСертификат);
	
	//Заполнение свойств + дополнительные поля и ТЧ
	ЗаполнитьЗначенияСвойств(ОбъектСертификат, СтруктураОбъекта);
	
	ОбъектСертификат.Код = СтруктураОбъекта.Thumbprint;
	
	СтруктураСубъекта = СтруктураОбъекта.Person;
	
	MiddleName = "";
	
	Если СтруктураСубъекта.Свойство("MiddleName")
		И ЗначениеЗаполнено(СтруктураСубъекта.MiddleName) Тогда
		MiddleName = " " + СтруктураСубъекта.MiddleName;	
	КонецЕсли;
	
	ОбъектСертификат.Подписант = СтруктураСубъекта.LastName + " " + СтруктураСубъекта.FirstName + MiddleName;
	
	ОбъектСертификат.Image = Новый ХранилищеЗначения(СтруктураОбъекта.Image, Новый СжатиеДанных(9));
	
	//Запись и заполнение структуры ответа
	Если ЗаписатьНекийОбъект(ОбъектСертификат,,СтруктураОтвета.Журнал) Тогда
		СтруктураОтвета.Результат = ОбъектСертификат.Ссылка;
		СтруктураОтвета.Успех = Истина;
	КонецЕсли;	
	
	Возврат СтруктураОтвета; 	
	
КонецФункции

// Получает новый или существующий объект ИБ по отпечатку
// 
// Параметры:
//  ОтпечатокСертификата - Строка
//
// Возвращаемое значение: 
//  Объект Справочник.ККСНГ_СертификатыКлючейЭлектроннойПодписи
//
Функция ПолучитьОбъектСертификат(ОтпечатокСертификата) Экспорт
	
	ОбъектСертификат = Неопределено;
	
	СсылкаСуществующего = ПолучитьСсылкуСертификат(ОтпечатокСертификата);
	
	Если СсылкаСуществующего.Пустая() Тогда
		ОбъектСертификат = Справочники.ККСНГ_СертификатыКлючейЭлектроннойПодписи.СоздатьЭлемент();
	Иначе
		ОбъектСертификат = СсылкаСуществующего.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат ОбъектСертификат;
	
КонецФункции

// Получает ссылку объекта ИБ по отпечатку
// 
// Параметры:
//  ОтпечатокСертификата - Строка
//
// Возвращаемое значение: 
//  Ссылка на Справочник.ККСНГ_СертификатыКлючейЭлектроннойПодписи или Неопределено
//
Функция ПолучитьСсылкуСертификат(ОтпечатокСертификата) Экспорт
	
	Возврат Справочники.ККСНГ_СертификатыКлючейЭлектроннойПодписи.НайтиПоКоду(ОтпечатокСертификата); 
	
КонецФункции

#КонецОбласти 

#Область СертификатыКлючейЭлектроннойПодписиИШифрования

// Получает отпечаток активного зарегистрированного сертификата авторизованного пользователя.
// См. ККСНГ_APIКурьер.v1_DictionaryUserCertificate
//
// Параметры:
//	ИскомыйОтпечаток  - Cтрока base64 - содержит двоиные данные отпечатка
//
// Возвращаемое значение: 
//	СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - если сертификат найден;
//  Неопределено - если сертификат не найден.
//
Функция ПолучитьСертификатКлючаЭППоОтпечатку(ИскомыйОтпечаток) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СертификатыКлючейЭлектроннойПодписиИШифрования.Ссылка КАК НайденныйСертификат
		|ИЗ
		|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК СертификатыКлючейЭлектроннойПодписиИШифрования
		|ГДЕ
		|	НЕ СертификатыКлючейЭлектроннойПодписиИШифрования.ПометкаУдаления
		|	И СертификатыКлючейЭлектроннойПодписиИШифрования.Отпечаток = &ИскомыйОтпечаток";
	
	Запрос.УстановитьПараметр("ИскомыйОтпечаток", ИскомыйОтпечаток);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.НайденныйСертификат;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти 

