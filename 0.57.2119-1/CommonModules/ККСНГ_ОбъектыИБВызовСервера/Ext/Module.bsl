#Область СлужебныеПроцедурыИФункции

Процедура УстановитьКлючиСтрокСвязанныхДокументов(ТаблицаЗаписей)
	
	ТаблицаЗаписей.Сортировать("Дата УБЫВ, СвязанныйДокумент УБЫВ");
	Для каждого СтрокаЗаписи Из ТаблицаЗаписей Цикл
		СтрокаЗаписи.КлючСтроки = ТаблицаЗаписей.Индекс(СтрокаЗаписи) + 1;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьДанныеОбъекта(НекийОбъект)
	
	МетаданныеОбъекта = НекийОбъект.Метаданные();
	МетаданныеИмя = МетаданныеОбъекта.Имя;
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		
		//У ЭД не очищаем реквизит ДокументОснование
		Если МетаданныеИмя = "ККСНГ_ЭлектронныеДокументы" И Реквизит.Имя = "ДокументОснование" Тогда
			Продолжить;
		КонецЕсли;
		
		НекийОбъект[Реквизит.Имя] = Неопределено; 
		
	КонецЦикла; 
	
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл 
		НекийОбъект[ТабличнаяЧасть.Имя].Очистить(); 
	КонецЦикла; 
	
КонецПроцедуры //ОчиститьДанныеОбъекта

Процедура ИнициализироватьСвойстваЭДПоМаркировке(ОбъектЭД, ЭтоНовыйЭД, ПараметрыАвторизации)

	Если ККСНГ_ЭлектронныеДокументыВызовСервера.ЭтоСтруктурированныйЭД(ОбъектЭД.DocumentTypeCode) И (ЭтоНовыйЭД Или ОбъектЭД.ЕстьМаркировка Или (Не ОбъектЭД.ЕстьМаркировка И ОбъектЭД.СтатусЦРПТ <> -1)) Тогда
		Если Не ОбъектЭД.ЕстьМаркировка Тогда
			ИнициализироватьПризнакМаркировкиПоМаскеФайла(ОбъектЭД, ПараметрыАвторизации);
		КонецЕсли;
		ИнициализироватьДанныеОтЦРПТ(ОбъектЭД, ПараметрыАвторизации);
	КонецЕсли;
	
	Если Не ОбъектЭД.ЕстьМаркировка Тогда
		ОбъектЭД.СтатусЦРПТ = -1;
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьДанныеОтЦРПТ(ОбъектЭД, ПараметрыАвторизации)

	Если ОбъектЭД.ЕстьМаркировка Тогда
		ЗапросСтатусаЦРПТ = ККСНГ_ДокументооборотВызовСервера.СтатусЦРПТДокумента(ОбъектЭД.Id, ПараметрыАвторизации);
		Если ЗапросСтатусаЦРПТ.Успех Тогда
			ОбъектЭД.СтатусЦРПТ = ЗапросСтатусаЦРПТ.Результат;
			
			Если ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Успех Тогда
				ОбъектЭД.ОшибкиЦРПТ = Новый ХранилищеЗначения(ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Результат, Новый СжатиеДанных(9));
				ОбъектЭД.КодОшибкиЦРПТ = ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Результат.КодОшибки;
				ОбъектЭД.ОписаниеОшибкиЦРПТ = ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Результат.ОписаниеОшибки;
			КонецЕсли;
			
		Иначе
			ОбъектЭД.СтатусЦРПТ = 5;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьПризнакМаркировкиПоМаскеФайла(ОбъектЭД, ПараметрыАвторизации)
	
	Перем МассивПрефиксов, ТекFilename, МассивСтрок, ПризнакМаркировки;
	
	МассивПрефиксов = Новый Массив;
	МассивПрефиксов.Добавить("NSCHFDOPPRMARK");
	МассивПрефиксов.Добавить("NSCHFDOPPOKMARK");
	МассивПрефиксов.Добавить("NKORSCHFDOPPRMARK");
	МассивПрефиксов.Добавить("KORSCHFDOPPR");
	МассивПрефиксов.Добавить("KORSCHFDOPPOK");
	
	ТекFilename = Врег(ОбъектЭД.Filename);
	МассивСтрок = СтрРазделить(ТекFilename, "_");
	
	Если МассивСтрок.Количество() = 12 Тогда
		ПризнакМаркировки = МассивСтрок[7];
		ОбъектЭД.ЕстьМаркировка = ?(ПризнакМаркировки = "1", Истина, Ложь);
	Иначе
		Для каждого Префикс Из МассивПрефиксов Цикл
			Если МассивСтрок.Найти(Префикс) <> Неопределено Тогда
				Если Префикс = "KORSCHFDOPPOK" Или Префикс = "KORSCHFDOPPR" Тогда
					ЗапросНаличияМаркировки = ККСНГ_ЭлектронныеДокументыВызовСервера.ПолучитьДополнительноеСвойствоДокумента(ПараметрыАвторизации, ОбъектЭД.Id, "contains.markedgoods", Тип("Булево"));
					ОбъектЭД.ЕстьМаркировка = ЗапросНаличияМаркировки.Успех И ЗапросНаличияМаркировки.Результат;
				Иначе
					ОбъектЭД.ЕстьМаркировка = Истина;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
