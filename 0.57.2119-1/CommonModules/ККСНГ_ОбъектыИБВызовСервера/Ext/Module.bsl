// Записывает присоединенный файл в ИБ 
//
// Параметры: 
//	СтруктураОбъекта - структура, см. https://confluence.esphere.ru/display/SBER/Attachment
//	Владелец - ссылка на владельца возможные варианты: ККСНГ_ЭлектронныеДокументы, ККСНГ_Квитанции
//
// Возвращаемое значение: 
//	Результат - ссылка, неопределено - ссылка на справочник ККСНГ_ПрисоединенныеФайлы
//
Функция ЗаписатьПрисоединенныйФайл(СтруктураОбъекта, Владелец) Экспорт
	
	// Подготовка структуры ответа
	СтруктураОтвета = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись присоединенного файла " + Владелец.Метаданные().Имя);
	
	// Для контента документа или квитанции ID ВСЕГДА = 0!
	// Если в структуре отсутствет поле ID, то ID=0
	Id = ?(СтруктураОбъекта.Свойство("Id", Id), Id, 0);
	
	// Обработка объекта записи
	ОбъектПрисоединенныйФайл = ПолучитьОбъектПрисоединенныйФайл(Id, Владелец);
	
	// Очистка реквизитов и ТЧ
	ОчиститьДанныеОбъекта(ОбъектПрисоединенныйФайл);
	
	// Заполнение свойств + дополнительные поля и ТЧ
	ЗаполнитьЗначенияСвойств(ОбъектПрисоединенныйФайл, СтруктураОбъекта);
	
	ОбъектПрисоединенныйФайл.Владелец = Владелец;
	ОбъектПрисоединенныйФайл.Наименование = СтруктураОбъекта.Filename;
	ОбъектПрисоединенныйФайл.Content = Новый ХранилищеЗначения(СтруктураОбъекта.Content, Новый СжатиеДанных(9));
	
	// Запись и заполнение структуры ответа
	Если ЗаписатьНекийОбъект(ОбъектПрисоединенныйФайл, , СтруктураОтвета.Журнал) Тогда
		СтруктураОтвета.Результат = ОбъектПрисоединенныйФайл.Ссылка;
		СтруктураОтвета.Успех = Истина;
	КонецЕсли;	
	
	Возврат СтруктураОтвета; 
	
КонецФункции

// Получает присоединенный файл как объект
//
// Параметры:
//	Id - Идентификатор присоединенного файла 
//		 *Для контента документа или квитанции ID ВСЕГДА = 0 !
//	Владелец - ссылка на владельца возможные варианты: ККСНГ_ЭлектронныеДокументы, ККСНГ_Квитанции
//
// Возвращаемое значение: 
//	Результат - объект, неопределено - объект справочника ККСНГ_ЭлектронныеДокументы
//
Функция ПолучитьОбъектПрисоединенныйФайл(Id, Владелец) Экспорт
	
	ОбъектПрисоединенныйФайл = Неопределено;
	
	СсылкаСуществующего = ПолучитьСсылкуПрисоединенныйФайл(Id, Владелец);
	
	Если СсылкаСуществующего.Пустая() Тогда
		ОбъектПрисоединенныйФайл = Справочники.ККСНГ_ПрисоединенныеФайлы.СоздатьЭлемент();
	Иначе
		ОбъектПрисоединенныйФайл = СсылкаСуществующего.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат ОбъектПрисоединенныйФайл;
	
КонецФункции

// Получает ссылку на присоединенный файл
//	Id - Идентификатор присоединенного файла
//	Владелец - ссылка на владельца возможные варианты: ККСНГ_ЭлектронныеДокументы, ККСНГ_Квитанции
//
// Параметры:
//
// Возвращаемое значение: 
//	Результат - ссылка, пустаяссылка - ссылка на справочник ККСНГ_ПрисоединенныеФайлы
//
Функция ПолучитьСсылкуПрисоединенныйФайл(Id, Владелец) Экспорт
	
	Возврат Справочники.ККСНГ_ПрисоединенныеФайлы.НайтиПоРеквизиту("Id", Id, , Владелец);
	
