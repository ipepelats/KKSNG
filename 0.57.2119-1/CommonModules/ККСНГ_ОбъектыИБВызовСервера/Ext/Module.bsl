#Область СлужебныйПрограммныйИнтерфейс

// Запись объекта ИБ с добавлением информации в журнал сообщений
//
// Параметры:
//  НекийОбъект    - Произвольный
//  ПараметрЗаписи - Структура - параметры записи объекта ИБ
//  Журнал         - Массив - журнал сообщений
//
// Возвращаемое значение: 
//  Булево
//
Функция ЗаписатьНекийОбъект(НекийОбъект, ПараметрЗаписи = Неопределено, Журнал = Неопределено) Экспорт
	
	МетаданныеСиноним = НекийОбъект.Метаданные().Синоним;
	
	Результат = Истина;
	
	Попытка
		
		Если ПараметрЗаписи = Неопределено Тогда
			НекийОбъект.Записать();
		Иначе
			НекийОбъект.Записать(ПараметрЗаписи);
		КонецЕсли;
		
	Исключение
		Ошибка = ОписаниеОшибки();
		Результат = Ложь;
	КонецПопытки;
	
	Если Журнал = Неопределено И НЕ Результат Тогда
		ВызватьИсключение Ошибка; 
	Иначе
		Если Результат Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Журнал, "Объект "+ Строка(НекийОбъект.Ссылка) + " успешно записан");
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Журнал, "Объект "+ МетаданныеСиноним + " не был записан." + Символы.ПС + Ошибка, "BD-00001");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Очищает РС ККСНГ_ПМ_ДопРеквизитыЭД по документу
//
// Параметры:
//  ДокументСсылка - Ссыылка на документ
//
// Возвращаемое значение: 
//  Ответ, см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ОчиститьДопРеквизитыДокумента(ДокументСсылка) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Очистка доп. реквизитов документа " + ДокументСсылка);

	Попытка 
		МодульМенеджераДопРеквизитыЭД = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("РегистрыСведений.ККСНГ_ПМ_ДопРеквизитыЭД");
		НаборЗаписей = МодульМенеджераДопРеквизитыЭД.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.СвязанныйДокумент.Установить(ДокументСсылка);
		
		НаборЗаписей.Записать();
		
		Ответ.Успех = Истина;
	Исключение
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки(), "RW-00014");
		
	КонецПопытки;
		
	Возврат Ответ;
	
КонецФункции

#Область ПрофилиОрганизаций

// Получает настройку обмена для организации (Профиль организации) по коду участника ЭДО
// 
// Параметры:
//  КодЭДО - Код участника ЭДО
//
// Возвращаемое значение: 
//  ПрофильОрганизацииСсылка - ссылка, пустая ссылка
//
Функция ПолучитьПрофильЭДООрганизацииПоКодуЭДО(Знач КодЭДО) Экспорт
	
	ПрофильОрганизацииСсылка = Справочники.ККСНГ_Организации.НайтиПоРеквизиту("КодУчастникаЭДО", КодЭДО);	
	
	Возврат ПрофильОрганизацииСсылка;
	
КонецФункции

// Получает настройку обмена для организации (Профиль организации) по документу// 
// Параметры:
//  КодЭДО - Код участника ЭДО
//
// Возвращаемое значение: 
//  ПрофильОрганизацииСсылка - ссылка, пустая ссылка
//
Функция ПолучитьПрофильЭДООрганизацииДокумента(Знач ЭлектронныйДокумент) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ККСНГ_Организации.Ссылка КАК ПрофильОрганизации
		|ИЗ
		|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
		|ГДЕ
		|	НЕ ККСНГ_Организации.ПометкаУдаления
		|	И ККСНГ_Организации.КодУчастникаЭДО = &КодУчастникаЭДО";
	
	Запрос.УстановитьПараметр("КодУчастникаЭДО", ЭлектронныйДокумент.КодЭДОВладельца);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ПрофильОрганизацииСсылка = ВыборкаДетальныеЗаписи.ПрофильОрганизации;
	Иначе 
		ПрофильОрганизацииСсылка = Справочники.ККСНГ_Организации.ПустаяСсылка();
	КонецЕсли;
		
	Возврат ПрофильОрганизацииСсылка;
	
КонецФункции

// Получает настройку обмена для организации (Профиль организации и контрагента) по документу
// Параметры:
//  ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//
// Возвращаемое значение:
//  Структура - ссылки или пустые ссылки на организацию и контрагента
//
Функция ПолучитьПрофильЭДООрганизацииИКонтрагентаДокумента(ЭлектронныйДокумент) Экспорт
	
	Перем Результат, ТекстЗапроса, Запрос, РезультатЗапроса, Выборка;
	
	Результат = Новый Структура;
	Результат.Вставить("ОрганизацияЭДО", Справочники.ККСНГ_Организации.ПустаяСсылка());
	Результат.Вставить("КонтрагентЭДО", Справочники.ККСНГ_Контрагенты.ПустаяСсылка());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЭлектронныеДокументы.ОрганизацияЭДО КАК ОрганизацияЭДО,
	|	ЕСТЬNULL(ККСНГ_Контрагенты.Ссылка, ЗНАЧЕНИЕ(Справочник.ККСНГ_Контрагенты.ПустаяСсылка)) КАК КонтрагентЭДО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ККСНГ_ЭлектронныеДокументы.Ссылка КАК ЭлектронныйДокумент,
	|		ЕСТЬNULL(ККСНГ_Организации.Ссылка, ЗНАЧЕНИЕ(Справочник.ККСНГ_Организации.ПустаяСсылка)) КАК ОрганизацияЭДО,
	|		ВЫБОР
	|			КОГДА ККСНГ_ЭлектронныеДокументы.НаправлениеЭД = ЗНАЧЕНИЕ(Перечисление.ККСНГ_НаправленияЭД.Входящий)
	|				ТОГДА ККСНГ_ЭлектронныеДокументы.SellerCode
	|			ИНАЧЕ ККСНГ_ЭлектронныеДокументы.BuyerCode
	|		КОНЕЦ КАК КодЭДОКонтрагента
	|	ИЗ
	|		Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|			ПО ККСНГ_ЭлектронныеДокументы.КодЭДОВладельца = ККСНГ_Организации.КодУчастникаЭДО
	|				И (НЕ ККСНГ_Организации.ПометкаУдаления)
	|	ГДЕ
	|		ККСНГ_ЭлектронныеДокументы.Ссылка = &ЭлектронныйДокумент) КАК ЭлектронныеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|		ПО ЭлектронныеДокументы.КодЭДОКонтрагента = ККСНГ_Контрагенты.КодУчастникаЭДО
	|			И ЭлектронныеДокументы.ОрганизацияЭДО = ККСНГ_Контрагенты.Владелец";
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат.ОрганизацияЭДО = Выборка.ОрганизацияЭДО;
		Результат.КонтрагентЭДО = Выборка.КонтрагентЭДО;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет способ авторизации токеном
//
// Параметры:
//  ПрофильОрганизации - Справочник.ККСНГ_Организации
