// Возвращает таблицу приглашений контрагентов, помещая в адрес временного хранилища
//
// Параметры:
//  ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//  АдресХранилища - Строка - Адрес во временном хранилище
//  ПараметрыАвторизации - Структура - Параметры авторизации в сервисе.
//						   Описание см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - ТаблицаЗначений - Сформированная таблица приглашений
//
Функция ПолучитьСписокПриглашений(ПрофильЭДООрганизации, АдресХранилища, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ТаблицаПриглашенийРезультат = Неопределено;
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение списка приглашений");
	ЗапросПриглашений = ККСНГ_APIКурьер.v2_RelationRequestListRequest(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПриглашений.Журнал, Ложь);
	
	Если ЗапросПриглашений.Успех Тогда
		
		ТаблицаПриглашений = ПолучитьНовуюТаблицуПриглашений();
		
		МассивПриглашений = ЗапросПриглашений.Результат.RelationRequestDetails;
		Для Каждого СтруктураПриглашения Из МассивПриглашений Цикл
			СтрокаПриглашение = ТаблицаПриглашений.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПриглашение, СтруктураПриглашения);
		КонецЦикла;
		
		Если ТаблицаПриглашений.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТаблицаПриглашений.Id КАК Id,
			|	ТаблицаПриглашений.IsLocal КАК IsLocal,
			|	ТаблицаПриглашений.SenderName КАК SenderName,
			|	ТаблицаПриглашений.SenderKpp КАК SenderKpp,
			|	ТаблицаПриглашений.SenderInn КАК SenderInn,
			|	ТаблицаПриглашений.Side КАК Side,
			|	ТаблицаПриглашений.Status КАК Status,
			|	ТаблицаПриглашений.StatusName КАК StatusName,
			|	ТаблицаПриглашений.Date КАК Date,
			|	ТаблицаПриглашений.AcceptionDate КАК AcceptionDate,
			|	ТаблицаПриглашений.UserId КАК UserId,
			|	ТаблицаПриглашений.UserName КАК UserName,
			|	ТаблицаПриглашений.Login КАК Login,
			|	ТаблицаПриглашений.AbonentCode КАК AbonentCode,
			|	ТаблицаПриглашений.ReceiverId КАК ReceiverId,
			|	ТаблицаПриглашений.ReceiverName КАК ReceiverName,
			|	ТаблицаПриглашений.ReceiverKpp КАК ReceiverKpp,
			|	ТаблицаПриглашений.ReceiverInn КАК ReceiverInn,
			|	ТаблицаПриглашений.Contacts КАК Contacts,
			|	ТаблицаПриглашений.Email КАК Email
			|ПОМЕСТИТЬ ВременнаяТаб
			|ИЗ
			|	&ТаблицаПриглашений КАК ТаблицаПриглашений
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВременнаяТаб.Id КАК Id,
			|	ВременнаяТаб.IsLocal КАК IsLocal,
			|	ВременнаяТаб.SenderName КАК SenderName,
			|	ВременнаяТаб.SenderKpp КАК SenderKpp,
			|	ВременнаяТаб.SenderInn КАК SenderInn,
			|	ВременнаяТаб.Side КАК Side,
			|	ВременнаяТаб.Status КАК Status,
			|	ВременнаяТаб.StatusName КАК StatusName,
			|	ВременнаяТаб.Date КАК Date,
			|	ВременнаяТаб.AcceptionDate КАК AcceptionDate,
			|	ВременнаяТаб.UserId КАК UserId,
			|	ВременнаяТаб.UserName КАК UserName,
			|	ВременнаяТаб.Login КАК Login,
			|	ВременнаяТаб.AbonentCode КАК AbonentCode,
			|	ВременнаяТаб.ReceiverId КАК ReceiverId,
			|	ВременнаяТаб.ReceiverName КАК ReceiverName,
			|	ВременнаяТаб.ReceiverKpp КАК ReceiverKpp,
			|	ВременнаяТаб.ReceiverInn КАК ReceiverInn,
			|	ВременнаяТаб.Contacts КАК Contacts,
			|	ВременнаяТаб.Email КАК Email,
			|	Контрагенты.Ссылка КАК Контрагент
			|ИЗ
			|	ВременнаяТаб КАК ВременнаяТаб
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
			|		ПО
			|ВЫБОР
			|	КОГДА ВременнаяТаб.SenderInn = &ИНН_Организации ТОГДА
			|		ВременнаяТаб.ReceiverInn = Контрагенты.ИНН
			|			И ВременнаяТаб.ReceiverKpp = Контрагенты.КПП
			|	ИНАЧЕ
			|		ВременнаяТаб.SenderInn = Контрагенты.ИНН
			|			И ВременнаяТаб.SenderKpp = Контрагенты.КПП
			|	КОНЕЦ
			|ГДЕ
			|	НЕ Контрагенты.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("ТаблицаПриглашений", ТаблицаПриглашений);
			Запрос.УстановитьПараметр("ИНН_Организации", ПрофильЭДООрганизации.Организация.ИНН);
			
			Попытка
				ТаблицаПриглашенийРезультат = Запрос.Выполнить().Выгрузить();
			Исключение
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
		ПоместитьВоВременноеХранилище(ТаблицаПриглашенийРезультат, АдресХранилища);
		Ответ.Результат = ТаблицаПриглашенийРезультат;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Определяет является ли контрагент обобленным подразделением Организации (Сбер)
//
// Параметры:
//   Контрагент - СправочникСсылка.ККСНГ_Контрагенты - Определяемый контрагент
//
// Возвращаемое значение:
//   Булево - Результат проверки
//
Функция ЭтоКонтрагентСбер(Знач Контрагент) Экспорт
	
	СберИНН = "7707083893";
	КонтрагентИНН = Неопределено;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.ККСНГ_Контрагенты") Тогда
		КонтрагентИНН = Контрагент.Контрагент.ИНН;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("Строка") Тогда
		КонтрагентИНН = Контрагент;
	КонецЕсли;
	
	Возврат (КонтрагентИНН = СберИНН);
	
КонецФункции

