Процедура СообщитьСтатусВыполненияЗадания(Описание, КоличествоОбработанных = 0, ОбщееКоличество = 100, АдресВременногоХранилища = "")
	
	Перем СтатусВыполнения, СообщениеПользователю;
	
	СтатусВыполнения = Новый Структура;
	СтатусВыполнения.Вставить("Описание", Описание);
	СтатусВыполнения.Вставить("КоличествоОбработанных", КоличествоОбработанных);
	СтатусВыполнения.Вставить("ОбщееКоличество", ОбщееКоличество);
	Если ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		СтатусВыполнения.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	КонецЕсли;
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = ЗначениеВСтрокуВнутр(СтатусВыполнения);
	СообщениеПользователю.Сообщить();
	
КонецПроцедуры

