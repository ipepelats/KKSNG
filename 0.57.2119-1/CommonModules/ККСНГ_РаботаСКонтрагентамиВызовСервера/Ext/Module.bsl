#Область ПрограммныйИнтерфейс

Процедура СинхронизироватьНовыхКонтрагентовФоном(ПараметрыАвторизации, ОрганизацияЭДО, АдресВременногоХранилища, ЗаписыватьСразу, ПроверятьВзаимосвязи, ТаблицаКонтрагентов) Экспорт
	
	Перем Ответ;
	Перем ЗапросКонтрагентов;
	Перем ОбщееКоличество, КоличествоОбработанных, КоличествоНайденных, ОписаниеСтатуса;
	Перем ОписаниеОшибки;
	Перем ЗапросИнформацииОКонтрагенте, Контрагент, СтрокаРезультата, НоваяСтрока;
	Перем СвойстваОбъекта, ЗаписьСвойств;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Результат = ТаблицаКонтрагентов.СкопироватьКолонки();
	ПоместитьВоВременноеХранилище(Ответ, АдресВременногоХранилища);
	
	// ----------------------------------------------------------
	
	СообщитьСтатусВыполненияЗадания("Получение списка контрагентов", , , АдресВременногоХранилища);
	
	ЗапросКонтрагентов = ПолучитьСписокКонтрагентовДляПоискаСКД(ОрганизацияЭДО, ТаблицаКонтрагентов);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКонтрагентов.Журнал, Ложь);
	
	Если Не ЗапросКонтрагентов.Успех Тогда
		ЗапросКонтрагентов = ПолучитьСписокКонтрагентовДляПоискаЗапросом(ОрганизацияЭДО, ТаблицаКонтрагентов);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКонтрагентов.Журнал, Ложь);
	КонецЕсли;
	
	Если Не ЗапросКонтрагентов.Успех Тогда
		СообщитьСтатусВыполненияЗадания("Ошибка", , , АдресВременногоХранилища);
		ПоместитьВоВременноеХранилище(Ответ, АдресВременногоХранилища);
		Возврат;
	КонецЕсли;
	
	// ----------------------------------------------------------
	
	СообщитьСтатусВыполненияЗадания("Получение данных из сервиса ЭДО", , , АдресВременногоХранилища);
	
	Ответ.Успех = Истина;
	ТаблицаКонтрагентов = ЗапросКонтрагентов.Результат;
	
	КоличествоОбработанных = 0;
	КоличествоНайденных = 0;
	ОбщееКоличество = ТаблицаКонтрагентов.Количество();
	СтрокиКУдалению = Новый Массив;
	
	Для каждого Контрагент Из ТаблицаКонтрагентов Цикл
		
		ОписаниеСтатуса = СтрШаблон("Получение данных из сервиса ЭДО: %1 / %2", XMLСтрока(КоличествоОбработанных), XMLСтрока(ОбщееКоличество));
		СообщитьСтатусВыполненияЗадания(ОписаниеСтатуса, КоличествоОбработанных, ОбщееКоличество, АдресВременногоХранилища);
		КоличествоОбработанных = КоличествоОбработанных + 1;
		
		Если ПустаяСтрока(Контрагент.КПП) Тогда
			ТекстСообщения = СтрШаблон("Получение информации о контрагенте %1, ИНН: %2", Контрагент.Контрагент, Контрагент.ИНН);
		Иначе
			ТекстСообщения = СтрШаблон("Получение информации о контрагенте %1, ИНН/КПП: %2/%3", Контрагент.Контрагент, Контрагент.ИНН, Контрагент.КПП);
		КонецЕсли;
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения);
		Если ПроверятьВзаимосвязи Тогда
			ЗапросИнформацииОКонтрагенте = ПолучитьИнформациюОКонтрагентеИзКурьераDiscover(ПараметрыАвторизации, Контрагент.ИНН, Контрагент.КПП);
		Иначе
			ЗапросИнформацииОКонтрагенте = ПолучитьИнформациюОКонтрагентеИзКурьераClient(ПараметрыАвторизации, Контрагент.ИНН, Контрагент.КПП);
		КонецЕсли;
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросИнформацииОКонтрагенте.Журнал, Ложь);
		
		Ответ.Успех = Ответ.Успех И ЗапросИнформацииОКонтрагенте.Успех;
		
		Если ЗапросИнформацииОКонтрагенте.Успех И ЗапросИнформацииОКонтрагенте.Результат.Количество() Тогда
			
			Для каждого СтрокаРезультата Из ЗапросИнформацииОКонтрагенте.Результат Цикл
				
				Если СтрСравнить(СтрокаРезультата.Code, ОрганизацияЭДО.КодУчастникаЭДО) = 0 Тогда
					// Собственную организацию не добавляем
					Продолжить;
				КонецЕсли;
				
				Контрагент.КодУчастникаЭДО = СтрокаРезультата.Code;
				Контрагент.КраткоеНаименование = СтрокаРезультата.Name;
				Контрагент.ИдентификаторСК = СтрокаРезультата.Id;
				
				Если ЗаписыватьСразу = Истина Тогда
					
					ЗаписьКонтрагента = ЗаписатьКонтрагентаЭДО(ОрганизацияЭДО, Контрагент.Контрагент, Контрагент.КодУчастникаЭДО, Контрагент.ИдентификаторСК);
					ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьКонтрагента.Журнал, Ложь);
					
					Если ЗаписьКонтрагента.Успех Тогда
						Контрагент.КонтрагентЭДО = ЗаписьКонтрагента.Результат;
					КонецЕсли;
					Ответ.Успех = Ответ.Успех И ЗаписьКонтрагента.Успех;
					
				КонецЕсли;
				
				Прервать;
				
			КонецЦикла;
			
		КонецЕсли;
		
		НоваяСтрока = Ответ.Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Контрагент);
		
		Если ПустаяСтрока(Контрагент.КодУчастникаЭДО) Тогда
			
			// Фиксируем дату поиска для тех, кого не нашли
			Если ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ЗапросИнформацииОКонтрагенте.Журнал) = Неопределено Тогда
				СвойстваОбъекта = Новый Структура;
				СвойстваОбъекта.Вставить("ИНН", Контрагент.ИНН);
				СвойстваОбъекта.Вставить("КПП", Контрагент.КПП);
				СвойстваОбъекта.Вставить("ДатаПоследнегоПоиска", ТекущаяДатаСеанса());
				Если ПроверятьВзаимосвязи Тогда
					ЗаписьСвойств = РегистрыСведений.ККСНГ_ДополнительныеСведения.УстановитьЗначенияСвойств(Контрагент.Контрагент, ОрганизацияЭДО, СвойстваОбъекта, Ложь);
				Иначе
					ЗаписьСвойств = РегистрыСведений.ККСНГ_ДополнительныеСведения.УстановитьЗначенияСвойств(Контрагент.Контрагент, Неопределено, СвойстваОбъекта, Ложь);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			КоличествоНайденных = КоличествоНайденных + 1;
			// Сохраняем промежуточный результат каждые 20 контрагентов
			Если КоличествоНайденных % 20 = 0 Тогда
				ПоместитьВоВременноеХранилище(Ответ, АдресВременногоХранилища);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, СтрШаблон("Найдено новых контрагентов: %1", XMLСтрока(Ответ.Результат.Количество())));
	
	// ----------------------------------------------------------
	
	СообщитьСтатусВыполненияЗадания("Почти готово", 100, , АдресВременногоХранилища);
	
	// Сортируем результаты, чтобы найденные контрагенты были в начале
	Для каждого СтрокаРезультата Из Ответ.Результат Цикл
		СтрокаРезультата.Пометка = Не ПустаяСтрока(СтрокаРезультата.КодУчастникаЭДО);
	КонецЦикла;
	Ответ.Результат.Сортировать("Пометка убыв, Контрагент");
	Ответ.Результат.ЗаполнитьЗначения(Ложь, "Пометка");
	
	ПоместитьВоВременноеХранилище(Ответ, АдресВременногоХранилища);
	
	Если Ответ.Успех Тогда
		СообщитьСтатусВыполненияЗадания("Завершено", 100, , АдресВременногоХранилища);
	Иначе
		СообщитьСтатусВыполненияЗадания("Завершено с ошибками", 100, , АдресВременногоХранилища);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает профиль контрагента соответствующий профилю организации
//
// Параметры:
//  ПрофильОрганизацииЭДО - СправочникСсылка.ККСНГ_Организации - Профиль организации
//	Контрагент - СправочникСсылка.Контаргенты - Связанный контрагент
//
// Возвращаемое значение:
//   СправочникСсылка.ККСНГ_Контрагенты - найденный профиль контрагента
//
Функция ПрофильКонтрагента(ПрофильОрганизацииЭДО, Контрагент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ККСНГ_Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|ГДЕ
	|	ККСНГ_Контрагенты.Контрагент = &Контрагент
	|	И НЕ ККСНГ_Контрагенты.ПометкаУдаления
	|	И ККСНГ_Контрагенты.Владелец = &ПрофильОрганизацииЭДО";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ПрофильОрганизацииЭДО", ПрофильОрганизацииЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ККСНГ_Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Возвращает профиль контрагента соответствующий профилю организации
//
// Параметры:
//  ПрофильОрганизацииЭДО - СправочникСсылка.ККСНГ_Организации - Профиль организации ЭДО
//	Контрагент - СправочникСсылка.Контаргенты - Связанный контрагент учетной системы
//
// Возвращаемое значение:
//   СправочникСсылка.ККСНГ_Контрагенты - найденный профиль контрагента
//
Функция ПрофильКонтрагентаПоКодуЭДО(ПрофильОрганизацииЭДО, КодУчастникаЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ККСНГ_Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|ГДЕ
	|	ККСНГ_Контрагенты.КодУчастникаЭДО = &КодУчастникаЭДО
	|	И НЕ ККСНГ_Контрагенты.ПометкаУдаления
	|	И ККСНГ_Контрагенты.Владелец = &ПрофильОрганизацииЭДО";
	
	Запрос.УстановитьПараметр("КодУчастникаЭДО", КодУчастникаЭДО);
	Запрос.УстановитьПараметр("ПрофильОрганизацииЭДО", ПрофильОрганизацииЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Проверяет ИНН на корректность с учетом длины и контрольных знаков
//
// Параметры:
//  ИНН					 - Строка				 - ИНН юридического или физического лица
//  ЭтоЮридическоеЛицо	 - Булево, Неопределено	 - признак проверки ИНН для юридического лица, в случае отсутствия определяется по длине ИНН
// 
// Возвращаемое значение:
//  Булево - результат проверки
//
Функция ЭтоКорректныйИНН(Знач ИНН, Знач ЭтоЮридическоеЛицо = Неопределено) Экспорт
	
	Перем Результат;
	Перем Индекс, Цифра;
	Перем Множители, Множитель, Множитель11, Множитель12;
	Перем КонтрольнаяСумма, КонтрольнаяСумма11, КонтрольнаяСумма12, КонтрольныйРазряд, КонтрольныйРазряд11, КонтрольныйРазряд12;
	
	Результат = Ложь;
	
	ИНН = СокрЛП(ИНН);
	ЭтоЮридическоеЛицо = ?(ЗначениеЗаполнено(ЭтоЮридическоеЛицо), ЭтоЮридическоеЛицо, СтрДлина(ИНН) = 10);
	
	Если ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЦифрыВСтроке(ИНН) Тогда
		
		Если ЭтоЮридическоеЛицо И СтрДлина(ИНН) = 10 Тогда
			
			Множители = Новый Соответствие;
			Множители.Вставить(1, 2);
			Множители.Вставить(2, 4);
			Множители.Вставить(3, 10);
			Множители.Вставить(4, 3);
			Множители.Вставить(5, 5);
			Множители.Вставить(6, 9);
			Множители.Вставить(7, 4);
			Множители.Вставить(8, 6);
			Множители.Вставить(9, 8);
			КонтрольнаяСумма = 0;
			
			Для Индекс = 1 По 9 Цикл
				Множитель = Множители[Индекс];
				Цифра = Число(Сред(ИНН, Индекс, 1));
				КонтрольнаяСумма = КонтрольнаяСумма + Цифра * Множитель;
			КонецЦикла;
			
			КонтрольныйРазряд = (КонтрольнаяСумма %11) %10;
			
			Результат = (КонтрольныйРазряд = Число(Сред(ИНН, 10, 1)));
			
		ИначеЕсли Не ЭтоЮридическоеЛицо И СтрДлина(ИНН) = 12 Тогда
			
			Множители = Новый Соответствие;
			Множители.Вставить(1,  Новый Структура("М11, М12", 7,  3));
			Множители.Вставить(2,  Новый Структура("М11, М12", 2,  7));
			Множители.Вставить(3,  Новый Структура("М11, М12", 4,  2));
			Множители.Вставить(4,  Новый Структура("М11, М12", 10, 4));
			Множители.Вставить(5,  Новый Структура("М11, М12", 3, 10));
			Множители.Вставить(6,  Новый Структура("М11, М12", 5,  3));
			Множители.Вставить(7,  Новый Структура("М11, М12", 9,  5));
			Множители.Вставить(8,  Новый Структура("М11, М12", 4,  9));
			Множители.Вставить(9,  Новый Структура("М11, М12", 6,  4));
			Множители.Вставить(10, Новый Структура("М11, М12", 8,  6));
			Множители.Вставить(11, Новый Структура("М11, М12", 0,  8));
			
			КонтрольнаяСумма11 = 0;
			КонтрольнаяСумма12 = 0;
			
			Для Индекс = 1 По 11 Цикл
				Множитель11 = Множители[Индекс].М11;
				Множитель12 = Множители[Индекс].М12;
				Цифра = Число(Сред(ИНН, Индекс, 1));
				КонтрольнаяСумма11 = КонтрольнаяСумма11 + Цифра * Множитель11;
				КонтрольнаяСумма12 = КонтрольнаяСумма12 + Цифра * Множитель12;
			КонецЦикла;
			
			КонтрольныйРазряд11 = (КонтрольнаяСумма11 %11) %10;
			КонтрольныйРазряд12 = (КонтрольнаяСумма12 %11) %10;
			
			Результат = (КонтрольныйРазряд11 = Число(Сред(ИНН,11,1)) И КонтрольныйРазряд12 = Число(Сред(ИНН,12,1)));
			
		Иначе
			
			Результат = Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет ИНН на корректность с учетом длины и контрольных знаков и заполнение КПП цифрами для юридического лица
//
// Параметры:
//  ИНН	 - Строка	 - ИНН юридического или физического лица
//  КПП	 - Строка	 - КПП юридического лица
// 
// Возвращаемое значение:
//  Булево - результат проверки
//
Функция ЭтоКорректныеИННКПП(Знач ИНН, Знач КПП) Экспорт
	
	Перем Результат;
	Перем Индекс, Цифра;
	Перем Множители, Множитель, Множитель11, Множитель12;
	Перем КонтрольнаяСумма, КонтрольнаяСумма11, КонтрольнаяСумма12, КонтрольныйРазряд, КонтрольныйРазряд11, КонтрольныйРазряд12;
	
	Результат = Ложь;
	
	Если ЭтоКорректныйИНН(ИНН) Тогда
		
		Если СтрДлина(ИНН) = 10 Тогда
			Результат = Не ПустаяСтрока(КПП) И ККСНГ_ОбщегоНазначенияКлиентСервер.ТолькоЦифрыВСтроке(КПП);
		Иначе
			Результат = (КПП = "");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьТекстЗапросаКонтрагентовДляПоиска() Экспорт
	
	Перем ТекстЗапроса;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	ЕСТЬNULL(ККСНГ_ДополнительныеСведения.ДатаПоследнегоПоиска, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнегоПоиска
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
	|		ПО Контрагенты.Ссылка = ККСНГ_Контрагенты.Контрагент
	|			И (ККСНГ_Контрагенты.Владелец = &Организация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ККСНГ_ДополнительныеСведения.Объект КАК Объект,
	|			ККСНГ_ДополнительныеСведения.ИНН КАК ИНН,
	|			ККСНГ_ДополнительныеСведения.КПП КАК КПП,
	|			МАКСИМУМ(ККСНГ_ДополнительныеСведения.ДатаПоследнегоПоиска) КАК ДатаПоследнегоПоиска
	|		ИЗ
	|			РегистрСведений.ККСНГ_ДополнительныеСведения КАК ККСНГ_ДополнительныеСведения
	|		ГДЕ
	|			(ККСНГ_ДополнительныеСведения.ПрофильЭДООрганизации = &Организация
	|					ИЛИ ККСНГ_ДополнительныеСведения.ПрофильЭДООрганизации = ЗНАЧЕНИЕ(Справочник.ККСНГ_Организации.ПустаяСсылка))
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ККСНГ_ДополнительныеСведения.Объект,
	|			ККСНГ_ДополнительныеСведения.ИНН,
	|			ККСНГ_ДополнительныеСведения.КПП) КАК ККСНГ_ДополнительныеСведения
	|		ПО Контрагенты.Ссылка = ККСНГ_ДополнительныеСведения.Объект
	|			И Контрагенты.ИНН = ККСНГ_ДополнительныеСведения.ИНН
	|			И Контрагенты.КПП = ККСНГ_ДополнительныеСведения.КПП
	|ГДЕ
	|	ККСНГ_Контрагенты.Ссылка ЕСТЬ NULL
	|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
	|	И Контрагенты.ИНН <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ИнициализоватьСхемуКомпоновкиДанныхДляПоискаКонтрагентов(СхемаКомпоновки, КомпоновщикНастроек, УникальныйИдентификатор = Неопределено) Экспорт
	
	Перем ТекстЗапроса, АдресСхемыКомпоновки, ИсточникНастроек, СохраненнаяНастройка;
	
	Если СхемаКомпоновки = Неопределено Тогда
		ТекстЗапроса = ПолучитьТекстЗапросаКонтрагентовДляПоиска();
		СхемаКомпоновки = ККСНГ_ОбщегоНазначения.ПолучитьСхемуКомпоновкиДанныхИзЗапроса(ТекстЗапроса);
	КонецЕсли;
	
	Если КомпоновщикНастроек = Неопределено Тогда
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КонецЕсли;
	
	АдресСхемыКомпоновки = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновки);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	СохраненнаяНастройка = РегистрыСведений.ККСНГ_Настройки.ПолучитьНастройкуПоискаКонтрагентов();
	Если ТипЗнч(СохраненнаяНастройка) = Тип("НастройкиКомпоновкиДанных") Тогда
		Попытка
			КомпоновщикНастроек.ЗагрузитьНастройки(СохраненнаяНастройка);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокКонтрагентовДляПоискаЗапросом(ОрганизацияЭДО, ТаблицаКонтрагентов) Экспорт
	
	Перем Ответ;
	Перем ТекстЗапроса, Запрос, Выборка;
	Перем Результат, НоваяСтрока;
	Перем ТекстСообщения, ОписаниеОшибки;
	
	ТекстСообщения = СтрШаблон("Получение списка контрагентов для поиска в сервисе ЭДО (%1)", ОрганизацияЭДО);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ТекстСообщения);
	
	Результат = ТаблицаКонтрагентов.СкопироватьКолонки();
	
	ТекстЗапроса = ПолучитьТекстЗапросаКонтрагентовДляПоиска();
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.Параметры.Вставить("Организация", ОрганизацияЭДО);
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка выполнения запроса к таблице контрагентов 1С", "RI-00101", ОписаниеОшибки);
		Возврат Ответ;
		
	КонецПопытки;
	
	Пока Выборка.Следующий() Цикл
		Попытка
			
			Если ЭтоКорректныеИННКПП(Выборка.ИНН, Выборка.КПП) Тогда
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЕсли;
			
		Исключение
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон("Найдено контрагентов с заполненными ИНН/КПП: %1", XMLСтрока(Результат.Количество()));
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения);
	
	Ответ.Результат = Результат;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьСписокКонтрагентовДляПоискаСКД(ОрганизацияЭДО, ТаблицаКонтрагентов) Экспорт
	
	Перем Ответ;
	Перем ТекстСообщения, ОписаниеОшибки, Результат, СтрокаРезультата, НоваяСтрока;
	Перем СхемаКомпоновки, КомпоновщикНастроек, ЗначенияПараметров;
	Перем КомпоновщикМакета, МакетКомпоновки, ПроцессорКомпоновки, ПроцессорВывода, ТаблицаРезультата;
	
	ТекстСообщения = СтрШаблон("Получение списка контрагентов для поиска в сервисе ЭДО (%1)", ОрганизацияЭДО);
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ТекстСообщения);
	
	ЗначенияПараметров = Новый Соответствие;
	ЗначенияПараметров.Вставить("Организация", ОрганизацияЭДО);
	ИнициализоватьСхемуКомпоновкиДанныхДляПоискаКонтрагентов(СхемаКомпоновки, КомпоновщикНастроек);
	ККСНГ_ОбщегоНазначения.ЗаполнитьНастройкиСхемыКомпоновкиДанных(КомпоновщикНастроек, ЗначенияПараметров);
	
	Попытка
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		
		ТаблицаРезультата = Новый ТаблицаЗначений;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ТаблицаРезультата);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Не удалось выполнить схему компоновки данных", "RI-00103", ОписаниеОшибки);
		Возврат Ответ;
		
	КонецПопытки;
	
	Результат = ТаблицаКонтрагентов.СкопироватьКолонки();
	Для каждого СтрокаРезультата Из ТаблицаРезультата Цикл
		Если ЭтоКорректныеИННКПП(СтрокаРезультата.ИНН, СтрокаРезультата.КПП) Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
			НоваяСтрока["Организация"] = ОрганизацияЭДО;
		КонецЕсли;
	КонецЦикла;
	
	Ответ.Результат = Результат;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

