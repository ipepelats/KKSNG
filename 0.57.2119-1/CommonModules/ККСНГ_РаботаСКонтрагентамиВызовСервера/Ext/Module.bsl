	//КонецЕсли;
	//ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения);
	
	ЗапросAPI = ККСНГ_APIКурьер.v2_Client(ПараметрыАвторизации, ИНН, , КПП);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		Ответ.Результат = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗапросAPI.Результат, "Company");
		Ответ.Успех = ЗапросAPI.Успех;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает информацию о компании по ИНН и КПП
//
// Параметры:
//  ПараметрыАвторизации - Структура - Параметры авторизации в сервисе.
//						   Описание см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации
//  ИНН					 - 	Строка - ИНН контрагента
//  КПП					 - 	Строка - КПП контрагента
//
// Возвращаемое значение:
//  Ответ - Структура - Результат запроса
//
Функция ПолучитьИнформациюОКонтрагентеИзКурьераDiscover(ПараметрыАвторизации, ИНН, КПП) Экспорт
	
	Перем Ответ, ТекстСообщения, ЗапросAPI;
	Перем ClientDiscovery, ArrayOfClientDiscovery, ClientRelation, ArrayOfClientRelation;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	//Если ПустаяСтрока(КПП) Тогда
	//	ТекстСообщения = СтрШаблон("Получение информации о контрагенте, ИНН: %1", ИНН);
	//Иначе
	//	ТекстСообщения = СтрШаблон("Получение информации о контрагенте, ИНН/КПП: %1/%2", ИНН, КПП);
	//КонецЕсли;
	//ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения);
	
	ClientDiscovery = Новый Структура;
	ClientDiscovery.Вставить("Inn", ИНН);
	ClientDiscovery.Вставить("Kpp", КПП);
	
	ArrayOfClientDiscovery = Новый Массив;
	ArrayOfClientDiscovery.Добавить(ClientDiscovery);
	
	ClientDiscovery = Новый Структура("ClientDiscovery", ArrayOfClientDiscovery);
	
	ЗапросAPI = ККСНГ_APIКурьер.v2_ClientDiscover(ПараметрыАвторизации, ClientDiscovery);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		
		ArrayOfClientRelation = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗапросAPI.Результат, "ClientRelation");
		Если ТипЗнч(ArrayOfClientRelation) = Тип("Массив") И ArrayOfClientRelation.Количество() > 0 Тогда
			
			Ответ.Результат = Новый Массив;
			
			Для каждого ClientRelation Из ArrayOfClientRelation Цикл
				Если СтрСравнить(ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ClientRelation, "Status"), "Exists") = 0 Тогда
					Ответ.Результат.Добавить(ClientRelation);
					Ответ.Успех = Истина;
				КонецЕсли;
			КонецЦикла
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ЗаписатьКонтрагентаЭДО(ПрофильЭДООрганизации, Контрагент, КодУчастникаЭДО, ИдентификаторСК) Экспорт
	
	Перем Ответ, ТекстСообщения, ОписаниеОшибки;
	Перем БлокировкаДанных, ЭлементБлокировки;
	Перем КонтрагентЭДОСсылка, КонтрагентЭДООбъект;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ТекстСообщения = СтрШаблон("Запись контрагента ЭДО: %1", Контрагент);
	ТекстКомментария = СтрШаблон("Код ЭДО '%1', идентификатор '%2'", КодУчастникаЭДО, XMLСтрока(ИдентификаторСК));
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, ТекстСообщения, ТекстКомментария, Контрагент);
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных();
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.ККСНГ_Контрагенты");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Владелец", ПрофильЭДООрганизации);
		ЭлементБлокировки.УстановитьЗначение("Контрагент", Контрагент);
		БлокировкаДанных.Заблокировать();
		
		КонтрагентЭДОСсылка = Справочники.ККСНГ_Контрагенты.НайтиПоРеквизиту("Контрагент", Контрагент, , ПрофильЭДООрганизации); 
		
		Если ЗначениеЗаполнено(КонтрагентЭДОСсылка) Тогда
			КонтрагентЭДООбъект = КонтрагентЭДОСсылка.ПолучитьОбъект();
		Иначе
			КонтрагентЭДООбъект = Справочники.ККСНГ_Контрагенты.СоздатьЭлемент();
		КонецЕсли;
		
		КонтрагентЭДООбъект.Владелец = ПрофильЭДООрганизации;
		КонтрагентЭДООбъект.Контрагент = Контрагент;
		КонтрагентЭДООбъект.КодУчастникаЭДО = КодУчастникаЭДО;
		КонтрагентЭДООбъект.ИдентификаторСК = ИдентификаторСК;
		КонтрагентЭДООбъект.Записать();
		
		ЗафиксироватьТранзакцию();
		
		Ответ.Результат = КонтрагентЭДООбъект.Ссылка;
		Ответ.Успех = Истина;
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ОписаниеОшибки = ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Не удалось записать контрагента ЭДО", "RI-00102", ОписаниеОшибки, Контрагент);
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

