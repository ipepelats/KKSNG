Функция ОтправительСовпадаетСПолучателем(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "matchclient");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
КонецФункции

Функция СуществуетЗаблокированнаяВзаимосвязь(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "blocked");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
КонецФункции

Процедура ПроверитьДанныеКонтрагента(Ответ, Контрагент, КонтрагентИНН)
	
	Если НЕ ЗначениеЗаполнено(КонтрагентИНН) Тогда
		
		ТекстОшибки = НСтр("ru = 'У контрагента %1 не заполнен ИНН'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00002", , Контрагент);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(Ответ.Журнал);
		
	ИначеЕсли НЕ ККСНГ_РаботаСКонтрагентамиВызовСервера.КорректныйИНН(КонтрагентИНН) Тогда
		
		ТекстОшибки = НСтр("ru = 'У контрагента %1 указан некорректный ИНН %2'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент, КонтрагентИНН);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00002", , Контрагент);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(Ответ.Журнал);
	Иначе
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ОчиститьОтозванныеПриглашенияЛокально(Приглащения, ПрофильЭДООрганизации)
	
	НомераОтозванныхПриглашений = ПолучитьНомераОтозванныхПриглашений(Приглащения, ПрофильЭДООрганизации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|  ККСНГ_Приглашения.ПрофильЭДООрганизации КАК ПрофильЭДООрганизации,
	|  ККСНГ_Приглашения.Id КАК Id
	|ИЗ
	|  РегистрСведений.ККСНГ_Приглашения КАК ККСНГ_Приглашения
	|ГДЕ
	|  ККСНГ_Приглашения.Id В(&НомераОтозванныхПриглашений)
	|  И ККСНГ_Приглашения.ПрофильЭДООрганизации = &ПрофильЭДООрганизации";
	
	Запрос.УстановитьПараметр("НомераОтозванныхПриглашений", НомераОтозванныхПриглашений);
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УдалитьПриглашение(Выборка.ПрофильЭДООрганизации, Выборка.Id);  
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьНомераОтозванныхПриглашений(Приглашения, ПрофильЭДООрганизации)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|  ККСНГ_Приглашения.Id КАК НомерПриглашения
	|ИЗ
	|  РегистрСведений.ККСНГ_Приглашения КАК ККСНГ_Приглашения
	|ГДЕ
	|  НЕ ККСНГ_Приглашения.Id В (&Id)
	|  И ККСНГ_Приглашения.Status = ""Processed""
	|  И ККСНГ_Приглашения.ПрофильЭДООрганизации = &ПрофильЭДООрганизации
	|  И ККСНГ_Приглашения.Side = ""Receiver""";
	
	Запрос.УстановитьПараметр("Id", ПолучитьНомераПриглашенийОжидающихПодтверждения(Приглашения));
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	НомераОтозванныхПриглашений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерПриглашения");
	
	Возврат НомераОтозванныхПриглашений;
	
КонецФункции

Функция ПолучитьНомераПриглашенийОжидающихПодтверждения(Приглашения)
	
	НомераПриглашений = Новый Массив;
	Для каждого Приглашение Из Приглашения Цикл
		Если НРег(СокрЛП(Приглашение.Status)) = "processed" Тогда
			НомераПриглашений.Добавить(Приглашение.Id);	
		КонецЕсли;		
	КонецЦикла;
	
	Возврат НомераПриглашений;
	
КонецФункции

Процедура УстановитьКонтрагентаПолучателя(Приглашения, НовыеКонтрагенты, ПрофильЭДООрганизации, Ответ, КоличествоЗаписанных)

	Для каждого ТекПриглашение Из Приглашения Цикл
		
		КонтрагентПолучательСсылка = Неопределено;
		Если НЕ НовыеКонтрагенты = Неопределено И НРЕГ(ТекПриглашение.side) = "sender" И НРЕГ(ТекПриглашение.status) = "processed" Тогда
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ИНН", ТекПриглашение.ReceiverInn);
			СтруктураПоиска.Вставить("КПП", ТекПриглашение.ReceiverKpp);
			РезультатПоиска = НовыеКонтрагенты.НайтиСтроки(СтруктураПоиска);
			Если РезультатПоиска.Количество() > 0 Тогда
				КонтрагентПолучательСсылка = РезультатПоиска[0].Контрагент;	
			КонецЕсли;
		КонецЕсли;
		
		ЗаписьПриглашения = ЗаписатьПриглашение(ПрофильЭДООрганизации, ТекПриглашение.Id, ТекПриглашение, , КонтрагентПолучательСсылка);
		Если ЗаписьПриглашения.Успех Тогда
			КоличествоЗаписанных = КоличествоЗаписанных + 1;
			Если ЗаписьПриглашения.СозданоНовое Тогда
				Ответ.Результат.КоличествоНовыхПриглашений = Ответ.Результат.КоличествоНовыхПриглашений + 1;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

#КонецОбласти