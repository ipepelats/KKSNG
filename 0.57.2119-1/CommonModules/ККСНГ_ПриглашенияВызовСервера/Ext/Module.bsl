Функция МассивДанныхКонтрагентов(ТЗ)

	МассивДанныхКонтрагентов = Новый Массив;
	ТаблицаID = Новый ТаблицаЗначений;
	ТаблицаID.Колонки.Добавить("Inn", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
	ТаблицаID.Колонки.Добавить("Kpp", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	ТаблицаID.Колонки.Добавить("Id", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Для каждого Выборка Из ТЗ Цикл
	
		ДанныеПоКонтрагентам = Новый Структура;
		ДанныеПоКонтрагентам.Вставить("inn", Выборка.Inn);
		ДанныеПоКонтрагентам.Вставить("kpp", Выборка.Kpp);
		МассивДанныхКонтрагентов.Добавить(ДанныеПоКонтрагентам);
		
		НоваяСтрока = ТаблицаID.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	
	КонецЦикла;
	
	ДанныеClientDiscovery = Новый Структура;
	ДанныеClientDiscovery.Вставить("ClientDiscovery", МассивДанныхКонтрагентов);
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеClientDiscovery", ДанныеClientDiscovery);
	Результат.Вставить("ТаблицаID", ТаблицаID);
	
	Возврат Результат;

КонецФункции

Функция СоздатьПрофилиПринятыхПриглашений(ПрофильЭДООрганизации, Приглашения, ПараметрыАвторизации)

	Результат = Новый Структура;
	Результат.Вставить("ИнформацияПоНовымПрофилям", "");
	Результат.Вставить("КоличествоНовыхПрофилей", 0);
	
	МассивТекущихID = Новый Массив;
	МассивДанныхКонтрагентов = Новый Массив;
	
	Для каждого ТекПриглашение Из Приглашения Цикл
		МассивТекущихID.Добавить(ТекПриглашение.Id);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрСведенийККСНГ_Приглашения.Id КАК Id,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverInn КАК ReceiverInn,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverKpp КАК ReceiverKpp,
	|	РегистрСведенийККСНГ_Приглашения.AbonentCode КАК Code,
	|	РегистрСведенийККСНГ_Приглашения.КонтрагентПолучатель КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ККСНГ_Контрагенты.пустаяСсылка) КАК Профиль
	|ИЗ
	|	РегистрСведений.ККСНГ_Приглашения КАК РегистрСведенийККСНГ_Приглашения
	|ГДЕ
	|	НЕ РегистрСведенийККСНГ_Приглашения.Id В (&МассивТекущихID)
	|	И РегистрСведенийККСНГ_Приглашения.ПрофильЭДООрганизации = &ПрофильЭДООрганизации";
	Запрос.УстановитьПараметр("МассивТекущихID", МассивТекущихID);
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеПоКонтрагентам = Новый Структура;
		ДанныеПоКонтрагентам.Вставить("inn", Выборка.ReceiverInn);
		ДанныеПоКонтрагентам.Вставить("kpp", Выборка.ReceiverKpp);
		МассивДанныхКонтрагентов.Добавить(ДанныеПоКонтрагентам);
	КонецЦикла;

	ДанныеClientDiscovery = Новый Структура;
	ДанныеClientDiscovery.Вставить("ClientDiscovery", МассивДанныхКонтрагентов);
	Ответ = ККСНГ_APIКурьер.v2_ClientDiscover(ПараметрыАвторизации, ДанныеClientDiscovery);
	Если Ответ.Успех Тогда
		
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("Code", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(47)));
		ТаблицаДанных.Колонки.Добавить("Inn", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
		ТаблицаДанных.Колонки.Добавить("Kpp", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
		ТаблицаДанных.Колонки.Добавить("Name", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
		ТаблицаДанных.Колонки.Добавить("Id", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 0, ДопустимыйЗнак.Неотрицательный)));
		
		Для каждого ТекущееСостояние Из Ответ.Результат.ClientRelation Цикл
			Если Нрег(ТекущееСостояние.Status) = "exists" Тогда
				НоваяСтрока = ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущееСостояние);				
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаДанных = ДополнитьТаблицуКонтрагентов(ТаблицаДанных, ПрофильЭДООрганизации);
		
		Для каждого ТекущийКонтрагент Из ТаблицаДанных Цикл
			ПрофильСоздан = ОбработатьКонтрагента(ТекущийКонтрагент, ПрофильЭДООрганизации);
			Если ПрофильСоздан Тогда
				Результат.ИнформацияПоНовымПрофилям = Результат.ИнформацияПоНовымПрофилям + Символы.ПС + ТекущийКонтрагент.Контрагент;
				Результат.КоличествоНовыхПрофилей = Результат.КоличествоНовыхПрофилей + 1;
				УстановитьСтатусПриглашенияПринят(ПрофильЭДООрганизации, ТекущийКонтрагент.Id);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДополнитьТаблицуКонтрагентов(ТаблицаДанных, ПрофильЭДООрганизации)

	Запрос = Новый Запрос;
	Запрос.Текст =
 	"ВЫБРАТЬ
 	|	ТЗ.Inn КАК Inn,
 	|	ТЗ.Kpp КАК Kpp,
 	|	ТЗ.Code КАК Code
 	|ПОМЕСТИТЬ ТЗ
 	|ИЗ
 	|	&ТаблицаДанных КАК ТЗ
 	|;
 	|
 	|////////////////////////////////////////////////////////////////////////////////
 	|ВЫБРАТЬ
 	|	РегистрСведенийККСНГ_Приглашения.Id КАК Id,
 	|	ТЗ.Code КАК Code,
 	|	МАКСИМУМ(ВЫБОР
 	|			КОГДА РегистрСведенийККСНГ_Приглашения.КонтрагентПолучатель ЕСТЬ NULL
 	|					ИЛИ РегистрСведенийККСНГ_Приглашения.КонтрагентПолучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
 	|				ТОГДА Контрагенты.Ссылка
 	|			ИНАЧЕ РегистрСведенийККСНГ_Приглашения.КонтрагентПолучатель
 	|		КОНЕЦ) КАК Контрагент,
 	|	МАКСИМУМ(ВЫБОР
 	|			КОГДА ККСНГ_Контрагенты.Ссылка ЕСТЬ NULL
 	|				ТОГДА ЗНАЧЕНИЕ(Справочник.ККСНГ_Контрагенты.ПустаяСсылка)
 	|			ИНАЧЕ ККСНГ_Контрагенты.Ссылка
 	|		КОНЕЦ) КАК Профиль
 	|ИЗ
 	|	ТЗ КАК ТЗ
 	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ККСНГ_Приглашения КАК РегистрСведенийККСНГ_Приглашения
 	|		ПО ТЗ.Inn = РегистрСведенийККСНГ_Приглашения.ReceiverInn
 	|			И ТЗ.Kpp = РегистрСведенийККСНГ_Приглашения.ReceiverKpp
 	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
 	|		ПО ТЗ.Code = ККСНГ_Контрагенты.КодУчастникаЭДО
 	|			И (НЕ ККСНГ_Контрагенты.ПометкаУдаления)
 	|			И (ККСНГ_Контрагенты.Владелец = &ПрофильЭДООрганизации)
 	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
 	|		ПО ТЗ.Inn = Контрагенты.ИНН
 	|			И ТЗ.Kpp = Контрагенты.КПП
 	|ГДЕ
 	|	РегистрСведенийККСНГ_Приглашения.ПрофильЭДООрганизации = &ПрофильЭДООрганизации
 	|	И РегистрСведенийККСНГ_Приглашения.Side = ""sender""
 	|	И РегистрСведенийККСНГ_Приглашения.Status = ""processed""
 	|
 	|СГРУППИРОВАТЬ ПО
 	|	РегистрСведенийККСНГ_Приглашения.Id,
 	|	ТЗ.Code";
	
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция УстановитьСтатусПриглашенияПринят(Знач ПрофильЭДООрганизации, Знач Id)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ККСНГ_Приглашения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПрофильЭДООрганизации = ПрофильЭДООрганизации;
		МенеджерЗаписи.Id = Id;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Status = "Accepted";	
			МенеджерЗаписи.StatusName = "Запрос принят/Взаимосвязь активна";
			МенеджерЗаписи.Записать();
		КонецЕсли;
		Ответ.Успех = Истина;
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстОшибки = "Ошибка установки статуса ""Принято"" приглашения организации по Id " + Id;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00001", ОписаниеОшибки); 		
	КонецПопытки;	
	
	Возврат Ответ;
	
КонецФункции

Функция СтатусОтправкиПриглашения(Контрагент, КодСтатуса)
	Возврат Новый Структура("Контрагент, КодСтатуса", Контрагент, КодСтатуса);	 	
КонецФункции

Функция ЗаписатьПриглашение(Знач ПрофильЭДООрганизации, 
							Знач Id, Приглашение = Неопределено, 
							Обработано = Неопределено, 
							КонтрагентПолучательСсылка = Неопределено)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Вставить("СозданоНовое", Ложь);
	
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ККСНГ_Приглашения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПрофильЭДООрганизации = ПрофильЭДООрганизации;
		МенеджерЗаписи.Id = Id;
		МенеджерЗаписи.Прочитать();
		
		Если Не КонтрагентПолучательСсылка = Неопределено Тогда
			МенеджерЗаписи.КонтрагентПолучатель = КонтрагентПолучательСсылка;
		КонецЕсли;				
		
		Если МенеджерЗаписи.Выбран() Тогда
			
			МенеджерЗаписи.Счетчик = МенеджерЗаписи.Счетчик + 1;
			
			Если Обработано <> Неопределено Тогда
				МенеджерЗаписи.Обработано = Обработано;
				МенеджерЗаписи.Записать();
			Иначе	
				МенеджерЗаписи.Status = Приглашение.Status;
				МенеджерЗаписи.StatusName = Приглашение.StatusName;
				МенеджерЗаписи.Записать();				
			КонецЕсли;
			
		Иначе
			
			МенеджерЗаписи.ПрофильЭДООрганизации = ПрофильЭДООрганизации;
			МенеджерЗаписи.Id = Id;
			Если Приглашение <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Приглашение);
			КонецЕсли;
			МенеджерЗаписи.Записать();
			Ответ.СозданоНовое = Истина;
			
		КонецЕсли;
		
		Ответ.Успех = Истина;
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстОшибки = "Ошибка записи приглашения организации по участнику " + ПрофильЭДООрганизации.КодУчастникаЭДО;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00001", ОписаниеОшибки); 		
	КонецПопытки;	
	
	Возврат Ответ;
	
КонецФункции

Функция УдалитьПриглашение(Знач ПрофильЭДООрганизации, Знач Id)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ККСНГ_Приглашения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПрофильЭДООрганизации = ПрофильЭДООрганизации;
		МенеджерЗаписи.Id = Id;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
		Ответ.Успех = Истина;
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстОшибки = "Ошибка удаления записи приглашения организации по Id " + Id;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00001", ОписаниеОшибки); 		
	КонецПопытки;	
	
	Возврат Ответ;
	
КонецФункции	

Функция ОбработатьКонтрагента(ДанныеКонтрагента, ПрофильЭДООрганизации, ТихийРежим = Истина)

	Если ЗначениеЗаполнено(ДанныеКонтрагента.Профиль) Тогда
		
		Попытка
			Профиль = ДанныеКонтрагента.Профиль.ПолучитьОбъект();
			Профиль.КодУчастникаЭДО = ДанныеКонтрагента.Code;
			Профиль.Записать();
			Если НЕ ТихийРежим Тогда
				ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Записан профиль " + Профиль.Наименование);	
			КонецЕсли;
			Возврат Истина;
		Исключение
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			Возврат Ложь;		
		КонецПопытки;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ДанныеКонтрагента.Контрагент) Тогда
			Если НЕ ТихийРежим Тогда
				ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен контрагент по ID = " + ДанныеКонтрагента.Id);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
		
		Попытка
			НовыйПрофиль = Справочники.ККСНГ_Контрагенты.СоздатьЭлемент();
			НовыйПрофиль.Владелец = ПрофильЭДООрганизации;
			НовыйПрофиль.КодУчастникаЭДО = ДанныеКонтрагента.Code;
			НовыйПрофиль.Контрагент = ДанныеКонтрагента.Контрагент;
			НовыйПрофиль.Наименование = СокрЛП(ПрофильЭДООрганизации.Наименование) + " <-> " + СокрЛП(ДанныеКонтрагента.Контрагент.Наименование);
			НовыйПрофиль.ВариантНастройкиОбмена = "Использовать настройки организации";
			НовыйПрофиль.Записать();
			Если НЕ ТихийРежим Тогда
				ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан профиль " + НовыйПрофиль.Наименование);
			КонецЕсли;
			Возврат Истина;
		Исключение
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			Возврат Ложь;		
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗарегистрированныхКонтрагентов1С(ПараметрыАвторизации, Знач ЗарегистрированныеКонтрагентыЭДО, Знач ВыбранныеКонтрагенты1С)
	
	Буфер = Новый СписокЗначений;
	Буфер.ЗагрузитьЗначения(ВыбранныеКонтрагенты1С);
	КонтрагентыПроверкиРегистрации = Буфер.ВыгрузитьЗначения();	
	
	ТаблицаЗарегистрированныхКонтрагентов1С = Новый ТаблицаЗначений;
	ТаблицаЗарегистрированныхКонтрагентов1С.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаЗарегистрированныхКонтрагентов1С.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	
	Для каждого ЗарегистрированныйКонтрагентЭДО Из ЗарегистрированныеКонтрагентыЭДО Цикл
		
		ЗарегистрированныйКонтрагент1С = ККСНГ_ПринятиеКУчетуВызовСервера.НайтиКонтрагента(ЗарегистрированныйКонтрагентЭДО.Code,
																							ЗарегистрированныйКонтрагентЭДО.Inn,
																							ЗарегистрированныйКонтрагентЭДО.Kpp);
		Если ЗначениеЗаполнено(ЗарегистрированныйКонтрагент1С) Тогда
			
			СтрокаТаблицы = ТаблицаЗарегистрированныхКонтрагентов1С.Добавить();
			СтрокаТаблицы.Контрагент = ЗарегистрированныйКонтрагент1С;
			СтрокаТаблицы.Статус = СокрЛП(НРег(ЗарегистрированныйКонтрагентЭДО.Status));
			
			ИндексНайденногоКонтрагентаПроверки = КонтрагентыПроверкиРегистрации.Найти(КонтрагентыПроверкиРегистрации);
			Если НЕ ИндексНайденногоКонтрагентаПроверки = Неопределено Тогда
				КонтрагентыПроверкиРегистрации.Удалить(ИндексНайденногоКонтрагентаПроверки);							
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДополнитьТаблицуЗарегистрированныхКонтрагентов1С(ПараметрыАвторизации, ТаблицаЗарегистрированныхКонтрагентов1С, КонтрагентыПроверкиРегистрации);	
	
	Возврат ТаблицаЗарегистрированныхКонтрагентов1С;
	
КонецФункции

Процедура ДополнитьТаблицуЗарегистрированныхКонтрагентов1С(ПараметрыАвторизации, ТаблицаЗарегистрированныхКонтрагентов1С, Знач КонтрагентыПроверкиРегистрации)
	
	Если КонтрагентыПроверкиРегистрации.Количество() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Контрагент,
			|	Контрагенты.ИНН КАК ИНН,
			|	Контрагенты.КПП КАК КПП,
			|	Контрагенты.Представление КАК Представление
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка В(&ПроверяемыеКонтрагенты1С)";
		
		Запрос.УстановитьПараметр("ПроверяемыеКонтрагенты1С", КонтрагентыПроверкиРегистрации);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
		
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("inn", Выборка.ИНН);
			СтруктураПоиска.Вставить("kpp", Выборка.КПП);
			СтруктураПоиска.Вставить("ogrn", "");
			
			ДанныеКомпанииКурьер = ККСНГ_APIКурьер.v1_FindClient(ПараметрыАвторизации, СтруктураПоиска);
			
			Если ДанныеКомпанииКурьер.Успех Тогда
				
				СтрокаТаблицы = ТаблицаЗарегистрированныхКонтрагентов1С.Добавить();
				СтрокаТаблицы.Контрагент = Выборка.Контрагент;
				СтрокаТаблицы.Статус = "rejected";
				
			КонецЕсли;			
			
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьСтатусЗарегистрированногоКонтрагента(Ответ, Контрагент, ЗарегистрированныеКонтрагенты1С)
	
	ОшибкаПоСтатусу = Истина;
	ТекстОшибки = "";
	
	Если ВзаимосвязьУжеСуществует(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 4));
		ТекстОшибки = НСтр("ru = 'У контрагента %1 уже существует взаимосвязь.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	ИначеЕсли СуществуетАктивныйЗапросКонтрагенту(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 5));
		ТекстОшибки = НСтр("ru = 'Существует запрос, направленный контрагенту %1.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	ИначеЕсли ОтправительСовпадаетСПолучателем(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 8));
		ТекстОшибки = НСтр("ru = 'Отправитель %1 совпадает с получателем.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	ИначеЕсли СуществуетОтклоненныйЗапросКонтрагенту(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 6));
		ТекстОшибки = НСтр("ru = 'Существует отклоненный запрос, направленный контрагенту %1.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	ИначеЕсли СуществуетЗаблокированнаяВзаимосвязь(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 9));
		ТекстОшибки = НСтр("ru = 'Уже существует взаимосвязь (заблокированная) с контрагентом %1'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	ИначеЕсли ПопыткаУдалитьСуществующегоКонтрагента(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
		Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 7));
		ТекстОшибки = НСтр("ru = 'Контрагент %1 уже существует в БД / Попытка добавить как несуществующий.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент);
	Иначе
		ОшибкаПоСтатусу = Ложь;
		ТекстОшибки = "";
	КонецЕсли;

	ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00002", , Контрагент);
	
	Возврат ОшибкаПоСтатусу;	
	
КонецФункции

Функция КонтрагентЗарегистрирован(Контрагент, ЗарегистрированныеКонтрагенты1С)
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(Новый Структура("Контрагент", Контрагент)).Количество() > 0;
КонецФункции

Процедура ДобавитьСтатусНеЗарегистрированногоКонтрагента(Ответ, Контрагент)
	Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 2));
	ТекстОшибки = НСтр("ru = '%1 ИНН %2 КПП %3 не найдена в Сервисе ЭДО'");
	ТекстОшибки = СтрШаблон(ТекстОшибки, Контрагент, Контрагент.ИНН, Контрагент.КПП);
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00002", , Контрагент);
КонецПроцедуры

Функция ВзаимосвязьУжеСуществует(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "exists");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
КонецФункции

Функция СуществуетАктивныйЗапросКонтрагенту(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "sent");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
КонецФункции

Функция СуществуетОтклоненныйЗапросКонтрагенту(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "rejected");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
КонецФункции

Функция ПопыткаУдалитьСуществующегоКонтрагента(Контрагент, ЗарегистрированныеКонтрагенты1С)
	ПараметрыОтбора = Новый Структура("Контрагент, Статус", Контрагент, "clientexists");
	Возврат ЗарегистрированныеКонтрагенты1С.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
