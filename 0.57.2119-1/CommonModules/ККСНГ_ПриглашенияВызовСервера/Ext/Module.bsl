#Область ПрограммныйИнтерфейс

#Область ПриглашениеКонтрагентов 

// Отправляет запросы на установку взаимосвязей контрагентов
//
// Параметры:
//   МассивИннКпп - Массив из Структура - сожержит:
//		* ИНН - Строка - ИНН контрагента
//		* КПП - Строка - КПП контрагента
//  ПараметрыАвторизации - Структура - Параметры авторизации в сервисе.
//						   Описание см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - Структура - содержит:
//			** Отправлено  - Массив из Строка - Массив успешно отправленных приглашений
//			** НеОтправлено - Массив из Строка - Массив не отправленных приглашений
//
Функция ОтправитьПриглашения(МассивИннКпп, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	МассивОтправленных = Новый Массив;
	МассивНеОтправленных = Новый Массив;
	
	Для Каждого ЭлементИннКпп Из МассивИннКпп Цикл
		RelationRequest = Новый Структура;
		RelationRequest.Вставить("ReceiverInn", ЭлементИннКпп.ИНН);
		RelationRequest.Вставить("ReceiverKpp", ЭлементИннКпп.КПП);
		RelationRequest.Вставить("Contacts", "");
		RelationRequest.Вставить("Email", "");
		RelationRequest.Вставить("ReceiverName", "");
		RelationRequest.Вставить("ReceiverId", "");
		ОтправкаПриглашенияРезультат = ККСНГ_APIКурьер.v2_RelationRequestAddRequest(ПараметрыАвторизации, RelationRequest);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтправкаПриглашенияРезультат.Журнал, Ложь);
		Если ОтправкаПриглашенияРезультат.Успех Тогда
			МассивОтправленных.Добавить(RelationRequest);	
		Иначе
			МассивНеОтправленных.Добавить(RelationRequest);
		КонецЕсли;	
	КонецЦикла;
	
	Ответ.Успех = МассивОтправленных.Количество() > 0;
	Ответ.Результат = Новый Структура("Отправлено,НеОтправлено", МассивОтправленных, МассивНеОтправленных);
	Возврат Ответ;
	
КонецФункции

// Отправляет приглашение выбранным и зарегистрированным контрагентам
//
// Параметры:
//   ВыбранныеКонтрагенты1С - Массив - Массив контрагентов
//   ЗарегистрированныеКонтрагентыЭДО - Структура - соответствует структуре данных ClientRelation
//										(https://confluence.esphere.ru/display/SBER/ClientRelation)
//		* RelationId - Число - Идентификатор взаимосвязи
//		* Status - Структура - Статус взаимосвязи
//		* Id - Число - Идентификатор абонента
//		* Name - Строка - Краткое наименование абонента
//		* Code - Строка - Идентификатор участника ЭДО
//		* Inn - Строка - ИНН абонента
//		* Kpp - Строка - КПП (только для организации)
//   ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - содержит:
// 			** КоличествоВсего - Число - Количество выбранных контрагентов  
// 			** Статусы - Массив из Структура - содержит:
//				*** Контрагент - СправочникСсылка.Контрагенты
//				*** КодСтатуса - Число
//			** КоличествоОтправленных - Число - Количество успешно отправленных приглашений
//          ** КоличествоНеОтправленных - Число - Количество не отправленных приглашений
//          ** КоличествоНеЗарегистрированных - Число - Количество не зарегистрированных контрагентов в сервисе
//
Функция ПригласитьКонтрагентов(Знач ВыбранныеКонтрагенты1С, 
								Знач ЗарегистрированныеКонтрагентыЭДО, 
								Знач ПрофильЭДООрганизации, 
								ПараметрыАвторизации) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Результат = Новый Структура;
	Ответ.Результат.Вставить("КоличествоВсего", ВыбранныеКонтрагенты1С.Количество());
	Ответ.Результат.Вставить("Статусы", Новый Массив);
	Ответ.Успех = Истина;
	
	КоличествоОтправленных = 0;
	КоличествоНеОтправленных = 0;
	КоличествоНеЗарегистрированных = 0;
	
	ЗарегистрированныеКонтрагенты1С = ПолучитьЗарегистрированныхКонтрагентов1С(ПараметрыАвторизации, 
																				ЗарегистрированныеКонтрагентыЭДО, 
																				ВыбранныеКонтрагенты1С);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВыбранныеКонтрагенты.Ссылка КАК Контрагент,
	|	ВыбранныеКонтрагенты.ИНН КАК ИНН,
	|	ВыбранныеКонтрагенты.КПП КАК КПП,
	|	ВыбранныеКонтрагенты.Представление КАК Представление
	|ИЗ
	|	Справочник.Контрагенты КАК ВыбранныеКонтрагенты
	|ГДЕ
	|	ВыбранныеКонтрагенты.Ссылка В(&ВыбранныеКонтрагенты1С)";
	
	Запрос.УстановитьПараметр("ВыбранныеКонтрагенты1С", ВыбранныеКонтрагенты1С);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ИНН) Тогда
			
			Контрагент = Выборка.Контрагент;
			
			Если НЕ КонтрагентЗарегистрирован(Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
				Ответ.Успех = Ложь;
				ДобавитьСтатусНеЗарегистрированногоКонтрагента(Ответ, Контрагент);
				ККСНГ_ОбщегоНазначенияКлиентСервер.Инкремент(КоличествоНеЗарегистрированных);
				Продолжить;
			КонецЕсли;
			
			ДанныеКонтрагента = Новый Структура;
			ДанныеКонтрагента.Вставить("ReceiverKpp", Выборка.КПП);
			ДанныеКонтрагента.Вставить("ReceiverInn", Выборка.ИНН);
			
			ОтправкаПриглашения = ККСНГ_APIКурьер.v2_RelationRequestAddRequest(ПараметрыАвторизации, ДанныеКонтрагента);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтправкаПриглашения.Журнал, Ложь);
			
			Ответ.Успех = Ответ.Успех И ОтправкаПриглашения.Успех;
			Если ОтправкаПриглашения.Успех Тогда
				Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 0));
				ККСНГ_ОбщегоНазначенияКлиентСервер.Инкремент(КоличествоОтправленных);
			ИначеЕсли ПроверитьСтатусЗарегистрированногоКонтрагента(Ответ, Контрагент, ЗарегистрированныеКонтрагенты1С) Тогда
				ККСНГ_ОбщегоНазначенияКлиентСервер.Инкремент(КоличествоНеОтправленных);
			Иначе
				Ответ.Результат.Статусы.Добавить(СтатусОтправкиПриглашения(Контрагент, 1));
				ККСНГ_ОбщегоНазначенияКлиентСервер.Инкремент(КоличествоНеОтправленных);
			КонецЕсли;
			
		Иначе 
			ТекстОшибки = НСтр("ru = 'У контрагента %1 не заполнен ИНН.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, Выборка.Представление);
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "RR-00002", , Контрагент);
		КонецЕсли;
		
	КонецЦикла;
	
	ПолучитьСписокПриглашений(ПрофильЭДООрганизации, ПараметрыАвторизации, РезультатЗапроса.Выгрузить());
	
	Ответ.Результат.Вставить("КоличествоОтправленных", КоличествоОтправленных);
	Ответ.Результат.Вставить("КоличествоНеОтправленных", КоличествоНеОтправленных);
	Ответ.Результат.Вставить("КоличествоНеЗарегистрированных", КоличествоНеЗарегистрированных);
	
	Возврат Ответ;

КонецФункции

// Возвращает список приглашений с сервиса и записывает в базу
//
// Параметры:
//   ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//	НовыеКонтрагенты - ТаблицаЗначений - содержит:
//		* ИНН - Строка - ИНН приглашаемого контрагента
//		* КПП - Строка - КПП приглашаемого контрагента
//		* Контрагент - СправочникСсылка.Контрагенты - Приглашаемый контрагент
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//   	* Результат - Структура - содержит:
//			** КоличествоПолученных - Число
//			** ИнформацияПоНовымПрофилям - Строка - Список контрагентов
//			** КоличествоНовыхПрофилей - Число
//			** КоличествоНовыхПриглашений - Число
//			** КоличествоЗаписанных - Число
//			** КоличествоПолученных - Число
//
Функция ПолучитьСписокПриглашений(Знач ПрофильЭДООрганизации, ПараметрыАвторизации, НовыеКонтрагенты = Неопределено) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();

	ЗапросПриглашений = ККСНГ_APIКурьер.v2_RelationRequestListRequest(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПриглашений.Журнал, Ложь);
	Ответ.Успех = ЗапросПриглашений.Успех;

	Если Ответ.Успех Тогда
		
		Приглашения = ЗапросПриглашений.Результат.RelationRequestDetails;
		
		ОчиститьОтозванныеПриглашенияЛокально(Приглашения, ПрофильЭДООрганизации);
		
		Ответ.Результат = Новый Структура;
		Ответ.Результат.Вставить("КоличествоПолученных", Приглашения.Количество());
		Ответ.Результат.Вставить("ИнформацияПоНовымПрофилям", "");
		Ответ.Результат.Вставить("КоличествоНовыхПрофилей", 0);
		Ответ.Результат.Вставить("КоличествоНовыхПриглашений", 0);
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получено приглашений: " 
																+ XMLСтрока(Приглашения.Количество()));
		КоличествоЗаписанных = 0;
		Если Приглашения.Количество() > 0 Тогда
			
			УстановитьКонтрагентаПолучателя(Приглашения, НовыеКонтрагенты, ПрофильЭДООрганизации, Ответ, КоличествоЗаписанных);

			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Записано приглашений: " 
																+ XMLСтрока(КоличествоЗаписанных) 
																	+ " из " + XMLСтрока(Приглашения.Количество()));														
		КонецЕсли;
		Ответ.Результат.Вставить("КоличествоЗаписанных", КоличествоЗаписанных);
		
		РезультатОбработки = СоздатьПрофилиПринятыхПриглашений(ПрофильЭДООрганизации, Приглашения, ПараметрыАвторизации);
		
		Ответ.Результат.ИнформацияПоНовымПрофилям = РезультатОбработки.ИнформацияПоНовымПрофилям;
		Ответ.Результат.КоличествоНовыхПрофилей = РезультатОбработки.КоличествоНовыхПрофилей;
		
	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

// Проверяет наличие контрагентов в сервисе 
//
// Параметры:
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//	 ВыбранныеКонтрагенты1С - Массив - Массив контрагентов, который проверяется на наличие в сервисе Курьер
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//   	* Результат - Структура - содержит:
//   		** ЗарегистрированныеКонтрагентыЭДО - Структура - соответствует структуре данных ClientRelation
//												  (https://confluence.esphere.ru/display/SBER/ClientRelation)
//				*** RelationId - Число - Идентификатор взаимосвязи
//				*** Status - Структура - Статус взаимосвязи
//				*** Id - Число - Идентификатор абонента
//				*** Name - Строка - Краткое наименование абонента
//				*** Code - Строка - Идентификатор участника ЭДО
//				*** Inn - Строка - ИНН абонента
//				*** Kpp - Строка - КПП (только для организации)
//
Функция КонтрагентыЗарегистрированыВКурьере(ПараметрыАвторизации, ВыбранныеКонтрагенты1С) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Ложь;
	Ответ.Результат = Новый Структура();
	
	ArrayOfClientDiscovery = Новый Структура("ClientDiscovery", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В(&ВыбранныеКонтрагенты1С)";
	
	Запрос.УстановитьПараметр("ВыбранныеКонтрагенты1С", ВыбранныеКонтрагенты1С);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПроверитьДанныеКонтрагента(Ответ, Выборка.Контрагент, Выборка.ИНН);
		
		ClientDiscovery = Новый Структура;
		ClientDiscovery.Вставить("inn", Выборка.ИНН);
		ClientDiscovery.Вставить("kpp", Выборка.КПП);
		
		ArrayOfClientDiscovery.ClientDiscovery.Добавить(ClientDiscovery);
		
	КонецЦикла;
	
	РезультатПоиска = ККСНГ_APIКурьер.v2_ClientDiscover(ПараметрыАвторизации, ArrayOfClientDiscovery);		
	
	Если НЕ РезультатПоиска.Успех Тогда
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, РезультатПоиска.Журнал, Ложь);
	Иначе
		Ответ.Результат.Вставить("ЗарегистрированныеКонтрагентыЭДО", РезультатПоиска.Результат.ClientRelation);
		Ответ.Успех = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Добавляет/изменяет запись об отправителе в регистре сведений "Приглашения"
//
// Параметры:
//   ИдентификаторПриглаешения - Строка - Идентификатор приглашения
//   ПрофильОрганизацииЭДО - СправочникСсылка.ККСНГ_Организации - Профиль организации ЭДО
//	 Контрагент - СправочникСсылка.Контаргенты - Контрагент-отправитель
//
// Возвращаемое значение:
//   Ответ - Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//
Функция ЗаписатьКонтрагентаОтправителя(ИдентификаторПриглашения, ПрофильОрганизацииЭДО, Контрагент) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Запись приглашения контрагента");
	
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ККСНГ_Приглашения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПрофильЭДООрганизации = ПрофильОрганизацииЭДО;
		МенеджерЗаписи.Id = ИдентификаторПриглашения;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.КонтрагентОтправитель = Контрагент;	
			МенеджерЗаписи.Записать();				
		КонецЕсли;
		
		Ответ.Успех = Истина;
		
	Исключение
		Ответ.Успех = Ложь;		
	КонецПопытки;	

	Возврат Ответ;
	
КонецФункции

// Отправляет запросы на удаление отправленных приглашений
//
// Параметры:
//  МассивИд - Массив из Строка - Массив идентификаторов удаляемых приглашений
//  ПараметрыАвторизации - Структура - Параметры авторизации в сервисе.
//						   Описание см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - Структура - содержит:
//			** Удалено  - Массив из Строка - Массив успешно удаленных приглашений
//			** НеУдалено - Массив из Строка - Массив не удаленных приглашений
//
Функция УдалитьПриглашения(МассивИд, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	МассивУдаленных = Новый Массив;
	МассивНеУдаленных = Новый Массив;
	
	Для Каждого Ид Из МассивИд Цикл
		УдалениеПриглашенияРезультат = ККСНГ_APIКурьер.v2_RelationRequestDeleteRequest(ПараметрыАвторизации, Ид);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, УдалениеПриглашенияРезультат.Журнал, Ложь);
		Если УдалениеПриглашенияРезультат.Успех Тогда
			МассивУдаленных.Добавить(Ид);	
		Иначе
			МассивНеУдаленных.Добавить(Ид);
		КонецЕсли;	
	КонецЦикла;
	
	Ответ.Успех = МассивУдаленных.Количество() > 0;
	Ответ.Результат = Новый Структура("Удалено,НеУдалено", МассивУдаленных, МассивНеУдаленных);
	Возврат Ответ;
	
КонецФункции


