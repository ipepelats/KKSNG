// Отзывает отправленные приглашения
//
// Параметры:
//   ИДПриглашений - Массив из Строка - Массив идентификаторов приглашений
//   ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - содержит:
// 			** КоличествоВсего - Число - Количество выбранных приглашений  
// 			** КоличествоОтозванных - Число - Количество успешно отозванных приглашений  
//
Функция ОтозватьПриглашение(ИДПриглашений, Знач ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Результат = Новый Структура;
	Ответ.Результат.Вставить("КоличествоВсего", ИДПриглашений.Количество());
	Ответ.Успех = Истина;
	
	КоличествоОтозванных = 0;
	Для каждого ТекИД Из ИДПриглашений Цикл
		ОтзывПриглашения = ККСНГ_APIКурьер.v2_RelationRequestDeleteRequest(ПараметрыАвторизации, ТекИД);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтзывПриглашения.Журнал, Ложь);
		
		Если ОтзывПриглашения.Успех Тогда
			ПриглашенияУдалено = УдалитьПриглашение(ПрофильЭДООрганизации, ТекИД);
			Если Не ПриглашенияУдалено.Успех Тогда
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПриглашенияУдалено.Журнал, Ложь);
			КонецЕсли;
		КонецЕсли;
	
		Ответ.Успех = Ответ.Успех И ОтзывПриглашения.Успех;
		Если ОтзывПриглашения.Успех Тогда
			КоличествоОтозванных = КоличествоОтозванных + 1;
		КонецЕсли;
	КонецЦикла; 
	Ответ.Результат.Вставить("КоличествоОтозванных", КоличествоОтозванных);
		
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область ПринятиеПриглашений

// Принимает запрос на установку взаимосвязи контрагентов
//
// Параметры:
//   МассивИд - Массив из Строка - Массив идентификаторов приглашений
//   ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - содержит:
// 			** КоличествоВсего - Число - Количество выбранных приглашений  
// 			** КоличествоПринятых - Число - Количество успешно принятых приглашений  
//
Функция ПринятьПриглашения(МассивИд, Знач ПрофильОрганизацииЭДО, ПараметрыАвторизации) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Результат = Новый Структура;
	Ответ.Результат.Вставить("КоличествоВсего", МассивИд.Количество());
	Ответ.Успех = Истина;
	
	КоличествоПринятых = 0;
	Для каждого ТекИД Из МассивИд Цикл
		ПринятиеПриглашения = ККСНГ_APIКурьер.v2_RelationRequestAccept(ПараметрыАвторизации, ТекИД);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ПринятиеПриглашения.Журнал, Ложь);
		
		Ответ.Успех = Ответ.Успех И ПринятиеПриглашения.Успех;
		Если ПринятиеПриглашения.Успех Тогда
			УстановитьСтатусПриглашенияПринят(ПрофильОрганизацииЭДО, ТекИД);
			КоличествоПринятых = КоличествоПринятых + 1;
		КонецЕсли;
	КонецЦикла; 
	Ответ.Результат.Вставить("КоличествоПринятых", КоличествоПринятых);
		
	Возврат Ответ;

КонецФункции

// Выполняет создание профилей контрагентов для принятых приглашений 
//
// Параметры:
//   ИДПриглашений - Массив из Строка - Массив идентификаторов приглашений
//	 ТаблицаПриглашений - ТаблицаЗначений - содержит:
//		* SenderInn - Число
//		* SenderKpp - Число
//		* SenderName - Строка
//		* Id - Число
//		* Профиль - СправочникСсылка.ККСНГ_Контрагенты
//		* Контрагент - СправочникСсылка.Контрагенты
//		* Обрабатывать - Булево
//   ПараметрыАвторизации - Структура - содержит:
//		* AuthToken - Строка, Неопределено - Для способа авторизации APIKey
//		* КонтекстТокена - Строка, Неопределено - Для способа авторизации ТокенСбербанка
//		* СертификатЭП - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Для способа авторизации APIKey
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//   ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации - Профиль организации
//
// Возвращаемое значение:
//   Структура - содержит:
// 		* ИДПриглашений - Массив из Число - Массив идентификаторов обработанных приглашений  
// 		* ИнформацияПоНовымПрофилям - Строка - Список контрагентов обработанных приглашений
// 		* КоличествоНовыхПрофилей - Число - Количество успешно обработанных приглашений  
//
Функция ОбработатьДанныеПриглашенийЗарегистрированныхКонтрагентовЭДО(ИДПриглашений, ТаблицаПриглашений, ПараметрыАвторизации, ПрофильЭДООрганизации) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗ.SenderInn КАК Inn,
	|	ТЗ.SenderKpp КАК Kpp,
	|	ТЗ.SenderName КАК Name,
	|	ТЗ.Id КАК Id,
	|	ТЗ.Профиль КАК Профиль,
	|	ТЗ.Контрагент КАК Контрагент,
	|	ТЗ.Обрабатывать КАК Обработать
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗ.Inn КАК Inn,
	|	ТЗ.Kpp КАК Kpp,
	|	ТЗ.Name КАК Name,
	|	ТЗ.Id КАК Id,
	|	ТЗ.Профиль КАК Профиль,
	|	ТЗ.Контрагент КАК Контрагент,
	|	ТЗ.Обработать КАК Обработать
	|ИЗ
	|	ТЗ КАК ТЗ
	|ГДЕ
	|	ТЗ.Id В(&ИДПриглашений)";

	Запрос.УстановитьПараметр("ТЗ", ТаблицаПриглашений);
	Запрос.УстановитьПараметр("ИДПриглашений", ИДПриглашений);

	Результат =  Запрос.Выполнить().Выгрузить();
	
	Результат.Колонки.Добавить("Code", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(47)));
	
	РезультатОтвет = Новый Структура;
	РезультатОтвет.Вставить("ИДПриглашений", Новый Массив);
	РезультатОтвет.Вставить("ИнформацияПоНовымПрофилям", "");
	РезультатОтвет.Вставить("КоличествоНовыхПрофилей", 0);
	
	Если Результат.Количество() > 0 Тогда
	
		МассивДанныхКонтрагентов = МассивДанныхКонтрагентов(Результат);
		Ответ = ККСНГ_APIКурьер.v2_ClientDiscover(ПараметрыАвторизации, МассивДанныхКонтрагентов.ДанныеClientDiscovery);
		ВзаимосвязиКонтрагентов = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Ответ.Результат, "ClientRelation", Новый Массив);
		
		Если Ответ.Успех Тогда
			
			Для каждого ВзаимосвязьКонтрагента Из ВзаимосвязиКонтрагентов Цикл
				
				СтруктураПоиска = Новый Структура;
				СтруктураПоиска.Вставить("Inn", ВзаимосвязьКонтрагента.Inn);
				Если ЗначениеЗаполнено(ВзаимосвязьКонтрагента.Kpp) Тогда
					СтруктураПоиска.Вставить("Kpp", ВзаимосвязьКонтрагента.Kpp);
				КонецЕсли;
				РезультатПоиска = Результат.НайтиСтроки(СтруктураПоиска);
				Если РезультатПоиска.Количество() > 0 Тогда
					РезультатПоиска[0].Code = ВзаимосвязьКонтрагента.Code;	
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого ТекущийКонтрагент Из Результат Цикл
				Если ТекущийКонтрагент.Обработать И ОбработатьКонтрагента(ТекущийКонтрагент, ПрофильЭДООрганизации) Тогда
					РезультатОтвет.ИДПриглашений.Добавить(ТекущийКонтрагент.Id);
					РезультатОтвет.ИнформацияПоНовымПрофилям = РезультатОтвет.ИнформацияПоНовымПрофилям + Символы.ПС + ТекущийКонтрагент.Контрагент;
					РезультатОтвет.КоличествоНовыхПрофилей = РезультатОтвет.КоличествоНовыхПрофилей + 1;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат РезультатОтвет;	
	
КонецФункции

#КонецОбласти

