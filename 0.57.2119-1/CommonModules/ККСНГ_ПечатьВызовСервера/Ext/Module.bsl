#Область ПрограммныйИнтерфейс

// Формирует печатную форму счета на основании данных электронного документа
// и возвращает заполненную печатную форму счета
//
// Параметры:
//   ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы - Описание параметра
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - ТабличныйДокумент - Сформированная и заполненная печатная форма
//      	
//
Функция ПолучитьТабличныйДокументСчета(ЭлектронныйДокумент) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Печать счета ЭД " + Строка(ЭлектронныйДокумент.id));
	
	// Сбор данных
	Попытка 
		ПрисоединенныйФайлДокумента = ККСНГ_ОбъектыИБВызовСервера.ПолучитьОбъектПрисоединенныйФайл(0, ЭлектронныйДокумент);	
		XMLДокумента = ПолучитьСтрокуИзДвоичныхДанных(ККСНГ_ОбъектыИБВызовСервера.ПолучитьДвоичныеДанныеФайла(ПрисоединенныйФайлДокумента), "windows-1251");	
		ОбXDTO = ККСНГ_APIКурьер.ПолучитьОбъектXDTO(XMLДокумента, "KKSNG_BILL", "Файл");	
		СтруктураСчета = ККСНГ_APIКурьер.ПолучитьСтруктуруПоОбъектуXDTO(ОбXDTO);
	Исключение
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки(), "PR-00001");
		Ответ.Результат = Новый ТабличныйДокумент();
		Возврат Ответ;
	КонецПопытки;
		
	// Подготовка данных
	СписокРеквизитов = ПолучитьСписокРеквизитовСчета();
	
	// Реквизиты шапки
	ОбработатьРеквизитыШапкиСчета(СписокРеквизитов, СтруктураСчета);
	
	// Строки товаров
	СтрокиСведТов = ОбработатьИПолучитьСведенияОТоварахСчета(СтруктураСчета);
	
	// Дополнительные реквизиты
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("СтрокиСведТов", СтрокиСведТов);
	ПараметрыОбработки.Вставить("ИдентификаторЭД", ЭлектронныйДокумент.id);
	
	ОбработатьДополнительныеРеквизитыСчета(СписокРеквизитов, ПараметрыОбработки);
	
	// Печать		
	ТабДокумент = Новый ТабличныйДокумент;	
	МакетСчета =  ПолучитьОбщийМакет("ККСНГ_ПФ_Счет");
		
	// Заголовок
	ОбластьЗаголовок = МакетСчета.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.Заполнить(СписокРеквизитов);
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	// Строки
	Для Каждого Элем из СтрокиСведТов Цикл
		
		ОбластьСтрока = МакетСчета.ПолучитьОбласть("Строка");
		ОбластьСтрока.Параметры.Заполнить(Элем);
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	// Подвал
	ОбластьПодвал = МакетСчета.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(СписокРеквизитов);
	ТабДокумент.Вывести(ОбластьПодвал);
	
	ТабДокумент.РазмерСтраницы = "A4";  
    ТабДокумент.АвтоМасштаб  = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Ответ.Результат = ТабДокумент;
	Ответ.Успех = Истина;
		
	Возврат Ответ;
	
КонецФункции

// Формирует печатную форму счета по бизнес-процессу ЭДО с поставщиками (УВХД) на основании данных электронного документа
// и возвращает заполненную печатную форму счета
//
// Параметры:
//   ЭлектронныйДокумент - СправочникСсылка.ККСНГ_ЭлектронныеДокументы - Описание параметра
//
// Возвращаемое значение:
//   Структура - Описание см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета
//		* Результат - ТабличныйДокумент - Сформированная и заполненная печатная форма
//      	
//
Функция ПолучитьТабличныйДокументСчетаУВХД(ЭлектронныйДокумент) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Печать счета ЭД " + Строка(ЭлектронныйДокумент.id));
	
	// Сбор данных
	Попытка 
		ПрисоединенныйФайлДокумента = ККСНГ_ОбъектыИБВызовСервера.ПолучитьОбъектПрисоединенныйФайл(0, ЭлектронныйДокумент);	
		XMLДокумента = ПолучитьСтрокуИзДвоичныхДанных(ККСНГ_ОбъектыИБВызовСервера.ПолучитьДвоичныеДанныеФайла(ПрисоединенныйФайлДокумента), "windows-1251");	
		XMLДокумента = СтрЗаменить(XMLДокумента, "xml:lang=", "lang=");
		ОбXDTO = ККСНГ_APIКурьер.ПолучитьОбъектXDTO(XMLДокумента, "KKSNG_BILL_UVHD", "Request");	
		СтруктураСчета = ККСНГ_APIКурьер.ПолучитьСтруктуруПоОбъектуXDTO(ОбXDTO);
	Исключение
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки(), "PR-00001");
		Ответ.Результат = Новый ТабличныйДокумент();
		Возврат Ответ;
	КонецПопытки;
		
	// Подготовка данных
	СписокРеквизитов = ПолучитьСписокРеквизитовСчетаУВХД();
	
	// Реквизиты шапки
	ОбработатьРеквизитыШапкиСчетаУВХД(СписокРеквизитов, СтруктураСчета);
	
	// Строки товаров
	СтрокиСведТов = ОбработатьИПолучитьСведенияОТоварахСчетаУВХД(СтруктураСчета);
	
	// Итоги
	ОбработатьРеквизитыИтоговСчетаУВХД(СписокРеквизитов, СтруктураСчета);
	
	// Дополнительные реквизиты
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("СтрокиСведТов", СтрокиСведТов);
	ПараметрыОбработки.Вставить("ИдентификаторЭД", ЭлектронныйДокумент.id);
	
	ОбработатьДополнительныеРеквизитыСчетаУВХД(СписокРеквизитов, ПараметрыОбработки);
	
	// Печать		
	ТабДокумент = Новый ТабличныйДокумент;	
	МакетСчета =  ПолучитьОбщийМакет("ККСНГ_ПФ_Счет");
		
	// Заголовок
	ОбластьЗаголовок = МакетСчета.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.Заполнить(СписокРеквизитов);
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	// Строки
	Для Каждого Элем из СтрокиСведТов Цикл
		
		ОбластьСтрока = МакетСчета.ПолучитьОбласть("Строка");
		ОбластьСтрока.Параметры.Заполнить(Элем);
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	// Подвал
	ОбластьПодвал = МакетСчета.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(СписокРеквизитов);
	ТабДокумент.Вывести(ОбластьПодвал);
	
	ТабДокумент.РазмерСтраницы = "A4";  
    ТабДокумент.АвтоМасштаб  = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Ответ.Результат = ТабДокумент;
	Ответ.Успех = Истина;
		
	Возврат Ответ;
	
КонецФункции

Функция КопируемыеСвойстваТабличногоДокумента() Экспорт
	
	Возврат "АвтоМасштаб,Вывод,ВысотаСтраницы,ДвусторонняяПечать,Защита,ИмяПринтера,КодЯзыка,
	|КоличествоЭкземпляров,МасштабПечати,НомерПервойСтраницы,ОриентацияСтраницы,ПолеСверху,ПолеСлева,
	|ПолеСнизу,ПолеСправа,РазборПоКопиям,РазмерКолонтитулаСверху,РазмерКолонтитулаСнизу,РазмерСтраницы,
	|ТочностьПечати,ФоноваяКартинка,ЧерноБелаяПечать,ШиринаСтраницы,ЭкземпляровНаСтранице";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоставнойАдрес(СтруктураПараметров)
	
	СтрРез = "";
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
	
		Для Каждого Свойство ИЗ СтруктураПараметров Цикл
			
			Если НЕ ЗначениеЗаполнено(Свойство.Значение) Тогда
				Продолжить;
			Иначе
				ЗначениеСвойства = "";
			КонецЕсли;

			ЗначениеСвойства = ЗначениеСвойства(Свойство);
			
			Если ЗначениеЗаполнено(ЗначениеСвойства) Тогда
				СтрРез = ?(ЗначениеЗаполнено(СтрРез), СтрРез + ", ", "") + ЗначениеСвойства;
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрРез;
	
КонецФункции

Функция ЗначениеСвойства(Свойство)

	ЗначениеСвойства = "";
	
	Если Свойство.Ключ = "Индекс" Тогда
		ЗначениеСвойства = Свойство.Значение;
	ИначеЕсли Свойство.Ключ = "КодРегион" Тогда
		ЗначениеСвойства = НазваниеРегиона(Свойство.Значение);
	ИначеЕсли Свойство.Ключ = "КодСтр" Тогда
		ЗначениеСвойства = ПредставлениеСтраны(Свойство.Значение);
	Иначе
		ЗначениеСвойства = "";
		Если Свойство.Ключ = "Дом" Тогда
			ЗначениеСвойства = "дом № ";
		ИначеЕсли Свойство.Ключ = "Корпус" Тогда
			ЗначениеСвойства = "корпус ";
		ИначеЕсли Свойство.Ключ = "Кварт" Тогда
			ЗначениеСвойства = "кв. ";
		КонецЕсли;
		ЗначениеСвойства = ЗначениеСвойства + Свойство.Значение;
	КонецЕсли;	
	
	Возврат ЗначениеСвойства;
	
КонецФункции

Функция НазваниеРегиона(КодРегиона) 
	
	СокращениеАдреса = "";
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	КодРегионаКакЧисло = ОписаниеТипаЧисло.ПривестиЗначение(КодРегиона);
	
	Если КодРегионаКакЧисло = 0 Тогда
		Возврат Неопределено;
	Иначе	
		КодРегионаЧисло = КодРегионаКакЧисло;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.РегистрыСведений.АдресныеОбъекты;
	
	Если ОбъектМетаданных.Реквизиты.Найти("Сокращение") <> Неопределено Тогда
		СокращениеАдреса = "АдресныеОбъекты.Сокращение";
	ИначеЕсли ОбъектМетаданных.Реквизиты.Найти("ТипОбъекта") <> Неопределено Тогда
		СокращениеАдреса = "АдресныеОбъекты.ТипОбъекта";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	АдресныеОбъекты.Наименование КАК ПолноеНаименование
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|ГДЕ
	|	АдресныеОбъекты.КодСубъектаРФ = &КодРегиона
	| И АдресныеОбъекты.Уровень = 1";
	
	Запрос.Параметры.Вставить("КодРегиона", КодРегионаЧисло);
	Запрос.Текст = ТекстЗапроса;

	Если ЗначениеЗаполнено(СокращениеАдреса) Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "АдресныеОбъекты.Наименование", СокращениеАдреса + "+ "" "" + " + "АдресныеОбъекты.Наименование");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ПолноеНаименование);
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ПредставлениеСтраны(КодСтраны)
	
	ДанныеСтраны = УправлениеКонтактнойИнформацией.ДанныеСтраныМира(КодСтраны);
	
	Представление = Неопределено;
	Если ТипЗнч(ДанныеСтраны) = Тип("Структура") Тогда 
		ДанныеСтраны.Свойство("Наименование", Представление);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = КодСтраны;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

