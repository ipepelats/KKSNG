КонецФункции

Процедура ОбработатьРеквизитыШапкиСчета(СписокРеквизитов, СтруктураСчета)
	
	Для Каждого Реквизит Из СписокРеквизитов Цикл	
		
		Если МожноЗаполнитьРеквизит(СписокРеквизитов, "АдресПродавца", Реквизит.Ключ) Тогда 
			ПоляАдреса = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, Реквизит.Значение);
			СписокРеквизитов["АдресПродавца"] = СоставнойАдрес(ПоляАдреса);
		ИначеЕсли МожноЗаполнитьРеквизит(СписокРеквизитов, "АдресПлательщика", Реквизит.Ключ) Тогда 
			ПоляАдреса = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, Реквизит.Значение);
			СписокРеквизитов["АдресПлательщика"] = СоставнойАдрес(ПоляАдреса);
		ИначеЕсли Реквизит.Ключ = "Валюта" Тогда
			КодОКВ = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, Реквизит.Значение, "643");			
			СписокРеквизитов[Реквизит.Ключ] = Справочники.Валюты.НайтиПоКоду(КодОКВ);						
		Иначе
			СписокРеквизитов[Реквизит.Ключ] = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, Реквизит.Значение);
		КонецЕсли;
		
	КонецЦикла;	

	Если НЕ ЗначениеЗаполнено(СписокРеквизитов["Продавец"]) Тогда
		СписокРеквизитов["Продавец"] = "Индивидуальный предприниматель "
					+ СписокРеквизитов["ПродавецФамилия"] + " " + СписокРеквизитов["ПродавецИмя"] + " " + СписокРеквизитов["ПродавецОтчество"];		
	КонецЕсли;
	СписокРеквизитов.Вставить("Получатель", СписокРеквизитов["Продавец"]);
	
	Если НЕ ЗначениеЗаполнено(СписокРеквизитов["Плательщик"]) Тогда
		СписокРеквизитов["Плательщик"] = "ИП " + СписокРеквизитов["ПлательщикФамилия"]
					+ " " + СписокРеквизитов["ПлательщикИмя"] + " " + СписокРеквизитов["ПлательщикОтчество"];		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СписокРеквизитов["ИННПолучателя"]) Тогда
		СписокРеквизитов["ИННПолучателя"] = СписокРеквизитов["ИННПолучателяФЛ"];		
	КонецЕсли;
	
КонецПроцедуры

Функция МожноЗаполнитьРеквизит(СписокРеквизитов, ИмяРеквизита, ПроверяемоеИмя)
	
	ЭтоЗначениеРеквизита = СтрНайти(ПроверяемоеИмя, ИмяРеквизита) > 0;
	РеквизитПустой = НЕ ЗначениеЗаполнено(СписокРеквизитов[ИмяРеквизита]);
	Возврат ЭтоЗначениеРеквизита И РеквизитПустой;
	
КонецФункции

Функция ОбработатьИПолучитьСведенияОТоварахСчета(СтруктураСчета)
	
	СтрокиСведТов = Новый Массив;
	МассивСтрокСведТов = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, "Документ.ТаблСч.СведТов", Новый Массив);
	Для Каждого Элем Из МассивСтрокСведТов Цикл
		
		СведТов = Новый Структура;
		
		СведТов.Вставить("НПП",			"НомСтр");
		СведТов.Вставить("ТоварУслуга",	"НаимТов");
		СведТов.Вставить("Единица",     "ОКЕИ_Тов");
		СведТов.Вставить("Количество",	"КолТов");
		СведТов.Вставить("Цена",		"ЦенаТов");
		СведТов.Вставить("СтавкаНДС",	"НалСт");
		СведТов.Вставить("СуммаБезНДС",	"СтТовБезНДС");
		СведТов.Вставить("Сумма",		"СтТовУчНал");
		СведТов.Вставить("СуммаНДС",    "СумНал.СумНДС");
				
		Для Каждого Тов Из СведТов Цикл	
			СведТов[Тов.Ключ] = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Элем, Тов.Значение);
		КонецЦикла;
		
		Если СведТов.Единица <> Неопределено Тогда
			Если ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОбъектМетаданныхЕстьВКонфигурации("Справочник", "КлассификаторЕдиницИзмерения") Тогда
				СведТов.Единица = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СведТов.Единица);
			ИначеЕсли ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОбъектМетаданныхЕстьВКонфигурации("Справочник", "УпаковкиЕдиницыИзмерения") Тогда
				СведТов.Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду(СведТов.Единица);
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокиСведТов.Добавить(СведТов);
		
	КонецЦикла;
	
	Возврат СтрокиСведТов;
	
КонецФункции

Процедура ОбработатьДополнительныеРеквизитыСчета(СписокРеквизитов, ДополнительныеПараметры = Неопределено)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;			
	КонецЕсли;
	
	СтрокиСведТов = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "СтрокиСведТов", Новый Массив);	
	ИдентификаторЭД = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ИдентификаторЭД", 0);	
	
	СуммаПоДокументу = СписокРеквизитов["ИтогоСНДС"];
	СуммаПоДокументу = ?(ЗначениеЗаполнено(СуммаПоДокументу), СуммаПоДокументу, 0);
	ПараметрыПредметаИсчисления = СписокРеквизитов["Валюта"].ПараметрыПрописи;
	СуммаПрописью = ЧислоПрописью(СуммаПоДокументу,, ПараметрыПредметаИсчисления);
	СписокРеквизитов.Вставить("СуммаПрописью", СуммаПрописью);	
	
	СписокРеквизитов.Вставить("ВсегоПозиций", СтрокиСведТов.Количество());
	СписокРеквизитов.Вставить("ИтогоСНДСФормат",Формат(СуммаПоДокументу, "ЧДЦ=2"));
	СписокРеквизитов.Вставить("ИДДок", Формат(ИдентификаторЭД, "ЧГ="));
	
КонецПроцедуры

#Область СчетУВХД

Функция ПолучитьСписокРеквизитовСчетаУВХД()
	
	// Реквизиты
	СписокРеквизитов = Новый Структура();
	
	// Заголовок
	СписокРеквизитов.Вставить("Номер");
	СписокРеквизитов.Вставить("Дата");
	СписокРеквизитов.Вставить("Валюта");

	СписокРеквизитов.Вставить("Продавец");
	СписокРеквизитов.Вставить("АдресПродавца");
	
	СписокРеквизитов.Вставить("Плательщик");
	СписокРеквизитов.Вставить("АдресПлательщика");
			
	СписокРеквизитов.Вставить("ИННПолучателя");
	СписокРеквизитов.Вставить("КПППолучателя");
	СписокРеквизитов.Вставить("Получатель");
	
	СписокРеквизитов.Вставить("БанкПолучателя");
	СписокРеквизитов.Вставить("РСПолучателя");
	СписокРеквизитов.Вставить("БИК");
	СписокРеквизитов.Вставить("КСБанкаПолучателя");	
	
	// Подвал	
	СписокРеквизитов.Вставить("ИтогоБезНДС");
	СписокРеквизитов.Вставить("ИтогоНДС");
	СписокРеквизитов.Вставить("ИтогоСНДС");
	
	Возврат СписокРеквизитов;
	
КонецФункции

Процедура ОбработатьРеквизитыШапкиСчетаУВХД(СписокРеквизитов, СтруктураСчета)
	
	ДанныеШапки = СтруктураСчета.InvoiceDetailRequest.InvoiceDetailRequestHeader;
	СчетРеквизиты = ДанныеШапки.Extrinsic;
	
	СписокРеквизитов.Номер = ПолучитьЗначениеРеквизитаУВХД(СчетРеквизиты, "Num_invoice");
	СписокРеквизитов.Дата = ПолучитьЗначениеРеквизитаУВХД(СчетРеквизиты, "Date_invoice");
	
	НаименованиеВалютыОКВ = СтруктураСчета.InvoiceDetailRequest.InvoiceDetailSummary.SubtotalAmount.Money.currency;
	СписокРеквизитов.Валюта = Справочники.Валюты.НайтиПоНаименованию(НаименованиеВалютыОКВ);
	
	// Продавец
	ПродавецДанные = ДанныеШапки.InvoicePartner[1].Contact;
	ПродавецРеквизиты = ПродавецДанные.Extrinsic;
	ПродавецНаименование = ПродавецДанные.Name.__content;
	ПродавецИНН = ПолучитьЗначениеРеквизитаУВХД(ПродавецРеквизиты, "INN");
	ПродавецКПП = ПолучитьЗначениеРеквизитаУВХД(ПродавецРеквизиты, "KPP");
	ПродавецБанк = ПолучитьЗначениеРеквизитаУВХД(ПродавецРеквизиты, "NameBank");
	ПродавецБик = ПолучитьЗначениеРеквизитаУВХД(ПродавецРеквизиты, "BIK");
	ПродавецРСчет = ПолучитьЗначениеРеквизитаУВХД(ПродавецРеквизиты, "IBAN");
	
	СписокРеквизитов.ИННПолучателя = ПродавецИНН;
	СписокРеквизитов.КПППолучателя = ПродавецКПП;
	СписокРеквизитов.БанкПолучателя = ПродавецБанк;
	СписокРеквизитов.РСПолучателя = ПродавецРСчет;
	СписокРеквизитов.БИК = ПродавецБик;
	СписокРеквизитов.КСБанкаПолучателя = "";
	СписокРеквизитов.Получатель = ПродавецНаименование;
	Если ЗначениеЗаполнено(ПродавецКПП) Тогда
		СписокРеквизитов.Продавец = СтрШаблон("%1, ИНН %2, КПП %3", ПродавецНаименование, ПродавецИНН, ПродавецКПП);
	Иначе
		СписокРеквизитов.Продавец = СтрШаблон("%1, ИНН %2", ПродавецНаименование, ПродавецИНН);
	КонецЕсли;
	СписокРеквизитов.АдресПродавца = АдресУВХДСтрокой(ПродавецДанные.PostalAddress);
	
	// Покупатель
	ПокупательДанные = ДанныеШапки.InvoicePartner[0].Contact;
	ПокупательРеквизиты = ПокупательДанные.Extrinsic;
	ПокупательНаименование = ПокупательДанные.Name.__content;
	ПокупательИНН = ПолучитьЗначениеРеквизитаУВХД(ПокупательРеквизиты, "INN");
	ПокупательКПП = ПолучитьЗначениеРеквизитаУВХД(ПокупательРеквизиты, "KPP");
	Если ЗначениеЗаполнено(ПокупательКПП) Тогда
		СписокРеквизитов.Плательщик = СтрШаблон("%1, ИНН %2, КПП %3", ПокупательНаименование, ПокупательИНН, ПокупательКПП);
	Иначе
		СписокРеквизитов.Плательщик = СтрШаблон("%1, ИНН %2", ПокупательНаименование, ПокупательИНН);
	КонецЕсли;
	СписокРеквизитов.АдресПлательщика = АдресУВХДСтрокой(ПокупательДанные.PostalAddress);
	
КонецПроцедуры

Функция АдресУВХДСтрокой(СтруктураАдреса)
	
	Индекс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураАдреса, "PostalCode", "");
	Город = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураАдреса, "City", "");
	Улица = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураАдреса, "Street", "");
	
	Возврат СтрШаблон("%1, %2, %3", Индекс, Город, Улица);	
	
КонецФункции

Функция ПолучитьЗначениеРеквизитаУВХД(МассивДанных, КлючПоиска)
	
	Если Не ТипЗнч(МассивДанных) = Тип("Массив") Тогда
		Возврат Неопределено;		
	КонецЕсли;		
	
	НайденноеЗначение = Неопределено;
	
	Для каждого ДанныеРеквизита Из МассивДанных Цикл
		Если ДанныеРеквизита.name = КлючПоиска Тогда
			НайденноеЗначение = ДанныеРеквизита.__content;	
		КонецЕсли;		
	КонецЦикла;
	
	Возврат НайденноеЗначение;
		
КонецФункции

Функция ОбработатьИПолучитьСведенияОТоварахСчетаУВХД(СтруктураСчета)
	
	СтрокиСведТов = Новый Массив;
	МассивСтрокСведТов = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураСчета, "InvoiceDetailRequest.InvoiceDetailOrder.InvoiceDetailItem", Новый Массив);
	Для Каждого Элем Из МассивСтрокСведТов Цикл
		
		СведТов = Новый Структура;
		
		СведТов.Вставить("НПП", "invoiceLineNumber");
		СведТов.Вставить("ТоварУслуга", "Distribution.__content");
		СведТов.Вставить("Единица", "UnitOfMeasure");
		СведТов.Вставить("Количество", "quantity");
		СведТов.Вставить("Цена", "UnitPrice.Money.__content");
		СведТов.Вставить("СтавкаНДС", "Tax.Description.__content");
		СведТов.Вставить("СуммаБезНДС", "");
		СведТов.Вставить("Сумма", "SubtotalAmount.Money.__content");
		СведТов.Вставить("СуммаНДС", "Tax.Money.__content");
				
		Для Каждого Тов Из СведТов Цикл	
			СведТов[Тов.Ключ] = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Элем, Тов.Значение);
		КонецЦикла;
		
		СтрокиСведТов.Добавить(СведТов);
		
	КонецЦикла;
	
	Возврат СтрокиСведТов;
	
КонецФункции

Процедура ОбработатьРеквизитыИтоговСчетаУВХД(СписокРеквизитов, СтруктураСчета)
	
	СписокРеквизитов.ИтогоСНДС = СтруктураСчета.InvoiceDetailRequest.InvoiceDetailSummary.SubtotalAmount.Money.__content;
	СписокРеквизитов.ИтогоБезНДС = СтруктураСчета.InvoiceDetailRequest.InvoiceDetailSummary.TotalAmountWithoutTax.Money.__content;
	СписокРеквизитов.ИтогоНДС = СтруктураСчета.InvoiceDetailRequest.InvoiceDetailSummary.Tax.Money.__content;
	
КонецПроцедуры

Процедура ОбработатьДополнительныеРеквизитыСчетаУВХД(СписокРеквизитов, ДополнительныеПараметры = Неопределено)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;			
	КонецЕсли;
	
	СтрокиСведТов = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "СтрокиСведТов", Новый Массив);	
	ИдентификаторЭД = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "ИдентификаторЭД", 0);	
	
	СуммаПоДокументу = СписокРеквизитов["ИтогоСНДС"];
	СуммаПоДокументу = ?(ЗначениеЗаполнено(СуммаПоДокументу), СуммаПоДокументу, 0);
	ПараметрыПредметаИсчисления = СписокРеквизитов["Валюта"].ПараметрыПрописи;
	СуммаПрописью = ЧислоПрописью(СуммаПоДокументу,, ПараметрыПредметаИсчисления);
	СписокРеквизитов.Вставить("СуммаПрописью", СуммаПрописью);	
	
	СписокРеквизитов.Вставить("ВсегоПозиций", СтрокиСведТов.Количество());
	СписокРеквизитов.Вставить("ИтогоСНДСФормат",Формат(СуммаПоДокументу, "ЧДЦ=2"));
	СписокРеквизитов.Вставить("ИДДок", Формат(ИдентификаторЭД, "ЧГ="));
	
КонецПроцедуры

