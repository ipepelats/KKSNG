// Выполняет команду подписания квитанций документа для списка электронных документов
//
// Параметры:
//  ЭлектронныеДокументы - Массив из СправочникСсылка.ККСНГ_ЭлектронныеДокументы - Список обрабатываемых электронных документов
//	ПараметрыАвторизации - Структура - см. ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации
//
// Возвращаемое значение:
//   Булево - Истина
//   
Функция ОбработатьКомандуКурьерПодписатьКвитанцииДокумента(ЭлектронныеДокументы, ПараметрыАвторизации, ИмяКоманды = "", УникальныйИдентификатор = "") Экспорт
	
	Перем ОрганизацияЭДО, КонтрагентЭДОКвитанции, ДанныеПодписантаКвитанции;
	Перем КонтекстТокена, Сертификат, Квитанция;
	Перем КвитанцииДокументов, ЭлектронныйДокумент, ОбновлениеКвитанции, КвитанцииДокумента;
	Перем РеквизитыДокумента, ПоследняяОшибка, ТекстСообщения, ЗапросДанныхПодписанта;
	
	КвитанцииДокументов = Новый Массив;
	КонтрагентЭДОКвитанции = Новый Соответствие;
	ДанныеПодписантаКвитанции = Новый Соответствие;
	
	// Получаем сертификат из параметров авторизации
	Если ПараметрыАвторизации.СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка") Тогда
		КонтекстТокена = ПараметрыАвторизации.КонтекстТокена;
		Сертификат = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(КонтекстТокена, "СертификатЭП", Неопределено);
	Иначе
		Сертификат = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыАвторизации, "СертификатЭП", Неопределено);
		Если ТипЗнч(Сертификат) <> Тип("СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования") Или Сертификат.Пустая() Тогда
			Сертификат = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл
		
		ОбновлениеКвитанции = ККСНГ_ДокументооборотВызовСервера.ОбновитьКвитанцииЭлектронногоДокументаПоДаннымИзКурьера(ЭлектронныйДокумент, ПараметрыАвторизации);
		
		РеквизитыДокумента = ККСНГ_ОбъектыИБВызовСервера.ПолучитьПрофильЭДООрганизацииИКонтрагентаДокумента(ЭлектронныйДокумент);
		Если ОрганизацияЭДО = Неопределено Тогда
			ОрганизацияЭДО = РеквизитыДокумента.ОрганизацияЭДО;
		КонецЕсли;
		
		КвитанцииДокумента = ККСНГ_ОбъектыИБВызовСервера.ПолучитьКвитанцииДокумента(ЭлектронныйДокумент, Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КвитанцииДокументов, КвитанцииДокумента);
		
		Для каждого Квитанция Из КвитанцииДокумента Цикл
			
			ЗапросДанныхПодписанта = ККСНГ_ОтправкаЭДВызовСервера.ПолучитьСтруктуруДанныхПодписанта();
			
			Если Сертификат <> Неопределено Тогда
				// Машиночитаемая доверенность
				ЗапросДанныхПодписанта = ККСНГ_ОтправкаЭДВызовСервера.ПолучитьДанныеПодписанта(ОрганизацияЭДО, РеквизитыДокумента.КонтрагентЭДО, Сертификат);
				Если Не ЗапросДанныхПодписанта.Успех Тогда
					
					ПоследняяОшибка = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ЗапросДанныхПодписанта.Журнал);
					Если ПоследняяОшибка <> Неопределено Тогда
						ТекстСообщения = ККСНГ_ЛогированиеКлиентСервер.ТекстСообщения(ПоследняяОшибка);
					Иначе
						ТекстСообщения = "Не удалось получить данные подписанта: неизвестная ошибка";
					КонецЕсли;
					
					ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросДанныхПодписанта.Журнал);
					
					Возврат Ложь;
					
				КонецЕсли;
				
				ЗапросДанныхПодписанта = ЗапросДанныхПодписанта.Результат;
				
			КонецЕсли;
			
			КонтрагентЭДОКвитанции.Вставить(Квитанция, РеквизитыДокумента.КонтрагентЭДО);
			ДанныеПодписантаКвитанции.Вставить(Квитанция, ЗапросДанныхПодписанта);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если КвитанцииДокументов.Количество() Тогда
		ККСНГ_КвитанцииКлиент.ОтправитьОтветНаКвитанцию(КвитанцииДокументов, ОрганизацияЭДО, ПараметрыАвторизации, Сертификат, КонтрагентЭДОКвитанции, ДанныеПодписантаКвитанции, ИмяКоманды, УникальныйИдентификатор);
	Иначе
		ККСНГ_ДокументооборотВызовСервера.ОбновитьЭлектронныеДокументыПоДаннымИзКурьера(ЭлектронныеДокументы, ОрганизацияЭДО, ПараметрыАвторизации);
		Параметры = Новый Структура("Результат", ИмяКоманды);
		Оповестить("Все квитанции подписаны", Параметры, УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область Авторизация

Функция ПустыеПараметрыАвторизации()
	
	Возврат Новый Структура("СпособАвторизации,AuthToken,КонтекстТокена,СертификатЭП");
	
КонецФункции

#КонецОбласти

Процедура ОбработатьРезультатЭтапа(РезультатЭтапа, ЭлектронныйДокумент, ПараметрыАвторизации)
	
	Перем ЭлектронныеДокументы;
	Перем ОрганизацияЭДО, ОбработкаНештатнойСитуации;
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("Массив") Тогда
		ЭлектронныеДокументы = ЭлектронныйДокумент;
	Иначе
		ЭлектронныеДокументы = Новый Массив;
		ЭлектронныеДокументы.Добавить(ЭлектронныйДокумент);
	КонецЕсли;
	
	Для каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл
		
		Если Не РезультатЭтапа.Успех Тогда
			
			ОрганизацияЭДО = ККСНГ_ОбъектыИБВызовСервера.ПолучитьПрофильЭДООрганизацииДокумента(ЭлектронныйДокумент);
			ККСНГ_ДокументооборотВызовСервера.ОбновитьЭлектронныйДокументПоДаннымИзКурьера(ЭлектронныйДокумент, ОрганизацияЭДО, ПараметрыАвторизации);
			
			ОбработкаНештатнойСитуации = ККСНГ_ДокументооборотВызовСервера.ОбработатьНештатныеСитуацииПоСобытиямДокумента(ЭлектронныйДокумент, ОрганизацияЭДО, ПараметрыАвторизации);
			
			Если ОбработкаНештатнойСитуации.Успех Тогда
				ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ОбработкаНештатнойСитуации.Журнал, "-1");
			Иначе
				Если РезультатЭтапа.Свойство("Журнал") Тогда
					ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(РезультатЭтапа.Журнал, "-1");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Оповестить("ПослеКомандыСФЕРАКурьер", , ЭлектронныйДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОтсутствующиеЭлементы(МассивОбщий, МассивПоиска1, МассивПоиска2)
	
	Перем МассивРезультат, ЭлементПоиска;
	
	МассивРезультат = Новый Массив;
	Для каждого ЭлементПоиска Из МассивОбщий Цикл
		Если Не ЭлементВходитВ(ЭлементПоиска, МассивПоиска1, МассивПоиска2) Тогда
			МассивРезультат.Добавить(ЭлементПоиска);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивРезультат;
	
КонецФункции

Функция ЭлементВходитВ(ЭлементПоиска, Массив1, Массив2 = Неопределено)
	
	Для каждого ЭлементПоиска Из Массив1 Цикл
		Если Не Массив1.Найти(ЭлементПоиска) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Массив2 = Неопределено Тогда
		Если Не Массив2.Найти(ЭлементПоиска) = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьЭлектронныеДокументыИзДополнительныхПараметров(ДополнительныеПараметры)
	
	Перем ЭлектронныеДокументы;
	
	Если ДополнительныеПараметры.Свойство("ЭлектронныеДокументы") Тогда
		ЭлектронныеДокументы = ДополнительныеПараметры.ЭлектронныеДокументы;
	Иначе
		ЭлектронныеДокументы = Новый Массив;
		ЭлектронныеДокументы.Добавить(ДополнительныеПараметры.ЭлектронныйДокумент);
	КонецЕсли;
	
	Возврат ЭлектронныеДокументы;
	
КонецФункции

#КонецОбласти