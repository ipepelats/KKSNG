#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеSslgate(Контекст)
	
	Контекст["URL"] = "";
	Контекст["SID0"] = "";
	
	Текст = Новый ЧтениеТекста(Контекст["ФайлURL"]);
	
	Стр = Текст.ПрочитатьСтроку();
	Пока Стр <> Неопределено Цикл
		
		Стр = СокрЛП(Стр);		
		Если ВРег(Лев(Стр, 4)) = "URL=" Тогда
			
			стрkeyurl = Прав(Стр, СтрДлина(Стр) - 4);
			
			ВремСтр = ?(Прав(стрkeyurl, 1) = "/", Лев(стрkeyurl, СтрДлина(стрkeyurl) - 1), стрkeyurl);
			ВремСтр = СтрЗаменить(ВремСтр, "/", Символы.ПС);
			
			стрkeyurl = "";
			
			Для Инд = 1 По СтрЧислоСтрок(ВремСтр) - 1 Цикл
				
				стрkeyurl = стрkeyurl + СтрПолучитьСтроку(ВремСтр, Инд) + "/";
				
				Если ВРег(СтрПолучитьСтроку(ВремСтр, Инд)) = "VPNKEYLOCAL" Тогда
					
					стрSID0 = СтрПолучитьСтроку(ВремСтр, Инд + 1);
					
					Контекст["SID0"] = стрSID0;
					Контекст["URL"] = стрkeyurl;
					
					Возврат Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Стр = Текст.ПрочитатьСтроку();
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ОбработатьСтрокуDevCfg(Знач СтрокаDevCfg)
	
	СтрокаDevCfg = СтрокаDevCfg + " ";
	ПозицияVT = Найти(СтрокаDevCfg, "_VT");
	ИнформацияКонфигурации = Новый Соответствие;
	
	Если ПозицияVT Тогда
		
		ПозицияVT = ПозицияVT + 1;
		ТекущийКлюч = "";
		ТекущееЗначение = "";
		
		Для Инд = ПозицияVT По СтрДлина(СтрокаDevCfg) Цикл
			
			ТекущийСимвол = Сред(СтрокаDevCfg, Инд, 1); 			
			Если ТекущийСимвол >= "0" И ТекущийСимвол <= "9" Тогда 
				// Это цифра  - номер версии прошивки или модуля
				ТекущееЗначение = ТекущееЗначение + ТекущийСимвол; 
			Иначе
				// Это не цифра - имя прошивки или модуля				
				Если НЕ ПустаяСтрока(ТекущийКлюч) И НЕ ПустаяСтрока(ТекущееЗначение) Тогда
					ИнформацияКонфигурации.Вставить(ВРег(ТекущийКлюч), ТекущееЗначение);		
					ТекущийКлюч = "";
					ТекущееЗначение = "";
				КонецЕсли;				
				
				ТекущийКлюч = ТекущийКлюч + ТекущийСимвол;
				
			КонецЕсли;						
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ИнформацияКонфигурации;
	
КонецФункции

Процедура ЗакрытьФормуОжидания(Форма)
	Если ТипЗнч(Форма) = Тип("УправляемаяФорма") Тогда
		Форма.ЗакрытьФормуПринудительно = Истина;
		Форма.Закрыть();
	КонецЕсли;
КонецПроцедуры	

Процедура ОчиститьАвторизационныеДанныеТокена(Контекст)
	
	Контекст.ПредСертификатЭП = Контекст.СертификатЭП;
	Контекст.ПредAuthCookie = Контекст.AuthCookie;
	
	Контекст.AuthCookie = "";	
	Контекст.SID2 = "";
	Контекст.Пользователь = "";
	Контекст.Пароль = "";
	Контекст.СертификатЭП = Неопределено;
	
КонецПроцедуры

Функция НайтиСертификатУстройстваПоОтпечатку(СертификатКонтекста, СписокСертификатов)
	
	НайдСертификат = Неопределено;
	
	Если ТипЗнч(СертификатКонтекста) = Тип("Структура") Тогда
		Отпечаток = СертификатКонтекста.Отпечаток;
		СертификатКонтекста = Неопределено;
		Для каждого ТекЭлемент Из СписокСертификатов Цикл
			ТекСертификат = ТекЭлемент.Значение;
			Если Отпечаток = ТекСертификат.Отпечаток Тогда
				НайдСертификат = ТекСертификат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НайдСертификат;
	
КонецФункции

