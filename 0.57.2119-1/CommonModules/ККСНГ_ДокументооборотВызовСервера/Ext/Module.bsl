	Если ЗапросМетода.Успех Тогда
		
		Ответ.Результат = ЗапросМетода.Результат;
		Ответ.Успех = Истина;
		
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции

// Получение предложений об аннулировании на сервере СФЕРА Курьер
//
// Параметры:
//	ДокументСсылка - Справочник.ККСНГ_ЭлектронныеДокументы
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура TicketDetails, см. https://confluence.esphere.ru/display/SBER/FileContent
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьПредложениеНаАннулированиеИзКвитанций(Знач ДокументСсылка, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ЗапросМетода = ККСНГ_APIКурьер.v1_TicketsTickets(ПараметрыАвторизации, ДокументСсылка.Id);	
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
	
	Если НЕ ЗапросМетода.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
		
	МассивКвитанций = ЗапросМетода.Результат.TicketDetails;
	
	Если ТипЗнч(МассивКвитанций) = Тип("Массив") Тогда
		
		AvoidanceRequest = Неопределено;
		
		Для Каждого Квитанция Из МассивКвитанций Цикл
			Если Квитанция.Type <> "AvoidanceRequest" Тогда	
				Продолжить;
			КонецЕсли;
			
			Если AvoidanceRequest = Неопределено 
				ИЛИ AvoidanceRequest.Date < Квитанция.Date Тогда
				AvoidanceRequest = Квитанция;
			КонецЕсли;	
			
		КонецЦикла;	
		
		Если AvoidanceRequest <> Неопределено Тогда 
			Ответ.Результат = AvoidanceRequest;
			Ответ.Успех = Истина;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Ответ;
	
КонецФункции

// Формирует ответную квитанцию отказ от предложения на аннулирование документа (УОУ).
//
// Параметры:
//  ДокументСсылка		 - 			 - Справочник.ККСНГ_ЭлектронныеДокументы
//  ТекстКомментария	 - 			 - Строка
//  ПараметрыАвторизации - Структура - содержит:
//  * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
