// Получение информации о статусе отправки документа и связанных с ним квитанций/подписей роуминговому получателю
//
// Параметры:
//	ЭлектронныйДокументСсылка - Ссылка СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПрофильЭДООрганизации     - Справочник.ККСНГ_Организации - профиль ЭДО
//	ПараметрыАвторизации      - Структура - содержит:
//     * СпособАвторизации    - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken            - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена       - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура см. https://confluence.esphere.ru/display/SBER/Document.RoamingInfo
//
Функция ПолучитьСтатусыВРоуминге(ЭлектронныйДокументСсылка, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();

	Результат = ККСНГ_APIКурьер.v2_DocumentRoamingInfo(ПараметрыАвторизации, ЭлектронныйДокументСсылка.Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, Результат.Журнал, Ложь);

	Если Результат.Успех Тогда
		ПолученныеСтатусы = Результат.Результат.DocumentRoamingInfo;
		Для каждого ТекСтатус Из ПолученныеСтатусы Цикл
			ТекСтатус.Вставить("ПредставлениеДокумента");
			ТекСтатус.ПредставлениеДокумента = ПредставлениеТипаТранспортногоДокумента(ТекСтатус.DocumentType);
			ТекСтатус.Вставить("ПредставлениеСтатуса");
			ТекСтатус.ПредставлениеСтатуса = ПредставлениеСтатусаВРоуминге(ТекСтатус.RoamingStatus);
		КонецЦикла; 
		Ответ.Результат = ПолученныеСтатусы;
		Ответ.Успех = Истина;
		// Обновляем документ из Курьера.
		ЭлектронныеДокументы = Новый Массив;
		ЭлектронныеДокументы.Добавить(ЭлектронныйДокументСсылка);
		ККСНГ_ДокументооборотВызовСервера.ОбновитьЭлектронныеДокументыПоДаннымИзКурьера(ЭлектронныеДокументы, 
																				ПрофильЭДООрганизации, 
																					ПараметрыАвторизации);
	Иначе 
		ОписаниеОшибки = "Не удалось получить актуальные статусы в роуминге: "
				+ ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Результат.Журнал);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "RI-00001");
	КонецЕсли;

	Возврат Ответ;

КонецФункции

