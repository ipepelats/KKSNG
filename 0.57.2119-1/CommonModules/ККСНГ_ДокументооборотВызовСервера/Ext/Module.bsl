			ОбновитьЭлектронныеДокументыПоДаннымИзКурьера(МассивПараметр, ПрофильЭДООрганизации, ПараметрыАвторизации);
			
		КонецЕсли;
				
	КонецЕсли; 
			
	Возврат Ответ;
	 
КонецФункции

#КонецОбласти

#Область ЗагрузкаДокументов

// Запись объектов документов в ИБ по данным с сервера СФЕРА Курьер
//
// Параметры:
//	ДокументыПоПапкам      - Структура - Имя папки, массив id
//	ПрофильЭДООрганизации  - СправочникСсылка.ККСНГ_Организации
//	АдресРезультата        - Строка - Адрес хранения результата выполнения
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
Процедура ЗаписатьДокументыПоИД(ДокументыПоПапкам, ПрофильНастройкиЭДО, АдресРезультата, ПараметрыАвторизации) Экспорт 
	
	РезультатыПоПапкам = Новый Соответствие;
	СохраненныеДокументы = Новый Соответствие;
	ДанныеПрогрессаПапки = Новый Соответствие;
	
	КоличествоДоковВсего = 0;
	Для каждого ТекПапка Из ДокументыПоПапкам Цикл
		КоличествоДоковВсего = КоличествоДоковВсего + ТекПапка.Значение.Количество();	
	КонецЦикла;
	СчетчикЗагрузкиВсего = 0;
	
	Для каждого ТекПапка Из ДокументыПоПапкам Цикл
		
		ИмяПапки = ТекПапка.Ключ;
		ДокументыПапки = ТекПапка.Значение;
		ЗаписанныхДокументов = 0;
		ОшибокДокументов = 0;
		ОшибокКвитанций = 0;
		СчетчикЗагрузкиПапки = 0;
		
		Для каждого ТекИД Из ДокументыПапки Цикл 
			
			СообщитьПрогрессЗагрузкиДокументов(ИмяПапки, КоличествоДоковВсего, СчетчикЗагрузкиВсего, СчетчикЗагрузкиПапки, ДанныеПрогрессаПапки);
			
			Если СохраненныеДокументы.Получить(ТекИД) <> Неопределено Тогда
				ЗаписанныхДокументов = ЗаписанныхДокументов + 1;
				Продолжить;
			КонецЕсли;	
				
			ЗапросПоДокументу = ККСНГ_ДокументооборотВызовСервера.ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(ТекИД, ПрофильНастройкиЭДО, ПараметрыАвторизации, Истина);
			
			Если ЗапросПоДокументу.Успех Тогда
				СохраненныеДокументы.Вставить(ТекИД);
				ЗаписанныхДокументов = ЗаписанныхДокументов + 1;
				ЭДСсылка = ЗапросПоДокументу.Результат;
				
				ОбновлениеКвитанций = ККСНГ_ДокументооборотВызовСервера.ОбновитьКвитанцииЭлектронногоДокументаПоДаннымИзКурьера(ЭДСсылка, ПараметрыАвторизации);
				
				Если НЕ ОбновлениеКвитанций.Успех Тогда
					ОшибокКвитанций = ОшибокКвитанций + 1;							
				КонецЕсли; 				
				
			Иначе
				ОшибокДокументов = ОшибокДокументов + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		РезультатЗаписи = Новый Структура;
		РезультатЗаписи.Вставить("ЗаписанныхДокументов", ЗаписанныхДокументов);
		РезультатЗаписи.Вставить("ОшибокДокументов", ОшибокДокументов);
		РезультатЗаписи.Вставить("ОшибокКвитанций", ОшибокКвитанций);
		РезультатЗаписи.Вставить("НеобходимаПереинициализация", ПараметрыАвторизации.Свойство("НеобходимаПереинициализация"));
				
		РезультатыПоПапкам.Вставить(ИмяПапки, РезультатЗаписи);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(РезультатыПоПапкам, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьФильтрДляВходящегоДокумента(Document)
	
	// От Сбербанка принимаем только определенные типы документов
	КодЭДОСбера = ККСНГ_РаботаСКонтрагентамиВызовСервера.КодЭДОСбера();
	
	Если Document.SellerCode = КодЭДОСбера Тогда
		
		РазрешенныеТипы = Новый Соответствие;
		РазрешенныеТипы.Вставить("UPD_SF", Истина);
		РазрешенныеТипы.Вставить("UPD_DOP", Истина);
		РазрешенныеТипы.Вставить("REZRU", Истина);
		РазрешенныеТипы.Вставить("BILL", Истина);
		РазрешенныеТипы.Вставить("ACT", Истина);
		РазрешенныеТипы.Вставить("ACCOUNT", Истина);
		РазрешенныеТипы.Вставить("AGREEMENT", Истина);
		РазрешенныеТипы.Вставить("DOCUMENT", Истина);
		РазрешенныеТипы.Вставить("UVHD_BILL", Истина);
		РазрешенныеТипы.Вставить("ACT_ECOSYSTEM", Истина);
		РазрешенныеТипы.Вставить("OTHER_REP", Истина);

		Возврат (РазрешенныеТипы[Document.DocumentTypeCode] <> Неопределено);
		
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

Процедура СообщитьПрогрессЗагрузкиДокументов(ИмяПапки, КоличествоДоковВсего, СчетчикЗагрузкиОбщий, СчетчикЗагрузкиПапки, ДанныеПрогрессаПапки)
	
	СчетчикЗагрузкиОбщий = СчетчикЗагрузкиОбщий + 1;
	СчетчикЗагрузкиПапки = СчетчикЗагрузкиПапки + 1;	
	
	ПроцентВыполнения = Цел((СчетчикЗагрузкиОбщий) * 100 / КоличествоДоковВсего);
	ИмяПапкиДляПользователя = ККСНГ_ОбщегоНазначенияВызовСервера.ПапкиДокументов().Получить(ИмяПапки);
	ТекстСообщения = СтрШаблон("[%1] Обработано: %2", ИмяПапкиДляПользователя, СчетчикЗагрузкиПапки);
	ПараметрыПрогресса = Новый Структура("ИмяПапки, Процент", ИмяПапки, ПроцентВыполнения);
	ДанныеПрогрессаПапки.Вставить(ИмяПапки, ПараметрыПрогресса);
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения, ТекстСообщения, Новый Структура("ДанныеПрогрессаПапки", ДанныеПрогрессаПапки));
	
КонецПроцедуры

#КонецОбласти