// Получает вложения документа ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	АдресХранилища         - Строка - адрес рузультата
//	ИдентификаторЭД        - Число - id документа
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
//	структура Document.Attachments.Attachment, см. https://confluence.esphere.ru/display/SBER/Document
//
Процедура ПолучитьВложенияЭлектронногоДокументаИзКурьераВФоновомЗадании(АдресХранилища, ИдентификаторЭД, ПараметрыАвторизации) Экспорт
				
	ЗапросВложений = ПолучитьВложенияЭлектронногоДокументаИзКурьера(ИдентификаторЭД, ПараметрыАвторизации);
					
	ПоместитьВоВременноеХранилище(ЗапросВложений, АдресХранилища); 
	 	
КонецПроцедуры

// Получает вложения документа ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	ИдентификаторЭД        - Число - id документа
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	структура Document.Attachments.Attachment, см. https://confluence.esphere.ru/display/SBER/Document
//
Функция ПолучитьВложенияЭлектронногоДокументаИзКурьера(ИдентификаторЭД, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		
	ЗапросПоДокументу = ПолучитьДетальнуюИнформациюЭДИзКурьера(ИдентификаторЭД, ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПоДокументу.Журнал, Ложь);
	
	Если ЗапросПоДокументу.Успех Тогда
		
		МассивВложений = ЗапросПоДокументу.Результат.Attachments.Attachment;
		
		Ответ.Результат = МассивВложений;
		Ответ.Успех = Истина;
				
	КонецЕсли;
			
	Возврат Ответ;
	 	
КонецФункции

// Получает вложения документа ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	ИдентификаторыВложений - Число 
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Массив файлов во временном хранилище
//
Функция ПолучитьВложенияИзКурьера(ИдентификаторыВложений, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ЗапросВложений = ПолучитьФайлыВложенийЭлектронногоДокументаИзКурьера(ИдентификаторыВложений, ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросВложений.Журнал, Ложь);
		
	Если ЗапросВложений.Успех Тогда
		
		МассивОписанийФайлов = Новый Массив;
		
		Для каждого СтруктураВложения Из ЗапросВложений.Результат Цикл
			
			Адрес = ПоместитьВоВременноеХранилище(СтруктураВложения.Content);
			ИмяФайла = Формат(СтруктураВложения.Id, "ЧГ=0") + "_" + СтруктураВложения.FileName;
			ОписаниеФайл = Новый ОписаниеПередаваемогоФайла(ИмяФайла, Адрес);
			
			МассивОписанийФайлов.Добавить(ОписаниеФайл);
			
		КонецЦикла;
		
		Ответ.Успех = Истина;
		Ответ.Результат = МассивОписанийФайлов;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает вложения документа ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	ИдентификаторыВложений - Число 
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Массив , см. https://confluence.esphere.ru/display/SBER/Document.Attachment
//
Функция ПолучитьФайлыВложенийЭлектронногоДокументаИзКурьера(ИдентификаторыВложений, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	МассивВложений = Новый Массив;
	
	Для каждого Идентификатор Из ИдентификаторыВложений Цикл 
		
		ЗапросВложений = ККСНГ_APIКурьер.v1_DocumentAttachment(ПараметрыАвторизации, Идентификатор);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросВложений.Журнал, Ложь);
	
		Если ЗапросВложений.Успех Тогда
			
			СтруктураВложения = ЗапросВложений.Результат;
			СтруктураВложения.Вставить("Id", Идентификатор);
						
			МассивВложений.Добавить(СтруктураВложения);
						
		КонецЕсли;
		
	КонецЦикла;
	
	Ответ.Результат = МассивВложений;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	 	
КонецФункции

// Заполняет данные подписанта в черновике на сервере СФЕРА Курьер
//	https://confluence.esphere.ru/display/SBER/Document.ChangeSigner+v.2
//
// Параметры:
//	ДокументСсылка          - Справочник.ККСНГ_ЭлектронныеДокументы
//	ДополнительныеПараметры - Произвольный, не используется
//	ПараметрыАвторизации    - Структура - содержит:
//     * СпособАвторизации  - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken          - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена     - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаполнитьПодписантаВЧерновике(Знач ДокументСсылка, Знач ДополнительныеПараметры, ПрофильЭДООрганизации, Знач ДанныеПодписанта, ПараметрыАвторизации) Экспорт
	
	Перем Ответ;
	Перем DocumentId, DocumentSigner, Person;
	Перем СертификатСсылка, Организация;
	Перем ЗапросДокумента, ЗапросМетода;
	Перем ПрофильЭДОКонтрагента, ЭтоФизЛицо, ДанныеСвидетельства;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если ТипЗнч(ДокументСсылка) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") И ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		ПрофильЭДОКонтрагента = ККСНГ_РаботаСКонтрагентамиВызовСервера.ПрофильКонтрагентаПоКодуЭДО(ПрофильЭДООрганизации, ДокументСсылка.BuyerCode);
		
		Если ПараметрыАвторизации.СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка Тогда
			СертификатСсылка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыАвторизации.КонтекстТокена, "СертификатЭП");
		Иначе
			СертификатСсылка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыАвторизации, "СертификатЭП");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПрофильЭДООрганизации)Или Не ЗначениеЗаполнено(СертификатСсылка) Тогда
			Возврат Ответ;
		КонецЕсли;
		
		Организация = ПрофильЭДООрганизации.Организация;
		ЭтоФизЛицо = Ложь;
		ОбменСКонтрагентамиПереопределяемый.ЭтоФизЛицо(Организация, ЭтоФизЛицо);
		
		DocumentSigner = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_DocumentSigner");
		Person = DocumentSigner.Person;
		
		// Машиночитаемые доверенности
		Если СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
			DocumentSigner.MchdViewType = "Meta";
		КонецЕсли;
		
		Если СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Пакет") = 0 Тогда
			DocumentSigner.MchdViewType = "File";
		КонецЕсли;
		
		Если Не ПустаяСтрока(DocumentSigner.MchdViewType) Тогда
			
			DocumentSigner.AccessMode = ДанныеПодписанта.МЧД.ИнформационнаяСистема;
			DocumentSigner.StartDate = Формат(ДанныеПодписанта.МЧД.ДатаНачала, "ДФ='yyyy-MM-dd'");
			DocumentSigner.Uuid = ДанныеПодписанта.МЧД.Номер;
			
		КонецЕсли;
		
		DocumentSigner.Inn = Организация.ИНН;
		DocumentSigner.Person = Person;
		DocumentSigner.Title = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта, "Должность");
		
		Person.FirstName = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта, "Имя");
		Person.LastName = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта, "Фамилия");
		Person.MiddleName = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта, "Отчество");
		
		DocumentSigner.SignerType = "Organization";
		
		Если ЭтоФизЛицо Тогда
			
			DocumentSigner.SignerType = "Individual";
			
			ДанныеСвидетельства = "";
			ОбменСКонтрагентамиПереопределяемый.ДанныеСвидетельстваОРегистрацииИП(Организация, ДанныеСвидетельства);
			
			Если Не ПустаяСтрока(ДанныеСвидетельства) Тогда
				DocumentSigner.RegistrationRequisites = ДанныеСвидетельства;
			КонецЕсли;
			
			// Обходим проверку сервиса, в блоке подписанта нет реквизита свидетельства о государственной регистрации
			Если Не ЗначениеЗаполнено(DocumentSigner.RegistrationRequisites) И ДокументСсылка.FormatVersion <> "5.01" Тогда
				DocumentSigner.RegistrationRequisites = "-";
			КонецЕсли;
			
		КонецЕсли;
		
		DocumentId = ДокументСсылка.Id;
		
		ЗапросМетода = ККСНГ_APIКурьер.v2_DocumentChangeSigner(ПараметрыАвторизации, DocumentId, DocumentSigner);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
		
		Если Не ЗапросМетода.Успех Тогда
			Возврат Ответ;
		КонецЕсли;
		
		ЗапросДокумента = ОбновитьЭлектронныйДокументПоДаннымИзКурьера(ДокументСсылка, ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДокумента.Журнал, Ложь);
		
		Ответ.Успех = ЗапросДокумента.Успех;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получение содержимого вложенного в документ файла
//	https://confluence.esphere.ru/display/SBER/Document.Content+v.2
//
// Параметры:
//	ДокументСсылка          - Справочник.ККСНГ_ЭлектронныеДокументы
//	ДополнительныеПараметры - Произвольный, не используется
//	ПараметрыАвторизации    - Структура - содержит:
//     * СпособАвторизации  - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken          - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена     - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьСодержимоеЭлектронногоДокументаСКурьера(Знач ДокументСсылка, Знач ДополнительныеПараметры, ПараметрыАвторизации) Экспорт
		
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();	
	Ответ.Успех = Ложь;
		
	// Проверка корректности входящих параметров
	Если ЗначениеЗаполнено(ДокументСсылка) 
		И ТипЗнч(ДокументСсылка) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		
		DocumentId =  ДокументСсылка.Id;
		
		ЗапросМетода = ККСНГ_APIКурьер.v2_DocumentContent(ПараметрыАвторизации, DocumentId);
		
		Ответ.Успех = ЗапросМетода.Успех;
		
		Ответ.Результат = ЗапросМетода.Результат;
				
	КонецЕсли; 
			
	Возврат Ответ;
	 
КонецФункции

#КонецОбласти

#Область Квитанции

// Получает данные квитанции с сервера СФЕРА Курьер
//
// Параметры:
//	Id                      - Id квитанции в СФЕРА Курьер
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура TicketDetails, см. https://confluence.esphere.ru/display/SBER/TicketDetails
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьКвитанциюИзКурьера(Id, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных квитанции");
	
	ЗапросAPI = ККСНГ_APIКурьер.v1_TicketsTicket(ПараметрыАвторизации, Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		Ответ.Результат = ЗапросAPI.Результат;
		Ответ.Успех = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Обновляет уже записанную квитанцию с сервера СФЕРА Курьер
//
// Параметры:
//	КвитанцияСсылка          - СправочникСсылка.ККСНГ_Квитанции
//	ПараметрыАвторизации     - Структура - содержит:
//		* СпособАвторизации  - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken          - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена     - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	СправочникСсылка.ККСНГ_Квитанции - ссылка на обновленный элемент справочника
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ОбновитьКвитанциюПоДаннымИзКурьера(КвитанцияСсылка, ПараметрыАвторизации) Экспорт
	
	Если (ТипЗнч(КвитанцияСсылка) = Тип("СправочникСсылка.ККСНГ_Квитанции")
		И ЗначениеЗаполнено(КвитанцияСсылка)) Тогда
		
		Возврат ЗаписатьКвитанциюПоДаннымИзКурьера(КвитанцияСсылка.Id, КвитанцияСсылка.Владелец, ПараметрыАвторизации);

	КонецЕсли;
	                                                
КонецФункции

// Получает данные квитанции, ее содержимое (content), электронные подписи
// с сервера СФЕРА Курьер и записывает в ИБ
//
// Параметры:
//	Id - Id квитанции в СФЕРА Курьер
//	Владелец - СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПараметрыАвторизации  - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена   - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	СправочникСсылка.ККСНГ_Квитанции - ссылка на созданный или обновленный элемент справочника
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаписатьКвитанциюПоДаннымИзКурьера(Id, Владелец, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обновление данных квитанции " + Формат(Id, "ЧГ=; ЧФ=(Ч)"));
	
	ЗапросДанных = ПолучитьКвитанциюИзКурьера(Id, ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанных.Журнал, Ложь);
	
	Если ЗапросДанных.Успех Тогда
		
		// TODO: Запись в транзакции 2019-05-30 Попов Д.В., Лашин И.И.: добавлена транзакция, но нужно подумать про + ЗаписатьПрисоединенныйФайл()
		ЗаписьКвитанции = ККСНГ_ОбъектыИБВызовСервера.ЗаписатьКвитанцию(ЗапросДанных.Результат, Владелец);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьКвитанции.Журнал, Ложь);
		
		Если ЗаписьКвитанции.Успех Тогда
			
			КвитанцияСсылка = ЗаписьКвитанции.Результат;
			ЗаписьФайл = ККСНГ_ОбъектыИБВызовСервера.ЗаписатьПрисоединенныйФайл(ЗапросДанных.Результат.Content, КвитанцияСсылка);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьФайл.Журнал, Ложь);
			
			Ответ.Результат = КвитанцияСсылка;
			Ответ.Успех = Истина;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает список квитанций по ID документа сервера СФЕРА Курьер
//
// Параметры:
//	Id - Id документа в СФЕРА Курьер
//	ПараметрыАвторизации  - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена   - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Массив структур TicketDetails, см. https://confluence.esphere.ru/display/SBER/TicketDetails
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьСписокКвитанцийПоДокументуИзКурьера(Id, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных квитанции");
	
	ЗапросAPI = ККСНГ_APIКурьер.v1_TicketsTickets(ПараметрыАвторизации, Id);	
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		Ответ.Результат = ЗапросAPI.Результат;
		Ответ.Успех = Истина;
	КонецЕсли;
			
	Возврат Ответ;
	
КонецФункции

// Запись квитанций по документу ЭД в ИБ
//
// Параметры:
//	ЭлектроныйДокументСсылка - СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПараметрыАвторизации     - Структура - содержит:
//     * СпособАвторизации   - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken           - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена      - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ОбновитьКвитанцииЭлектронногоДокументаПоДаннымИзКурьера(ЭлектроныйДокументСсылка, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обновление квитанций электронного документа");
	
	ЗапросПоСпискуКвитанций = ПолучитьСписокКвитанцийПоДокументуИзКурьера(ЭлектроныйДокументСсылка.Id, ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПоСпискуКвитанций.Журнал, Ложь);
	
	Если ЗапросПоСпискуКвитанций.Успех Тогда
		
		СписокКвитанций = ЗапросПоСпискуКвитанций.Результат.TicketDetails;
		Для каждого Квитанция Из СписокКвитанций Цикл
			
			// У квитанций DocumentId всегда Неопределено, там где задан - ЭД.
			ЗаписьКвитанции = ККСНГ_ДокументооборотВызовСервера.ЗаписатьКвитанциюПоДаннымИзКурьера(Квитанция.Id, ЭлектроныйДокументСсылка, ПараметрыАвторизации);
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьКвитанции.Журнал, Ложь);
			
			Если Не ЗаписьКвитанции.Успех Тогда
				Ответ.Успех = Ложь;
				Возврат Ответ;
			КонецЕсли;
			
		КонецЦикла;
		
		Ответ.Успех = Истина;
		
	Иначе
		Ответ.Успех = Ложь;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает данные титула покупателя с сервера СФЕРА Курьер
//
// Параметры:
//	Id - Id документе в СФЕРА Курьер
//	ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации
//	СертификатСсылка - Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура FileContent, см. https://confluence.esphere.ru/display/SBER/FileContent
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьТитулПокупателяИзКурьера(Id, ПрофильЭДООрганизации, СертификатСсылка, ПараметрыАвторизации, СодержаниеОперации, ИмяФайла = "", ДанныеПодписанта, ВерсияФормата = "") Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Организация = ПрофильЭДООрганизации.Организация;
	
	AcceptInfo = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo");
	DocumentSignerInfo = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo.DocumentSigner.DocumentSignerInfo");
	Signer = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo.DocumentSigner.DocumentSignerInfo.Signer");
	Person = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo.DocumentSigner.DocumentSignerInfo.Signer.Person");
	MchdFile = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo.DocumentSigner.DocumentSignerInfo.MchdFile");
	
	SignerAuthority = ККСНГ_APIКурьер.ПолучитьСтруктуруПоТипуXDTO("type_UniversalDocumentAcceptInfo.DocumentSigner.DocumentSignerInfo.SignerAuthority");
	
	Person.LastName = СертификатСсылка.Фамилия;
	Person.FirstName = СертификатСсылка.Имя;
	Person.MiddleName = СертификатСсылка.Отчество;
	
	Signer.Inn = Организация.ИНН;
	Signer.Name = Организация.НаименованиеСокращенное;
	
	// TODO Реализовать сбор всех данных по организации в ПМ
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	
	ЭтоИП = Не МодульККСНГ_ПМ_РаботаСМетаданными.ЭтоЮрЛицо(Организация);
	
	Если ЭтоИП Тогда
		
		ОшибкаСвидетельстваИП = "";
		
		Если ПустаяСтрока(Организация.СвидетельствоСерияНомер) Тогда
			ОшибкаСвидетельстваИП = ОшибкаСвидетельстваИП + "Заполните, пожалуйста, серию и № свидетельства о государственной регистрации ИП." + Символы.ПС;
		КонецЕсли;
		
		Если Организация.СвидетельствоДатаВыдачи = Дата('00010101') Тогда
			ОшибкаСвидетельстваИП = ОшибкаСвидетельстваИП + "Заполните, пожалуйста, дату выдачи свидетельства о государственной регистрации ИП." + Символы.ПС;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ОшибкаСвидетельстваИП) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СокрЛП(ОшибкаСвидетельстваИП), "DT-00004", , Организация);
			Возврат Ответ;
		КонецЕсли;
		
		Шаблон = НСтр("ru = '%1 от %2'");
		ДатаВыдачиСтрокой = Формат(Организация.СвидетельствоДатаВыдачи, "ДЛФ=D");
		Signer.RegistrationRequisites = СтрШаблон(Шаблон, СокрЛП(Организация.СвидетельствоСерияНомер), ДатаВыдачиСтрокой);
		
	Иначе
		Должность = СертификатСсылка.Должность;
		Signer.Title = ?(ЗначениеЗаполнено(Должность), Должность, "Сотрудник");
	КонецЕсли;
	
	DocumentSignerInfo.SigningDate = ТекущаяДатаСеанса(); // Дата подписания документа
	
	// Блок MchdFile заполняется только при варианте метаданные (AuthorityMethod = 3)
	Если ДанныеПодписанта.ТребуетсяМЧД = Истина И СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
		
		MchdFile.SingleNumber = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта.МЧД, "Номер");
		MchdFile.AttorneyDate = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта.МЧД, "ДатаНачала");
		MchdFile.InformationSystem = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПодписанта.МЧД, "ИнформационнаяСистема");
		DocumentSignerInfo.MchdFile.Добавить(MchdFile);
		
	КонецЕсли;
	
	Если ДанныеПодписанта.ТребуетсяМЧД = Ложь Тогда
		DocumentSignerInfo.AuthorityMethod = 1; // Без доверенности
	ИначеЕсли СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Пакет") = 0 Тогда
		DocumentSignerInfo.AuthorityMethod = 2; // МЧД пакетом
	ИначеЕсли СтрСравнить(ДанныеПодписанта.ВариантОтправкиМЧД, "Метаданные") = 0 Тогда
		DocumentSignerInfo.AuthorityMethod = 3; // МЧД сведения об инф. системе
	Иначе
		DocumentSignerInfo.AuthorityMethod = 4; // МЧД отправляется отдельно
	КонецЕсли;
	
	Signer.SignerType = ?(ЭтоИП, "Individual", "Organization");
	Signer.Person = Person;
	
	SignerAuthority.Authority = "Должностные обязанности";
	SignerAuthority.AuthorityScope = 3;
	SignerAuthority.Condition = 5;
	
	DocumentSignerInfo.Signer.Добавить(Signer);
	DocumentSignerInfo.SignerAuthority.Добавить(SignerAuthority);
	AcceptInfo.DocumentSigner.DocumentSignerInfo.Добавить(DocumentSignerInfo);
	
	ЭтоКорректировка = ККСНГ_ОбщегоНазначенияКлиентСервер.ЭтоКорректировка(ИмяФайла);
	
	AcceptInfo.Date = ТекущаяДатаСеанса();
	AcceptInfo.DealSummary = ?(Не ЭтоКорректировка, "Товары (работы, услуги, права) приняты без расхождений (претензий)", "С изменением стоимости согласен");
	AcceptInfo.AcceptanceCode.ResultCode = ?(Не ЭтоКорректировка, "AcceptedNoDisaccord", Неопределено);
	
	// Документ подписан с расхождениями
	Если СодержаниеОперации = "2" И Не ЭтоКорректировка Тогда
		AcceptInfo.DealSummary = "Товары (работы, услуги, права) приняты с расхождениями (претензией)";
		AcceptInfo.AcceptanceCode.ResultCode = "AcceptedDisaccord";
	КонецЕсли;
	
	ЗапросМетода = ККСНГ_APIКурьер.v2_DocumentAcceptTitle(ПараметрыАвторизации, Id, AcceptInfo);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
	
	Если ЗапросМетода.Успех Тогда
		Ответ.Результат = ЗапросМетода.Результат;
		Ответ.Успех = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает данные титула покупателя с сервера СФЕРА Курьер
//
// Параметры:
//	ДокументСсылка - Справочник.ККСНГ_ЭлектронныеДокументы
//	СертификатСсылка - Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура FileContent, см. https://confluence.esphere.ru/display/SBER/FileContent
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьТитулПокупателяДляДокумента(Знач ДокументСсылка, Знач СертификатСсылка, ПараметрыАвторизации, Знач СодержаниеОперации, ДанныеПодписанта) Экспорт
	
	Перем ПрофильЭДООрганизации, DocumentId, ИмяФайла, ВерсияФормата;
	
	ПрофильЭДООрганизации = ККСНГ_ОбъектыИБВызовСервера.ПолучитьПрофильЭДООрганизацииДокумента(ДокументСсылка);
	DocumentId = ДокументСсылка.Id;
	ИмяФайла = ДокументСсылка.Filename;
	ВерсияФормата = ДокументСсылка.FormatVersion;
	
	Возврат ПолучитьТитулПокупателяИзКурьера(DocumentId, ПрофильЭДООрганизации, СертификатСсылка, ПараметрыАвторизации, СодержаниеОперации, ИмяФайла, ДанныеПодписанта, ВерсияФормата);
	
КонецФункции

// Получает уведомления с сервера СФЕРА Курьер
//
// Параметры:
//  ДокументСсылка			 - 		 - Справочник.ККСНГ_ЭлектронныеДокументы
//  ТекстПричиныОтклонения	 - 		 - Строка
//  ПараметрыАвторизации	 - Структура - содержит:
//  * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//  * AuthToken         - Строка - авторизационный токен доступа к API,
//  * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//  MchdData				 - Структура - см.https://confluence.esphere.ru/display/SBER/MchdData
// 
// Возвращаемое значение:
//  Структура - FileContent, см. https://confluence.esphere.ru/display/SBER/FileContent
//  см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьУведомлениеОбУточненииДляДокумента(Знач ДокументСсылка, Знач ТекстПричиныОтклонения, ПараметрыАвторизации, MchdData = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ЗапросМетода = ККСНГ_APIКурьер.v1_TicketCreateClarification(ПараметрыАвторизации, ДокументСсылка.Id, ТекстПричиныОтклонения, MchdData);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
	
	Если ЗапросМетода.Успех Тогда
		
		Ответ.Результат = ЗапросМетода.Результат;
		Ответ.Успех = Истина;
		
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции

