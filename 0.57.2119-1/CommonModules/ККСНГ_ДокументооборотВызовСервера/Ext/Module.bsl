//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция КурьерSign(Знач ДокументСсылка, Знач ДополнительныеПараметры, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обработка команды КурьерSign");	
	Ответ.Успех = Ложь;
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Отсутствуют данные подписи", "CM-00001");
	КонецЕсли; 
	
	// Проверка корректности входящих параметров
	Если ЗначениеЗаполнено(ДокументСсылка) 
		И ТипЗнч(ДокументСсылка) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		
		DocumentId =  ДокументСсылка.Id;
		
		ЗапросМетода = ККСНГ_APIКурьер.v1_DocumentSign(ПараметрыАвторизации, DocumentId, ДополнительныеПараметры.Signature);	
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
		
		Ответ.Успех = ЗапросМетода.Успех;
		
		Если Ответ.Успех Тогда
			ПрофильЭДООрганизации = ККСНГ_ОбъектыИБВызовСервера.ПолучитьПрофильЭДООрганизацииПоКодуЭДО(ДокументСсылка.КодЭДОВладельца);
			МассивПараметр = Новый Массив;
			МассивПараметр.Добавить(ДокументСсылка); 
			ОбновитьЭлектронныеДокументыПоДаннымИзКурьера(МассивПараметр, ПрофильЭДООрганизации, ПараметрыАвторизации);
			
		КонецЕсли;
								
	КонецЕсли; 
		
	Возврат Ответ;
			
