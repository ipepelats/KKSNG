
#Область ПрограммныйИнтерфейс

#Область НастройкиОрганизации

// Есть ли хотя бы 1 профиль с контрагентом по организации
//
// Параметры:
//	ПрофильЭДООрганизации      - Справочник.ККСНГ_Организации
//
// Возвращаемое значение:
//  Булево
//
Функция НаличиеНастроенныхКонтрагентовЭДО(Знач ПрофильЭДООрганизации) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ККСНГ_Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
		|ГДЕ
		|	ККСНГ_Контрагенты.Владелец = &ПрофильЭДООрганизации
		|	И НЕ ККСНГ_Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЕстьКонтрагентыЭДО = ВыборкаДетальныеЗаписи.Следующий();
		
	Возврат ЕстьКонтрагентыЭДО;

КонецФункции

// Есть ли хотя бы 1 профиль организации ЭДО
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//  Булево
//
Функция НаличиеНастроенныхОрганизацийЭДО() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ККСНГ_Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
		|ГДЕ
		|	НЕ ККСНГ_Организации.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЕстьОрганизацииЭДО = ВыборкаДетальныеЗаписи.Следующий();
		
	Возврат ЕстьОрганизацииЭДО;

КонецФункции

#КонецОбласти

#Область Авторизация

// Возвращает способ авторизации организации ЭДО
//
// Параметры:
//	ПрофильЭДООрганизации      - Справочник.ККСНГ_Организации
//
// Возвращаемое значение:
//  Перечисление ККСНГ_СпособыАвторизацииКурьер
//
Функция СпособАвторизацииОрганизации(Знач ПрофильЭДООрганизации, Знач Пользователь = Неопределено) Экспорт
	
	СпособАвторизации = Неопределено;
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если ПрофильЭДООрганизации.МногопользовательскийРежим Тогда
		
		СтрокаПоиска = ПрофильЭДООрганизации.НастройкиДоступа.Найти(Пользователь, "Пользователь1С");
		Если СтрокаПоиска <> Неопределено Тогда
			СпособАвторизации = СтрокаПоиска.СпособАвторизации;
		КонецЕсли;

	Иначе
		СпособАвторизации = ПрофильЭДООрганизации.СпособАвторизации;
	КонецЕсли;
	
	Возврат СпособАвторизации;

КонецФункции

// Получает новый авторизационный токен по предоставленному ключу
// См. ККСНГ_APIКурьерСервер.LogonByApiKey
//
// Параметры:
//  Key - строка, ключ доступа к API
//
// Возвращаемое значение: 
//  Токен - строка, авторизационный токен
//
Функция ПолучитьАвторизационныйТокенПоКлючу(Знач Key) Экспорт
	
	// Запомним время вызова метода
	МеткаВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = ККСНГ_ДокументооборотПовтИсп.ПолучитьАвторизационныйТокенПоКлючу(Key);
	
	Если Не Ответ.Успех Тогда
		
		// Если внутренняя ошибка сервера или ошибка сети, сбросим кеш повторно используемых значений
		// То есть, не надо кешировать эту неудачную попытку авторизации
		Результат = Ответ.Результат;
		Если ТипЗнч(Результат) = Тип("Число") И Результат >= 500 Тогда
			ОбновитьПовторноИспользуемыеЗначения();
		КонецЕсли;
		
	Иначе
		
		// Очистим журнал, если он получен из кеша повторно использованных значений
		Если Ответ.Журнал.Количество() > 0 И  Ответ.Журнал[0].ДатаВМиллисекундах < МеткаВремени Тогда
			 Ответ.Журнал.Очистить();
		КонецЕсли;

	КонецЕсли;
	
	Возврат Ответ;

КонецФункции

// Получает новый авторизационный токен по коду участника ЭДО организации
// См. ККСНГ_APIКурьерСервер.LogonByApiKey
//
// Параметры:
//  КодУчастникаЭДО - строка, код участника ЭДО
//
// Возвращаемое значение: 
//  Токен - строка, авторизационный токен
//
Функция ПолучитьАвторизационныйТокенПоКодуЭДО(Знач КодУчастникаЭДО) Экспорт
	
	ПрофильЭДООрганизации = Справочники.ККСНГ_Организации.НайтиПоРеквизиту("КодУчастникаЭДО", КодУчастникаЭДО);
	Возврат ПолучитьАвторизационныйТокенПоПрофилюЭДООрганизации(ПрофильЭДООрганизации);
	
КонецФункции

// Получает новый авторизационный токен по настройке обмена для организации
// См. ККСНГ_APIКурьерСервер.LogonByApiKey
//
// Параметры:
//  ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации
//
// Возвращаемое значение: 
//  Токен - строка, авторизационный токен
//
Функция ПолучитьАвторизационныйТокенПоПрофилюЭДООрганизации(Знач ПрофильЭДООрганизации, Знач Пользователь = Неопределено) Экспорт
	
	КлючДоступаAPI = "";
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если ПрофильЭДООрганизации.МногопользовательскийРежим Тогда
		
		СтрокаПоиска = ПрофильЭДООрганизации.НастройкиДоступа.Найти(Пользователь, "Пользователь1С");
		Если СтрокаПоиска <> Неопределено Тогда
			КлючДоступаAPI = СтрокаПоиска.КлючДоступаAPI;
		КонецЕсли;

	Иначе
		КлючДоступаAPI = ПрофильЭДООрганизации.КлючДоступаAPI;
	КонецЕсли;	
	
	Возврат ПолучитьАвторизационныйТокенПоКлючу(КлючДоступаAPI);

КонецФункции

// Проверяет соответствие ИНН/КПП из организации профиля ЭДО 1С и результата запроса к API Курьер 
// См. ККСНГ_APIКурьер.v2_ClientSelf
//
// Параметры:
//  ПрофильЭДООрганизации  - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
// Возвращаемое значение: 
//  Ответ - Структура, см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(), 
Функция ПроверитьСоответствиеОрганизацииКурьеру(ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		
	РезультатВызова = ККСНГ_APIКурьер.v2_ClientSelf(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, РезультатВызова.Журнал, Ложь);
	
	Если НЕ РезультатВызова.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Company = РезультатВызова.Результат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ККСНГ_Организации.Организация.ИНН КАК ИНН,
	|	ККСНГ_Организации.Организация.КПП КАК КПП,
	|	ПРЕДСТАВЛЕНИЕ(ККСНГ_Организации.Организация) КАК Организация,
	|	ВЫБОР
	|		КОГДА ККСНГ_Организации.Организация.ИНН = &ИНН
	|				И ККСНГ_Организации.Организация.КПП = &КПП
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПроверкаУспешна
	|ИЗ
	|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|ГДЕ
	|	ККСНГ_Организации.Ссылка = &ПрофильЭДООрганизации";
	
	Запрос.УстановитьПараметр("ИНН", Company.INN);
	Запрос.УстановитьПараметр("КПП", Строка(Company.KPP));
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	ОрганизацияЮрЛицо = МодульККСНГ_ПМ_РаботаСМетаданными.ЭтоЮрЛицо(ПрофильЭДООрганизации);
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.ПроверкаУспешна Тогда
			Ответ.Успех = Истина;
		Иначе
			
			ШаблонИНН = "ИНН %1";
			ШаблонИНН_КПП = "ИНН / КПП %1 / %2"; 
			ТекстШаблона = "Выбранная организация - %1 (%2) не соответствует сертификату на устройстве - %3 (%4)." 
			+ Символы.ПС + "Перевыберите организацию или подключите соответствующий токен.";
			
			Если ОрганизацияЮрЛицо Тогда
				ИНН_КПП_Организации	= СтрШаблон(ШаблонИНН_КПП, Выборка.ИНН, Выборка.КПП); 
			Иначе
				ИНН_КПП_Организации	= СтрШаблон(ШаблонИНН, Выборка.ИНН);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Company.KPP) Тогда
				ИНН_КПП_Сертификата	= СтрШаблон(ШаблонИНН, Company.INN);
			Иначе	
				ИНН_КПП_Сертификата	= СтрШаблон(ШаблонИНН_КПП, Company.INN, Company.KPP);
			КонецЕсли;
			
			ТекстОшибки = СтрШаблон(ТекстШаблона, Выборка.Организация, ИНН_КПП_Организации, 
			Company.Name, ИНН_КПП_Сертификата);   
			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "GT-00001");	
			
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат Ответ;
	
КонецФункции

Функция ПараметрыАвторизацииОрганизацииПоApiKey(ОрганизацияЭДО, Пользователь) Экспорт 
	
	Перем Ответ, СпособАвторизации, ПараметрыАвторизации;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	СпособАвторизации = СпособАвторизацииОрганизации(ОрганизацияЭДО, Пользователь);
	
	Если СпособАвторизации = Неопределено Тогда
		ТекстОшибки = "Не удалось определить способ авторизации, перейдите к настройкам профиля организации";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "AU-00115", , ОрганизацияЭДО);
		Возврат Ответ;
	КонецЕсли;
	
	Если СпособАвторизации <> Перечисления.ККСНГ_СпособыАвторизацииКурьер.ApiKey Тогда
		Если ОрганизацияЭДО.МногопользовательскийРежим Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "У пользователя установлен способ авторизации не APIKey", "AU-00116", , Пользователь);
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "У организации установлен способ авторизации не APIKey", "AU-00117", , ОрганизацияЭДО);
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;
	
	ЗапросApiKey = ПолучитьАвторизационныйТокенПоПрофилюЭДООрганизации(ОрганизацияЭДО, Пользователь);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросApiKey.Журнал);
	
	Если Не ЗапросApiKey.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	ПараметрыАвторизации = Новый Структура;
	ПараметрыАвторизации.Вставить("СпособАвторизации", СпособАвторизации);
	ПараметрыАвторизации.Вставить("AuthToken", ЗапросApiKey.Результат);
	
	Ответ.Результат = ПараметрыАвторизации;
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ДанныеСертификатовКурьера

// Возвращает сертификат
//
// Параметры:
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//  Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования если есть в ИБ
//  либо структура Certificate, см. https://confluence.esphere.ru/display/SBER/Certificate
//
Функция ПолучитьСертификатКлючаЭП(ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ЗапросАктивногоСертификата = ПолучитьДанныеАктивногоСертификата(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросАктивногоСертификата.Журнал, Ложь);
	
	Если ЗапросАктивногоСертификата.Успех Тогда
		
		ДанныеАктивногоСертификата = ЗапросАктивногоСертификата.Результат;
		ТипhexBinary    = ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "hexBinary"); 	
		ДвоичныеДанныеОтпечатка = ФабрикаXDTO.Создать(ТипhexBinary, СтрЗаменить(ДанныеАктивногоСертификата.Thumbprint, " ", ""));
		ОтпечатокСертификата = Base64Строка(ДвоичныеДанныеОтпечатка.Значение);
		ИскомыйСертификатКлючаЭП = ККСНГ_ОбъектыИБВызовСервера.ПолучитьСертификатКлючаЭППоОтпечатку(ОтпечатокСертификата);
		Если ИскомыйСертификатКлючаЭП <> Неопределено Тогда
			Ответ.Результат = ИскомыйСертификатКлючаЭП;
			Ответ.Успех = Истина;
		Иначе 
			
			Ответ.Результат = ДанныеАктивногоСертификата;
			// Добавляем ошибку со своим кодом, по которому сможем найти ошибку в журнале.
			ОписаниеОшибки = "Отсутствует сертификат, соответствующий пользователю сервиса.";
			ОбрабатываемыеОшибки = ККСНГ_ЭлектроннаяПодписьКлиентСервер.ОшибкиСертификатаКлючаЭП();
			КодОшибки = ОбрабатываемыеОшибки["НеНайденСертификатЭП"];
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, КодОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает данные активного зарегистрированного сертификата авторизованного пользователя.
// См. ККСНГ_APIКурьер.v1_DictionaryUserCertificate
//
// Параметры:
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение: 
//	структура Certificate, см. https://confluence.esphere.ru/display/SBER/Certificate
//
Функция ПолучитьДанныеАктивногоСертификата(ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	// Получим информацию об активном зарегистрированном сертификате пользователя.
	ЗапросАктивногоСертификата = ККСНГ_APIКурьер.v1_DictionaryUserCertificate(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросАктивногоСертификата.Журнал, Ложь);
	Ответ.Успех = ЗапросАктивногоСертификата.Успех;
	ОбрабатываемыеОшибки = ККСНГ_ЭлектроннаяПодписьКлиентСервер.ОшибкиСертификатаКлючаЭП();
	
	Если ЗапросАктивногоСертификата.Успех Тогда
		
		ДанныеАктивногоСертификата = ЗапросАктивногоСертификата.Результат;
		Если КонецДня(ДанныеАктивногоСертификата.NotAfter) < ТекущаяДатаСеанса() Тогда
			ОписаниеОшибки = "Активный сертификат пользователя просрочен.";
			КодОшибки = ОбрабатываемыеОшибки["АктивныйСертификатПросрочен"];
		ИначеЕсли НачалоДня(ДанныеАктивногоСертификата.NotBefore) > ТекущаяДатаСеанса() Тогда
		    ОписаниеОшибки = "Срок действия активного сертификата пользователя ещё не наступил.";
			КодОшибки = ОбрабатываемыеОшибки["АктивныйСертификатПокаНеДействует"];
		Иначе 
			ОписаниеОшибки = "";
			КодОшибки = "";
		КонецЕсли;
		Если Не ПустаяСтрока(КодОшибки) Тогда
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, КодОшибки);
			Ответ.Успех = Ложь;
		КонецЕсли;
		
		Ответ.Результат = ДанныеАктивногоСертификата;
		
	Иначе
		// Добавляем ошибку со своим кодом, по которому сможем найти ошибку в журнале.
		Если (ЗапросАктивногоСертификата.Результат = 400) Тогда
			ОписаниеОшибки = "У пользователя нет активных сертификатов.";
			КодОшибки = ОбрабатываемыеОшибки["НетАктивногоСертификата"];
		Иначе
			ОписаниеОшибки = "Не удалось получить информацию о сертификате пользователя. " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Ответ.Журнал);
			КодОшибки = ОбрабатываемыеОшибки["ОшибкаЗапросаАктивногоСертификата"];
		КонецЕсли;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, КодОшибки);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

