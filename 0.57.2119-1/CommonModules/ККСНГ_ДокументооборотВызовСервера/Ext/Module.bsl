Функция КодыСтатусовВРоуминге() Экспорт
	
	СтатусыВРоуминге = Новый Структура;
	СтатусыВРоуминге.Вставить("None", 0);
	СтатусыВРоуминге.Вставить("SendingInProgress", 1);
	СтатусыВРоуминге.Вставить("ErrorOfSending", 2);
	СтатусыВРоуминге.Вставить("InProcessingByReceiver", 3);
	СтатусыВРоуминге.Вставить("ErrorOfReceiver", 4);
	СтатусыВРоуминге.Вставить("UnknownParentDocument", 5);
	СтатусыВРоуминге.Вставить("Delivered", 6);
		
	Возврат СтатусыВРоуминге;
	
