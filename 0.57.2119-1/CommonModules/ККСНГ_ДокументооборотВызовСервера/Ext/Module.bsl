//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ВыполнитьКомандуКурьер(Знач ИмяКоманды, Знач ДокументСсылка, Знач ДополнительныеПараметры, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Вызов обработки команды сервиса ЭДО " + ИмяКоманды);
		 
	Попытка
		РезультатВызоваКоманды = Неопределено;
		Выполнить "РезультатВызоваКоманды = " + ИмяКоманды + "(ДокументСсылка, ДополнительныеПараметры, ПараметрыАвторизации);";
				
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, РезультатВызоваКоманды.Журнал, Ложь);
		Ответ.Успех = РезультатВызоваКоманды.Успех;
		
	Исключение
		Ошибка = ОписаниеОшибки();
		Ответ.Результат = Ошибка;
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, Ошибка, "CC-00001");
		
