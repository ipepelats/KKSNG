// Получает статус ЦРПТ ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	Id - Id документа в СФЕРА Курьер
//	ПрофильЭДООрганизации - СправочникСсылка.ККСНГ_Организации
//
// Возвращаемое значение:
//	Число - статус обработки документа из ЦРПТ
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция СтатусЦРПТДокумента(Id, ПараметрыАвторизации) Экспорт
	
	Перем Ответ;
	Перем ЗапросAPI, ДанныеВнешнихСервисов, ДанныеОтЦРПТ;
	Перем Чтение, ServiceCode, ДанныеЦРПТ, СтатусИзЦРПТ, ТекДанные, ТекстОшибки;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Вставить("ДанныеПоОшибкеОтЦРПТ", Неопределено);
	
	// Получаем статус ЦРПТ документа.
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение статуса ЦРПТ документа");
	ЗапросAPI = ККСНГ_APIКурьер.v2_DocumentExternalServices(ПараметрыАвторизации, Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если Не ЗапросAPI.Успех Тогда
		Возврат Ответ;
	КонецЕсли;
	
	ДанныеОтЦРПТ = Неопределено;
	
	ДанныеВнешнихСервисов = ЗапросAPI.Результат.ExternalServiceData;
	Для Каждого ТекДанные Из ДанныеВнешнихСервисов Цикл
		ServiceCode = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекДанные, "ServiceCode");
		Если СтрСравнить(ServiceCode, "CZ") <> 0 И СтрСравнить(ServiceCode, "CZ.FIX") <> 0 Тогда
			Продолжить;
		КонецЕсли;
		ДанныеОтЦРПТ = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекДанные, "Data");
		Если СтрСравнить(ServiceCode, "CZ") = 0 Тогда
			Прервать; // CZ - завершающий
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ДанныеОтЦРПТ) Тогда
		
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ДанныеОтЦРПТ);
			ДанныеЦРПТ = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ТекстОшибки = "Ошибка чтения данных ЦРПТ.";
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "MK-00005", ОписаниеОшибки);
		КонецПопытки;
		
		Если ТипЗнч(ДанныеЦРПТ) = Тип("Структура") Тогда
			
			СтатусИзЦРПТ = Неопределено;
			Если ДанныеЦРПТ.Свойство("status", СтатусИзЦРПТ) Тогда
				Ответ.Результат = СтатусИзЦРПТ;
				Ответ.ДанныеПоОшибкеОтЦРПТ = ККСНГ_ОтправкаЭДВызовСервера.ДанныеПоОшибкеПоМаркируемойПродукцииИзЦРПТ(ДанныеЦРПТ);
				Ответ.Успех = Истина;
			Иначе
				ТекстОшибки = "В данных ЦРПТ нет статуса обработки документа.";
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "MK-00006");
			КонецЕсли;
			
		Иначе
			ТекстОшибки = "Ошибка чтения данных ЦРПТ.";
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ТекстОшибки, "MK-00007");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// ДанныеМаркировки
#КонецОбласти

#Область Подписка

// Получает идентификатор новой или существующей подписки по предоставленному токену
// См. ККСНГ_APIКурьер.v2_SubscriptionGetSubscriptions
// См. ККСНГ_APIКурьер.v2_SubscriptionAdd
//
// Параметры:
//  ИдентификаторПодписки - строка, идентификатор подписки, хранимый на данный момент в базе.
//  AuthToken - строка, авторизационный токен
//
// Возвращаемое значение: 
//	Структура Ответ, см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(),
//	в случае успешного выполнения содержащая подтвержденнный переданный идентифкатор или новый.
//
Функция ПолучитьИдентификаторПодписки(ИдентификаторПодписки, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		
	Если ККСНГ_ОбщегоНазначенияВызовСервера.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, 
				"Установлена блокировка работы с внешними ресурсами", "SB-00013");
		
		Возврат Ответ;
		
	КонецЕсли;
	
	// Получим список действующих подписок
	ЗапросСпискаПодписок = ККСНГ_APIКурьер.v2_SubscriptionGetSubscriptions(ПараметрыАвторизации);
	Если Не ЗапросСпискаПодписок.Успех Тогда
		
		// Не удалось получить список действующих подписок
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросСпискаПодписок.Журнал, Ложь);
		ОписаниеОшибки = "Не удалось получить список подписок: " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Ответ.Журнал);
		// Добавляем ошибку со своим кодом, по которому сможем найти ошибку подписки в журнале.
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "SC-00001");
		
		Ответ.Результат = ЗапросСпискаПодписок.Результат;
		Возврат Ответ;
		
	КонецЕсли;
	
	СписокДействующихПодписок = ЗапросСпискаПодписок.Результат.Subscription;
	
	// Проверим, что указанная подписка ещё действует
	Если Не ПустаяСтрока(ИдентификаторПодписки) Тогда
		Для Каждого Подписка Из СписокДействующихПодписок Цикл
			Если ИдентификаторПодписки = Подписка.token Тогда
				
				// Вернем указанную подписку как действующую
				Ответ.Успех = Истина;
				Ответ.Результат = ИдентификаторПодписки;
				Возврат Ответ;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Пробуем создать новую подписку, сейчас лимит подписок в Курьере = 5
	ЗапросНовойПодписки = ККСНГ_APIКурьер.v2_SubscriptionAdd(ПараметрыАвторизации, Ложь);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросНовойПодписки.Журнал, Ложь);
	
	Если ЗапросНовойПодписки.Успех Тогда
		
		Ответ.Успех = Истина;
		Ответ.Результат = ЗапросНовойПодписки.Результат.token;
		Возврат Ответ;
		
	Иначе
		
		Ответ.Результат = ЗапросНовойПодписки.Результат;
		
		ОписаниеОшибки = "Не удалось создать подписку: " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Ответ.Журнал);
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "SC-00001");
		
	КонецЕсли;
			
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ЭлектронныеДокументы

#Область НеструктурированныеЭлектронныеДокументы

// Получает список возможных типов для неструктурированных документов
//
// Параметры:
//	ПараметрыАвторизации   - Структура - содержит:
//     * СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//     * AuthToken         - Строка - авторизационный токен доступа к API,
//     * КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при 
//									  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
// Возвращаемое значение:
//	СписокЗначений
//
Функция СписокДоступныхНеструктурированныхТиповДокументов(ПараметрыАвторизации) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();

	СписокДоступныхТипов = Новый СписокЗначений;

	СтруктурированныеТипы = Новый Массив;
	СтруктурированныеТипы.Добавить("ACTFNS");
	СтруктурированныеТипы.Добавить("INFSOOB");
	СтруктурированныеТипы.Добавить("CSF");
	СтруктурированныеТипы.Добавить("BILL");
	СтруктурированныеТипы.Добавить("SF");
	СтруктурированныеТипы.Добавить("WAYBILL");
	СтруктурированныеТипы.Добавить("UO_DPINFSOOB");
	СтруктурированныеТипы.Добавить("UPD_DOP");
	СтруктурированныеТипы.Добавить("UPD_SF");
	СтруктурированныеТипы.Добавить("UPD_SF_DOP");
	СтруктурированныеТипы.Добавить("UCD_CSF");
	СтруктурированныеТипы.Добавить("UCD_CSF_DIC");
	СтруктурированныеТипы.Добавить("UCD_DIC");
	СтруктурированныеТипы.Добавить("TOVTORG");
	СтруктурированныеТипы.Добавить("REZRU");
	СтруктурированныеТипы.Добавить("WAYBILL_TORG12");

	ЗапросТипов = ККСНГ_APIКурьер.v2_TypeDocument(ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросТипов.Журнал, Ложь);

	Если ЗапросТипов.Успех Тогда
		МассивТипов = ЗапросТипов.Результат.DocumentType;

		Если ТипЗнч(МассивТипов) = Тип("Массив") Тогда
			Для Каждого ТипИзКурьера Из МассивТипов Цикл
				Если СтруктурированныеТипы.Найти(ТипИзКурьера.DocumentTypeCode) = Неопределено Тогда // Неструктурированный
					СписокДоступныхТипов.Добавить(ТипИзКурьера.DocumentTypeCode, ТипИзКурьера.Name);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если СписокДоступныхТипов.Количество() > 0 Тогда
			Ответ.Успех = Истина;
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Невозможно получить список документов для отправки.", "DC-00001");
		КонецЕсли;

	КонецЕсли;

	Ответ.Результат = СписокДоступныхТипов;

	Возврат Ответ;

КонецФункции

// НеструктурированныеЭлектронныеДокументы
#КонецОбласти 

// Получает данные ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	Id - Id документа в СФЕРА Курьер
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура Document, см. https://confluence.esphere.ru/display/SBER/Document
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьЭлектронныйДокументСВложениемИзКурьера(Id, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных документа");
	
	ЗапросAPI = ККСНГ_APIКурьер.v1_DocumentDetails(ПараметрыАвторизации, Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		
		СтруктураДокумента = ЗапросAPI.Результат;
		
		// Получаем данные подписи ЭД
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных электронной подписи");
		ЗапросДанныеПодписи = ККСНГ_APIКурьер.v1_DocumentGetSignatures(ПараметрыАвторизации, СтруктураДокумента.id);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныеПодписи.Журнал, Ложь);
		
		Если ЗапросДанныеПодписи.Успех Тогда
						
			Отказ = Ложь;
			
			СписокПодписейЭД = ЗапросДанныеПодписи.Результат.DocumentSign;
			Для каждого СтруктураПодписиЭД Из СписокПодписейЭД Цикл
				
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных сертификата");
				
				ЗапросДанныеСертификата = ККСНГ_APIКурьер.v1_DocumentGetSignatureDetails(
														ПараметрыАвторизации, СтруктураПодписиЭД.Id);
														
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныеСертификата.Журнал, Ложь);
				
				Если ЗапросДанныеСертификата.Успех Тогда
					ДанныеСертификата = ЗапросДанныеСертификата.Результат;											
					СтруктураПодписиЭД.Вставить("SignatureDetails", ДанныеСертификата);
				Иначе
					Отказ = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не Отказ Тогда
				
				СтруктураДокумента.Вставить("DocumentSigns", СписокПодписейЭД);
				Ответ.Результат = ЗапросAPI.Результат;
				Ответ.Успех = Истина;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат Ответ;
	
КонецФункции

// Обновляет уже записанный ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	ЭлектроныйДокументСсылка - СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПрофильЭДООрганизации    - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации     - Структура - содержит:
//		* СпособАвторизации  - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken          - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена     - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	СправочникСсылка.ККСНГ_ЭлектронныеДокументы - ссылка на обновленный элемент справочника
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ОбновитьЭлектронныйДокументПоДаннымИзКурьера(ЭлектронныйДокументСсылка, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Если (ТипЗнч(ЭлектронныйДокументСсылка) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") И ЗначениеЗаполнено(ЭлектронныйДокументСсылка)) Тогда
		Возврат ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(ЭлектронныйДокументСсылка.Id, ПрофильЭДООрганизации, ПараметрыАвторизации);
	КонецЕсли;
	
	Возврат ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
КонецФункции

// Обновляет уже записанные ЭД с сервера СФЕРА Курьер включая квитанции
//
// Параметры:
//	ЭлектронныеДокументы    - Массив СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПрофильЭДООрганизации   - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	массив обновленных элементов СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//                                                                          	
Функция ОбновитьЭлектронныеДокументыПоДаннымИзКурьера(ЭлектронныеДокументы, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обновление данных электронных документов");
	Ответ.Результат = Новый Массив;
	
	Если ТипЗнч(ЭлектронныеДокументы) = Тип("Массив") Тогда
		
		Для каждого ЭлектронныйДокументСсылка Из ЭлектронныеДокументы Цикл
			
			Если ЗначениеЗаполнено(ПрофильЭДООрганизации) Тогда
				
				ЗапросДокумента = ОбновитьЭлектронныйДокументПоДаннымИзКурьера(ЭлектронныйДокументСсылка, ПрофильЭДООрганизации, ПараметрыАвторизации);
				ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДокумента.Журнал, Ложь);
				
				Если ЗапросДокумента.Успех Тогда
					
					Ответ.Результат.Добавить(ЭлектронныйДокументСсылка);
					
					ЗапросКвитанций = ОбновитьКвитанцииЭлектронногоДокументаПоДаннымИзКурьера(ЭлектронныйДокументСсылка, ПараметрыАвторизации);
					ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКвитанций.Журнал, Ложь);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции 

// Получает данные ЭД вместе с вложенным файлом с сервера СФЕРА Курьер и записывает в ИБ
//
// Параметры:
//	Id - Id документа в СФЕРА Курьер
//	ПрофильЭДООрганизации   - СправочникСсылка.ККСНГ_Организации
//	ПрофильЭДООрганизации   - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	СправочникСсылка.ККСНГ_ЭлектронныеДокументы - ссылка на созданный или обновленный элемент справочника
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ЗаписатьЭлектронныйДокументПоДаннымИзКурьера(Id, ПрофильЭДООрганизации, ПараметрыАвторизации, ФильтроватьВходящие = Ложь) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Обновление данных электронного документа");
	
	ЗапросДанных = ПолучитьЭлектронныйДокументСВложениемИзКурьера(Id, ПараметрыАвторизации);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанных.Журнал, Ложь);
	
	Если ЗапросДанных.Успех Тогда
		
		Если ФильтроватьВходящие И Не ПроверитьФильтрДляВходящегоДокумента(ЗапросДанных.Результат) Тогда
			Ответ.Результат = Неопределено;
			Ответ.Успех = Истина;
			Возврат Ответ;
		КонецЕсли;
		
		// TODO: Запись в транзакции 2019-05-30 Попов Д.В., Лашин И.И.: добавлена транзакция, но нужно подумать про + ЗаписатьПрисоединенныйФайл()
		ЗаписьЭД = ККСНГ_ОбъектыИБВызовСервера.ЗаписатьЭД(ЗапросДанных.Результат, ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьЭД.Журнал, Ложь);
		
		Если ЗаписьЭД.Успех Тогда
			
			ЭлектронныйДокументСсылка = ЗаписьЭД.Результат;			
			
			ЗаписьФайл = ККСНГ_ОбъектыИБВызовСервера.ЗаписатьПрисоединенныйФайл(ЗапросДанных.Результат.Content, 
																			ЭлектронныйДокументСсылка);			
																			
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьФайл.Журнал, Ложь);
			
			Ответ.Результат = ЭлектронныйДокументСсылка;
			Ответ.Успех = Истина;
			
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает историю обработки ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	Id                      - Id документа в СФЕРА Курьер
//	ПрофильЭДООрганизации   - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	СправочникСсылка.ККСНГ_ЭлектронныеДокументы - ссылка на обновленный элемент справочника
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьИсториюЭДИзКурьера(Id, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение истории документа");
	
	ЗапросAPI = ККСНГ_APIКурьер.v2_DocumentHistory(ПараметрыАвторизации, Id);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		
		Ответ.Результат = ЗапросAPI.Результат;
		Ответ.Успех = Истина;
		
	КонецЕсли;
			
	Возврат Ответ;
			
КонецФункции 

// Фильтр по принимаемым документам для Сбербанка
//
// Параметры:
//	МассивDocument - Массив - документы Справочник.ККСНГ_ЭлектронныеДокументы
//
Процедура ПрименитьФильтрДляМассиваДокументов(МассивDocument) Экспорт
	
	Инд = 0;
	Пока Инд <= МассивDocument.ВГраница() Цикл
		Если НЕ ПроверитьФильтрДляВходящегоДокумента(МассивDocument[Инд]) Тогда
			МассивDocument.Удалить(Инд);
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;
		
КонецПроцедуры

// Обработка отзыва документа по событию Курьера в объекте ЭД
//
// Параметры:
//	ЭлектронныйДокумент      - СправочникСсылка.ККСНГ_ЭлектронныеДокументы / СправочникСсылка.ККСНГ_Квитанции
//	ПрофильЭДООрганизации    - СправочникСсылка.ККСНГ_Организации
//	ПараметрыАвторизации     - Структура - содержит:
//		* СпособАвторизации  - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken          - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена     - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ОбработатьНештатныеСитуацииПоСобытиямДокумента(ЭлектронныйДокумент, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") 
		Или ТипЗнч(ЭлектронныйДокумент) = Тип("СправочникСсылка.ККСНГ_Квитанции") Тогда
		ИдДокумента = ЭлектронныйДокумент.Id;
	ИначеЕсли ТипЗнч(ЭлектронныйДокумент) = Тип("Число") Тогда
		ИдДокумента = ЭлектронныйДокумент;
	Иначе
		Возврат Ответ;
	КонецЕсли;
				
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение событий документа");
	СобытияПоДокументуЗапрос = ККСНГ_APIКурьер.v1_getDocumentEvents(ПараметрыАвторизации, ИдДокумента);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, СобытияПоДокументуЗапрос.Журнал, Ложь);
	
	Если СобытияПоДокументуЗапрос.Успех Тогда
		
		СобытияПоДокументу = СобытияПоДокументуЗапрос.Результат.DocumentEvent;
		
		Для Каждого Событие Из СобытияПоДокументу Цикл
			
			Если Событие.EventType = "Revoked" Тогда
				Ответ.Успех = Истина;
				Ответ.Результат = ККСНГ_ОбъектыИБВызовСервера.ОтразитьИзмененияВОбъектеЭД(ИдДокумента, 
																		ПрофильЭДООрганизации, Событие);
				
				ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, 
						"Документ был отозван отправителем. Действия с документом недоступны.", "CP-00001");
				
				Прервать;
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Получает детальную информацию по ЭД с сервера СФЕРА Курьер
//
// Параметры:
//	ИдентификаторЭД         - Идентификатор документа в СФЕРА Курьер
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
//
// Возвращаемое значение:
//	Структура Document, см. https://confluence.esphere.ru/display/SBER/Document
//	см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьДетальнуюИнформациюЭДИзКурьера(ИдентификаторЭД, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных документа");
	ЗапросAPI = ККСНГ_APIКурьер.v1_DocumentDetails(ПараметрыАвторизации, ИдентификаторЭД);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		
		Ответ.Результат = ЗапросAPI.Результат;
		Ответ.Успех = Истина;
				
	КонецЕсли;
			
	Возврат Ответ;
	
КонецФункции

// Возвращает реквизиты объектов ИБ
//
// Параметры:
//	ЭлектронныеДокументы   - Массив СправочникСсылка.ККСНГ_ЭлектронныеДокументы
//	ПоляДокумента          - Структура - реквизиты объекта ЭД
//
// Возвращаемое значение:
//  Массив	
//
Функция ПолучитьДанныеЭД(ЭлектронныеДокументы, ПоляДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	[ПОЛЯ]
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ЭлектронныеДокументы
	|ГДЕ
	|	ЭлектронныеДокументы.Ссылка В(&ЭлектронныеДокументы)";
	
	ПоляДокументаЗамена = Новый Массив;
	Для каждого ПолеДокумента Из ПоляДокумента Цикл
		ПоляДокументаЗамена.Добавить(ПолеДокумента.Ключ + " КАК " + ПолеДокумента.Значение);			
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ПОЛЯ]", СтрСоединить(ПоляДокументаЗамена, ","));
		
	Запрос.УстановитьПараметр("ЭлектронныеДокументы", ЭлектронныеДокументы);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных);
	
КонецФункции

#КонецОбласти 

