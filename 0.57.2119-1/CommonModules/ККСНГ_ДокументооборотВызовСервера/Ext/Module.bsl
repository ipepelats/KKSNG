// Возвращает представление статуса
//
// Параметры:
//	СтатусВРоуминге - Строка - статус
//
// Возвращаемое значение:
//	Строка - представление статуса
//
Функция ПредставлениеСтатусаВРоуминге(СтатусВРоуминге) Экспорт
	
	ПредставленияСтатусов = Новый Соответствие;
	ПредставленияСтатусов.Вставить("None", 					 "<статус отсутствует>");
	ПредставленияСтатусов.Вставить("SendingInProgress",		 "В процессе отправки");
	ПредставленияСтатусов.Вставить("ErrorOfSending", 		 "Ошибка отправки");
	ПредставленияСтатусов.Вставить("InProcessingByReceiver", "Обрабатывается оператором получателя");
	ПредставленияСтатусов.Вставить("ErrorOfReceiver",		 "Ошибка обработки получателем");
	ПредставленияСтатусов.Вставить("UnknownParentDocument",  "Неизвестный родительский документ");
	ПредставленияСтатусов.Вставить("Delivered", 			 "Доставлен");
	
	ПредставлениеСтатуса = ПредставленияСтатусов[СокрЛП(СтатусВРоуминге)];
	Если Не ЗначениеЗаполнено(ПредставлениеСтатуса) Тогда
		ПредставлениеСтатуса = "<статус не определён>";
	КонецЕсли;
	
	Возврат ПредставлениеСтатуса;
			
КонецФункции

