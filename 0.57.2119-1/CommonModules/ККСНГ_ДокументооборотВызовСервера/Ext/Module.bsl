//  см. ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета()
//
Функция ПолучитьУОУНаПредложениеОбАннулированииДляДокумента(Знач ДокументСсылка, Знач ТекстКомментария, ПараметрыАвторизации, MchdData = Неопределено) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	ЗапросМетода = ККСНГ_APIКурьер.v2_DocumentCreateAvoidanceRequestClarificationNotice(ПараметрыАвторизации, ДокументСсылка.Id, ТекстКомментария, MchdData);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросМетода.Журнал, Ложь);
	
	Если ЗапросМетода.Успех Тогда
		
		Ответ.Результат = ЗапросМетода.Результат;
		Ответ.Успех = Истина;
		
	КонецЕсли;

	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область ЭлектронныеПодписи

// Получает список ЭП документа из Курьера
//
// Параметры:
//  IdДокумента				 - Число	 - Идентификатор ЭД
//  ПрофильЭДООрганизации	 - СправочникСсылка.ККСНГ_Организации	 - ссылка на профиль ЭДО организации
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
// Возвращаемое значение:
//	Структура - поля структуры;
//			Успех - Булево - Результат выполнения операции
//			Результат - Структура, содержащая массив структур DocumentSign в одноименном поле
//			Журнал -
//
Функция ПолучитьСписокЭлектронныхПодписейДокументаИзКурьера(IdДокумента, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
	// Получаем данные подписи ЭД
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных электронной подписи");
	ЗапросДанныеПодписи = ККСНГ_APIКурьер.v1_DocumentGetSignatures(ПараметрыАвторизации, IdДокумента);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныеПодписи.Журнал, Ложь);
	
	Если ЗапросДанныеПодписи.Успех Тогда
		
		СоответствиеПодписиСертификаты = Новый Соответствие;
		Отказ = Ложь;
		
		СписокПодписейЭД = ЗапросДанныеПодписи.Результат.DocumentSign;
		Для каждого ПодписьЭД Из СписокПодписейЭД Цикл
			
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных сертификата");
			
			ЗапросДанныеСертификата = ККСНГ_APIКурьер.v1_DocumentGetSignatureDetails(
																ПараметрыАвторизации, ПодписьЭД.Id);
																
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросДанныеСертификата.Журнал, Ложь);
			
			Если ЗапросДанныеСертификата.Успех Тогда
				ДанныеСертификата = ЗапросДанныеСертификата.Результат;					
				СоответствиеПодписиСертификаты.Вставить(ПодписьЭД, ДанныеСертификата);
			Иначе
				Отказ = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не Отказ Тогда
			
			ЗаписьЭД = ККСНГ_ОбъектыИБВызовСервера.ДобавитьПодписиЭлектронногоДокумента(
							СоответствиеПодписиСертификаты, IdДокумента, ПрофильЭДООрганизации);
							
			ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗаписьЭД.Журнал, Ложь);
			
			Если ЗаписьЭД.Успех Тогда
				
				Ответ.Результат = ЗаписьЭД.Результат;
				Ответ.Успех = Истина;
				
			КонецЕсли; 
			
		КонецЕсли; 
					
	КонецЕсли;
		
	Возврат Ответ;
	
КонецФункции 

// Функция - Получить данные сертификата ключа электронной подписи из курьера
//
// Параметры:
//  IdПодписи				 - Число	 - Идентификатор ЭП
//  ПрофильЭДООрганизации	 - СправочникСсылка.ККСНГ_Организации	 - ссылка на профиль ЭДО организации
//	ПараметрыАвторизации    - Структура - содержит:
//		* СпособАвторизации - ПеречислениеСсылка.ККСНГ_СпособыАвторизацииКурьер
//		* AuthToken         - Строка - авторизационный токен доступа к API,
//		* КонтекстТокена    - Структура - см. ККСНГ_VPNKeyTLSКлиент.ИнициализироватьКонтекст используется при
//   							  СпособАвторизации = Перечисления.ККСНГ_СпособыАвторизацииКурьер.ТокенСбербанка
// Возвращаемое значение:
//	Структура - поля структуры; 
//			Успех - Булево - Результат выполнения операции
//			Результат - Структура SignatureDetails, см. https://confluence.esphere.ru/display/SBER/SignatureDetails
//			Журнал -
//
Функция ПолучитьДанныеСертификатаКлючаЭлектроннойПодписиИзКурьера(IdПодписи, ПрофильЭДООрганизации, ПараметрыАвторизации) Экспорт
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
		
	// Получаем данные сертификата
	ККСНГ_ЛогированиеКлиентСервер.ДобавитьИнформацию(Ответ.Журнал, "Получение данных сертификата");
	ЗапросAPI = ККСНГ_APIКурьер.v1_DocumentGetSignatureDetails(ПараметрыАвторизации, IdПодписи);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросAPI.Журнал, Ложь);
	
	Если ЗапросAPI.Успех Тогда
		Ответ.Результат = ЗапросAPI.Результат;
		Ответ.Успех = Истина;
	КонецЕсли;
		
	Возврат Ответ;
	
КонецФункции 

