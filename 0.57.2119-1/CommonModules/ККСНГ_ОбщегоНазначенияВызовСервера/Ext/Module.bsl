	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Организации.Ссылка КАК Организация
	               |ПОМЕСТИТЬ ВТ_ДоступныеОрганизации
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ККСНГ_Организации.Ссылка КАК ПрофильЭДО
	               |ИЗ
	               |	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДоступныеОрганизации КАК ВТ_ДоступныеОрганизации
	               |		ПО (ВТ_ДоступныеОрганизации.Организация = ККСНГ_Организации.Организация)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПрофильЭДО");
		
