// Возвращает структуру папок для работы с документами
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//	Соответствие
//
Функция ПапкиДокументов() Экспорт
	
	Папки = Новый Соответствие;
	Папки.Вставить("OnProcess", "На обработку");
	Папки.Вставить("Processed", "Обработанные");
	Папки.Вставить("In", "Входящие");
	Папки.Вставить("Out", "Исходящие");
	Папки.Вставить("Draft", "Черновики");
	Папки.Вставить("Favorites", "Избранное");
	Папки.Вставить("Trash", "Корзина");
	Папки.Вставить("NoRoute", "Документы без маршрутов");	
	
	Возврат Папки;
	
КонецФункции 

// Возвращает структуру папок для работы с документами кроме удаленных
