
#Область ПрограммныйИнтерфейс

// Сбрасывает размеры и положение окна формы
//
// Параметры:
//  Форма - УправляемаяФорма - форма, из обработчика события которой происходит вызов процедуры
//
Процедура СброситьРазмерыИПоложениеОкна(Форма) Экспорт

	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеСистемныхНастроек.Удалить(Форма.ИмяФормы, "", ИмяПользователя);
	КонецЕсли;

	Форма.КлючСохраненияПоложенияОкна = Строка(Новый УникальныйИдентификатор);

КонецПроцедуры

#Область ЭлектронныеПодписи

// Возвращает массив данных ЭП для объекта
//
// Параметры:
//	ОбъектЭДО                 - Справочник.ККСНГ_ЭлектронныеДокументы или ККСНГ_Квитанции
//	ТипТранспортногоДокумента - тип документа
//
// Возвращаемое значение:
//	Массив элементов см.ПолучитьСтруктуруОписанияЭлектроннойПодписи()
//
Функция ПолучитьМассивЭПОбъектаЭДО(ОбъектЭДО, ТипТранспортногоДокумента) Экспорт 
	
	ТипЗнчОбъекта = ТипЗнч(ОбъектЭДО);
	Если ТипЗнчОбъекта = Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы") Тогда
		МассивЭП = ПолучитьМассивЭПЭлектронногоДокумента(ОбъектЭДО, ТипТранспортногоДокумента);
	ИначеЕсли ТипЗнчОбъекта = Тип("СправочникСсылка.ККСНГ_Квитанции") Тогда
		МассивЭП = ПолучитьМассивЭПКвитанции(ОбъектЭДО);
	Иначе
		МассивЭП = Новый Массив;	
	КонецЕсли;
	
	Возврат МассивЭП;
	
КонецФункции

// Возвращает массив данных ЭП для ЭД
//
// Параметры:
//	ЭлектронныйДокумент       - Справочник.ККСНГ_ЭлектронныеДокументы
//	ТипТранспортногоДокумента - тип документа
//
// Возвращаемое значение:
//	Массив элементов см.ПолучитьСтруктуруОписанияЭлектроннойПодписи()
//
Функция ПолучитьМассивЭПЭлектронногоДокумента(ЭлектронныйДокумент, ТипТранспортногоДокумента) Экспорт
	
	// если основной документ и требуются подписи двух сторон
	Если ТребуютсяПодписиДвухСторон(ТипТранспортногоДокумента) Тогда
		МассивЭП = ПолучитьЭлектронныеПодписиПродавцаПокупателя(ЭлектронныйДокумент);
	Иначе		
		МассивЭП = ПолучитьЭлектронныеПодписиДокумента(ЭлектронныйДокумент);
	КонецЕсли;
	
	Возврат МассивЭП;
	
КонецФункции

// Возвращает массив данных ЭП для квитанции
//
// Параметры:
//	Квитанция       - Справочник.ККСНГ_Квитанции
//
// Возвращаемое значение:
//	Массив элементов см.ПолучитьСтруктуруОписанияЭлектроннойПодписи()
//
Функция ПолучитьМассивЭПКвитанции(Квитанция) Экспорт
	
	// проверить возможность работы с менеджером криптографии
	ДоступенМенеджерКриптографии = ДоступенМенеджерКриптографииНаСервере();
	
	МассивЭП = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_КвитанцииПодписи.ДатаПодписи КАК ДатаПодписи,
	|	ККСНГ_КвитанцииПодписи.Content КАК Подпись	
	|ИЗ
	|	Справочник.ККСНГ_Квитанции.Подписи КАК ККСНГ_КвитанцииПодписи
	|ГДЕ
	|	ККСНГ_КвитанцииПодписи.Ссылка = &Квитанция";
	Запрос.УстановитьПараметр("Квитанция", Квитанция);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураЭП = ЗаполнитьСтруктуруОписанияЭлектроннойПодписи(Выборка, ДоступенМенеджерКриптографии, Ложь);		
		МассивЭП.Добавить(СтруктураЭП);	
	КонецЦикла; 
	
	Возврат МассивЭП;	
	
КонецФункции

