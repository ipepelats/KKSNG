#Область ЭлектронныеПодписи

Функция ПолучитьЭлектронныеПодписиДокумента(ЭлектронныйДокумент)
	
	// проверить возможность работы с менеджером криптографии
	ДоступенМенеджерКриптографии = ДоступенМенеджерКриптографииНаСервере();
	
	МассивЭП = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Signed КАК ДатаПодписи,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Подписант КАК Подписант,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Organization КАК Организация,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Title КАК Должность,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Ссылка КАК Сертификат,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Код КАК Отпечаток,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Begin КАК НачалоДействия,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.End КАК КонецДействия,
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Image КАК Подпись
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы.DocumentSigns КАК ККСНГ_ЭлектронныеДокументыDocumentSigns
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_СертификатыКлючейЭлектроннойПодписи КАК ККСНГ_СертификатыКлючейЭлектроннойПодписи
	|		ПО ККСНГ_ЭлектронныеДокументыDocumentSigns.Сертификат = ККСНГ_СертификатыКлючейЭлектроннойПодписи.Ссылка
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Ссылка = &ЭлектронныйДокумент";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураЭП = ЗаполнитьСтруктуруОписанияЭлектроннойПодписи(Выборка, ДоступенМенеджерКриптографии, Истина);		
		МассивЭП.Добавить(СтруктураЭП);
	КонецЦикла;
	
	Возврат МассивЭП;
	
КонецФункции

Функция ПолучитьЭлектронныеПодписиПродавцаПокупателя(ЭлектронныйДокумент)
	
	// проверить возможность работы с менеджером криптографии
	ДоступенМенеджерКриптографии = ДоступенМенеджерКриптографииНаСервере();
	
	МассивЭП = Новый Массив;
	
	МассивТитулПокупателя = ККСНГ_ЭлектронныеДокументыВызовСервера.МассивТиповТранспортныхДокументовТитулПокупателя();
	
	// TODO получение данных подписи из квитанции
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Signed КАК ДатаПодписи,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Подписант КАК Подписант,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Organization КАК Организация,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Title КАК Должность,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Ссылка КАК Сертификат,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Код КАК Отпечаток,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.Begin КАК НачалоДействия,
	|	ККСНГ_СертификатыКлючейЭлектроннойПодписи.End КАК КонецДействия,
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Image КАК Подпись,
	|	Истина КАК ЭтоЭД
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы.DocumentSigns КАК ККСНГ_ЭлектронныеДокументыDocumentSigns
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ККСНГ_СертификатыКлючейЭлектроннойПодписи КАК ККСНГ_СертификатыКлючейЭлектроннойПодписи
	|		ПО ККСНГ_ЭлектронныеДокументыDocumentSigns.Сертификат = ККСНГ_СертификатыКлючейЭлектроннойПодписи.Ссылка
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументыDocumentSigns.Ссылка = &ЭлектронныйДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ККСНГ_КвитанцииПодписи.ДатаПодписи,
	|	"""",
	|	"""",
	|	"""",
	|	NULL,
	|	"""",
	|	NULL,
	|	NULL,
	|	ККСНГ_КвитанцииПодписи.Content,
	|	Ложь
	|ИЗ
	|	Справочник.ККСНГ_Квитанции.Подписи КАК ККСНГ_КвитанцииПодписи
	|ГДЕ
	|	ККСНГ_КвитанцииПодписи.Ссылка.Владелец = &ЭлектронныйДокумент
	|	И ККСНГ_КвитанцииПодписи.Ссылка.Type В(&ТитулПокупателя)";
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	Запрос.УстановитьПараметр("ТитулПокупателя", МассивТитулПокупателя);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураЭП = ЗаполнитьСтруктуруОписанияЭлектроннойПодписи(Выборка, ДоступенМенеджерКриптографии, Выборка.ЭтоЭД);		
		МассивЭП.Добавить(СтруктураЭП); 
	КонецЦикла;
	
	Возврат МассивЭП;
	
КонецФункции

// Служебная
Функция ЗаполнитьСтруктуруОписанияЭлектроннойПодписи(Выборка, ДоступенМенджереКриптографии, ДанныеПодписиЭД)
	
	СтруктураЭП = ПолучитьСтруктуруОписанияЭлектроннойПодписи();
	СтруктураЭП.ПрочитанСертификат = Ложь;
	ЗаполнитьЗначенияСвойств(СтруктураЭП, Выборка);
	Если ДанныеПодписиЭД Тогда
		СтруктураЭП.КомуВыданСертификат = Выборка.Подписант + ?(ЗначениеЗаполнено(Выборка.Организация), ", " + Выборка.Организация, "")
															+ ?(ЗначениеЗаполнено(Выборка.Должность), ", " + Выборка.Должность, "");
		// "С ... по ... " с форматной строкой "ДФ=dd.MM.yyyy";														
		СтруктураЭП.СрокДействия = ККСНГ_ЭлектроннаяПодписьКлиентСервер.СрокДействияСертификатаСтрокой(Выборка.НачалоДействия, Выборка.КонецДействия);
	КонецЕсли;
	
	ДвоичныеДанныеПодписи = Выборка.Подпись.Получить();
	СтруктураЭП.Подпись = ДвоичныеДанныеПодписи;
	
	Если ДоступенМенджереКриптографии Тогда
		ДанныеПодписи = ККСНГ_ОбщегоНазначенияВызовСервера.ПрочитатьДанныеПодписиНаСервере(ДвоичныеДанныеПодписи);
	КонецЕсли;
	
	Если ДанныеПодписи <> Неопределено Тогда
		Если ДанныеПодписиЭД Тогда
			СтруктураЭП.ИздательСертификата = ДанныеПодписи.ИздательСертификата;					
		Иначе
			ЗаполнитьЗначенияСвойств(СтруктураЭП, ДанныеПодписи);
		КонецЕсли;	
		СтруктураЭП.ПрочитанСертификат = Истина;
		СтруктураЭП.Подпись = Неопределено;		
	КонецЕсли;
	
	Возврат СтруктураЭП;
	
КонецФункции

// Служебная
Функция ПолучитьСтруктуруОписанияЭлектроннойПодписи()
	
	Возврат Новый Структура("ДатаПодписи, КомуВыданСертификат, Сертификат, Отпечаток, СрокДействия, ИздательСертификата, Подпись, ПрочитанСертификат");	
	
