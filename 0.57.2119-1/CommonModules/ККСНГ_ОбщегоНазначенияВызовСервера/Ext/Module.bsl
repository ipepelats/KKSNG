	Папки = ПапкиДокументов();
	Папки.Удалить("Trash");
	Возврат Папки;
	
КонецФункции 

// Возвращает коды типов для структурированных документов
//
// Параметры:
//	нет
//
// Возвращаемое значение:
//	Массив
//
Функция ПолучитьКодыСтруктурированныхДокументов() Экспорт
	
	МассивКодов = Новый Массив;
	МассивКодов.Добавить("ACTFNS");
	МассивКодов.Добавить("INFSOOB");
	МассивКодов.Добавить("CSF");
	МассивКодов.Добавить("BILL");
	МассивКодов.Добавить("SF");
	МассивКодов.Добавить("WAYBILL");
	МассивКодов.Добавить("UO_DPINFSOOB");
	МассивКодов.Добавить("UPD_DOP");
	МассивКодов.Добавить("UPD_SF");
	МассивКодов.Добавить("UPD_SF_DOP");
	МассивКодов.Добавить("UCD_CSF");
	МассивКодов.Добавить("UCD_CSF_DIC");
	МассивКодов.Добавить("UCD_DIC");	
	МассивКодов.Добавить("TOVTORG");
	МассивКодов.Добавить("REZRU");
	МассивКодов.Добавить("UVHD_BILL");
	
	Возврат МассивКодов;
	
КонецФункции 

// Формирует массив вариантов обмена документами ДОП
//
// Параметры:
//  нет 
//
// Возвращаемое значение: 
//  Массив, тип элемента строка
//
Функция ВариантыНастройкиОбменаДОП() Экспорт
	
	Перем МассивВариантов, ИменаВариантовНастройки, ИмяВариантаНастройки;
	
	МассивВариантов = Новый Массив;
	
	ИменаВариантовНастройки  = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВариантыФорматовЭлектронныхДокументов();
	Для каждого ИмяВариантаНастройки Из ИменаВариантовНастройки Цикл
		Если СтрНайти(ИмяВариантаНастройки, "для каждого документа") > 0 Тогда
			МассивВариантов.Добавить(ИмяВариантаНастройки);
		КонецЕсли;
	КонецЦикла;
	
	// Дополним вариантами, реально настроенными по организацияи и контрагентам
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.ВариантНастройкиОбмена КАК ВариантНастройкиОбмена
	|ИЗ
	|	(ВЫБРАТЬ
	|		ККСНГ_Организации.ВариантНастройкиОбмена КАК ВариантНастройкиОбмена
	|	ИЗ
	|		Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ККСНГ_Контрагенты.ВариантНастройкиОбмена
	|	ИЗ
	|		Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.ВариантНастройкиОбмена ПОДОБНО ""%для каждого документа%""";
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивВариантов.Добавить(Выборка.ВариантНастройкиОбмена);
	КонецЦикла;
	
	Возврат МассивВариантов;
	
КонецФункции

// Проверяет необходимость подписи2х сторон по коду титула
//
// Параметры:
//	КодТипаДокумента - Строка
//
// Возвращаемое значение:
//	Булево
//
Функция ТребуютсяПодписиДвухСторон(КодТипаДокумента) Экспорт
	
	Возврат КодТипаДокумента = "UpdSellerInfo"
		Или КодТипаДокумента = "UpdInvoiceSellerInfo"
		Или КодТипаДокумента = "Torg12SellerTitle"
		Или КодТипаДокумента = "UpdCorrectionSellerInfo"
		Или КодТипаДокумента = "UpdCorrectionInvoiceSellerInfo";		
	
КонецФункции

// Выводит информацию о статусе обработки при длительных операциях
//
// Параметры:
//  Информация     - Строка - Информация о текущей операции
//  КоличествоВсего	  - Число
//  Счетчик	          - Число
// 
Процедура СообщитьПрогрессЗагрузкиДокументов(КоличествоВсего, Счетчик, Информация) Экспорт
	
	ПроцентВыполнения = Цел((Счетчик) * 100 / КоличествоВсего);
	ДлительныеОперации.СообщитьПрогресс(ПроцентВыполнения, Информация, Счетчик);
	
КонецПроцедуры

