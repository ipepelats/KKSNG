// Проверяет доступность профиля для пользователя
//
// Параметры:
//	ПрофильЭДО - Справочник.ККСНГ_Организации
//
// Возвращаемое значение:
//	Булево
//
Функция ПрофильЭДОДоступенПользователю(ПрофильЭДО) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ККСНГ_Организации.Организация.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	               |ГДЕ
	               |	ККСНГ_Организации.Ссылка = &Ссылка
	               |	И НЕ ККСНГ_Организации.Организация.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", ПрофильЭДО);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Проверяет доступность организации для пользователя
//
// Параметры:
//	Организация - Справочник.Организации
//
// Возвращаемое значение:
//	Булево
//
Функция ОрганизацияДоступнаПользователю(Организация) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Организации.Ссылка КАК Организация
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |ГДЕ
	               |	Организации.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Организация);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
