// Функция Получает реквизиты оранизации
//
// Параметры:
//  Организация - Справочник.ККСНГ_Организации
// 
// Возвращаемое значение: Структура
//   - 
//
Функция ПолучитьДанныеПоОрганизации(Организация) Экспорт
	
	Перем СтруктураДанныхОрганизации;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета("Получение данных по организациям");
	
	РеквизитыОрганизаций = Метаданные.Справочники.Организации.Реквизиты;
	
	Если РеквизитыОрганизаций.Найти("РегистрацияВНалоговомОргане") <> Неопределено Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.Наименование КАК Наименование,
		|	Организации.ИНН КАК ИНН,
		|	Организации.ОГРН КАК ОГРН,
		|	ВЫБОР
		|		КОГДА Организации.РегистрацияВНалоговомОргане.КПП ЕСТЬ NULL
		|			ТОГДА ЕСТЬNULL(Организации.КПП, НЕОПРЕДЕЛЕНО)
		|		ИНАЧЕ ЕСТЬNULL(Организации.РегистрацияВНалоговомОргане.КПП, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК КПП
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация";
		
	ИначеЕсли РеквизитыОрганизаций.Найти("КПП") <> Неопределено Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка,
		|	Организации.Наименование КАК Наименование,
		|	Организации.ИНН КАК ИНН,
		|	Организации.ОГРН КАК ОГРН,
		|	Организации.КПП КАК КПП
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация";
		
	Иначе
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаРезультата = РезультатЗапроса.Выбрать();
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, "Ошибка получение данных организации", "CFG-00011", ОписаниеОшибки);
		
		Возврат Ответ;
	КонецПопытки;
	
	Пока ВыборкаРезультата.Следующий() Цикл
		СтруктураДанныхОрганизации = Новый Структура;
		
		Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтруктураДанныхОрганизации.Вставить(Колонка.Имя, ВыборкаРезультата[Колонка.Имя]);
		КонецЦикла;
		
		Ответ.Результат = СтруктураДанныхОрганизации;
		
	КонецЦикла;
	
	Ответ.Успех = Истина;
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

// Проверяет доступность по коду типа ЭД
//
// Параметры:
//	КодТипаЭД - Строка
//
// Возвращаемое значение:
//	Булево
//
Функция ДоступнаВыгрузкаФНС(КодТипаЭД) Экспорт
	
	КодыТиповСВыгрузкойФНС = Новый Массив;
	КодыТиповСВыгрузкойФНС.Добавить("ACTFNS");
	КодыТиповСВыгрузкойФНС.Добавить("CSF");
	КодыТиповСВыгрузкойФНС.Добавить("SF");
	КодыТиповСВыгрузкойФНС.Добавить("WAYBILL");
	КодыТиповСВыгрузкойФНС.Добавить("UPD_DOP");
	КодыТиповСВыгрузкойФНС.Добавить("UPD_SF");
	КодыТиповСВыгрузкойФНС.Добавить("UPD_SF_DOP");
	КодыТиповСВыгрузкойФНС.Добавить("UCD_CSF");
	КодыТиповСВыгрузкойФНС.Добавить("UCD_CSF_DIC");
	КодыТиповСВыгрузкойФНС.Добавить("UCD_DIC");	
	КодыТиповСВыгрузкойФНС.Добавить("TOVTORG");
	КодыТиповСВыгрузкойФНС.Добавить("REZRU");
	
	Возврат КодыТиповСВыгрузкойФНС.Найти(КодТипаЭД) <> Неопределено;
		
КонецФункции // ДоступнаВыгрузкаФНС()

// Возвращает данные подписи
//
// Параметры:
//	Подпись - Содержимое контейнера с подписью
//
// Возвращаемое значение:
//  Неопределено или Структура:
// 		* КомуВыданСертификат - Строка
// 		* Отпечаток           - Строка
// 		* СрокДействия        - Строка
// 		* ИздательСертификата - Строка
Функция ПрочитатьДанныеПодписиНаСервере(Подпись) Экспорт
	
	Результат = Неопределено;
	
	МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("ПолучениеСертификатов", Ложь);	
	
	Если МенеджерКриптографии = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Сертификаты = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(Подпись);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если Сертификаты.Количество() > 0 Тогда
		Сертификат = Сертификаты[0];
		
		Результат = Новый Структура;
		Результат.Вставить("КомуВыданСертификат", ККСНГ_ЭлектроннаяПодписьКлиентСервер.ПредставлениеСубъекта(Сертификат));
		Результат.Вставить("Отпечаток", СтрЗаменить(Строка(Сертификат.Отпечаток), " ", ""));
		Результат.Вставить("СрокДействия", ККСНГ_ЭлектроннаяПодписьКлиентСервер.СрокДействияСертификатаСтрокой(Сертификат.ДатаНачала, Сертификат.ДатаОкончания));
		Результат.Вставить("ИздательСертификата", ККСНГ_ЭлектроннаяПодписьКлиентСервер.ПредставлениеИздателя(Сертификат));		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Кодирует строку в соответствии с выбранным способом кодирования.
//
// Параметры:
//	НекаяСтрока       - Строка
//	СпособКодирования - Строка
//
// Возвращаемое значение:
//	Строка
//
Функция ВыполнитьКодировкуСтроки(НекаяСтрока, СпособКодирования = "КодировкаURL") Экспорт
	
	Если СпособКодирования = "КодировкаURL" Тогда
		Возврат КодироватьСтроку(НекаяСтрока, СпособКодированияСтроки.КодировкаURL);
	Иначе
		Возврат КодироватьСтроку(НекаяСтрока, СпособКодированияСтроки.URLВКодировкеURL);
	КонецЕсли; 
	
КонецФункции // ВыполнитьКодировкуСтроки

// Возвращает ссылку на объект по его UID
//
// Параметры:
//	УникальныйИдентификаторСтрокой 	- Строка
//	ТипОбъектаМетаданных 			- Строка
//	ИмяОбъектаМетаданных 			- Строка
//
// Возвращаемое значение:
//	Ссылка на документ/справочник или Неопределено
//
Функция СсылкаПоСтрокеУникальногоИдентификатора(УникальныйИдентификаторСтрокой, ТипОбъектаМетаданных, ИмяОбъектаМетаданных) Экспорт 
	
	Перем ИскомаяСсылка, Менеджер, УникальныйИдентификаторСсылки;
	
	Если НРег(ТипОбъектаМетаданных) = "справочник" Тогда
		Если Метаданные.Справочники.Найти(ИмяОбъектаМетаданных) = Неопределено Тогда
			Возврат Неопределено; 
		Иначе
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник." + ИмяОбъектаМетаданных);
		КонецЕсли;
	ИначеЕсли НРег(ТипОбъектаМетаданных) = "документ" Тогда
		Если Метаданные.Документы.Найти(ИмяОбъектаМетаданных) = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ." + ИмяОбъектаМетаданных);
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(УникальныйИдентификаторСтрокой) Тогда
		УникальныйИдентификаторСсылки = Новый УникальныйИдентификатор(УникальныйИдентификаторСтрокой);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ИскомаяСсылка = Менеджер.ПолучитьСсылку(УникальныйИдентификаторСсылки);
	Если ОбщегоНазначения.СсылкаСуществует(ИскомаяСсылка) Тогда
		Возврат ИскомаяСсылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // СсылкаПоСтрокеУникальногоИдентификатора

// Выполняет пропорциональное распределение суммы
//
// Параметры:
//  РаспределяемаяСумма  - Число - сумма, которую надо распределить; 
//	Таблица              - Таблица значений
//	ИмяКолонки           - Наименование колонки для заполнения
//	ИмяКолонкиБазы       - Наименование колонки базы распределения
//
Процедура РаспределитьСуммуПоКолонкеТаблицы(РаспределяемаяСумма, Таблица, ИмяКолонки, ИмяКолонкиБазы = "") Экспорт

	Если РаспределяемаяСумма <> 0 Тогда
		Если ПустаяСтрока(ИмяКолонкиБазы) Тогда
			МассивСтарыхСумм = Таблица.ВыгрузитьКолонку(ИмяКолонки);
		Иначе
			МассивСтарыхСумм = Таблица.ВыгрузитьКолонку(ИмяКолонкиБазы);
		КонецЕсли;
		МассивНовыхСумм = ККСНГ_ОбщегоНазначенияКлиентСервер.РаспределитьПропорционально(РаспределяемаяСумма, МассивСтарыхСумм);
		Если МассивНовыхСумм <> Неопределено Тогда
	 		Таблица.ЗагрузитьКолонку(МассивНовыхСумм, ИмяКолонки);
		КонецЕсли; 
	Иначе
		Таблица.ЗаполнитьЗначения(0, ИмяКолонки);
	КонецЕсли;

КонецПроцедуры

// Дополняет таблицу значений-приемник данными из таблицы значений-источник.
// Если таблица значений-приемник = Неопределено, то инициализирует ее таблицей значений-источником.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений - таблица, из которой будут браться строки для заполнения;
//  ТаблицаПриемник - ТаблицаЗначений - таблица, в которую будут добавлены строки из таблицы-источника.
//  
Процедура ИнициализироватьДополнитьТаблицу(ТаблицаИсточник, ТаблицаПриемник) Экспорт
	
	Если ТаблицаПриемник = Неопределено Тогда
		ТаблицаПриемник = ТаблицаИсточник;
	Иначе
		ДополнитьТаблицу(ТаблицаИсточник, ТаблицаПриемник);
	КонецЕсли;		
		
КонецПроцедуры

// Дополняет таблицу значений-приемник данными из таблицы значений-источник.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений - таблица, из которой будут браться строки для заполнения;
//  ТаблицаПриемник - ТаблицаЗначений - таблица, в которую будут добавлены строки из таблицы-источника.
//  
Процедура ДополнитьТаблицу(ТаблицаИсточник, ТаблицаПриемник) Экспорт
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет наличие и возвращает значение реквизита объекта
//
// Параметры:
//  Объект          - Произвольный объект
//	ИмяРеквизита    - Наименование реквизита объекта , возможно обращение через "."
//
// Возвращаемое значение:
// Неопределено или значение реквизита
// 
Функция ЗначениеИмеющегосяРеквизитаОбъекта(Объект, РеквизитыСтрокой) Экспорт
	
	Результат = Новый Соответствие;
	
	НаборРеквизитов = СтрРазделить(РеквизитыСтрокой, ",");
	
	Для каждого ИмяРеквизита Из НаборРеквизитов Цикл
		
		ИмяРеквизита = СокрЛП(ИмяРеквизита);
		
		МассивРеквизитов = СтрРазделить(ИмяРеквизита, ".");
		УровеньВложенности =  МассивРеквизитов.Количество();
		
		Если УровеньВложенности = 0 ИЛИ УровеньВложенности > 2 Тогда
			Продолжить;
		ИначеЕсли УровеньВложенности = 2 Тогда
			
			ТекущийРезультат = ЗначениеИмеющегосяРеквизитаОбъекта(Объект[МассивРеквизитов[0]], МассивРеквизитов[1]);
			ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат, ТекущийРезультат);
			
		Иначе
			Если ЗначениеЗаполнено(Объект) И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) Тогда
				ЗначениеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита);
				Результат.Вставить(ИмяРеквизита, ЗначениеРеквизита);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Преобразует строку таблицы значений в структуру.
// Свойства структуры и их значения совпадают с колонками переданной строки.
//
// Параметры:
//  СтрокаТаблицыЗначений - СтрокаТаблицыЗначений - строка таблицы значений.
//
// Возвращаемое значение:
//  Структура - преобразованная строка таблицы значений.
//
Функция СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицыЗначений) Экспорт
	
	Структура = Новый Структура;
	Для каждого Колонка Из СтрокаТаблицыЗначений.Владелец().Колонки Цикл
		Структура.Вставить(Колонка.Имя, СтрокаТаблицыЗначений[Колонка.Имя]);
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

// Возвращает параметр сеанса РаботаСВнешнимиРесурсамиЗаблокирована
