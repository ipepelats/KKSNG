#Область ФоновыеЗадания 

// Добавляет фоновое задание в очередь на выполнение и возвращает идентификатор добавленного задания
//
// Параметры:
//   ИмяМетода - Строка - Полное имя экспортного метода неглобального общего модуля
//   ПараметрыВызова - Массив - Параметры обработчика
//   КлючЗадания - Строка - Ключ задания
//   Описание - Строка - Описание задания
//
// Возвращаемое значение:
//   ИдентификаторЗадания - Строка - Идентификатор фонового задания
//   
// Пример:
//   ПараметрыЗапроса = Новый Массив();
//	 ПараметрыЗапроса.Добавить(ДанныеФормированияЗапросовРазделов);
//	 ПараметрыЗапроса.Добавить(АдресХранилищаРезультата);
//
//   ВыполнитьФоновоеЗадание("ККСНГ_ЭлектронныеДокументы.ПолучитьЗначенияСчетчиковРазделов", ПараметрыЗапроса)
//
Функция ВыполнитьФоновоеЗадание(ИмяМетода, ПараметрыВызова = Неопределено, КлючЗадания = Неопределено, Описание = "") Экспорт
	
	Попытка
		ФоновоеЗадание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыВызова, КлючЗадания, Описание);
		ИдентификаторЗадания = ФоновоеЗадание.УникальныйИдентификатор;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ИдентификаторЗадания = Неопределено;
	КонецПопытки;
	
	Возврат ИдентификаторЗадания;
	
КонецФункции

// Проверяет состояние фонового задания по переданному идентификатору.
// Если фоновое задание не найдено, то оно считатется выполненным.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор, Строка - идентификатор фонового задания. 
//  ТекстОшибки       - Строка - описание ошибки при выполнении фз
//
// Возвращаемое значение:
//  Булево - состояние выполнения задания.
// 
Функция ЗаданиеВыполнено(idЗадания, ТекстОшибки = Неопределено) Экспорт

	ЗаданиеВыполнено = Истина;
	
	ФоновоеЗадание = НайтиЗаданиеПоИдентификатору(idЗадания);
	
	Если ФоновоеЗадание <> Неопределено Тогда
		
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ЗаданиеВыполнено = Ложь;
			ОписаниеОшибки = "";
		ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);
			ОписаниеОшибки = "Фоновое задание завершилось аварийно. " + ?(ЗначениеЗаполнено(ПредставлениеОшибки), ПредставлениеОшибки, "");
		ИначеЕсли ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			ОписаниеОшибки = "Фоновое задание отменено администратором.";
		Иначе
			ОписаниеОшибки = "";
		КонецЕсли;
	
		Если НЕ ТекстОшибки = Неопределено Тогда
			ТекстОшибки = ОписаниеОшибки;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ЗаданиеВыполнено;
	
КонецФункции

// Поиск фонового задания по переданному идентификатору.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор, Строка - идентификатор фонового задания. 
//
// Возвращаемое значение:
//  ФоновоеЗадание, Неопределено - Если задание для заданного идентификатора не найдено, возвращает Неопределено.
//
Функция НайтиЗаданиеПоИдентификатору(Знач ИдентификаторЗадания) Экспорт
	
	Если ТипЗнч(ИдентификаторЗадания) = Тип("Строка") Тогда
		ИдентификаторЗадания = Новый УникальныйИдентификатор(ИдентификаторЗадания);
	КонецЕсли;
		
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
КонецФункции

// Возвращает состояние ФЗ по id
//
// Параметры:
//	ИдентификаторЗадания       - id ФЗ
//	УдалятьСообщения           - Булево
//
// Возвращаемое значение:
//	Структура
//   * Завершено      - Булево 
//   * ОписаниеОшибки - Строка
//
Функция РезультатВыполненияФоновогоЗадания(ИдентификаторЗадания, УдалятьСообщения = Ложь) Экспорт
	
	РезультатВыполнения = Новый Структура("Завершено, ОписаниеОшибки", Истина);
	
	УстановитьПривилегированныйРежим(Истина);

	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторЗадания));	
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
	РезультатВыполнения.Завершено = ФоновоеЗадание.Состояние <> СостояниеФоновогоЗадания.Активно;
	Если РезультатВыполнения.Завершено Тогда
		ОшибкаЗадания = ФоновоеЗадание.ИнформацияОбОшибке;
		Если ОшибкаЗадания <> Неопределено Тогда
			РезультатВыполнения.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ОшибкаЗадания);
		КонецЕсли;
		Если УдалятьСообщения Тогда
			ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат РезультатВыполнения;

КонецФункции

// Возвращает состояние ФЗ по id
//
// Параметры:
//	ИдентификаторЗадания       - id ФЗ
//	ШаблонФорматирования       - Строка вида "; получателю; ; получателям; получателям; получателям", см. справку СтрокаСЧислом
//
// Возвращаемое значение:
//	Структура
//   * Процент       - Число   - процент выполнения фз
//   * Количество    - Число   - число обработанных пакетов фз
//   * Представление - Строка  - представление числа по произвольному шаблону, пример: "3 получателям"
//
Функция ИнфоОВыполненииФоновогоЗадания(ИдентификаторЗадания, ШаблонФорматирования) Экспорт

	ИнфоОВыполнении = ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторЗадания);
	
	Если НЕ ИнфоОВыполнении = Неопределено Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("Процент", ИнфоОВыполнении.Процент);
		Результат.Вставить("Количество", ИнфоОВыполнении.ДополнительныеПараметры);
		Результат.Вставить("Представление",  СтрокаСЧисломПоШаблону(ШаблонФорматирования, ИнфоОВыполнении.ДополнительныеПараметры));
		
		Возврат Результат;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Возвращает представление числа по произвольному шаблону, пример: "3 получателям"
//
// Параметры:
//	ШаблонФорматирования - Строка вида "; получателю; ; получателям; получателям; получателям", см. справку СтрокаСЧислом
//	Количество           - Число
//
// Возвращаемое значение:
//	Строка
//
Функция КоличествоСтрокой(ШаблонФорматирования, Количество) Экспорт

	Окончание = СтрокаСЧислом(ШаблонФорматирования, Количество, ВидЧисловогоЗначения.Количественное, "L=ru");
	
	Результат = "" + Количество + " " + Окончание;
	
	Возврат Результат;

КонецФункции

