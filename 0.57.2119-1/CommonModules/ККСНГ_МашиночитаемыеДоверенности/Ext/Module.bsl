Функция ПолучитьДанныеЮридическогоЛица(Данные)
	
	Перем Результат;
	
	Результат = СтруктураДанныхУчастника();
	Результат.Наименование =  ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "НаимОрг", "");
	Результат.ИНН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ИННЮЛ", "");
	Результат.КПП = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "КПП", "");
	Результат.ОГРН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ОГРН", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеИндивидуальногоПредпринимателя(Данные)
	
	Перем Результат, ФизическоеЛицо;
	
	Результат = СтруктураДанныхУчастника();
	
	Результат.Наименование = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "НаимИП", "");
	Если ПустаяСтрока(Результат.Наименование) Тогда
		ФизическоеЛицо = ПолучитьДанныеФизическогоЛица(Данные);
		Результат.Наименование = ФизическоеЛицо.Наименование;
	КонецЕсли;
	
	Результат.ИНН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ИННФЛ", "");
	Результат.ОГРН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ОГРНИП", "");
	Результат.СНИЛС = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "СНИЛС", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеФизическогоЛица(Данные)
	
	Перем Результат;
	Перем ФИОФизическогоЛица, Фамилия, Имя, Отчество;
	
	Результат = СтруктураДанныхУчастника();
	Результат.ИНН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ИННФЛ", "");
	Результат.СНИЛС = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "СНИЛС", "");
	Результат.ОГРН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ОГРНИП");
	
	ФИОФизическогоЛица = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ФИО");
	Если ФИОФизическогоЛица = Неопределено Тогда // Для формата 003 ФИО заполняем из сведений о физ.лице
		ФИОФизическогоЛица = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "СведФЛ.ФИО");
	КонецЕсли;
	
	Фамилия = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ФИОФизическогоЛица, "Фамилия");
	Имя = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ФИОФизическогоЛица, "Имя");
	Отчество = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ФИОФизическогоЛица, "Отчество");
	
	Результат.Наименование = ККСНГ_ОбщегоНазначенияКлиентСервер.СоединитьСтрокиСПробелом(Фамилия, Имя, Отчество);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеИностраннойОрганизации(Данные)
	
	Перем Результат;
	
	Результат = СтруктураДанныхУчастника();
	Результат.Наименование = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "НаимИО");
	Результат.ИНН = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "ИННЮЛ", "");
	Результат.КПП = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, "КПП", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПолномочия(Полномочия)
	
	Перем Результат;
	Перем Полномочие, НовоеПолномочие;
	
	Результат = Новый Массив;
	
	Если ТипЗнч(Полномочия) = Тип("Массив") Тогда
		
		Для каждого Полномочие Из Полномочия Цикл
			
			НовоеПолномочие = СтруктураПолномочий();
			
			НовоеПолномочие.Код = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочие, "КодПолн", "");
			НовоеПолномочие.Текст = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочие, "СодержПолн", "");
			
			Если ПустаяСтрока(НовоеПолномочие.Текст) Тогда
				НовоеПолномочие.Текст = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочие, "ТекстПолн", "");
			КонецЕсли;
			
			Результат.Добавить(НовоеПолномочие);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

