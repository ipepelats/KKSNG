КонецФункции

Функция ПолучитьСведенияПредставителя_001(Представители)
	
	Перем Результат;
	Перем СведенияОПредставителях, Представитель, ТипУчастника, Участник;
	Перем ЮридическоеЛицо, ИндивидуальныйПредприниматель, ФизическоеЛицо;
	
	Результат = Новый Массив;
	
	СведенияОПредставителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представители, "СвПред");
	ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представители, "ТипПред");
	
	Если ТипЗнч(СведенияОПредставителях) = Тип("Массив") Тогда
		
		Для каждого Представитель Из СведенияОПредставителях Цикл
			
			Если ТипУчастника = "ЮЛ" Тогда // Юридическое лицо
				
				ЮридическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представитель, "СвОрг");
				Участник = ПолучитьДанныеЮридическогоЛица(ЮридическоеЛицо);
				
			ИначеЕсли ТипУчастника = "ИП" Тогда // Индивидуальный предприниматель
				
				ИндивидуальныйПредприниматель = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представитель, "СведИП");
				Участник = ПолучитьДанныеИндивидуальногоПредпринимателя(ИндивидуальныйПредприниматель);
				
			ИначеЕсли ТипУчастника = "ФЛ" Тогда // Физическое лицо
				
				ФизическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представитель, "СведФизЛ");
				Участник = ПолучитьДанныеФизическогоЛица(ФизическоеЛицо);
				
			Иначе
				Участник = СтруктураДанныхУчастника();
			КонецЕсли;
			
			Результат.Добавить(Участник);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

