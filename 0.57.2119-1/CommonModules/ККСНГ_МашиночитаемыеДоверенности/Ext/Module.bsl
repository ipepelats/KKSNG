#Область Формат_002

Функция ЗаполнитьДоверенностьПоXML_002(ДанныеДоверенности)
	
	Перем ДоверенностьОбъект;
	Перем ИдентификаторФайла, СведенияОДоверенности, СведенияОПередоверии;
	Перем СведенияОДоверителях, СведенияОДоверителяхПерв, СведенияОПредставителях, СведенияОПолномочиях;
	Перем Доверители, Доверитель, НоваяСтрока, Представители, Представитель, Полномочия, Полномочие;
	
	ДоверенностьОбъект = Справочники.ККСНГ_МашиночитаемыеДоверенности.СоздатьЭлемент();
	
	ИдентификаторФайла = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДоверенности, "ИдФайл");
	
	СведенияОДоверенности = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДоверенности, "Документ.Довер");
	СведенияОПередоверии = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДоверенности, "Документ.Передов");
	
	Если СведенияОПередоверии = Неопределено Тогда
		
		СведенияОДоверителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СвДоверит");
		СведенияОДоверителяхПерв = СведенияОДоверителях;
		
		СведенияОПредставителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СвУпПред");
		СведенияОПолномочиях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СвПолн");
		
		СведенияОДоверенности = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СвДов");
		
	Иначе
		
		СведенияОДоверителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвЛицПередПолн");
		СведенияОДоверителяхПерв = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвДовПер.СвОснДовер.СвДовер0");
		
		СведенияОПредставителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвЛицПолучПолн");
		СведенияОПолномочиях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвПолн");
		
		ДоверенностьОбъект.НомерДоверенностиОснования = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвДовПер.НомДоверN");
		ДоверенностьОбъект.НомерПервоначальнойДоверенности = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвДовПер.СвОснДовер.НомДовер0");
		
		СведенияОДоверенности = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвДовПер.СвПереДовер");
		
	КонецЕсли;
	
	ДоверенностьОбъект.ИмяФайлаДоверенности = СтрШаблон("%1.xml", ИдентификаторФайла);
	ДоверенностьОбъект.Код = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "НомДовер");
	ДоверенностьОбъект.ДатаНачала = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "ДатаВыдДовер");
	ДоверенностьОбъект.ДатаОкончания = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "ДатаКонДовер");
	ДоверенностьОбъект.ИнформационнаяСистема = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СведСистОтм");
	
	Доверители = ПолучитьДоверителей_002(СведенияОДоверителях);
	Для каждого Доверитель Из Доверители Цикл
		НоваяСтрока = ДоверенностьОбъект.Доверители.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Доверитель, , "Подписанты");
		НоваяСтрока.Подписанты = ККСНГ_ОбщегоНазначения.СтрокаJSON(Доверитель.Подписанты);
	КонецЦикла;
	
	// Заполняем ИНН первоначального доверителя (первого в списке)
	Если СведенияОДоверителяхПерв <> СведенияОДоверителях Тогда
		Доверители = ПолучитьДоверителей_002(СведенияОДоверителяхПерв);
	КонецЕсли;
	Для каждого Доверитель Из Доверители Цикл
		ДоверенностьОбъект.ИННДоверителя = Доверитель.ИНН;
		Прервать;
	КонецЦикла;
	
	// Заполняем представителей
	Представители = ПолучитьПредставителей_002(СведенияОПредставителях);
	Для каждого Представитель Из Представители Цикл
		НоваяСтрока = ДоверенностьОбъект.Представители.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Представитель);
	КонецЦикла;
	
	// Заполняем полномочия
	Полномочия = ПолучитьПолномочия(СведенияОПолномочиях);
	Для каждого Полномочие Из Полномочия Цикл
		НоваяСтрока = ДоверенностьОбъект.Полномочия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Полномочие);
	КонецЦикла;
	
	Возврат ДоверенностьОбъект;
	
КонецФункции

Функция ПолучитьДоверителей_002(СведенияОДоверителях)
	
	Перем Результат, Доверитель, СведенияОДоверителе;
	
	Результат = Новый Массив;
	
	Если ТипЗнч(СведенияОДоверителях) = Тип("Массив") Тогда
		Для каждого Доверитель Из СведенияОДоверителях Цикл
			СведенияОДоверителе = ПолучитьСведенияДоверителя_002(Доверитель);
			Результат.Добавить(СведенияОДоверителе);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведенияДоверителя_002(Доверитель)
	
	Перем ПервоначальнаяДоверенность, ТипУчастника;
	Перем ЮридическоеЛицо, ИностраннаяОрганизация, ИндивидуальныйПредприниматель, ФизическоеЛицо;
	Перем Участник, Подписант, Фамилия, Имя, Отчество, ДанныеПодписанта;
	
	ПервоначальнаяДоверенность = Истина;
	
	ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ТипДовер");
	
	Если ТипУчастника = Неопределено Тогда
		ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ТипЛицПрдПолн");
		ПервоначальнаяДоверенность = Ложь;
	КонецЕсли;
	
	Если ТипУчастника = "ЮЛ" Тогда // Юридическое лицо
		
		ЮридическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, ?(ПервоначальнаяДоверенность, "РосОргДовер.СвРосОрг", "РосОргПрдПолн"));
		Если ЮридическоеЛицо = Неопределено И ПервоначальнаяДоверенность Тогда // Доверитель первоначальной доверенности при передоверии
			ЮридическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "РосОргДовер");
		КонецЕсли;
		
		Участник = ПолучитьДанныеЮридическогоЛица(ЮридическоеЛицо);
		
	ИначеЕсли ТипУчастника = "ИО" Тогда // Иностранная организация (Филиал иностранной организации)
		
		ИностраннаяОрганизация = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ИнОргДовер.СвИнОрг");
		Если ИностраннаяОрганизация = Неопределено Тогда // Доверитель первоначальной доверенности при передоверии
			ИностраннаяОрганизация = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ИнОргДовер");
		КонецЕсли;
		
		Участник = ПолучитьДанныеИностраннойОрганизации(ИностраннаяОрганизация);
		
	ИначеЕсли ТипУчастника = "ИП" Тогда // Индивидуальный предприниматель
		
		ИндивидуальныйПредприниматель = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, ?(ПервоначальнаяДоверенность, "ИПДовер", "ИППрдПолн"));
		Участник = ПолучитьДанныеИндивидуальногоПредпринимателя(ИндивидуальныйПредприниматель);
		
	ИначеЕсли ТипУчастника = "ФЛ" Тогда // Физическое лицо
		
		ФизическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, ?(ПервоначальнаяДоверенность, "ФЛДовер", "ФЛПрдПолн"));
		Участник = ПолучитьДанныеФизическогоЛица(ФизическоеЛицо);
		
	Иначе
		Участник = СтруктураДанныхУчастника();
	КонецЕсли;
	
	// Заполняем подписантов
	Подписант = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "Подписант");
	
	Участник.Подписанты = Новый Массив;
	Если ТипЗнч(Подписант) = Тип("Структура") Тогда
		
		Фамилия = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "Фамилия");
		Имя = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "Имя");
		Отчество = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "Отчество");
		
		ДанныеПодписанта = СтруктураДанныхУчастника();
		ДанныеПодписанта.Наименование = ККСНГ_ОбщегоНазначенияКлиентСервер.СоединитьСтрокиСПробелом(Фамилия, Имя, Отчество);
		
		Участник.Подписанты.Добавить(ДанныеПодписанта);
		
	КонецЕсли;
	
	Возврат Участник;
	
КонецФункции

