		СведенияОПредставителях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвПолучПолн");
		СведенияОПолномочиях = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвПолн");
		
		ДоверенностьОбъект.НомерДоверенностиОснования = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвПередов.НомДоверN");
		ДоверенностьОбъект.НомерПервоначальнойДоверенности = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПередоверии, "СвПервДовер.НомДоверПерв");
		
	КонецЕсли;
	
	ДоверенностьОбъект.ИмяФайлаДоверенности = СтрШаблон("%1.xml", ИдентификаторФайла);
	ДоверенностьОбъект.Код = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "НомДовер");
	ДоверенностьОбъект.ДатаНачала = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "ДатаВыдДовер");
	ДоверенностьОбъект.ДатаОкончания = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СрокДейст");
	ДоверенностьОбъект.ИнформационнаяСистема = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверенности, "СведСист");
	
	Доверители = ПолучитьДоверителей_003(СведенияОДоверителях);
	Для каждого Доверитель Из Доверители Цикл
		НоваяСтрока = ДоверенностьОбъект.Доверители.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Доверитель, , "Подписанты");
		НоваяСтрока.Подписанты = ККСНГ_ОбщегоНазначения.СтрокаJSON(Доверитель.Подписанты);
	КонецЦикла;
	
	// Заполняем ИНН доверителя (первого в списке)
	Для каждого Доверитель Из Доверители Цикл
		ДоверенностьОбъект.ИННДоверителя = Доверитель.ИНН;
		Прервать;
	КонецЦикла;
	
	// Заполняем представителей
	Представители = ПолучитьПредставителей_003(СведенияОПредставителях);
	Для каждого Представитель Из Представители Цикл
		НоваяСтрока = ДоверенностьОбъект.Представители.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Представитель);
	КонецЦикла;
	
	// Заполняем полномочия
	Полномочия = ПолучитьПолномочия_003(СведенияОПолномочиях);
	Для каждого Полномочие Из Полномочия Цикл
		НоваяСтрока = ДоверенностьОбъект.Полномочия.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Полномочие);
	КонецЦикла;
	
	Возврат ДоверенностьОбъект;
	
КонецФункции

Функция ПолучитьДоверителей_003(СведенияОДоверителях)
	
	Перем Результат, Доверитель, СведенияОДоверителе;
	
	Результат = Новый Массив;
	
	Если ТипЗнч(СведенияОДоверителях) = Тип("Массив") Тогда
		Для каждого Доверитель Из СведенияОДоверителях Цикл
			СведенияОДоверителе = ПолучитьСведенияДоверителя_003(Доверитель);
			Результат.Добавить(СведенияОДоверителе);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведенияДоверителя_003(Доверитель)
	
	Перем ПервоначальнаяДоверенность, СведенияОДоверителе, ТипУчастника;
	Перем ЮридическоеЛицо, ИностраннаяОрганизация, ИндивидуальныйПредприниматель, ФизическоеЛицо;
	Перем Участник, Подписанты, Подписант, СведенияОПодписантах, СведенияОПодписанте;
	
	Подписанты = Новый Массив;
	ПервоначальнаяДоверенность = Истина;
	
	СведенияОДоверителе = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "Доверит");
	ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ТипДоверит");
	
	Если СведенияОДоверителе = Неопределено Тогда
		СведенияОДоверителе = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ПередПолн");
		ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Доверитель, "ТипПерПолн");
		ПервоначальнаяДоверенность = Ложь;
	КонецЕсли;
	
	Если ТипУчастника = "1" Тогда // Юридическое лицо
		
		ЮридическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "РосОргДовер.СвРосОрг", "РосОргПерПолн.СвРосОрг"));
		Участник = ПолучитьДанныеЮридическогоЛица(ЮридическоеЛицо);
		Подписанты = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "РосОргДовер.ЛицоБезДов", "РосОргПерПолн.ЛицоБезДов"));
		
	ИначеЕсли ТипУчастника = ?(ПервоначальнаяДоверенность, "2", "5") Тогда // Иностранная организация (Филиал иностранной организации)
		
		ИностраннаяОрганизация = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "ИнОргДовер.СвИнОрг", "ИнПерПолн.СвИнОрг"));
		Участник = ПолучитьДанныеИностраннойОрганизации(ИностраннаяОрганизация);
		Подписанты = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "ИнОргДовер.СвРукОП", "ИнПерПолн.СвРукОП"));
		
	ИначеЕсли ТипУчастника = ?(ПервоначальнаяДоверенность, "3", "2") Тогда // Индивидуальный предприниматель
		
		ИндивидуальныйПредприниматель = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "ИПДовер", "ИППерПолн"));
		Участник = ПолучитьДанныеИндивидуальногоПредпринимателя(ИндивидуальныйПредприниматель);
		Подписанты.Добавить(ИндивидуальныйПредприниматель);
		
	ИначеЕсли ТипУчастника = ?(ПервоначальнаяДоверенность, "4", "3") Тогда // Физическое лицо
		
		ФизическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, ?(ПервоначальнаяДоверенность, "ФЛДовер", "ФЛПерПолн"));
		Участник = ПолучитьДанныеФизическогоЛица(ФизическоеЛицо);
		Подписанты.Добавить(ФизическоеЛицо);
		
	ИначеЕсли ТипУчастника = "4" Тогда // Филиал для передоверенности
		
		Филиал = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, "ФилПерПолн.СвФил");
		Участник = ПолучитьДанныеЮридическогоЛица(Филиал);
		ФизическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОДоверителе, "ФилПерПолн.СвРукФил");
		Подписанты.Добавить(ФизическоеЛицо);
		
	Иначе
		Участник = СтруктураДанныхУчастника();
	КонецЕсли;
	
	// Заполняем подписантов
	Участник.Подписанты = Новый Массив;
	Если ТипЗнч(Подписанты) = Тип("Массив") Тогда
		Для каждого Подписант Из Подписанты Цикл
			СведенияОПодписантах = ПолучитьСведенияОПодписантах_003(Подписант);
			Для каждого СведенияОПодписанте Из СведенияОПодписантах Цикл
				Участник.Подписанты.Добавить(СведенияОПодписанте);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Участник;
	
КонецФункции

Функция ПолучитьСведенияОПодписантах_003(Подписант)
	
	Перем Результат;
	Перем СведенияОУчастнике, СведенияОУчастниках;
	
	Результат = Новый Массив;
	
	// Физическое лицо
	СведенияОУчастнике = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "СвФЛ");
	
	// Индивидуальный предприниматель
	Если СведенияОУчастнике = Неопределено Тогда
		СведенияОУчастнике = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "СведФЛ");
	КонецЕсли;
	
	// Физическое лицо сам доверитель
	Если СведенияОУчастнике = Неопределено Тогда
		СведенияОУчастнике = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "СведФИО");
	КонецЕсли;
	
	Если СведенияОУчастнике <> Неопределено Тогда
		Результат.Добавить(ПолучитьДанныеФизическогоЛица(СведенияОУчастнике));
	КонецЕсли;
	
	// Индивидуальный предприниматель
	СведенияОУчастнике = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "СвИП");
	Если СведенияОУчастнике <> Неопределено Тогда
		Результат.Добавить(ПолучитьДанныеФизическогоЛица(СведенияОУчастнике));
	КонецЕсли;
	
	// Юридическое лицо
	СведенияОУчастниках = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Подписант, "СВЮЛ.СвФЛ");
	Если ТипЗнч(СведенияОУчастниках) = Тип("Массив") Тогда
		Для каждого СведенияОУчастнике Из СведенияОУчастниках Цикл
			Результат.Добавить(ПолучитьДанныеФизическогоЛица(СведенияОУчастнике));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредставителей_003(СведенияОПредставителях)
	
	Перем Результат;
	Перем Представитель, СведенияОПредставителе;
	
	Результат = Новый Массив;
	
	Если ТипЗнч(СведенияОПредставителях) = Тип("Массив") Тогда
		Для каждого Представитель Из СведенияОПредставителях Цикл
			СведенияОПредставителе = ПолучитьСведенияПредставителя_003(Представитель);
			Результат.Добавить(СведенияОПредставителе);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведенияПредставителя_003(Представитель)
	
	Перем СведенияОПредставителе, ТипУчастника, Участник;
	Перем ЮридическоеЛицо, ИндивидуальныйПредприниматель, ФизическоеЛицо, ФилиалЮридическогоЛица, ФилиалИностраннойОрганизации;
	
	СведенияОПредставителе = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представитель, "Пред");
	ТипУчастника = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Представитель, "ТипПред");
	
	Если ТипУчастника = "1" Тогда // Юридическое лицо
		
		ЮридическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПредставителе, "СведОрг");
		Участник = ПолучитьДанныеЮридическогоЛица(ЮридическоеЛицо);
		
	ИначеЕсли ТипУчастника = "2" Тогда // Индивидуальный предприниматель
		
		ИндивидуальныйПредприниматель = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПредставителе, "СведИП");
		Участник = ПолучитьДанныеИндивидуальногоПредпринимателя(ИндивидуальныйПредприниматель);
		
	ИначеЕсли ТипУчастника = "3" Тогда // Физическое лицо
		
		ФизическоеЛицо = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПредставителе, "СведФизЛ");
		Участник = ПолучитьДанныеФизическогоЛица(ФизическоеЛицо);
		
	ИначеЕсли ТипУчастника = "4" Тогда // Филиал юридического лица
		
		ФилиалЮридическогоЛица = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПредставителе, "СведФилиал");
		Участник = ПолучитьДанныеЮридическогоЛица(ФилиалЮридическогоЛица);
		
	ИначеЕсли ТипУчастника = "5" Тогда // Филиал иностранной организации
		
		ФилиалИностраннойОрганизации = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СведенияОПредставителе, "СведИО");
		Участник = ПолучитьДанныеИностраннойОрганизации(ФилиалИностраннойОрганизации);
		
	Иначе
		Участник = СтруктураДанныхУчастника();
	КонецЕсли;
	
	Возврат Участник;
	
КонецФункции

Функция ПолучитьПолномочия_003(Полномочия)
	
	Перем Результат;
	Перем ТипПолномочий, МашиночитаемыеПолномочия, Полномочие;
	
	Результат = Новый Массив;
	
	ТипПолномочий = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочия, "ТипПолн");
	
	Если ТипПолномочий = "0" Тогда // Текстовые полномочия
		
		Полномочие = СтруктураПолномочий();
		Полномочие.Текст = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочия, "ТекстПолн");
		Результат.Добавить(Полномочие);
		
	ИначеЕсли ТипПолномочий = "1" Тогда // Машиночитаемые полномочия
		
		МашиночитаемыеПолномочия = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочия, "МашПолн");
		Если ТипЗнч(МашиночитаемыеПолномочия) = Тип("Массив") Тогда
			Для каждого Полномочие Из МашиночитаемыеПолномочия Цикл
				
				Полномочия = СтруктураПолномочий();
				Полномочия.Код = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочие, "КодПолн");
				Полномочия.Текст = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Полномочие, "НаимПолн");
				Результат.Добавить(Полномочия);
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

