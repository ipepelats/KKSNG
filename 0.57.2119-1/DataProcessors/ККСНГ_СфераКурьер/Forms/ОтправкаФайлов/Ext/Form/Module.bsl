
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ККСНГ_ОбщегоНазначенияВызовСервера.СброситьРазмерыИПоложениеОкна(ЭтотОбъект);
	
	Параметры.Свойство("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	Параметры.Свойство("БизнесПроцесс", БизнесПроцесс);
	
	ЭтаФорма.Заголовок = СтрШаблон("Отправка файлов (%1)", ПрофильНастройкиЭДО);
	
	ДатаДокумента = ТекущаяДатаСеанса();
	
	ДоступнаРаботаСЧерновиками = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ИспользуетсяОтправкаЧерновиков();
	Элементы.ФормаДобавитьВЧерновики.Видимость = ДоступнаРаботаСЧерновиками;
	
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	Если НЕ МодульККСНГ_ПМ_РаботаСМетаданными = Неопределено Тогда
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.ДоговорУВХД, "ДоговорыСоглашения");
	КонецЕсли;
	
	Если БизнесПроцесс = "УВХД" Тогда
		СписокКонтрагентовСбер = ПолучитьСписокКонтрагентовСбер(ПрофильНастройкиЭДО, "КонтрагентЭДО");
		Если СписокКонтрагентовСбер.Количество() = 1 Тогда
			Получатель = СписокКонтрагентовСбер[0].Значение;
		КонецЕсли;
		
		СписокНаименованийДокумента = ККСНГ_ЭлектронныеДокументы.ПолучитьСписокНаименованийДокументаУВХД();
		ИмяДокументаСписокВыбора = Элементы.НаименованиеДокументаУВХД.СписокВыбора;
		ИмяДокументаСписокВыбора.Очистить();
		
		Для Каждого НаименованиеДокумента Из СписокНаименованийДокумента Цикл
			ИмяДокументаСписокВыбора.Добавить(НаименованиеДокумента.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьОтображениеДанныхФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДоступныеПрофилиЭДО = ККСНГ_ОбщегоНазначенияВызовСервера.ПолучитьДоступныеПрофилиЭДОПользователя();
	
	Если ЗначениеЗаполнено(ПрофильНастройкиЭДО) И ДоступныеПрофилиЭДО.Найти(ПрофильНастройкиЭДО) = Неопределено Тогда
		Отказ = Истина;
		ТекстОшибки = СтрШаблон("Организация %1 недоступна пользователю", ПрофильНастройкиЭДО);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиСообщениеПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	УстановитьТипДокумента = Новый ОписаниеОповещения("ПослеЗаполнениеТиповДокументов", ЭтотОбъект);
	НачатьЗаполнениеТиповДокументов(УстановитьТипДокумента);
	
	Если ЗначениеЗаполнено(Получатель) Тогда
		ПослеВыбораПолучателя(Получатель, Неопределено);
	КонецЕсли;
	
	ОбновитьОтображениеДанныхФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьКонтрагентаЭДО" И Источник = Получатель Тогда
		ЗагрузитьСписокВыбораДоговоровУВХД(Получатель);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если БизнесПроцесс = "УВХД" Тогда
		ПроверяемыеРеквизиты.Добавить("ДоговорУВХД");
		Если ТипДокумента = "DOCUMENT" Тогда
			ПроверяемыеРеквизиты.Добавить("НаименованиеДокументаУВХД");
		КонецЕсли;
	КонецЕсли;
	
	Если Не РежимНесколькоПолучателей Тогда
		ПроверяемыеРеквизиты.Добавить("Получатель");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элементы.ТипДокумента.СписокВыбора.Количество() = 0 Тогда
		Если Не ЗаполненПрофильЭДО() Тогда 
			СтандартнаяОбработка = Ложь;
		Иначе
			НачатьЗаполнениеТиповДокументов();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИтогиОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СтатусОтправки", 2);	
	СтрокиСОшибками = Получатели.НайтиСтроки(ПараметрыОтбора);
	ОтправленныеСОшибками = Новый Массив;
	Для каждого ТекСтрока Из СтрокиСОшибками Цикл 
		ТекОшибка = Новый Структура;
		ТекОшибка.Вставить("КонтрагентЭДО", ТекСтрока.КонтрагентЭДО); 
		ТекОшибка.Вставить("ТекстОшибки", ТекСтрока.ТекстОшибки); 
		
		ОтправленныеСОшибками.Добавить(ТекОшибка);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("ОтправленныеСОшибками", ОтправленныеСОшибками);
	ОткрытьФорму("Обработка.ККСНГ_СфераКурьер.Форма.ФормаОписаниеОшибок", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Владелец", ПрофильНастройкиЭДО);
	
	Если БизнесПроцесс = "УВХД" Тогда
		СписокКонтрагентовСбер = ПолучитьСписокКонтрагентовСбер(ПрофильНастройкиЭДО);
		ПараметрыОтбора.Вставить("Контрагент", СписокКонтрагентовСбер);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ПослеВыбораПолучателя", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.ККСНГ_Контрагенты.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , ОбработкаОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКДокументуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтправляемыеФайлы.Очистить();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборФайла", ЭтотОбъект);
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок = "Выберите файл для отправки";
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорУВХДОчистка(Элемент, СтандартнаяОбработка)
	
	ДоговорУВХД = Неопределено;
	ЗагрузитьСписокВыбораТиповДокумента();
	ЗаполнитьДопПараметрыПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорУВХДОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДоговорУВХД = ВыбранноеЗначение;
	ЗагрузитьСписокВыбораТиповДокумента(ВыбранноеЗначение);
	ЗаполнитьДопПараметрыПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаОчистка(Элемент, СтандартнаяОбработка)
	
	ТипДокумента = "";
	ЗаполнитьДопПараметрыПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаПриИзменении(Элемент)
	
	ЗаполнитьДопПараметрыПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПриИзменении(Элемент)
	
	ПослеВыбораПолучателя(Получатель, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКДокументуПриИзменении(Элемент)
	
	ВыбранныеФайлы = Новый Массив;
	ВыбранныеФайлы.Добавить(ПутьКДокументу);
	
	ОбработатьВыборФайла(ВыбранныеФайлы, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеДокументаУВХДПриИзменении(Элемент)
	
	ЗаполнитьДопПараметрыПоУмолчанию();
	
КонецПроцедуры

#Область ОбработчикиСобытийПоПолучателям

&НаКлиенте
Процедура ПодборКонтрагентовЭДО(Команда)
	
	Если Не ЗаполненПрофильЭДО() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Владелец", ПрофильНастройкиЭДО);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	// TODO: сделать общий универсальный метод получения реквизита по названию, обсудить в каком модуле
	ВозможноУстановитьОтборПоИНН = ВозможноУстановитьОтборПоИНН();
	Если ВозможноУстановитьОтборПоИНН Тогда
		
		НастройкиКД = Новый НастройкиКомпоновкиДанных;
		ОтборСсылка = НастройкиКД.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборСсылка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент.ИНН");
		ОтборСсылка.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ОтборСсылка.ПравоеЗначение = "7707083893";
		ОтборСсылка.Использование = Истина;
		
	КонецЕсли;
	
	НестандартныйОтбор = Новый Структура;
	НестандартныйОтбор.Вставить("НестандартныйОтбор", НастройкиКД);
	
	ПараметрыФормы.Вставить("ДополнительныеПараметры", НестандартныйОтбор);
	
	ОткрытьФорму("Справочник.ККСНГ_Контрагенты.ФормаВыбора", ПараметрыФормы, Элементы.Получатели);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для каждого ВыбранныйКонтрагентЭДО Из ВыбранноеЗначение Цикл
		
		ЭтоКонтрагентСбер = ККСНГ_РаботаСКонтрагентамиВызовСервера.ЭтоКонтрагентСбер(ВыбранныйКонтрагентЭДО);
		Если РежимНесколькоПолучателей И ЭтоКонтрагентСбер Тогда
			ТекстСообщения = "ПАО Сбербанк можно выбрать в режиме одного получателя";
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("КонтрагентЭДО", ВыбранныйКонтрагентЭДО);
		ТакиеЖеКонтрагентыЭДО = Получатели.НайтиСтроки(ПараметрыПоиска);
		
		Если ТакиеЖеКонтрагентыЭДО.Количество() = 0 Тогда 
			НоваяСтрока = Получатели.Добавить();
			НоваяСтрока.КонтрагентЭДО = ВыбранныйКонтрагентЭДО;
			
			РеквизитыКонтрагента = ККСНГ_ОбщегоНазначенияВызовСервера.ЗначениеИмеющегосяРеквизитаОбъекта(НоваяСтрока.КонтрагентЭДО, "Контрагент.ИНН, Контрагент.КПП");
			НоваяСтрока.ИНН = РеквизитыКонтрагента.Получить("ИНН");
			НоваяСтрока.КПП = РеквизитыКонтрагента.Получить("КПП");
		Иначе
			ШаблонСообщения = "Получатель был добавлен ранее: %1";
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ВыбранныйКонтрагентЭДО);
			ИндексСтроки = Получатели.Индекс(ТакиеЖеКонтрагентыЭДО[0]);
			СтрокаПоля = СтрШаблон("Получатели[%1].КонтрагентЭДО", ИндексСтроки);
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , СтрокаПоля);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрокаПолучателя = Элемент.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтрокаПолучателя.ОтправленныйЭД) Тогда 
		ОткрываемыйЭлемент = ТекСтрокаПолучателя.ОтправленныйЭД;
	Иначе
		ОткрываемыйЭлемент = ТекСтрокаПолучателя.КонтрагентЭДО;
	КонецЕсли;
	
	ПоказатьЗначение(, ОткрываемыйЭлемент);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

