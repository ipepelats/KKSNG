КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеФоновогоЗаданияОтправкиФайлов() Экспорт
	
	Перем НайденныеЧерновики, ИнформацияПоДокументу, ВариантОтправки;
	
	Если Не ЗаданиеЗапущено() Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоПолучателей = Получатели.Количество();
	
	ИнфоОВыполнении = ККСНГ_ОбщегоНазначенияВызовСервера.ИнфоОВыполненииФоновогоЗадания(ИдентификаторЗаданияОтправкиФайлов, "; получателю; ; получателям; получателям; получателям");
	Если Не ИнфоОВыполнении = Неопределено Тогда
		ПрогрессБар = ИнфоОВыполнении.Процент;
		Элементы.ПрогрессБар.Заголовок = СтрШаблон("Отправлено %1 из %2 ", ИнфоОВыполнении.Представление, ВсегоПолучателей);
	КонецЕсли;
	
	ОписаниеОшибкиВыполненияФЗ = "";
	ЗаданиеВыполнено = ККСНГ_ОбщегоНазначенияВызовСервера.ЗаданиеВыполнено(ИдентификаторЗаданияОтправкиФайлов, ОписаниеОшибкиВыполненияФЗ);
	
	Если ЗаданиеВыполнено И Не ОписаниеОшибкиВыполненияФЗ = "" Тогда
		ИнициализироватьПослеОтправки("");
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибкиВыполненияФЗ);
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресРезультатаФоновогоЗаданияОтправкиФайлов);
	Если Не ТипЗнч(РезультатВыполнения) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущийПолучатель Из РезультатВыполнения.РезультатПоПолучателям Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("КонтрагентЭДО", ТекущийПолучатель.Ключ);
		
		СтрокиПолучателя = Получатели.НайтиСтроки(ПараметрыОтбора);
		Если СтрокиПолучателя.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокиПолучателя[0], ТекущийПолучатель.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	НайденныеЧерновики = Получатели.НайтиСтроки(Новый Структура("ИмяСтатуса", "Черновик"));
	Если НайденныеЧерновики.Количество() <> 0 Тогда
		ВариантОтправки = "сохранен в черновики";
	Иначе
		ВариантОтправки = "отправлен";
	КонецЕсли;
	
	Если ЗаданиеВыполнено Тогда
		
		ЧастиИтогов = Новый Массив;
		
		КоличествоСтрокой = ККСНГ_ОбщегоНазначенияВызовСервера.КоличествоСтрокой("; получателю; ; получателям; получателям; получателям", РезультатВыполнения.ОтправленныхУспешно);
		
		ТекстИтогов = СтрШаблон("Файл %1 %2 из %3 ", ВариантОтправки, КоличествоСтрокой, ВсегоПолучателей);
		ЧастиИтогов.Добавить(ТекстИтогов);
		
		Получатели.Сортировать("СтатусОтправки Убыв"); 
		ИнициализироватьПослеОтправки("");
		
		Если РезультатВыполнения.ОтправленныхУспешно <> ВсегоПолучателей Тогда 
			
			ТекстСсылкиНаОшибки = "Перейти к ошибкам";
			СсылкаНаОшибки = "СсылкаНаОшибки";
			ЧастиИтогов.Добавить(Новый ФорматированнаяСтрока(ТекстСсылкиНаОшибки,,,, СсылкаНаОшибки));
			Элементы.ДекорацияИтоги.Заголовок = Новый ФорматированнаяСтрока(ЧастиИтогов);
			Элементы.ДекорацияИтоги.Видимость = Истина;
			
		Иначе	
			
			Элементы.ДекорацияИтоги.Видимость = Ложь;
			
			КнопкиВопроса = Новый СписокЗначений;
			КнопкиВопроса.Добавить(Ложь, "Завершить");
			КнопкиВопроса.Добавить(Истина, "Отправить ещё файлы");
			
			Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросПриЗавершенииФЗ", ЭтотОбъект);
			
			ТекстВопроса = СтрШаблон("Файл %1.", ВариантОтправки);
			ЗаголовокОкна = "Отправка файлов";
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, КнопкиВопроса, 0, , ЗаголовокОкна);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗаданиеОтправкиФайловНаСервере(ДанныеВызоваФЗ, УникальныйИдентификатор)
	
	КлючЗадания = "ОтправкаФайлов" + УникальныйИдентификатор;
	
	ПараметрыФоновогоЗадания = ККСНГ_ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ДанныеВызоваФЗ);
	
	ТаблицаПолучателей = РеквизитФормыВЗначение("Получатели");
	ПараметрыФоновогоЗадания.Добавить(ТаблицаПолучателей.ВыгрузитьКолонку("КонтрагентЭДО"));
	
	ДопРеквизитыПоПолучателям = РеквизитФормыВЗначение("ДопРеквизитыПолучателей");
	ПараметрыФоновогоЗадания.Добавить(ДопРеквизитыПоПолучателям);
	
	ФоновоеЗаданиеИмяМетода = "ККСНГ_ЭлектронныеДокументыВызовСервера.ОтправитьДанныеПакетовФайловПолучателям";
	Попытка
		ФоновоеЗадание = ФоновыеЗадания.Выполнить(ФоновоеЗаданиеИмяМетода, ПараметрыФоновогоЗадания, КлючЗадания, "Отправка файлов получателям ");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ФоновоеЗадание.УникальныйИдентификатор;
	
КонецФункции

&НаКлиенте
Функция КарточкаДокумента()
	
	ЗаголовокЖурнала = "Формирование карточки документа";
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета(ЗаголовокЖурнала);
	
	ПоказатьОповещениеПользователя(ЗаголовокЖурнала); 
	
	ДанныеКарточки = Новый Структура;
	ДанныеКарточки.Вставить("Дата", ДатаДокумента);
	ДанныеКарточки.Вставить("Номер", НомерДокумента);
	ДанныеКарточки.Вставить("КодТипаДокумента", ТипДокумента);
	
	ДанныеСвязанногоДокумента = ДанныеСвязанногоДокумента();
	ДанныеКарточки.Вставить("ИдентификаторСвязанногоДокумента", ДанныеСвязанногоДокумента.Идентификатор);
	ДанныеКарточки.Вставить("ТипСвязи", ДанныеСвязанногоДокумента.ТипСвязи);
	
	ЕдинственныйФайл = ОтправляемыеФайлы[0];
	ИмяФайла = ЕдинственныйФайл.ИмяФайла;
	СодержимоеФайла = ПолучитьИзВременногоХранилища(ЕдинственныйФайл.АдресДанных);
	
	ДанныеКарточки.Вставить("Filename", ИмяФайла);
	ДанныеКарточки.Вставить("MimeType", "application/xml");
	
	Если СодержимоеФайла.Размер() = 0 Тогда
		СобытиеОшибки = "Отправляемые файлы пусты";
		КодОшибки = "MASS-00002";
		КомментарийОшибки = "Все отправляемые файлы пусты. Выберите, пожалуйста, другие файлы.";
		ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, СобытиеОшибки, КодОшибки, КомментарийОшибки);
		Возврат Ответ;
	КонецЕсли;
	
	ДанныеКарточки.Вставить("Content", СодержимоеФайла);
	ДанныеКарточки.Вставить("Ссылка", Неопределено);
	ДанныеКарточки.Вставить("Комментарий", "");
	
	Ответ.Успех = Истина;
	Ответ.Результат = ДанныеКарточки;
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Функция ЗаданиеЗапущено()
	
	Возврат ЗначениеЗаполнено(ИдентификаторЗаданияОтправкиФайлов);
	
КонецФункции

&НаКлиенте
Процедура ПослеУстановкиДопПараметров(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ОтборПоиска = Новый Структура;
		ОтборПоиска.Вставить("КонтрагентЭДО", Результат.КонтрагентЭДО);
		НайденнныеСтроки = ДопРеквизитыПолучателей.НайтиСтроки(ОтборПоиска);
		Если НайденнныеСтроки.Количество() > 0 Тогда
			СтрокаПолучателя = НайденнныеСтроки[0];
		Иначе
			СтрокаПолучателя = ДопРеквизитыПолучателей.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаПолучателя, Результат);
		
		Если БизнесПроцесс = "УВХД" И ТипДокумента = "DOCUMENT" Тогда
			МассивДопПараметров = ДополнительныеПараметрыДокументаИзСтроки(СтрокаПолучателя.ДопПараметры);
			Для каждого ДопПараметр из МассивДопПараметров Цикл
				Если ДопПараметр.Ключ = "document.name" Тогда
					НаименованиеДокументаУВХД = ДопПараметр.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДополнительныеПараметрыДокумента(ПараметрыДокумента, ДопПараметрыЗапроса = Неопределено)
	
	ДопПараметрыДокумента = Неопределено;
	
	РезультатСтрокой = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметрыЗапроса, "РезультатСтрокой", Ложь);
	
	ДопПараметрыМассив = ККСНГ_ЭлектронныеДокументы.ДополнительныеПараметрыДокумента(ПараметрыДокумента, ДопПараметрыЗапроса);
	
	Если ТипЗнч(ДопПараметрыМассив) = Тип("Массив") Тогда
		Если РезультатСтрокой Тогда
			ДопПараметрыДокумента = ЗначениеВСтрокуВнутр(ДопПараметрыМассив);
		Иначе
			ДопПараметрыДокумента = ДопПараметрыМассив;
		КонецЕсли;
	ИначеЕсли РезультатСтрокой Тогда
		ДопПараметрыДокумента = "";
	КонецЕсли;
	
	Возврат ДопПараметрыДокумента;
	
КонецФункции

