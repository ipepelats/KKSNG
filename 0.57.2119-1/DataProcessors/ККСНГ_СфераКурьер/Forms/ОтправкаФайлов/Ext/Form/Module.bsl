&НаСервере
Функция ДанныеСвязанногоДокумента()
	
	ДанныеРезультат = Новый Структура();
	ДанныеРезультат.Вставить("Идентификатор", "");
	ДанныеРезультат.Вставить("ТипСвязи", "Other");
	
	Если ЗначениеЗаполнено(ДоговорУВХД) И НЕ РежимНесколькоПолучателей Тогда
		
		МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
		ДанныеДоговора1С = МодульККСНГ_ПМ_РаботаСМетаданными.ПолучитьДанныеДоговора(ДоговорУВХД);
		
		ДанныеДоговораУВХД = ККСНГ_ЭлектронныеДокументы.ПолучитьДанныеДоговораУВХД(ДанныеДоговора1С);
		
		Если ТипЗнч(ДанныеДоговораУВХД) = Тип("Структура") И ДанныеДоговораУВХД.ИдентификаторДоговора > 0 Тогда
			ДанныеРезультат.Идентификатор = ДанныеДоговораУВХД.ИдентификаторДоговора; 
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеРезультат;
	
КонецФункции

