&НаСервереБезКонтекста
Функция ПолучитьСписокКонтрагентовСбер(ПрофильНастройкиЭДО, ТипКонтрагента = "Контрагент")
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыЭДО.Контрагент КАК Контрагент,
	|	КонтрагентыЭДО.Ссылка КАК КонтрагентЭДО
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты КАК КонтрагентыЭДО
	|ГДЕ
	|	КонтрагентыЭДО.Контрагент.ИНН = &ИНН
	|	И КонтрагентыЭДО.Владелец = &Владелец
	|	И НЕ КонтрагентыЭДО.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", ПрофильНастройкиЭДО);
	Запрос.УстановитьПараметр("ИНН", "7707083893");
	
	СписокКонтрагентовСбер = Новый СписокЗначений();
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Если ТипКонтрагента = "Контрагент" Тогда
			СписокКонтрагентовСбер.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Контрагент"));
		ИначеЕсли ТипКонтрагента = "КонтрагентЭДО" Тогда
			СписокКонтрагентовСбер.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КонтрагентЭДО"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокКонтрагентовСбер;
	
КонецФункции

#КонецОбласти