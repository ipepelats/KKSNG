	Элементы.Получатель.Доступность = Доступно;
	Элементы.ПолучателиУдалить.Доступность = Доступно;
	Элементы.ПолучателиУстановитьДопПараметры.Доступность = Доступно;
	Элементы.ПолучателиПереключитьНесколькоПолучателей.Доступность = Доступно;
	Элементы.НомерДокумента.Доступность = Доступно;
	Элементы.ДатаДокумента.Доступность = Доступно;
	Элементы.ПутьКДокументу.Доступность = Доступно;
