			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка,
	ККСНГ_ЭлектронныеДокументы.Id КАК Id,
	ККСНГ_ЭлектронныеДокументы.TotalSum КАК TotalSum,
	ККСНГ_ЭлектронныеДокументы.StatusName КАК StatusName,
	ВЫБОР
		КОГДА ККСНГ_Организации.ИдентификаторСК = ККСНГ_ЭлектронныеДокументы.ReceiverId
			ТОГДА ККСНГ_ЭлектронныеДокументы.SenderName
		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.ReceiverName
	КОНЕЦ КАК Контрагент,
	ККСНГ_ЭлектронныеДокументы.ReceiveDate КАК ReceiveDate,
	ВЫБОР
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_DOP"
			ТОГДА "УПД.ДОП"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_SF"
			ТОГДА "УПД.СЧФ"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_SF_DOP"
			ТОГДА "УПД.СЧФДОП"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_CSF"
			ТОГДА "УКД.КСЧФ"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_DIC"
			ТОГДА "УКД.ДИС"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_CSF_DIC"
			ТОГДА "УКД.КСЧФДИС"
		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.TypeName
	КОНЕЦ КАК ТипДокумента,
	ВЫРАЗИТЬ("" КАК СТРОКА(500)) КАК Выгружен,
	ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументы.Number КАК СТРОКА(255)) КАК Number,
	ККСНГ_ЭлектронныеДокументы.TypeName КАК TypeName
ИЗ
	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
		ПО ККСНГ_Организации.КодУчастникаЭДО = ККСНГ_ЭлектронныеДокументы.КодЭДОВладельца
ГДЕ
	ККСНГ_Организации.Ссылка = &amp;ПрофильНастройкиЭДО
	И ККСНГ_ЭлектронныеДокументы.ReceiveDate МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ККСНГ_ЭлектронныеДокументы.DocumentTypeCode В(&amp;ТипыДокументов)

СГРУППИРОВАТЬ ПО
	ККСНГ_ЭлектронныеДокументы.Ссылка,
	ККСНГ_ЭлектронныеДокументы.Id,
	ККСНГ_ЭлектронныеДокументы.TotalSum,
	ККСНГ_ЭлектронныеДокументы.StatusName,
	ККСНГ_ЭлектронныеДокументы.ReceiveDate,
	ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументы.Number КАК СТРОКА(255)),
	ВЫБОР
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_DOP"
			ТОГДА "УПД.ДОП"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_SF"
			ТОГДА "УПД.СЧФ"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UPD_SF_DOP"
			ТОГДА "УПД.СЧФДОП"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_CSF"
			ТОГДА "УКД.КСЧФ"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_DIC"
			ТОГДА "УКД.ДИС"
		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = "UCD_CSF_DIC"
			ТОГДА "УКД.КСЧФДИС"
		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.TypeName
	КОНЕЦ,
	ВЫБОР
		КОГДА ККСНГ_Организации.ИдентификаторСК = ККСНГ_ЭлектронныеДокументы.ReceiverId
			ТОГДА ККСНГ_ЭлектронныеДокументы.SenderName
		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.ReceiverName
	КОНЕЦ,
	ККСНГ_ЭлектронныеДокументы.TypeName</QueryText>
