	|	ККСНГ_ЭлектронныеДокументы.ReceiverName КАК ReceiverName,
	|	ККСНГ_ЭлектронныеДокументы.IsDocflowCompleted КАК IsDocflowCompleted,
	|	ККСНГ_ЭлектронныеДокументы.ReceiveDate КАК ReceiveDate,
	|	ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументы.Number КАК СТРОКА(255)) КАК Number,
	|	ККСНГ_ЭлектронныеДокументы.Date КАК Date,
	|	ВЫБОР
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_DOP""
	|			ТОГДА ""УПД.ДОП""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_SF""
	|			ТОГДА ""УПД.СЧФ""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_SF_DOP""
	|			ТОГДА ""УПД.СЧФДОП""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_CSF""
	|			ТОГДА ""УКД.КСЧФ""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_DIC""
	|			ТОГДА ""УКД.ДИС""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_CSF_DIC""
	|			ТОГДА ""УКД.КСЧФДИС""
	|		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.TypeName
	|	КОНЕЦ КАК ТипДокумента,
	|	ККСНГ_ЭлектронныеДокументы.ЕстьМаркировка КАК Маркированный,
	|	ККСНГ_ЭлектронныеДокументы.СтатусЦРПТ КАК СтатусЦРПТ,
	|	ККСНГ_СвязанныеДокументы.СвязанныйДокумент КАК Документ1С,
	|	НЕ ККСНГ_СвязанныеДокументы.СвязанныйДокумент ЕСТЬ NULL КАК Учет1С,
	|	NULL КАК БизнесПроцесс
	|ИЗ
	|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ККСНГ_СвязанныеДокументы КАК ККСНГ_СвязанныеДокументы
	|			ПО ККСНГ_ЭлектронныеДокументы.ГУИД = ККСНГ_СвязанныеДокументы.ЭлектронныйДокумент
	|				И ККСНГ_СвязанныеДокументы.КлючСтроки = 1
	|		ПО ККСНГ_Организации.КодУчастникаЭДО = ККСНГ_ЭлектронныеДокументы.КодЭДОВладельца
	|			И ККСНГ_Организации.ИдентификаторСК = ККСНГ_ЭлектронныеДокументы.ReceiverId
	|ГДЕ
	|	ККСНГ_Организации.Ссылка = &ПрофильНастройкиЭДО
	|	И ККСНГ_ЭлектронныеДокументы.IsDocflowCompleted
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка,
	|	ККСНГ_ЭлектронныеДокументы.Id,
	|	ККСНГ_ЭлектронныеДокументы.TypeName,
	|	ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументы.Description_ КАК СТРОКА(255)),
	|	ККСНГ_ЭлектронныеДокументы.TotalSum,
	|	ККСНГ_ЭлектронныеДокументы.StatusName,
	|	ККСНГ_ЭлектронныеДокументы.SenderName,
	|	ККСНГ_ЭлектронныеДокументы.ReceiverName,
	|	ККСНГ_ЭлектронныеДокументы.IsDocflowCompleted,
	|	ККСНГ_ЭлектронныеДокументы.ReceiveDate,
	|	ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументы.Number КАК СТРОКА(255)),
	|	ККСНГ_ЭлектронныеДокументы.Date,
	|	ВЫБОР
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_DOP""
	|			ТОГДА ""УПД.ДОП""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_SF""
	|			ТОГДА ""УПД.СЧФ""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UPD_SF_DOP""
	|			ТОГДА ""УПД.СЧФДОП""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_CSF""
	|			ТОГДА ""УКД.КСЧФ""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_DIC""
	|			ТОГДА ""УКД.ДИС""
	|		КОГДА ККСНГ_ЭлектронныеДокументы.DocumentTypeCode = ""UCD_CSF_DIC""
	|			ТОГДА ""УКД.КСЧФДИС""
	|		ИНАЧЕ ККСНГ_ЭлектронныеДокументы.TypeName
	|	КОНЕЦ,
	|	ККСНГ_ЭлектронныеДокументы.ЕстьМаркировка,
	|	ККСНГ_ЭлектронныеДокументы.СтатусЦРПТ,
	|	ККСНГ_СвязанныеДокументы.СвязанныйДокумент КАК Документ1С,
	|	НЕ ККСНГ_СвязанныеДокументы.СвязанныйДокумент ЕСТЬ NULL КАК Учет1С,
	|	NULL КАК БизнесПроцесс
	|ИЗ
	|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ККСНГ_СвязанныеДокументы КАК ККСНГ_СвязанныеДокументы
	|			ПО ККСНГ_ЭлектронныеДокументы.ГУИД = ККСНГ_СвязанныеДокументы.ЭлектронныйДокумент
	|				И ККСНГ_СвязанныеДокументы.КлючСтроки = 1
	|		ПО ККСНГ_Организации.КодУчастникаЭДО = ККСНГ_ЭлектронныеДокументы.КодЭДОВладельца
	|			И ККСНГ_Организации.ИдентификаторСК = ККСНГ_ЭлектронныеДокументы.SenderId
	|ГДЕ
	|	ККСНГ_Организации.Ссылка = &ПрофильНастройкиЭДО
	|	И ККСНГ_ЭлектронныеДокументы.IsDocflowCompleted";
	
	ОбработанныеДокументы.ДинамическоеСчитываниеДанных = Истина;
	ОбработанныеДокументы.ОсновнаяТаблица = "Справочник.ККСНГ_ЭлектронныеДокументы";
		
	ОбработанныеДокументы.УстановитьОбязательноеИспользование("Ссылка", Истина);
	
