Функция СоответствияРазделовШаблон(Знач ЗначениеПоУмолчанию = Неопределено)
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("КОтправке", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПодписатьИОтправить", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПодписатьИОтправитьУВХД", ЗначениеПоУмолчанию);
	Соответствие.Вставить("Черновики", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПодписатьКвитанции", ЗначениеПоУмолчанию);
	Соответствие.Вставить("Входящие", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПринятьВх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПодписатьВх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("АннулироватьВх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ЗапроситьАннулированиеВх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПринятьКУчетуВх",  ЗначениеПоУмолчанию);
	Соответствие.Вставить("Исходящие", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ПодписатьИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ОтправитьИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ОтозватьИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ЗапроситьАннулированиеИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("АннулироватьИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ОтклоненныеИсх", ЗначениеПоУмолчанию);
	Соответствие.Вставить("Обработанные", ЗначениеПоУмолчанию);
	Соответствие.Вставить("Приглашения", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ИсходящиеПригл", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ВходящиеПригл", ЗначениеПоУмолчанию);
	Соответствие.Вставить("ОбработанныеПригл", ЗначениеПоУмолчанию);
	
	Возврат Соответствие;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоответствиеДействияРаздела(Раздел = Неопределено)
	
	Соответствие = СоответствияРазделовШаблон(Новый Массив);
	Соответствие.Вставить("ПринятьВх", МассивПринятьВх());
	Соответствие.Вставить("ПодписатьВх", МассивПодписатьВх());
	Соответствие.Вставить("АннулироватьВх", МассивАннулировать());
	Соответствие.Вставить("ЗапроситьАннулированиеВх", МассивЗапроситьАннулирование());
	Соответствие.Вставить("ОтозватьИсх", МассивОтозватьИсх());
	Соответствие.Вставить("ЗапроситьАннулированиеИсх", МассивЗапроситьАннулирование());
	Соответствие.Вставить("АннулироватьИсх", МассивАннулировать());
	Соответствие.Вставить("ПодписатьИсх", МассивПодписатьИсх());
	Соответствие.Вставить("ОтправитьИсх", МассивОтправитьИсх());
	
	Возврат ?(Раздел = Неопределено, Соответствие, Соответствие.Получить(Раздел));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоответствиеСтатусыРаздела(Раздел = Неопределено)
	
	Соответствие = СоответствияРазделовШаблон(Новый Массив);
	Соответствие.Вставить("Черновики", МассивЧерновики());
	Соответствие.Вставить("ОтклоненныеИсх", МассивОтклоненные());
	
	Возврат ?(Раздел = Неопределено, Соответствие, Соответствие.Получить(Раздел));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоответствиеЕстьОтборПоНеПринятымКУчету(Раздел = Неопределено)
	
	Соответствие = СоответствияРазделовШаблон(Ложь);
	Соответствие.Вставить("ПринятьКУчетуВх",  Истина);
	
	Возврат ?(Раздел = Неопределено, Соответствие, Соответствие.Получить(Раздел));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СоответствиеЕстьОтборПоЗавершенным(Раздел = Неопределено)
	
	Соответствие = СоответствияРазделовШаблон(Ложь);
	Соответствие.Вставить("Обработанные", Истина);
	
	Возврат ?(Раздел = Неопределено, Соответствие, Соответствие.Получить(Раздел));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазделыЗапрещеноМножественноеВыделение()
	Массив = Новый Массив;
	Массив.Добавить("ПринятьКУчетуВх");
	Массив.Добавить("Черновики");
	Возврат Массив;
КонецФункции

