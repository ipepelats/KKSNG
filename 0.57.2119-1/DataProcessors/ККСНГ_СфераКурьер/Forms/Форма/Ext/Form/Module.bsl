&НаКлиенте
Процедура ПоказатьКомандыРаздела(Знач Раздел)
	
	КомандыРазделов = Новый Соответствие();
	КомандыРазделов.Вставить("КОтправке", "");
	КомандыРазделов.Вставить("ПодписатьИОтправить", "ДокументыКОтправкеПодписатьИОтправить, ДокументыКОтправкеГруппаНеструктурированные, ДокументыКОтправкеОтправитьФайлы, ДокументыКОтправкеОтправитьНеструктурированныйДокумент" + ?(ДоступнаРаботаСЧерновиками, ", ДокументыКОтправкеОтправитьБезПодписи", ""));
	КомандыРазделов.Вставить("ПодписатьИОтправитьУВХД", "ДокументыКОтправкеПодписатьИОтправить, ДокументыКОтправкеГруппаНеструктурированные, ДокументыКОтправкеОтправитьФайлы"+ ?(ДоступнаРаботаСЧерновиками, ", ДокументыКОтправкеОтправитьБезПодписи", ""));
	КомандыРазделов.Вставить("ПодписатьКвитанции", "ДокументыСКвитанциямиПодписатьКвитанции");
	КомандыРазделов.Вставить("Входящие", "");
	КомандыРазделов.Вставить("ПринятьВх", "КурьерAccept");
	КомандыРазделов.Вставить("ПодписатьВх", "КурьерAcceptWithTicketNoDisaccordSign, КурьерAcceptWithTicketDisaccordSign");
	КомандыРазделов.Вставить("АннулироватьВх", "КурьерAcceptAvoidance, КурьерRejectAvoidance");
	КомандыРазделов.Вставить("ЗапроситьАннулированиеВх", "КурьерAvoidanceRequest");
	КомандыРазделов.Вставить("ПринятьКУчетуВх", "ВходящиеДокументыПринятьКУчетуВх, ВходящиеДокументыОткрытьРанееУчтенныйВх");
	КомандыРазделов.Вставить("Исходящие", "");
	КомандыРазделов.Вставить("ОтозватьИсх", "КурьерRevoke");
	КомандыРазделов.Вставить("ЗапроситьАннулированиеИсх", "КурьерAvoidanceRequestOut");
	КомандыРазделов.Вставить("АннулироватьИсх", "КурьерAcceptAvoidanceOut, КурьерRejectAvoidanceOut");
	КомандыРазделов.Вставить("ОтклоненныеИсх", "");
	КомандыРазделов.Вставить("Обработанные", "");
	
	Если ДоступнаРаботаСПриглашениями Тогда
		КомандыРазделов.Вставить("Приглашения", "");
		КомандыРазделов.Вставить("ИсходящиеПригл", "ПриглашенияОтозвать, ПриглашенияОтправить");
		КомандыРазделов.Вставить("ВходящиеПригл", "ПриглашенияПринять, ПриглашенияОтклонить");
		КомандыРазделов.Вставить("ОбработанныеПригл", "");
	КонецЕсли;
	
	Если ДоступнаРаботаСЧерновиками Тогда
	 	КомандыРазделов.Вставить("Черновики", "");
		КомандыРазделов.Вставить("ПодписатьИсх", "КурьерИсхSign");
		КомандыРазделов.Вставить("ОтправитьИсх", "КурьерSend");
	КонецЕсли;
	
	ЭлементыКоманд = Новый Соответствие();
	ЭлементыКоманд.Вставить("ДокументыКОтправкеПодписатьИОтправить", Элементы.ДокументыКОтправкеПодписатьИОтправить);
	ЭлементыКоманд.Вставить("ДокументыКОтправкеГруппаНеструктурированные", Элементы.ДокументыКОтправкеГруппаНеструктурированные);
	ЭлементыКоманд.Вставить("ДокументыКОтправкеОтправитьФайлы", Элементы.ДокументыКОтправкеОтправитьФайлы);
	ЭлементыКоманд.Вставить("ДокументыКОтправкеОтправитьНеструктурированныйДокумент", Элементы.ДокументыКОтправкеОтправитьНеструктурированныйДокумент);
	ЭлементыКоманд.Вставить("ДокументыСКвитанциямиПодписатьКвитанции", Элементы.ДокументыСКвитанциямиПодписатьКвитанции);
	ЭлементыКоманд.Вставить("КурьерRevoke", Элементы.КурьерRevoke);
	ЭлементыКоманд.Вставить("КурьерAccept", Элементы.КурьерAccept);
	ЭлементыКоманд.Вставить("КурьерAcceptWithTicketNoDisaccordSign", Элементы.КурьерAcceptWithTicketNoDisaccordSign);
	ЭлементыКоманд.Вставить("КурьерAcceptWithTicketDisaccordSign", Элементы.КурьерAcceptWithTicketDisaccordSign);
	ЭлементыКоманд.Вставить("КурьерSign", Элементы.КурьерSign);
	ЭлементыКоманд.Вставить("КурьерSend", Элементы.КурьерSend);
	ЭлементыКоманд.Вставить("ВходящиеДокументыПринятьКУчетуВх", Элементы.ВходящиеДокументыПринятьКУчетуВх);
	ЭлементыКоманд.Вставить("ВходящиеДокументыОткрытьРанееУчтенныйВх", Элементы.ВходящиеДокументыОткрытьРанееУчтенныйВх);
	ЭлементыКоманд.Вставить("КурьерReject", Элементы.КурьерReject);
	ЭлементыКоманд.Вставить("КурьерRejectWithTicket", Элементы.КурьерRejectWithTicket);
	
	Если ДоступнаРаботаСПриглашениями Тогда
		ЭлементыКоманд.Вставить("ПриглашенияОтправить", Элементы.ПригласитьКонтрагентов);
		ЭлементыКоманд.Вставить("ПриглашенияОтозвать", Элементы.ОтозватьПриглашения);
		ЭлементыКоманд.Вставить("ПриглашенияПринять", Элементы.ПринятьПриглашения);
		ЭлементыКоманд.Вставить("ПриглашенияОтклонить", Элементы.ОтклонитьПриглашения);
	КонецЕсли;
	
	ЭлементыКоманд.Вставить("ДокументыКОтправкеОтправитьБезПодписи", Элементы.ДокументыКОтправкеОтправитьБезПодписи);
	ЭлементыКоманд.Вставить("КурьерИсхSign", Элементы.КурьерИсхSign);
	ЭлементыКоманд.Вставить("КурьерAvoidanceRequest", Элементы.КурьерAvoidanceRequest);
	ЭлементыКоманд.Вставить("КурьерAcceptAvoidance", Элементы.КурьерAcceptAvoidance);
	ЭлементыКоманд.Вставить("КурьерRejectAvoidance", Элементы.КурьерRejectAvoidance);
	ЭлементыКоманд.Вставить("КурьерAvoidanceRequestOut", Элементы.КурьерAvoidanceRequestOut);
	ЭлементыКоманд.Вставить("КурьерAcceptAvoidanceOut", Элементы.КурьерAcceptAvoidanceOut);
	ЭлементыКоманд.Вставить("КурьерRejectAvoidanceOut", Элементы.КурьерRejectAvoidanceOut);
	
	КомандыРаздела = СтрРазделить(КомандыРазделов.Получить(Раздел), ", ", Ложь);
	
	Для каждого КлючЗначение Из ЭлементыКоманд Цикл
		
		ИмяКоманды = КлючЗначение.Ключ;
		ЭлементФормы = КлючЗначение.Значение;
		КомандаНайдена = Не КомандыРаздела.Найти(ИмяКоманды) = Неопределено;
		КомандаДоступна = Истина;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ЭлементФормы.Имя, "Видимость", КомандаНайдена И КомандаДоступна);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСписокРаздела(Знач Раздел)
	ПоказатьСтраницуРаздела(Раздел);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтраницуРаздела(Знач Раздел)
	
	ИмяСтраницы = СтраницаРаздела(Раздел);
	
	Если ЗначениеЗаполнено(ИмяСтраницы) Тогда
		Элементы.ГруппаРазделов.ТекущаяСтраница = Элементы[ИмяСтраницы];
		УстановитьРазрешениеМножественногоВыделения(Раздел);
	КонецЕсли;
	
	Если Элементы.ГруппаРазделов.ТекущаяСтраница = Элементы.ГруппаВходящиеДокументы Тогда
		ВходящиеДокументыОбработатьАктивизациюСтроки();
	ИначеЕсли Элементы.ГруппаРазделов.ТекущаяСтраница = Элементы.ГруппаИсходящиеДокументы Тогда
		ИсходящиеДокументыОбработатьАктивизациюСтроки();
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсходящиеДокументыОбработатьАктивизациюСтроки()
	
	ТекДанные = Элементы.ИсходящиеДокументы.ТекущиеДанные;
	
	Если ТекущийРаздел = "Черновики" И НЕ ТекДанные = Неопределено Тогда
		
		МассивДействий = "Sign,Send";
		
		ДействияДокумента = ККСНГ_ЭлектронныеДокументыВызовСервера.ДоступностьДействийДокумента(ТекДанные.Ссылка, МассивДействий);
		
		Элементы.КурьерИсхSign.Видимость = ДействияДокумента.Получить("Sign");
		Элементы.КурьерSend.Видимость = ДействияДокумента.Получить("Send");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВходящиеДокументыОбработатьАктивизациюСтроки()
	
	ТекущиеДанные = Элементы.ВходящиеДокументы.ТекущиеДанные;
	Если Не ТекущийРаздел = "ПринятьКУчетуВх" Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуКлиент");
	ЗапросДоступностиПринятияКУчету = ОбщийМодульПринятиеКУчету.ПринятиеКУчетуДоступно(ТекущиеДанные.Ссылка, ТекущиеДанные.DocumentTypeCode);
	Если ЗапросДоступностиПринятияКУчету.Успех Тогда
		ПринятиеКУчетуДоступно = ЗапросДоступностиПринятияКУчету.Результат;
	Иначе
		ПринятиеКУчетуДоступно = Ложь;
		ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ЗапросДоступностиПринятияКУчету.Журнал, "-1");
	КонецЕсли;
	
	Элементы.ВходящиеДокументыПринятьКУчетуВх.Видимость = ПринятиеКУчетуДоступно;
	 
КонецПроцедуры

&НаКлиенте
Функция СтраницаРаздела(Знач Раздел)
	
	Страница = Неопределено;
	
	СтраницыРазделов = Новый Соответствие;
	СтраницыРазделов.Вставить("КОтправке", "ГруппаДокументыКОтправке");
	СтраницыРазделов.Вставить("ПодписатьИОтправить", "ГруппаДокументыКОтправке");
	СтраницыРазделов.Вставить("ПодписатьИОтправитьУВХД", "ГруппаДокументыКОтправке");
	
	СтраницыРазделов.Вставить("ПодписатьКвитанции", "ГруппаПодписатьКвитанции");
	
	СтраницыРазделов.Вставить("Входящие", "ГруппаВходящиеДокументы");
	СтраницыРазделов.Вставить("ПринятьВх", "ГруппаВходящиеДокументы");
	СтраницыРазделов.Вставить("ПодписатьВх", "ГруппаВходящиеДокументы");
	СтраницыРазделов.Вставить("АннулироватьВх", "ГруппаВходящиеДокументы");
	СтраницыРазделов.Вставить("ЗапроситьАннулированиеВх", "ГруппаВходящиеДокументы");
	СтраницыРазделов.Вставить("ПринятьКУчетуВх", "ГруппаВходящиеДокументы");
	
	СтраницыРазделов.Вставить("Исходящие", "ГруппаИсходящиеДокументы");
	СтраницыРазделов.Вставить("ОтозватьИсх", "ГруппаИсходящиеДокументы");
	СтраницыРазделов.Вставить("ЗапроситьАннулированиеИсх", "ГруппаИсходящиеДокументы");
	СтраницыРазделов.Вставить("АннулироватьИсх", "ГруппаИсходящиеДокументы");
	СтраницыРазделов.Вставить("ОтклоненныеИсх", "ГруппаИсходящиеДокументы");
	
	СтраницыРазделов.Вставить("Обработанные", "ГруппаОбработанныеДокументы");
	
	Если ДоступнаРаботаСПриглашениями Тогда
		СтраницыРазделов.Вставить("Приглашения", "ГруппаПриглашения");
		СтраницыРазделов.Вставить("ИсходящиеПригл", "ГруппаИсходящиеПриглашения");
		СтраницыРазделов.Вставить("ВходящиеПригл", "ГруппаВходящиеПриглашения");
		СтраницыРазделов.Вставить("ОбработанныеПригл", "ГруппаПриглашения");
	КонецЕсли;
	
	Если ДоступнаРаботаСЧерновиками Тогда
		СтраницыРазделов.Вставить("Черновики", "ГруппаИсходящиеДокументы");
		СтраницыРазделов.Вставить("ПодписатьИсх", "ГруппаИсходящиеДокументы");
		СтраницыРазделов.Вставить("ОтправитьИсх", "ГруппаИсходящиеДокументы");
	КонецЕсли;
	
	Страница = СтраницыРазделов.Получить(Раздел);

	Если ЗначениеЗаполнено(Страница) Тогда
		Страница = СтраницыРазделов.Получить(Раздел);
	КонецЕсли;
	
	Возврат Страница;
	
КонецФункции

&НаКлиенте
Процедура УстановитьРазрешениеМножественногоВыделения(Раздел)
	
	ЗапрещенныеРазделы = РазделыЗапрещеноМножественноеВыделение();
	ИмяТаблицы = ПолучитьИмяТаблицыРаздела(Раздел);
	Если Не ИмяТаблицы = Неопределено Тогда
		РазделЗапрещен = Не ЗапрещенныеРазделы.Найти(Раздел) = Неопределено;
		Если РазделЗапрещен Тогда
			Элементы[ИмяТаблицы].РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		Иначе
			Элементы[ИмяТаблицы].РежимВыделения = РежимВыделенияТаблицы.Множественный;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиПрофиляЭДОДляСписковДокументов()

	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыКОтправке,
																				"ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыСКвитанциями,
																				"ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсходящиеДокументы,
																				"ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы,
																				"ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ОбработанныеДокументы,
																				"ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуОшибокНаКлиенте(Журнал)

	ДанныеОшибок = Новый Массив;
	ЗаполнитьТаблицуОшибокНаСервере(Журнал, ДанныеОшибок, ПрофильНастройкиЭДО);
	
	Для каждого СтрокаДанных Из ДанныеОшибок Цикл
		НоваяСтрока = ТаблицаОшибок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.Обработать = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьТаблицуОшибокНаСервере(Журнал, ДанныеОшибок, ПрофильНастройкиЭДО)

	Для Каждого Сообщение Из Журнал Цикл
		Если ТипЗнч(Сообщение) = Тип("Массив") Тогда
			ЗаполнитьТаблицуОшибокНаСервере(Сообщение, ДанныеОшибок, ПрофильНастройкиЭДО);
		ИначеЕсли ТипЗнч(Сообщение) = Тип("Структура") Тогда
			Если Строка(Сообщение.Статус) = "-1" И ЗначениеЗаполнено(Сообщение.КодОшибки) Тогда
				
				ОтветПоОшибке = ККСНГ_ЛогированиеВызовСервера.ПолучитьСтруктуруИнформацииОбОшибкеПриОтправкеДокумента();
				
				ККСНГ_ЛогированиеВызовСервера.ИнициализироватьДанныеОшибки(ОтветПоОшибке, Сообщение, ПрофильНастройкиЭДО);
				
				ДанныеОшибок.Добавить(ОтветПоОшибке);
				
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЛогаОшибокЗавершение(Результат, ДопДанные) Экспорт

	АдресТаблицыОшибок = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("АдресТаблицыОшибок", АдресТаблицыОшибок) Тогда
		
		Если НЕ ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен профиль организации.", , "ПрофильНастройкиЭДО");
			Возврат;
		КонецЕсли;
		
		ТекстСсылки = ОбработатьВыбранныеОшибкиНаСервере(АдресТаблицыОшибок, ПрофильНастройкиЭДО);
		
		Если НЕ ТекстСсылки = Неопределено Тогда
			
		    ЗапуститьПриложение(ТекстСсылки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьВыбранныеОшибкиНаСервере(АдресТаблицыОшибок, ПрофильНастройкиЭДО)

	Если НЕ АдресТаблицыОшибок = Неопределено Тогда
	
		ТаблицаОшибок = ПолучитьИзВременногоХранилища(АдресТаблицыОшибок);
		
		ИтоговаяИнформацияПоОшибкам = ИтоговаяИнформацияПоОшибкам(ТаблицаОшибок);
		
		ТемаПисьма = "Ошибка при отправке и подписании документов от " + ПрофильНастройкиЭДО.Наименование
			+ "(" + ПрофильНастройкиЭДО.КодУчастникаЭДО + ")";
		ТекстПисьма = "Добрый день, при попытке отправить документы из Интеграционного модуля ЭДО 1С, возникли следующие ошибки:";
		
		ТекстПисьма = ТекстПисьма + Символы.ПС + Символы.ПС + ИтоговаяИнформацияПоОшибкам;
		
		ОпределениеКонфигурации = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ОпределениеКонфигурации();
		НаименованиеВерсииМодуля = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.НаименованиеВерсииМодуля();
		Конфигурация = "Конфигурация: " + ОпределениеКонфигурации.Синоним + ",версия " + ОпределениеКонфигурации.Версия;
		
		ТекстПисьма = ТекстПисьма + Символы.ПС + Символы.ПС + Конфигурация + Символы.ПС + НаименованиеВерсииМодуля;
		ТекстПисьма = ТекстПисьма + Символы.ПС + Символы.ПС + "Так же прикладываю файл с описанием логов.";
		
		ТемаПисьмаURL = КодироватьСтроку(ТемаПисьма, СпособКодированияСтроки.КодировкаURL);
		ТекстПисьмаURL = КодироватьСтроку(ТекстПисьма, СпособКодированияСтроки.КодировкаURL);
		
		ТестовыйРежим = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТестовыйРежим();
		Если ТестовыйРежим Тогда
			Емейл = "intpro@esphere.ru";
		Иначе
			Емейл = "1C_hd@esphere.ru";
		КонецЕсли;
		
		ТекстСсылки = "mailto:" + Емейл + "?subject=%ТемаПисьмаURL%&body=%ТекстПисьмаURL%";
		ТекстСсылки = СтрЗаменить(ТекстСсылки, "%ТемаПисьмаURL%", ТемаПисьмаURL);
		ТекстСсылки = СтрЗаменить(ТекстСсылки, "%ТекстПисьмаURL%", ТекстПисьмаURL);
		
		Возврат ТекстСсылки;
		
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ИтоговаяИнформацияПоОшибкам(Таблица)

	Результат = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.ИННПолучателя КАК ИННПолучателя,
	|	Таблица.ТипДокумента КАК ТипДокумента,
	|	Таблица.ОтветСервера КАК ОтветСервера,
	|	Таблица.ТекстСообщенияБезДокумента КАК ТекстСообщенияБезДокумента
	|ПОМЕСТИТЬ Ошибки
	|ИЗ
	|	&ТаблицаОшибок КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ошибки.ИННПолучателя КАК ИННПолучателя,
	|	Ошибки.ТипДокумента КАК ТипДокумента,
	|	Ошибки.ОтветСервера КАК ОтветСервера
	|ИЗ
	|	Ошибки КАК Ошибки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ошибки.ОтветСервера КАК ОтветСервера,
	|	Ошибки.ТекстСообщенияБезДокумента КАК ТекстСообщенияБезДокумента
	|ИЗ
	|	Ошибки КАК Ошибки";
	Запрос.УстановитьПараметр("ТаблицаОшибок", Таблица);

	ПакетЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаПоОшибкам = ПакетЗапроса[1].Выбрать();
	ВыборкаРасшифровкаОшибок = ПакетЗапроса[2].Выбрать();
	
	Пока ВыборкаПоОшибкам.Следующий() Цикл
		Результат = Результат + "Получатель ИНН " + ВыборкаПоОшибкам.ИННПолучателя + ", тип: " + ВыборкаПоОшибкам.ТипДокумента + ", ответ: "
					+ ВыборкаПоОшибкам.ОтветСервера + Символы.ПС;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОчиститьИСкрытьТаблицуОшибок()

	Элементы.СообщениеОбОшибке.Видимость = Ложь;
	ТаблицаОшибок.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура НачатьОтправкуДокументов(ПодписатьДанные)
	
	Если Не ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен профиль организации.", , "ПрофильНастройкиЭДО");
		Возврат;
	КонецЕсли;
	
	ДанныеКОтправке = Новый Массив();
	
	Если Не БизнесПроцессРаздела = "УВХД" Тогда
		ДанныеКОтправкеУВХД = Новый Массив();
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.ДокументыКОтправке.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.ДокументыКОтправке.ДанныеСтроки(ИдентификаторСтроки);
		
		СтруктураДанныеОтправки = Новый Структура();
		СтруктураДанныеОтправки.Вставить("Ссылка", ДанныеСтроки.Ссылка);
		СтруктураДанныеОтправки.Вставить("Контрагент", ДанныеСтроки.Контрагент);
		
		Если БизнесПроцессРаздела = "УВХД" Тогда
			
			ДанныеПоиска = Новый Структура("Договор", ДанныеСтроки.ДоговорКонтрагента);
			ДоговорСопоставлен = СопоставленияДоговоров.НайтиСтроки(ДанныеПоиска).Количество();
			Если Не ДоговорСопоставлен Тогда
				Продолжить;
			КонецЕсли;
			СтруктураДанныеОтправки.Вставить("ДоговорСопоставлен", ДоговорСопоставлен);
			
		ИначеЕсли ДанныеСтроки.ЭтоКонтрагентСбер И ДанныеСтроки.ДоступенПоУВХД Тогда
			ДанныеКОтправкеУВХД.Добавить(ДанныеСтроки.Ссылка);
		КонецЕсли;
		
		ДанныеКОтправке.Добавить(СтруктураДанныеОтправки);
		
	КонецЦикла;
	
	Если Не БизнесПроцессРаздела = "УВХД" И ДанныеКОтправкеУВХД.Количество() Тогда
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ДанныеКОтправке", ДанныеКОтправке);
		ПараметрыОповещения.Вставить("ПодписатьДанные", ПодписатьДанные);
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ПослеЗакрытияВопросаПроверитьДокументыПоПроцессуУВХД", ЭтотОбъект, ПараметрыОповещения);
		ТекстВопроса = "Возможно, некоторые документы требуется отправить по процессу ""ЭДО с поставщиками"".
		|Для этого необходимо переключиться в соответствуюй раздел ""ЭДО с поставщиками"" в дереве.
		|Продолжить отправку документов по обычному процессу?";
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыОтправки = Новый Структура();
	ПараметрыОтправки.Вставить("ПодписатьДанные", ПодписатьДанные);
	ПродолжитьОтправкуДокументов(ДанныеКОтправке, ПараметрыОтправки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтправкуДокументов(ДанныеКОтправке, ДопПараметры = Неопределено)
	
	Если ДанныеКОтправке.Количество() > 0 Тогда
		
		ПараметрыОтправки = Новый Структура;
		ПараметрыОтправки.Вставить("ДанныеКОтправке", ДанныеКОтправке);
		ПараметрыОтправки.Вставить("ПодписатьДанные", ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ПодписатьДанные", Ложь));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьПодписание", ЭтотОбъект, ПараметрыОтправки);
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ОписаниеОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСлужебныеРеквизитыФормы()
	
	ДоступнаРаботаСПриглашениями = ПравоДоступа("Чтение", Метаданные.НайтиПоПолномуИмени("Справочник.Контрагенты"));
	ДоступнаРаботаСЧерновиками = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ИспользуетсяОтправкаЧерновиков();
	ДоступнаРаботаПоБизнесПроцессуУВХД = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ИспользуетсяБизнесПроцессУВХД();
	
КонецПроцедуры

#Область ЭлектронныйДокумент

&НаКлиенте
Процедура ПодписатьИОтправитьЭлектронныеДокументыЗавершение(Результат, ДопПараметры) Экспорт
	
	ОчиститьИСкрытьТаблицуОшибок();
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если ТипЗнч(ДопПараметры) = Тип("Массив") Тогда

			Если ДопПараметры.Количество() Тогда
				
				Для Каждого Элем Из ДопПараметры Цикл
					МассивОтправленныхДокументов.Добавить(Элем);
				КонецЦикла;

				ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "Ссылка",
						МассивОтправленныхДокументов.ВыгрузитьЗначения(), ВидСравненияКомпоновкиДанных.НеВСписке, , Истина);
				
			КонецЕсли;
			
		КонецЕсли;

		Элементы.ДокументыКОтправке.ВыделенныеСтроки.Очистить();
		Элементы.ДокументыКОтправке.Обновить();

		ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(Результат.Журнал, "-1");
		
		ЗаполнитьТаблицуОшибокНаКлиенте(Результат.Журнал);
		Элементы.СообщениеОбОшибке.Видимость = ТаблицаОшибок.Количество() > 0;
		
	КонецЕсли;

	//УстановитьНастройкиПрофиляЭДО();
		
КонецПроцедуры

#КонецОбласти

#Область РаботаСПодпиской

&НаКлиенте
Процедура ОбновитьСостояниеКнопкиОбновления(ИдетОбновление = Ложь)

	Если ИдетОбновление Тогда
		Элементы.ОбновитьДанныеКурьер.Картинка = БиблиотекаКартинок.ККСНГ_СинхронизироватьАнимированная;
		Элементы.ОбновитьДанныеКурьер.Заголовок = "Идет обновление...";
	Иначе
		Элементы.ОбновитьДанныеКурьер.Картинка = БиблиотекаКартинок.ККСНГ_Синхронизировать;
		Элементы.ОбновитьДанныеКурьер.Заголовок = "Обновить данные сервиса";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьДанныеКурьераВФоне(ПрофильНастройкиЭДО, ЗаданияОбновленияИзПодписок, УникальныйИдентификатор, ПараметрыАвторизации)

	Если ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда

		КодУчастникаЭДО = ПрофильНастройкиЭДО.КодУчастникаЭДО;

		// Проверим, есть ли уже запущенное задание
		ТекущееЗадание = ЗаданияОбновленияИзПодписок.НайтиПоЗначению(ПрофильНастройкиЭДО);
		Если ТекущееЗадание <> Неопределено Тогда
			Если ТекущееЗадание.Пометка Тогда
				ЗаданияОбновленияИзПодписок.Удалить(ТекущееЗадание);
			Иначе
				Возврат СтрРазделить(ТекущееЗадание.Представление, "|")[0];
			КонецЕсли;
		КонецЕсли;

		КлючФЗ = "ОбновлениеПодписки_" + КодУчастникаЭДО;
		ДанныеФЗ = ДанныеЗапущенногоЗаданияОбработкиСобытий(КлючФЗ);
		Если ДанныеФЗ = Неопределено Тогда
			
			АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

			ПараметрыФЗ = Новый Массив;
			ПараметрыФЗ.Добавить(ПрофильНастройкиЭДО);
			ПараметрыФЗ.Добавить(АдресХранилища);
			ПараметрыФЗ.Добавить(ПараметрыАвторизации);
			
			ИмяМетодаФЗ = "ККСНГ_Подписки.ПолучитьИОбработатьСобытияИзСфераКурьер";
			ОписаниеФЗ = "Обновление событий по подписке " + КодУчастникаЭДО;
			
			ИдентификаторЗаданияОбновленияПодписки = ККСНГ_ОбщегоНазначенияВызовСервера.ВыполнитьФоновоеЗадание(ИмяМетодаФЗ, ПараметрыФЗ, КлючФЗ, ОписаниеФЗ);
		
		Иначе
		    ИдентификаторЗаданияОбновленияПодписки = ДанныеФЗ.ИДЗадания;
			АдресХранилища = ДанныеФЗ.АдресХранилища;
		КонецЕсли;
				
		ЗаданияОбновленияИзПодписок.Добавить(ПрофильНастройкиЭДО, "" + ИдентификаторЗаданияОбновленияПодписки + "|" + АдресХранилища);

		Возврат ИдентификаторЗаданияОбновленияПодписки;

	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ПродолжитьОбновлениеПодписки(ПараметрыАвторизации, ДопПараметры) Экспорт

	ИдентификаторФЗ = ОбновитьДанныеКурьераВФоне(ПрофильНастройкиЭДО, ЗаданияОбновленияИзПодписок, УникальныйИдентификатор, ПараметрыАвторизации);
	
	Если ЗначениеЗаполнено(ИдентификаторФЗ) Тогда
		ОбновитьСостояниеКнопкиОбновления(Истина);
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеФоновогоЗадания", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеЗапущенногоЗаданияОбработкиСобытий(Ключ)
	
	Перем АктивноеЗадание, ДанныеЗадания, ИДАктивногоЗадания, ОтборФоновогоЗадания, ПодходящиеЗадания;
	Перем СообщенияЗадания, СообщениеЗадания, ТекстСообщения;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеЗадания = Неопределено;
	ОтборФоновогоЗадания = Новый Структура;
	ОтборФоновогоЗадания.Вставить("Ключ", Ключ);
	ОтборФоновогоЗадания.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	ПодходящиеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФоновогоЗадания);
	
	Если ПодходящиеЗадания.Количество() > 0 Тогда
		
		АктивноеЗадание = ПодходящиеЗадания[0];
		ДанныеЗадания = Новый Структура("ИДЗадания,АдресХранилища");
		ИДАктивногоЗадания = АктивноеЗадание.УникальныйИдентификатор;
		ДанныеЗадания.ИДЗадания = ИДАктивногоЗадания;
		СообщенияЗадания = АктивноеЗадание.ПолучитьСообщенияПользователю(Ложь);
		
		Для каждого СообщениеЗадания Из СообщенияЗадания Цикл
			ТекстСообщения = СообщениеЗадания.Текст;
			Если ЭтоАдресВременногоХранилища(ТекстСообщения) Тогда
				ДанныеЗадания.АдресХранилища = ТекстСообщения;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДанныеЗадания;

КонецФункции

&НаСервереБезКонтекста
Функция ОбновитьСостояниеФоновыхЗаданий(ЗаданияОбновленияИзПодписок)

	СоответствиеРезультатов = Новый Соответствие;

	Для Каждого Задание Из ЗаданияОбновленияИзПодписок Цикл

		ДанныеЗадания = СтрРазделить(Задание.Представление, "|");
		Если ДанныеЗадания.ВГраница() > 0 Тогда
			ИдентификаторЗаданияОбновленияПодписки = ДанныеЗадания[0];
			АдресХранилища = ДанныеЗадания[1];
		Иначе
			Задание.Пометка = Истина;
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ИдентификаторЗаданияОбновленияПодписки) Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатВыполнения = ККСНГ_ОбщегоНазначенияВызовСервера.РезультатВыполненияФоновогоЗадания(ИдентификаторЗаданияОбновленияПодписки);
		Если Не РезультатВыполнения.Завершено Тогда
			Продолжить;
		КонецЕсли;
		
		// Ставим пометку
		Задание.Пометка = Истина;

		Если РезультатВыполнения.ОписаниеОшибки = Неопределено Тогда
			Если ЗначениеЗаполнено(АдресХранилища) Тогда
				Ответ = ПолучитьИзВременногоХранилища(АдресХранилища);
				
				// Очищаем хранилище
				УдалитьИзВременногоХранилища(АдресХранилища);
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
			ОписаниеОшибки = "Обновление документооборота завершено с ошибками: " + РезультатВыполнения.ОписаниеОшибки;
			ККСНГ_ЛогированиеКлиентСервер.ДобавитьОшибку(Ответ.Журнал, ОписаниеОшибки, "BJ-00001");
		КонецЕсли;
		СоответствиеРезультатов.Вставить(Задание.Значение, Ответ);
		
	КонецЦикла;

	Возврат СоответствиеРезультатов;
КонецФункции

&НаКлиенте
Процедура ПроверитьЗавершениеФоновогоЗадания() Экспорт

	Если ЗаданияОбновленияИзПодписок.Количество() Тогда
		
		СоответствиеРезультатов = ОбновитьСостояниеФоновыхЗаданий(ЗаданияОбновленияИзПодписок);

		Для Каждого Результат Из СоответствиеРезультатов Цикл
			
			ЖурналВыполнения = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат.Значение, "Журнал");
			
			Если ЖурналВыполнения = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КодОшибкиАвторизации = "AU-00002";
			ОшибкаВыполнения = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ЖурналВыполнения, КодОшибкиАвторизации);
			
			Если ОшибкаВыполнения <> Неопределено И ОшибкаВыполнения.КодОшибки = КодОшибкиАвторизации Тогда
				
				ПараметрыАвторизации = Новый Структура("НеобходимаПереинициализация", Истина);
				ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(Результат.Ключ, ПараметрыАвторизации);

				Если Результат.Ключ = ПрофильНастройкиЭДО Тогда
					ККСНГ_ЛогированиеКлиентСервер.ВывестиСообщениеПользователю(ОшибкаВыполнения);
				КонецЕсли;
				
			КонецЕсли;
			
			Если Результат.Ключ <> ПрофильНастройкиЭДО Тогда
				Продолжить;
			КонецЕсли;
			
			// Выводим "нужные" сообщения об ошибках: пока что ошибки подписок и фоновых заданий.
			КодыВыводимыхОшибок = СтрРазделить("SC-00001,BJ-00001", ",", Ложь);
			
			Для Каждого КодОшибки Из КодыВыводимыхОшибок Цикл
				
				ОшибкаПоКоду = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ЖурналВыполнения, КодОшибки);
				
				Если ОшибкаПоКоду <> Неопределено И ОшибкаПоКоду.КодОшибки = КодОшибки Тогда
					ККСНГ_ЛогированиеКлиентСервер.ВывестиСообщениеПользователю(ОшибкаПоКоду);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;

	ЗаданияКУдалению = Новый Массив;

	Для Каждого Задание Из ЗаданияОбновленияИзПодписок Цикл
		
		Если Задание.Пометка Тогда
			ЗаданияКУдалению.Добавить(Задание);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Задание Из ЗаданияКУдалению Цикл
		ЗаданияОбновленияИзПодписок.Удалить(Задание);
	КонецЦикла;

	Если ЗаданияОбновленияИзПодписок.Количество() Тогда

		ОбновитьСостояниеКнопкиОбновления(Истина);
		
		// Продолжаем наблюдения
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеФоновогоЗадания", 15, Истина);
		
	Иначе

		// Оповещаем пользователя и обновляем списки когда завершены все задания
		ОповеститьОбИзменении(Тип("СправочникСсылка.ККСНГ_ЭлектронныеДокументы"));
		ОповеститьОбИзменении(Тип("СправочникСсылка.ККСНГ_ПрисоединенныеФайлы"));
		ОповеститьОбИзменении(Тип("СправочникСсылка.ККСНГ_Квитанции"));

		Элементы.ДокументыКОтправке.Обновить();
		Элементы.ВходящиеДокументы.Обновить();
		Элементы.ИсходящиеДокументы.Обновить();
		
		ОбновитьСчетчикиРазделовДокументов();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Обновление

&НаКлиенте
Процедура ПроверитьОбновление()

	ИдентификаторЗаданияПроверкиОбновления = ВыполнитьПроверкуОбновленияВФоне();
	Если ЗначениеЗаполнено(ИдентификаторЗаданияПроверкиОбновления) Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеПроверкиОбновления", 5, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВыполнитьПроверкуОбновленияВФоне()

	ИдентификаторЗаданияПроверкиОбновления = Неопределено;
	
	АдресХранилищаПроверкиОбновления = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыФЗ = Новый Массив;
	ПараметрыФЗ.Добавить(АдресХранилищаПроверкиОбновления);
	
	ИмяМетодаФЗ = "ККСНГ_ОбновлениеВызовСервера.ПроверитьНаличиеОбновленияВФоновомЗадании";
	ОписаниеФЗ = "Поиск обновлений";
	
	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(АдресХранилищаПроверкиОбновления);
	
	ИдентификаторФЗ = ККСНГ_ОбщегоНазначенияВызовСервера.ВыполнитьФоновоеЗадание(ИмяМетодаФЗ, ПараметрыФЗ, , ОписаниеФЗ);
	
	Если Не ЗначениеЗаполнено(ИдентификаторФЗ) Тогда
		УдалитьИзВременногоХранилища(АдресХранилищаПроверкиОбновления);
	КонецЕсли;

	Возврат ИдентификаторФЗ;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЗавершениеПроверкиОбновления() Экспорт
		
	Если ККСНГ_ОбщегоНазначенияВызовСервера.ЗаданиеВыполнено(ИдентификаторЗаданияПроверкиОбновления) Тогда

		Ответ = ПолучитьИзВременногоХранилища(АдресХранилищаПроверкиОбновления);
		ИдентификаторЗаданияПроверкиОбновления = "";
		АдресХранилищаПроверкиОбновления = "";
		
		Если Ответ.Успех И Ответ.Результат Тогда
			ПоказатьОповещениеПользователя("Доступна новая версия Модуля ЭДО", "e1cib/app/Обработка.ККСНГ_Обновление",
				"Перейти к обновлению", БиблиотекаКартинок.ККСНГ_Внимание, СтатусОповещенияПользователя.Важное, ЭтотОбъект.УникальныйИдентификатор);
		КонецЕсли;

	Иначе

		ПодключитьОбработчикОжидания("ПроверитьЗавершениеПроверкиОбновления", 15, Истина);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОтправкаНеструктурированногоДокумента

&НаКлиенте
Процедура ПослеАвторизацииОтправитьДокумент(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		
		ЗапросТиповДокументов = ККСНГ_ДокументооборотВызовСервера.СписокДоступныхНеструктурированныхТиповДокументов(ПараметрыАвторизации);

		Если ЗапросТиповДокументов.Успех Тогда
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
			ПараметрыОткрытия.Вставить("СписокНеструктурированныхТипов", ЗапросТиповДокументов.Результат);
			
			ОткрытьФорму("ОбщаяФорма.ККСНГ_ОтправкаПечатнойФормы", ПараметрыОткрытия);
		Иначе
			ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросТиповДокументов.Журнал);
		КонецЕсли;

	Иначе
		
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Приглашения

&НаКлиенте
Процедура ОтправкаПриглашенийЗакрытие(Результат, ДополнительныеПараметры) Экспорт
	
	Если ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ОбновитьСписокПриглашений", Ложь) Тогда
		ПослеАвторизации = Новый ОписаниеОповещения("ПолучитьСписокПриглашенийЗавершение", ЭтотОбъект, "Sender");
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ПослеАвторизации);
	КонецЕсли;
	
	Если ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ОткрытьВыборКонтрагентов", Ложь) Тогда
		ПригласитьКонтрагентов(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтклонитьПриглашенияЗавершение(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		ИДПриглашений = ДопПараметры.ИДПриглашений;
		ОтклонениеПриглашений = ККСНГ_ПриглашенияВызовСервера.ОтклонитьПриглашения(ИДПриглашений, ПрофильНастройкиЭДО, ПараметрыАвторизации);

		Если ОтклонениеПриглашений.Успех Тогда
			ПоказатьОповещениеПользователя(, , "Приглашения отклонены");
			ОбновлениеПриглашений = ККСНГ_ПриглашенияВызовСервера.ПолучитьСписокПриглашений(ПрофильНастройкиЭДО, ПараметрыАвторизации);
			ОбновитьТекущиеПриглашения("Receiver");
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ОтклонениеПриглашений.Журнал);
		КонецЕсли;
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
	//ОбновитьСчетчикиРазделовПриглашений();

КонецПроцедуры

&НаКлиенте
Функция ИДВыделенныхПриглашений(ТекущаяТаблица = Неопределено)
	
	ИДПриглашений = Новый Массив;

	Если НЕ ТекущаяТаблица = Неопределено Тогда
		Для Каждого ТекущаяСтрока Из ТекущаяТаблица Цикл
			Если ТекущаяСтрока.Обрабатывать Тогда
				ИДПриглашений.Добавить(ТекущаяСтрока.Id);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ИДПриглашений;

КонецФункции

&НаКлиенте
Процедура ОтозватьПриглашениеЗавершение(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		ИДПриглашений = ДопПараметры.ИДПриглашений;
		ОтзывПриглашений = ККСНГ_ПриглашенияВызовСервера.ОтозватьПриглашение(ИДПриглашений, ПрофильНастройкиЭДО, ПараметрыАвторизации);

		Если ОтзывПриглашений.Успех Тогда
			ПоказатьОповещениеПользователя(, , "Приглашения отозваны");
			ОбновитьТекущиеПриглашения("Sender");
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ОтзывПриглашений.Журнал);
		КонецЕсли;
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
	Элементы.ОтозватьПриглашения.Доступность = Истина;
	
	//ОбновитьСчетчикиРазделовПриглашений();

КонецПроцедуры

&НаКлиенте
Процедура ПринятьПриглашенияЗавершение(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		
		РезультатОбработки = ОбработатьДанныеПриглашенийЗарегистрированныхКонтрагентовЭДО(ДопПараметры.ИДПриглашений,
										ПараметрыАвторизации, ДопПараметры.ПрофильЭДООрганизации);
		
		Если РезультатОбработки.ИДПриглашений.Количество() > 0 Тогда
		
			ПринятиеПриглашений = ККСНГ_ПриглашенияВызовСервера.ПринятьПриглашения(РезультатОбработки.ИДПриглашений,
										ДопПараметры.ПрофильЭДООрганизации, ПараметрыАвторизации);
			
			КоличествоНовыхПрофилей = РезультатОбработки.КоличествоНовыхПрофилей;
			Если НЕ КоличествоНовыхПрофилей = 0 Тогда
				Пояснение = "Принято приглашений - " + КоличествоНовыхПрофилей;
				ПоказатьОповещениеПользователя("Обновлены статусы приглашений:", , Пояснение);
			КонецЕсли;
			
			Если ПринятиеПриглашений.Успех Тогда
				ОбновлениеПриглашений = ККСНГ_ПриглашенияВызовСервера.ПолучитьСписокПриглашений(ПрофильНастройкиЭДО, ПараметрыАвторизации);
				ОбновитьТекущиеПриглашения("Receiver");
			Иначе
				ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ПринятиеПриглашений.Журнал);
			КонецЕсли;
		
		КонецЕсли;
	
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
	//ОбновитьСчетчикиРазделовПриглашений();
	
КонецПроцедуры

&НаСервере
Функция ОбработатьДанныеПриглашенийЗарегистрированныхКонтрагентовЭДО(ИДПриглашений, ПараметрыАвторизации, ПрофильЭДООрганизации)
	
	ТаблицаПриглашений = РеквизитФормыВЗначение("ТаблицаПриглашенийПринятые");
	
	Возврат ККСНГ_ПриглашенияВызовСервера.ОбработатьДанныеПриглашенийЗарегистрированныхКонтрагентовЭДО(ИДПриглашений,
				ТаблицаПриглашений, ПараметрыАвторизации, ПрофильЭДООрганизации);
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСписокПриглашенийЗавершение(ЗапросПараметрыАвторизации, ДопПараметры = Неопределено) Экспорт

	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		ОбновлениеПриглашений = ККСНГ_ПриглашенияВызовСервера.ПолучитьСписокПриглашений(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ОбновитьТекущиеПриглашения(?(ДопПараметры = Неопределено, "", ДопПараметры));
		Если ОбновлениеПриглашений.Успех Тогда
			КоличествоНовыхПрофилей = ОбновлениеПриглашений.Результат.КоличествоНовыхПрофилей;
			КоличествоНовыхПриглашений = ОбновлениеПриглашений.Результат.КоличествоНовыхПриглашений;
			Если НЕ КоличествоНовыхПрофилей = 0 ИЛИ НЕ КоличествоНовыхПриглашений = 0 Тогда
				Пояснение = "Получено новых приглашений - " + КоличествоНовыхПриглашений + Символы.ПС
				 + "Одобрено приглашений - " + КоличествоНовыхПрофилей;
				ПоказатьОповещениеПользователя("Обновлены статусы приглашений:", , Пояснение);
			КонецЕсли;
			
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ОбновлениеПриглашений.Журнал);
		КонецЕсли;
		
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
	//ОбновитьСчетчикиРазделовПриглашений();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСпискиПолученныхОтправленныхЗавершение(ПараметрыАвторизации, ДопПараметры = Неопределено) Экспорт

	ОбновлениеПриглашений = ККСНГ_ПриглашенияВызовСервера.ПолучитьСписокПриглашений(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		
	НаправлениеЗапросаОбновленияПриглашений = НаправлениеЗапросаОбновленияПриглашений();
		
	ОбновитьТекущиеПриглашения(НаправлениеЗапросаОбновленияПриглашений);
	
	Если ОбновлениеПриглашений.Успех Тогда
			
		КоличествоНовыхПрофилей = ОбновлениеПриглашений.Результат.КоличествоНовыхПрофилей;
		КоличествоНовыхПриглашений = ОбновлениеПриглашений.Результат.КоличествоНовыхПриглашений;
		Если НЕ КоличествоНовыхПрофилей = 0 ИЛИ НЕ КоличествоНовыхПриглашений = 0 Тогда
			Пояснение = "Получено новых приглашений - " + КоличествоНовыхПриглашений + Символы.ПС
			 + "Одобрено приглашений - " + КоличествоНовыхПрофилей;
			ПоказатьОповещениеПользователя("Обновлены статусы приглашений:", , Пояснение);
		КонецЕсли;
		
		ОбновитьСчетчикиРазделовПриглашений();
		
	Иначе
		ПоследняяОшибкаЖурнала = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ОбновлениеПриглашений.Журнал);
		Если Не ПоследняяОшибкаЖурнала = Неопределено Тогда
			ПоказатьОповещениеПользователя(, , ПоследняяОшибкаЖурнала.Событие);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НаправлениеЗапросаОбновленияПриглашений()

	Если ТекущийРаздел = "ВходящиеПригл" Тогда
		Возврат "Receiver";
	ИначеЕсли ТекущийРаздел = "ИсходящиеПригл" Тогда
		Возврат "Sender";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ОбновитьТекущиеПриглашения(НаправлениеЗапроса = Неопределено)

	Если НаправлениеЗапроса = Неопределено Тогда
		ЗначениеВРеквизитФормы(ПолучитьТекущиеПриглашения(ПрофильНастройкиЭДО), "Приглашения");
	ИначеЕсли НаправлениеЗапроса = "Sender" Тогда
		ЗначениеВРеквизитФормы(ПолучитьТекущиеПриглашенияКакОтправитель(ПрофильНастройкиЭДО, НРЕГ(ФильтрСтатусовИсходящих)), "ТаблицаПриглашенийОтправленные");
	ИначеЕсли НаправлениеЗапроса = "Receiver" Тогда
		ЗначениеВРеквизитФормы(ПолучитьТекущиеПриглашенияКакПолучатель(ПрофильНастройкиЭДО, НРЕГ(ФильтрСтатусовВходящих)), "ТаблицаПриглашенийПринятые");
	ИначеЕсли НаправлениеЗапроса = "All" Тогда
		ЗначениеВРеквизитФормы(ПолучитьТекущиеПриглашенияКакОтправитель(ПрофильНастройкиЭДО, "Processed"), "ТаблицаПриглашенийОтправленные");
		ЗначениеВРеквизитФормы(ПолучитьТекущиеПриглашенияКакПолучатель(ПрофильНастройкиЭДО, "Processed"), "ТаблицаПриглашенийПринятые");
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущиеПриглашения(ПрофильНастройкиЭДО)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
