&НаКлиенте
Процедура ДополнительныеРеквизиты(Команда)

	Если НЕ ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен профиль организации.", , "ПрофильНастройкиЭДО");
		Возврат;
	КонецЕсли;
		
	Если Элементы.ДокументыКОтправке.ВыделенныеСтроки.Количество() Тогда
		
		Для Каждого ИдентификаторСтроки Из Элементы.ДокументыКОтправке.ВыделенныеСтроки Цикл
			ДанныеСтроки = Элементы.ДокументыКОтправке.ДанныеСтроки(ИдентификаторСтроки);
			Прервать;
		КонецЦикла;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
		ДопПараметры.Вставить("ДокументСсылка", ДанныеСтроки.Ссылка);
		ДопПараметры.Вставить("ВидЭД", ДанныеСтроки.ВидЭД);
		ДопПараметры.Вставить("Контрагент", ДанныеСтроки.Контрагент);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеАвторизацииДополнительныеРеквизиты", ЭтотОбъект, ДопПараметры);
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ОписаниеОповещения);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФильтрПоДокументам(Команда)

	АктивныйФильтр = ПолучитьАктивныйФильтрПоДокументам();
	ИмяАктивногоФильтра = ?(АктивныйФильтр = Неопределено, "", АктивныйФильтр.Имя);
	ИмяУстанавливаемогоФильтра = Команда.Имя;
	
	Если Не ИмяАктивногоФильтра = ИмяУстанавливаемогоФильтра Тогда
		
		Если ИмяУстанавливаемогоФильтра = "ФильтрВсеДокументы" Тогда
			ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке,
										"Новый", Истина, ВидСравненияКомпоновкиДанных.Равно, , Ложь);
			
			УстановитьПометкуАктивногоФильтраПоДокументам(Элементы.ДокументыКОтправкеПоказатьВсеДокументы);
							
		ИначеЕсли ИмяУстанавливаемогоФильтра = "ФильтрРанееОтправленные" Тогда
			ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке,
										"Новый", Ложь, ВидСравненияКомпоновкиДанных.Равно, , Истина);
			
			УстановитьПометкуАктивногоФильтраПоДокументам(Элементы.ДокументыКОтправкеКомандаПоказатьРанееОтправленные);
			
		Иначе
			ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке,
										"Новый", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);

			УстановитьПометкуАктивногоФильтраПоДокументам(Элементы.ДокументыКОтправкеКомандаПоказатьНовые);
			
		КонецЕсли;
		
	КонецЕсли;
	
	МассивОтправленныхДокументов.Очистить();
	ОтправленныеДокументы = МассивОтправленныхДокументов.ВыгрузитьЗначения();

	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "Ссылка",
										ОтправленныеДокументы, ВидСравненияКомпоновкиДанных.НеВСписке, , Ложь);
										
	ОбновитьСоответствияРазделовДаннымФормированияЗапросов(ТекущийРаздел);
	ОбновитьСчетчикиРазделовДокументов();
										
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьКвитанции(Команда)
	
	ДанныеЭД = Новый Массив;
	
	Для каждого ИдентификаторСтроки Из Элементы.ДокументыСКвитанциями.ВыделенныеСтроки Цикл
		
		ТекДанные = Элементы.ДокументыСКвитанциями.ДанныеСтроки(ИдентификаторСтроки);
		
		ТекДанныеЭД = Новый Структура;
		ТекДанныеЭД.Вставить("ИдДокумента", ТекДанные.Id);
		ТекДанныеЭД.Вставить("ЭДСсылка", ТекДанные.Ссылка);
		ТекДанныеЭД.Вставить("ЭтоРоуминг", ТекДанные.IsRoaming);
		
		ДанныеЭД.Добавить(ТекДанныеЭД);
		
	КонецЦикла;
	
	Если ДанныеЭД.Количество() > 0 Тогда
		
		ПараметрыПодписания = Новый Структура;
		ПараметрыПодписания.Вставить("ДанныеЭД", ДанныеЭД);
		
		ПослеАвторизации = Новый ОписаниеОповещения("ПродолжитьПодписаниеКвитанций", ЭтотОбъект, ПараметрыПодписания);
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ПослеАвторизации);
		
	КонецЕсли;
	
КонецПроцедуры

