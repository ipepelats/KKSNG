&НаКлиенте
Функция ОбновитьДеревоНавигации(ЭлементыДереваНавигации, ОбновлятьРазделыДокументов = Истина, ОбновлятьРазделыПриглашений = Истина)
	
	Для каждого СтрокаНавигации Из ЭлементыДереваНавигации Цикл
		
		//Если Не ОбновлятьРазделыДокументов И СтрокаНавигации.ЭтоДокумент Тогда
		//	Продолжить;
		//КонецЕсли;
		//
		//Если Не ОбновлятьРазделыПриглашений И СтрокаНавигации.ЭтоПриглашение Тогда
		//	Продолжить;
		//КонецЕсли;
		
		ОтборРаздела = Новый Структура("Имя", СтрокаНавигации.Значение);
		НайденныеСтроки = ОписаниеРазделов.НайтиСтроки(ОтборРаздела);
		Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Продолжить;
		КонецЕсли;
		Раздел = НайденныеСтроки[0];
		
		СтрокаНавигации.Представление = Раздел.Представление;
		
		ВложенныеЭлементы = СтрокаНавигации.ПолучитьЭлементы();
		ЕстьВложенныеЭлементы = (ВложенныеЭлементы.Количество() > 0);
		
		Если ЕстьВложенныеЭлементы Тогда
			ОбновитьДеревоНавигации(ВложенныеЭлементы);
		Иначе
			
			Если Раздел.РассчитыватьКоличество И Раздел.КоличествоРассчитано И Раздел.Количество > 0 Тогда
				КоличествоПредставление = ?(Раздел.Количество > 999, "999+", Раздел.Количество);
				СтрокаНавигации.Представление = СтрокаНавигации.Представление + " (" + КоличествоПредставление + ")";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

