	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКомпоновщикаДинамическогоСписка(Раздел, ИмяТаблицы, ТаблицаФормы)
	
	Схема = ТаблицаФормы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = ТаблицаФормы.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	Настройки.Порядок.Элементы.Очистить();
	
	УстановитьДополнительныеНастройкиКомпоновкиДанныхРаздела(Настройки, Раздел, ИмяТаблицы);
	
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(Схема.НаборыДанных[0].Запрос);
	ПоследнийЗапрос = СхемаЗапроса.ПакетЗапросов.Получить(СхемаЗапроса.ПакетЗапросов.Количество() - 1);
	Для каждого Оператор Из ПоследнийЗапрос.Операторы Цикл
		Оператор.КоличествоПолучаемыхЗаписей = 1000;
	КонецЦикла;
	
	Схема.НаборыДанных[0].Запрос = СхемаЗапроса.ПолучитьТекстЗапроса();
		
	Настройки.Структура.Очистить();
	ДетальныеЗаписи = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ВыбранноеПоле = ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ТекстЗапроса = МакетКомпоновки.НаборыДанных.НаборДанныхДинамическогоСписка.Запрос;
		
	ПараметрыЗапроса = Новый Массив();
	Для каждого ЭлементПараметр Из МакетКомпоновки.ЗначенияПараметров Цикл
		СтруктураПараметра = Новый Структура("Имя, Значение", ЭлементПараметр.Имя, ЭлементПараметр.Значение);
		ПараметрыЗапроса.Добавить(СтруктураПараметра);
	КонецЦикла;
		
	Возврат Новый Структура("ТекстЗапроса, ПараметрыЗапроса", ТекстЗапроса, ПараметрыЗапроса);
	
КонецФункции

&НаСервере
Процедура УстановитьДополнительныеНастройкиКомпоновкиДанныхРаздела(НастройкиКомпоновкиДанных, Раздел, ИмяТаблицы)
	
	Если Раздел = "ПодписатьИОтправить" Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(НастройкиКомпоновкиДанных.Отбор, "ЭтоКонтрагентСбер");
		ККСНГ_ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(НастройкиКомпоновкиДанных.Отбор, "ДоступенПоУВХД");
	ИначеЕсли Раздел = "ПодписатьИОтправитьУВХД" Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиКомпоновкиДанных.Отбор, "ЭтоКонтрагентСбер", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиКомпоновкиДанных.Отбор, "ДоступенПоУВХД", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	ИначеЕсли ИмяТаблицы = "ВходящиеДокументы" ИЛИ ИмяТаблицы = "ИсходящиеДокументы" Тогда
		УстановитьПараметрыДанныхНастройкиКомпоновкиДанныхРаздела(НастройкиКомпоновкиДанных, Раздел);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеПоПодпискеИПриглашений()

	ОчиститьСообщения();
	Если ККСНГ_ОбщегоНазначенияВызовСервера.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Установлена блокировка работы с внешними ресурсами");
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьОбновлениеПоПодпискеИПриглашений", ЭтотОбъект);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ОписаниеОповещения, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбновлениеПоПодпискеИПриглашений(ЗапросПараметрыАвторизации, ДопПараметры = Неопределено) Экспорт

	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		
		ПродолжитьОбновлениеПодписки(ПараметрыАвторизации, ДопПараметры);
	
		Если ДоступнаРаботаСПриглашениями Тогда
			ПолучитьСпискиПолученныхОтправленныхЗавершение(ПараметрыАвторизации, ДопПараметры);
		КонецЕсли;
		
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
		
	КонецЕсли;
	
КонецПроцедуры

