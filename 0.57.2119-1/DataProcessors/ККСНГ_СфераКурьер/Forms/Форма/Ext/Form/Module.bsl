#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	
	НастроитьСписокДокументовОтправке();
	НастроитьСписокДокументовСКвитанциями();
	НастроитьСписокИсходящихДокументов();
	НастроитьСписокВходящихДокументов();
	НастроитьСписокОбработанныхДокументов();
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрыВыбораПрофилейЭДО(ПрофильНастройкиЭДО, Элементы.ПрофильНастройкиЭДО);
	
	// Отображение кнопки "+" при выборе профиля только если ещё нет ни одного
	Для Каждого ПараметрВыбора Из Элементы.ПрофильНастройкиЭДО.ПараметрыВыбора Цикл
		Если ПараметрВыбора.Имя = "Отбор.Ссылка" И ТипЗнч(ПараметрВыбора.Значение) = Тип("Массив") Тогда
			Элементы.ПрофильНастройкиЭДО.КнопкаСоздания = (ПараметрВыбора.Значение.Количество() = 0);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ИнициализироватьСлужебныеРеквизитыФормы();
	ИнициализироватьДеревоРазделов();
	ИнициализироватьРазделы();
	
	Если ДоступнаРаботаПоБизнесПроцессуУВХД Тогда
		ЗагрузитьСписокСопоставленийДоговоровУВХД();
		СписокСопоставленныхДоговоров = ПолучитьСписокСопоставленныхДоговоров();
		ДокументыКОтправке.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("СопоставленныеДоговора", СписокСопоставленныхДоговоров);
	КонецЕсли;
	
	Элементы.ГруппаРазделов.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.СообщениеОбОшибке.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТестовыйРежим() Тогда
		ПодключитьОбработчикОжидания("ПроверитьОбновление", 60, Истина);
	КонецЕсли;
	
	УстановитьПрофильОрганизации();
		
	УстановитьНастройкиПрофиляЭДОДляСписковДокументов();
	УстановитьПериодСпискаДокументовКОтправке();
	УстановитьПометкуАктивногоФильтраПоДокументам(Элементы.ДокументыКОтправкеКомандаПоказатьНовые);
	УстановитьНастройкиСписковТекущегоРаздела(Неопределено);
	
	Если ДоступнаРаботаСПриглашениями И ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда
		ОбновитьТекущиеПриглашения("All");
	КонецЕсли;
	
	ОтказПриПроверкеОрганизации = Ложь;
	ККСНГ_ДокументооборотКлиент.ПроверитьНаличиеОрганизацийЭДО(ОтказПриПроверкеОрганизации);
	
	Если Не ОтказПриПроверкеОрганизации Тогда
		ККСНГ_ДокументооборотКлиент.ПроверитьНаличиеКонтрагентовЭДО(ПрофильНастройкиЭДО);
	КонецЕсли;
	
	ПоказатьСтраницуРаздела("КОтправке");
	ОбновитьДеревоНавигации(ДеревоДействийРазделов.ПолучитьЭлементы());
	
	//ККСНГ_ЭлектронныеДокументыКлиент.ПредложитьОбновитьФорматУКД(ЭтотОбъект);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Обработка событий в системе
	Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("ПрофильЭДООрганизации") И Параметр.ПрофильЭДООрганизации = ПрофильНастройкиЭДО Тогда
		Если ИмяСобытия = "ОбновитьКОтправке" Тогда
			Элементы.ДокументыКОтправке.Обновить();
		КонецЕсли;
	КонецЕсли;
	
	// Переход из загрузки документооборота
	Если ИмяСобытия = "СменитьПрофильЭДООрганизации" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("ПрофильНастройкиЭДО") Тогда
			ПрофильНастройкиЭДО = Параметр.ПрофильНастройкиЭДО;
			УстановитьНастройкиПрофиляЭДОДляСписковДокументов();
		КонецЕсли;
	КонецЕсли;

	Если ИмяСобытия = "Все квитанции подписаны" И Источник = УникальныйИдентификатор Тогда
		
		ИмяКоманды = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметр, "Результат");
		Если Не ПустаяСтрока(ИмяКоманды) Тогда
			ВыполнитьДействиеКурьер(ИмяКоманды, , Ложь);
		Иначе
			Элементы.ДокументыСКвитанциями.ВыделенныеСтроки.Очистить();
			Элементы.ДокументыСКвитанциями.Обновить();
			ОбновитьСчетчикиРазделовДокументов();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ПослеКомандыСФЕРАКурьер" И Источник = Неопределено Тогда
		УстановитьНастройкиСписковТекущегоРаздела(ТекущийРаздел);
		ОбновитьСчетчикиРазделовДокументов();
	КонецЕсли;
	
	Если ИмяСобытия = "ЗаписьКонтрагентаЭДО" Тогда
		Если ДоступнаРаботаПоБизнесПроцессуУВХД Тогда
			ЗагрузитьСписокСопоставленийДоговоровУВХД(Параметр);
			СписокСопоставленныхДоговоров = ПолучитьСписокСопоставленныхДоговоров();
			ДокументыКОтправке.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("СопоставленныеДоговора", СписокСопоставленныхДоговоров);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)

	СохраненныйПрофильЭДО = Настройки.Получить("ПрофильНастройкиЭДО");

	Если СохраненныйПрофильЭДО <> Неопределено
			И (ЗначениеЗаполнено(ПрофильНастройкиЭДО)
               		ИЛИ НЕ ККСНГ_ОбщегоНазначенияВызовСервера.ПрофильЭДОДоступенПользователю(СохраненныйПрофильЭДО)) Тогда
		Настройки.Удалить("ПрофильНастройкиЭДО");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПрофильНастройкиЭДОПриИзменении(Элемент)
	
	УстановитьНастройкиПрофиляЭДОДляСписковДокументов();
	
	Если Элементы.ГруппаРазделов.ТекущаяСтраница = Элементы.ГруппаРазделов.ПодчиненныеЭлементы.ГруппаДокументыКОтправке Тогда
		ККСНГ_ДокументооборотКлиент.ПроверитьНаличиеКонтрагентовЭДО(ПрофильНастройкиЭДО, Ложь);
	КонецЕсли;
	
	ОбновитьТекущиеПриглашения("All");
	ОбновитьСоответствияРазделовДаннымФормированияЗапросов(, Истина);
	ОбновитьСчетчикиРазделовДокументов(Истина);
	ОбновитьСчетчикиРазделовПриглашений(Истина);
	ВыполнитьОбновлениеДанныхКурьера();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодКОтправкеПриИзменении(Элемент)

	УстановитьПериодСпискаДокументовКОтправке();
	ОбновитьСоответствияРазделовДаннымФормированияЗапросов(ТекущийРаздел);
	ОбновитьСчетчикиРазделовДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидыЭДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтборВидыЭДПоказатьОтметкуЗавершение", ЭтотОбъект);
	ОтборВидыЭД.ПоказатьОтметкуЭлементов(ОписаниеОповещения, "Виды документов");

КонецПроцедуры

&НаКлиенте
Процедура ОтборВидыЭДПриИзменении(Элемент)

	ВыбранныеВидыЭД = Новый Массив;

	Для каждого ЭлементСписка Из ОтборВидыЭД Цикл
		Если ЭлементСписка.Пометка Тогда
			ВыбранныеВидыЭД.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;

	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "ВидЭД", ВыбранныеВидыЭД, , , Истина);
	ОбновитьСоответствияРазделовДаннымФормированияЗапросов(ТекущийРаздел);
	ОбновитьСчетчикиРазделовДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура СообщениеОбОшибкеНажатие(Элемент, СтандартнаяОбработка)
	
	ТаблицаОшибокКопия = ТаблицаОшибок;
	АдресТаблицыОшибок = АдресТаблицыОшибок(ТаблицаОшибокКопия);
	ПараметрыОткрытия = Новый Структура("АдресТаблицыОшибок", АдресТаблицыОшибок);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаЛогаОшибокЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ККСНГ_СфераКурьер.Форма.ФормаЛогОшибок",
					ПараметрыОткрытия, ЭтотОбъект, , , , ОписаниеОповещения
						, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#Область СобытияФормыПриглашений

&НаКлиенте
Процедура ФильтрСтатусовИсходящихПриИзменении(Элемент)
	ПолучитьСписокПриглашений(Неопределено);
	ОбновитьСчетчикиРазделовПриглашений();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСтатусовВходящихПриИзменении(Элемент)
	ПолучитьСписокПолученныхПриглашений(Неопределено);
	ОбновитьСчетчикиРазделовПриглашений();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОбрабатыватьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаПриглашенийОтправленные.ТекущиеДанные;
	Если Не ТекДанные = Неопределено И ТекДанные.Обрабатывать Тогда
		Если Не (НРЕГ(ТекДанные.Status) = "processed" И НРЕГ(ТекДанные.Side) = "sender") Тогда
			ТекДанные.Обрабатывать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДействийРазделов

&НаКлиенте
Процедура ДеревоДействийРазделовПриАктивизацииСтроки(Элемент)
	
	ОчиститьИСкрытьТаблицуОшибок();
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыйРаздел = Элемент.ТекущиеДанные.Значение;
	Если Не НовыйРаздел = ТекущийРаздел Тогда
		
		ТекущийРаздел = НовыйРаздел;
		
		БизнесПроцессРаздела = ?(НовыйРаздел = "ПодписатьИОтправитьУВХД", "УВХД", Неопределено);
		ДокументыКОтправке.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("БизнесПроцесс", БизнесПроцессРаздела);
				
		УстановитьНастройкиСписковТекущегоРаздела(ТекущийРаздел);
		УстановитьПометкуАктивногоФильтраПоДокументам(Элементы.ДокументыКОтправкеКомандаПоказатьНовые);
		УстановитьФильтрПоДокументам(Команды.Найти(Элементы.ДокументыКОтправкеКомандаПоказатьНовые.ИмяКоманды));
		
		ОбновитьСоответствияРазделовДаннымФормированияЗапросов(НовыйРаздел);
		//ОбновитьСчетчикиРазделовДокументов();
		ВыполнитьОбновлениеДанныхКурьера();
		
		ПоказатьРаздел(НовыйРаздел);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыКОтправке

&НаКлиенте
Процедура ДокументыКОтправкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ДанныеСтроки = Элементы.ДокументыКОтправке.ДанныеСтроки(ВыбраннаяСтрока);
	ПоказатьЗначение(, ДанныеСтроки.Ссылка);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДокументыКОтправкеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	БизнесПроцесс = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Настройки.ДополнительныеСвойства, "БизнесПроцесс");
	Если БизнесПроцесс = "УВХД" Тогда
		СопоставленныеДоговора = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Настройки.ДополнительныеСвойства, "СопоставленныеДоговора", Новый Массив());
		Для каждого Строка Из Строки Цикл
			ДоговорСопоставлен = Не (СопоставленныеДоговора.Найти(Строка.Значение.Данные.ДоговорКонтрагента) = Неопределено);
			Если Не ДоговорСопоставлен Тогда
				Для каждого ОформлениеЯчейки Из Строка.Значение.Оформление Цикл
					ОформлениеЯчейки.Значение.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160));
					Если ОформлениеЯчейки.Ключ = "Примечание" Тогда
						ОформлениеЯчейки.Значение.УстановитьЗначениеПараметра("Текст", "Необходимо сопоставить договор");
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИсходящиеДокументы

&НаКлиенте
Процедура ИсходящиеДокументыПриАктивизацииСтроки(Элемент)
	
	ИсходящиеДокументыОбработатьАктивизациюСтроки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИсходящиеДокументыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ЭлектронныеДокументПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВходящиеДокументы

&НаКлиенте
Процедура ВходящиеДокументыПриАктивизацииСтроки(Элемент)
	
	ВходящиеДокументыОбработатьАктивизациюСтроки();
	 
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВходящиеДокументыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ЭлектронныеДокументПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбработанныеДокументы

&НаСервереБезКонтекста
Процедура ОбработанныеДокументыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ЭлектронныеДокументПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПриглашенийПринятые

&НаКлиенте
Процедура ТаблицаПриглашенийПринятыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаПриглашенийПринятыеSenderName"
			И Не Элемент.ТекущиеДанные = Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Профиль) Тогда
		ККСНГ_ПриглашенияКлиент.ОткрытьФормуПрофиляКонтрагента(Элемент.ТекущиеДанные.Профиль, Элементы.ТаблицаПриглашенийПринятые);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенийПринятыеПередНачаломИзменения(Элемент, Отказ)
	
	ТекДанные = Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НРЕГ(ТекДанные.Side) = "receiver" И (НРЕГ(ТекДанные.Status) = "rejected" Или НРЕГ(ТекДанные.Status) = "accepted") Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенийПринятыеКонтрагентПриИзменении(Элемент, ВыбранныеЗначения = Неопределено)
	
	ТекДанные = Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные;
	Если Не ТекДанные = Неопределено Тогда
		НовыйКонтрагент = ?(ВыбранныеЗначения = Неопределено, ТекДанные.Контрагент, ВыбранныеЗначения);
		ЗапросЗаписьПриглашения = ККСНГ_ПриглашенияВызовСервера.ЗаписатьКонтрагентаОтправителя(ТекДанные.Id, ПрофильНастройкиЭДО, НовыйКонтрагент);
		Если Не ЗапросЗаписьПриглашения.Успех Тогда
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросЗаписьПриглашения.Журнал);
		КонецЕсли;
		ТекДанные.Профиль = ККСНГ_РаботаСКонтрагентамиВызовСервера.ПрофильКонтрагента(ПрофильНастройкиЭДО, НовыйКонтрагент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенийПринятыеКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные;
	ОтправительИНН = ?(ТекДанные = Неопределено, "", ТекДанные.SenderInn);
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИНН", ОтправительИНН);
	
	ПослеВыбораКонтрагента = Новый ОписаниеОповещения("ОбработкаВыбораПолучателя", ЭтотОбъект, Неопределено);
		
	ККСНГ_ПриглашенияКлиент.ОткрытьФормуВыбораКонтрагента(Отбор, Элементы.ТаблицаПриглашенийПринятые, ПослеВыбораКонтрагента);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенийПринятыеОбрабатыватьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные;
	Если Не ТекДанные = Неопределено И ТекДанные.Обрабатывать Тогда
		Если НРЕГ(ТекДанные.Status) = "processed" И НРЕГ(ТекДанные.Side) = "receiver" Тогда
			
			ПутьКПолю = "ТаблицаПриглашенийПринятые[" + ТаблицаПриглашенийПринятые.Индекс(Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные) + "].Контрагент";
			Если НЕ ЗначениеЗаполнено(ТекДанные.Контрагент) Тогда
				ТекДанные.Обрабатывать = Ложь;
				ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен контрагент. Заполните контрагента и повторно примите приглашение", , ПутьКПолю);
			Иначе
				РеквизитыКонтрагента = ККСНГ_ОбщегоНазначенияВызовСервера.ЗначениеИмеющегосяРеквизитаОбъекта(ТекДанные.Контрагент, "ИНН, КПП");
				Если НЕ ТекДанные.SenderInn = РеквизитыКонтрагента["ИНН"] ИЛИ НЕ ТекДанные.SenderKpp = РеквизитыКонтрагента["КПП"] Тогда
					ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ИНН/КПП выбранного контрагента не совпадает с ИНН/КПП отправителя", , ПутьКПолю);
				КонецЕсли;
			КонецЕсли;

		Иначе
			ТекДанные.Обрабатывать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПриглашенийОтправленные

&НаКлиенте
Процедура ТаблицаПриглашенийОтправленныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОтправитьReceiverName" И НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		
		ПрофильКонтрагента = ККСНГ_РаботаСКонтрагентамиВызовСервера.ПрофильКонтрагента(ПрофильНастройкиЭДО, Элемент.ТекущиеДанные.Контрагент);
		Если Не ПрофильКонтрагента.Пустая() Тогда
			ККСНГ_ПриглашенияКлиент.ОткрытьФормуПрофиляКонтрагента(ПрофильКонтрагента, Элементы.ТаблицаПриглашенийОтправленные);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриглашенийОтправленныеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВыбранныеКонтрагенты1С = ВыбранноеЗначение;
	
	Если Не ВыбранныеКонтрагенты1С = Неопределено  Тогда
		Если ВыбранныеКонтрагенты1С.Количество() > 1 Тогда
			ПараметрыОткрытия = Новый Структура("Контрагенты1С, ПрофильОрганизацииЭДО", ВыбранныеКонтрагенты1С, ПрофильНастройкиЭДО);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОтправкаПриглашенийЗакрытие", ЭтотОбъект);
			ОткрытьФорму("Обработка.ККСНГ_СинхронизацияКонтрагентов.Форма.ОтправкаПриглашений", ПараметрыОткрытия,
				Элементы.ТаблицаПриглашенийОтправленные, , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			ПослеАвторизации = Новый ОписаниеОповещения("ПригласитьКонтрагентовЗавершение", ЭтотОбъект, ВыбранныеКонтрагенты1С);
			ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильНастройкиЭДО, ПослеАвторизации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

