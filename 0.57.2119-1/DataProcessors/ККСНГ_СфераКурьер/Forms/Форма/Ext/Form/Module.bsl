	|			И (НЕ ККСНГ_Контрагенты.ПометкаУдаления)
	|			И ДанныеСКонтрагентом.ПрофильЭДООрганизации = ККСНГ_Контрагенты.Владелец
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеСКонтрагентом.ПрофильЭДООрганизации,
	|	ДанныеСКонтрагентом.Обработано,
	|	ДанныеСКонтрагентом.Id,
	|	ДанныеСКонтрагентом.SenderName,
	|	ДанныеСКонтрагентом.SenderKpp,
	|	ДанныеСКонтрагентом.SenderInn,
	|	ДанныеСКонтрагентом.Status,
	|	ДанныеСКонтрагентом.Date,
	|	ДанныеСКонтрагентом.AcceptionDate,
	|	ДанныеСКонтрагентом.ReceiverId,
	|	ДанныеСКонтрагентом.ReceiverName,
	|	ДанныеСКонтрагентом.ReceiverKpp,
	|	ДанныеСКонтрагентом.ReceiverInn,
	|	ДанныеСКонтрагентом.Contacts,
	|	ДанныеСКонтрагентом.Email,
	|	ДанныеСКонтрагентом.Обрабатывать,
	|	ДанныеСКонтрагентом.КонтрагентОтправитель,
	|	ДанныеСКонтрагентом.StatusName,
	|	ДанныеСКонтрагентом.Side";
	
	Запрос.УстановитьПараметр("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	Запрос.УстановитьПараметр("side", "Receiver");
	
	Если НЕ ВыбранныйСтатус = "all" Тогда
		Запрос.УстановитьПараметр("ВыбранныйСтатус", ВыбранныйСтатус);
		Запрос.УстановитьПараметр("ИспользоватьФильтр", Истина);
	Иначе
		Запрос.УстановитьПараметр("ВыбранныйСтатус", "");
		Запрос.УстановитьПараметр("ИспользоватьФильтр", Ложь);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущиеПриглашенияКакОтправитель(ПрофильНастройкиЭДО, ВыбранныйСтатус)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегистрСведенийККСНГ_Приглашения.ПрофильЭДООрганизации КАК ПрофильЭДООрганизации,
	|	РегистрСведенийККСНГ_Приглашения.Обработано КАК Обработано,
	|	РегистрСведенийККСНГ_Приглашения.Id КАК Id,
	|	РегистрСведенийККСНГ_Приглашения.SenderName КАК SenderName,
	|	РегистрСведенийККСНГ_Приглашения.SenderKpp КАК SenderKpp,
	|	РегистрСведенийККСНГ_Приглашения.SenderInn КАК SenderInn,
	|	РегистрСведенийККСНГ_Приглашения.StatusName КАК StatusName,
	|	РегистрСведенийККСНГ_Приглашения.Date КАК Date,
	|	РегистрСведенийККСНГ_Приглашения.AcceptionDate КАК AcceptionDate,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverId КАК ReceiverId,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverName КАК ReceiverName,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverKpp КАК ReceiverKpp,
	|	РегистрСведенийККСНГ_Приглашения.ReceiverInn КАК ReceiverInn,
	|	РегистрСведенийККСНГ_Приглашения.Contacts КАК Contacts,
	|	РегистрСведенийККСНГ_Приглашения.Email КАК Email,
	|	ЛОЖЬ КАК Обрабатывать,
	|	РегистрСведенийККСНГ_Приглашения.КонтрагентПолучатель КАК Контрагент,
	|	РегистрСведенийККСНГ_Приглашения.Status КАК Status,
	|	РегистрСведенийККСНГ_Приглашения.Side КАК Side
	|ИЗ
	|	РегистрСведений.ККСНГ_Приглашения КАК РегистрСведенийККСНГ_Приглашения
	|ГДЕ
	|	РегистрСведенийККСНГ_Приглашения.ПрофильЭДООрганизации = &ПрофильНастройкиЭДО
	|	И РегистрСведенийККСНГ_Приглашения.Side = &Side
	|	И ВЫБОР
	|			КОГДА &ИспользоватьФильтр
	|				ТОГДА РегистрСведенийККСНГ_Приглашения.Status = &ВыбранныйСтатус
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	Запрос.УстановитьПараметр("side", "Sender");
	
	Если НЕ ВыбранныйСтатус = "all" Тогда
		Запрос.УстановитьПараметр("ВыбранныйСтатус", ВыбранныйСтатус);
		Запрос.УстановитьПараметр("ИспользоватьФильтр", Истина);
	Иначе
		Запрос.УстановитьПараметр("ВыбранныйСтатус", "");
		Запрос.УстановитьПараметр("ИспользоватьФильтр", Ложь);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаКлиенте
Процедура ПригласитьКонтрагентовЗавершение(ЗапросПараметрыАвторизации, ВыбранныеКонтрагенты1С) Экспорт

	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		
		РезультатПроверки = ККСНГ_ПриглашенияВызовСервера.КонтрагентыЗарегистрированыВКурьере(ПараметрыАвторизации, ВыбранныеКонтрагенты1С);
		Если НЕ РезультатПроверки.Успех Тогда
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(РезультатПроверки.Журнал);
			Возврат;
		КонецЕсли;
		
		ЗарегистрированныеКонтрагентыЭДО = РезультатПроверки.Результат.ЗарегистрированныеКонтрагентыЭДО;
		
		ОтправкаПриглашений = ККСНГ_ПриглашенияВызовСервера.ПригласитьКонтрагентов(ВыбранныеКонтрагенты1С,
																					ЗарегистрированныеКонтрагентыЭДО,
																					ПрофильНастройкиЭДО,
																					ПараметрыАвторизации);
		
		Если ОтправкаПриглашений.Успех Тогда
			ПоказатьОповещениеПользователя(, , "Приглашения отправлены");
			ОбновитьТекущиеПриглашения("Sender");
		Иначе
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ОтправкаПриглашений.Журнал);
		КонецЕсли;
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
	//ОбновитьСчетчикиРазделовПриглашений();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеКурьер(ИмяКоманды, ВыделенныеСтроки = Неопределено, ТребуетсяПодписаниеКвитанций = Неопределено)
	
	Если ВыделенныеСтроки = Неопределено И Элементы.ГруппаРазделов.ТекущаяСтраница.Имя = "ГруппаВходящиеДокументы" Тогда
		ВыделенныеСтроки = Элементы.ВходящиеДокументы.ВыделенныеСтроки;
	КонецЕсли;
	
	Если ВыделенныеСтроки = Неопределено И Элементы.ГруппаРазделов.ТекущаяСтраница.Имя = "ГруппаИсходящиеДокументы" Тогда
		ВыделенныеСтроки = Элементы.ИсходящиеДокументы.ВыделенныеСтроки;
	КонецЕсли;
	
	Если ВыделенныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяПодписаниеКвитанций = Неопределено Тогда
		ТребуетсяПодписаниеКвитанций = ККСНГ_КвитанцииКлиент.ТребуетсяПодписаниеКвитанций(ИмяКоманды);
	КонецЕсли;
	
	ККСНГ_ДокументооборотКлиент.ВыполнитьДействиеКурьер(ИмяКоманды, ПрофильНастройкиЭДО, ТребуетсяПодписаниеКвитанций, ВыделенныеСтроки, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеСчетчиковРазделов

&НаКлиенте
Процедура ВыполнитьОбновлениеДанныхКурьера()
	
	Если НЕ ЗначениеЗаполнено(ПрофильНастройкиЭДО) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен профиль организации.", , "ПрофильНастройкиЭДО");
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбновлениеПоПодпискеИПриглашений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчикиРазделовДокументов(ОбнулитьСчетчики = Ложь)
	
	Если ОбнулитьСчетчики Тогда
		ОбнулитьСчетчикиРазделовДокументов();
	КонецЕсли;
	
	ИдентификаторЗаданияОбновленияСчетчиков = ВыполнитьОбновлениеСчетчиковРазделовДокументовВФоне();
	Если ЗначениеЗаполнено(ИдентификаторЗаданияОбновленияСчетчиков) Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеОбновленияСчетчиков", 5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСчетчикиРазделовПриглашений(ОбнулитьСчетчики = Ложь)
	
	Если ОбнулитьСчетчики Тогда
		ОбнулитьСчетчикиРазделовПриглашений();
	КонецЕсли;
	
	Элементы.ТаблицаПриглашенийОтправленные.Обновить();
	ОтборПриглашений = Новый Структура("Status", ФильтрСтатусовИсходящих);
	ПриглашенияСтроки = ТаблицаПриглашенийОтправленные.НайтиСтроки(ОтборПриглашений);
	УстановитьЗначениеСчетчикаОписанияРаздела("ИсходящиеПригл", ПриглашенияСтроки.Количество());
	
	Элементы.ТаблицаПриглашенийПринятые.Обновить();
	ОтборПриглашений = Новый Структура("Status", ФильтрСтатусовВходящих);
	ПриглашенияСтроки = ТаблицаПриглашенийПринятые.НайтиСтроки(ОтборПриглашений);
	УстановитьЗначениеСчетчикаОписанияРаздела("ВходящиеПригл", ПриглашенияСтроки.Количество());
	
	ОбновитьДеревоНавигации(ДеревоДействийРазделов.ПолучитьЭлементы(), Ложь);
	
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьОбновлениеСчетчиковРазделовДокументовВФоне()
	
	АдресХранилищаРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	
	ПараметрыФЗ = Новый Массив;
	ПараметрыФЗ.Добавить(СоответствияРазделовДаннымФормированияЗапросов);
	ПараметрыФЗ.Добавить(АдресХранилищаРезультата);
	
	ИмяМетодаФЗ = "ККСНГ_ЭлектронныеДокументы.ПолучитьЗначенияСчетчиковРазделов";
	КлючФЗ = "ОбновлениеСчетчиковРазделов__" + Строка(ПрофильНастройкиЭДО.УникальныйИдентификатор());
	ОписаниеФЗ = "Обновление счетчиков разделов " + Строка(ПрофильНастройкиЭДО);
	
	ИдентификаторФЗ = ККСНГ_ОбщегоНазначенияВызовСервера.ВыполнитьФоновоеЗадание(ИмяМетодаФЗ, ПараметрыФЗ, КлючФЗ, ОписаниеФЗ);
	
	Если Не ЗначениеЗаполнено(ИдентификаторФЗ) Тогда
		УдалитьИзВременногоХранилища(АдресХранилищаРезультата);
	КонецЕсли;
	
	Возврат ИдентификаторФЗ;
	
КонецФункции

&НаСервере
Процедура ОбновитьСоответствияРазделовДаннымФормированияЗапросов(Знач Раздел = Неопределено, ОчиститьСоответствия = Ложь)
	
	Если СоответствияРазделовДаннымФормированияЗапросов = Неопределено Или ОчиститьСоответствия Тогда
		СоответствияРазделовДаннымФормированияЗапросов = Новый Структура;
		Раздел = Неопределено;
	Иначе
		СоответствияРазделовДаннымФормированияЗапросов = ЗначениеИзСтрокиВнутр(СоответствияРазделовДаннымФормированияЗапросов);
	КонецЕсли;
	
	СоответствияРазделовТаблицамДанных = СоответствияРазделовТаблицамДанных();
	СоответствияРазделовТаблицамФормы = СоответствияРазделовТаблицамФормы();
	
	Если Раздел = Неопределено Тогда
		
		Для каждого СоответствиеРазделаТаблицеДанных Из СоответствияРазделовТаблицамДанных Цикл
			
			Раздел = СоответствиеРазделаТаблицеДанных.Ключ;
			ИмяТаблицы = СоответствиеРазделаТаблицеДанных.Значение;
			ТаблицаФормы = СоответствияРазделовТаблицамФормы.Получить(ИмяТаблицы);
			Если Не ИмяТаблицы = Неопределено И Не ТаблицаФормы = Неопределено Тогда
				ДанныеФормированияЗапроса = ПолучитьДанныеФормированияЗапросаРаздела(Раздел, ИмяТаблицы, ТаблицаФормы, ПрофильНастройкиЭДО);
				СоответствияРазделовДаннымФормированияЗапросов.Вставить(Раздел, ДанныеФормированияЗапроса);
			КонецЕсли;
				
		КонецЦикла;
		
	Иначе
		
		ИмяТаблицы = СоответствияРазделовТаблицамДанных.Получить(Раздел);
		ТаблицаФормы = СоответствияРазделовТаблицамФормы.Получить(ИмяТаблицы);
		Если Не ИмяТаблицы = Неопределено И Не ТаблицаФормы = Неопределено Тогда
			ДанныеФормированияЗапроса = ПолучитьДанныеФормированияЗапросаРаздела(Раздел, ИмяТаблицы, ТаблицаФормы, ПрофильНастройкиЭДО);
			СоответствияРазделовДаннымФормированияЗапросов.Вставить(Раздел, ДанныеФормированияЗапроса);
		КонецЕсли;
			
	КонецЕсли;
	
	СоответствияРазделовДаннымФормированияЗапросов = ЗначениеВСтрокуВнутр(СоответствияРазделовДаннымФормированияЗапросов);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеФормированияЗапросаРаздела(Раздел, ИмяТаблицы, ТаблицаФормы, ПрофильНастройкиЭДО)
	
	Если ИмяТаблицы = "ДокументыКОтправке" Или ИмяТаблицы = "ВходящиеДокументы"
		Или ИмяТаблицы = "ИсходящиеДокументы" Или ИмяТаблицы = "ДокументыСКвитанциями" Тогда
		ДанныеФормированияЗапроса = ПолучитьДанныеКомпоновщикаДинамическогоСписка(Раздел, ИмяТаблицы, ТаблицаФормы);
	Иначе
		ДанныеФормированияЗапроса = Неопределено;
	КонецЕсли;
	
	Возврат ДанныеФормированияЗапроса;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыДанныхНастройкиКомпоновкиДанныхРаздела(НастройкиКомпоновкиДанных, Раздел)
	
	ПараметрыДанныхРаздела = НастройкиОтбораСписковРаздела(Раздел);
	ПараметрыДанныхРаздела.Вставить("ПрофильНастройкиЭДО", ПрофильНастройкиЭДО);
	
	ПараметрыДанныхНастройки = НастройкиКомпоновкиДанных.ПараметрыДанных;
	Для каждого ПараметрДанных Из ПараметрыДанныхРаздела Цикл
		ИдентификаторПараметраДанныхРаздела = ПараметрДанных.Ключ;
		НайденныйПараметрДанныхНастройки = ПараметрыДанныхНастройки.Элементы.Найти(ИдентификаторПараметраДанныхРаздела);
		Если Не НайденныйПараметрДанныхНастройки  = Неопределено И НайденныйПараметрДанныхНастройки.Использование Тогда
			ПараметрыДанныхНастройки.УстановитьЗначениеПараметра(ПараметрДанных.Ключ, ПараметрДанных.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеОбновленияСчетчиков()
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗаданияОбновленияСчетчиков) Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыполнения = ККСНГ_ОбщегоНазначенияВызовСервера.РезультатВыполненияФоновогоЗадания(ИдентификаторЗаданияОбновленияСчетчиков);
	
	Если Не РезультатВыполнения.Завершено Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеОбновленияСчетчиков", 5, Истина);
	Иначе
		
		Если РезультатВыполнения.ОписаниеОшибки = Неопределено Тогда
			ЗапросДанныхОбновленияСчетчиков = ПолучитьЗначенияСчетчиковРазделовИзФоновогоЗадания(ИдентификаторЗаданияОбновленияСчетчиков);
			
			Если ЗапросДанныхОбновленияСчетчиков.Успех Тогда
				ДанныеОбновленияСчетчиков = ЗапросДанныхОбновленияСчетчиков.Результат;
				ОбновитьЗначенияОписанийРазделов(ДанныеОбновленияСчетчиков);
			КонецЕсли;
								
		Иначе
					
			ОписаниеОшибки = "Обновление данных по разделам завершено с ошибками: " + РезультатВыполнения.ОписаниеОшибки;
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			
		КонецЕсли;
		
		ОбновитьДеревоНавигации(ДеревоДействийРазделов.ПолучитьЭлементы());
				
		ОбновитьСостояниеКнопкиОбновления(Ложь);

	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначенияСчетчиковРазделовИзФоновогоЗадания(ИдентификаторЗадания)
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	
    Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторЗадания));
	
	Если НЕ Задание = Неопределено Тогда
		
		СообщенияЗадания = Задание.ПолучитьСообщенияПользователю();
		
		Если СообщенияЗадания.Количество() = 1 Тогда
			АдресХранилища = СообщенияЗадания[0].Текст;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ АдресХранилища = Неопределено
		И ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		
		ЗначениеИзХранилища = ПолучитьИзВременногоХранилища(АдресХранилища);
		
		Если ТипЗнч(ЗначениеИзХранилища) = Тип("Структура")
			И ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначениеИзХранилища, "Успех", Ложь) Тогда
			Ответ.Успех = Истина;
			Ответ.Результат = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначениеИзХранилища, "Результат");
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

