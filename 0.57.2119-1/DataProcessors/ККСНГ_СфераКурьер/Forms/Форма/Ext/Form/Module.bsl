КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьПрофильОрганизации()

	Если Не ЭтотОбъект.ПрофильНастройкиЭДО.Пустая()
		И (ЭтотОбъект.ПрофильНастройкиЭДО.ПолучитьОбъект() = Неопределено
		ИЛИ ЭтотОбъект.ПрофильНастройкиЭДО.ПометкаУдаления) Тогда
		
		ЭтотОбъект.ПрофильНастройкиЭДО = Неопределено;
		
	КонецЕсли;
	
	ДоступныеПрофилиЭДО = ККСНГ_ОбщегоНазначенияВызовСервера.ПолучитьДоступныеПрофилиЭДОПользователя();
	
	Если ЭтотОбъект.ПрофильНастройкиЭДО.Пустая()
		И ДоступныеПрофилиЭДО.Количество() > 0 Тогда
		
		Для Каждого СтрДоступныйПрофиль Из ДоступныеПрофилиЭДО Цикл
			
			Если НЕ СтрДоступныйПрофиль.ПометкаУдаления Тогда
				
				ЭтотОбъект.ПрофильНастройкиЭДО = СтрДоступныйПрофиль;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПодписание(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		ДанныеКОтправке = ДопПараметры.ДанныеКОтправке;
		ПодписатьДанные = ДопПараметры.ПодписатьДанные;
		
		ДопДанные = Новый Структура;
		ДопДанные.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
		ДопДанные.Вставить("ДанныеКОтправке", ДанныеКОтправке);
		ДопДанные.Вставить("ПодписатьДанные", ПодписатьДанные);
		
		Если ДанныеКОтправке.Количество() = 1 Тогда
			ПодтвердитьОтправкуДокументовЗавершение(Истина, ДопДанные);
		Иначе
			
			НовыйОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодтвердитьОтправкуДокументовЗавершение", ЭтотОбъект, ДопДанные);
			СтруктураОтбора = Новый Структура("МассивДокументов, БизнесПроцесс", ДанныеКОтправке, БизнесПроцессРаздела);
			
			ОткрытьФорму("Обработка.ККСНГ_СфераКурьер.Форма.ФормаПодтвержденияОтправки", СтруктураОтбора, ЭтотОбъект, , , , НовыйОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	Иначе
		
		Элементы.ДокументыКОтправкеПодписатьИОтправить.Доступность = Истина;
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПодписаниеКвитанций(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Перем ПараметрыАвторизации;
	Перем ЭлектронныеДокументы, ДанныеДокумента;
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		
		ЭлектронныеДокументы = Новый Массив;
		Для каждого ДанныеДокумента Из ДопПараметры.ДанныеЭД Цикл
			ЭлектронныеДокументы.Добавить(ДанныеДокумента.ЭДСсылка);
		КонецЦикла;
		
		ККСНГ_ДокументооборотКлиент.ОбработатьКомандуКурьерПодписатьКвитанцииДокумента(ЭлектронныеДокументы, ПараметрыАвторизации, , УникальныйИдентификатор);
		
	Иначе
		
		Элементы.ДокументыКОтправкеПодписатьИОтправить.Доступность = Истина;
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЗначениеБизнесПроцесса(Строки)
	
	МассивДокументов = Новый Массив;
	СоответствиеСтрок = Новый Соответствие;
	
	Для каждого ТекущаяСтрока Из Строки Цикл
		
		ДанныеСтроки = ТекущаяСтрока.Значение.Данные;
		МассивДокументов.Добавить(ДанныеСтроки.Ссылка);
		
		СоответствиеСтрок.Вставить(ДанныеСтроки.Ссылка, ТекущаяСтрока.Значение.Данные);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ККСНГ_ЭлектронныеДокументыProperties.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА (ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументыProperties.Value КАК СТРОКА(10))) = ""UVHD""
	               |			ТОГДА ""ЭДО с поставщиками""
	               |		ИНАЧЕ ККСНГ_ЭлектронныеДокументыProperties.Value
	               |	КОНЕЦ КАК Value
	               |ИЗ
	               |	Справочник.ККСНГ_ЭлектронныеДокументы.Properties КАК ККСНГ_ЭлектронныеДокументыProperties
	               |ГДЕ
	               |	(ВЫРАЗИТЬ(ККСНГ_ЭлектронныеДокументыProperties.Key КАК СТРОКА(50))) = &Key
	               |	И ККСНГ_ЭлектронныеДокументыProperties.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("Key", "business process");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультат = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаРезультат.Следующий() Цикл
			
			ДанныеСтроки = СоответствиеСтрок.Получить(ВыборкаРезультат.Ссылка);
			
			Если ДанныеСтроки <> Неопределено Тогда
				ДанныеСтроки.БизнесПроцесс = ВыборкаРезультат.Value;
			КонецЕсли;
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АдресТаблицыОшибок(ТаблицаОшибокКопия)

	ТаблицаОшибок = ДанныеФормыВЗначение(ТаблицаОшибокКопия, Тип("ТаблицаЗначений"));
	АдресТаблицы = ПоместитьВоВременноеХранилище(ТаблицаОшибок);
	
	Возврат АдресТаблицы;
	
КонецФункции

&НаКлиенте
Процедура ПослеАвторизацииДополнительныеРеквизиты(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт

	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		ДопПараметры.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
		ДопПараметры.Вставить("БизнесПроцесс", БизнесПроцессРаздела);
		
		ОткрытьФорму("Обработка.ККСНГ_ДополнительныеРеквизитыЭД.Форма.Форма", ДопПараметры, ЭтотОбъект);

	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
		Элементы.ДокументыКОтправкеПодписатьИОтправить.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПолучателя(ВыбранноеЗначение, ДопПараметры) Экспорт

	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		
		ТаблицаПриглашенийПринятыеКонтрагентПриИзменении(Неопределено, ВыбранноеЗначение);
		
		ТекДанные = Элементы.ТаблицаПриглашенийПринятые.ТекущиеДанные;
		Если Не ТекДанные = Неопределено Тогда
			ТекДанные.Контрагент = ВыбранноеЗначение;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтборВидыЭДПоказатьОтметкуЗавершение(Список, ДопПараметры) Экспорт

	Если Список <> Неопределено Тогда

		ВыбранныеВидыЭД = Новый Массив;

		Для каждого ЭлементСписка Из ОтборВидыЭД Цикл
			Если ЭлементСписка.Пометка Тогда
				ВыбранныеВидыЭД.Добавить(ЭлементСписка.Значение);
			КонецЕсли;

		КонецЦикла;

		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "ВидЭД", ВыбранныеВидыЭД, , , Истина);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьОтправкуДокументовЗавершение(Результат, ДопДанные) Экспорт
	
	Если Результат = Истина Тогда
		
		МассивДокументов = Новый Массив;
		ДанныеКОтправке = ДопДанные.ДанныеКОтправке;
		
		Для каждого ДанныеСтруктура Из ДанныеКОтправке Цикл
			МассивДокументов.Добавить(ДанныеСтруктура.Ссылка);
		КонецЦикла;
		
		// Проверим заполнение доп. реквизитов документов
		ЗапросПроверкиДопРеквизитов = ККСНГ_ОтправкаЭДКлиент.ПроверкаЗаполненияДопРеквизитовДокументов(МассивДокументов);
		
		ПодписатьДанные = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопДанные, "ПодписатьДанные", Истина);
		
		Если ЗапросПроверкиДопРеквизитов.Успех Тогда
			
			ПараметрыАвторизации = ДопДанные.ПараметрыАвторизации;
			
			ПараметрыОповещения = Новый Структура("БизнесПроцесс", БизнесПроцессРаздела);
			
			ОповещениеЗавершения = Новый ОписаниеОповещения("ПодписатьИОтправитьЭлектронныеДокументыЗавершение", ЭтотОбъект, ПараметрыОповещения);
			
			ККСНГ_ОтправкаЭДКлиент.ПодписатьИОтправитьЭлектронныеДокументы(ДанныеКОтправке, ПрофильНастройкиЭДО, ПараметрыАвторизации, ПодписатьДанные, ОповещениеЗавершения);
			
		Иначе // Пока просто вывод
			Элементы.ДокументыКОтправкеПодписатьИОтправить.Доступность = Истина;
			ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ЗапросПроверкиДопРеквизитов.Журнал, "-1");
		КонецЕсли;
		
	Иначе
		ПодписатьИОтправитьЭлектронныеДокументыЗавершение(Неопределено, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиСписковТекущегоРаздела(Раздел)

	Если ДоступнаРаботаПоБизнесПроцессуУВХД И БизнесПроцессРаздела = "УВХД" Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "ЭтоКонтрагентСбер",
																		Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "ДоступенПоУВХД",
																		Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	Иначе
		ККСНГ_ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(ДокументыКОтправке.Отбор, "ЭтоКонтрагентСбер");
		ККСНГ_ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(ДокументыКОтправке.Отбор, "ДоступенПоУВХД");
	КонецЕсли;
	
	НастройкиОтбораДляВходящихИсходящих = НастройкиОтбораСписковРаздела(Раздел);
	
	// TODO Пересмотреть подход к установке фильтров
	Если Раздел = "Исходящие" Или Раздел = "ОтозватьИсх"
			Или Раздел = "ЗапроситьАннулированиеИсх" Или Раздел = "АннулироватьИсх" Или Раздел = "ОтклоненныеИсх"
				Или Раздел = "ОтправитьИсх" Или Раздел = "ПодписатьИсх"
				Или Раздел = "Черновики" Или Не ЗначениеЗаполнено(Раздел) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсходящиеДокументы, "ИспользоватьОтборДействий",
																						НастройкиОтбораДляВходящихИсходящих.ИспользоватьОтборДействий);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсходящиеДокументы, "Actions",
																						НастройкиОтбораДляВходящихИсходящих.Actions);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсходящиеДокументы, "ИспользоватьОтборСтатусов",
																						НастройкиОтбораДляВходящихИсходящих.ИспользоватьОтборСтатусов);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсходящиеДокументы, "Statuses",
																						НастройкиОтбораДляВходящихИсходящих.Statuses);
	КонецЕсли;
	
	Если Раздел = "Входящие" Или Раздел = "ПринятьВх"
			Или Раздел = "ПодписатьВх" Или Раздел = "АннулироватьВх"
				Или Раздел = "ЗапроситьАннулированиеВх" Или Раздел = "ПринятьКУчетуВх" Или Не ЗначениеЗаполнено(Раздел) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "ИспользоватьОтборДействий",
																						НастройкиОтбораДляВходящихИсходящих.ИспользоватьОтборДействий);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "Actions",
																						НастройкиОтбораДляВходящихИсходящих.Actions);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "ИспользоватьОтборСтатусов",
																						НастройкиОтбораДляВходящихИсходящих.ИспользоватьОтборСтатусов);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "Statuses",
																						НастройкиОтбораДляВходящихИсходящих.Statuses);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "ОтборПоНеПринятымКУчету",
																						НастройкиОтбораДляВходящихИсходящих.ОтборПоНеПринятымКУчету);
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ВходящиеДокументы, "ОтборПоЗавершенным",
																						НастройкиОтбораДляВходящихИсходящих.ОтборПоЗавершенным);
	КонецЕсли;
	
	Если ДоступнаРаботаСПриглашениями Тогда
		ФильтрСтатусовИсходящих = "Processed";
		ФильтрСтатусовВходящих = "Processed";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиОтбораСписковРаздела(Раздел = Неопределено)

	Результат = Новый Структура;
	
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		
		Результат.Вставить("ИспользоватьОтборДействий", Ложь);
		Результат.Вставить("Actions", Новый Массив);
		Результат.Вставить("Statuses", Новый Массив);
		Результат.Вставить("ИспользоватьОтборСтатусов", Ложь);
		Результат.Вставить("ОтборПоНеПринятымКУчету", Ложь);
		Результат.Вставить("ОтборПоЗавершенным", Ложь);
		
	Иначе
		
		ДействияРаздела = СоответствиеДействияРаздела(Раздел);
		ЕстьОтборПоДействиям = ДействияРаздела.Количество() > 0;
		СтатусыРаздела = СоответствиеСтатусыРаздела(Раздел);
		ЕстьОтборПоСтатусам = СтатусыРаздела.Количество() > 0;
		ЕстьОтборПоНеПринятымКУчету = СоответствиеЕстьОтборПоНеПринятымКУчету(Раздел);
		ЕстьОтборПоЗавершенным = СоответствиеЕстьОтборПоЗавершенным(Раздел);
		
		Результат.Вставить("Actions", ДействияРаздела);
		Результат.Вставить("ИспользоватьОтборДействий", ЕстьОтборПоДействиям);
		Результат.Вставить("Statuses", СтатусыРаздела);
		Результат.Вставить("ИспользоватьОтборСтатусов", ЕстьОтборПоСтатусам);
		Результат.Вставить("ОтборПоНеПринятымКУчету", ЕстьОтборПоНеПринятымКУчету);
		Результат.Вставить("ОтборПоЗавершенным", ЕстьОтборПоЗавершенным);
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкуАктивногоФильтраПоДокументам(АктивныйЭлемент)
	
	Для каждого ТекЭлемент Из Элементы.ДокументыКОтправкеГруппаФильтрДокументов.ПодчиненныеЭлементы Цикл
		Если АктивныйЭлемент = ТекЭлемент Тогда
			ТекЭлемент.Пометка = Истина;
		Иначе
			ТекЭлемент.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьАктивныйФильтрПоДокументам()
	
	Для каждого ТекЭлемент Из Элементы.ДокументыКОтправкеГруппаФильтрДокументов.ПодчиненныеЭлементы Цикл
		Если ТекЭлемент.Пометка Тогда
			Возврат ТекЭлемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

