&НаСервере
Функция СоответствияРазделовТаблицамДанных()
	
	СоответствияРазделовТаблицам = Новый Соответствие;
	СоответствияРазделовТаблицам.Вставить("ПодписатьИОтправить", "ДокументыКОтправке");
	СоответствияРазделовТаблицам.Вставить("ПодписатьКвитанции", "ДокументыСКвитанциями");
	СоответствияРазделовТаблицам.Вставить("ПринятьВх", "ВходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("ПодписатьВх", "ВходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("АннулироватьВх", "ВходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("ПринятьКУчетуВх", "ВходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("ОтозватьИсх", "ИсходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("АннулироватьИсх", "ИсходящиеДокументы");
	СоответствияРазделовТаблицам.Вставить("ОтклоненныеИсх", "ИсходящиеДокументы");
	
	Если ДоступнаРаботаСЧерновиками Тогда
		СоответствияРазделовТаблицам.Вставить("Черновики", "ИсходящиеДокументы");
		СоответствияРазделовТаблицам.Вставить("ПодписатьИсх", "ИсходящиеДокументы");
		СоответствияРазделовТаблицам.Вставить("ОтправитьИсх", "ИсходящиеДокументы");
	КонецЕсли;
	
	Если ДоступнаРаботаПоБизнесПроцессуУВХД Тогда
		СоответствияРазделовТаблицам.Вставить("ПодписатьИОтправитьУВХД", "ДокументыКОтправке");
	КонецЕсли;
	
	Возврат СоответствияРазделовТаблицам;
	
КонецФункции

&НаСервере
Функция СоответствияРазделовТаблицамФормы()
	
	СоответствияРазделовТаблицамФормы = Новый Соответствие;
	СоответствияРазделовТаблицамФормы.Вставить("ДокументыКОтправке", Элементы.ДокументыКОтправке);
	СоответствияРазделовТаблицамФормы.Вставить("ДокументыСКвитанциями", Элементы.ДокументыСКвитанциями);
	СоответствияРазделовТаблицамФормы.Вставить("ВходящиеДокументы", Элементы.ВходящиеДокументы);
	СоответствияРазделовТаблицамФормы.Вставить("ИсходящиеДокументы", Элементы.ИсходящиеДокументы);
	
	Если ДоступнаРаботаСПриглашениями Тогда
		СоответствияРазделовТаблицамФормы.Вставить("Приглашения", Элементы.Приглашения);
		СоответствияРазделовТаблицамФормы.Вставить("ТаблицаПриглашенийОтправленные", Элементы.ТаблицаПриглашенийОтправленные);
		СоответствияРазделовТаблицамФормы.Вставить("ТаблицаПриглашенийПринятые", Элементы.ТаблицаПриглашенийПринятые);
	КонецЕсли;
	
	Возврат СоответствияРазделовТаблицамФормы;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеСчетчикаОписанияРаздела(Имя, Количество)
	
	СтрокиОписанийРазделов = ОписаниеРазделов.НайтиСтроки(Новый Структура("Имя", Имя));
