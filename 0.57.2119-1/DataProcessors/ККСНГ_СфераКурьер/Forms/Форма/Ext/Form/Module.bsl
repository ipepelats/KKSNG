&НаСервереБезКонтекста
Процедура ЭлектронныеДокументПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Перем СвязанныеДокументы;
	Перем СтрокаСписка, ДанныеСтроки, Документ1С;
	Перем ПричиныОтклоненияИлиОтзыва, Причина;
	
	Для каждого СтрокаСписка Из Строки Цикл
		ДанныеСтроки = СтрокаСписка.Значение.Данные;
		Если ДанныеСтроки.Свойство("Документ1С") И ТипЗнч(ДанныеСтроки.Документ1С) = Тип("Строка") Тогда
			Документ1С = ККСНГ_ОбъектыИБВызовСервера.СсылкаНаСвязанныйДокументПоИдентификатору(ДанныеСтроки.Ссылка, ДанныеСтроки.Документ1С);
			Если Документ1С <> Неопределено Тогда
				ОформлениеПоля = СтрокаСписка.Значение.Оформление["Документ1С"];
				ОформлениеПоля.УстановитьЗначениеПараметра("Текст", Документ1С);
				ОформлениеПоля.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ИмяЭлемента = "ИсходящиеДокументы" И ДанныеСтроки.Свойство("StatusName") Тогда
		ПричиныОтклоненияИлиОтзыва = ПолучитьПричиныОтклоненияИлиОтзыва(Строки.ПолучитьКлючи());
		Для каждого СтрокаСписка Из Строки Цикл
			Причина = ПричиныОтклоненияИлиОтзыва[СтрокаСписка.Ключ];
			Если Не ПустаяСтрока(Причина) Тогда
				ДанныеСтроки = СтрокаСписка.Значение.Данные;
				ДанныеСтроки.StatusName = СтрШаблон("%1, %2", ДанныеСтроки.StatusName, Причина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// TODO Пересмотреть получение значений
	Если ДанныеСтроки.Свойство("БизнесПроцесс") Тогда
		ВывестиЗначениеБизнесПроцесса(Строки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПричиныОтклоненияИлиОтзыва(Документы)
	
	Перем Результат;
	Перем ТекстЗапроса, Запрос, Выборка;
	
	Результат = Новый Соответствие;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка КАК Ссылка,
	|	ККСНГ_ЭлектронныеДокументы.Status КАК Status,
	|	ККСНГ_ЭлектронныеДокументы.RejectReason КАК RejectReason,
	|	ККСНГ_ЭлектронныеДокументы.RevokeReason КАК RevokeReason
	|ИЗ
	|	Справочник.ККСНГ_ЭлектронныеДокументы КАК ККСНГ_ЭлектронныеДокументы
	|ГДЕ
	|	ККСНГ_ЭлектронныеДокументы.Ссылка В(&Документы)
	|	И (ККСНГ_ЭлектронныеДокументы.Status = ""Rejected""
	|			ИЛИ ККСНГ_ЭлектронныеДокументы.Status = ""Revoked"")";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документы", Документы);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.RejectReason + Выборка.RevokeReason);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПериодСпискаДокументовКОтправке()

	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыКОтправке,
									"НачалоПериода", ПериодКОтправке.ДатаНачала);
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыКОтправке,
									"КонецПериода", ПериодКОтправке.ДатаОкончания);
															
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокДокументовОтправке()
	
	ОбщийМодульДокументыКОтправке = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ДокументыКОтправке");
	ОтборВидыЭД = ОбщийМодульДокументыКОтправке.ПолучитьСписокВидовЭД();
	ТекстЗапросаКОтправке = ОбщийМодульДокументыКОтправке.ПолучитьТекстЗапросаДокументовКОтправке();
	ТекстЗапросаКОтправке = ПолучитьОбщийЗапросСДопРеквизитами(ТекстЗапросаКОтправке);
	ДокументыКОтправке.ТекстЗапроса = ТекстЗапросаКОтправке;
	
	ДокументыКОтправке.УстановитьОбязательноеИспользование("Ссылка", Истина);
	ДокументыКОтправке.УстановитьОбязательноеИспользование("ГотовКОтправке", Истина);
	
	ПериодКОтправке.Вариант = ВариантСтандартногоПериода.Вчера;
	ПериодКОтправке.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ПериодКОтправке.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());

	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыКОтправке, "ВариантНастройкиОбменаОрганизации", ККСНГ_ОбщегоНазначенияКлиентСервер.ВариантНастройкиОбменаОрганизации());
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыКОтправке, "ВариантыНастройкиОбменаДОП", ККСНГ_ОбщегоНазначенияВызовСервера.ВариантыНастройкиОбменаДОП());
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "ВидЭД", ОтборВидыЭД.ВыгрузитьЗначения(), ВидСравненияКомпоновкиДанных.ВСписке, , Истина);
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыКОтправке, "Новый", Истина, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОбщийЗапросСДопРеквизитами(ТекстЗапроса)
	
	ОбщийМодульДокументыКОтправке = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ДокументыКОтправке");
	
	СхемаЗапроса = Новый СхемаЗапроса();
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	ИндексПоследнейКолонки = ПакетЗапросов.Колонки.Количество()-1;
	Кол1 = ИндексПоследнейКолонки + 1;
	Кол2 = ИндексПоследнейКолонки + 2;
	Кол3 = ИндексПоследнейКолонки + 3;
	Кол4 = ИндексПоследнейКолонки + 4;
	// Доп. реквизиты УВХД
	Кол5 = ИндексПоследнейКолонки + 5;
	Кол6 = ИндексПоследнейКолонки + 6;
	
	Для Каждого Оператор Из ПакетЗапросов.Операторы Цикл
		
		//Первый запрос
		Если НЕ Оператор.Источники.Количество() Тогда
			Оператор.ВыбираемыеПоля.Добавить("NULL", Кол1);
			Оператор.ВыбираемыеПоля.Добавить("NULL", Кол2);
			Оператор.ВыбираемыеПоля.Добавить("NULL", Кол3);
			Оператор.ВыбираемыеПоля.Добавить("NULL", Кол4);
			// Доп. реквизиты УВХД
			Оператор.ВыбираемыеПоля.Добавить("ЛОЖЬ", Кол5);
			Оператор.ВыбираемыеПоля.Добавить("NULL", Кол6);
			Продолжить;
		КонецЕсли;
		
		// Запросы объединений
		Оператор.Источники.Добавить("РегистрСведений.ККСНГ_ПМ_ДопРеквизитыЭД", "ДопРеквизитыЭД");
		Оператор.Источники[Оператор.Источники.Количество()-1].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ПравоеВнешнее;
		
		Оператор.ВыбираемыеПоля.Добавить("ЕСТЬNULL(ДопРеквизитыЭД.УстановленыДопАтрибуты, ЛОЖЬ)", Кол1);
		Оператор.ВыбираемыеПоля.Добавить("ЕСТЬNULL(ДопРеквизитыЭД.ЕстьВложения, ЛОЖЬ)", Кол2);
		Оператор.ВыбираемыеПоля.Добавить("ЕСТЬNULL(ДопРеквизитыЭД.ЗаполненКомментарий, ЛОЖЬ)", Кол3);
		Оператор.ВыбираемыеПоля.Добавить("ВЫБОР
										|	КОГДА ДопРеквизитыЭД.СвязанныйДокумент ЕСТЬ NULL
										|	ТОГДА 0
										|ИНАЧЕ ВЫБОР
										|	КОГДА ДопРеквизитыЭД.ЕстьВложения
										|	ТОГДА 1
										|ИНАЧЕ 0
										|	КОНЕЦ + ВЫБОР
										|	КОГДА ДопРеквизитыЭД.УстановленыДопАтрибуты
										|	ТОГДА 2
										|ИНАЧЕ 0
										|	КОНЕЦ + ВЫБОР
										|	КОГДА ДопРеквизитыЭД.ЗаполненКомментарий
										|	ТОГДА 4
										|ИНАЧЕ 0
										|	КОНЕЦ
										|	КОНЕЦ", Кол4);
		// Доп. реквизиты УВХД
		Оператор.ВыбираемыеПоля.Добавить(ОбщийМодульДокументыКОтправке.ВыражениеЭтоКонтрагентСбер(), Кол5);
		Оператор.ВыбираемыеПоля.Добавить("NULL", Кол6);
	
	КонецЦикла;
	
	ПакетЗапросов.Колонки[Кол1].Псевдоним = "УстановленыДопАтрибуты";
	ПакетЗапросов.Колонки[Кол2].Псевдоним = "ЕстьВложения";
	ПакетЗапросов.Колонки[Кол3].Псевдоним = "ЗаполненКомментарий";
	ПакетЗапросов.Колонки[Кол4].Псевдоним = "УстановленыДопРеквизиты";
	// Доп. реквизиты УВХД
	ПакетЗапросов.Колонки[Кол5].Псевдоним = "ЭтоКонтрагентСбер";
	ПакетЗапросов.Колонки[Кол6].Псевдоним = "Примечание";
	
	НовыйТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Возврат НовыйТекстЗапроса;
	
КонецФункции

