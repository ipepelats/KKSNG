#Область УВХД

&НаСервере
Процедура ЗагрузитьСписокСопоставленийДоговоровУВХД(ПрофильКонтрагента = Неопределено)
	
	Если Не ПрофильКонтрагента = Неопределено Тогда
		НайденныеСтроки = СопоставленияДоговоров.НайтиСтроки(Новый Структура("Контрагент", ПрофильКонтрагента));
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			СопоставленияДоговоров.Удалить(НайденнаяСтрока);
		КонецЦикла;
	Иначе
		СопоставленияДоговоров.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорыУВХД.Договор1С КАК ДоговорЗначениеСвойства,
	|	ДоговорыУВХД.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.ККСНГ_Контрагенты.ДоговорыУВХД КАК ДоговорыУВХД
	|ГДЕ
	|	НЕ ДоговорыУВХД.Договор1С = ЗНАЧЕНИЕ(Справочник.ККСНГ_ЗначенияСвойствОбъектов.ПустаяСсылка)
	|	И ВЫБОР
	|			КОГДА &ПрофильКонтрагента = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДоговорыУВХД.Ссылка = &ПрофильКонтрагента
	|		КОНЕЦ
	|ИТОГИ ПО
	|	Контрагент";
	Запрос.УстановитьПараметр("ПрофильКонтрагента", ПрофильКонтрагента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтрагент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКонтрагент.Следующий() Цикл
		Выборка = ВыборкаКонтрагент.Выбрать();
		Пока Выборка.Следующий() Цикл
			Договор = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуОбъектаПоЗначениюСвойства(Выборка.ДоговорЗначениеСвойства);
			Если ЗначениеЗаполнено(Договор) Тогда
				СопоставленияНоваяСтрока = СопоставленияДоговоров.Добавить();
				СопоставленияНоваяСтрока.Контрагент = ВыборкаКонтрагент.Контрагент;
				СопоставленияНоваяСтрока.Договор = Договор;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСопоставленныхДоговоров()
	Возврат СопоставленияДоговоров.Выгрузить(, "Договор").ВыгрузитьКолонку("Договор");
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаПроверитьДокументыПоПроцессуУВХД(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПараметрыОтправки = Новый Структура();
		ПараметрыОтправки.Вставить("ПодписатьДанные", ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ПодписатьДанные", Ложь));
		
		ДанныеКОтправке = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ДанныеКОтправке", Ложь);
		ПродолжитьОтправкуДокументов(ДанныеКОтправке, ПараметрыОтправки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// TODO Вынести в общий модуль
&НаКлиенте
Процедура НачатьВыборДокумента1С(ДанныеДокумента)
	
	ОбщийМодуль = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуКлиент");
	ЗапросТиповДокументов1С = ОбщийМодуль.ТипыСвязанногоДокумента1С(ДанныеДокумента.ЭлектронныйДокумент, ДанныеДокумента.КодТипаДокумента, ДанныеДокумента.ЭтоВходящий);
	
	Если ЗапросТиповДокументов1С.Успех Тогда
		
		ОписаниеДоступныхТипов = ЗапросТиповДокументов1С.Результат;
		ОбработкаОповещения = Новый ОписаниеОповещения("ОбработчикЗавершенияВыбораПринятогоКУчетуДокумента", ЭтотОбъект, ДанныеДокумента);
		
		Документ1С = ККСНГ_ЭлектронныеДокументыВызовСервера.ПолучитьСвязанныйДокумент1С(ДанныеДокумента.ЭлектронныйДокумент);
		
		ПоказатьВводЗначения(ОбработкаОповещения, Документ1С, "Выбор документа принятого к учёту", ОписаниеДоступныхТипов);
		
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ЗапросТиповДокументов1С.Журнал, "-1");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияВыбораПринятогоКУчетуДокумента(ВыбЗначение, ДопПараметры) Экспорт

	Если ВыбЗначение <> Неопределено Тогда
		ККСНГ_ОбъектыИБВызовСервера.ЗаписатьСвязьЭлектронногоДокумента(ДопПараметры.ЭлектронныйДокумент, ВыбЗначение);
		Элементы.ВходящиеДокументы.Обновить();
		ОбновитьСчетчикиРазделовДокументов();
		
    КонецЕсли;

КонецПроцедуры

