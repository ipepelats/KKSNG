&НаКлиенте
Процедура ПодписатьДвоичныеДанныеЗавершение(Результат, ДопПараметры) Экспорт
			
	Если Не Результат.Успех Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	Ответ.Успех = Результат.Успех;
	ПараметрыАвторизации = ДопПараметры.ПараметрыАвторизации;
			
	МассивРезультатов = Результат.НаборДанных;
	
	Для Каждого ДанныеРезультата Из МассивРезультатов Цикл
		
		СпособОтправки = СпособОтправки("ПечатнаяФорма");
		Если ДанныеРезультата.Черновик Тогда
			
			ТекстПредупреждения = "Документ " + ДанныеРезультата.Filename + " сохранен в черновики.";
			ОтветОтправки = ККСНГ_ОтправкаЭДВызовСервера.ОтправитьНеструктурированныйДокументВКурьер(ДанныеРезультата, ПрофильНастройкиЭДО, ПараметрыАвторизации, , Ложь, СпособОтправки);
			
		Иначе
			
			Если ДанныеРезультата.Свойство("СвойстваПодписи") Тогда
				СвойстваПодписи = ККСНГ_ДокументооборотКлиентСервер.СвойстваПодписиИзРезультатаПодписания(ДанныеРезультата);
				Подпись = СвойстваПодписи.Подпись;
			КонецЕсли;
			
			ТекстПредупреждения = "Документ " + ДанныеРезультата.Filename + " отправлен.";
			
			Если СтрСравнить(ДанныеРезультата.ВариантОтправки, "Отправить") = 0 Тогда
				ОтветОтправки = ККСНГ_ОтправкаЭДВызовСервера.ОтправитьДокументНаКурьерСОбработкойЧерновика(ДанныеРезультата, ПрофильНастройкиЭДО, ПараметрыАвторизации, СпособОтправки);
			Иначе
				ОтветОтправки = ККСНГ_ОтправкаЭДВызовСервера.ОтправитьНеструктурированныйДокументВКурьер(ДанныеРезультата, ПрофильНастройкиЭДО, ПараметрыАвторизации, Подпись, Истина, СпособОтправки);
			КонецЕсли;
			
		КонецЕсли;
		
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ОтветОтправки.Журнал);
		ПоследняяОшибка = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(ОтветОтправки.Журнал);
		
		Если ОтветОтправки.Успех Тогда
			
			ОшибкаПодписания = ТипЗнч(ПоследняяОшибка) = Тип("Структура") И ПоследняяОшибка.КодОшибки = "ER-12001";
			Если ОшибкаПодписания Тогда
				ТекстПредупреждения = ТекстПредупреждения + " Подписание не требуется.";
			КонецЕсли;
			
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения);
			
		Иначе
			
			Если ТипЗнч(ПоследняяОшибка) = Тип("Структура") И СтрСравнить(ПоследняяОшибка.КодОшибки, "ER-12107") <> 0 Тогда
				Если СтрСравнить(ДанныеРезультата.ВариантОтправки, "Отправить") = 0 Тогда
					ПоследняяОшибка.Комментарий = "Документ " + ДанныеРезультата.Filename + " сохранен в черновики.";
				Иначе
					ПоследняяОшибка.Комментарий = "Документ " + ДанныеРезультата.Filename + " не удалось подписать.";
				КонецЕсли;
			КонецЕсли;
			
			ТекстСообщения = ККСНГ_ЛогированиеКлиентСервер.ТекстСообщения(ПоследняяОшибка);
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильНастройкиЭДО, ПараметрыАвторизации); 
			
		КонецЕсли;
		
		Ответ.Успех = Ответ.Успех И ОтветОтправки.Успех;
		
	КонецЦикла;
	
	Элементы.Список.ВыделенныеСтроки.Очистить();
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьДаннымиДинамическогоСписка(МассивДанныхКОтправке)

	СтруктураДополнения = Новый Структура("Дата, Номер, Получатель, Ссылка, Контрагент, ИсходныйДокумент");
	
	Для каждого ДанныеКОтправке Из МассивДанныхКОтправке Цикл
		
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(Элементы.Список.ТекущаяСтрока);
		Если Не ДанныеСтроки = Неопределено Тогда
			СтруктураДополнения.Дата = ДанныеСтроки.Дата;
			
			Если ЗначениеЗаполнено(ДанныеКОтправке.ОбъектПечати) И ТипЗнч(ДанныеКОтправке.ОбъектПечати) <> Тип("Строка") Тогда
				СтруктураДополнения.Номер = ПолучитьНомерНаПечатьПоСсылке(ДанныеКОтправке.ОбъектПечати);
			Иначе
				СтруктураДополнения.Номер = ДанныеСтроки.Номер;
			КонецЕсли;
			
			СтруктураДополнения.Получатель = ДанныеСтроки.ПрофильКонтрагента;
			СтруктураДополнения.Контрагент = ДанныеСтроки.Контрагент;
			СтруктураДополнения.Ссылка = ДанныеКОтправке.ОбъектПечати;
			СтруктураДополнения.ИсходныйДокумент = ДанныеСтроки.Ссылка;
			
		КонецЕсли;
		
		ККСНГ_ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеКОтправке, СтруктураДополнения); 
		
	КонецЦикла;
	
КонецПроцедуры

