&НаКлиенте
Процедура ДоговорыУВХДДоговорУВХДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещенияЗавершения = Новый ОписаниеОповещения("ВыборДоговораУВХДЗавершение", ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ПрофильНастройкиЭДО", Объект.Владелец);
	ПараметрыФормы.Вставить("Контрагент", Объект.Ссылка);
	
	Отбор = Новый Структура();
	Отбор.Вставить("ИсключитьСопоставленныеДоговоры", Истина);
	Отбор.Вставить("ВыбранныеДоговоры", ПолучитьВыбранныеДоговорыУВХД(Элементы.ДоговорыУВХД.ТекущиеДанные.ДоговорУВХД));
	Отбор.Вставить("КонтрагентСсылка", Объект.Ссылка);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("ОбщаяФорма.ККСНГ_ФормаВыбораДоговоровУВХД", ПараметрыФормы, , , , , ОписаниеОповещенияЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыУВХДПредставлениеДоговор1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещенияЗавершения = Новый ОписаниеОповещения("ВыборДоговора1СЗавершение", ЭтотОбъект);
	
	ТекущийДоговор1С = Элементы.ДоговорыУВХД.ТекущиеДанные.Договор1С;
	ИсключаемыеДоговоры1С = ПолучитьВыбранныеДоговоры1С(ТекущийДоговор1С);
	
	ОбщийМодульРаботаСМетаданнымиКлиент = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданнымиКлиент");
	ВидыДоговоров = ОбщийМодульРаботаСМетаданнымиКлиент.ВидыДоговоровПродажи();
	
	ДоговорыКонтрагентовВыбрать(ОписаниеОповещенияЗавершения, Элементы.ДоговорыУВХДПредставлениеДоговор1С, ТекущийДоговор1С, ИсключаемыеДоговоры1С, ВидыДоговоров);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборТипаДоговора1СПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = Неопределено Тогда
		ОткрытьФормуВыбораДоговора1С(ДополнительныеПараметры.ОповещениеОЗавершении, Результат.Значение);	
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораДоговора1С(ОписаниеОповещенияЗавершения,
									   ТипЗначения, 
									   ТекущийДоговор1С = Неопределено, 
									   ИсключаемыеДоговоры1С = Неопределено,
									   ВидыДоговоров = Неопределено) Экспорт
	
	ОбщийМодульРаботаСМетаданнымиКлиент = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданнымиКлиент");
	ОбщийМодульРаботаСМетаданнымиКлиент.ДоговорыКонтрагентовВыбрать(ТипЗначения,
																	Объект.Контрагент, 
																	ОрганизацияИзПрофиля(Объект.Владелец), 
																	ВидыДоговоров, , 
																	ИсключаемыеДоговоры1С, 
																	ОписаниеОповещенияЗавершения);
			
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыКонтрагентовВыбрать(ОписаниеОповещенияВыбора, ЭлементФормы, ТекущийДоговор1С = Неопределено, ИсключаемыеДоговоры1С = Неопределено, ВидыДоговоров = Неопределено)
	
	Договор1СТипы = ЭлементФормы.ОграничениеТипа.Типы();
	Если Договор1СТипы.Количество() = 1 Тогда
		
		ОткрытьФормуВыбораДоговора1С(ОписаниеОповещенияВыбора, Договор1СТипы[0], ТекущийДоговор1С, ИсключаемыеДоговоры1С, ВидыДоговоров = Неопределено);	
		
	ИначеЕсли Договор1СТипы.Количество() > 1 Тогда
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ОповещениеОЗавершении", ОписаниеОповещенияВыбора);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыборТипаДоговора1СПродолжение", ЭтотОбъект, ПараметрыОповещения);
		
		СписокТипов = Новый СписокЗначений;
		СписокТипов.ЗагрузитьЗначения(Договор1СТипы);
		СписокТипов.ПоказатьВыборЭлемента(ОписаниеОповещения, "Выберите тип");		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыУВХДПредставлениеДоговор1СОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДоговорыУВХД.ТекущиеДанные;
	ТекущиеДанные.Договор1С = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнфоПоляФХЖ

&НаСервере
Процедура ИнформационныеПоляФХЖ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьСоответствияДокументовТабличнымЧастям();
	ЗаполнитьСписокВыбораДокументов();
	ЗагрузитьХранилищеУсловийНаФорму();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСоответствияДокументовТабличнымЧастям()
	
	ОбщийМодульРаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	ДокументыВыбора = ОбщийМодульРаботаСМетаданными.ПолучитьДокументыВыбора();
	Для каждого ДокументВыбора Из ДокументыВыбора Цикл
		
		ТабличныеЧастиВыбора = ОбщийМодульРаботаСМетаданными.ПолучитьТабличныеЧастиДокументаВыбора(ДокументВыбора.Значение);
		Для каждого ТабличнаяЧастьВыбора Из ТабличныеЧастиВыбора Цикл
			СтрокаСоответствия = СоответствияДокументовТабличнымЧастям.Добавить();
			СтрокаСоответствия.Документ = ДокументВыбора.Значение;
			СтрокаСоответствия.ДокументПредставление = ДокументВыбора.Представление;
			СтрокаСоответствия.ТабличнаяЧасть = ТабличнаяЧастьВыбора.Значение;
			СтрокаСоответствия.ТабличнаяЧастьПредставление = ТабличнаяЧастьВыбора.Представление;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДокументов()
	
	ДокументыВыбора = ПолучитьДокументыВыбора();
	
	ЗагрузитьСписокЗначенийВСписокВыбора(Элементы.ИнформационныеПоляФХЖ1Документ.СписокВыбора, ДокументыВыбора);
	ЗагрузитьСписокЗначенийВСписокВыбора(Элементы.ИнформационныеПоляФХЖ2Документ.СписокВыбора, ДокументыВыбора);
	ЗагрузитьСписокЗначенийВСписокВыбора(Элементы.ИнформационныеПоляФХЖ3Документ.СписокВыбора, ДокументыВыбора);
	
	НастроитьУсловноеОформлениеСпискаВыбора(Элементы.ИнформационныеПоляФХЖ1Документ);
	НастроитьУсловноеОформлениеСпискаВыбора(Элементы.ИнформационныеПоляФХЖ2Документ);
	НастроитьУсловноеОформлениеСпискаВыбора(Элементы.ИнформационныеПоляФХЖ3Документ);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументыВыбора()
	
	ДокументыВыбора = Новый СписокЗначений;
	
	ДокументыОтбор = СоответствияДокументовТабличнымЧастям.Выгрузить(, "Документ, ДокументПредставление");
	ДокументыОтбор.Свернуть("Документ, ДокументПредставление");
	Для каждого СтрокаОтбора Из ДокументыОтбор Цикл
		ДокументыВыбора.Добавить(СтрокаОтбора.Документ, СтрокаОтбора.ДокументПредставление);	
	КонецЦикла;
	
	Возврат ДокументыВыбора;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТабличныеЧастиВыбораНаКлиенте(ДокументВыбора)
	
	ТабличныеЧастиВыбора = Новый СписокЗначений;
	
	ТабличныеЧастиОтбор = СоответствияДокументовТабличнымЧастям.НайтиСтроки(Новый Структура("Документ", ДокументВыбора));
	Для каждого СтрокаОтбора Из ТабличныеЧастиОтбор Цикл
		ТабличныеЧастиВыбора.Добавить(СтрокаОтбора.ТабличнаяЧасть, СтрокаОтбора.ТабличнаяЧастьПредставление);	
	КонецЦикла;
	
	Возврат ТабличныеЧастиВыбора;	
	
КонецФункции

&НаСервере
Процедура ЗагрузитьСписокЗначенийВСписокВыбора(СписокВыбора, ДанныеЗагрузки)
	
	Для каждого ЭлементЗагрузки Из ДанныеЗагрузки Цикл
		СписокВыбора.Добавить(ЭлементЗагрузки.Значение, ЭлементЗагрузки.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформлениеСпискаВыбора(ПолеФормы)
	
	Если ТипЗнч(ПолеФормы) = Тип("Строка") Тогда
		ПолеФормыВыбора = Элементы[ПолеФормы];
	Иначе
		ПолеФормыВыбора = ПолеФормы;
	КонецЕсли;
	
	Для каждого ЭлементВыбора Из ПолеФормыВыбора.СписокВыбора Цикл
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();

        ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементВыбора.Представление);

        // Условие
        ЭлементУсловия  = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеФормыВыбора.ПутьКДанным);
        ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        ЭлементУсловия.ПравоеЗначение = ЭлементВыбора.Значение;

        // Поле
        ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
        ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ПолеФормыВыбора.Имя);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьУсловияОтбораВСтроке(ТекущиеДанные, ДанныеОчистки)
	
	Для каждого ЭлементОчистки Из ДанныеОчистки Цикл
		ТекущиеДанные[ЭлементОчистки.Ключ] = ЭлементОчистки.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборУсловияОтбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	ТекущиеДанные.Условие = Результат.УсловиеПредставление;
	ТекущиеДанные.ХранилищеУсловийФорма = Результат.УсловиеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборТабличнойЧасти(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		
		ОчиститьУсловияОтбораВСтроке(ДополнительныеПараметры.ТекущиеДанные, Новый Структура("Условие, ХранилищеУсловийФорма, Формула"));
		
		ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
		ТекущиеДанные.ТабличнаяЧасть = Результат.Значение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗаполнениеФормулы(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	ТекущиеДанные.Использовать = ЗначениеЗаполнено(Результат);	
	
	Если НЕ Результат = Неопределено Тогда
		
		ТекущиеДанные.Формула = Результат;
		Модифицированность = Истина;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресСхемыКомпоновкиДанных(ТекстЗапроса)
	
	СхемаКомпоновки = ККСНГ_ОбщегоНазначения.ПолучитьСхемуКомпоновкиДанныхИзЗапроса(ТекстЗапроса);
	
	Возврат ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиУсловий(ТекущиеДанные, ДополнительныеПараметры)
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ТекущиеДанные", ТекущиеДанные);
	
	ОписаниеОповещенияВыборУсловияОтбора = Новый ОписаниеОповещения("ОбработатьВыборУсловияОтбора", ЭтотОбъект, ПараметрыОповещения);
	
	ИмяТаблицыЗапроса = ДополнительныеПараметры.ИмяТаблицыЗапроса;
	ТекстЗапроса = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьТекстЗапросаПоТаблице(ИмяТаблицыЗапроса);
		
	АдресСхемыКомпоновки = ПолучитьАдресСхемыКомпоновкиДанных(ТекстЗапроса);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("УсловиеОтбора", ТекущиеДанные.ХранилищеУсловийФорма);
	ПараметрыФормы.Вставить("АдресСхемыКомпоновки", АдресСхемыКомпоновки);
	
	ОткрытьФорму(
		"Справочник.ККСНГ_Контрагенты.Форма.ФормаНастроекУсловий", 
		ПараметрыФормы, 
		ЭтотОбъект, 
		, 
		, 
		, 
		ОписаниеОповещенияВыборУсловияОтбора, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКонструктораФормул(ТекущиеДанные, ДополнительныеПараметры)
	
	ИмяТаблицыЗапроса = ДополнительныеПараметры.ИмяТаблицыЗапроса;
	ТекстЗапроса = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьТекстЗапросаПоТаблице(ИмяТаблицыЗапроса);
	
	ПараметрыРедактированияШаблона = Новый Структура;
	ПараметрыРедактированияШаблона.Вставить("Формула", ТекущиеДанные.Формула);
	ПараметрыРедактированияШаблона.Вставить("АдресНабораОперандов", ПоместитьВоВременноеХранилище(ТекстЗапроса, УникальныйИдентификатор));
		
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ТекущиеДанные", ТекущиеДанные);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьЗаполнениеФормулы", ЭтотОбъект, ПараметрыОповещения);
	
	ОткрытьФорму(
		"ОбщаяФорма.ККСНГ_КонструкторФормул",
		ПараметрыРедактированияШаблона,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьХранилищеУсловийНаФорму(ТекущийОбъект = Неопределено, ТабличныеЧастиФХЖ = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");		               	
	КонецЕсли;
	
	Если ТабличныеЧастиФХЖ = Неопределено Тогда
		ТабличныеЧастиФХЖ = ПолучитьМассивТабличныхЧастейФХЖ();		
	КонецЕсли;
	
	Для каждого ТабличнаяЧастьФХЖ Из ТабличныеЧастиФХЖ Цикл
		
		Для каждого ТекущиеДанные Из Объект[ТабличнаяЧастьФХЖ] Цикл
			
			ТекущиеДанные.ХранилищеУсловийФорма = ТекущийОбъект[ТабличнаяЧастьФХЖ][ТекущиеДанные.НомерСтроки - 1].ХранилищеУсловий;				
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьХранилищеУсловийВОбъект(ТекущийОбъект = Неопределено, ТабличныеЧастиФХЖ = Неопределено)
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = РеквизитФормыВЗначение("Объект");		
	КонецЕсли;
	
	Если ТабличныеЧастиФХЖ = Неопределено Тогда
		ТабличныеЧастиФХЖ = ПолучитьМассивТабличныхЧастейФХЖ();		
	КонецЕсли;
	
	Для каждого ТабличнаяЧастьФХЖ Из ТабличныеЧастиФХЖ Цикл
		
		Для каждого ТекущиеДанные Из Объект[ТабличнаяЧастьФХЖ] Цикл
			
			ТекущийОбъект[ТабличнаяЧастьФХЖ][ТекущиеДанные.НомерСтроки - 1].ХранилищеУсловий = ТекущиеДанные.ХранилищеУсловийФорма;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивТабличныхЧастейФХЖ()
	
	ТабличныеЧастиФХЖ = Новый Массив;
	
	ТабличныеЧастиФХЖ.Добавить(Метаданные.Справочники.ККСНГ_Контрагенты.ТабличныеЧасти.ИнформационныеПоляФХЖ1.Имя);
	ТабличныеЧастиФХЖ.Добавить(Метаданные.Справочники.ККСНГ_Контрагенты.ТабличныеЧасти.ИнформационныеПоляФХЖ2.Имя);
	ТабличныеЧастиФХЖ.Добавить(Метаданные.Справочники.ККСНГ_Контрагенты.ТабличныеЧасти.ИнформационныеПоляФХЖ3.Имя);
	
	Возврат ТабличныеЧастиФХЖ;
	
КонецФункции

#КонецОбласти 

