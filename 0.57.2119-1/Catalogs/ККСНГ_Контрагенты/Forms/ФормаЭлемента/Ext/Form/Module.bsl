&НаСервере
Процедура ЗагрузитьПредставленияДоговоров()
	
	Для каждого СтрокаДоговораУВХД Из Объект.ДоговорыУВХД Цикл
		Договор1С = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(СтрокаДоговораУВХД, "Договор1С");
		СтрокаДоговораУВХД.ПредставлениеДоговор1С = Договор1С;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДоговораУВХДЗавершение(ВыбранныйДоговор, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныйДоговор = Неопределено Тогда
		
		Модифицированность = Истина;
		
		ТекущиеДанные = Элементы.ДоговорыУВХД.ТекущиеДанные;
		ТекущиеДанные.ДоговорУВХД = ВыбранныйДоговор;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДоговора1СЗавершение(ВыбранныйДоговор, ДополнительныеПараметры) Экспорт
	
	Если Не ВыбранныйДоговор = Неопределено Тогда
		
		Модифицированность = Истина;
		
		ТекущиеДанные = Элементы.ДоговорыУВХД.ТекущиеДанные;
		ТекущиеДанные.Договор1С = ПолучитьСсылкуЗначенияСвойства(ВыбранныйДоговор);
		ТекущиеДанные.ПредставлениеДоговор1С = Строка(ВыбранныйДоговор);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьВыбранныеДоговоры1С(ТекущийДоговор1С = Неопределено)
	
	ВыбранныеДоговоры1С = Новый Массив();
	Для каждого СтрокаДоговорыУВХД Из Объект.ДоговорыУВХД Цикл
		
		Если СтрокаДоговорыУВХД.Договор1С = ТекущийДоговор1С Тогда
			Продолжить;	
		КонецЕсли;
		
		Договор1С = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(СтрокаДоговорыУВХД, "Договор1С");
		Если Не Договор1С = Неопределено Тогда
			ВыбранныеДоговоры1С.Добавить(Договор1С);				
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ВыбранныеДоговоры1С;
	
КонецФункции

&НаСервере
Функция ПолучитьВыбранныеДоговорыУВХД(ТекущийДоговорУВХД = Неопределено)
	
	ВыбранныеДоговорыУВХД = Новый Массив();
	Для каждого СтрокаДоговорыУВХД Из Объект.ДоговорыУВХД Цикл
		
		ВыбранныйДоговорУВХД = СтрокаДоговорыУВХД.ДоговорУВХД;
		
		Если ТекущийДоговорУВХД = ВыбранныйДоговорУВХД Тогда
			Продолжить;			
		КонецЕсли;				
		
		Если ЗначениеЗаполнено(ВыбранныйДоговорУВХД) Тогда
			ВыбранныеДоговорыУВХД.Добавить(ВыбранныйДоговорУВХД);				
		КонецЕсли;	
		
	КонецЦикла;

	Возврат ВыбранныеДоговорыУВХД;
	
КонецФункции

