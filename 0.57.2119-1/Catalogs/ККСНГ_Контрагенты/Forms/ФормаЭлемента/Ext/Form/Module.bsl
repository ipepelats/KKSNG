
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем НастройкаПоУмолчанию;
	Перем СписокВариантовОтправки, ВариантОтправкиМЧД;
	Перем ДоступныйВариант, ВариантыНастроекОбмена, НекийФормат;
	Перем ТаблицаФорматов, ВариантНастройкиОтбора, Отбор;
	Перем ТекПрофильЭДО, МодульККСНГ_ПМ_РаботаСМетаданными;
	
	НастройкаПоУмолчанию = "Использовать настройки организации";
	ЭтотОбъект.ВариантНастроекОрганизации = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьДоступныйФорматЭлектронногоДокумента(Объект.Владелец.ВариантНастройкиОбмена);
	
	// Варианты отправки МЧД 
	СписокВариантовОтправки = Элементы.ВариантОтправкиМЧД.СписокВыбора;
	ВариантОтправкиМЧД = ККСНГ_МашиночитаемыеДоверенности.ДоступныеВариантыОтправкиДоверенности();
	
	СписокВариантовОтправки.Очистить();
	
	СписокВариантовОтправки.Добавить("", НастройкаПоУмолчанию);
	Для каждого ДоступныйВариант Из ВариантОтправкиМЧД Цикл
		СписокВариантовОтправки.Добавить(ДоступныйВариант.Значение, ДоступныйВариант.Представление);
	КонецЦикла;
	
	Если СписокВариантовОтправки.НайтиПоЗначению(Объект.ВариантОтправкиМЧД) = Неопределено И СписокВариантовОтправки.Количество() > 0 Тогда
		Объект.ВариантОтправкиМЧД = СписокВариантовОтправки[0].Значение;
	КонецЕсли;
	
	// Варианты настроек обмена ФНС
	ВариантыНастроекОбмена = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВариантыФорматовЭлектронныхДокументов();
	
	Элементы.СписокВариантовНастроекОбмена.СписокВыбора.Вставить(0, НастройкаПоУмолчанию);
	Для каждого НекийФормат Из ВариантыНастроекОбмена Цикл
		Элементы.СписокВариантовНастроекОбмена.СписокВыбора.Добавить(НекийФормат);
	КонецЦикла;
	Если Объект.ВариантНастройкиОбмена <> НастройкаПоУмолчанию Тогда
		Объект.ВариантНастройкиОбмена = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьДоступныйФорматЭлектронногоДокумента(Объект.ВариантНастройкиОбмена);
	КонецЕсли;
	
	// Таблица форматов ФНС
	ТаблицаФорматов = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьФорматыЭлектронныхДокументов();
	
	ИсходящиеДокументы.Загрузить(ТаблицаФорматов);
	
	ВариантНастройкиОтбора = ?(Объект.ВариантНастройкиОбмена = НастройкаПоУмолчанию, ВариантНастроекОрганизации, Объект.ВариантНастройкиОбмена);
	ВариантНастройкиОтбора = ?(ЗначениеЗаполнено(ВариантНастройкиОтбора), ВариантНастройкиОтбора, "_");
	Отбор = Новый ФиксированнаяСтруктура("НаименованиеВарианта", ВариантНастройкиОтбора);
	Элементы.ИсходящиеДокументы.ОтборСтрок = Отбор;
	
	ТекПрофильЭДО = Объект.Владелец;
	
	// Устанавливаем ограничение типов для реквизитов
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	Если Не МодульККСНГ_ПМ_РаботаСМетаданными = Неопределено Тогда
		
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.Договор, "ДоговорыСоглашения");
		Элементы.Договор.Видимость = Элементы.Договор.ОграничениеТипа.Типы().Количество(); 
		
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.ДоговорыУВХДПредставлениеДоговор1С, "ДоговорыСоглашения");
		
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.Склад, "Склады");
		Элементы.Склад.Видимость = Элементы.Склад.ОграничениеТипа.Типы().Количество();
		
	КонецЕсли;
	
	Если Не Отказ И ЗначениеЗаполнено(ТекПрофильЭДО) И Не ККСНГ_ОбщегоНазначенияВызовСервера.ПрофильЭДОДоступенПользователю(ТекПрофильЭДО) Тогда
		Отказ = Истина;
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У пользователя недостаточно прав для совершения операции.");
	Иначе
		ККСНГ_ОбщегоНазначенияКлиентСервер.УстановитьПараметрыВыбораПрофилейЭДО(ТекПрофильЭДО, Элементы.Владелец, Истина);
	КонецЕсли;
	
	ИнформационныеПоляФХЖ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка);
	
	ЗагрузитьПредставленияДоговоров();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ТекущийВариантНастройкиОбмена) Тогда
		ТекущийВариантНастройкиОбмена = Объект.ВариантНастройкиОбмена;
	КонецЕсли;
	
	ОбновитьОтображениеЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Склад) Тогда
		Попытка
			ЭтотОбъект.Склад = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ТекущийОбъект, "Склад");
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Договор) Тогда
		Попытка
			ЭтотОбъект.Договор = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ТекущийОбъект, "Договор");
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Склад", ЭтотОбъект.Склад);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Договор", ЭтотОбъект.Договор);
	
	ЗагрузитьХранилищеУсловийВОбъект(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗагрузитьХранилищеУсловийНаФорму(ТекущийОбъект);
	
	ЗагрузитьПредставленияДоговоров();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ТекущийВариантНастройкиОбмена <> Объект.ВариантНастройкиОбмена Тогда
		ПараметрыСобытия = Новый Структура;
		ПараметрыСобытия.Вставить("ПрофильЭДООрганизации", Объект.Владелец);
		ПараметрыСобытия.Вставить("КодУчастникаЭДООрганизации", КодЭДОВладельца(Объект.Владелец));
		ПараметрыСобытия.Вставить("КодУчастникаЭДОКонтрагента", Объект.КодУчастникаЭДО);
		ПараметрыСобытия.Вставить("НовыйВариантНастройкиОбмена", Объект.ВариантНастройкиОбмена);
		Оповестить("ОбновитьКОтправке", ПараметрыСобытия, ЭтотОбъект); 
		ТекущийВариантНастройкиОбмена = Объект.ВариантНастройкиОбмена;
	КонецЕсли;
	
	ОбновитьОтображениеЭлементов();
	
	Оповестить("ЗаписьКонтрагентаЭДО", Объект.Ссылка, Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантНастройкиОбменаПриИзменении(Элемент)
		
	ВариантНастройкиОтбора = ?(Объект.ВариантНастройкиОбмена = "Использовать настройки организации", ВариантНастроекОрганизации, Объект.ВариантНастройкиОбмена);
	ВариантНастройкиОтбора = ?(ЗначениеЗаполнено(ВариантНастройкиОтбора), ВариантНастройкиОтбора, "_");
	Отбор = Новый ФиксированнаяСтруктура("НаименованиеВарианта", ВариантНастройкиОтбора);
	Элементы.ИсходящиеДокументы.ОтборСтрок = Отбор;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещенияЗавершения = Новый ОписаниеОповещения("ДоговорНачалоВыбораЗавершение", ЭтотОбъект);
	
	ОбщийМодульРаботаСМетаданнымиКлиент = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданнымиКлиент");
	ВидыДоговоров = ОбщийМодульРаботаСМетаданнымиКлиент.ВидыДоговоровЗакупки();
	
	ДоговорыКонтрагентовВыбрать(ОписаниеОповещенияЗавершения, Элементы.ДоговорыУВХДПредставлениеДоговор1С, Договор, , ВидыДоговоров);
		
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбораЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЭтотОбъект.Договор = Результат;	
	КонецЕсли; 	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОрганизацияИзПрофиля(ПрофильЭДООрганизации)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПрофильЭДООрганизации, "Организация", Истина);
КонецФункции

&НаКлиенте
Процедура ВладелецОчистка(Элемент, СтандартнаяОбработка)
	ЗадатьВопросПриИзмененииКонтрагента(Модифицированность);
КонецПроцедуры

&НаКлиенте
Процедура ВладелецОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЗадатьВопросПриИзмененииКонтрагента(Модифицированность);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКонтрагентаОрганизации()
	
	ОбновитьОтображениеЭлементов();
	
	Объект.Договор = Неопределено;
	
	Объект.ДоговорыУВХД.Очистить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодЭДОВладельца(ТекущийВладелец)
	
	Возврат ТекущийВладелец.КодУчастникаЭДО;
	
КонецФункции

&НаКлиенте
Процедура КодУчастникаЭДОПриИзменении(Элемент)
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.ФорматироватьКодУчастникаЭДО(Объект.КодУчастникаЭДО);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОчистка(Элемент, СтандартнаяОбработка)
	ЗадатьВопросПриИзмененииКонтрагента(Модифицированность);
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЗадатьВопросПриИзмененииКонтрагента(Модифицированность);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнформационныеПоляФХЖ1

&НаКлиенте
Процедура ИнформационныеПоляФХЖ1ИдентификаторПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ1.ТекущиеДанные;
	ТекущиеДанные.Использовать = ЗначениеЗаполнено(ТекущиеДанные.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ1ДокументПриИзменении(Элемент)
	
	ОчиститьУсловияОтбораВСтроке(Элементы.ИнформационныеПоляФХЖ1.ТекущиеДанные, Новый Структура("Условие, ХранилищеУсловийФорма, Формула"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ1ФормулаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ1.ТекущиеДанные;
	ПараметрыОткрытияФормы = Новый Структура("ИмяТаблицыЗапроса", ТекущиеДанные.Документ);
	
	ОткрытьФормуКонструктораФормул(ТекущиеДанные, ПараметрыОткрытияФормы);
	
КонецПроцедуры	

&НаКлиенте
Процедура ИнформационныеПоляФХЖ1УсловиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ1.ТекущиеДанные;
	ПараметрыОткрытияФормы = Новый Структура("ИмяТаблицыЗапроса", ТекущиеДанные.Документ);

	ОткрытьФормуНастройкиУсловий(ТекущиеДанные, ПараметрыОткрытияФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ1УсловиеОчистка(Элемент, СтандартнаяОбработка)
	
	ОчиститьУсловияОтбораВСтроке(Элементы.ИнформационныеПоляФХЖ1.ТекущиеДанные, Новый Структура("ХранилищеУсловийФорма"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнформационныеПоляФХЖ2

&НаКлиенте
Процедура ИнформационныеПоляФХЖ2ДокументПриИзменении(Элемент)
	
	СтруктураОтбора = Новый Структура("Использовать, Условие, ХранилищеУсловийФорма, Формула, ТабличнаяЧасть", Ложь);
	ОчиститьУсловияОтбораВСтроке(Элементы.ИнформационныеПоляФХЖ2.ТекущиеДанные, СтруктураОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ2ТабличнаяЧастьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ2.ТекущиеДанные;
	СписокТабличныхЧастей = ПолучитьТабличныеЧастиВыбораНаКлиенте(ТекущиеДанные.Документ);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ТекущиеДанные", ТекущиеДанные);
	
	ОписаниеОповещенияВыбора = Новый ОписаниеОповещения("ОбработатьВыборТабличнойЧасти", ЭтотОбъект, ПараметрыОповещения);
	
	ПоказатьВыборИзСписка(ОписаниеОповещенияВыбора, СписокТабличныхЧастей);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ2ТабличнаяЧастьОчистка(Элемент, СтандартнаяОбработка)
	
	СтруктураОтбора = Новый Структура("Использовать, Формула, Условие, Условие, ХранилищеУсловийФорма", Ложь);
	ОчиститьУсловияОтбораВСтроке(Элементы.ИнформационныеПоляФХЖ2.ТекущиеДанные, СтруктураОтбора);	
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеПоляФХЖ2ФормулаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ2.ТекущиеДанные;
	ИмяТаблицыЗапроса = ТекущиеДанные.Документ + ?(ЗначениеЗаполнено(ТекущиеДанные.ТабличнаяЧасть), "." + ТекущиеДанные.ТабличнаяЧасть, "");
	ПараметрыОткрытияФормы = Новый Структура("ИмяТаблицыЗапроса", ИмяТаблицыЗапроса);
	
	ОткрытьФормуКонструктораФормул(ТекущиеДанные, ПараметрыОткрытияФормы);
	
КонецПроцедуры	

&НаКлиенте
Процедура ИнформационныеПоляФХЖ2УсловиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ИнформационныеПоляФХЖ2.ТекущиеДанные;
	ИмяТаблицыЗапроса = ТекущиеДанные.Документ + ?(ЗначениеЗаполнено(ТекущиеДанные.ТабличнаяЧасть), "." + ТекущиеДанные.ТабличнаяЧасть, "");
	ПараметрыОткрытияФормы = Новый Структура("ИмяТаблицыЗапроса", ИмяТаблицыЗапроса);
	
	ОткрытьФормуНастройкиУсловий(ТекущиеДанные, ПараметрыОткрытияФормы);
	
КонецПроцедуры

