&НаКлиенте
Процедура ОбработкаВыбораПриИзмененииКонтрагента(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт

	Если ВыбранноеЗначение = КодВозвратаДиалога.Отмена И НЕ ДополнительныеПараметры = Неопределено Тогда
		Объект.Контрагент = ДополнительныеПараметры.КонтрагентДоИзменения;
		Объект.Владелец = ДополнительныеПараметры.ОрганизацияДоИзменения;
		ЭтаФорма.Модифицированность = ДополнительныеПараметры.ЗначенияМодифицированности;
	Иначе
		ПриИзмененииКонтрагентаОрганизации();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросПриИзмененииКонтрагента(ЗначенияМодифицированности)

	Если Объект.ДоговорыУВХД.Количество() = 0 Тогда
	
		ОбработкаВыбораПриИзмененииКонтрагента(КодВозвратаДиалога.ОК);
		Возврат;
	
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ОКОтмена;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КонтрагентДоИзменения", Объект.Контрагент);
	ДополнительныеПараметры.Вставить("ОрганизацияДоИзменения", Объект.Владелец);
	ДополнительныеПараметры.Вставить("ЗначенияМодифицированности", ЗначенияМодифицированности);
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораПриИзмененииКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
	ТекстВопроса = "При изменении контрагента таблица сопоставления договоров будет очищена. Изменить контрагента?";

	ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0, КодВозвратаДиалога.ОК);		

КонецПроцедуры

