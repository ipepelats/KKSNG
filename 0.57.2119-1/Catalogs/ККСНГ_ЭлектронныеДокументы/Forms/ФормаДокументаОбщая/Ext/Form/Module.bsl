КонецПроцедуры

&НаКлиенте
Процедура ЭкспортДляФНСПродолжение(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт

	Если ЗапросПараметрыАвторизации.Успех Тогда
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;

		ОтветАрхивФНС = АрхивДляФНС(Объект.Id, Объект.Type, ПараметрыАвторизации);

		Если ОтветАрхивФНС.Успех Тогда
			АрхивДвоичныеДанные = ОтветАрхивФНС.Результат;
			ВыбранныйКаталог = ДопПараметры.ВыбранныйКаталог;

			Слеш = ПолучитьРазделительПути();
			Если Прав(ВыбранныйКаталог, 1) <> Слеш Тогда
				ВыбранныйКаталог = ВыбранныйКаталог + Слеш;
			КонецЕсли;

			ДатаФормирования = Формат(ККСНГ_ОбщегоНазначенияВызовСервера.ТекущаяДатаВремяСеанса(), "ДФ=dd_MM_yyyy_ЧЧ_мм");
			ИмяАрхива = ВыбранныйКаталог + "exportFNS_" + ДатаФормирования + ".zip";
			ДопПараметры = Новый Структура("ИмяАрхива", ИмяАрхива);
			ОписаниеОповещения = Новый ОписаниеОповещения("ЭкспортПослеЗаписиАрхива", ЭтотОбъект, ДопПараметры);
			АрхивДвоичныеДанные.НачатьЗапись(ОписаниеОповещения, ИмяАрхива);

		Иначе
			ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильЭДООрганизации, ПараметрыАвторизации);
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ОтветАрхивФНС.Журнал);
		КонецЕсли;
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортПослеЗаписиАрхива(ДопПараметры) Экспорт

	Файл = Новый Файл(ДопПараметры.ИмяАрхива);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаСсылкуФайла", ЭтотОбъект, Файл.ПолноеИмя);
	ПоказатьОповещениеПользователя("Архив сохранен", ОписаниеОповещения, Файл.Имя, БиблиотекаКартинок.СохранитьФайл);

КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаСсылкуФайла(ДополнительныеПараметры) Экспорт

	#Если ВебКлиент Тогда
		Если Не РаботаСФайламиСлужебныйКлиент.РасширениеРаботыСФайламиПодключено() Тогда
			РаботаСФайламиСлужебныйКлиент.ПоказатьПредупреждениеОНеобходимостиРасширенияРаботыСФайлами(Неопределено);
			Возврат;
		КонецЕсли;
	#КонецЕсли

	Если ТипЗнч(ДополнительныеПараметры) = Тип("Строка") И Не ПустаяСтрока(ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиент.ОткрытьПроводник(ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АрхивДляФНС(ДокументId, ТипТранспортногоДокумента, ПараметрыАвторизации)

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();

	ЗапросКвитанций = ККСНГ_APIКурьер.v1_TicketsTickets(ПараметрыАвторизации, ДокументId);
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросКвитанций.Журнал, Ложь);

	Если ЗапросКвитанций.Успех Тогда
		
		Квитанции = ЗапросКвитанций.Результат.TicketDetails;
		ИмяВременногоКаталога = ПолучитьИмяВременногоФайла("");
		Слеш = ПолучитьРазделительПути();
		ВнутриКаталога = ИмяВременногоКаталога + Слеш;
		ВыгружаемыеТипыКвитанций = Новый Массив;
		
		Если ККСНГ_ОбщегоНазначенияВызовСервера.ТребуютсяПодписиДвухСторон(ТипТранспортногоДокумента) Тогда
			ВыгружаемыеТипыКвитанций =
					ККСНГ_ЭлектронныеДокументыВызовСервера.МассивТиповТранспортныхДокументовТитулПокупателя();
		КонецЕсли;

		Для каждого ТекКвитанция Из Квитанции Цикл
			Если ТекКвитанция.ExtendedType = "Document"
					Или ВыгружаемыеТипыКвитанций.Найти(ТекКвитанция.Type) <> Неопределено Тогда
			    ДанныеСодержимого = ТекКвитанция.Content;
				ФайлДляИмен = Новый Файл(ВнутриКаталога + ДанныеСодержимого.Filename);
				ФайлДвоичныеДанные = ДанныеСодержимого.Content;
			    ФайлДвоичныеДанные.Записать(ФайлДляИмен.ПолноеИмя);
				ОбработатьПодписиКвитанции(ТекКвитанция.Signature, ФайлДляИмен, ВнутриКаталога);
			КонецЕсли;
		КонецЦикла;

		ЗаписьZIP = Новый ЗаписьZipФайла();
		ЗаписьZIP.Добавить(ВнутриКаталога + "*", РежимСохраненияПутейZIP.НеСохранятьПути);
		АрхивДвоичныеДанные = ЗаписьZIP.ПолучитьДвоичныеДанные();
		УдалитьФайлы(ИмяВременногоКаталога);

		Ответ.Успех = ТипЗнч(АрхивДвоичныеДанные) = Тип("ДвоичныеДанные");
		
	КонецЕсли;

	Ответ.Результат = АрхивДвоичныеДанные;

	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Процедура ОбработатьПодписиКвитанции(Подписи, ФайлШаблон, КаталогПуть)
	
	ИндексПодписи = 0;
	Для каждого Подпись Из Подписи Цикл
		ПодписьДвоичныеДанные = Подпись.Content;
		ИмяФайлаПодписи = КаталогПуть + ФайлШаблон.ИмяБезРасширения
								+ "SGN" + ?(ИндексПодписи > 0, ИндексПодписи, "") + ".sgn";
		ПодписьДвоичныеДанные.Записать(ИмяФайлаПодписи);
		ИндексПодписи = ИндексПодписи + 1;
	КонецЦикла;
	
КонецПроцедуры

