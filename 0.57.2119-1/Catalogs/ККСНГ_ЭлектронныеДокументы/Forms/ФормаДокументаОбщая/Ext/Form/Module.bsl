			ОбновитьКарточкуДокумента(Ложь);
		Иначе 
			ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросИстории.Журнал);
		КонецЕсли;
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьТаблицуИсторииНаСервере(ПараметрыАвторизации)

	ИсторияОбработки.Очистить();

	Ответ = ККСНГ_ДокументооборотВызовСервера.ПолучитьИсториюЭДИзКурьера(Объект.Id, ПараметрыАвторизации);

	Если Ответ.Успех Тогда

		Статусы = СтруктураСтатусовДокумента();
		МассивИстории = Ответ.Результат.DocumentHistory;

		Если ТипЗнч(МассивИстории) = Тип("Массив") Тогда

			Для Каждого ЭлементИстории Из МассивИстории Цикл
				НоваяСтрокаИстории = ИсторияОбработки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаИстории, ЭлементИстории);
				Статусы.Свойство(НоваяСтрокаИстории.Status, НоваяСтрокаИстории.СтатусКод);
			КонецЦикла;

		КонецЕсли;

	КонецЕсли;
	
	#Область ОбновлениеСтатусовВРоуминге

	СтатусыДокументаБезРоуминга = СтрРазделить("Draft,ToSign,Revoked,WaitingForSend", ",", Ложь);
	Если Объект.IsRoaming И СтатусыДокументаБезРоуминга.Найти(СокрЛП(Объект.Status)) = Неопределено Тогда 
		
		ЗапросСтатусовВРоуминге = ККСНГ_ДокументооборотВызовСервера.ПолучитьСтатусыВРоуминге(Объект.Ссылка, ПрофильЭДООрганизации, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросСтатусовВРоуминге.Журнал, Ложь);
		Если ЗапросСтатусовВРоуминге.Успех Тогда 
			АктуальныеСтатусы = ЗапросСтатусовВРоуминге.Результат;
			СтатусыВРоумингеСКодами = ККСНГ_ДокументооборотВызовСервера.КодыСтатусовВРоуминге();
			Для каждого ТекСтатус Из АктуальныеСтатусы Цикл
				
				НоваяСтрокаИстории = ИсторияОбработки.Добавить();
				НоваяСтрокаИстории.Date = ТекСтатус.StatusDate;
				НоваяСтрокаИстории.Status = ТекСтатус.RoamingStatus;
				НоваяСтрокаИстории.StatusName = ТекСтатус.ПредставлениеСтатуса;
				НоваяСтрокаИстории.Comment = "Роуминг: " + ТекСтатус.ПредставлениеДокумента;

				СтатусыВРоумингеСКодами.Свойство(НоваяСтрокаИстории.Status, НоваяСтрокаИстории.СтатусКод);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	// ОбновлениеСтатусовВРоуминге
	#КонецОбласти
	
	ИсторияОбработки.Сортировать("Date Убыв, СтатусКод Убыв");
		
	Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция СтруктураСтатусовДокумента()

	Статусы = Новый Структура;
	Статусы.Вставить("None", 0);
	Статусы.Вставить("Draft", 1);
	Статусы.Вставить("ToSign", 2);
	Статусы.Вставить("Prepared", 3);
	Статусы.Вставить("IsRead", 4);
	Статусы.Вставить("OnAgreement", 5);
	Статусы.Вставить("Signed", 6);
	Статусы.Вставить("Rejected", 7);
	Статусы.Вставить("Accepted", 9);
	Статусы.Вставить("OnRevocation", 10);
	Статусы.Вставить("Revoked", 11);
	Статусы.Вставить("Sended", 12);
	Статусы.Вставить("Delivered", 13);
	Статусы.Вставить("Received", 14);
	Статусы.Вставить("NoRoute", 15);
	Статусы.Вставить("RequestedAvoidance", 16);
	Статусы.Вставить("RejectedAvoidance", 17);
	Статусы.Вставить("AcceptedAvoidance", 18);
	Статусы.Вставить("ClarificationRequested", 19);
	Статусы.Вставить("WaitingForSend", 20);

	Возврат Статусы;

КонецФункции

#КонецОбласти

#Область ПринятиеКУчетуИСвязьДокументов

&НаКлиенте
Процедура ОбработчикЗавершенияВыбораДействияИзМеню(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		Если ВыбранныйЭлемент.Значение = "Принять к учёту в 1С" Тогда
			ПараметрыФормы = Новый Структура("Объект, ЕстьМаркировка", Объект.Ссылка, Объект.ЕстьМаркировка);
			ПараметрыЗавершенияПринятияКУчету = Новый Структура("Документ1С", Документ1С);
			
			ОбработчикЗавершенияПринятияКУчету = Новый ОписаниеОповещения("ОбработчикЗавершенияПринятияКУчету",
			ЭтотОбъект, ПараметрыЗавершенияПринятияКУчету);
			
			ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуКлиент");
			ОбщийМодульПринятиеКУчету.ОткрытьФормуПринятияКУчету(ПараметрыФормы, ЭтотОбъект, Объект.Id, ОбработчикЗавершенияПринятияКУчету);
					
		ИначеЕсли ВыбранныйЭлемент.Значение = "Выбрать ранее учтённый" Тогда
			НачатьВыборДокумента1С();
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияПринятияКУчету(РезЗакрытия, ДополнительныеПараметры) Экспорт

	Документ1С = ККСНГ_ЭлектронныеДокументыВызовСервера.ПолучитьСвязанныйДокумент1С(Объект.Ссылка);
	ОбновитьСтатусУчета();
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборДокумента1С()
	
	ОбщийМодуль = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуКлиент");
	ЗапросТиповДокументов1С = ОбщийМодуль.ТипыСвязанногоДокумента1С(Объект.Ссылка, Объект.DocumentTypeCode, ЭтоВходящий);
	Если Не ЗапросТиповДокументов1С.Успех Тогда
		ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ЗапросТиповДокументов1С.Журнал, "-1");
		Возврат;
	КонецЕсли;
	
	ОписаниеТиповК = ЗапросТиповДокументов1С.Результат;
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ОбработчикЗавершенияВыбораПринятогоКУчетуДокумента", ЭтотОбъект);

	ПоказатьВводЗначения(ОбработкаОповещения, Документ1С, "Выбор документа принятого к учёту", ОписаниеТиповК);

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияВыбораПринятогоКУчетуДокумента(ВыбЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбЗначение <> Неопределено Тогда
		Документ1С = ВыбЗначение;
		
		ККСНГ_ОбъектыИБВызовСервера.ЗаписатьСвязьЭлектронногоДокумента(Объект.Ссылка, Документ1С);
		ОбновитьСтатусУчета();
		// TODO Пересмотреть оповещения электронных документов, сейчас по аналогии с принятием к учету
		ОповеститьОбИзменении(Объект.Ссылка);
		Оповестить("ПослеКомандыСФЕРАКурьер");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусУчета()

	Если ЗначениеЗаполнено(Документ1С) Тогда
		Элементы.ДекорацияПодсказкаВыбора.Видимость = Ложь;
		Элементы.ДекорацияДокумент1С.Заголовок = СокрЛП(Документ1С);
		Элементы.ДекорацияДокумент1С.Подсказка = "Связанный документ 1С";
	Иначе
		Элементы.ДекорацияПодсказкаВыбора.Видимость = Не ПринятиеКУчетуДоступно;
		Элементы.ДекорацияДокумент1С.Заголовок = ?(ПринятиеКУчетуДоступно, "не учтён", "выбрать документ 1С");
		Элементы.ДекорацияДокумент1С.Подсказка = ?(ПринятиеКУчетуДоступно, "Связанный документ 1С", 
			"Для документа принятие к учету недоступно. Выберите созданный самостоятельно связанный документ 1С.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСВложениями

&НаКлиенте
Процедура ОбновитьСписокВложенийЭД()
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗаданияОбновленияВложений) Тогда
		
		УстановитьНастройкиОбновленияВложений();
			
		ПослеАвторизации = Новый ОписаниеОповещения("ПродолжитьОбновлениеВложений", ЭтотОбъект);
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации, ПослеАвторизации);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбновлениеВложений(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;

		ФоновоеЗаданиеОбновлениеВложений = ОбновлениеВложенийНаСервере(ПараметрыАвторизации);
		
		Если ФоновоеЗаданиеОбновлениеВложений <> Неопределено Тогда
			ПодключитьОбработчикОжидания("ПроверитьЗавершениеОбновленияВложений", 1, Истина);
		КонецЕсли;
		
	Иначе
		ОписаниеОшибки = "Ошибка получения списка вложений документа. " 
							+ ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(ЗапросПараметрыАвторизации.Журнал);
							
		ВывестиОшибкуОбновленияВложений(ОписаниеОшибки);					
			 
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеОбновленияВложений() Экспорт
	
	ОписаниеОшибки = "";
	
	Если НЕ ККСНГ_ОбщегоНазначенияВызовСервера.ЗаданиеВыполнено(ИдентификаторЗаданияОбновленияВложений, ОписаниеОшибки) Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеОбновленияВложений", 1, Истина);
		Возврат;
	КонецЕсли;
					
	Элементы.ДекорацияОжидание.Видимость = Ложь;
	ИдентификаторЗаданияОбновленияВложений = "";
	ТаблицаВложений.Очистить();
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ВывестиОшибкуОбновленияВложений(ОписаниеОшибки);
		Возврат;
	КонецЕсли;		
	
	ЗапросОбновленияВложений = ПолучитьИзВременногоХранилища(АдресХранилищаВложений);
	
	Если ТипЗнч(ЗапросОбновленияВложений) = Тип("Структура") Тогда
		
		Если ЗапросОбновленияВложений.Успех Тогда
			
			МассивВложений = ЗапросОбновленияВложений.Результат; 
			
			Для Нпп = 1 По МассивВложений.Количество() Цикл 
				СтрокаТаблицы = ТаблицаВложений.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивВложений[Нпп - 1]);
				СтрокаТаблицы.Нпп = Нпп;
			КонецЦикла;
			
			Если ТаблицаВложений.Количество() Тогда
				Элементы.ТаблицаВложений.Видимость = Истина;
				Элементы.СтатусПолученияВложений.Видимость = Ложь;
			Иначе
				Элементы.СтатусПолученияВложений.Заголовок = "Вложения отсутствуют.";	
			КонецЕсли;
			
		Иначе
			
			ОписаниеОшибки = "Ошибка получения списка вложений документа. " 
			+ ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(ЗапросОбновленияВложений.Журнал);
			ВывестиОшибкуОбновленияВложений(ОписаниеОшибки);
			
		КонецЕсли;
		
	Иначе 
		
		ОписаниеОшибки = "Неизвестная ошибка получения списка вложений документа. Обратитесь к администратору.";
		ВывестиОшибкуОбновленияВложений(ОписаниеОшибки);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ОбновлениеВложенийНаСервере(ПараметрыАвторизации)

	АдресХранилищаВложений = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		
	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(АдресХранилищаВложений);
	ПараметрыВызова.Добавить(Объект.Id);
	ПараметрыВызова.Добавить(ПараметрыАвторизации);
	
	Попытка
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("ККСНГ_ДокументооборотВызовСервера.ПолучитьВложенияЭлектронногоДокументаИзКурьераВФоновомЗадании", 
								ПараметрыВызова, УникальныйИдентификатор, "Обновление вложений ЭД");
								
		ИдентификаторЗаданияОбновленияВложений = ФоновоеЗадание.УникальныйИдентификатор;
		
	Исключение
		ИдентификаторЗаданияОбновленияВложений = "";
	КонецПопытки;
		
	Возврат ИдентификаторЗаданияОбновленияВложений;
	
КонецФункции

&НаКлиенте
Процедура УстановитьНастройкиОбновленияВложений()
	
	Элементы.ДекорацияОжидание.Видимость = Истина;
	Элементы.СтатусПолученияВложений.Видимость = Истина;
	Элементы.СтатусПолученияВложений.Заголовок = "Получение вложений, пожалуйста подождите...";
	Элементы.ОшибкаПолученияВложений.Видимость = Ложь;
	Элементы.ТаблицаВложений.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиОшибкуОбновленияВложений(ОписаниеОшибки)
	
	Элементы.ОшибкаПолученияВложений.Видимость = Истина;
	Элементы.ОшибкаПолученияВложений.Заголовок = ОписаниеОшибки;
	
	Элементы.ДекорацияОжидание.Видимость = Ложь;
	Элементы.СтатусПолученияВложений.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВыбранныеВложения(МассивСтрок)
	
	МассивИдентификаторов = Новый Массив;
				
	Для каждого Строка Из МассивСтрок Цикл
		СтрокаТаблицы = ТаблицаВложений.НайтиПоИдентификатору(Строка);
		МассивИдентификаторов.Добавить(СтрокаТаблицы.Id);
	КонецЦикла;
		
	ДопПараметры = Новый Структура("МассивИдентификаторов", МассивИдентификаторов);
	
	ПослеАвторизации = Новый ОписаниеОповещения("ПродолжитьСохранениеВложений", ЭтотОбъект, ДопПараметры);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации, ПослеАвторизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьСохранениеВложений(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт

	Ответ = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьСтруктуруОтвета();
	ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросПараметрыАвторизации.Журнал, Ложь);
	
	Если ЗапросПараметрыАвторизации.Успех Тогда
		
		ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
		МассивИдентификаторов = ДопПараметры.МассивИдентификаторов;
				
		ЗапросВложений = ККСНГ_ДокументооборотВызовСервера.ПолучитьВложенияИзКурьера(МассивИдентификаторов, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.КонкатенироватьЖурналы(Ответ.Журнал, ЗапросВложений.Журнал, Ложь);
		
		Если ЗапросВложений.Успех Тогда
						
			Ответ.Успех = Истина;
			МассивФайлов = ЗапросВложений.Результат;
					
			Если МассивФайлов.Количество() = 1 Тогда
				ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
				ДиалогВыбораФайла.Заголовок = "Сохранение вложения электронного документа";
				ДиалогВыбораФайла.ПолноеИмяФайла = МассивФайлов[0].Имя;
			Иначе
				ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
				ДиалогВыбораФайла.Заголовок = "Укажите каталог для сохранения файлов вложений электронного документа";	
			КонецЕсли;
						
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьСохранениеВложений", ЭтотОбъект, ДиалогВыбораФайла);
			
			НачатьПолучениеФайлов(ОписаниеОповещения, МассивФайлов, ДиалогВыбораФайла);
									
		КонецЕсли;	

	КонецЕсли;
	
	Если НЕ Ответ.Успех Тогда
		
		ОписаниеОшибки = "Ошибка сохранения вложений электронного документа. " 
								+ ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Ответ.Журнал);
								
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСохранениеВложений(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		КоличествоФайлов = Результат.Количество();
		
		Если КоличествоФайлов Тогда
			
			ТекстСообщения = "Сохранено " + КоличествоФайлов + " вложений";
									
			ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаВложения", ЭтотОбъект, ДопПараметры.Каталог);
			ПоказатьОповещениеПользователя(ТекстСообщения, ОписаниеОповещения, "Посмотреть в папке", БиблиотекаКартинок.СохранитьФайл);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаВложения(ДополнительныеПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		Если Не РаботаСФайламиСлужебныйКлиент.РасширениеРаботыСФайламиПодключено() Тогда
			РаботаСФайламиСлужебныйКлиент.ПоказатьПредупреждениеОНеобходимостиРасширенияРаботыСФайлами(Неопределено);
			Возврат;
		КонецЕсли;
	#КонецЕсли

	Если ТипЗнч(ДополнительныеПараметры) = Тип("Строка") И Не ПустаяСтрока(ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиент.ОткрытьПроводник(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область КарточкаИнфоПолей

&НаСервере
Процедура ПрисоединитьКарточкуИнфоПолейКЭлектронномуДокументу(ТабличныйДокументЭД)
	
	МодульМенеджераЭД = Справочники.ККСНГ_ЭлектронныеДокументы;
	КарточкаИнфоПолейДанныеЗаполнения = МодульМенеджераЭД.КарточкаИнфоПолейДанныеЗаполнения(Объект.Ссылка);
	Если КарточкаИнфоПолейДанныеЗаполнения.Успех Тогда
		ДанныеЗаполнения = КарточкаИнфоПолейДанныеЗаполнения.Результат;
		КарточкаИнфоПолейТабличныйДокумент = МодульМенеджераЭД.ТабличныйДокументКарточкиИнфоПолей(ДанныеЗаполнения);
		ТабличныйДокументЭД.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокументЭД.Вывести(КарточкаИнфоПолейТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПараметры

&НаСервере
Процедура НастроитьВидимостьДополнительныхПараметров()
	
	ИспользоватьБизнесПроцессУВХД = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ИспользуетсяБизнесПроцессУВХД();
	
	Элементы.ГруппаДополнительныеПараметры.Видимость = ИспользоватьБизнесПроцессУВХД;
	
	Если НЕ ИспользоватьБизнесПроцессУВХД Тогда
		Возврат;
	КонецЕсли;
	
	КодыОтображаемыхДопПараметров = Новый Массив();
	КодыОтображаемыхДопПараметров.Добавить("document.currency");
	КодыОтображаемыхДопПараметров.Добавить("manager.email");
	КодыОтображаемыхДопПараметров.Добавить("uvhd.contract.number");
	
	Для каждого СтрокаДопПараметр Из Объект.Properties Цикл
		СтрокаДопПараметр.Видимость = Не (КодыОтображаемыхДопПараметров.Найти(СтрокаДопПараметр.Key) = Неопределено);
	КонецЦикла;	
	
	Элементы.Properties.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("Видимость", Истина));	
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
