#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрисоединенныйФайлСсылка = ККСНГ_ОбъектыИБВызовСервера.ПолучитьСсылкуПрисоединенныйФайл(0, Объект.Ссылка);
	ЭтоСтруктурированныйДокумент = ККСНГ_ЭлектронныеДокументыВызовСервера.ЭтоСтруктурированныйЭД(Объект.DocumentTypeCode);
	ДоступнаВыгрузкаФНС = ККСНГ_ОбщегоНазначенияВызовСервера.ДоступнаВыгрузкаФНС(Объект.DocumentTypeCode);
	ЭтоВходящий = Объект.НаправлениеЭД = ПредопределенноеЗначение("Перечисление.ККСНГ_НаправленияЭД.Входящий");
	ПрофильЭДООрганизации = ККСНГ_ОбъектыИБВызовСервера.ПолучитьПрофильЭДООрганизацииДокумента(Объект.Ссылка);
	Документ1С = ККСНГ_ЭлектронныеДокументыВызовСервера.ПолучитьСвязанныйДокумент1С(Объект.Ссылка);
	Квитанции.Параметры.УстановитьЗначениеПараметра("Владелец", Объект.Ссылка);
	
	НастроитьВидимостьДополнительныхПараметров();
	Элементы.ГруппаПредупреждениеПФ.Видимость = Ложь;
	
	Если Не Отказ И ЗначениеЗаполнено(Объект.Организация) И Не ККСНГ_ОбщегоНазначенияВызовСервера.ОрганизацияДоступнаПользователю(Объект.Организация) Тогда
		Отказ = Истина;
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У пользователя недостаточно прав для совершения операции.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбщийМодульПринятиеКУчету = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_ПринятиеКУчетуКлиент");
	ЗапросДоступностиПринятияКУчету = ОбщийМодульПринятиеКУчету.ПринятиеКУчетуДоступно(Объект.Ссылка, Объект.DocumentTypeCode);
	Если ЗапросДоступностиПринятияКУчету.Успех Тогда
		ПринятиеКУчетуДоступно = ЗапросДоступностиПринятияКУчету.Результат;
	Иначе
		ПринятиеКУчетуДоступно = Ложь;
		ККСНГ_ЛогированиеКлиентСервер.ЖурналСообщенийВывестиСообщенияПользователю(ЗапросДоступностиПринятияКУчету.Журнал, "-1");
	КонецЕсли;
	
	ОбновитьДоступностьДействий();
	НастроитьВидимостьОткрытьСФЕРАКурьер();
	ОбновитьИнформациюПоОшибкамЦРПТ();
	ОбновитьОтображениеСтатусаЦРПТ();
	ОбновитьОтображениеБизнесПроцесс();
	
	ЭтотОбъект.Заголовок = ККСНГ_ЭлектронныеДокументыКлиент.СформироватьЗаголовокЭлектронногоДокумента(Объект.DocumentTypeCode, Объект.TypeName, Объект.Number, Объект.Date);
	
	ЭтотОбъект.ТолькоПросмотр = Истина;
	ОбновитьСтатусУчета();
	
	Элементы.ПечатнаяФормаЭлектронногоДокумента.Видимость = Ложь;
	
	Если Не ЭтоСтруктурированныйДокумент Тогда
		Элементы.СтраницаРеквизиты.Видимость = Истина;
		Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.СтраницаРеквизиты;
	КонецЕсли;
	
	ОбновитьДанныеПечатнойФормыЭлектронногоДокумента();
	УстановитьНастройкиОбновленияВложений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Перем ТекПрофильНастройкиЭДО;
	
	Если ИмяСобытия = "ПослеКомандыСФЕРАКурьер" И Источник = Объект.Ссылка Тогда
		ОбновитьКарточкуДокумента();
		ОбновитьСтатусУчета();
	ИначеЕсли ИмяСобытия = "Все квитанции подписаны" И Источник = УникальныйИдентификатор Тогда
		ОбновитьКарточкуДокумента();
		ВыполнитьДействиеКурьер(Параметр.Результат, Ложь);
	ИначеЕсли ИмяСобытия = "ОбновитьДоступностьКомандКурьера" Тогда
		ОбновитьДоступностьДействий();
	ИначеЕсли ИмяСобытия = "ККСНГ_ОбновлениеЭД" И ТипЗнч(Параметр) = Тип("Структура") Тогда
		Параметр.Свойство("ПрофильНастройкиЭДО", ТекПрофильНастройкиЭДО);
		Если Параметр.Свойство("ПрофильНастройкиЭДО", ТекПрофильНастройкиЭДО) И ТекПрофильНастройкиЭДО = ПрофильЭДООрганизации Тогда 
			ОбновитьКарточкуДокумента();
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияДокумент1СНажатие(Элемент)

	Если ЗначениеЗаполнено(Документ1С) Тогда

		ПоказатьЗначение(, Документ1С);

	ИначеЕсли ЭтоВходящий И ПринятиеКУчетуДоступно Тогда
						
		МенюВыбора = Новый СписокЗначений;
	
		МенюВыбора.Добавить("Принять к учёту в 1С", "Принять к учёту в 1С",	, БиблиотекаКартинок.ККСНГ_СоздатьВ1С);
		МенюВыбора.Добавить("Выбрать ранее учтённый", "Выбрать ранее учтённый",	, БиблиотекаКартинок.ККСНГ_ДобавитьСвязь);
		
		ОбработкаОповещения = Новый ОписаниеОповещения("ОбработчикЗавершенияВыбораДействияИзМеню", ЭтотОбъект);
		
		ПоказатьВыборИзМеню(ОбработкаОповещения, МенюВыбора, Элементы.ДекорацияДокумент1С);	
			
	Иначе
		НачатьВыборДокумента1С();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтатусЭДНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Элементы.ГруппаЗакладки.ТекущаяСтраница = Элементы.СтраницаИсторияОбработки;
	ОбновитьТаблицуИстории();

КонецПроцедуры

&НаКлиенте
Процедура ГруппаЗакладкиПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница.Имя = "СтраницаИсторияОбработки" Тогда
		ОбновитьТаблицуИстории();
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаВложения" Тогда 
		ОбновитьСписокВложенийЭД();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКвитанции

&НаКлиенте
Процедура КвитанцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если СтрСравнить(Элемент.ТекущиеДанные.ExtendedType, "Document") = 0 Тогда
		Возврат; // Сам документ не показываем, нет смысла
	КонецЕсли;
	
	Если СтрНачинаетсяС(Элемент.ТекущиеДанные.ExtendedType, "UniversalMessageFns") Тогда
		Возврат; // Универсальные сообщения пока не поддерживаются
	КонецЕсли;
	
	ПоказатьФормуКвитанции(Элемент.ТекущиеДанные);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура КвитанцииПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Перем ДанныеКвитанции, СтрокаСписка, ДанныеСтроки;
	
	// Заполнение типа документа для квитанций, загруженных до обновления перечисления
	
	ДанныеКвитанции = Новый Структура;
	ДанныеКвитанции.Вставить("ККСНГ_ExtendedDocumentType");
	
	Для каждого СтрокаСписка Из Строки Цикл
		
		ДанныеСтроки = СтрокаСписка.Значение.Данные;
		Если Не ЗначениеЗаполнено(ДанныеСтроки.ККСНГ_ExtendedDocumentType) Тогда
			Попытка
				ДанныеКвитанции.ККСНГ_ExtendedDocumentType = Перечисления.ККСНГ_ExtendedDocumentType[СокрЛП(ДанныеСтроки.ExtendedType)];
			Исключение
				Продолжить;
			КонецПопытки;
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДанныеКвитанции);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаВложений

&НаКлиенте
Процедура ТаблицаВложенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СохранитьВыбранныеВложения(ВыбраннаяСтрока);
								
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДействиеКурьер(Команда)
	ВыполнитьДействиеКурьер(Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ПротоколПередачи(Команда)

	#Если ВебКлиент Тогда
	    Возврат;
	#КонецЕсли

	ПослеАвторизации = Новый ОписаниеОповещения("ПротоколПередачиПродолжение", ЭтотОбъект);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации, ПослеАвторизации);

КонецПроцедуры

&НаКлиенте
Процедура КарточкаДокумента(Команда)

	ПараметрыФормы = Новый Структура("Ключ", Объект.Ссылка);
	ОткрытьФорму("Справочник.ККСНГ_ЭлектронныеДокументы.Форма.ФормаЭлемента", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеЭлектронногоДокумента(Команда)

	ПослеАвторизации = Новый ОписаниеОповещения("ОбновитьДанныеЭлектронногоДокументаПродолжение", ЭтотОбъект);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации, ПослеАвторизации);

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортДляФНС(Команда)

	НачатьВыборКаталога(Новый ОписаниеОповещения("ЭкспортДляФНСПослеВыбораКаталога", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВложения(Команда)
	
	ВыделенныеСтроки = Элементы.ТаблицаВложений.ВыделенныеСтроки;
	СохранитьВыбранныеВложения(ВыделенныеСтроки);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСФЕРАДокументы(Команда)
	
	Если ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ТестовыйРежим() Тогда
		АдресКурьера = "https://courier-demo.esphere.ru";
	Иначе
		АдресКурьера = "https://courier.esphere.ru";
	КонецЕсли;
	
	ВнешняяСсылка = АдресКурьера + "/documents/"
				  + ?(ЭтоВходящий, "1", "2") + "/"
				  + Формат(Объект.Id, "ЧГ=");
	
	ЗапуститьПриложение(ВнешняяСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОшибкиИзЦРПТНаФорме(Команда)
	
	ОбновитьИнформациюПоОшибкамЦРПТ(Истина);
	ОбновитьОтображениеСтатусаЦРПТ();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область НастройкаВидимостиДоступности

&НаКлиенте
Процедура НастроитьВидимостьОткрытьСФЕРАКурьер()

	Элементы.ФормаОткрытьСФЕРАКурьер.Видимость = Ложь;
	
	ПараметрыАвторизации = ККСНГ_ДокументооборотКлиент.ТекущиеПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации);
	СпособАвторизации    = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыАвторизации,	"СпособАвторизации");
	Если СпособАвторизации = Неопределено Тогда
		СпособАвторизации = ККСНГ_ДокументооборотВызовСервера.СпособАвторизацииОрганизации(ПрофильЭДООрганизации);	
	КонецЕсли;
	
	Если СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ApiKey") Тогда
		Элементы.ФормаОткрытьСФЕРАКурьер.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеФормыДокумента

&НаКлиенте
Процедура ОбновитьКарточкуДокумента(ОбновлятьТекВкладку = Истина)

	ОбновитьКарточкуДокументаНаСервере();
	Если ОбновлятьТекВкладку Тогда
		ОбновитьТекущуюВкладку();	
	КонецЕсли;
	ОбновитьДоступностьДействий();
	ОбновитьОтображениеСтатусаЦРПТ();
	ОповеститьОбИзменении(Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ОбновитьКарточкуДокументаНаСервере()

    ЭтотОбъект.Прочитать();
	
	НастроитьВидимостьДополнительныхПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекущуюВкладку()

	ТекСтраница = Элементы.ГруппаЗакладки.ТекущаяСтраница.Имя;

	Если ТекСтраница = "СтраницаКвитанции" Тогда
		Элементы.Квитанции.Обновить();
	ИначеЕсли ТекСтраница = "СтраницаИсторияОбработки" Тогда
		ОбновитьТаблицуИстории();
	ИначеЕсли ТекСтраница = "СтраницаПодписи" ИЛИ ТекСтраница = "СтраницаСодержимое" Тогда
		ОбновитьДанныеПечатнойФормыЭлектронногоДокумента();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьДействий()
	
	СписокДействийПоМаске = ККСНГ_ДокументооборотКлиент.ПолучитьСоответствиеМаскиДействийИзСтроки(Объект.Actions);
	
	КорректировкаДоступностиДействий(СписокДействийПоМаске);
	СписокДоступныхДействий.Очистить();
	Для каждого Действие Из СписокДействийПоМаске Цикл
		СписокДоступныхДействий.Добавить(Действие.Ключ);
	КонецЦикла;
	
	Для каждого ЭлементФормы Из Элементы Цикл
		
		Если ТипЗнч(ЭлементФормы) = Тип("КнопкаФормы") И Лев(ЭлементФормы.ИмяКоманды, 6) = "Курьер" Тогда
			
			ЭлементФормы.Пометка = Ложь;
			ЭлементФормы.Доступность = Истина;
			
			ИмяДействия = Сред(ЭлементФормы.ИмяКоманды, 7);
			ЭлементФормы.Видимость = СписокДействийПоМаске[ИмяДействия] <> Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ПротоколПередачи.ТолькоВоВсехДействиях = НЕ Объект.IsDocflowCompleted И СписокДействийПоМаске.Количество() > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаДоступностиДействий(СписокДействийПоМаске)
	
	НеподписанныеКвитанции = ККСНГ_ОбъектыИБВызовСервера.ПолучитьКвитанцииДокумента(Объект.Ссылка, Истина);
	
	Если НеподписанныеКвитанции.Количество() Тогда
		СписокДействийПоМаске.Вставить("ПодписатьКвитанцииДокумента", Истина);
	КонецЕсли;
	
	Если Объект.Status = "Delivered" Тогда
		
		СписокДействийПоМаске.Вставить("Accept", Истина);
		СписокДействийПоМаске.Вставить("Reject", Истина);
		
	КонецЕсли;
	
	Если СписокДействийПоМаске["AcceptWithTicket"] <> Неопределено И СписокДействийПоМаске["AcceptWithTicket"] Тогда
		
		СписокДействийПоМаске.Вставить("AcceptWithTicketNoDisaccordSign", Истина); // Подписать
		
		ЭтоКорректировка = ККСНГ_ОбщегоНазначенияКлиентСервер.ЭтоКорректировка(Объект.Filename);
		Если Не ЭтоКорректировка Тогда
			СписокДействийПоМаске.Вставить("AcceptWithTicketDisaccordSign", Истина); // Подписать с расхождениями
		КонецЕсли;
	
		СписокДействийПоМаске.Удалить("Accept");
		
	КонецЕсли;
	
	Если СписокДействийПоМаске["RejectWithTicket"] <> Неопределено И СписокДействийПоМаске["RejectWithTicket"] Тогда
		
		СписокДействийПоМаске.Удалить("Reject");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеСтатусаЦРПТ()
	
	Элементы.ГруппаСтатусЦРТ.Видимость = Объект.ЕстьМаркировка И Объект.СтатусЦРПТ <> -1 И СтрСравнить(Объект.Status, "Draft") <> 0;
	
	Если Элементы.ГруппаСтатусЦРТ.Видимость Тогда
		
		Если Объект.СтатусЦРПТ = 0 Или Объект.СтатусЦРПТ = 4 Тогда
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = БиблиотекаКартинок.ККСНГ_СтатусОшибкаОбработкиЦРПТ;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "Ошибка обработки документа";
		ИначеЕсли Объект.СтатусЦРПТ = 1 Тогда
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = БиблиотекаКартинок.ККСНГ_СтатусОтправленЦРПТ;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "Документ отправлен";
		ИначеЕсли Объект.СтатусЦРПТ = 2 Тогда
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = БиблиотекаКартинок.ККСНГ_СтатусУспешноОбработанЦРПТ;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "Документ успешно обработан";
		ИначеЕсли Объект.СтатусЦРПТ = 3 Тогда
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = БиблиотекаКартинок.ККСНГ_СтатусОбрабатываетсяЦРПТ;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "Документ получен и обрабатывается";
		ИначеЕсли Объект.СтатусЦРПТ = 5 Тогда
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = БиблиотекаКартинок.ККСНГ_СтатусОбрабатываетсяЦРПТ;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "Не удалось получить статус ЦРПТ";
		Иначе
			Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка = Новый Картинка;
			Элементы.ДекорацияРасшифровкаСтатусаЦРПТ.Заголовок = "" + Объект.СтатусЦРПТ + " Неизвестный статус";
		КонецЕсли;
		Элементы.ДекорацияИконкаСтатусаЦРПТ.Видимость = Элементы.ДекорацияИконкаСтатусаЦРПТ.Картинка.Вид <> ВидКартинки.Пустая;
	КонецЕсли;
	
	Элементы.СтраницаЦРПТ.Видимость = Элементы.ГруппаСтатусЦРТ.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеБизнесПроцесс()
	
	БизнесПроцессДопПараметр = Объект.Properties.НайтиСтроки(Новый Структура("Key", "business process"));
	Элементы.ГруппаБизнесПроцесс.Видимость = БизнесПроцессДопПараметр.Количество();
	Если Элементы.ГруппаБизнесПроцесс.Видимость Тогда
		
		СоответствияИменБизнесПроцесса = Новый Соответствие();
		СоответствияИменБизнесПроцесса.Вставить("UVHD", "ЭДО с поставщиками");	
		
		БизнесПроцессКод = БизнесПроцессДопПараметр[0].Value;
		БизнесПроцессИмя = СоответствияИменБизнесПроцесса[БизнесПроцессКод];
		Если Не ЗначениеЗаполнено(БизнесПроцессИмя) Тогда
			БизнесПроцессИмя = БизнесПроцессКод;	
		КонецЕсли;
		
		Элементы.ДекорацияРасшифровкаБизнесПроцесса.Заголовок = БизнесПроцессИмя;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьСписокДоступныхДействий()
	
	НеподписанныеКвитанции = ККСНГ_ОбъектыИБВызовСервера.ПолучитьКвитанцииДокумента(Объект.Ссылка, Истина);
	Если НеподписанныеКвитанции.Количество() Тогда
		СписокДоступныхДействий.Добавить("ПодписатьКвитанцииДокумента");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформациюПоОшибкамЦРПТ(Принудительно = Ложь)
	
	Если Не Объект.Ссылка.Пустая() И Объект.ЕстьМаркировка И СтрСравнить(Объект.Status, "Draft") <> 0 Тогда
		
		СтатусКонечный = Объект.СтатусЦРПТ = 4 Или Объект.СтатусЦРПТ = 2;
		
		Если Принудительно <> Истина И СтатусКонечный Тогда
			ИнформацияНеПустая = ОбновитьИнформациюПоОшибкамЦРПТНаСервере(Истина);
			Если ИнформацияНеПустая Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ПрофильНастройкиЭДО", ПрофильЭДООрганизации);
		ДопПараметры.Вставить("Id", Объект.Id);
		ПослеАвторизации = Новый ОписаниеОповещения("ОбновитьИнформациюПоОшибкамЦРПТЗавершение", ЭтотОбъект, ДопПараметры);
		ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииОрганизации(ПрофильЭДООрганизации, ПослеАвторизации);
		
	Иначе
		Элементы.СтраницаЦРПТ.Видимость = Ложь;
	КонецЕсли;
	
	ОповеститьОбИзменении(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнформациюПоОшибкамЦРПТЗавершение(ЗапросПараметрыАвторизации, ДопПараметры) Экспорт
	
	ПараметрыАвторизации = ЗапросПараметрыАвторизации.Результат;
	Если ЗапросПараметрыАвторизации.Успех Тогда
		РезультатОбновления = ОбновитьИнформациюПоОшибкамЦРПТНаСервере(Ложь, ПараметрыАвторизации, ДопПараметры.Id);
	Иначе
		ККСНГ_ДокументооборотКлиент.ПроверитьОчиститьAuthCookie(ДопПараметры.ПрофильНастройкиЭДО, ПараметрыАвторизации);
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросПараметрыАвторизации.Журнал);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОбновитьИнформациюПоОшибкамЦРПТНаСервере(ИзОбъекта, ПараметрыАвторизации = Неопределено, Id = Неопределено)
	
	Перем ОбъектЭД, ЗапросСтатусаЦРПТ, ДанныеОтЦРПТ, Ошибки, Ошибка;
	
	ОбъектЭД = РеквизитФормыВЗначение("Объект");
	
	Если ИзОбъекта Тогда
		
		ДанныеОтЦРПТ = ОбъектЭД.ОшибкиЦРПТ.Получить();
		Если ТипЗнч(ДанныеОтЦРПТ) <> Тип("Структура") Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Ошибки = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеОтЦРПТ, "Ошибки");
		Если ТипЗнч(Ошибки) <> Тип("Массив") Тогда
			Ошибки = Новый Массив;
			Ошибки.Добавить(ДанныеОтЦРПТ);
		КонецЕсли;
		
		ВывестиТаблицуИнформацииПоОшибкамЦРПТ(Ошибки);
		Возврат Истина;
		
	КонецЕсли;
	
	ЗапросСтатусаЦРПТ = ККСНГ_ДокументооборотВызовСервера.СтатусЦРПТДокумента(Id, ПараметрыАвторизации);
	Если ЗапросСтатусаЦРПТ.Успех Тогда
		
		Если ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Успех Тогда
			
			ОбъектЭД.СтатусЦРПТ = ЗапросСтатусаЦРПТ.Результат;
			
			ДанныеОтЦРПТ = ЗапросСтатусаЦРПТ.ДанныеПоОшибкеОтЦРПТ.Результат;
			ОбъектЭД.КодОшибкиЦРПТ = ДанныеОтЦРПТ.КодОшибки;
			ОбъектЭД.ОписаниеОшибкиЦРПТ = ДанныеОтЦРПТ.Заголовок;
			Для каждого Ошибка Из ДанныеОтЦРПТ.Ошибки Цикл
				ОбъектЭД.ОписаниеОшибкиЦРПТ = Ошибка.ОписаниеОшибки;
				Прервать;
			КонецЦикла;
			
			ВывестиТаблицуИнформацииПоОшибкамЦРПТ(ДанныеОтЦРПТ.Ошибки);
			
		КонецЕсли;
		
		Попытка
			ОбъектЭД.ОшибкиЦРПТ = Новый ХранилищеЗначения(ДанныеОтЦРПТ, Новый СжатиеДанных(9));
			ОбъектЭД.Записать();
		Исключение
		КонецПопытки;
		
		ЗначениеВРеквизитФормы(ОбъектЭД, "Объект");
		
	Иначе
		ККСНГ_ЛогированиеКлиентСервер.ВывестиПоследнююОшибкуЖурнала(ЗапросСтатусаЦРПТ.Журнал);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ВывестиТаблицуИнформацииПоОшибкамЦРПТ(МассивДанныхИзЦРПТ)
	
	Перем ИнформацияИзЦРПТ, НоваяСтрока;
	Перем Отбор, ПустыеСтроки, ПустаяСтрока;
	
	ИнформацияПоОшибкамЦРПТ.Очистить();
	
	Для каждого ИнформацияИзЦРПТ Из МассивДанныхИзЦРПТ Цикл
		
		Если ИнформацияПоОшибкамЦРПТ.Количество() > 0 Тогда
			// Пустая строка между ошибками
			НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
			НоваяСтрока.Заголовок = "-";
		КонецЕсли;
		
		//НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		//НоваяСтрока.Заголовок = "Статус";
		//НоваяСтрока.Расшифровка = ИнформацияИзЦРПТ.Заголовок;
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Код ошибки";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "КодОшибки");
		
		Если НоваяСтрока.Расшифровка = "1" Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Описание ошибки";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "ОписаниеОшибки");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Служебная информация";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "СлужебнаяИнформация");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Дополнительная информация";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "ДополнительнаяИнформация");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "ИНН";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "ИНН");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "КПП";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "КПП");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "ФИАС";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "ФИАС");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Участники";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "Участники");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Номер и дата документа";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "НомерДатаДокумента");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Номер и дата исправления";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "НомерДатаИсправления");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "GTIN";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "GTIN");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Коды маркировки";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "КодыМаркировок");
		
		НоваяСтрока = ИнформацияПоОшибкамЦРПТ.Добавить();
		НоваяСтрока.Заголовок = "Коды упаковок";
		НоваяСтрока.Расшифровка = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ИнформацияИзЦРПТ, "КодыУпаковок");
		
	КонецЦикла;
	
	Отбор = Новый Структура("Расшифровка", "");
	ПустыеСтроки = ИнформацияПоОшибкамЦРПТ.НайтиСтроки(Отбор);
	Для каждого ПустаяСтрока Из ПустыеСтроки Цикл
		Если ПустаяСтрока.Заголовок <> "-" Тогда
			ИнформацияПоОшибкамЦРПТ.Удалить(ПустаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеПечатнойФормыДокумента

&НаКлиенте
Процедура ОбновитьДанныеПечатнойФормыЭлектронногоДокумента()

	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьМассивЭПОбъектаЭДОЗавершение", ЭтотОбъект, ЭтоСтруктурированныйДокумент);
	ККСНГ_ЭлектронныеДокументыКлиент.ПолучитьМассивЭПОбъектаЭДОНаКлиенте(ОписаниеОповещения, Объект.Ссылка, Объект.Type);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМассивЭПОбъектаЭДОЗавершение(МассивЭП, ЭтоСтруктурированныйДокумент) Экспорт

	ККСНГ_ЭлектронныеДокументыКлиент.ЗаполнитьТаблицуПодписиНаФорме(ТаблицаПодписи, МассивЭП);

	Если ЭтоСтруктурированныйДокумент Тогда
		СформироватьПечатнуюФормуЭлектронногоДокумента(ЭтоСтруктурированныйДокумент, МассивЭП);
	КонецЕсли;

	ОбновитьДоступностьЭкспортаДляФНС();

КонецПроцедуры

&НаКлиенте
Процедура СформироватьПечатнуюФормуЭлектронногоДокумента(ЭтоСтруктурированныйДокумент, МассивЭП)

	СтруктураТабДок = ПолучитьТабличныйДокумент(ЭтоСтруктурированныйДокумент, МассивЭП);
	ТабДокЭД = СтруктураТабДок.ПечатнаяФормаЭД;

	Если ЗначениеЗаполнено(СтруктураТабДок.ТекстПредупреждения) Тогда
		Элементы.ПредупреждениеПФ.Заголовок = СтруктураТабДок.ТекстПредупреждения;
		Элементы.ГруппаПредупреждениеПФ.Видимость = Истина;
	Иначе
		Элементы.ГруппаПредупреждениеПФ.Видимость = Ложь;
	КонецЕсли;

	Если ТабДокЭД <> Неопределено Тогда

		ТабДокЭД.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ККСНГ_ЭлектронныеДокументы_" + Объект.Type;
		ПрисоединитьКарточкуИнфоПолейКЭлектронномуДокументу(ТабДокЭД);
		ПечатнаяФормаЭлектронногоДокумента = ТабДокЭД;
		Элементы.ПечатнаяФормаЭлектронногоДокумента.Видимость = Истина;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьТабличныйДокумент(ЭтоСтруктурированныйДокумент, МассивЭП, Квитанция = Неопределено)
	
	Результат = Неопределено;
	
	СвойстваЭлектронногоДокумента = Новый Структура;
	СвойстваЭлектронногоДокумента.Вставить("НомерИсходногоДокумента", Объект.Number);
	СвойстваЭлектронногоДокумента.Вставить("ДатаИсходногоДокумента", Объект.Date);
	СвойстваЭлектронногоДокумента.Вставить("Подписи", МассивЭП);
	СвойстваЭлектронногоДокумента.Вставить("КодТипаДокумента", Объект.DocumentTypeCode);
	
	Если Квитанция <> Неопределено Тогда
		
		СвойстваЭлектронногоДокумента.Вставить("Владелец", Квитанция.Ссылка);
		СвойстваЭлектронногоДокумента.Вставить("РасширенныйТип", Квитанция.ExtendedType);
		СвойстваЭлектронногоДокумента.Вставить("ТипТранспортногоДокумента", Квитанция.Type);
		
		ТекПрисоединенныйФайлСсылка = Квитанция.ПрисоединенныйФайлСсылка;
		
	ИначеЕсли ЭтоСтруктурированныйДокумент Тогда
		
		СвойстваЭлектронногоДокумента.Вставить("Владелец", Объект.Ссылка);
		СвойстваЭлектронногоДокумента.Вставить("РасширенныйТип", "Document");
		СвойстваЭлектронногоДокумента.Вставить("ТипТранспортногоДокумента", Объект.Type);
		
		ТекПрисоединенныйФайлСсылка = ПрисоединенныйФайлСсылка;
	Иначе
		ТекПрисоединенныйФайлСсылка = Неопределено;
	КонецЕсли;
	
	ПараметрыПредставления = Новый Структура;
	ПараметрыПредставления.Вставить("СкрыватьДопДанные", Истина);
	ПараметрыПредставления.Вставить("СкрыватьКопияВерна", Истина);
	ПараметрыПредставления.Вставить("СвойстваЭлектронногоДокумента", СвойстваЭлектронногоДокумента);
	
	Результат = ККСНГ_ЭлектронныеДокументыВызовСервера.ПолучитьПредставлениеФайлаЭД(ТекПрисоединенныйФайлСсылка, ПараметрыПредставления);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

