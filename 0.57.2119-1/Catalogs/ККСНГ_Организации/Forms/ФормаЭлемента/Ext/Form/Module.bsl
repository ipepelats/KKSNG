#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОткрытаМастеромОрганизации", ОткрытаМастеромОрганизации);
	
	// Варианты отправки МЧД 
	СписокВариантовОтправки = Элементы.ВариантОтправкиМЧД.СписокВыбора;
	ВариантОтправкиМЧД = ККСНГ_МашиночитаемыеДоверенности.ДоступныеВариантыОтправкиДоверенности();
	
	СписокВариантовОтправки.Очистить();
	
	Для каждого ДоступныйВариант Из ВариантОтправкиМЧД Цикл
		СписокВариантовОтправки.Добавить(ДоступныйВариант.Значение, ДоступныйВариант.Представление);
	КонецЦикла;
	
	Если СписокВариантовОтправки.НайтиПоЗначению(Объект.ВариантОтправкиМЧД) = Неопределено Тогда
		Объект.ВариантОтправкиМЧД = "Метаданные";
	КонецЕсли;
	
	// Варианты настроек обмена ФНС
	ВариантыНастроекОбмена = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВариантыФорматовЭлектронныхДокументов();
	Для каждого НекийФормат Из ВариантыНастроекОбмена Цикл
		Элементы.СписокВариантовНастроекОбмена.СписокВыбора.Добавить(НекийФормат);
	КонецЦикла;
	Объект.ВариантНастройкиОбмена = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьДоступныйФорматЭлектронногоДокумента(Объект.ВариантНастройкиОбмена);
	
	// Таблица форматов ФНС
	ТаблицаФорматов = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьФорматыЭлектронныхДокументов();
	ИсходящиеДокументы.Загрузить(ТаблицаФорматов);
	
	ВариантНастройкиОтбора = ?(ЗначениеЗаполнено(Объект.ВариантНастройкиОбмена), Объект.ВариантНастройкиОбмена, "_");
	Отбор = Новый ФиксированнаяСтруктура("НаименованиеВарианта", ВариантНастройкиОтбора);
	Элементы.ИсходящиеДокументы.ОтборСтрок = Отбор;
	
	Если Не Отказ И ЗначениеЗаполнено(Объект.Организация) И Не ККСНГ_ОбщегоНазначенияВызовСервера.ОрганизацияДоступнаПользователю(Объект.Организация) Тогда
		Отказ = Истина;
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У пользователя недостаточно прав для совершения операции.");
	КонецЕсли;
	
	ТекущийСпособАвторизации = ККСНГ_ДокументооборотВызовСервера.СпособАвторизацииОрганизации(Объект.Ссылка);
	
	// Устанавливаем ограничение типов для реквизитов
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	
	Если Не МодульККСНГ_ПМ_РаботаСМетаданными = Неопределено Тогда
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.Склад, "Склады");
		Элементы.Склад.Видимость = Элементы.Склад.ОграничениеТипа.Типы().Количество();
	КонецЕсли;
	
	ОбновитьНастройкуПодключаемогоМодуля();
	ЗаполнитьРеквизитыФормыПоРегламентномуЗаданию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ТекущийВариантНастройкиОбмена) Тогда
		ТекущийВариантНастройкиОбмена = Объект.ВариантНастройкиОбмена;
	КонецЕсли;
		
	МногопользовательскийРежимПриОткрытии = Объект.МногопользовательскийРежим;
	
	НастроитьПерейтиКНастройкамКонтрагентов();
	ОбновитьВидимостьПоСпособуАвторизации();
	ОбновитьВидимостьМногопользовательскогоРежима();
	 
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Склад) Тогда
		Попытка
			ЭтотОбъект.Склад = Справочники.ККСНГ_ЗначенияСвойствОбъектов.ПолучитьСсылкуЗначенияСвойстваОсновнойКонфигурации(ТекущийОбъект, "Склад");
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Склад", ЭтотОбъект.Склад);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.МногопользовательскийРежим Тогда
	
		Инд = 0;		
		Для Каждого СтрокаНастройкиДоступа Из Объект.НастройкиДоступа Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаНастройкиДоступа.СпособАвторизации) Тогда
				
					ТекстСообщенияПользователю = "Не заполнена колонка ""Способ авторизации"" в строке " + Строка(Инд + 1) + " списка ""Настройки доступа""";
					КлючДанных = Объект.Ссылка;
					Поле = "НастройкиДоступа[" + Строка(Инд) + "].СпособАвторизации";
					ПутьКДанным = "Объект";
					ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным, Отказ);
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаНастройкиДоступа.Пользователь1С) Тогда
				
					ТекстСообщенияПользователю = "Не заполнена колонка ""Пользователь"" в строке " + Строка(Инд + 1) + " списка ""Настройки доступа""";
					КлючДанных = Объект.Ссылка;
					Поле = "НастройкиДоступа[" + Строка(Инд) + "].Пользователь1С";
					ПутьКДанным = "Объект";
					ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным, Отказ);
				
			КонецЕсли;
							
			Если НЕ ЗначениеЗаполнено(СтрокаНастройкиДоступа.КлючДоступаAPI) 
				И СтрокаНастройкиДоступа.СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ApiKey") Тогда
				
					ТекстСообщенияПользователю = "Не заполнена колонка ""Ключ доступа API"" в строке " + Строка(Инд + 1) + " списка ""Настройки доступа""";
					КлючДанных = Объект.Ссылка;
					Поле = "НастройкиДоступа[" + Строка(Инд) + "].КлючДоступаAPI";
					ПутьКДанным = "Объект";
					ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным, Отказ);
				
			КонецЕсли;		
			
			Инд = Инд + 1;
			
		КонецЦикла;
		
		Если НЕ Объект.НастройкиДоступа.Количество() Тогда
			
			ТекстСообщенияПользователю = "Табличная часть списка ""Настройки доступа"" должна содержать хотя бы одну запись";
			КлючДанных = Объект.Ссылка;
			Поле = "НастройкиДоступа";
			ПутьКДанным = "Объект";
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным, Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ТекущийВариантНастройкиОбмена <> Объект.ВариантНастройкиОбмена Тогда
		ПараметрыСобытия = Новый Структура;
		ПараметрыСобытия.Вставить("ПрофильЭДООрганизации", Объект.Ссылка);
		ПараметрыСобытия.Вставить("КодУчастникаЭДООрганизации", Объект.КодУчастникаЭДО);
		ПараметрыСобытия.Вставить("НовыйВариантНастройкиОбмена", Объект.ВариантНастройкиОбмена);
		Оповестить("ОбновитьКОтправке", ПараметрыСобытия, ЭтотОбъект);  
		ТекущийВариантНастройкиОбмена = Объект.ВариантНастройкиОбмена;
	КонецЕсли;

	СпособАвторизацииПослеЗаписи = ККСНГ_ДокументооборотВызовСервера.СпособАвторизацииОрганизации(Объект.Ссылка);
	
	Если ТекущийСпособАвторизации <> СпособАвторизацииПослеЗаписи Тогда
		Если глПараметрыАвторизацииКурьер <> Неопределено Тогда
			глПараметрыАвторизацииКурьер.Вставить(Объект.Ссылка, Неопределено);
		КонецЕсли;			
		ТекущийСпособАвторизации = СпособАвторизацииПослеЗаписи;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если НЕ ЭтотОбъект.Открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "ККСНГ_ИзменениеНастроекАвтообмена" 
		И ТипЗнч(Параметр) = Тип("СправочникСсылка.ККСНГ_Организации") Тогда
		
		ЗаполнитьРеквизитыФормыПоРегламентномуЗаданию()
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкиДоступа

&НаКлиенте
Процедура НастройкиДоступаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ Объект.НастройкиДоступа.Количество() ИЛИ Копирование Тогда
		Отказ = Истина;
		
		Если Копирование Тогда		
			ДанныеДляСтроки = Элемент.ТекущиеДанные;
		Иначе
			ДанныеДляСтроки = Объект;
		КонецЕсли;
				
		НоваяСтрока = Объект.НастройкиДоступа.Добавить();
		НоваяСтрока.СпособАвторизации = ДанныеДляСтроки.СпособАвторизации;
		Если ДанныеДляСтроки.СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ApiKey") Тогда
			НоваяСтрока.КлючДоступаAPI = ДанныеДляСтроки.КлючДоступаAPI;
		КонецЕсли;
				
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДоступаПользователь1СОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		
	Отбор = Новый Структура;
	Отбор.Вставить("Пользователь1С", ВыбранноеЗначение);
	НайденныеСтроки = Объект.НастройкиДоступа.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() Тогда
		СтандартнаяОбработка = Ложь;
		ТекстСообщенияПользователю = "Пользователь " + ВыбранноеЗначение + " уже присутствует в строке "
								+ Строка(НайденныеСтроки[0].НомерСтроки) + " списка ""Настройки доступа""";
		КлючДанных = Объект.Ссылка;
		Поле = "НастройкиДоступа[" + Строка(НайденныеСтроки[0].НомерСтроки - 1) + "].Пользователь1С";
		ПутьКДанным = "Объект";
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиДоступаСпособАвторизацииПриИзменении(Элемент)
	ОбновитьВидимостьМногопользовательскогоРежима();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособАвторизацииПриИзменении(Элемент)
	ОбновитьВидимостьПоСпособуАвторизации();
КонецПроцедуры

&НаКлиенте
Процедура СписокВариантовНастроекОбменаПриИзменении(Элемент)
		
	ВариантНастройкиОтбора = ?(ЗначениеЗаполнено(Объект.ВариантНастройкиОбмена), Объект.ВариантНастройкиОбмена, "_");
	Отбор = Новый ФиксированнаяСтруктура("НаименованиеВарианта", ВариантНастройкиОтбора);
	Элементы.ИсходящиеДокументы.ОтборСтрок = Отбор;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНастройкамКонтрагентовОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ПрофильЭДООрганизации", Объект.Ссылка);
	ОткрытьФорму("Обработка.ККСНГ_СинхронизацияКонтрагентов.Форма.Синхронизация", ПараметрыФормы, , Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВключитьМногопользовательскийРежим(Команда)
			
	Объект.МногопользовательскийРежим = НЕ Объект.МногопользовательскийРежим;
	ОбновитьВидимостьМногопользовательскогоРежима();
	
КонецПроцедуры

&НаКлиенте
Процедура ТестНастроек(Команда)
	
	ТестДоступен = Истина;
	
	Если Объект.СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ApiKey") Тогда
		ТестДоступен = ЗначениеЗаполнено(Объект.КлючДоступаAPI);	
	КонецЕсли;
	
	Если ТестДоступен Тогда
		СтарыйКодУчастника = Объект.КодУчастникаЭДО;
		СтарыйИдентификаторПодписки = Объект.ИдентификаторПодпискиСК;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СтарыйКодУчастника", СтарыйКодУчастника);
		ДопПараметры.Вставить("СтарыйИдентификаторПодписки", СтарыйИдентификаторПодписки);
		ПослеТестаНастроек = Новый ОписаниеОповещения("УстановитьМодифицированность", ЭтотОбъект, ДопПараметры);
		НачатьТестНастроек(ПослеТестаНастроек);		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура НастроитьРасписаниеАвтообмена(Команда)
	
	Перем ПараметрыОткрытияФормы, ТекстВопроса;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		Или ЭтотОбъект.Модифицированность Тогда
		
		ОчиститьСообщения();
		
		ТекстВопроса = "Для перехода в настройки расписания автообмена необходимо сохранить изменения.
		|Записать элемент?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработатьОтветПользователяОЗаписиОбъекта", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
		
	Иначе 
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("ОрганизацияЭДО", 	Объект.Ссылка);
		
		ОткрытьФорму("Справочник.ККСНГ_Организации.Форма.ФормаНастройкиРасписанияАвтообмена", 
						ПараметрыОткрытияФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастроитьМЧД(Команда)
	
	Перем ПараметрыОткрытияФормы, ТекстВопроса;

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или ЭтотОбъект.Модифицированность Тогда
		
		ОчиститьСообщения();
		
		ДополнительныеПараметры = Новый Структура("КомандаНастройкиМЧД", Команда);
		
		ТекстВопроса = "Для перехода в настройки машиночитаемой доверенности необходимо сохранить изменения.
		|Записать элемент?";
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработатьОтветПользователяОЗаписиОбъекта", ЭтотОбъект, ДополнительныеПараметры), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("ОрганизацияЭДО", Объект.Ссылка);
		
		ОткрытьФорму("Справочник.ККСНГ_МашиночитаемыеДоверенности.Форма.ФормаСписка", ПараметрыОткрытияФормы, ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьШаблонОбработчика(Команда)
	
	ОписаниеФайлаШаблона = ПодготовитьШаблонОбработчикаНаСервере();
	
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(ОписаниеФайлаШаблона);
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбораФайла.Заголовок = "Сохранение шаблона обработки электронного документа";
	ДиалогВыбораФайла.ПолноеИмяФайла = ОписаниеФайлаШаблона.Имя;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьСохранениеШаблона", ЭтотОбъект, ДиалогВыбораФайла);
	НачатьПолучениеФайлов(ОписаниеОповещения, МассивФайлов, ДиалогВыбораФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьШаблон(Команда)
	
	ЭтотОбъект.Модифицированность = Истина;
	Объект.ОбработчикПослеФормирования = Неопределено;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОбработатьОтветПользователяОЗаписиОбъекта(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	КомандаНастройкиМЧД = ККСНГ_ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "КомандаНастройкиМЧД");
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Записать();
		
		Если КомандаНастройкиМЧД <> Неопределено Тогда
			НастроитьМЧД(КомандаНастройкиМЧД);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

