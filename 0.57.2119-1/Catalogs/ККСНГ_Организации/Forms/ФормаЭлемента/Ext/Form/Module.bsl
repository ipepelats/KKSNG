КонецПроцедуры

&НаКлиенте
Процедура УстановитьМодифицированность(Результат, ДопПараметры) Экспорт
	
	СтарыйКодУчастника = ДопПараметры.СтарыйКодУчастника;
	СтарыйИдентификаторПодписки = ДопПараметры.СтарыйИдентификаторПодписки;
	Если СтарыйКодУчастника <> Объект.КодУчастникаЭДО
	 ИЛИ СтарыйИдентификаторПодписки <> Объект.ИдентификаторПодпискиСК Тогда		
		ЭтотОбъект.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьНастроенныеКонтрагенты(ПрофильЭДООрганизации)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ККСНГ_Контрагенты.Ссылка КАК КонтрагентСсылка
		|ИЗ
		|	Справочник.ККСНГ_Контрагенты КАК ККСНГ_Контрагенты
		|ГДЕ
		|	ККСНГ_Контрагенты.Владелец = &ПрофильЭДООрганизации
		|	И НЕ ККСНГ_Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПрофильЭДООрганизации", ПрофильЭДООрганизации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
		
КонецФункции

&НаКлиенте
Процедура НастроитьПерейтиКНастройкамКонтрагентов()
	
	Элементы.ПерейтиКНастройкамКонтрагентов.Заголовок = ККСНГ_ДокументооборотКлиент.ТекстОбОтсутствииКонтрагентовЭДО(ОткрытаМастеромОрганизации);
	Элементы.ПерейтиКНастройкамКонтрагентов.Видимость = Не ЕстьНастроенныеКонтрагенты(Объект.Ссылка);
	
КонецПроцедуры

#Область НастройкаРегламентныхЗаданий

// Получает данные регламентного задания (если оно есть) и заполняет форму данными задания.
&НаСервере
Процедура ЗаполнитьРеквизитыФормыПоРегламентномуЗаданию()
	
	Перем НастройкиРегламентногоЗадания;
	
	ЧтениеНастроек = ККСНГ_РегламентныеЗадания.ПрочитатьНастройкиРегламентногоЗаданияАвтообмена(Объект.Ссылка);
	
	Если ЧтениеНастроек.Успех Тогда
		
		НастройкиРегламентногоЗадания = ЧтениеНастроек.Результат;
		
		ЭтотОбъект.Использование = НастройкиРегламентногоЗадания.Использование;
		ЭтотОбъект.РасписаниеРегламентногоЗадания = НастройкиРегламентногоЗадания.Расписание;
		ЭтотОбъект.ПользовательЭДО = НастройкиРегламентногоЗадания.ПользовательЭДО;
		
	КонецЕсли;
	
	Если ТипЗнч(ЭтотОбъект.РасписаниеРегламентногоЗадания) <> Тип("РасписаниеРегламентногоЗадания") Тогда
		ЭтотОбъект.РасписаниеРегламентногоЗадания = "Не установлено";
	КонецЕсли;

	ЭтотОбъект.Элементы.ПользовательЭДО.Доступность = ЗначениеЗаполнено(ЭтотОбъект.ПользовательЭДО);
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ПользовательЭДО) Тогда
		ЭтотОбъект.ПользовательЭДО = "Не указан";
	КонецЕсли;
	
	ЭтотОбъект.Элементы.РасписаниеАвтоматическогоОбменаИнформация.Доступность = ЭтотОбъект.Использование;
	
КонецПроцедуры

#КонецОбласти

#Область ТестированиеНастроек

&НаКлиенте
Процедура НачатьТестНастроек(ПослеТестаНастроек)
	
	ККСНГ_ДокументооборотКлиент.ИнициализироватьПараметрыАвторизации();
	ТекПараметрыАвторизации = ККСНГ_ДокументооборотКлиент.ТекущиеПараметрыАвторизацииОрганизации(Объект.Ссылка);
	Если ТекПараметрыАвторизации <> Неопределено И ТекПараметрыАвторизации.СпособАвторизации = Объект.СпособАвторизации Тогда
		ПродолжитьТестНастроек(ТекПараметрыАвторизации, ПослеТестаНастроек);
	Иначе 	
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ОповещениеОЗавершении", ПослеТестаНастроек);
		НачатьАутентификацию(ТекПараметрыАвторизации, ДопПараметры);
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьАутентификацию(ПараметрыАвторизации, ДополнительныеПараметры)
	
	ДанныеАвторизации = Новый Структура("СпособАвторизации,КлючДоступаAPI,ПараметрыАвторизации",
							Объект.СпособАвторизации, Объект.КлючДоступаAPI, ПараметрыАвторизации);
	ЗавершениеАутентификации = Новый ОписаниеОповещения("ЗавершениеАутентификации", ЭтотОбъект, ДополнительныеПараметры);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииНовойОрганизации(ДанныеАвторизации, ЗавершениеАутентификации);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеАутентификации(Результат, ДополнительныеПараметры) Экспорт
		
	ОповещениеОЗавершении = ДополнительныеПараметры.ОповещениеОЗавершении;
	Если Результат.Успех Тогда
		ПараметрыАвторизации = Результат.Результат;
		глПараметрыАвторизацииКурьер.Вставить(Объект.Ссылка, ПараметрыАвторизации);
		ПродолжитьТестНастроек(ПараметрыАвторизации, ОповещениеОЗавершении);
	Иначе 
		ТекстОшибки = "Не удалось авторизоваться. " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Результат.Журнал);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьТестНастроек(ПараметрыАвторизации, ОповещениеОЗавершении)
	
	РезультатТеста = ТестНастроекНаСервере(ПараметрыАвторизации, Объект.ИдентификаторПодпискиСК);
	
	ПолученныеДанные = РезультатТеста.ВозвращаемыеДанные;
	Если ЗначениеЗаполнено(ПолученныеДанные.КодУчастникаЭДО) Тогда
		Объект.КодУчастникаЭДО = ПолученныеДанные.КодУчастникаЭДО;
		ККСНГ_ОбщегоНазначенияКлиентСервер.ФорматироватьКодУчастникаЭДО(Объект.КодУчастникаЭДО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПолученныеДанные.ИдентификаторСК) Тогда
		Объект.ИдентификаторСК = ПолученныеДанные.ИдентификаторСК;
	КонецЕсли;
	Если РезультатТеста.Успех Тогда
		Объект.ИдентификаторПодпискиСК = ПолученныеДанные.ИдентификаторПодпискиСК;
	КонецЕсли;
	
	ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатТеста.Комментарий);
	ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, РезультатТеста);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТестНастроекНаСервере(ПараметрыАвторизации, ИдентификаторПодпискиСК)
	
	РезультатТеста = Новый Структура;	
	РезультатТеста.Вставить("ВозвращаемыеДанные", Новый Структура("КодУчастникаЭДО,ИдентификаторСК,ИдентификаторПодпискиСК"));
	РезультатТеста.Вставить("Успех", Ложь);
	РезультатТеста.Вставить("Комментарий", "");

	РезультатВызова = ККСНГ_APIКурьер.v2_ClientSelf(ПараметрыАвторизации);
	
	Если РезультатВызова.Успех Тогда
		
		Company = РезультатВызова.Результат;
		РезультатТеста.ВозвращаемыеДанные.КодУчастникаЭДО = Company.Code;
		РезультатТеста.ВозвращаемыеДанные.ИдентификаторСК = Company.Id;
		
		РезультатВызова = ККСНГ_ДокументооборотВызовСервера.ПолучитьИдентификаторПодписки(ИдентификаторПодпискиСК, ПараметрыАвторизации);
		
		Если РезультатВызова.Успех Тогда
			
			РезультатТеста.ВозвращаемыеДанные.ИдентификаторПодпискиСК = РезультатВызова.Результат;
			РезультатТеста.Успех = Истина;
			РезультатТеста.Комментарий = "Тест настроек прошел успешно.";
			
		Иначе
			РезультатТеста.Комментарий = ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(РезультатВызова.Журнал, "SC-00001");
		КонецЕсли;
		
	Иначе	
		РезультатТеста.Комментарий = "Не удалось получить информацию о компании: " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(РезультатВызова.Журнал);
	КонецЕсли;
			
	Возврат РезультатТеста;
	
КонецФункции

&НаСервере
Процедура ОбновитьНастройкуПодключаемогоМодуля()
	
	Если ЗначениеЗаполнено(Объект.ОбработчикПослеФормированияЭД) И Не ЗначениеЗаполнено(Объект.ПодключаемыйМодуль) Тогда
		Объект.ПодключаемыйМодуль = Объект.ОбработчикПослеФормированияЭД;
		Объект.ОбработчикПослеФормированияЭД = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
		ЭтотОбъект.Записать();
	КонецЕсли;
	
	Элементы.ГруппаОбработчикПосле.Видимость = Не Объект.ОбработчикПослеФормированияЭД.Пустая();
	
КонецПроцедуры

#Область РаботаСШаблономОбработки

&НаСервереБезКонтекста
Функция ПодготовитьШаблонОбработчикаНаСервере()
	
	ДвоичныеДанныеОбработки = ПолучитьОбщийМакет("ККСНГ_ПодключаемыйМодуль");
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки);
	ОписаниеФайл = Новый ОписаниеПередаваемогоФайла("ПодключаемыйМодульЭДО.epf", Адрес);
	
	Возврат ОписаниеФайл;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьСохранениеШаблона(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		КоличествоФайлов = Результат.Количество();
		
		Если КоличествоФайлов Тогда
			ТекстСообщения = "Шаблон обработчика сохранен " + ДопПараметры.Каталог;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПриНажатииНаВложения", ЭтотОбъект, ДопПараметры.Каталог);
			ПоказатьОповещениеПользователя(ТекстСообщения, ОписаниеОповещения, "Посмотреть в папке", БиблиотекаКартинок.СохранитьФайл);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаВложения(ДополнительныеПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		Если Не РаботаСФайламиСлужебныйКлиент.РасширениеРаботыСФайламиПодключено() Тогда
			РаботаСФайламиСлужебныйКлиент.ПоказатьПредупреждениеОНеобходимостиРасширенияРаботыСФайлами(Неопределено);
			Возврат;
		КонецЕсли;
	#КонецЕсли

	Если ТипЗнч(ДополнительныеПараметры) = Тип("Строка") И Не ПустаяСтрока(ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиент.ОткрытьПроводник(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

