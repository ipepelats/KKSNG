#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Варианты настроек обмена ФНС
	ВариантыНастроекОбмена = ККСНГ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВариантыФорматовЭлектронныхДокументов();
	Для Каждого НекийФормат Из ВариантыНастроекОбмена Цикл
		
		Элементы.СписокВариантовНастроекОбмена.СписокВыбора.Добавить(НекийФормат);
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ВариантНастройкиОбмена) Тогда
			ЭтотОбъект.ВариантНастройкиОбмена = НекийФормат;
		КонецЕсли;
		
	КонецЦикла;
	
	// Устанавливаем ограничение типов для реквизитов
	МодульККСНГ_ПМ_РаботаСМетаданными = ККСНГ_ОбщегоНазначенияКлиентСервер.ПолучитьМодульПодсистемы("ККСНГ_ПМ_РаботаСМетаданными");
	
	Если Не МодульККСНГ_ПМ_РаботаСМетаданными = Неопределено Тогда
		МодульККСНГ_ПМ_РаботаСМетаданными.УстановитьОграничениеТипа(Элементы.Склад, "Склады");
		Элементы.Склад.Видимость = Элементы.Склад.ОграничениеТипа.Типы().Количество();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьИнтерфейс();
	НастроитьВидимостьПоСпособуАвторизации();
	ОбновитьЦветЭлементовСогласноВариантуОтправки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Организация1СПриИзменении(Элемент)
	
	ТекстПредупреждения = ТекстПредупрежденияОрганизация(Организация1С, ИНН, КПП);
	ВыводитьПредупреждение = Не ПустаяСтрока(ТекстПредупреждения);
	
	Если ВыводитьПредупреждение Тогда
	    Элементы.ДекорацияПредупреждениеОрганизация.Заголовок = ТекстПредупреждения;
	КонецЕсли;
	
	Элементы.ДекорацияПредупреждениеОрганизация.Видимость = ВыводитьПредупреждение;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВариантовНастроекОбменаПриИзменении(Элемент)
	
	ОбновитьЦветЭлементовСогласноВариантуОтправки();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаДалее(Команда)
	
	ТекСтраница = Элементы.СтраницыФормы.ТекущаяСтраница;
	Если ТекСтраница = Элементы.СтраницаШаг1 Тогда
		ОбработатьШаг1();
	ИначеЕсли ТекСтраница = Элементы.СтраницаШаг2 Тогда
		ОбработатьШаг2();
	ИначеЕсли ТекСтраница = Элементы.СтраницаШаг3 Тогда
		ОбработатьШаг3();
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШаг1()
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(СпособАвторизации) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните, пожалуйста, способ авторизации.", , "СпособАвторизации");
		Возврат;
	КонецЕсли;
	
	Если ЭтоАвторизацияApiKey() И Не ЗначениеЗаполнено(КлючДоступаAPI) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните, пожалуйста, ключ доступа API.", , "КлючДоступаAPI");
		Возврат;
	КонецЕсли;
	
	НужнаНастройка = (СпособАвторизации <> ПрежнийСпособАвторизации) Или (КлючДоступаAPI <> ПрежнийКлючДоступаAPI);
	
	Если НужнаНастройка Или Не Элементы.ДекорацияНастройкиУспешны.Видимость Тогда
		ОчиститьРезультатыСозданияНастроек();
		НачатьАутентификацию();
	Иначе 
		ПерейтиНаСтраницу(Элементы.СтраницаШаг2);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбработкуШага1(РезультатАутентификации)
	
	УстановитьКартинкуЭтапаНастроек("Аутентификация", РезультатАутентификации.ТекстОшибки);
	Если Не РезультатАутентификации.Успех Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАвторизации = РезультатАутентификации.ПараметрыАвторизации;
	
	СделатьПаузу(1, "ПродолжитьОбработкуШагаПолучениеСведенийОрганизации");
			
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбработкуШагаПолучениеСведенийОрганизации() Экспорт
	
	РезультатПолученияСведений = ПолученыСведенияОбОрганизации(ПараметрыАвторизации);		
	УстановитьКартинкуЭтапаНастроек("СведенияОбОрганизации", РезультатПолученияСведений.ТекстОшибки);
	
	Если РезультатПолученияСведений.Успех Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РезультатПолученияСведений, "КодУчастникаЭДО, НаименованиеОрганизации, ИдентификаторСК, ИНН, КПП");
		ОтобразитьИННКППКурьер();
		СделатьПаузу(1, "ПродолжитьОбработкуШагаПроверкаУникальности");
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПродолжитьОбработкуШагаПроверкаУникальности() Экспорт
	
	Элементы.ГруппаПолученныеСведенияСВыравниванием.Видимость = Истина;
	РезультатПроверкиУникальности = УникальностьОрганизацииСфераКурьер(ИдентификаторСК);
	
	Если РезультатПроверкиУникальности.Успех Тогда
		
		УстановитьКартинкуЭтапаНастроек("ПроверкаУникальности", "");
		
		Если ЭтоАвторизацияApiKey() Тогда
			СделатьПаузу(1, "ПродолжитьОбработкуШагаПоискСертификатЭП");
		Иначе
			Элементы.ДекорацияНастройкиУспешны.Видимость = Истина;
			СделатьПаузу(1, "ПродолжитьОбработкуШагаЗавершениеШага1");
		КонецЕсли;
		
	Иначе
		
		НавигационнаяСсылкаПрофиля = ПолучитьНавигационнуюСсылку(РезультатПроверкиУникальности.Ссылка);
		ФорматированнаяСтрока = Новый ФорматированнаяСтрока(РезультатПроверкиУникальности.Представление, , , , НавигационнаяСсылкаПрофиля);
							
		ЧастиСообщения = Новый Массив;
		ЧастиСообщения.Добавить("Найдена уже настроенная организация ");
		ЧастиСообщения.Добавить(ФорматированнаяСтрока);
		ЧастиСообщения.Добавить(" с таким же идентификатором (" + ИдентификаторСК + ").");
		
		УстановитьКартинкуЭтапаНастроек("ПроверкаУникальности", Новый ФорматированнаяСтрока(ЧастиСообщения));
		
	КонецЕсли;			
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбработкуШагаПоискСертификатЭП() Экспорт
	НайтиСертификатЭП("");	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбработкуШагаЗавершениеШага1() Экспорт
	ЗавершитьШаг1(КодВозвратаДиалога.Да);
КонецПроцедуры

&НаКлиенте
Процедура НайтиСертификатЭП(ПрежнийКодОшибки = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыАвторизации.СертификатЭП) Тогда
		
		РезультатДополнения = ККСНГ_ДокументооборотКлиент.ДополнитьПараметрыАвторизацииСертификатомЭП(ПараметрыАвторизации);
		Если Не РезультатДополнения.Успех Тогда 
			
			ОбрабатываемыеОшибки = ККСНГ_ЭлектроннаяПодписьКлиентСервер.ОшибкиСертификатаКлючаЭП();
			ПоследняяОшибка = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(РезультатДополнения.Журнал);
			Если ПоследняяОшибка <> Неопределено И
				ПоследняяОшибка.КодОшибки <> ПрежнийКодОшибки И
				ПоследняяОшибка.КодОшибки <> ОбрабатываемыеОшибки["ОшибкаЗапросаАктивногоСертификата"] Тогда
				
				ПараметрыНастройкиЭП = Новый Структура;
				ПараметрыНастройкиЭП.Вставить("КодОшибки", ПоследняяОшибка.КодОшибки);
				ДанныеАктивногоСертификата = РезультатДополнения.Результат;
				ПараметрыНастройкиЭП.Вставить("ДанныеАктивногоСертификата", ДанныеАктивногоСертификата);
				
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("РезультатДополнения", РезультатДополнения);
				ДопПараметры.Вставить("ПрежнийКодОшибки", ПоследняяОшибка.КодОшибки);
				
				ОповещениеПослеНастройки = Новый ОписаниеОповещения("ПослеНастройкиСертификатаЭП", ЭтотОбъект, ДопПараметры); 
				
				ОткрытьФорму("ОбщаяФорма.ККСНГ_НастройкаСертификатаЭП", ПараметрыНастройкиЭП, ЭтотОбъект,
					Истина, , , ОповещениеПослеНастройки, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
			Иначе 
				ОбработатьОшибкуПолученияСертификатаЭП(РезультатДополнения);
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Сертификат = ПараметрыАвторизации.СертификатЭП;
	УстановитьКартинкуЭтапаНастроек("ПолучениеСертификатаЭП", "", Ложь);
	Элементы.ДекорацияНастройкиУспешны.Видимость = Истина;
	СделатьПаузу(1, "ПродолжитьОбработкуШагаЗавершениеШага1");

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОшибкуПолученияСертификатаЭП(РезультатДополнения) 
	
	ОбрабатываемыеОшибки = ККСНГ_ЭлектроннаяПодписьКлиентСервер.ОшибкиСертификатаКлючаЭП();
	ПоследняяОшибка = ККСНГ_ЛогированиеКлиентСервер.ПоследняяОшибкаЖурнала(РезультатДополнения.Журнал);
	Если ПоследняяОшибка <> Неопределено Тогда
		ПрерватьСоздание = ПоследняяОшибка.КодОшибки = ОбрабатываемыеОшибки["ОшибкаЗапросаАктивногоСертификата"];
		ТекстОшибкиСертификата = ККСНГ_ЛогированиеКлиентСервер.ТекстСообщения(ПоследняяОшибка);
	КонецЕсли;
	УстановитьКартинкуЭтапаНастроек("ПолучениеСертификатаЭП", ТекстОшибкиСертификата, Не ПрерватьСоздание);
	Если ПрерватьСоздание Тогда
		Возврат;
	Иначе 
		ТекстВопроса = ТекстОшибкиСертификата + Символы.ПС + "Продолжить создание организации?";
		ПослеОтветаНаВопрос = Новый ОписаниеОповещения("ЗавершитьШаг1", ЭтотОбъект);
		ПоказатьВопрос(ПослеОтветаНаВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройкиСертификатаЭП(ПовторитьПопытку, ДопПараметры) Экспорт 
	
	РезультатДополнения = ДопПараметры.РезультатДополнения;
	ПрежнийКодОшибки = ДопПараметры.ПрежнийКодОшибки;
		
	Если ПовторитьПопытку = Истина Тогда
		
		НайтиСертификатЭП(ПрежнийКодОшибки);
				
	Иначе 
		ОбработатьОшибкуПолученияСертификатаЭП(РезультатДополнения);		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьШаг1(Знач Ответ = Неопределено, ДопПараметры = Неопределено) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Организация1С = ОрганизацияПоИННКПП(ИНН, КПП);
		ПрежнийКлючДоступаAPI = КлючДоступаAPI;
		ПрежнийСпособАвторизации = СпособАвторизации;
		ПерейтиНаСтраницу(Элементы.СтраницаШаг2);		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШаг2()
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Организация1С) Тогда 
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите, пожалуйста, организацию 1С.", , "Организация1С");
	Иначе
		ПерейтиНаСтраницу(Элементы.СтраницаШаг3);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШаг3()
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ВариантНастройкиОбмена) Тогда
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите, пожалуйста, вариант настройки обмена.", , "ВариантНастройкиОбмена");
		Возврат;
	КонецЕсли;
	
	Состояние("Получение идентификатора подписки");
	ТекстОшибкиИдентификатораПодписки = "";
	ИдентификаторПодпискиПолучен = ПолученИдентификаторПодписки(ПараметрыАвторизации, ИдентификаторПодпискиСК, ТекстОшибкиИдентификатораПодписки);
	Если ИдентификаторПодпискиПолучен Тогда
		Состояние("Получение подписки успешно получен.");
	Иначе
		ТекстОшибки = ТекстОшибкиИдентификатораПодписки + Символы.ПС + "Запись организации прервана.";
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТекстОшибкиЗаписи = "";
	НоваяОрганизацияСсылка = СсылкаЗаписаннойОрганизации(ТекстОшибкиЗаписи);
	Если ЗначениеЗаполнено(НоваяОрганизацияСсылка) Тогда
		ПараметрыФормы = Новый Структура("Ключ,ОткрытаМастеромОрганизации", НоваяОрганизацияСсылка, Истина);
		ОткрытьФорму("Справочник.ККСНГ_Организации.Форма.ФормаЭлемента", ПараметрыФормы, , , , , , РежимОткрытияОкнаФормы.Независимый);
		ОповеститьОбИзменении(НоваяОрганизацияСсылка);
		ККСНГ_ДокументооборотКлиент.ОбновитьПараметрыАвторизацииОрганизации(НоваяОрганизацияСсылка, ПараметрыАвторизации);
		ЭтотОбъект.Закрыть();
	Иначе
		ККСНГ_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписи);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
		
	ПерейтиНаСтраницу(Элементы["СтраницаШаг" + (Число(НомерТекущегоШага()) - 1)]);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособАвторизацииПриИзменении(Элемент)
	НастроитьВидимостьПоСпособуАвторизации();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнтерфейсныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьВидимостьПоСпособуАвторизации()
	
	ЭтоApiKey = ЭтоАвторизацияApiKey();
	Элементы.КлючДоступаAPI.Видимость = ЭтоApiKey;
	Элементы.ГруппаПолучениеСертификатаЭП.Видимость = ЭтоApiKey;
		
КонецПроцедуры

&НаКлиенте
Функция ЭтоАвторизацияApiKey()
	
	Возврат СпособАвторизации = ПредопределенноеЗначение("Перечисление.ККСНГ_СпособыАвторизацииКурьер.ApiKey");

КонецФункции

&НаКлиенте
Процедура ОтобразитьИННКППКурьер()
	
	ЕстьИНН = ЗначениеЗаполнено(ИНН);
	ЕстьКПП = ЗначениеЗаполнено(КПП);
	Если ЕстьИНН Тогда
		ИННКППКурьера = "ИНН" + ?(ЕстьКПП, " / КПП", "") + " из сервиса ЭДО: " + ИНН + ?(ЕстьКПП, " / " + КПП, "");
	Иначе
	    ИННКППКурьера = "";
	КонецЕсли;
	Элементы.ДекорацияИННКППКурьера.Заголовок = ИННКППКурьера;
	Элементы.ДекорацияИННКППКурьера.Видимость = ЗначениеЗаполнено(ИННКППКурьера);
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьПаузу(ПродолжительностьПаузы = 1, ИмяПроцедурыЗавершения = Неопределено)
	
	Если ЗначениеЗаполнено(ИмяПроцедурыЗавершения) Тогда
		ПодключитьОбработчикОжидания(ИмяПроцедурыЗавершения, ПродолжительностьПаузы, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПустойОбработчик() Экспорт
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьИнтерфейс()
	
	ОбновитьЗаголовокФормы();
	Элементы.КомандаНазад.Видимость = ИмяТекущейСтраницы() <> "СтраницаШаг1";

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокФормы()
	
