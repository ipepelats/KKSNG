#Область ВызовМетодовСФЕРАКурьер

&НаКлиенте
Процедура НачатьАутентификацию()
	
	ДанныеАвторизации = Новый Структура("СпособАвторизации,КлючДоступаAPI,ПараметрыАвторизации",
									СпособАвторизации, КлючДоступаAPI, ПараметрыАвторизации);
	ЗавершениеАутентификации = Новый ОписаниеОповещения("ЗавершениеАутентификации", ЭтотОбъект);
	ККСНГ_ДокументооборотКлиент.ПараметрыАвторизацииНовойОрганизации(ДанныеАвторизации, ЗавершениеАутентификации);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеАутентификации(Результат, ДополнительныеПараметры) Экспорт
	
	ВозвращаемыйРезультат = Новый Структура("Успех,ТекстОшибки,ПараметрыАвторизации", Ложь, "");
	ВозвращаемыйРезультат.Успех = Результат.Успех;
	
	Если Результат.Успех Тогда
		ВозвращаемыйРезультат.ПараметрыАвторизации = Результат.Результат;		
	Иначе 
		ТекстОшибки = "Не удалось авторизоваться. " + ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(Результат.Журнал);
		ВозвращаемыйРезультат.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

	ПродолжитьОбработкуШага1(ВозвращаемыйРезультат);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолученыСведенияОбОрганизации(ПараметрыАвторизации)	
	
	ВозвращаемыйРезультат = Новый Структура("Успех,ТекстОшибки,КодУчастникаЭДО,НаименованиеОрганизации,ИдентификаторСК,ИНН,КПП", Ложь, "");
	
	РезультатВызова = ККСНГ_APIКурьер.v2_ClientSelf(ПараметрыАвторизации);
	ВозвращаемыйРезультат.Успех = РезультатВызова.Успех;
	
	Если РезультатВызова.Успех Тогда
		Company = РезультатВызова.Результат;
		ВозвращаемыйРезультат.КодУчастникаЭДО = Company.Code;
		ВозвращаемыйРезультат.ИдентификаторСК = Company.Id;	
		ВозвращаемыйРезультат.НаименованиеОрганизации = Company.Name;
		ВозвращаемыйРезультат.ИНН = Company.Inn;	
		ВозвращаемыйРезультат.КПП = Company.Kpp;
	Иначе	
		ВозвращаемыйРезультат.ТекстОшибки = "Не удалось получить информацию о компании. "
										+ ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(РезультатВызова.Журнал);
	КонецЕсли;
	
	Возврат ВозвращаемыйРезультат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолученИдентификаторПодписки(ПараметрыАвторизации, ИдентификаторПодпискиСК, ТекстОшибки = "")		
		
	РезультатВызова = ККСНГ_ДокументооборотВызовСервера.ПолучитьИдентификаторПодписки(ИдентификаторПодпискиСК, ПараметрыАвторизации);
	
	Если РезультатВызова.Успех Тогда
		ИдентификаторПодпискиСК = РезультатВызова.Результат;
		Возврат Истина;
	Иначе
		ТекстОшибки = ККСНГ_ЛогированиеКлиентСервер.ОписаниеПоследнейОшибки(РезультатВызова.Журнал, "SC-00001");
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

// ВызовМетодовСФЕРАКурьер
#КонецОбласти

&НаСервереБезКонтекста
Функция УникальностьОрганизацииСфераКурьер(ИдентификаторСК)	
	
	ВозвращаемыйРезультат = Новый Структура("Успех,Ссылка,Представление", Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ККСНГ_Организации.Ссылка КАК Ссылка,
		|	ККСНГ_Организации.Представление КАК Представление
		|ИЗ
		|	Справочник.ККСНГ_Организации КАК ККСНГ_Организации
		|ГДЕ
		|	ККСНГ_Организации.ИдентификаторСК = &ИдентификаторСК
		|	И НЕ ККСНГ_Организации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИдентификаторСК", ИдентификаторСК);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ВозвращаемыйРезультат.Успех = Ложь;
		ЗаполнитьЗначенияСвойств(ВозвращаемыйРезультат, ВыборкаДетальныеЗаписи, "Ссылка,Представление");
	КонецЕсли;
		
	Возврат ВозвращаемыйРезультат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОрганизацияПоИННКПП(ИНН, КПП)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК НайденнаяОрганизация
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И Организации.ИНН = &ИНН";
	
	Если ЗначениеЗаполнено(КПП) Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И Организации.КПП = &КПП";
		Запрос.УстановитьПараметр("КПП", КПП);
	КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.НайденнаяОрганизация;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СсылкаЗаписаннойОрганизации(ТекстОшибки = "")	
	
	НоваяОрганизация = Справочники.ККСНГ_Организации.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НоваяОрганизация, ЭтотОбъект);
	НоваяОрганизация.Организация = Организация1С;
	
	НоваяОрганизация.ДополнительныеСвойства.Вставить("Склад", ЭтотОбъект.Склад);
		
	Попытка
		НоваяОрганизация.Записать();
	Исключение
	    ТекстОшибки = "Не удалось записать организацию по причине: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат НоваяОрганизация.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстПредупрежденияОрганизация(Организация1С, ЭталонныйИНН, ЭталонныйКПП)
	
	ТекстПредупреждения = "";
	ИННСовпадают = Организация1С.ИНН = ЭталонныйИНН;
	КППСовпадают = Организация1С.КПП = ЭталонныйКПП;
	
	Если Не ИННСовпадают И Не КППСовпадают Тогда 
		ТекстПредупреждения = "ИНН и КПП выбранной организации не совпадают с данными из сервиса ЭДО.";
	ИначеЕсли Не ИННСовпадают Тогда
		ТекстПредупреждения = "ИНН выбранной организации не совпадает с данными из сервиса ЭДО.";
	ИначеЕсли Не КППСовпадают Тогда
		ТекстПредупреждения = "КПП выбранной организации не совпадает с данными из сервиса ЭДО.";
	Иначе	// Все хорошо. 
		ТекстПредупреждения = "";
	КонецЕсли;
	
	Возврат ТекстПредупреждения;
	
КонецФункции

#КонецОбласти