&НаКлиенте
Процедура ОчиститьРезультатыСозданияНастроек()
	
	УстановитьКартинкуЭтапаНастроек("Аутентификация", Неопределено);
	УстановитьКартинкуЭтапаНастроек("СведенияОбОрганизации", Неопределено);
	УстановитьКартинкуЭтапаНастроек("ПроверкаУникальности", Неопределено);
	УстановитьКартинкуЭтапаНастроек("ПолучениеСертификатаЭП", Неопределено);
	КодУчастникаЭДО = "";
	ИдентификаторСК = "";
	ИдентификаторПодпискиСК = 0;
	ОтпечатокПодписи = "";
	Сертификат = ПредопределенноеЗначение("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка");	
	ИНН = "";
	КПП = "";
	Элементы.ГруппаПолученныеСведенияСВыравниванием.Видимость = Ложь;
	Элементы.ДекорацияНастройкиУспешны.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКартинкуЭтапаНастроек(ИмяЭтапа, ОписаниеОшибки = Неопределено, ЭтоПредупреждение = Ложь)
	
	ЭлементКартинка = Элементы[ИмяЭтапа + "Картинка"];
		
	Если ОписаниеОшибки = Неопределено Тогда
		ЭлементКартинка.Картинка    = Новый Картинка;
		ЭлементКартинка.Подсказка   = НСтр("ru = 'Этап не выполнялся.'");
	ИначеЕсли ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ЭлементКартинка.Картинка    = ?(ЭтоПредупреждение = Истина, БиблиотекаКартинок.ККСНГ_Предупреждение32, БиблиотекаКартинок.ККСНГ_Ошибка32);
		ЭлементКартинка.Подсказка   = ОписаниеОшибки;
	Иначе
		ЭлементКартинка.Картинка    = БиблиотекаКартинок.ККСНГ_Успешно32;
		ЭлементКартинка.Подсказка   = НСтр("ru = 'Этап успешно пройден.'");
	КонецЕсли;
	Элементы.ДекорацияОшибка.Видимость = ЗначениеЗаполнено(ОписаниеОшибки);
	Элементы.ДекорацияОшибка.Заголовок = ?(ЗначениеЗаполнено(ОписаниеОшибки), ОписаниеОшибки, "");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЦветЭлементовСогласноВариантуОтправки();
	
	ПоОтдельности = СтрНайти(ВариантНастройкиОбмена, "для каждого документа") <> 0;
	Комплектом = СтрНайти(ВариантНастройкиОбмена, "для комплекта документов") <> 0;
	
	ИнойЦвет = Новый Цвет(0, 150, 70);
	ЦветАвто = Новый Цвет;
	// Элементы варианта "По отдельности".
	Элементы.НадписьАктНаПередачуПравУПД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	Элементы.НадписьАктВыполненныхРаботУПД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	Элементы.НадписьТоварнаяНакладнаяУПД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	Элементы.НадписьСчетФактураУПД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	Элементы.НадписьАктНакладнаяКорректировкаУКД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	Элементы.НадписьСчетФактураКорректировкаУКД.ЦветТекста = ?(ПоОтдельности, ИнойЦвет, ЦветАвто);
	// Элементы варианта "Комплектом".
	Элементы.НадписьУПДСЧФДОП.ЦветТекста = ?(Комплектом, ИнойЦвет, ЦветАвто);
	Элементы.НадписьУКДСЧФДОП.ЦветТекста = ?(Комплектом, ИнойЦвет, ЦветАвто);
	
КонецПроцедуры

